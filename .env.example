# ========================================
# POLICE CAD ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your actual values

# ========================================
# SERVER CONFIGURATION
# ========================================

# Port to start server on (default: 8080)
PORT=8080

# Node environment (development/production)
NODE_ENV=development

# ========================================
# DATABASE CONFIGURATION
# ========================================

# MongoDB connection URI
# Format: mongodb://username:password@host:port/database
# Local example: mongodb://localhost/knoldus
# Atlas example: mongodb+srv://username:password@cluster.mongodb.net/database
DB_URI=mongodb://localhost/knoldus

# ========================================
# API CONFIGURATION
# ========================================

# Police CAD API URL (required for microservice integration)
# Default: https://police-cad-app-api.herokuapp.com
POLICE_CAD_API_URL=http://localhost:8081

# Police CAD API Token (Bearer token for API authentication)
# Format: Bearer your_jwt_token_here
POLICE_CAD_API_TOKEN=Bearer your_jwt_token_here

# ========================================
# URL REDIRECTION CONFIGURATION
# ========================================

# New base URL for redirects (default: http://localhost:8080)
NEW_BASE_URL=http://localhost:8080

# Old base URL for redirects (optional)
OLD_BASE_URL=

# Redirect status code (default: 302)
REDIRECT_STATUS=302

# Client redirect URL for OAuth (Discord integration)
CLIENT_REDIRECT=http://localhost:8080/auth/discord/callback

# ========================================
# OAUTH/DISCORD CONFIGURATION
# ========================================

# Discord OAuth Client ID
# Get this from Discord Developer Portal: https://discord.com/developers/applications
CLIENT_ID=your_discord_client_id

# Discord OAuth Client Secret
# Get this from Discord Developer Portal: https://discord.com/developers/applications
CLIENT_SECRET=your_discord_client_secret

# ========================================
# EMAIL CONFIGURATION
# ========================================

# SendGrid API Key for email functionality
# Get this from SendGrid dashboard: https://app.sendgrid.com/settings/api_keys
MAIL_API_KEY=your_sendgrid_api_key

# From email address for sending emails
# Should be a verified sender in your SendGrid account
FROM_EMAIL=noreply@yourdomain.com

# Site protocol for email links (http or https)
SITE_PROTOCOL=http

# ========================================
# CLOUDINARY CONFIGURATION
# ========================================

# Cloudinary upload preset for image uploads
# Get this from your Cloudinary dashboard
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# ========================================
# SECURITY NOTES
# ========================================
# 
# 1. Never commit your actual .env file to version control
# 2. Keep your API keys and secrets secure
# 3. Use different keys for development and production
# 4. Regularly rotate your API keys and secrets
# 5. Use strong, unique passwords for database connections
#
# ========================================
# SETUP INSTRUCTIONS
# ========================================
#
# 1. Copy this file: cp temp.txt .env
# 2. Edit .env with your actual values
# 3. For Discord OAuth:
#    - Create app at https://discord.com/developers/applications
#    - Add redirect URL: http://localhost:8080/auth/discord/callback
#    - Copy Client ID and Client Secret
# 4. For SendGrid:
#    - Create account at https://sendgrid.com
#    - Generate API key
#    - Verify sender email
# 5. For Cloudinary:
#    - Create account at https://cloudinary.com
#    - Create upload preset
# 6. For Police CAD API:
#    - Set up police-cad-api service
#    - Generate JWT token
#    - Update API URL and token
#

# =============================================================================
# SIGN IN WITH GOOGLE AND APPLE
# =============================================================================
# Public client identifiers. Not secrets, but unset means the provider's button
# is not rendered at all: a button that cannot work reads as broken rather than
# absent, and the id is the audience the API checks a token against, so there is
# no sane default to fall back to.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=com.linesmerrill.policecad.web

# The callbacks, which must match what is registered with each provider byte
# for byte. Taken from config rather than built from the request, because a
# value derived from a Host header is a value an attacker can influence.
GOOGLE_OAUTH_REDIRECT_URI=https://www.linespolice-cad.com/auth/google/callback
APPLE_OAUTH_REDIRECT_URI=https://www.linespolice-cad.com/auth/apple/callback

# There is NO client secret, and no Apple Team ID, Key ID or .p8 private key.
# Both providers are asked for an ID token directly in the redirect response, so
# the authorization code is never exchanged and no signing key is needed.
