  "scripts": {
    "start": "node server.js",
    "start:legacy": "node app.js",
    "test": "mocha",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:smoke": "playwright test --config=e2e/playwright.config.ts --project=smoke",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "dev": "NODE_ENV=development nodemon --ext js,ejs,tsx,ts server.js",
    "dev:legacy": "nodemon --ext js,ejs app.js",
    "update-version": "node scripts/update-version.js",
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "build:local": "npm run lint && next build",
    "postinstall": "next build"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
