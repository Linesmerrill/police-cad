<script>
// Volume bars visualization
(function() {
  var barCount = 20;
  var container = document.getElementById('ss-volume-bars');
  if (!container) return;
  for (var i = 0; i < barCount; i++) {
    var bar = document.createElement('span');
    // Varying heights for visual interest
    var h = 3 + (i / barCount) * 15;
    bar.style.height = h + 'px';
    container.appendChild(bar);
  }

  // Make updateVolumeUI global
  window.updateVolumeUI = function(val) {
    var display = document.getElementById('ss-vol-display');
    if (display) display.textContent = val + '%';
    var bars = container.children;
    var filled = Math.round((val / 100) * barCount);
    for (var i = 0; i < bars.length; i++) {
      if (i < filled) {
        bars[i].classList.add('active');
        bars[i].classList.toggle('bright', i >= filled - 3);
      } else {
        bars[i].classList.remove('active', 'bright');
      }
    }
    // Update slider track fill via CSS gradient
    var slider = document.getElementById('alert-volume-slider');
    if (slider) {
      var pct = val + '%';
      slider.style.background = 'linear-gradient(to right, rgba(99,130,255,0.35) 0%, rgba(123,156,255,0.5) ' + pct + ', #2a2d3e ' + pct + ')';
    }
  };

  // Initialize on load
  document.addEventListener('DOMContentLoaded', function() {
    var slider = document.getElementById('alert-volume-slider');
    if (slider) window.updateVolumeUI(slider.value);
  });
})();

// Patch initSoundSettings to also update the volume UI
var _origInitSoundSettings = window.initSoundSettings;
window.initSoundSettings = function() {
  if (typeof _origInitSoundSettings === 'function') _origInitSoundSettings();
  var slider = document.getElementById('alert-volume-slider');
  if (slider && typeof window.updateVolumeUI === 'function') {
    window.updateVolumeUI(slider.value);
  }
};

// Beta feature toggles — generic two-button handler so each toggle tracks
// its own flag, reflects the current opt-in state (Enable vs Disable), and
// only redirects when opting IN. Opting out stays on the current page so
// users don't get bounced unexpectedly.
(function() {
  var userId = '<%= user._id %>';
  var apiUrl = '<%= apiUrl %>';
  // Redirect on enable ONLY when the user is on the matching classic page.
  // Opening Settings from a random page (EMS, fire, civilian, etc.) and
  // flipping a flag just saves the preference — no surprise navigation
  // with mismatched query params (which previously sent users from
  // /ems-dashboard to /command-dashboard?dept=Fire&... and rendered a
  // fire bridge instead of dispatch).
  var toggles = [
    {
      btn: document.getElementById('ss-cmd-dashboard-btn'),
      flag: 'betaCommandDashboard',
      redirectTo: '/command-dashboard',
      redirectWhenAt: '/police-dashboard',
    },
    {
      btn: document.getElementById('ss-cmd-dispatch-btn'),
      flag: 'betaCommandDispatch',
      redirectTo: '/command-dashboard',
      redirectWhenAt: '/dispatch-dashboard',
    },
  ];

  function applyState(btn, enabled) {
    if (!btn) return;
    btn.dataset.state = enabled ? 'on' : 'off';
    btn.textContent = enabled ? 'Disable' : 'Enable';
    if (enabled) {
      btn.style.background = 'transparent';
      btn.style.border = '1px solid rgba(255,255,255,0.15)';
      btn.style.color = '#94a3b8';
    } else {
      btn.style.border = 'none';
      // Keep the original gradient via the HTML style attr — re-set here in
      // case we flipped to disabled then back.
      if (btn.id === 'ss-cmd-dispatch-btn') {
        btn.style.background = 'linear-gradient(135deg,#7c3aed,#a78bfa)';
        btn.style.color = '#0b051a';
      } else {
        btn.style.background = 'linear-gradient(135deg,#0ea5e9,#38bdf8)';
        btn.style.color = '#050a12';
      }
    }
  }

  function fetchState() {
    if (!userId) return;
    $.ajax({
      url: apiUrl + '/api/v1/user-preferences/' + encodeURIComponent(userId),
      method: 'GET',
    }).done(function(prefs) {
      prefs = prefs || {};
      toggles.forEach(function(t) { applyState(t.btn, prefs[t.flag] === true); });
    }).fail(function() {
      // On load error assume both off — matches the previous default behavior.
      toggles.forEach(function(t) { applyState(t.btn, false); });
    });
  }

  // Feature labels surfaced in the shared feedback modal header.
  var FLAG_LABELS = {
    betaCommandDashboard: 'the Command Dashboard',
    betaCommandDispatch: 'the Command Bridge',
  };

  function applyBetaToggle(t, nextValue) {
    t.btn.disabled = true;
    t.btn.textContent = nextValue ? 'Switching…' : 'Disabling…';
    t.btn.style.opacity = '0.6';
    var body = { userId: userId };
    body[t.flag] = nextValue;
    $.ajax({
      url: apiUrl + '/api/v1/user-preferences/' + encodeURIComponent(userId),
      method: 'PUT',
      contentType: 'application/json',
      data: JSON.stringify(body),
    }).done(function(resp) {
      var serverValue = resp && resp[t.flag];
      applyState(t.btn, !!serverValue);
      t.btn.disabled = false;
      t.btn.style.opacity = '1';
      // Only redirect if we enabled AND we're on the matching classic
      // page. Saves the flag from any page; navigation only happens when
      // it actually makes sense contextually.
      if (nextValue && serverValue && t.redirectTo && window.location.pathname === t.redirectWhenAt) {
        window.location.href = t.redirectTo + window.location.search;
      }
    }).fail(function(xhr) {
      console.error('[beta-toggle] PUT failed', xhr && xhr.status, xhr && xhr.responseText);
      applyState(t.btn, !nextValue); // roll back visual state
      t.btn.disabled = false;
      t.btn.style.opacity = '1';
      alert('Couldn\'t save that preference — please try again.');
    });
  }

  toggles.forEach(function(t) {
    if (!t.btn) return;
    t.btn.addEventListener('click', function() {
      if (!userId) { console.warn('[beta-toggle] no user id available'); return; }
      var currentlyOn = t.btn.dataset.state === 'on';
      if (currentlyOn) {
        // Disabling — prompt for feedback via the shared module, then
        // flip the flag off on confirm/skip. Cancel bails entirely.
        if (typeof window.cdPromptBetaFeedback === 'function') {
          window.cdPromptBetaFeedback({
            flag: t.flag,
            label: FLAG_LABELS[t.flag] || 'this beta',
            context: window.location.pathname,
            userId: userId,
            apiUrl: apiUrl,
            onConfirm: function() { applyBetaToggle(t, false); },
            // onCancel: no-op, state stays as Enabled
          });
        } else {
          // Module missing — fall back to plain disable
          applyBetaToggle(t, false);
        }
      } else {
        // Enabling — straight-line, no modal.
        applyBetaToggle(t, true);
      }
    });
  });

  // Initial paint
  fetchState();
})();

// Close modal on close button click or backdrop click
document.addEventListener('DOMContentLoaded', function() {
  var modal = document.getElementById('accountModal');
  var closeBtn = document.getElementById('accountModalClose');

  function closeModal() {
    if (modal) modal.style.display = 'none';
  }

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });
  }
});
</script>

