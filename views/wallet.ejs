<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wallet - Lines Police CAD</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="shortcut icon" type="image/ico" href="static/images/favicon.ico">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --w-bg: #08090c;
      --w-glass: rgba(255,255,255,0.04);
      --w-glass-border: rgba(255,255,255,0.06);
      --w-glass-hover: rgba(255,255,255,0.07);
      --w-text: #e2e8f0;
      --w-text-muted: #94a3b8;
      --w-text-dim: #64748b;
      --w-accent: #38bdf8;
      --w-accent-dim: rgba(56,189,248,0.12);
      --w-accent-border: rgba(56,189,248,0.25);
      --w-green: #22c55e;
      --w-red: #ef4444;
      --w-amber: #f59e0b;
      --w-radius: 12px;
    }
    html { font-size: 16px; }
    body {
      background: var(--w-bg); color: var(--w-text);
      font-family: 'Outfit', -apple-system, sans-serif;
      min-height: 100vh; line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding-top: 36px;
    }
    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background:
        radial-gradient(ellipse 700px 500px at 10% 15%, rgba(56,189,248,0.06) 0%, transparent 70%),
        radial-gradient(ellipse 500px 400px at 90% 85%, rgba(34,197,94,0.03) 0%, transparent 70%);
    }
    .w-shell { position: relative; z-index: 1; max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
    .w-header { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1.5rem; }
    .w-header-icon {
      width: 44px; height: 44px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      background: var(--w-accent-dim); color: var(--w-accent); font-size: 1.2rem;
      border: 1px solid var(--w-accent-border);
    }
    .w-title { font-size: 1.4rem; font-weight: 600; letter-spacing: -0.01em; }
    .w-subtitle { font-size: 0.85rem; color: var(--w-text-muted); margin-top: 0.1rem; }
    .w-subtitle-row { display: inline-flex; align-items: center; gap: 0.4rem; }
    .w-swap-btn {
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px; border-radius: 50%;
      background: rgba(56,189,248,0.08); color: var(--w-accent, #38bdf8);
      border: 1px solid rgba(56,189,248,0.18); cursor: pointer;
      font-size: 0.65rem;
      transition: background 120ms, border-color 120ms, transform 120ms;
    }
    .w-swap-btn:hover { background: rgba(56,189,248,0.18); border-color: rgba(56,189,248,0.35); transform: rotate(180deg); }
    /* "Active" indicator + "Set as active" button sit inline with the swap
       affordance so the active civilian is always one glance away.
       Locked to the same height as .w-swap-btn (22px) with line-height:1
       so the subtitle row stays optically aligned — without this they
       inherit line-height:1.5 from .w-subtitle and end up a couple
       pixels off the swap icon. */
    .w-active-pill,
    .w-set-active-btn {
      display: inline-flex; align-items: center; gap: 0.3rem;
      height: 22px; line-height: 1;
      padding: 0 8px;
      font-size: 0.65rem; font-weight: 600; letter-spacing: 0.05em;
      text-transform: uppercase;
      border-radius: 999px;
      box-sizing: border-box;
    }
    .w-active-pill {
      background: rgba(34,197,94,0.12); color: #4ade80;
      border: 1px solid rgba(34,197,94,0.32);
    }
    .w-active-pill i { font-size: 0.55rem; }
    .w-set-active-btn {
      background: rgba(139,92,246,0.10); color: #c4b5fd;
      border: 1px solid rgba(139,92,246,0.30);
      cursor: pointer; transition: background 120ms, border-color 120ms, color 120ms;
    }
    .w-set-active-btn:hover { background: rgba(139,92,246,0.20); border-color: rgba(139,92,246,0.5); color: #fff; }
    .w-set-active-btn i { font-size: 0.55rem; }
    .w-set-active-btn[disabled] { opacity: 0.55; cursor: progress; }

    /* Civilian swap modal */
    .w-swap-backdrop {
      position: fixed; inset: 0; background: rgba(2,6,12,0.6);
      backdrop-filter: blur(6px);
      opacity: 0; pointer-events: none;
      transition: opacity 160ms ease;
      z-index: 60;
    }
    .w-swap-backdrop.is-open { opacity: 1; pointer-events: auto; }
    .w-swap-modal {
      position: fixed; top: 50%; left: 50%;
      transform: translate(-50%, -48%) scale(0.97);
      width: min(440px, calc(100vw - 2rem));
      max-height: min(72vh, 600px); display: flex; flex-direction: column;
      background: #0b1220;
      border: 1px solid rgba(56,189,248,0.22);
      border-radius: 12px;
      box-shadow: 0 24px 60px rgba(0,0,0,0.55);
      opacity: 0; pointer-events: none;
      transition: opacity 160ms ease, transform 160ms ease;
      z-index: 61;
    }
    .w-swap-modal.is-open { opacity: 1; pointer-events: auto; transform: translate(-50%, -50%) scale(1); }
    .w-swap-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.75rem 0.9rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      font-weight: 600; color: var(--w-text);
    }
    .w-swap-header button {
      background: none; border: none; color: var(--w-text-muted);
      cursor: pointer; font-size: 0.9rem; padding: 0.25rem;
    }
    .w-swap-header button:hover { color: var(--w-text); }
    .w-swap-search {
      margin: 0.7rem 0.9rem 0.4rem;
      display: flex; align-items: center; gap: 0.5rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px; padding: 0.45rem 0.65rem;
    }
    .w-swap-search i { color: var(--w-text-muted); font-size: 0.75rem; }
    .w-swap-search input {
      background: transparent; border: none; outline: none; color: var(--w-text);
      flex: 1; font-size: 0.85rem;
    }
    .w-swap-list { overflow-y: auto; padding: 0.35rem 0.6rem 0.7rem; }
    .w-swap-row {
      display: flex; align-items: center; gap: 0.65rem;
      padding: 0.55rem 0.6rem; border-radius: 8px; cursor: pointer;
      transition: background 100ms;
    }
    .w-swap-row:hover { background: rgba(56,189,248,0.06); }
    .w-swap-row.is-current { background: rgba(56,189,248,0.1); cursor: default; }
    .w-swap-row.is-current:hover { background: rgba(56,189,248,0.1); }
    .w-swap-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: rgba(56,189,248,0.12); color: var(--w-accent, #38bdf8);
      display: grid; place-items: center; font-weight: 700; font-size: 0.78rem;
      overflow: hidden; flex-shrink: 0;
    }
    .w-swap-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .w-swap-name { font-size: 0.88rem; color: var(--w-text); text-transform: capitalize; }
    .w-swap-bal { font-size: 0.74rem; color: var(--w-text-muted); font-variant-numeric: tabular-nums; }
    .w-swap-info { flex: 1; min-width: 0; }
    .w-swap-current-pill {
      font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--w-accent, #38bdf8); background: rgba(56,189,248,0.12);
      padding: 0.1rem 0.4rem; border-radius: 4px;
    }
    .w-swap-empty { padding: 1.5rem; text-align: center; color: var(--w-text-muted); font-size: 0.85rem; }

    .w-card {
      background: var(--w-glass); border: 1px solid var(--w-glass-border);
      border-radius: var(--w-radius); padding: 1.25rem 1.4rem;
    }
    .w-balance-card { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
    .w-balance-label { font-size: 0.78rem; color: var(--w-text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
    .w-balance-value { font-size: 2.4rem; font-weight: 600; color: var(--w-accent); margin-top: 0.25rem; }
    .w-balance-value.neg { color: var(--w-red); }
    .w-balance-actions { display: flex; gap: 0.5rem; }
    .w-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.5rem 0.85rem; border-radius: 8px;
      background: var(--w-accent-dim); color: var(--w-accent);
      border: 1px solid var(--w-accent-border);
      font: inherit; font-size: 0.85rem; font-weight: 500;
      cursor: pointer; transition: background 120ms ease, transform 120ms ease;
      text-decoration: none;
    }
    .w-btn:hover { background: rgba(56,189,248,0.18); transform: translateY(-1px); }
    .w-btn.ghost {
      background: transparent; color: var(--w-text-muted);
      border-color: var(--w-glass-border);
    }
    .w-btn.ghost:hover { background: var(--w-glass-hover); color: var(--w-text); }
    .w-btn.danger {
      background: rgba(239,68,68,0.12); color: #f87171;
      border-color: rgba(239,68,68,0.28);
    }
    .w-btn.danger:hover { background: rgba(239,68,68,0.22); color: #fca5a5; }

    .w-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 800px) { .w-grid { grid-template-columns: 1fr; } }

    .w-section-title {
      display: flex; align-items: center; gap: 0.5rem;
      font-size: 0.9rem; font-weight: 600; color: var(--w-text);
      margin-bottom: 0.85rem;
    }
    .w-section-title i { color: var(--w-text-muted); }
    .w-jobs-info {
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px; border-radius: 50%;
      color: var(--w-text-muted); cursor: pointer;
      transition: color 120ms ease, background 120ms ease;
      font-size: 0.78rem;
    }
    .w-jobs-info:hover { color: var(--w-accent, #38bdf8); background: rgba(56,189,248,0.08); }
    .w-jobs-hint {
      font-size: 0.74rem; color: var(--w-text-muted);
      background: rgba(56,189,248,0.06);
      border: 1px solid rgba(56,189,248,0.18);
      border-radius: 6px;
      padding: 0.45rem 0.6rem; margin-bottom: 0.7rem;
      line-height: 1.4;
    }
    .w-jobs-hint a { color: var(--w-accent, #38bdf8); text-decoration: none; }
    .w-jobs-hint a:hover { text-decoration: underline; }

    /* Inbox preview */
    .w-inbox-row {
      display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
      padding: 0.65rem 0.4rem; border-bottom: 1px dashed var(--w-glass-border);
      margin: 0 -0.4rem;
    }
    .w-inbox-row:last-child { border-bottom: 0; }
    .w-inbox-row-link { color: inherit; text-decoration: none; border-radius: 6px; transition: background 120ms ease; }
    .w-inbox-row-link:hover { background: var(--w-glass-hover); }
    .w-inbox-title { font-size: 0.88rem; color: var(--w-text); }
    .w-inbox-meta { font-size: 0.74rem; color: var(--w-text-dim); margin-top: 0.15rem; }
    .w-inbox-amount { font-size: 0.92rem; font-weight: 600; color: var(--w-amber); white-space: nowrap; }
    .w-inbox-amount.paid { color: var(--w-green); }
    .w-inbox-amount.delinquent { color: var(--w-red); }
    .w-empty { font-size: 0.85rem; color: var(--w-text-dim); padding: 0.85rem 0; }

    /* Transaction pagination (shared style — class names preserved
       so .w-shifts-pagination / .w-shifts-page-btn stays a recognizable
       small-pager pattern across the wallet). */
    .w-shifts-pagination {
      display: flex; align-items: center; justify-content: space-between;
      margin-top: 0.75rem; font-size: 0.78rem; color: var(--w-text-dim);
    }
    .w-shifts-page-btn {
      background: transparent; border: 1px solid rgba(255,255,255,0.08);
      color: var(--w-text-muted); padding: 0.35rem 0.7rem; border-radius: 6px;
      cursor: pointer; font: inherit; font-size: 0.75rem;
    }
    .w-shifts-page-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .w-shifts-page-btn:hover:not(:disabled) { color: var(--w-text); border-color: rgba(255,255,255,0.18); }

    /* Transaction ledger — groups by date, each row is icon + title/subtitle + amount + balance-after.
       Bank-statement style: signed amount, post-transaction balance underneath. */
    .w-tx-list { display: flex; flex-direction: column; gap: 1rem; }
    .w-tx-group { display: flex; flex-direction: column; gap: 0.45rem; }
    .w-tx-date {
      font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--w-text-dim);
      padding: 0 0.15rem;
    }
    .w-tx-card {
      background: rgba(255,255,255,0.025);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 10px;
      overflow: hidden;
    }
    .w-tx-row {
      display: grid;
      grid-template-columns: 36px 1fr auto;
      align-items: center;
      gap: 0.85rem;
      padding: 0.7rem 0.85rem;
      cursor: pointer;
      transition: background 0.15s ease;
    }
    .w-tx-row:hover { background: rgba(255,255,255,0.03); }
    .w-tx-row + .w-tx-row { border-top: 1px solid rgba(255,255,255,0.05); }
    .w-tx-icon {
      width: 32px; height: 32px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 0.8rem;
    }
    .w-tx-icon.credit { background: rgba(52,211,153,0.16); color: var(--w-green); }
    .w-tx-icon.debit { background: rgba(239,68,68,0.16); color: var(--w-red); }
    .w-tx-body { min-width: 0; }
    .w-tx-title {
      color: var(--w-text); font-size: 0.88rem; font-weight: 500;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .w-tx-sub {
      color: var(--w-text-dim); font-size: 0.74rem; margin-top: 0.15rem;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .w-tx-trail { text-align: right; font-variant-numeric: tabular-nums; }
    .w-tx-amount { font-size: 0.92rem; font-weight: 600; white-space: nowrap; }
    .w-tx-amount.credit { color: var(--w-green); }
    .w-tx-amount.debit { color: var(--w-red); }
    .w-tx-balance { font-size: 0.7rem; color: var(--w-text-dim); margin-top: 0.15rem; }
    .w-tx-status-pill {
      display: inline-block; padding: 1px 6px; border-radius: 4px;
      font-size: 0.6rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
      background: rgba(148,163,184,0.12); color: var(--w-text-dim); margin-left: 6px;
      vertical-align: middle;
    }
    .w-tx-status-pill.expired { background: rgba(251,191,36,0.14); color: #fbbf24; }
    .w-tx-status-pill.abandoned { background: rgba(148,163,184,0.12); color: #94a3b8; }
    @media (max-width: 480px) {
      .w-tx-row { padding: 0.65rem 0.7rem; gap: 0.65rem; }
      .w-tx-title { font-size: 0.84rem; }
    }

    /* Transaction detail modal — definition-list rendered inside ddModal's
       message slot. ddModal's body centers everything; we override locally so
       the rows read like a receipt. */
    .w-tx-detail { text-align: left; display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.25rem; }
    .w-tx-detail-row {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 0.85rem; padding: 0.35rem 0; font-size: 0.82rem;
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .w-tx-detail-row:last-child { border-bottom: none; }
    .w-tx-detail-label { color: var(--w-text-dim); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .w-tx-detail-value { color: var(--w-text); font-variant-numeric: tabular-nums; text-align: right; }
    .w-tx-detail-value.credit { color: var(--w-green); font-weight: 600; }
    .w-tx-detail-value.debit { color: var(--w-red); font-weight: 600; }
    .w-tx-detail-body {
      margin-top: 0.5rem; padding: 0.65rem 0.75rem; border-radius: 7px;
      background: rgba(255,255,255,0.03); color: var(--w-text-muted);
      font-size: 0.8rem; line-height: 1.5; text-align: left;
    }

    /* Clock-in widget */
    /* Cap the Jobs list around ~8 rows. Communities with many depts were
       stretching the card way past the Recent Inbox card next to it; the
       inbox is short by nature, so the imbalance read as broken. Scroll
       the overflow inside the card instead. */
    .w-clock-list-wrap { position: relative; }
    .w-clock-list {
      display: flex; flex-direction: column; gap: 0.55rem;
      max-height: 32rem;
      overflow-y: auto;
      /* Compensate for the scrollbar gutter so rows don't shift when the
         list grows past the cap. */
      padding-right: 0.25rem;
      margin-right: -0.25rem;
      scrollbar-width: thin;
      scrollbar-color: rgba(255,255,255,0.12) transparent;
    }
    .w-clock-list::-webkit-scrollbar { width: 6px; }
    .w-clock-list::-webkit-scrollbar-track { background: transparent; }
    .w-clock-list::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.10);
      border-radius: 3px;
    }
    .w-clock-list::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.18); }

    /* Scroll affordances. Three layered cues so the cap doesn't read as
       a hidden cliff (users were missing departments below the fold):
         1. Soft fade mask at the edge that has more content.
         2. Floating count chip ("↓ 2 more") with a subtle bounce.
         3. Chip is clickable — taps scroll the next page into view.
       All three fade in/out smoothly as scroll position changes. */
    .w-clock-fade {
      position: absolute; left: 0; right: 0;
      height: 3rem; pointer-events: none; z-index: 1;
      opacity: 0; transition: opacity 0.18s ease;
    }
    .w-clock-fade.is-top {
      top: 0;
      background: linear-gradient(to top, rgba(8,9,12,0) 0%, rgba(8,9,12,0.85) 90%);
      height: 1.75rem;
    }
    .w-clock-fade.is-bottom {
      bottom: 0;
      background: linear-gradient(to bottom, rgba(8,9,12,0) 0%, rgba(8,9,12,0.92) 92%);
    }
    .w-clock-list-wrap.has-more-above .w-clock-fade.is-top { opacity: 1; }
    .w-clock-list-wrap.has-more-below .w-clock-fade.is-bottom { opacity: 1; }

    .w-clock-more {
      position: absolute; left: 50%; bottom: 0.6rem;
      transform: translate(-50%, 0.45rem);
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.32rem 0.75rem;
      font-family: 'Outfit', sans-serif;
      font-size: 0.72rem; font-weight: 500; letter-spacing: 0.02em;
      color: #7dd3fc;
      background: rgba(8,9,12,0.85);
      border: 1px solid rgba(56,189,248,0.32);
      border-radius: 999px;
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 4px 18px rgba(0,0,0,0.45), 0 0 0 1px rgba(56,189,248,0.06) inset;
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.22s cubic-bezier(0.34, 1.4, 0.64, 1), background 0.15s, border-color 0.15s, color 0.15s;
      z-index: 2;
    }
    .w-clock-more:hover { color: #fff; background: rgba(56,189,248,0.18); border-color: rgba(56,189,248,0.55); }
    .w-clock-more:focus-visible {
      outline: 2px solid rgba(56,189,248,0.55);
      outline-offset: 2px;
    }
    .w-clock-list-wrap.has-more-below .w-clock-more {
      opacity: 1; pointer-events: auto;
      transform: translate(-50%, 0);
    }
    .w-clock-more .fa-chevron-down {
      font-size: 0.6rem;
      animation: w-bob 1.9s ease-in-out infinite;
    }
    @keyframes w-bob {
      0%, 55%, 100% { transform: translateY(0); }
      28% { transform: translateY(2px); }
    }
    @media (prefers-reduced-motion: reduce) {
      .w-clock-more .fa-chevron-down { animation: none; }
    }
    .w-clock-row {
      display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
      padding: 0.7rem 0.85rem; border-radius: 8px;
      background: rgba(255,255,255,0.02); border: 1px solid var(--w-glass-border);
    }
    .w-clock-dept { font-size: 0.9rem; font-weight: 500; color: var(--w-text); }
    .w-clock-rate { font-size: 0.74rem; color: var(--w-text-muted); margin-top: 0.1rem; }

    .w-status-pill {
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.25rem 0.55rem; border-radius: 999px;
      font-size: 0.72rem; font-weight: 600;
      background: rgba(34,197,94,0.12); color: var(--w-green);
      border: 1px solid rgba(34,197,94,0.25);
    }
    .w-pulse {
      width: 6px; height: 6px; border-radius: 50%; background: var(--w-green);
      box-shadow: 0 0 0 0 rgba(34,197,94,0.6);
      animation: w-pulse 2s infinite;
    }
    @keyframes w-pulse {
      0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.6); }
      70% { box-shadow: 0 0 0 8px rgba(34,197,94,0); }
      100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
    }

    .w-active-banner {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);
      border-radius: var(--w-radius); padding: 0.85rem 1rem; margin-bottom: 1rem;
    }
    .w-active-info { display: flex; flex-direction: column; gap: 0.15rem; }
    .w-active-info b { font-weight: 600; color: var(--w-green); }
    .w-active-info span { font-size: 0.78rem; color: var(--w-text-muted); }

    .w-spinner {
      display: inline-block; width: 14px; height: 14px;
      border: 2px solid var(--w-text-dim); border-top-color: var(--w-accent);
      border-radius: 50%; animation: w-spin 0.8s linear infinite;
    }
    @keyframes w-spin { to { transform: rotate(360deg); } }

    /* ---------- Send Money modal — multi-step bottom sheet ---------- */
    .w-btn.primary {
      background: var(--w-accent);
      color: #0b1220;
      border-color: var(--w-accent);
      font-weight: 600;
      box-shadow: 0 6px 16px rgba(56,189,248,0.25);
    }
    .w-btn.primary:hover {
      background: #67d2fa; color: #0b1220; transform: translateY(-1px);
      box-shadow: 0 8px 22px rgba(56,189,248,0.35);
    }
    .w-btn.primary:disabled, .w-btn.primary[disabled] {
      opacity: 0.55; cursor: not-allowed; transform: none;
      box-shadow: 0 6px 16px rgba(56,189,248,0.12);
    }

    .w-send-backdrop {
      position: fixed; inset: 0; background: rgba(2,6,12,0.6);
      backdrop-filter: blur(6px);
      opacity: 0; pointer-events: none;
      transition: opacity 160ms ease;
      z-index: 70;
    }
    .w-send-backdrop.is-open { opacity: 1; pointer-events: auto; }
    .w-send-modal {
      position: fixed; top: 50%; left: 50%;
      transform: translate(-50%, -48%) scale(0.97);
      width: min(520px, calc(100vw - 2rem));
      max-height: min(86vh, 720px);
      display: flex; flex-direction: column;
      background: #0b1220;
      border: 1px solid rgba(56,189,248,0.22);
      border-radius: 16px;
      box-shadow: 0 30px 70px rgba(0,0,0,0.6);
      opacity: 0; pointer-events: none;
      transition: opacity 160ms ease, transform 160ms ease;
      z-index: 71;
      overflow: hidden;
    }
    .w-send-modal.is-open { opacity: 1; pointer-events: auto; transform: translate(-50%, -50%) scale(1); }
    .w-send-header {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.9rem 1.1rem; border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .w-send-kicker {
      font-size: 0.62rem; font-weight: 800; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--w-accent);
    }
    .w-send-title {
      font-size: 1.05rem; font-weight: 600; color: var(--w-text);
      margin-top: 0.1rem; letter-spacing: -0.005em;
    }
    .w-send-dots { display: inline-flex; gap: 5px; align-items: center; }
    .w-send-dot {
      width: 6px; height: 6px; border-radius: 999px;
      background: rgba(255,255,255,0.18);
      transition: width 160ms ease, background 160ms ease;
    }
    .w-send-dot.is-active { width: 18px; background: var(--w-accent); }
    .w-send-dot.is-done { background: rgba(56,189,248,0.5); }
    .w-send-close {
      width: 28px; height: 28px; border-radius: 999px; border: 0;
      background: rgba(255,255,255,0.06); color: var(--w-text);
      cursor: pointer; display: grid; place-items: center;
    }
    .w-send-close:hover { background: rgba(255,255,255,0.12); }

    .w-send-body { padding: 1rem 1.1rem 1.1rem; overflow-y: auto; }

    .w-recipient-pill {
      display: flex; align-items: center; gap: 0.7rem;
      background: rgba(56,189,248,0.08);
      border: 1px solid rgba(56,189,248,0.25);
      border-radius: 12px; padding: 0.55rem 0.7rem;
      cursor: pointer; margin-bottom: 0.9rem;
      transition: background 120ms ease;
    }
    .w-recipient-pill:hover { background: rgba(56,189,248,0.12); }
    .w-recipient-avatar {
      width: 32px; height: 32px; border-radius: 999px; overflow: hidden;
      background: rgba(56,189,248,0.16); color: var(--w-accent);
      display: grid; place-items: center; font-weight: 700; font-size: 0.72rem;
      flex-shrink: 0;
    }
    .w-recipient-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .w-recipient-cap {
      font-size: 0.6rem; font-weight: 800; letter-spacing: 0.14em;
      color: var(--w-text-muted); text-transform: uppercase;
    }
    .w-recipient-name { font-size: 0.92rem; font-weight: 600; color: var(--w-text); margin-top: 0.1rem; }
    .w-recipient-change { font-size: 0.74rem; color: var(--w-accent); font-weight: 600; }

    /* Step 0 — recipient list */
    .w-send-search {
      display: flex; align-items: center; gap: 0.5rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px; padding: 0.55rem 0.75rem;
      margin-bottom: 0.7rem;
    }
    .w-send-search i { color: var(--w-text-muted); font-size: 0.78rem; }
    .w-send-search input {
      background: transparent; border: 0; outline: 0; color: var(--w-text);
      flex: 1; font-size: 0.88rem; font-family: inherit;
    }
    .w-recipient-list { display: flex; flex-direction: column; gap: 0.35rem; max-height: 320px; overflow-y: auto; }
    .w-recipient-row {
      display: flex; align-items: center; gap: 0.7rem;
      padding: 0.55rem 0.65rem; border-radius: 10px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.05);
      cursor: pointer; transition: background 120ms ease;
    }
    .w-recipient-row:hover { background: rgba(56,189,248,0.07); border-color: rgba(56,189,248,0.20); }
    .w-recipient-row .who { flex: 1; min-width: 0; font-size: 0.9rem; color: var(--w-text); }
    .w-recipient-row .who small { display: block; font-size: 0.7rem; color: var(--w-text-dim); margin-top: 0.1rem; }
    .w-recipient-row .chev { color: var(--w-text-dim); font-size: 0.7rem; }

    /* Step 1 — amount */
    .w-amount-display {
      text-align: center; padding: 1.25rem 0 0.4rem;
      font-size: 3.1rem; font-weight: 600; letter-spacing: -0.03em;
      color: var(--w-text); font-variant-numeric: tabular-nums;
    }
    .w-amount-display.neg { color: var(--w-red); }
    .w-amount-balance {
      text-align: center; color: var(--w-text-muted);
      font-size: 0.82rem; margin-bottom: 0.9rem;
    }
    .w-amount-balance b { color: var(--w-text); font-weight: 600; }
    .w-amount-input {
      width: 100%; background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px; padding: 0.7rem 0.85rem;
      color: var(--w-text); font: inherit; font-size: 1rem;
      text-align: center; letter-spacing: 0.02em;
      margin-bottom: 0.7rem;
    }
    .w-amount-input:focus { outline: 0; border-color: rgba(56,189,248,0.5); }
    .w-quick-row { display: flex; gap: 0.4rem; margin-bottom: 0.9rem; }
    .w-quick-chip {
      flex: 1; padding: 0.5rem 0; border-radius: 8px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      color: var(--w-text); font: inherit; font-size: 0.78rem; font-weight: 600;
      cursor: pointer; transition: background 120ms;
    }
    .w-quick-chip:hover { background: rgba(56,189,248,0.10); border-color: rgba(56,189,248,0.30); }
    .w-quick-chip.accent { color: var(--w-accent); border-color: rgba(56,189,248,0.30); background: rgba(56,189,248,0.08); }
    .w-quick-chip.accent:hover { background: rgba(56,189,248,0.16); }

    .w-insufficient {
      display: flex; gap: 0.6rem; align-items: flex-start;
      background: rgba(239,68,68,0.10);
      border: 1px solid rgba(239,68,68,0.30);
      border-radius: 10px; padding: 0.7rem 0.85rem;
      margin: 0.4rem 0 0.2rem;
    }
    .w-insufficient i { color: var(--w-red); font-size: 0.95rem; margin-top: 0.1rem; }
    .w-insufficient-title { color: var(--w-red); font-weight: 700; font-size: 0.86rem; }
    .w-insufficient-body { color: var(--w-text-muted); font-size: 0.78rem; margin-top: 0.15rem; line-height: 1.4; }
    .w-insufficient-body b { color: var(--w-accent); font-weight: 600; cursor: pointer; }

    /* Step 2 — memo */
    .w-memo-input {
      width: 100%; min-height: 110px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px; padding: 0.85rem 1rem;
      color: var(--w-text); font: inherit; font-size: 0.95rem; line-height: 1.5;
      resize: vertical;
    }
    .w-memo-input:focus { outline: 0; border-color: rgba(56,189,248,0.5); }
    .w-memo-footer {
      display: flex; justify-content: space-between; align-items: center;
      margin-top: 0.4rem; padding: 0 0.2rem;
    }
    .w-memo-hint { font-size: 0.72rem; color: var(--w-text-dim); }
    .w-memo-count { font-size: 0.72rem; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--w-text-dim); }
    .w-memo-count.warn { color: var(--w-amber); }
    .w-memo-count.danger { color: var(--w-red); }

    /* Step 3 — receipt */
    .w-receipt {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 14px; padding: 1.2rem 1.4rem;
      position: relative;
    }
    .w-receipt::before, .w-receipt::after {
      content: ''; position: absolute; left: 0; right: 0;
      height: 1px; background: rgba(255,255,255,0.10);
    }
    .w-receipt::before { top: 18px; }
    .w-receipt::after { bottom: 18px; }
    .w-receipt-kicker {
      text-align: center; color: var(--w-accent);
      font-size: 0.65rem; letter-spacing: 0.18em; font-weight: 800;
      text-transform: uppercase; padding-top: 0.4rem;
    }
    .w-receipt-amount {
      text-align: center; color: var(--w-text);
      font-size: 2.6rem; font-weight: 600; letter-spacing: -0.025em;
      font-variant-numeric: tabular-nums; margin-top: 0.1rem; margin-bottom: 0.65rem;
    }
    .w-receipt-divider { height: 1px; background: rgba(255,255,255,0.06); margin: 0.4rem 0 0.5rem; }
    .w-receipt-row {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding: 0.45rem 0; gap: 0.7rem;
    }
    .w-receipt-k {
      color: var(--w-text-muted); font-size: 0.7rem;
      letter-spacing: 0.10em; text-transform: uppercase; font-weight: 700;
    }
    .w-receipt-v {
      color: var(--w-text); font-size: 0.92rem; font-weight: 600;
      text-align: right; font-variant-numeric: tabular-nums; flex: 1;
    }
    .w-receipt-v.memo { font-weight: 400; font-style: italic; color: var(--w-text-muted); }

    .w-send-footer {
      display: flex; gap: 0.5rem; padding: 0.85rem 1.1rem 1.1rem;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .w-send-footer .grow { flex: 1; justify-content: center; }
    .w-send-error {
      margin: 0.6rem 1.1rem 0.2rem; padding: 0.6rem 0.85rem;
      background: rgba(239,68,68,0.10);
      border: 1px solid rgba(239,68,68,0.30);
      border-radius: 8px; color: var(--w-red);
      font-size: 0.84rem;
    }

    /* Transfer-row hint on transaction list */
    .w-tx-icon.transfer-sent { background: rgba(56,189,248,0.16); color: var(--w-accent); }
    .w-tx-icon.transfer-received { background: rgba(52,211,153,0.16); color: var(--w-green); }

    /* Step 4 — success state */
    .w-sent-hero {
      text-align: center;
      padding: 1.2rem 0 0.6rem;
    }
    .w-sent-check {
      width: 78px; height: 78px; border-radius: 999px;
      background: rgba(52,211,153,0.10);
      border: 1px solid rgba(52,211,153,0.30);
      display: grid; place-items: center;
      margin: 0 auto 0.9rem;
      animation: w-sent-pop 320ms cubic-bezier(.2,1.2,.4,1) both;
    }
    .w-sent-check i {
      font-size: 2.1rem; color: var(--w-green);
    }
    @keyframes w-sent-pop {
      0%   { transform: scale(0.6); opacity: 0; }
      60%  { transform: scale(1.08); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .w-sent-headline {
      font-size: 1.5rem; font-weight: 600; color: var(--w-text);
      letter-spacing: -0.015em; font-variant-numeric: tabular-nums;
    }
    .w-sent-subline {
      font-size: 0.86rem; color: var(--w-text-muted); margin-top: 0.2rem;
    }
    .w-sent-subline b { color: var(--w-text); font-weight: 600; }
  </style>
</head>
<body>

<%- include('partials/standalone-utility', {
  user: user,
  communityName: communityName,
  pageLabel: 'Wallet',
  backHref: '/civ-dashboard',
  backLabel: 'Back to dashboard',
  useLastDashboard: true
}) %>

<%- include('partials/dd-modal') %>

<div class="w-shell">
  <div class="w-header">
    <div class="w-header-icon"><i class="fa fa-wallet"></i></div>
    <div>
      <div class="w-title" style="display:flex; align-items:center; gap:0.5rem;">Wallet<% if (new Date() < new Date('2026-05-26')) { %><span style="background:linear-gradient(135deg, rgba(99,102,241,0.25), rgba(168,85,247,0.25)); color:#c4b5fd; padding:2px 8px; border-radius:4px; font-size:10px; font-weight:700; letter-spacing:0.8px; text-transform:uppercase; border:1px solid rgba(139,92,246,0.3);">Beta</span><% } %></div>
      <div class="w-subtitle w-subtitle-row">
        <span id="walletSubtitle"><%= civilianId ? 'Loading civilian…' : (communityName || 'this community') %></span>
        <% if (civilianId) { %>
        <button type="button" class="w-swap-btn" id="swapCivBtn" title="Switch civilian" aria-label="Switch civilian">
          <i class="fa fa-right-left"></i>
        </button>
        <% if (isActiveCivilian) { %>
        <span class="w-active-pill" title="This is the civilian the wallet, inbox, and bot default to."><i class="fa fa-check"></i> Active</span>
        <% } else if (activeCivilianId) { %>
        <button type="button" class="w-set-active-btn" id="setActiveBtn" title="Make this civilian the default for the wallet, inbox, and bot.">
          <i class="fa fa-thumbtack"></i> Set as active
        </button>
        <% } else { %>
        <button type="button" class="w-set-active-btn" id="setActiveBtn" title="Pin this civilian as the default for the wallet, inbox, and bot.">
          <i class="fa fa-thumbtack"></i> Set as active
        </button>
        <% } %>
        <% } %>
      </div>
    </div>
  </div>

  <% if (typeof economyEnabled !== 'undefined' && !economyEnabled) { %>
  <!-- Disabled state: this community has no department with economy turned on.
       The Wallet/Inbox nav items are hidden in that case, so this view only
       surfaces when someone deep-links here directly. -->
  <div class="w-card" style="text-align:center; padding:2.5rem 1.5rem; border:1px solid rgba(245,158,11,0.25); background:rgba(245,158,11,0.06);">
    <div style="font-size:2.5rem; color:#f59e0b; margin-bottom:0.75rem;">
      <i class="fa fa-circle-pause"></i>
    </div>
    <div style="font-size:1.1rem; font-weight:600; color:var(--w-text); margin-bottom:0.4rem;">
      Economy is disabled for <strong><%= communityName || 'this community' %></strong>
    </div>
    <div style="font-size:0.9rem; color:var(--w-text-muted); max-width:38rem; margin:0 auto;">
      Contact a community admin if this seems incorrect.
    </div>
  </div>
  <% } else if (!civilianId) { %>
  <!-- Empty state: user has no civilian in this community -->
  <div class="w-card" style="text-align:center; padding:2.5rem 1.5rem;">
    <div style="font-size:2.5rem; color:var(--w-text-muted); margin-bottom:0.75rem;">
      <i class="fa fa-user-plus"></i>
    </div>
    <div style="font-size:1.1rem; font-weight:600; color:var(--w-text); margin-bottom:0.4rem;">
      No civilian in <%= communityName || 'this community' %>
    </div>
    <div style="font-size:0.9rem; color:var(--w-text-muted); margin-bottom:1.25rem; max-width:36rem; margin-left:auto; margin-right:auto;">
      The wallet, jobs, and inbox are tied to a civilian. Create one in this community to start earning, clocking in, and paying tickets.
    </div>
    <% if (encodedCommunityId) { %>
    <a class="w-btn" href="/community/<%= encodedCommunityId %>#civilians-section" style="display:inline-flex; align-items:center; gap:0.4rem;">
      <i class="fa fa-plus"></i> Create a civilian
    </a>
    <% } else { %>
    <a class="w-btn" href="/communities" style="display:inline-flex; align-items:center; gap:0.4rem;">
      <i class="fa fa-layer-group"></i> Pick a community
    </a>
    <% } %>
  </div>
  <% } else { %>

  <div class="w-swap-backdrop" id="swapBackdrop"></div>
  <div class="w-swap-modal" id="swapModal" role="dialog" aria-modal="true" aria-label="Switch civilian">
    <div class="w-swap-header">
      <span><i class="fa fa-right-left" style="margin-right:0.4rem; color:var(--w-text-muted);"></i> Switch civilian</span>
      <button type="button" id="swapCloseBtn" aria-label="Close"><i class="fa fa-times"></i></button>
    </div>
    <div class="w-swap-search">
      <i class="fa fa-search"></i>
      <input type="search" id="swapSearch" placeholder="Search your civilians…" autocomplete="off">
    </div>
    <div class="w-swap-list" id="swapList"><div class="w-swap-empty">Loading civilians…</div></div>
  </div>

  <!-- Active session banner (hidden until loaded) -->
  <div class="w-active-banner" id="activeBanner" style="display:none;">
    <div class="w-active-info">
      <b id="activeDeptName">On the clock</b>
      <span id="activeSessionMeta">—</span>
    </div>
    <button class="w-btn ghost" id="clockOutBtn"><i class="fa fa-stop"></i> Clock out</button>
  </div>

  <!-- Balance card -->
  <div class="w-card w-balance-card">
    <div>
      <div class="w-balance-label">Current Balance</div>
      <div class="w-balance-value" id="balanceValue">—</div>
    </div>
    <div class="w-balance-actions">
      <button type="button" class="w-btn primary" id="sendMoneyBtn"><i class="fa fa-paper-plane"></i> Send money</button>
      <a class="w-btn ghost" href="/inbox?c=<%= encodedCivId || '' %>"><i class="fa fa-inbox"></i> Inbox</a>
    </div>
  </div>

  <!-- Send Money modal — multi-step bottom sheet (recipient → amount → memo → review) -->
  <div class="w-send-backdrop" id="sendBackdrop"></div>
  <div class="w-send-modal" id="sendModal" role="dialog" aria-modal="true" aria-label="Send money">
    <div class="w-send-header">
      <div style="flex:1;">
        <div class="w-send-kicker">Send money</div>
        <div class="w-send-title" id="sendStepTitle">Send to</div>
      </div>
      <div class="w-send-dots" id="sendDots">
        <span class="w-send-dot is-active"></span>
        <span class="w-send-dot"></span>
        <span class="w-send-dot"></span>
        <span class="w-send-dot"></span>
      </div>
      <button type="button" class="w-send-close" id="sendCloseBtn" aria-label="Close"><i class="fa fa-times"></i></button>
    </div>
    <div class="w-send-error" id="sendError" style="display:none;"></div>
    <div class="w-send-body" id="sendBody"></div>
    <div class="w-send-footer" id="sendFooter" style="display:none;">
      <button type="button" class="w-btn ghost" id="sendBackBtn"><i class="fa fa-arrow-left"></i> Back</button>
      <button type="button" class="w-btn primary grow" id="sendNextBtn">Continue <i class="fa fa-chevron-right"></i></button>
    </div>
  </div>

  <!-- Two-column: recent inbox + clock-in -->
  <div class="w-grid">
    <div class="w-card">
      <div class="w-section-title"><i class="fa fa-receipt"></i> Recent Inbox</div>
      <div id="recentInbox"><div class="w-empty">Loading…</div></div>
    </div>

    <div class="w-card">
      <div class="w-section-title" style="justify-content:space-between;">
        <span style="display:inline-flex; align-items:center; gap:0.5rem;"><i class="fa fa-briefcase"></i> Jobs</span>
        <span id="jobsInfo" class="w-jobs-info" title=""><i class="fa fa-circle-info"></i></span>
      </div>
      <div class="w-jobs-hint" id="jobsHint" style="display:none;"></div>
      <div class="w-clock-list-wrap" id="clockListWrap">
        <div class="w-clock-fade is-top" aria-hidden="true"></div>
        <div class="w-clock-list" id="clockList"><div class="w-empty">Loading departments…</div></div>
        <div class="w-clock-fade is-bottom" aria-hidden="true"></div>
        <button type="button" class="w-clock-more" id="clockMoreBtn" aria-label="Scroll for more departments" tabindex="-1">
          <span id="clockMoreCount">More</span>
          <i class="fa fa-chevron-down" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Transaction history -->
  <div class="w-card" style="margin-top:1rem;">
    <div class="w-section-title"><i class="fa fa-clock-rotate-left"></i> Transactions</div>
    <div id="txList" class="w-tx-list"><div class="w-empty">Loading…</div></div>
    <div class="w-shifts-pagination" id="txPagination" style="display:none;">
      <button class="w-shifts-page-btn" id="txPrev" disabled><i class="fa fa-chevron-left"></i> Prev</button>
      <span id="txPageInfo">Page 1</span>
      <button class="w-shifts-page-btn" id="txNext" disabled>Next <i class="fa fa-chevron-right"></i></button>
    </div>
  </div>
  <% } %>
</div>

<script>
  const API_URL = "<%- apiUrl %>";
  const CIVILIAN_ID = "<%- civilianId %>";
  const ENCODED_CIV_ID = "<%- encodedCivId %>";
  const COMMUNITY_ID = "<%- communityId %>";
  const ENCODED_COMMUNITY_ID = "<%- encodedCommunityId %>";
  const USER_ID = "<%- userId %>";
  const CIVILIAN_NAME = "<%- civilianName %>";
  // The "active civilian" the wallet/inbox/bot default to. Distinct from
  // CIVILIAN_ID: the user can browse another civilian's wallet without
  // changing this. Empty string when no pick is persisted yet.
  let ACTIVE_CIVILIAN_ID = "<%- activeCivilianId %>";
  // Community currency — sourced from community.penalCodes (fines are
  // deprecated). Falls back to USD/$ when not configured.
  const CURRENCY_SYMBOL = <%- JSON.stringify(currencySymbol || '$') %>;

  // When the user has no civilian in this community, the EJS renders an
  // empty-state card instead of the wallet shell — none of the elements
  // wired up below exist on the page, so bail out before touching them.
  if (CIVILIAN_ID) {
  document.getElementById('walletSubtitle').textContent = CIVILIAN_NAME || 'Civilian';

  function fmtMoney(cents) {
    const sign = cents < 0 ? '-' : '';
    const abs = Math.abs(cents);
    const dollars = Math.floor(abs / 100);
    const rem = abs % 100;
    return sign + CURRENCY_SYMBOL + dollars.toLocaleString() + '.' + String(rem).padStart(2, '0');
  }

  async function refreshWallet() {
    const balEl = document.getElementById('balanceValue');
    const inboxHost = document.getElementById('recentInbox');
    try {
      const res = await fetch(`${API_URL}/api/v2/economy/wallet/${CIVILIAN_ID}`);
      if (!res.ok) {
        const txt = await res.text().catch(() => '');
        throw new Error(`HTTP ${res.status}${txt ? ': ' + txt.slice(0, 200) : ''}`);
      }
      const data = await res.json();
      balEl.textContent = fmtMoney(data.balance || 0);
      balEl.classList.toggle('neg', (data.balance || 0) < 0);
      renderRecentInbox(data.recentInbox || []);
    } catch (err) {
      console.error('wallet load failed:', err);
      balEl.textContent = '—';
      inboxHost.innerHTML = '<div class="w-empty" style="color:#ef4444;">Wallet API unavailable. ' + escapeHtml(err.message || '') + '</div>';
    }
  }

  function renderRecentInbox(items) {
    const host = document.getElementById('recentInbox');
    if (!items.length) { host.innerHTML = '<div class="w-empty">No items in your inbox.</div>'; return; }
    const civParam = ENCODED_CIV_ID ? '?c=' + encodeURIComponent(ENCODED_CIV_ID) : '';
    host.innerHTML = items.slice(0, 5).map(it => {
      const isTransferRcvd = it.type === 'transfer-received';
      const isTransferSent = it.type === 'transfer-sent';
      // Transfer items store signed amounts (negative = credit). Render them
      // with explicit +/- so a received transfer reads as a gain.
      const absAmt = Math.abs(it.amount || 0);
      const amtText = isTransferRcvd ? '+' + fmtMoney(absAmt)
                    : isTransferSent ? '-' + fmtMoney(absAmt)
                    : fmtMoney(it.amount || 0);
      const cls = isTransferRcvd ? 'paid'
                : isTransferSent ? 'delinquent'
                : (it.status === 'paid' ? 'paid' : (it.status === 'delinquent' ? 'delinquent' : ''));
      const meta = (isTransferRcvd || isTransferSent)
        ? (it.memo ? '“' + it.memo + '”' : 'Peer transfer')
        : (it.source || '') + ' · ' + (it.status || '');
      // Link each row to the corresponding item in /inbox. Hash is read by the
      // inbox page to scroll + highlight after the list loads.
      const href = '/inbox' + civParam + '#item-' + encodeURIComponent(it._id || '');
      return `
        <a class="w-inbox-row w-inbox-row-link" href="${href}">
          <div>
            <div class="w-inbox-title">${escapeHtml(it.title || it.type || 'Item')}</div>
            <div class="w-inbox-meta">${escapeHtml(meta)}</div>
          </div>
          <div class="w-inbox-amount ${cls}">${escapeHtml(amtText)}</div>
        </a>
      `;
    }).join('');
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  let activeSession = null;
  let activeTimer = null;

  async function refreshActiveSession() {
    try {
      const res = await fetch(`${API_URL}/api/v2/economy/session/active?civilianId=${encodeURIComponent(CIVILIAN_ID)}`);
      if (!res.ok) {
        console.warn('session/active returned', res.status);
        activeSession = null; renderActive(); rerenderDepartments(); return;
      }
      const text = await res.text();
      activeSession = (!text || text === 'null') ? null : JSON.parse(text);
      renderActive();
      rerenderDepartments();
    } catch (err) {
      console.error('session/active failed:', err);
      activeSession = null; renderActive(); rerenderDepartments();
    }
  }

  function renderActive() {
    const banner = document.getElementById('activeBanner');
    if (!activeSession) { banner.style.display = 'none'; return; }
    banner.style.display = 'flex';
    document.getElementById('activeDeptName').innerHTML =
      `<span class="w-pulse" style="display:inline-block;margin-right:6px;vertical-align:middle;"></span>` +
      `On the clock at <strong>${escapeHtml(activeSession.departmentName || 'department')}</strong>`;
    updateMeta();
    if (activeTimer) clearInterval(activeTimer);
    activeTimer = setInterval(updateMeta, 1000);
  }

  function updateMeta() {
    if (!activeSession) return;
    const start = new Date(activeSession.startedAt);
    const elapsedSec = Math.max(0, Math.floor((Date.now() - start.getTime()) / 1000));
    const h = Math.floor(elapsedSec / 3600);
    const m = Math.floor((elapsedSec % 3600) / 60);
    const s = elapsedSec % 60;
    const earnings = ((activeSession.payRateSnapshot || 0) * elapsedSec / 3600);
    const earned = Math.min(earnings, (activeSession.payRateSnapshot || 0) * (activeSession.maxSessionMinutes || 0) / 60);
    document.getElementById('activeSessionMeta').textContent =
      `${pad(h)}:${pad(m)}:${pad(s)} elapsed · ${fmtMoney(Math.floor(earned))} earned (estimate)`;
  }
  function pad(n) { return String(n).padStart(2, '0'); }

  document.getElementById('clockOutBtn').addEventListener('click', async () => {
    if (!activeSession) return;
    if (window.ddModal) {
      window.ddModal({
        type: 'warning', icon: 'fa-stop',
        title: 'Clock out?',
        message: 'This will finalize your shift and credit any pending pay to your civilian.',
        confirmText: 'Clock out',
        onConfirm: doClockOut,
      });
    } else { doClockOut(); }
  });

  async function doClockOut() {
    try {
      await fetch(`${API_URL}/api/v2/economy/clock-out?userId=${encodeURIComponent(USER_ID)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId: activeSession._id }),
      });
      activeSession = null;
      if (activeTimer) clearInterval(activeTimer);
      await Promise.all([refreshWallet(), refreshActiveSession(), refreshDepartments(), refreshTransactions()]);
    } catch (err) { console.error(err); }
  }

  function updateJobsInfo(shownCount, totalCount) {
    const info = document.getElementById('jobsInfo');
    const hint = document.getElementById('jobsHint');
    if (!info || !hint) return;
    const hiddenCount = Math.max(0, totalCount - shownCount);
    const summary = totalCount === 0
      ? 'This community has no departments yet.'
      : `Showing ${shownCount} of ${totalCount} department${totalCount === 1 ? '' : 's'} — only departments with economy enabled appear here.`;
    info.setAttribute('title', summary);
    let msg = summary;
    if (hiddenCount > 0) {
      msg += ` <a href="/economy-settings">Enable economy on more departments →</a>`;
    }
    hint.innerHTML = msg;
    info.onclick = () => {
      hint.style.display = hint.style.display === 'none' ? 'block' : 'none';
    };
  }

  async function refreshDepartments() {
    const host = document.getElementById('clockList');
    if (!COMMUNITY_ID) {
      host.innerHTML = '<div class="w-empty">This civilian has no active community. Open the civilian and pick a community first.</div>';
      return;
    }
    try {
      const res = await fetch(`${API_URL}/api/v1/community/${COMMUNITY_ID}`);
      if (!res.ok) {
        const txt = await res.text().catch(() => '');
        throw new Error(`HTTP ${res.status}${txt ? ': ' + txt.slice(0, 200) : ''}`);
      }
      const community = await res.json();
      const depts = (community.community && community.community.departments) || [];

      const economyDepts = depts.filter(d => d.economyEnabled);
      updateJobsInfo(economyDepts.length, depts.length);
      const decorated = economyDepts.map(d => {
        const approvalRequired = !!d.approvalRequired;
        const isExplicitMember = (d.members || []).some(m => m.userID === USER_ID);
        // Public departments treat any community member as implicitly eligible.
        const isMember = isExplicitMember || !approvalRequired;
        return { dept: d, isMember };
      });
      decorated.sort((a, b) => (b.isMember ? 1 : 0) - (a.isMember ? 1 : 0));
      renderDepartments(decorated);
    } catch (err) {
      console.error('community load failed:', err);
      host.innerHTML = '<div class="w-empty" style="color:#ef4444;">Could not load departments. ' + escapeHtml(err.message || '') + '</div>';
    }
  }

  // Cache the latest department list so we can re-render when the active
  // session changes (clock-in / clock-out) without refetching the community.
  let _lastDeptEntries = null;

  function renderDepartments(deptEntries) {
    _lastDeptEntries = deptEntries;
    const host = document.getElementById('clockList');
    const communityHref = ENCODED_COMMUNITY_ID
      ? `/community/${encodeURIComponent(ENCODED_COMMUNITY_ID)}#departments-section`
      : '/communities';

    if (!deptEntries.length) {
      host.innerHTML = '<div class="w-empty">No departments have economy enabled yet. Ask an admin to enable economy on a department, or create a civilian-template department for RP jobs.</div>';
      return;
    }

    const activeDeptId = activeSession && activeSession.departmentId;

    host.innerHTML = deptEntries.map(({ dept: d, isMember }) => {
      const ratePerHr = (d.basePayPerHour || 0);
      const isActiveHere = activeDeptId && d._id === activeDeptId;
      let action;
      let rowExtra = '';
      if (isActiveHere) {
        // This dept owns the live session — let the user clock out directly.
        action = `<button class="w-btn danger" data-action="row-clock-out">` +
          `<i class="fa fa-stop"></i> Clock out</button>`;
        rowExtra = 'style="border-color:rgba(34,197,94,0.32);background:linear-gradient(135deg,rgba(34,197,94,0.06),rgba(255,255,255,0.02));"';
      } else if (isMember) {
        const blocked = !!activeSession; // active elsewhere — block clock-in here
        action = `<button class="w-btn" data-action="clock-in" ${blocked ? 'disabled style="opacity:0.5;cursor:not-allowed;" title="Clock out of your current shift first"' : ''}>` +
          `<i class="fa fa-play"></i> Clock in</button>`;
      } else {
        action = `<a class="w-btn ghost" href="${communityHref}"><i class="fa fa-arrow-up-right-from-square"></i> View department</a>`;
      }
      const dim = (isMember || isActiveHere) ? '' : 'style="opacity:0.75;"';
      const baseAttrs = rowExtra || dim;
      const statusLine = isActiveHere
        ? `<div class="w-clock-rate" style="color:#22c55e;">● On the clock</div>`
        : `<div class="w-clock-rate">${fmtMoney(ratePerHr)} / hr base${isMember ? '' : ' · not a member'}</div>`;
      return `
        <div class="w-clock-row" ${baseAttrs} data-dept-id="${escapeHtml(d._id)}">
          <div>
            <div class="w-clock-dept">${escapeHtml(d.name)}</div>
            ${statusLine}
          </div>
          ${action}
        </div>
      `;
    }).join('');

    host.querySelectorAll('[data-action="clock-in"]').forEach(btn => {
      btn.addEventListener('click', e => {
        const row = e.target.closest('[data-dept-id]');
        clockIn(row.dataset.deptId);
      });
    });
    host.querySelectorAll('[data-action="row-clock-out"]').forEach(btn => {
      btn.addEventListener('click', () => doClockOut());
    });
    // Layout settles on the next frame after innerHTML, so defer the
    // overflow check — otherwise clientHeight/scrollHeight are stale.
    requestAnimationFrame(updateClockListAffordance);
  }

  // Re-render the Jobs panel using the cached dept list. Called after
  // activeSession changes so the active row picks up its "On the clock"
  // styling without a community refetch.
  function rerenderDepartments() {
    if (_lastDeptEntries) renderDepartments(_lastDeptEntries);
  }

  // ---------- Jobs list scroll affordance ----------
  // Users were missing departments below the fold because the list was
  // capped at ~32rem but gave no visual cue. Toggle has-more-above /
  // has-more-below classes on the wrapper so the gradient fades + the
  // "↓ N more" chip animate in, and update the count to whatever's still
  // hidden below the current scroll position.
  function updateClockListAffordance() {
    const wrap = document.getElementById('clockListWrap');
    const list = document.getElementById('clockList');
    const count = document.getElementById('clockMoreCount');
    if (!wrap || !list || !count) return;
    const scrollTop = Math.round(list.scrollTop);
    const clientH = list.clientHeight;
    const scrollH = list.scrollHeight;
    const hasOverflow = scrollH - clientH > 2;
    const remaining = scrollH - (scrollTop + clientH);
    wrap.classList.toggle('has-more-above', scrollTop > 4);
    const showBelow = hasOverflow && remaining > 4;
    wrap.classList.toggle('has-more-below', showBelow);
    if (showBelow) {
      // Count rows that are fully below the visible viewport. More honest
      // than estimating from pixel math since row heights can vary
      // (member/non-member rows differ slightly).
      const rows = list.querySelectorAll('.w-clock-row');
      const fold = scrollTop + clientH;
      let hidden = 0;
      rows.forEach(row => {
        if (row.offsetTop + row.offsetHeight - 4 > fold) hidden++;
      });
      count.textContent = hidden > 0 ? (hidden + ' more') : 'More';
    }
  }

  (function wireClockListAffordance() {
    const list = document.getElementById('clockList');
    const btn = document.getElementById('clockMoreBtn');
    if (!list || !btn) return;
    list.addEventListener('scroll', updateClockListAffordance, { passive: true });
    btn.addEventListener('click', () => {
      // Scroll roughly one viewport down so users can keep paging through.
      // Falls back to scrollTo(end) when remaining < one viewport.
      const step = Math.max(100, list.clientHeight - 40);
      list.scrollTo({ top: list.scrollTop + step, behavior: 'smooth' });
    });
    // Recompute on window resize since clientHeight can change.
    window.addEventListener('resize', updateClockListAffordance, { passive: true });
  })();

  async function clockIn(deptId) {
    // If a different civilian is currently pinned as active, warn the user
    // that this clock-in will swap the pin. The server auto-pins on
    // first-ever clock-in (no active yet) and otherwise preserves the
    // existing pick — so the swap is purely a client-driven, opt-in
    // action. Skip the prompt when no pin exists or the pin already
    // matches this civilian.
    if (ACTIVE_CIVILIAN_ID && ACTIVE_CIVILIAN_ID !== CIVILIAN_ID) {
      const ok = await confirmActiveCivilianSwap();
      if (!ok) return;
    }
    try {
      const res = await fetch(`${API_URL}/api/v2/economy/clock-in?userId=${encodeURIComponent(USER_ID)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ communityId: COMMUNITY_ID, departmentId: deptId, civilianId: CIVILIAN_ID }),
      });
      // The API rejects a second clock-in (any civilian, any dept) for the
      // same user with 409 and the existing session in the body. Offer to
      // clock out the running shift and clock in here, so the user doesn't
      // have to manually navigate to the other dashboard to free things up.
      if (res.status === 409) {
        const existing = await res.json().catch(() => null);
        if (existing && existing._id) {
          await handleClockInConflict(deptId, existing);
          // After a successful swap-shift the active pin should follow
          // the newly clocked-in civilian.
          await syncActiveCivilianToCurrent();
          return;
        }
      }
      if (!res.ok) {
        const txt = await res.text().catch(() => '');
        throw new Error(`clock-in failed: ${res.status}${txt ? ' — ' + txt.slice(0, 200) : ''}`);
      }
      // Mirror server-side auto-pin: if this is a "first clock-in" the
      // server already pinned this civ. If there was a different pin, we
      // got here because the user confirmed the swap above, so update.
      await syncActiveCivilianToCurrent();
      await Promise.all([refreshActiveSession(), refreshWallet(), refreshDepartments()]);
      startHeartbeat();
    } catch (err) {
      console.error(err);
      if (window.ddModal) window.ddModal({ type: 'danger', icon: 'fa-triangle-exclamation', title: 'Could not clock in', message: err.message });
    }
  }

  // Warn-then-confirm modal for the "clock in here will swap your active
  // civilian" case. Resolves to true on confirm, false on cancel/close.
  // ddModal is provided by views/partials/dd-modal.ejs (included at the
  // top of this page). Per policy we never fall back to browser confirm.
  function confirmActiveCivilianSwap() {
    return new Promise((resolve) => {
      const name = escapeHtml(CIVILIAN_NAME || 'this civilian');
      window.ddModal({
        type: 'warning',
        icon: 'fa-thumbtack',
        title: 'Change active civilian?',
        message: 'This will make <strong>' + name + '</strong> your active civilian.',
        detail: 'Wallet, inbox, and bot default here.',
        confirmText: 'Clock in & set active',
        confirmIcon: 'fa-play',
        onConfirm: () => resolve(true),
        onCancel: () => resolve(false),
      });
    });
  }

  // Push the current civilian as the active pick. Used after a clock-in
  // succeeds (covers both the explicit-swap case the user confirmed
  // above and the 409 swap-shift recovery). Idempotent and silent: if
  // the pin already matches we skip the API call; if the call fails we
  // log but don't pop a modal — the clock-in itself succeeded.
  async function syncActiveCivilianToCurrent() {
    if (!USER_ID || !COMMUNITY_ID || !CIVILIAN_ID) return;
    if (ACTIVE_CIVILIAN_ID === CIVILIAN_ID) return;
    try {
      const r = await fetch(`${API_URL}/api/v2/user/active-civilian`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: USER_ID, communityId: COMMUNITY_ID, civilianId: CIVILIAN_ID }),
      });
      if (!r.ok) return;
      ACTIVE_CIVILIAN_ID = CIVILIAN_ID;
      const btn = document.getElementById('setActiveBtn');
      if (btn) {
        const pill = document.createElement('span');
        pill.className = 'w-active-pill';
        pill.title = 'This is the civilian the wallet, inbox, and bot default to.';
        pill.innerHTML = '<i class="fa fa-check"></i> Active';
        btn.replaceWith(pill);
      }
    } catch (err) {
      console.warn('syncActiveCivilianToCurrent failed', err);
    }
  }

  async function handleClockInConflict(deptId, existing) {
    var deptName = escapeHtml(existing.departmentName || 'another department');
    var sameCiv = existing.civilianId && existing.civilianId === CIVILIAN_ID;
    var newName = escapeHtml(CIVILIAN_NAME || 'this civilian');
    var msg = sameCiv
      ? 'Already on the clock at <strong>' + deptName + '</strong>. Clock out and start a new shift here?'
      : 'Another civilian is on the clock at <strong>' + deptName + '</strong>. Clock them out and clock in as <strong>' + newName + '</strong>?';
    window.ddModal({
      type: 'warning',
      icon: 'fa-triangle-exclamation',
      title: 'Already on the clock',
      message: msg,
      detail: 'Running shift earnings finalize first.',
      confirmText: 'Clock out & clock in here',
      confirmIcon: 'fa-arrows-rotate',
      onConfirm: function () { swapClockIn(deptId, existing); },
    });
  }

  async function swapClockIn(deptId, existing) {
    try {
      // Best-effort clock-out: if it fails we still surface the error
      // rather than blindly trying to clock in (which would just 409 again).
      const outRes = await fetch(`${API_URL}/api/v2/economy/clock-out?userId=${encodeURIComponent(USER_ID)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId: existing._id }),
      });
      if (!outRes.ok) {
        const txt = await outRes.text().catch(() => '');
        throw new Error(`clock-out failed: ${outRes.status}${txt ? ' — ' + txt.slice(0, 200) : ''}`);
      }
      const inRes = await fetch(`${API_URL}/api/v2/economy/clock-in?userId=${encodeURIComponent(USER_ID)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ communityId: COMMUNITY_ID, departmentId: deptId, civilianId: CIVILIAN_ID }),
      });
      if (!inRes.ok) {
        const txt = await inRes.text().catch(() => '');
        throw new Error(`clock-in failed: ${inRes.status}${txt ? ' — ' + txt.slice(0, 200) : ''}`);
      }
      await Promise.all([refreshActiveSession(), refreshWallet(), refreshDepartments()]);
      startHeartbeat();
    } catch (err) {
      console.error(err);
      if (window.ddModal) window.ddModal({ type: 'danger', icon: 'fa-triangle-exclamation', title: 'Could not swap shift', message: err.message });
    }
  }

  let heartbeatTimer = null;
  function startHeartbeat() {
    if (heartbeatTimer) clearInterval(heartbeatTimer);
    heartbeatTimer = setInterval(async () => {
      if (!activeSession) return;
      try {
        const res = await fetch(`${API_URL}/api/v2/economy/heartbeat?userId=${encodeURIComponent(USER_ID)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: activeSession._id }),
        });
        if (res.status === 410) {
          activeSession = null; renderActive(); await refreshWallet(); return;
        }
        if (res.ok) {
          const data = await res.json();
          if (data && data.session) activeSession = data.session;
        }
      } catch (err) { console.error('heartbeat failed', err); }
    }, 30000);
  }

  // ---------- Transaction history ----------
  let txPage = 1;
  const TX_LIMIT = 10;

  function fmtDuration(seconds) {
    const s = Math.max(0, Math.floor(Number(seconds) || 0));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    if (h === 0) return m + 'm';
    if (m === 0) return h + 'h';
    return h + 'h ' + m + 'm';
  }
  function fmtShiftTime(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    return d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
  }
  // Bucket label for date-grouping. Mirrors the mobile wallet's
  // Today / Yesterday / weekday / full-date scheme so the two surfaces feel
  // like the same ledger.
  function txDateLabel(iso) {
    if (!iso) return 'Unknown';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return 'Unknown';
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const dDay = new Date(d); dDay.setHours(0, 0, 0, 0);
    const diff = Math.round((today - dDay) / 86400000);
    if (diff === 0) return 'Today';
    if (diff === 1) return 'Yesterday';
    if (diff > 1 && diff < 7) return d.toLocaleDateString(undefined, { weekday: 'long' });
    return d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
  }
  // Map a transaction to a FontAwesome glyph that mirrors the mobile wallet:
  // briefcase for shifts, gavel for citations/court verdicts, etc. The swatch
  // color is still driven by `direction` (green for credits, red for debits)
  // so the icon adds *what* without changing the at-a-glance +/- signal.
  function txIconClass(tx) {
    if (tx.type === 'shift') return 'fa fa-briefcase';
    if (tx.type === 'payroll') return 'fa fa-money-bill-trend-up';
    if (tx.type === 'transfer-sent') return 'fa fa-arrow-up-right-from-square';
    if (tx.type === 'transfer-received') return 'fa fa-arrow-down-to-bracket';
    const src = (tx.subtitle || '').toLowerCase();
    if (src === 'citation') return 'fa fa-gavel';
    if (src === 'judicial' || tx.type === 'verdict') return 'fa fa-gavel';
    if (src === 'admin') return 'fa fa-user-shield';
    if (src === 'shop') return 'fa fa-cart-shopping';
    if (src === 'system') return 'fa fa-circle-info';
    if (tx.type === 'fee') return 'fa fa-receipt';
    if (tx.type === 'fine') return 'fa fa-file-invoice-dollar';
    return tx.direction === 'credit' ? 'fa fa-plus' : 'fa fa-minus';
  }
  function txTitle(tx) {
    if (tx.type === 'shift') return (tx.departmentName || tx.title || 'Department') + ' shift';
    return tx.title || (tx.direction === 'credit' ? 'Credit' : 'Charge');
  }
  function txSubtitle(tx) {
    const parts = [];
    if (tx.type === 'shift') {
      if (tx.paidSeconds) parts.push(fmtDuration(tx.paidSeconds));
      if (tx.status && tx.status !== 'ended') parts.push(`<span class="w-tx-status-pill ${escapeHtml(tx.status)}">${escapeHtml(tx.status)}</span>`);
    } else if (tx.subtitle) {
      const s = String(tx.subtitle);
      parts.push(s.charAt(0).toUpperCase() + s.slice(1));
    }
    const time = fmtShiftTime(tx.occurredAt);
    if (time) parts.push(time);
    return parts.join(' · ');
  }

  async function refreshTransactions() {
    const host = document.getElementById('txList');
    const pag = document.getElementById('txPagination');
    if (!CIVILIAN_ID) {
      host.innerHTML = '<div class="w-empty">No civilian context — transaction history unavailable.</div>';
      return;
    }
    host.innerHTML = '<div class="w-empty">Loading…</div>';
    try {
      const res = await fetch(`${API_URL}/api/v2/economy/transactions/civilian/${CIVILIAN_ID}?page=${txPage}&limit=${TX_LIMIT}`);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const payload = await res.json();
      const data = payload.data || [];
      const total = payload.totalCount || 0;
      if (!data.length) {
        host.innerHTML = '<div class="w-empty">No activity yet. Shift earnings and payments will show up here.</div>';
        pag.style.display = 'none';
        return;
      }
      // Group by date label, preserving newest-first order from the API.
      const groups = [];
      for (const tx of data) {
        const label = txDateLabel(tx.occurredAt);
        let g = groups[groups.length - 1];
        if (!g || g.label !== label) {
          g = { label, items: [] };
          groups.push(g);
        }
        g.items.push(tx);
      }
      host.innerHTML = groups.map(g => `
        <div class="w-tx-group">
          <div class="w-tx-date">${escapeHtml(g.label)}</div>
          <div class="w-tx-card">
            ${g.items.map(tx => {
              const sign = tx.direction === 'credit' ? '+' : '-';
              const balanceLine = tx.balanceAfterKnown
                ? `<div class="w-tx-balance">Balance ${escapeHtml(fmtMoney(tx.balanceAfter || 0))}</div>`
                : '';
              return `
                <div class="w-tx-row" data-tx-ref-type="${escapeHtml(tx.refType)}" data-tx-ref-id="${escapeHtml(tx.refId)}" role="button" tabindex="0">
                  <div class="w-tx-icon ${escapeHtml(tx.direction)}"><i class="${escapeHtml(txIconClass(tx))}"></i></div>
                  <div class="w-tx-body">
                    <div class="w-tx-title">${escapeHtml(txTitle(tx))}</div>
                    <div class="w-tx-sub">${txSubtitle(tx)}</div>
                  </div>
                  <div class="w-tx-trail">
                    <div class="w-tx-amount ${escapeHtml(tx.direction)}">${sign}${escapeHtml(fmtMoney(tx.amount || 0))}</div>
                    ${balanceLine}
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `).join('');
      const totalPages = Math.max(1, Math.ceil(total / TX_LIMIT));
      pag.style.display = totalPages > 1 ? 'flex' : 'none';
      document.getElementById('txPageInfo').textContent = `Page ${txPage} of ${totalPages} · ${total} transaction${total === 1 ? '' : 's'}`;
      document.getElementById('txPrev').disabled = txPage <= 1;
      document.getElementById('txNext').disabled = txPage >= totalPages;
    } catch (err) {
      host.innerHTML = `<div class="w-empty" style="color:#ef4444;">Couldn't load transactions: ${escapeHtml(err.message || '')}</div>`;
    }
  }
  document.getElementById('txPrev').addEventListener('click', () => {
    if (txPage > 1) { txPage -= 1; refreshTransactions(); }
  });
  document.getElementById('txNext').addEventListener('click', () => {
    txPage += 1; refreshTransactions();
  });

  // ---------- Transaction detail modal ----------
  function fmtFullDateTime(iso) {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
  }
  function titleCase(s) {
    if (!s) return '';
    return String(s).replace(/\b\w/g, c => c.toUpperCase());
  }
  function detailRow(label, value, className) {
    const cls = className ? ' ' + className : '';
    return `<div class="w-tx-detail-row"><span class="w-tx-detail-label">${escapeHtml(label)}</span><span class="w-tx-detail-value${cls}">${value}</span></div>`;
  }

  async function openShiftDetail(sessionId) {
    if (!sessionId) return;
    try {
      const res = await fetch(`${API_URL}/api/v2/economy/session/${encodeURIComponent(sessionId)}?userId=${encodeURIComponent(USER_ID)}`);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const s = await res.json();
      if (!s || !s._id) throw new Error('Session not found');
      const rows = [];
      rows.push(detailRow('Department', escapeHtml(s.departmentName || 'Department')));
      rows.push(detailRow('Started', escapeHtml(fmtFullDateTime(s.startedAt))));
      rows.push(detailRow('Ended', escapeHtml(s.endedAt ? fmtFullDateTime(s.endedAt) : '—')));
      rows.push(detailRow('Duration', escapeHtml(fmtDuration(s.paidSeconds))));
      // payRateSnapshot is cents/hr; surface as $/hr for context.
      if (s.payRateSnapshot) rows.push(detailRow('Pay rate', escapeHtml(fmtMoney(s.payRateSnapshot) + '/hr')));
      rows.push(detailRow('Earnings', '+' + escapeHtml(fmtMoney(s.earnings || 0)), 'credit'));
      if (s.balanceAfter) rows.push(detailRow('Balance after', escapeHtml(fmtMoney(s.balanceAfter))));
      const statusLabel = s.status === 'ended' ? 'Completed' : titleCase(s.status || '');
      rows.push(detailRow('Status', escapeHtml(statusLabel)));
      window.ddModal({
        type: 'info',
        icon: 'fa-briefcase',
        title: 'Shift details',
        message: `<div class="w-tx-detail">${rows.join('')}</div>`,
        buttons: [{ label: 'Close', class: 'ddm-btn-secondary' }],
      });
    } catch (err) {
      window.ddModal({ type: 'danger', icon: 'fa-triangle-exclamation', title: 'Couldn’t load shift', message: escapeHtml(err.message || 'Unknown error') });
    }
  }

  async function openInboxDetail(itemId) {
    if (!itemId) return;
    try {
      const res = await fetch(`${API_URL}/api/v2/economy/inbox/${encodeURIComponent(itemId)}?userId=${encodeURIComponent(USER_ID)}`);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const it = await res.json();
      if (!it || !it._id) throw new Error('Item not found');
      const rows = [];
      // Inbox `amount` is signed: positive = owed (debit on pay), negative =
      // credit. Normalize to direction + unsigned amount so the modal reads
      // bank-statement style.
      const amt = it.amount || 0;
      const direction = amt < 0 ? 'credit' : 'debit';
      const absAmt = Math.abs(amt);
      const sign = direction === 'credit' ? '+' : '-';
      const typeLabel = titleCase(it.type || 'Other');
      const sourceLabel = titleCase(it.source || '');
      rows.push(detailRow('Type', escapeHtml(typeLabel)));
      if (sourceLabel) rows.push(detailRow('Source', escapeHtml(sourceLabel)));
      rows.push(detailRow('Amount', sign + escapeHtml(fmtMoney(absAmt)), direction));
      rows.push(detailRow('Issued', escapeHtml(fmtFullDateTime(it.createdAt))));
      if (it.paidAt) rows.push(detailRow('Paid', escapeHtml(fmtFullDateTime(it.paidAt))));
      if (it.dismissedAt) rows.push(detailRow('Dismissed', escapeHtml(fmtFullDateTime(it.dismissedAt))));
      if (it.balanceAfter) rows.push(detailRow('Balance after', escapeHtml(fmtMoney(it.balanceAfter))));
      rows.push(detailRow('Status', escapeHtml(titleCase(it.status || 'pending'))));
      const bodyHtml = it.body ? `<div class="w-tx-detail-body">${escapeHtml(it.body)}</div>` : '';
      // Choose accent based on the credit/debit nature so the icon swatch
      // matches the row a user just clicked.
      window.ddModal({
        type: direction === 'credit' ? 'info' : 'warning',
        icon: direction === 'credit' ? 'fa-money-bill-trend-up' : 'fa-file-invoice-dollar',
        title: it.title || (direction === 'credit' ? 'Credit details' : 'Charge details'),
        message: `<div class="w-tx-detail">${rows.join('')}</div>${bodyHtml}`,
        buttons: [{ label: 'Close', class: 'ddm-btn-secondary' }],
      });
    } catch (err) {
      window.ddModal({ type: 'danger', icon: 'fa-triangle-exclamation', title: 'Couldn’t load item', message: escapeHtml(err.message || 'Unknown error') });
    }
  }

  // Delegate row clicks from the static container so we don't have to rebind
  // every time refreshTransactions replaces innerHTML.
  document.getElementById('txList').addEventListener('click', (ev) => {
    const row = ev.target.closest('.w-tx-row[data-tx-ref-id]');
    if (!row) return;
    const refType = row.getAttribute('data-tx-ref-type');
    const refId = row.getAttribute('data-tx-ref-id');
    if (refType === 'clockSession') openShiftDetail(refId);
    else if (refType === 'inboxItem') openInboxDetail(refId);
  });
  document.getElementById('txList').addEventListener('keydown', (ev) => {
    if (ev.key !== 'Enter' && ev.key !== ' ') return;
    const row = ev.target.closest('.w-tx-row[data-tx-ref-id]');
    if (!row) return;
    ev.preventDefault();
    row.click();
  });

  (async function init() {
    await Promise.all([refreshWallet(), refreshActiveSession(), refreshDepartments(), refreshTransactions()]);
    if (activeSession) startHeartbeat();
  })();

  // ---------- Civilian quick-swap ----------
  const swapBackdrop = document.getElementById('swapBackdrop');
  const swapModal = document.getElementById('swapModal');
  const swapSearch = document.getElementById('swapSearch');
  const swapList = document.getElementById('swapList');
  let swapCivilians = null;

  function encodeCivIdClient(id) {
    return btoa(id).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  function openSwapModal() {
    swapBackdrop.classList.add('is-open');
    swapModal.classList.add('is-open');
    swapSearch.value = '';
    setTimeout(() => swapSearch.focus(), 80);
    if (!swapCivilians) loadSwapCivilians();
    else renderSwapList();
  }
  function closeSwapModal() {
    swapBackdrop.classList.remove('is-open');
    swapModal.classList.remove('is-open');
  }
  document.getElementById('swapCivBtn').addEventListener('click', openSwapModal);
  document.getElementById('swapCloseBtn').addEventListener('click', closeSwapModal);
  swapBackdrop.addEventListener('click', closeSwapModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && swapModal.classList.contains('is-open')) closeSwapModal();
  });
  swapSearch.addEventListener('input', renderSwapList);

  async function loadSwapCivilians() {
    swapList.innerHTML = '<div class="w-swap-empty">Loading civilians…</div>';
    try {
      const url = `${API_URL}/api/v1/civilians/user/${encodeURIComponent(USER_ID)}` +
        (COMMUNITY_ID ? `?active_community_id=${encodeURIComponent(COMMUNITY_ID)}` : '');
      const res = await fetch(url);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      swapCivilians = Array.isArray(data) ? data : [];
      renderSwapList();
    } catch (err) {
      console.error('swap civs load failed:', err);
      swapList.innerHTML = '<div class="w-swap-empty" style="color:#ef4444;">Could not load civilians.</div>';
    }
  }

  function renderSwapList() {
    if (!swapCivilians) return;
    const q = (swapSearch.value || '').trim().toLowerCase();
    const rows = swapCivilians
      .map(c => {
        const inner = c.civilian || {};
        const fn = (inner.firstName || '').trim();
        const ln = (inner.lastName || '').trim();
        const combined = (inner.name || '').trim();
        // Many older civ docs store the full name in `name` rather than
        // firstName/lastName, so fall back to that before "Unnamed".
        const name = [fn, ln].filter(Boolean).join(' ') || combined || 'Unnamed civilian';
        const parts = name.split(/\s+/);
        const initials = ((parts[0]?.[0] || '') + (parts[1]?.[0] || '')).toUpperCase() || '?';
        return {
          id: c._id,
          name,
          image: inner.image || '',
          balance: typeof inner.balance === 'number' ? inner.balance : 0,
          initials,
        };
      })
      .filter(r => !q || r.name.toLowerCase().includes(q));

    if (rows.length === 0) {
      swapList.innerHTML = `<div class="w-swap-empty">${q ? 'No civilians match that search.' : 'You have no other civilians in this community.'}</div>`;
      return;
    }

    swapList.innerHTML = rows.map(r => {
      const isCurrent = r.id === CIVILIAN_ID;
      const isActive = !!ACTIVE_CIVILIAN_ID && r.id === ACTIVE_CIVILIAN_ID;
      const avatar = r.image
        ? `<img src="${escapeHtml(r.image)}" alt="">`
        : escapeHtml(r.initials);
      // "Current" = the wallet you're looking at right now.
      // "Active"  = the wallet everything defaults to.
      // Both can be true at once; render both pills so the distinction is obvious.
      const pills = [
        isCurrent ? '<span class="w-swap-current-pill">Current</span>' : '',
        isActive  ? '<span class="w-active-pill" style="margin-left:0.3rem;"><i class="fa fa-check"></i> Active</span>' : '',
      ].join('');
      const pill = pills;
      const cls = 'w-swap-row' + (isCurrent ? ' is-current' : '');
      return `
        <div class="${cls}" data-civ-id="${escapeHtml(r.id)}">
          <div class="w-swap-avatar">${avatar}</div>
          <div class="w-swap-info">
            <div class="w-swap-name">${escapeHtml(r.name)}</div>
            <div class="w-swap-bal">${fmtMoney(r.balance)}</div>
          </div>
          ${pill}
        </div>
      `;
    }).join('');

    swapList.querySelectorAll('.w-swap-row').forEach(row => {
      const id = row.dataset.civId;
      if (id === CIVILIAN_ID) return;
      row.addEventListener('click', () => {
        const encoded = encodeCivIdClient(id);
        window.location.href = `/wallet?c=${encodeURIComponent(encoded)}`;
      });
    });
  }

  // ---------- Set-as-active ----------
  // PUTs /api/v2/user/active-civilian so this civ becomes the default for
  // the wallet, inbox, and the Discord bot. Swap (the arrows button) is
  // for browsing — it just navigates. Set-as-active is the explicit
  // commitment.
  const setActiveBtn = document.getElementById('setActiveBtn');
  if (setActiveBtn) {
    setActiveBtn.addEventListener('click', async () => {
      if (!USER_ID || !COMMUNITY_ID || !CIVILIAN_ID) return;

      // The active civilian drives downstream UI (job cards, clock-in/out
      // modals, default civ for the bot, etc.), so it must always match
      // whichever civilian is currently on the clock. If a different
      // civilian on this account is clocked in, refuse the swap and tell
      // the user to clock them out first — keeps every surface in sync.
      try {
        const sessRes = await fetch(`${API_URL}/api/v2/economy/session/active?userId=${encodeURIComponent(USER_ID)}`);
        if (sessRes.ok) {
          const sessText = await sessRes.text();
          const session = (!sessText || sessText === 'null') ? null : JSON.parse(sessText);
          if (session && session._id && session.civilianId && session.civilianId !== CIVILIAN_ID) {
            showSetActiveBlockedByShift(session);
            return;
          }
        }
      } catch (e) {
        // Don't block on a session lookup failure — fall through to the
        // PUT below. Server-side enforcement is the backstop.
      }

      await doSetActive();
    });
  }

  // Block modal: another civilian on this account is on the clock, so we
  // refuse the pin swap. The active civilian and the running shift must
  // stay aligned — otherwise the wallet header, job cards, and clock-in
  // modals all desync from the shift that's actually earning money.
  function showSetActiveBlockedByShift(session) {
    const deptName = escapeHtml(session.departmentName || 'a department');
    const newName = escapeHtml(CIVILIAN_NAME || 'this civilian');
    // Best-effort: deep-link to the on-the-clock civilian's wallet so
    // they can clock out in one click. We have their civilianId from the
    // session payload — base64url-encode it the same way the swap modal
    // does.
    const otherCivId = session.civilianId || '';
    let otherWalletHref = '/wallet';
    if (otherCivId) {
      try {
        const encoded = btoa(otherCivId).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
        otherWalletHref = '/wallet?c=' + encodeURIComponent(encoded);
      } catch (_) {}
    }
    window.ddModal({
      type: 'warning',
      icon: 'fa-stopwatch',
      title: 'Clock out first',
      message: 'Another civilian is on the clock at <strong>' + deptName + '</strong>. Clock them out before pinning <strong>' + newName + '</strong>.',
      detail: 'Active civilian must match the running shift.',
      buttons: [
        { label: 'Got it', class: 'ddm-btn-secondary' },
        { label: 'Go to that wallet', class: 'ddm-btn-primary', icon: 'fa-arrow-right', href: otherWalletHref },
      ],
    });
  }

  async function doSetActive() {
    setActiveBtn.disabled = true;
    const originalHTML = setActiveBtn.innerHTML;
    setActiveBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Saving…';
    try {
      const res = await fetch(`${API_URL}/api/v2/user/active-civilian`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: USER_ID, communityId: COMMUNITY_ID, civilianId: CIVILIAN_ID }),
      });
      // The API enforces the same "active must equal currently-clocked-in"
      // rule we pre-check above — if the pre-check raced or was skipped
      // (transient lookup failure), the server still refuses with 409 and
      // returns the existing session. Surface the same "clock out first"
      // modal in that case rather than showing a generic error.
      if (res.status === 409) {
        const body = await res.json().catch(() => null);
        const session = body && body.session;
        setActiveBtn.disabled = false;
        setActiveBtn.innerHTML = originalHTML;
        if (session && session._id) {
          showSetActiveBlockedByShift(session);
          return;
        }
      }
      if (!res.ok) {
        const txt = await res.text().catch(() => '');
        throw new Error(`HTTP ${res.status}${txt ? ' — ' + txt.slice(0, 200) : ''}`);
      }
      ACTIVE_CIVILIAN_ID = CIVILIAN_ID;
      // Swap the button out for the "Active" pill in place — no full
      // page reload needed.
      const pill = document.createElement('span');
      pill.className = 'w-active-pill';
      pill.title = 'This is the civilian the wallet, inbox, and bot default to.';
      pill.innerHTML = '<i class="fa fa-check"></i> Active';
      setActiveBtn.replaceWith(pill);
    } catch (err) {
      console.error('set-active-civilian failed', err);
      setActiveBtn.disabled = false;
      setActiveBtn.innerHTML = originalHTML;
      window.ddModal({
        type: 'danger', icon: 'fa-triangle-exclamation',
        title: 'Could not set active civilian', message: escapeHtml(err.message || ''),
      });
    }
  }
  // ---------- Send Money flow ----------
  // Multi-step bottom-sheet: recipient → amount → memo → review → submit.
  // Hard-blocks insufficient balance inline (red banner) so the user
  // understands why send is disabled — explicit per UX requirement.
  (function initSendMoney() {
    const SEND_MAX_CENTS = 10_000_00; // $10,000, also enforced server-side
    const SEND_MAX_MSG = 140;

    const openBtn = document.getElementById('sendMoneyBtn');
    const backdrop = document.getElementById('sendBackdrop');
    const modal = document.getElementById('sendModal');
    const closeBtn = document.getElementById('sendCloseBtn');
    const body = document.getElementById('sendBody');
    const footer = document.getElementById('sendFooter');
    const backBtn = document.getElementById('sendBackBtn');
    const nextBtn = document.getElementById('sendNextBtn');
    const stepTitle = document.getElementById('sendStepTitle');
    const dots = document.getElementById('sendDots');
    const errorEl = document.getElementById('sendError');
    if (!openBtn || !modal) return;

    // The user can browse another civ's wallet — only their OWN active
    // civilian can be the sender. If they're on someone else's wallet, the
    // button is hidden.
    if (!ACTIVE_CIVILIAN_ID || ACTIVE_CIVILIAN_ID !== CIVILIAN_ID) {
      openBtn.style.display = 'none';
    }

    let step = 0; // 0 picker · 1 amount · 2 memo · 3 review · 4 sent
    let recipient = null;
    let amountCents = 0;
    let memo = '';
    let civilians = []; // community-wide civilians, loaded on first open
    let civsLoading = false;
    let sending = false;
    // Snapshot of the completed transfer — held separately so "Send another"
    // can wipe recipient/amount/memo without disrupting the success screen.
    let sentSnapshot = null;
    const TITLES = ['Send to', 'How much?', 'Add a note?', 'Review', 'Sent'];

    function open() {
      step = 0; recipient = null; amountCents = 0; memo = ''; sentSnapshot = null;
      errorEl.style.display = 'none'; errorEl.textContent = '';
      backdrop.classList.add('is-open');
      modal.classList.add('is-open');
      render();
      ensureCivilians();
    }
    function sendAnother() {
      step = 0; recipient = null; amountCents = 0; memo = '';
      errorEl.style.display = 'none'; errorEl.textContent = '';
      // Keep sentSnapshot until we re-enter step 4; clearing now avoids
      // stale references but isn't strictly required.
      sentSnapshot = null;
      render();
    }
    function close() {
      if (sending) return;
      backdrop.classList.remove('is-open');
      modal.classList.remove('is-open');
    }
    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) close();
    });

    async function ensureCivilians() {
      if (civilians.length > 0 || civsLoading) { render(); return; }
      if (!COMMUNITY_ID) return;
      civsLoading = true;
      try {
        const res = await fetch(`${API_URL}/api/v2/community/${encodeURIComponent(COMMUNITY_ID)}/civilians?page=1&limit=100`);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const list = Array.isArray(data?.civilians) ? data.civilians : [];
        civilians = list.filter(c => c._id !== CIVILIAN_ID);
      } catch (err) {
        console.warn('community civilians load failed', err);
      } finally {
        civsLoading = false;
        if (step === 0) render();
      }
    }

    function civName(c) {
      const d = c?.civilian || {};
      const fn = (d.firstName || '').trim();
      const ln = (d.lastName || '').trim();
      const name = [fn, ln].filter(Boolean).join(' ') || (d.name || '').trim() || 'Unnamed';
      return name;
    }
    function civImage(c) {
      const d = c?.civilian || {};
      return d.image || '';
    }
    function civInitials(c) {
      const parts = civName(c).split(/\s+/);
      return ((parts[0]?.[0] || '') + (parts[1]?.[0] || '')).toUpperCase() || '?';
    }

    function setDots() {
      const ds = dots.querySelectorAll('.w-send-dot');
      ds.forEach((d, i) => {
        d.classList.toggle('is-active', i === step);
        d.classList.toggle('is-done', i < step);
      });
    }

    function render() {
      stepTitle.textContent = TITLES[step];
      setDots();
      // Hide the live recipient pill on the success step — the success
      // headline already names the recipient. Otherwise show it on steps 1-3.
      const recPill = (recipient && step > 0 && step < 4)
        ? `<div class="w-recipient-pill" id="recPill" role="button" tabindex="0">
             <div class="w-recipient-avatar">${
               civImage(recipient)
                 ? `<img src="${escapeHtml(civImage(recipient))}" alt="">`
                 : escapeHtml(civInitials(recipient))
             }</div>
             <div style="flex:1; min-width:0;">
               <div class="w-recipient-cap">To</div>
               <div class="w-recipient-name">${escapeHtml(civName(recipient))}</div>
             </div>
             <span class="w-recipient-change">change</span>
           </div>`
        : '';

      let content = '';
      if (step === 0) content = renderPicker();
      else if (step === 1) content = renderAmount();
      else if (step === 2) content = renderMemo();
      else if (step === 3) content = renderReview();
      else content = renderSent();

      body.innerHTML = recPill + content;
      wireStepHandlers();

      // Footer visibility + button states
      if (step === 0) {
        footer.style.display = 'none';
      } else if (step === 4) {
        // Success state — swap the footer to "Send another" + "Done" so the
        // user can immediately initiate another transfer without re-opening
        // the modal.
        footer.style.display = 'flex';
        backBtn.innerHTML = '<i class="fa fa-paper-plane"></i> Send another';
        backBtn.disabled = false;
        nextBtn.innerHTML = '<i class="fa fa-check"></i> Done';
        nextBtn.disabled = false;
      } else {
        footer.style.display = 'flex';
        backBtn.innerHTML = '<i class="fa fa-arrow-left"></i> Back';
        if (step < 3) {
          nextBtn.innerHTML = 'Continue <i class="fa fa-chevron-right"></i>';
          nextBtn.disabled = step === 1 ? !validAmount() : false;
        } else {
          nextBtn.innerHTML = sending
            ? '<i class="fa fa-spinner fa-spin"></i> Sending…'
            : `<i class="fa fa-paper-plane"></i> Send ${escapeHtml(fmtMoney(amountCents))}`;
          nextBtn.disabled = sending;
        }
        backBtn.disabled = sending;
      }
    }

    function renderPicker() {
      if (civsLoading) {
        return `<div class="w-empty" style="text-align:center; padding:1.5rem;">
                  <i class="w-spinner"></i> Loading civilians…
                </div>`;
      }
      return `
        <div class="w-send-search">
          <i class="fa fa-search"></i>
          <input id="sendQuery" type="search" placeholder="Search ${civilians.length} ${civilians.length === 1 ? 'civilian' : 'civilians'}" autocomplete="off">
        </div>
        <div class="w-recipient-list" id="recipientList">
          ${renderRecipientRows('')}
        </div>
      `;
    }
    function renderRecipientRows(q) {
      const query = (q || '').toLowerCase();
      const rows = civilians.filter(c => !query || civName(c).toLowerCase().includes(query));
      if (rows.length === 0) {
        return `<div class="w-empty" style="text-align:center; padding:1.5rem;">
                  ${civilians.length === 0 ? "No one to send to yet." : `Nothing matches &ldquo;${escapeHtml(q)}&rdquo;.`}
                </div>`;
      }
      return rows.map(c => `
        <div class="w-recipient-row" data-civ-id="${escapeHtml(c._id)}">
          <div class="w-recipient-avatar">${
            civImage(c)
              ? `<img src="${escapeHtml(civImage(c))}" alt="">`
              : escapeHtml(civInitials(c))
          }</div>
          <div class="who">${escapeHtml(civName(c))}<small>${escapeHtml(c.user?.username || 'civilian')}</small></div>
          <i class="fa fa-chevron-right chev"></i>
        </div>
      `).join('');
    }
    function renderAmount() {
      const dollars = (amountCents / 100).toFixed(2);
      const balance = currentBalanceCents();
      const insufficient = amountCents > 0 && amountCents > balance;
      const overMax = amountCents > SEND_MAX_CENTS;
      return `
        <div class="w-amount-display ${insufficient ? 'neg' : ''}">$${dollars}</div>
        <div class="w-amount-balance">Wallet balance: <b>${escapeHtml(fmtMoney(balance))}</b></div>
        <input id="sendAmountInput" type="number" min="0" step="0.01" max="${SEND_MAX_CENTS / 100}" inputmode="decimal"
               class="w-amount-input" placeholder="0.00" value="${amountCents > 0 ? dollars : ''}">
        <div class="w-quick-row">
          ${[500, 1000, 2500, 5000].map(c =>
            `<button type="button" class="w-quick-chip" data-quick="${c}">$${c / 100}</button>`
          ).join('')}
          <button type="button" class="w-quick-chip accent" data-quick="max">Max</button>
        </div>
        ${insufficient ? `
          <div class="w-insufficient">
            <i class="fa fa-circle-xmark"></i>
            <div>
              <div class="w-insufficient-title">Not enough in your wallet</div>
              <div class="w-insufficient-body">You have ${escapeHtml(fmtMoney(balance))} — try a smaller amount or tap <b data-action="use-max">Max</b>.</div>
            </div>
          </div>` : ''}
        ${overMax && !insufficient ? `
          <div class="w-insufficient" style="background:rgba(245,158,11,0.08); border-color:rgba(245,158,11,0.30);">
            <i class="fa fa-circle-exclamation" style="color:var(--w-amber);"></i>
            <div>
              <div class="w-insufficient-title" style="color:var(--w-amber);">Single transfer max is ${escapeHtml(fmtMoney(SEND_MAX_CENTS))}</div>
            </div>
          </div>` : ''}
      `;
    }
    function renderMemo() {
      const left = SEND_MAX_MSG - memo.length;
      const cls = left <= 0 ? 'danger' : left <= 20 ? 'warn' : '';
      return `
        <textarea id="sendMemoInput" class="w-memo-input" maxlength="${SEND_MAX_MSG}" placeholder="e.g. thx for the tow">${escapeHtml(memo)}</textarea>
        <div class="w-memo-footer">
          <span class="w-memo-hint">Shows up on their receipt — keep it short.</span>
          <span class="w-memo-count ${cls}" id="memoCount">${memo.length}/${SEND_MAX_MSG}</span>
        </div>
      `;
    }
    function renderSent() {
      const s = sentSnapshot || { amountCents: 0, recipientName: '', message: '', balanceAfter: 0 };
      return `
        <div class="w-sent-hero">
          <div class="w-sent-check"><i class="fa fa-circle-check"></i></div>
          <div class="w-sent-headline">Sent ${escapeHtml(fmtMoney(s.amountCents))}</div>
          <div class="w-sent-subline">to <b>${escapeHtml(s.recipientName)}</b></div>
        </div>
        <div class="w-receipt" style="margin-top:0.4rem;">
          ${s.message ? `
          <div class="w-receipt-row">
            <span class="w-receipt-k">Note</span>
            <span class="w-receipt-v memo">&ldquo;${escapeHtml(s.message)}&rdquo;</span>
          </div>` : ''}
          <div class="w-receipt-row">
            <span class="w-receipt-k">New balance</span>
            <span class="w-receipt-v" style="color:var(--w-green);">${escapeHtml(fmtMoney(s.balanceAfter))}</span>
          </div>
        </div>
      `;
    }
    function renderReview() {
      const balance = currentBalanceCents();
      return `
        <div class="w-receipt">
          <div class="w-receipt-kicker">You're sending</div>
          <div class="w-receipt-amount">${escapeHtml(fmtMoney(amountCents))}</div>
          <div class="w-receipt-divider"></div>
          <div class="w-receipt-row">
            <span class="w-receipt-k">To</span>
            <span class="w-receipt-v">${escapeHtml(civName(recipient))}</span>
          </div>
          ${memo.trim() ? `
          <div class="w-receipt-row">
            <span class="w-receipt-k">Note</span>
            <span class="w-receipt-v memo">&ldquo;${escapeHtml(memo.trim())}&rdquo;</span>
          </div>` : ''}
          <div class="w-receipt-row">
            <span class="w-receipt-k">Balance after</span>
            <span class="w-receipt-v">${escapeHtml(fmtMoney(balance - amountCents))}</span>
          </div>
        </div>
      `;
    }

    function wireStepHandlers() {
      const recPill = document.getElementById('recPill');
      if (recPill) {
        recPill.addEventListener('click', () => { step = 0; render(); });
      }
      if (step === 0) {
        const q = document.getElementById('sendQuery');
        const list = document.getElementById('recipientList');
        if (q && list) {
          q.addEventListener('input', () => {
            list.innerHTML = renderRecipientRows(q.value);
            bindRowClicks();
          });
        }
        bindRowClicks();
      }
      if (step === 1) {
        const input = document.getElementById('sendAmountInput');
        if (input) {
          input.focus();
          input.addEventListener('input', () => {
            const v = parseFloat(input.value);
            amountCents = isNaN(v) ? 0 : Math.round(v * 100);
            if (amountCents < 0) amountCents = 0;
            updateAmountUI();
          });
        }
        body.querySelectorAll('[data-quick]').forEach(b => {
          b.addEventListener('click', () => {
            const v = b.dataset.quick;
            amountCents = v === 'max'
              ? Math.min(currentBalanceCents(), SEND_MAX_CENTS)
              : parseInt(v, 10);
            render();
          });
        });
        const maxLink = body.querySelector('[data-action="use-max"]');
        if (maxLink) {
          maxLink.addEventListener('click', () => {
            amountCents = Math.min(currentBalanceCents(), SEND_MAX_CENTS);
            render();
          });
        }
      }
      if (step === 2) {
        const t = document.getElementById('sendMemoInput');
        const c = document.getElementById('memoCount');
        if (t) {
          t.focus();
          t.addEventListener('input', () => {
            memo = t.value.slice(0, SEND_MAX_MSG);
            const left = SEND_MAX_MSG - memo.length;
            c.textContent = `${memo.length}/${SEND_MAX_MSG}`;
            c.classList.toggle('warn', left <= 20 && left > 0);
            c.classList.toggle('danger', left <= 0);
          });
        }
      }
    }
    function bindRowClicks() {
      document.querySelectorAll('.w-recipient-row').forEach(row => {
        row.addEventListener('click', () => {
          const id = row.dataset.civId;
          recipient = civilians.find(c => c._id === id);
          if (!recipient) return;
          step = 1;
          render();
        });
      });
    }

    function updateAmountUI() {
      // Cheap surgical refresh so we don't lose input focus on every keystroke.
      const display = body.querySelector('.w-amount-display');
      if (display) {
        display.textContent = '$' + (amountCents / 100).toFixed(2);
        display.classList.toggle('neg', amountCents > 0 && amountCents > currentBalanceCents());
      }
      nextBtn.disabled = !validAmount();
      // Pop the insufficient banner in/out as the user types.
      const old = body.querySelector('.w-insufficient');
      const balance = currentBalanceCents();
      const insufficient = amountCents > 0 && amountCents > balance;
      const overMax = amountCents > SEND_MAX_CENTS;
      if (old) old.remove();
      if (insufficient) {
        const div = document.createElement('div');
        div.className = 'w-insufficient';
        div.innerHTML = `<i class="fa fa-circle-xmark"></i>
          <div>
            <div class="w-insufficient-title">Not enough in your wallet</div>
            <div class="w-insufficient-body">You have ${escapeHtml(fmtMoney(balance))} — try a smaller amount or tap <b data-action="use-max">Max</b>.</div>
          </div>`;
        body.appendChild(div);
        div.querySelector('[data-action="use-max"]').addEventListener('click', () => {
          amountCents = Math.min(balance, SEND_MAX_CENTS);
          render();
        });
      } else if (overMax) {
        const div = document.createElement('div');
        div.className = 'w-insufficient';
        div.style.background = 'rgba(245,158,11,0.08)';
        div.style.borderColor = 'rgba(245,158,11,0.30)';
        div.innerHTML = `<i class="fa fa-circle-exclamation" style="color:var(--w-amber);"></i>
          <div><div class="w-insufficient-title" style="color:var(--w-amber);">Single transfer max is ${escapeHtml(fmtMoney(SEND_MAX_CENTS))}</div></div>`;
        body.appendChild(div);
      }
    }

    function currentBalanceCents() {
      // Read from the DOM since we don't keep a JS source-of-truth for it.
      const el = document.getElementById('balanceValue');
      if (!el) return 0;
      const txt = (el.textContent || '').replace(/[^\d.-]/g, '');
      const n = parseFloat(txt);
      return isNaN(n) ? 0 : Math.round(n * 100);
    }
    function validAmount() {
      if (amountCents <= 0) return false;
      if (amountCents > SEND_MAX_CENTS) return false;
      if (amountCents > currentBalanceCents()) return false;
      return true;
    }

    backBtn.addEventListener('click', () => {
      if (sending) return;
      if (step === 4) { sendAnother(); return; }
      step = Math.max(0, step - 1);
      render();
    });
    nextBtn.addEventListener('click', async () => {
      if (sending) return;
      if (step === 4) { close(); return; }
      if (step < 3) {
        if (step === 1 && !validAmount()) return;
        step += 1;
        render();
        return;
      }
      // Submit
      sending = true;
      errorEl.style.display = 'none';
      render();
      try {
        const res = await fetch(`${API_URL}/api/v2/economy/transfer?userId=${encodeURIComponent(USER_ID)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fromCivilianId: CIVILIAN_ID,
            toCivilianId: recipient._id,
            amountCents,
            message: memo.trim(),
          }),
        });
        const payload = await res.json().catch(() => null);
        if (!res.ok) {
          const msg = payload?.Response?.Message || payload?.message || `Transfer failed (${res.status})`;
          throw new Error(msg);
        }
        // Optimistic balance patch — the user's send should reflect immediately.
        if (typeof payload?.fromBalanceAfter === 'number') {
          const balEl = document.getElementById('balanceValue');
          if (balEl) balEl.textContent = fmtMoney(payload.fromBalanceAfter);
        }
        // Capture a stable snapshot, then morph into the success step
        // in-place instead of closing + showing a ddModal toast.
        sentSnapshot = {
          amountCents,
          message: memo.trim(),
          recipientName: payload?.recipientName || civName(recipient),
          balanceAfter: typeof payload?.fromBalanceAfter === 'number'
            ? payload.fromBalanceAfter
            : Math.max(currentBalanceCents() - amountCents, 0),
        };
        step = 4;
        if (typeof refreshTransactions === 'function') refreshTransactions();
        if (typeof refreshWallet === 'function') refreshWallet();
      } catch (err) {
        errorEl.textContent = err.message || 'Transfer failed';
        errorEl.style.display = '';
      } finally {
        sending = false;
        render();
      }
    });
  })();

  } // end if (CIVILIAN_ID)
</script>
<%- include('partials/pending-deletion-gate') %>
</body>
</html>
