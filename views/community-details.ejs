        const canManageMembers = checkManageMembersPermission();
        const isOwner = checkIsOwner();
        
        // Get required DOM elements
        const titleElement = document.getElementById('memberActionsTitle');
        const infoElement = document.getElementById('memberActionsInfo');
        const actionsContainer = document.getElementById('memberActionsButtons');
        const modal = document.getElementById('memberActionsModal');
        
