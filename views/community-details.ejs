    <script src="/static/js/community-details.js"></script>
    <script>
    function encodeDepartmentId(departmentId) {
      // Simple reversible encoding: convert to base64 and replace some characters
      const base64 = btoa(departmentId);
      return base64
        .replace(/\+/g, '-')
        .replace(/\//g, '_')
        .replace(/=/g, '');
    }

    function navigateToDepartment(departmentId, departmentName, templateName) {
      const templateType = templateName.toLowerCase();
      let dashboardUrl = '';
      
      if (templateType.includes('civilian')) {
        dashboardUrl = `/civ-dashboard?dept=${encodeURIComponent(departmentName)}&d=${encodeDepartmentId(departmentId)}`;
      } else if (templateType.includes('police')) {
        dashboardUrl = `/police-dashboard?dept=${encodeURIComponent(departmentName)}&d=${encodeDepartmentId(departmentId)}`;
      } else if (templateType.includes('fire') || templateType.includes('ems')) {
        dashboardUrl = `/ems-dashboard?dept=${encodeURIComponent(departmentName)}&d=${encodeDepartmentId(departmentId)}`;
      } else if (templateType.includes('dispatch')) {
        dashboardUrl = `/dispatch-dashboard?dept=${encodeURIComponent(departmentName)}&d=${encodeDepartmentId(departmentId)}`;
      }
      
      if (dashboardUrl) {
        // First, set the last accessed community
        const communityId = '<%= community._id %>';
        const userId = '<%= user && user._doc ? user._doc._id : "" %>';
        
        if (communityId && userId) {
          fetch('<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>/api/v1/user/last-accessed-community', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              userId: userId,
              communityId: communityId,
              createdAt: new Date().toISOString()
            })
          }).then(() => {
            // Then navigate directly to the dashboard with department parameters
            window.location.href = dashboardUrl;
          }).catch(error => {
            console.error('Error setting last accessed community:', error);
            // Continue with navigation even if setting last accessed community fails
            window.location.href = dashboardUrl;
          });
        } else {
          // Fallback if communityId or userId not available
          window.location.href = dashboardUrl;
        }
      } else {
        console.error('No matching dashboard for department:', departmentName);
        alert('Unknown department type: ' + departmentName);
      }
    }
    </script>
    <style>
      body {
