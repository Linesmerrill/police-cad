              <button onclick="kickMember('${member._id}')" style="background:#f59e0b; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1rem;">
                <i class="fa fa-user-times" style="margin-right:0.5rem;"></i>
                Kick Member
              </button>
              <button onclick="banMember('${member._id}')" style="background:#ef4444; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1rem;">
                <i class="fa fa-ban" style="margin-right:0.5rem;"></i>
                Ban Member
              </button>
              ${isOwner ? `
                <button onclick="transferOwnership()" style="background:#8b5cf6; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1rem; transition:all 0.2s; hover:background:#7c3aed;">
                  <i class="fa fa-crown" style="margin-right:0.5rem;"></i>
                  Transfer Ownership
                </button>
              ` : ''}
            `;
          } else {
            actionsContainer.innerHTML = `
              <div style="color:#a0aec0; font-style:italic; padding:1rem;">
                You cannot perform actions on yourself.
              </div>
            `;
          }
        } else {
          actionsContainer.innerHTML = `
            <div style="color:#a0aec0; font-style:italic; padding:1rem;">
              You don't have permission to manage members.
            </div>
          `;
        }
        
        modal.style.display = 'flex';
      }

      function checkManageMembersPermission() {
        // Check if user has manage members permission OR administrator permission
        const userRoles = <%- JSON.stringify(community.community.roles || []) %>;
        const userId = '<%= user._doc._id %>';
        
        for (const role of userRoles) {
          if (role.members && role.members.includes(userId)) {
            for (const perm of role.permissions || []) {
              // Check for "manage members" permission enabled
              if (perm.name === 'manage members' && perm.enabled === true) {
                return true;
              }
              // Check for "administrator" permission enabled
              if (perm.name === 'administrator' && perm.enabled === true) {
                return true;
              }
            }
          }
        }
        return false;
      }

      function checkIsOwner() {
        return '<%= user._doc._id %>' === '<%= community.community.ownerID %>';
      }

      function formatDate(dateString) {
        if (!dateString) return 'Unknown';
        const date = new Date(dateString);
        if (isNaN(date.getTime())) return 'Unknown';
        
        return date.toLocaleDateString('en-US', {
          month: 'numeric',
          day: 'numeric',
          year: 'numeric'
        });
      }

      function getJoinDateFromObjectId(objectId) {
        if (!objectId || typeof objectId !== 'string') return 'Unknown';
        
        try {
          // MongoDB ObjectId contains a timestamp in the first 4 bytes
          // Convert the first 8 hex characters to decimal, then to milliseconds
          const timestamp = parseInt(objectId.substring(0, 8), 16);
          const date = new Date(timestamp * 1000); // Convert to milliseconds
          
          if (isNaN(date.getTime())) return 'Unknown';
          
          return date.toLocaleDateString('en-US', {
            month: 'numeric',
            day: 'numeric',
            year: 'numeric'
          });
        } catch (error) {
          return 'Unknown';
        }
      }

      function getMemberJoinDate(member) {
        // Get the current community ID
        const currentCommunityId = '<%= community._id %>';
        
        // Find the community entry that matches the current community
        if (member.user?.communities && Array.isArray(member.user.communities)) {
          const communityEntry = member.user.communities.find(comm => comm.communityId === currentCommunityId);
          
          if (communityEntry && communityEntry._id) {
            // Use the community join ObjectId to get the actual join date
            return getJoinDateFromObjectId(communityEntry._id);
          }
        }
        
        // Fallback: Show when they joined the platform if no community join info
        if (member.user?.createdAt) {
          return formatDate(member.user.createdAt);
        }
        
        return 'Unknown';
      }

      function getMemberRole(member) {
        // Check if user is the community owner
        if (member._id === '<%= community.community.ownerID %>') {
          return 'Owner';
        }
        
        // Check if user has any roles in the community
        const userRoles = <%- JSON.stringify(community.community.roles || []) %>;
        for (const role of userRoles) {
          if (role.members && role.members.includes(member._id)) {
            return role.name || 'Member';
          }
        }
        
        return 'Member';
      }

      // Member action functions
      async function kickMember(memberId) {
        showCustomConfirm(
          'Kick Member',
          'Are you sure you want to kick this member from the community? They will be removed but can rejoin if invited.',
          () => {
            performKickMember(memberId);
          }
        );
      }

      async function performKickMember(memberId) {
        // Show loading state in the member actions modal
        const actionsContainer = document.getElementById('memberActionsButtons');
        if (actionsContainer) {
          actionsContainer.innerHTML = `
            <div style="text-align:center; padding:2rem;">
              <div class="loading-spinner" style="width:60px; height:60px; border:4px solid #4a5568; border-top:4px solid #f59e0b; border-radius:50%; animation:spin 1s linear infinite; margin:0 auto 1rem;"></div>
              <p style="color:#a0aec0; font-size:1.125rem;">Kicking member...</p>
              <p style="color:#6b7280; font-size:0.875rem;">This may take a moment</p>
            </div>
          `;
        }

        try {
          const communityId = '<%= community._id %>';
          const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
          
          const response = await fetch(`${apiUrl}/api/v1/user/${memberId}/remove-community`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ communityId }),
          });

          if (!response.ok) {
            const data = await response.json();
            throw new Error(data.message || `Failed to kick member: ${response.status}`);
          }

          const data = await response.json();
          
          showToast('Member kicked successfully!', 3000, 'success');
          closeMemberActionsModal();
          
          // Refresh the members list to reflect the change
          // If we're on a page that might now be empty, go back to page 1
          if (communityMembersPage > 1 && communityFilteredMembers.length === 1) {
            loadMembers(1);
          } else {
            loadMembers(communityMembersPage);
          }
          
        } catch (error) {
          showToast(`Failed to kick member: ${error.message}`, 3000, 'error');
          
          // Restore the action buttons on error
          if (actionsContainer) {
            const member = communityFilteredMembers.find(m => m._id === memberId);
            if (member) {
              openMemberActions(memberId); // This will restore the buttons
            }
          }
        }
      }

