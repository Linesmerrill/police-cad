<script>
function openLeaveCommunityModal() {
  document.getElementById('leaveCommunityModal').style.display = 'flex';
}
document.getElementById('leaveCommunityModalClose').onclick = function() {
  document.getElementById('leaveCommunityModal').style.display = 'none';
}
document.getElementById('leaveCommunityModalCancel').onclick = function() {
  document.getElementById('leaveCommunityModal').style.display = 'none';
}
document.getElementById('leaveCommunityModalConfirm').onclick = function() {
  submitLeaveCommunity();
}
function submitLeaveCommunity() {
  const userId = '<%= user && user._doc ? user._doc._id : "" %>';
  const communityId = '<%= community._id %>';
  const errorDiv = document.getElementById('leaveCommunityError');
  errorDiv.style.display = 'none';
  errorDiv.textContent = '';

  // Show loading state (optional)
  const leaveBtn = document.getElementById('leaveCommunityModalConfirm');
  if (leaveBtn) {
    leaveBtn.disabled = true;
    leaveBtn.textContent = 'Leaving...';
  }

  fetch(`${API_URL}/user/${userId}/remove-community`, {
    method: "DELETE",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({ communityId }),
  })
    .then(async (response) => {
      if (!response.ok) {
        const data = await response.json();
        throw new Error(
          `Failed to remove user from community.\n\nMessage: ${data.message}.\nCode: ${response.status}`
        );
      }
      return response.json();
    })
    .then(() => {
      localStorage.setItem('leftCommunityToast', '1');
      window.location.href = "/communities";
    })
    .catch((error) => {
      errorDiv.style.display = 'block';
      errorDiv.textContent = error.message || "An error occurred.";
      if (leaveBtn) {
        leaveBtn.disabled = false;
        leaveBtn.textContent = 'Leave Community';
      }
    });
}
</script>

