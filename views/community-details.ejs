<script>
function navigateToDepartment(departmentId, templateName) {
  const deptName = templateName.toLowerCase();
  let dashboardUrl = '';
  
  if (deptName.includes('civilian')) {
    dashboardUrl = `/civ-dashboard?dept=${encodeURIComponent(templateName)}&d=${departmentId}`;
  } else if (deptName.includes('police')) {
    dashboardUrl = `/police-dashboard?dept=${encodeURIComponent(templateName)}&d=${departmentId}`;
  } else if (deptName.includes('fire') || deptName.includes('ems')) {
    dashboardUrl = `/ems-dashboard?dept=${encodeURIComponent(templateName)}&d=${departmentId}`;
  } else if (deptName.includes('dispatch')) {
    dashboardUrl = `/dispatch-dashboard?dept=${encodeURIComponent(templateName)}&d=${departmentId}`;
  }
  
  if (dashboardUrl) {
    // First, set the last accessed community
    const communityId = '<%= community._id %>';
    const userId = '<%= user._doc._id %>';
    
    if (communityId && userId) {
      fetch('https://police-cad-app-api-bc6d659b60b3.herokuapp.com/api/v1/user/last-accessed-community', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          userId: userId,
          communityId: communityId,
          createdAt: new Date().toISOString()
        })
      }).then(() => {
        // Then navigate directly to the dashboard with department parameters
        window.location.href = dashboardUrl;
      }).catch(error => {
        console.error('Error setting last accessed community:', error);
        // Continue with navigation even if setting last accessed community fails
        window.location.href = dashboardUrl;
      });
    } else {
      // Fallback if communityId or userId not available
      window.location.href = dashboardUrl;
    }
  } else {
    console.error('No matching dashboard for department:', templateName);
    alert('Unknown department type: ' + templateName);
  }
}

