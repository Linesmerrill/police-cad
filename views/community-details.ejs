    </div>
    <div style="color:#a0aec0; text-align:center; padding:1rem; margin-bottom:1.5rem;">
      <p>Are you sure you want to leave this community?</p>
      <p style="font-size:0.9rem; margin-top:0.5rem; color:#f56565;">This action cannot be undone.</p>
    </div>
    <div id="leaveCommunityError" style="display:none; color:#f56565; text-align:center; margin-bottom:1rem;"></div>
    <div style="margin-top:2rem; text-align:center; display:flex; justify-content:center; gap:1rem;">
      <button id="leaveCommunityModalCancel" type="button" style="background:#35385a; color:#fff; border:none; border-radius:8px; padding:0.6rem 1.2rem; font-weight:500; cursor:pointer;">
        Cancel
      </button>
      <button id="leaveCommunityModalConfirm" type="button" style="background:#f56565; color:#fff; border:none; border-radius:8px; padding:0.6rem 1.2rem; font-weight:500; cursor:pointer;">
        Leave Community
      </button>
    </div>
  </div>
