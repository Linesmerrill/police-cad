        <div style="text-align:center;">
          <button onclick="closeComingSoonModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded font-semibold">Got it!</button>
        </div>
      </div>
    `;
    
    document.body.appendChild(modal);
  } else {
    // Update existing modal content
    const titleElement = modal.querySelector('h3');
    const messageElement = modal.querySelector('p');
    if (titleElement) titleElement.textContent = title;
    if (messageElement) messageElement.textContent = message;
  }
  
  modal.style.display = 'flex';
}

function closeComingSoonModal() {
  const modal = document.getElementById('comingSoonModal');
  if (modal) {
    modal.style.display = 'none';
  }
}

if (localStorage.getItem('leftCommunityToast')) {
  showToast("You have left the community.", 2500);
  localStorage.removeItem('leftCommunityToast');
}
</script> 

