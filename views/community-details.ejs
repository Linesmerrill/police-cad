        <textarea id="dept-description" rows="3" class="w-full text-gray-200 bg-gray-800 rounded p-4 text-lg"></textarea>
      </div>
      <div class="mb-4">
        <label class="block text-gray-300 mb-2 text-lg font-medium">Visibility</label>
        <div class="flex gap-2">
          <button type="button" id="visibility-public" class="flex-1 px-4 py-4 rounded-l-lg border border-gray-600 bg-blue-600 text-white font-semibold focus:outline-none focus:ring-2 focus:ring-blue-400 text-lg" onclick="setDeptVisibility('public')">Public</button>
          <button type="button" id="visibility-private" class="flex-1 px-4 py-4 rounded-r-lg border border-gray-600 bg-gray-700 text-gray-200 font-semibold focus:outline-none focus:ring-2 focus:ring-blue-400 text-lg" onclick="setDeptVisibility('private')">Private <span class='text-base'>(Approval required)</span></button>
        </div>
        <input type="hidden" id="dept-visibility" name="visibility" value="public" />
      </div>
      <div id="createDeptStep1Error" class="text-red-400 text-base mb-2" style="display:none;"></div>
      <div class="flex justify-end gap-2 mt-6">
        <button type="button" onclick="closeCreateDepartmentModal(1)" class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-4 rounded text-lg font-medium">Cancel</button>
        <button type="button" onclick="goToCreateDepartmentStep2()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-4 rounded font-semibold text-lg">Next</button>
      </div>
    </form>
  </div>
</div>

<!-- Step 2: Template Selection -->
<div id="createDepartmentStep2Modal" class="heroui-modal" style="display:none; position:fixed; z-index:3000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:600px; width:95%; position:relative; border:1px solid #35385a;">
    <button onclick="closeCreateDepartmentModal(2)" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
    <div style="text-align:center; margin-bottom:1.5rem;">
      <i class="fa fa-layer-group" style="font-size:3rem; color:#a78bfa; margin-bottom:1rem;"></i>
      <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Create a Department - Step 2 of 3</h3>
    </div>
    <div class="mb-4 text-gray-300 text-center text-lg">Select a template to quickly create a department. You can customize each template by toggling components.</div>
    <div id="templateAccordion" class="flex flex-col gap-2 mb-4"></div>
    <div id="createDeptStep2Error" class="text-red-400 text-base mb-2 text-center" style="display:none;"></div>
    <div class="flex justify-between mt-6">
      <button type="button" onclick="backToCreateDepartmentStep1()" class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-4 rounded text-lg font-medium">Back</button>
      <button type="button" id="createDeptStep2NextBtn" onclick="goToCreateDepartmentStep3()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-4 rounded font-semibold text-lg opacity-50 cursor-not-allowed" disabled>Next</button>
    </div>
  </div>
</div>

<!-- Step 3: Add Members -->
<div id="createDepartmentStep3Modal" class="heroui-modal" style="display:none; position:fixed; z-index:3000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:600px; width:95%; position:relative; border:1px solid #35385a;">
    <button onclick="closeCreateDepartmentModal(3)" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
    <div style="text-align:center; margin-bottom:1.5rem;">
      <i class="fa fa-users" style="font-size:3rem; color:#10b981; margin-bottom:1rem;"></i>
      <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Create a Department - Step 3 of 3</h3>
    </div>
    <div class="mb-4 text-gray-300 text-center text-lg">Add members to the department. Members can have multiple roles.</div>
    <div class="mb-2 text-base text-green-400 text-center" id="selectedMembersCount"></div>
    <div class="mb-4">
      <div id="selectedMembers" class="flex flex-wrap gap-2 mb-2"></div>
      <div id="memberList" class="max-h-60 overflow-y-auto"></div>
    </div>
    <div id="createDeptStep3Error" class="text-red-400 text-base mb-2 text-center" style="display:none;"></div>
    <div class="flex justify-between mt-6">
      <button type="button" onclick="backToCreateDepartmentStep2()" class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-4 rounded text-lg font-medium">Back</button>
      <button type="button" onclick="finishCreateDepartment()" class="bg-green-600 hover:bg-green-700 text-white px-6 py-4 rounded font-semibold text-lg">Finish</button>
    </div>
  </div>
</div>

<script>
// --- Modal State ---
let createDeptData = {
  name: '',
  description: '',
  image: '',
  visibility: 'public',
  template: { name: '', components: [] },
  members: []
};
let createDeptTemplates = [
  { name: "Civilian", color: "#3b82f6", description: "Basic civilian department with basic components and permissions.", permissions: [ { key: "createCivilians", label: "Create Civilians", default: true }, { key: "createVehicles", label: "Create Vehicles", default: true }, { key: "createFirearms", label: "Create Firearms", default: true }, { key: "call911", label: "Call 911", default: true } ] },
  { name: "Police", color: "#6366f1", description: "Basic police department with typical components and permissions.", permissions: [ { key: "10CodesInterface", label: "10-codes interface", default: true }, { key: "personSearch", label: "Person Search & Actions", default: true }, { key: "vehicleSearch", label: "Vehicle Search & Actions", default: true }, { key: "firearmSearch", label: "Firearm Search & Actions", default: true }, { key: "createBolos", label: "Create Bolos", default: true }, { key: "viewBolosAndWarrants", label: "View Calls, Bolos & Warrants", default: true }, { key: "notepad", label: "Notepad", default: true } ] },
  { name: "Dispatch", color: "#f59e42", description: "Can manage calls, dispatch units create bolos and more.", permissions: [ { key: "dispatchUnits", label: "Dispatch Units", default: true }, { key: "createAndManageCalls", label: "Create & Manage Calls", default: true }, { key: "createBolos", label: "Create Bolos", default: true }, { key: "manage911Calls", label: "Manage 911 Calls", default: true }, { key: "nameSearch", label: "Name Search", default: true }, { key: "vehicleSearch", label: "Vehicle Search & Actions", default: true }, { key: "firearmSearch", label: "Firearm Search & Actions", default: true } ] },
  { name: "Fire", color: "#f87171", description: "Basic fire department with basic components and permissions.", permissions: [ { key: "10CodesInterface", label: "10-codes interface", default: true }, { key: "personSearch", label: "Person Search & Actions", default: true }, { key: "vehicleSearch", label: "Vehicle Search & Actions", default: true }, { key: "createBolos", label: "Create Bolos", default: true }, { key: "viewBolosAndWarrants", label: "View Calls, Bolos & Warrants", default: true }, { key: "notepad", label: "Notepad", default: true } ] },
  { name: "EMS", color: "#10b981", description: "Basic EMS department with basic components and permissions.", permissions: [ { key: "10CodesInterface", label: "10-codes interface", default: true }, { key: "personSearch", label: "Person Search & Actions", default: true }, { key: "vehicleSearch", label: "Vehicle Search & Actions", default: true }, { key: "createBolos", label: "Create Bolos", default: true }, { key: "viewBolosAndWarrants", label: "View Calls, Bolos & Warrants", default: true }, { key: "notepad", label: "Notepad", default: true } ] },
  { name: "Custom", color: "#a3a3a3", description: "(Coming Soon!) Add a new department with custom components and permissions.", permissions: [ { key: "talkInChannels", label: "Create your own components (Coming soon)", default: true }, { key: "inviteFriends", label: "Custom features for a new department (Coming soon)", default: true } ] }
];
let createDeptPermissionsState = {};
createDeptTemplates.forEach(t => {
  let permAcc = {};
  t.permissions.forEach(p => { permAcc[p.key] = p.default; });
  createDeptPermissionsState[t.name] = permAcc;
});
let createDeptSelectedTemplate = '';
let createDeptMembers = [];
let createDeptAllMembers = [];

// --- Modal Open/Close ---
document.getElementById('openCreateDepartmentModalBtn')?.addEventListener('click', () => {
  document.getElementById('createDepartmentStep1Modal').style.display = 'flex';
});
function closeCreateDepartmentModal(step) {
  document.getElementById(`createDepartmentStep${step}Modal`).style.display = 'none';
}
function backToCreateDepartmentStep1() {
  document.getElementById('createDepartmentStep2Modal').style.display = 'none';
  document.getElementById('createDepartmentStep1Modal').style.display = 'flex';
}
function backToCreateDepartmentStep2() {
  document.getElementById('createDepartmentStep3Modal').style.display = 'none';
  document.getElementById('createDepartmentStep2Modal').style.display = 'flex';
}

// --- Step 1: Next ---
function goToCreateDepartmentStep2() {
  const name = document.getElementById('dept-name').value.trim();
  if (!name) {
    document.getElementById('createDeptStep1Error').textContent = 'Department name is required.';
    document.getElementById('createDeptStep1Error').style.display = 'block';
    return;
  }
  createDeptData.name = name;
  createDeptData.description = document.getElementById('dept-description').value.trim();
  // For now, just use a placeholder for image upload
  const photoInput = document.getElementById('dept-photo');
  createDeptData.image = photoInput && photoInput.files && photoInput.files[0] ? 'https://res.cloudinary.com/dqtwwvm7p/image/upload/v1747054441/upload_placeholder.jpg' : '';
  const vis = document.getElementById('dept-visibility');
  createDeptData.visibility = vis ? vis.value : 'public';
  document.getElementById('createDeptStep1Error').style.display = 'none';
  document.getElementById('createDepartmentStep1Modal').style.display = 'none';
  renderTemplateCards();
  document.getElementById('createDepartmentStep2Modal').style.display = 'flex';
}

// --- Step 2: Template Selection ---
function renderTemplateCards() {
  const container = document.getElementById('templateAccordion');
  container.innerHTML = '';
  createDeptTemplates.forEach((template, idx) => {
    const isSelected = createDeptSelectedTemplate === template.name;
    const hasUnsavedChanges = isSelected && createDeptUnsavedChanges;
    const card = document.createElement('div');
    card.className = 'rounded-lg shadow border bg-gray-800 border-gray-700 transition-all';
    if (isSelected) card.classList.add('border-green-500', 'ring-2', 'ring-green-400');
    card.innerHTML = `
      <button type="button" class="w-full flex justify-between items-center px-4 py-4 focus:outline-none" onclick="expandTemplateCard(${idx})">
        <span class="font-bold text-xl" style="color:${template.color}">${template.name}</span>
        <span class="flex items-center gap-2">
          ${isSelected ? '<i class=\'fa fa-check-circle text-green-400 text-2xl\'></i>' : ''}
          <i id="template-arrow-${idx}" class="fa fa-chevron-down text-gray-400 transition-transform text-lg"></i>
        </span>
      </button>
      <div id="template-details-${idx}" class="px-4 pb-4" style="display:${isSelected ? 'block' : 'none'};">
        <div class="text-gray-400 text-base mb-3">${template.description}</div>
        <div class="mb-3">
          ${template.permissions.map(perm => `
            <label class="flex items-center gap-3 mb-2">
              <input type="checkbox" ${createDeptPermissionsState[template.name][perm.key] ? 'checked' : ''} onchange="onTemplatePermissionChange('${template.name}','${perm.key}',this.checked)" class="form-checkbox text-blue-600 w-4 h-4" />
              <span class="text-base">${perm.label}</span>
            </label>
          `).join('')}
        </div>
        ${isSelected ? (
          hasUnsavedChanges
            ? `<button type="button" class="w-full bg-green-600 hover:bg-green-700 text-white py-2 rounded mt-3 font-semibold transition text-lg" onclick="saveTemplatePermissionChanges('${template.name}')"><i class='fa fa-save mr-2'></i>Save</button>`
            : `<button type="button" class="w-full bg-gray-600 text-gray-300 cursor-not-allowed py-2 rounded mt-3 font-semibold transition text-lg" disabled>Selected</button>`
        ) : `<button type="button" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded mt-3 font-semibold transition text-lg" onclick="selectCreateDeptTemplate('${template.name}')">Select</button>`}
      </div>
    `;
    container.appendChild(card);
  });
  // Update Next button state
  const nextBtn = document.getElementById('createDeptStep2NextBtn');
  if (createDeptSelectedTemplate && !createDeptUnsavedChanges) {
    nextBtn.disabled = false;
    nextBtn.classList.remove('opacity-50','cursor-not-allowed');
  } else {
    nextBtn.disabled = true;
    nextBtn.classList.add('opacity-50','cursor-not-allowed');
  }
}
window.onTemplatePermissionChange = function(templateName, permKey, checked) {
  createDeptPermissionsState[templateName][permKey] = checked;
  if (createDeptSelectedTemplate === templateName) {
    createDeptUnsavedChanges = true;
    renderTemplateCards();
  }
}
window.saveTemplatePermissionChanges = function(templateName) {
  createDeptUnsavedChanges = false;
  renderTemplateCards();
  showToast('Template permissions updated!', 1500);
}
window.selectCreateDeptTemplate = function(templateName) {
  createDeptSelectedTemplate = templateName;
  createDeptUnsavedChanges = false;
  renderTemplateCards();
}
// Add this variable to modal state:
let createDeptUnsavedChanges = false;

// --- Step 3: Add Members with Infinite Scrolling ---
let membersPage = 1;
let membersLimit = 50; // Increased limit for better performance
let membersTotal = 0;
let isLoadingMore = false;
let hasMoreMembers = true;

function fetchCommunityMembers(page = 1, append = false) {
  if (isLoadingMore) return;
  
  isLoadingMore = true;
  const communityId = '<%= community._id %>';
  
  // Show loading indicator if this is the first load
  if (page === 1) {
    const memberList = document.getElementById('memberList');
    if (memberList) {
      memberList.innerHTML = `
        <div class="text-center py-4">
          <i class="fas fa-spinner fa-spin fa-lg text-blue-500"></i>
          <p class="text-gray-400 mt-2">Loading members...</p>
        </div>
      `;
    }
  }
  
  fetch(`${API_URL}/api/v1/community/${communityId}/members?limit=${membersLimit}&page=${page}`)
    .then(res => {
      if (!res.ok) {
        throw new Error(`Failed to fetch members: ${res.status} ${res.statusText}`);
      }
      return res.json();
    })
    .then(data => {
      let newMembers = data.members || [];
      membersTotal = data.totalUsers || 0;
      
      if (append) {
        // Append new members to existing list
        createDeptAllMembers = [...createDeptAllMembers, ...newMembers];
      } else {
        // Replace existing members (first load)
        createDeptAllMembers = newMembers;
      }
      
      // Check if there are more members to load
      hasMoreMembers = createDeptAllMembers.length < membersTotal;
      
      // Ensure current user is always selected and can't be deselected
      const currentUserId = '<%= user && user._doc ? user._doc._id : (user && user._id ? user._id : "") %>';
      const currentUser = createDeptAllMembers.find(m => m._id === currentUserId);
      if (currentUser && !createDeptMembers.some(m => m._id === currentUserId)) {
        createDeptMembers.unshift(currentUser); // Add to beginning of array
      }
      
      renderMemberList();
      
      // Hide step 2 modal and show step 3 (only on first load)
      if (page === 1) {
        document.getElementById('createDepartmentStep2Modal').style.display = 'none';
        document.getElementById('createDepartmentStep3Modal').style.display = 'flex';
      }
      
      isLoadingMore = false;
    })
    .catch(error => {
      isLoadingMore = false;
      
      if (typeof showToast === 'function') {
        showToast(`Failed to load members: ${error.message}`, 3000);
      } else {
        alert(`Failed to load members: ${error.message}`);
      }
    });
}

function loadMoreMembers() {
  if (!hasMoreMembers || isLoadingMore) return;
  
  membersPage++;
  fetchCommunityMembers(membersPage, true);
}

function renderMemberList() {
  const memberList = document.getElementById('memberList');
  const selectedMembersDiv = document.getElementById('selectedMembers');
  const selectedMembersCount = document.getElementById('selectedMembersCount');
  
  // Clear existing content
  memberList.innerHTML = '';
  selectedMembersDiv.innerHTML = '';
  
  // Render all members
  createDeptAllMembers.forEach(member => {
    const isSelected = createDeptMembers.some(m => m._id === member._id);
    const currentUserId = '<%= user && user._doc ? user._doc._id : (user && user._id ? user._id : "") %>';
    const isCurrentUser = member._id === currentUserId;
    
    const div = document.createElement('div');
    div.className = 'flex items-center gap-3 mb-2';
    div.innerHTML = `
      <input type="checkbox" 
        ${isCurrentUser ? 'checked' : (isSelected ? 'checked' : '')} 
        ${isCurrentUser ? 'disabled style="opacity: 0.5; cursor: not-allowed;"' : ''} 
        onchange="toggleCreateDeptMember('${member._id}')" 
        class="w-5 h-5" />
      <img src="${member.user.profilePicture || `https://ui-avatars.com/api/?name=${member.user.username}&background=808080&color=fff&size=256`}" class="w-8 h-8 rounded-full" />
      <span class="text-lg" ${isCurrentUser ? 'style="color: #6c757d; font-style: italic;"' : ''}>${member.user.username}${isCurrentUser ? ' (You - Required)' : ''}</span>
    `;
    memberList.appendChild(div);
    
    if (isSelected) {
      const selDiv = document.createElement('div');
      selDiv.className = 'flex items-center gap-2 bg-gray-700 rounded px-3 py-2 mb-2';
      selDiv.innerHTML = `
        <img src="${member.user.profilePicture || `https://ui-avatars.com/api/?name=${member.user.username}&background=808080&color=fff&size=256`}" class="w-6 h-6 rounded-full" />
        <span class="text-base">${member.user.username}</span>
        ${member._id !== '<%= user && user._doc ? user._doc._id : (user && user._id ? user._id : "") %>' ? `<button onclick="toggleCreateDeptMember('${member._id}')" class="ml-2 text-red-400 text-lg">&times;</button>` : ''}
      `;
      selectedMembersDiv.appendChild(selDiv);
    }
  });
  
  // Add infinite scroll trigger at the bottom
  if (hasMoreMembers) {
    const loadMoreDiv = document.createElement('div');
    loadMoreDiv.className = 'text-center py-3';
    loadMoreDiv.innerHTML = `
      <button onclick="loadMoreMembers()" class="text-blue-400 hover:text-blue-300 text-lg font-medium">
        ${isLoadingMore ? '<i class="fas fa-spinner fa-spin"></i> Loading...' : 'Load more members'}
      </button>
    `;
    memberList.appendChild(loadMoreDiv);
  }
  
          selectedMembersCount.textContent = `${createDeptMembers.length} ${createDeptMembers.length === 1 ? 'member' : 'members'} selected`;
}

function toggleCreateDeptMember(memberId) {
  // Prevent current user from being deselected
  const currentUserId = '<%= user && user._doc ? user._doc._id : (user && user._id ? user._id : "") %>';
  if (memberId === currentUserId) {
    return;
  }
  
  const idx = createDeptMembers.findIndex(m => m._id === memberId);
  if (idx === -1) {
    const member = createDeptAllMembers.find(m => m._id === memberId);
    if (member) createDeptMembers.push(member);
  } else {
    createDeptMembers.splice(idx, 1);
  }
  renderMemberList();
}

function finishCreateDepartment(skipMembers = false) {
  if (!skipMembers && createDeptMembers.length === 0) {
    document.getElementById('createDeptStep3Error').textContent = 'At least one member is required.';
    document.getElementById('createDeptStep3Error').style.display = 'block';
    return;
  }
  document.getElementById('createDeptStep3Error').style.display = 'none';
  createDeptData.members = createDeptMembers.map(m => ({ userID: m._id, status: 'approved' }));
  const communityId = '<%= community._id %>';
  // Map visibility to approvalRequired and build payload
  const payload = {
    name: createDeptData.name,
    description: createDeptData.description,
    image: createDeptData.image,
    approvalRequired: createDeptData.visibility === 'private',
    members: createDeptData.members,
    template: createDeptData.template
  };
  fetch(`${API_URL}/api/v1/community/${communityId}/departments`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  })
    .then(async res => {
      const text = await res.text();
      try {
        return JSON.parse(text);
      } catch (e) {
        throw new Error('Server did not return JSON. See console for details.');
      }
    })
    .then(response => {
      if (!skipMembers) {
        fetch(`${API_URL}/api/v1/community/${communityId}/departments/${response.department_id}/members`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ memberIds: createDeptMembers.map(m => m._id) })
        })
          .then(() => {
            closeCreateDepartmentModal(3);
            showToast('Department created successfully!', 2500);
            window.location.reload();
          });
      } else {
        closeCreateDepartmentModal(3);
        showToast('Department created successfully!', 2500);
        window.location.reload();
      }
    })
    .catch(err => {
      document.getElementById('createDeptStep3Error').textContent = err.message || 'Failed to create department.';
      document.getElementById('createDeptStep3Error').style.display = 'block';
    });
}

// --- Step 1: Photo Upload & Visibility ---
function handleDeptPhotoChange(e) {
  const file = e.target.files[0];
  const preview = document.getElementById('dept-photo-preview');
  if (file) {
    const reader = new FileReader();
    reader.onload = function(ev) {
      preview.src = ev.target.result;
      preview.style.display = 'block';
    };
    reader.readAsDataURL(file);
  } else {
    preview.src = '';
    preview.style.display = 'none';
  }
}
function setDeptVisibility(val) {
  document.getElementById('dept-visibility').value = val;
  if (val === 'public') {
    document.getElementById('visibility-public').classList.add('bg-blue-600','text-white');
    document.getElementById('visibility-public').classList.remove('bg-gray-700','text-gray-200');
    document.getElementById('visibility-private').classList.add('bg-gray-700','text-gray-200');
    document.getElementById('visibility-private').classList.remove('bg-blue-600','text-white');
  } else {
    document.getElementById('visibility-private').classList.add('bg-blue-600','text-white');
    document.getElementById('visibility-private').classList.remove('bg-gray-700','text-gray-200');
    document.getElementById('visibility-public').classList.add('bg-gray-700','text-gray-200');
    document.getElementById('visibility-public').classList.remove('bg-blue-600','text-white');
  }
}

function goToCreateDepartmentStep3() {
  if (!createDeptSelectedTemplate) {
    document.getElementById('createDeptStep2Error').textContent = 'Please select a template.';
    document.getElementById('createDeptStep2Error').style.display = 'block';
    return;
  }
  createDeptData.template = {
    name: createDeptSelectedTemplate,
    components: Object.keys(createDeptPermissionsState[createDeptSelectedTemplate]).map(key => ({ name: key, enabled: createDeptPermissionsState[createDeptSelectedTemplate][key] }))
  };
  document.getElementById('createDeptStep2Error').style.display = 'none';
  
  // Show loading state instead of hiding modal
  const step2Modal = document.getElementById('createDepartmentStep2Modal');
  const modalContent = step2Modal.querySelector('div[style*="background:#1e2028"]');
  const templateAccordion = document.getElementById('templateAccordion');
  const buttonsContainer = step2Modal.querySelector('.flex.justify-between');
  
  if (templateAccordion && buttonsContainer) {
    templateAccordion.innerHTML = `
      <div class="text-center">
        <i class="fas fa-spinner fa-spin fa-2x text-blue-500 mb-3"></i>
        <p class="text-gray-300">Loading members...</p>
      </div>
    `;
    buttonsContainer.style.display = 'none';
  }
  
  fetchCommunityMembers();
}

window.expandTemplateCard = function(idx) {
  createDeptTemplates.forEach((template, i) => {
    const details = document.getElementById(`template-details-${i}`);
    const arrow = document.getElementById(`template-arrow-${i}`);
    if (details) {
      if (i === idx) {
        details.style.display = details.style.display === 'block' ? 'none' : 'block';
        if (arrow) arrow.style.transform = details.style.display === 'block' ? 'rotate(180deg)' : '';
      } else {
        details.style.display = 'none';
        if (arrow) arrow.style.transform = '';
      }
    }
  });
}
