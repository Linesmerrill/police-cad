    rolesSearchInput.addEventListener('input', function(e) {
      const query = e.target.value;
      const clearBtn = document.getElementById('rolesSearchClear');
      
      if (query.trim()) {
        clearBtn.style.display = 'block';
        searchRoles(query);
      } else {
        clearBtn.style.display = 'none';
        searchRoles('');
      }
    });
