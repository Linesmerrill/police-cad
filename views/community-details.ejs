      <p style="font-size:1rem;">Are you sure you want to leave this community?</p>
      <p style="font-size:1rem; margin-top:0.5rem; color:#f56565;">This action cannot be undone.</p>
    </div>
    <div id="leaveCommunityError" style="display:none; color:#f56565; text-align:center; margin-bottom:1rem;"></div>
    <div style="margin-top:2rem; text-align:center; display:flex; justify-content:center; gap:1rem;">
      <button id="leaveCommunityModalCancel" type="button" style="background:#35385a; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1rem;">
        Cancel
      </button>
      <button id="leaveCommunityModalConfirm" type="button" style="background:#f56565; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1rem;">
        Leave Community
      </button>
    </div>
  </div>
</div>
<script>
function openLeaveCommunityModal() {
  document.getElementById('leaveCommunityModal').style.display = 'flex';
}
function submitLeaveCommunity() {
  const userId = '<%= user && user._doc ? user._doc._id : "" %>';
  const communityId = '<%= community._id %>';
  const errorDiv = document.getElementById('leaveCommunityError');
  errorDiv.style.display = 'none';
  errorDiv.textContent = '';

  // Show loading state (optional)
  const leaveBtn = document.getElementById('leaveCommunityModalConfirm');
  if (leaveBtn) {
    leaveBtn.disabled = true;
    leaveBtn.textContent = 'Leaving...';
  }

  fetch(`${API_URL}/user/${userId}/remove-community`, {
    method: "DELETE",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({ communityId }),
  })
    .then(async (response) => {
      if (!response.ok) {
        const data = await response.json();
        throw new Error(
          `Failed to remove user from community.\n\nMessage: ${data.message}.\nCode: ${response.status}`
        );
      }
      return response.json();
    })
    .then(() => {
      localStorage.setItem('leftCommunityToast', '1');
      window.location.href = "/communities";
    })
    .catch((error) => {
      errorDiv.style.display = 'block';
      errorDiv.textContent = error.message || "An error occurred.";
      if (leaveBtn) {
        leaveBtn.disabled = false;
        leaveBtn.textContent = 'Leave Community';
      }
    });
}
</script>

