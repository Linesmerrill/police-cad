        </div>

        <!-- Events Section -->
        <div id="events-section" class="card">
          <%
            // Permission logic for managing events (EJS, like departments)
            let canManageEvents = false;
            if (userId && community.community && Array.isArray(community.community.roles)) {
              community.community.roles.forEach(function(role) {
                if (Array.isArray(role.members) && role.members.includes(userId)) {
                  if (Array.isArray(role.permissions)) {
                    role.permissions.forEach(function(perm) {
                      if (
                        (perm.name === "administrator" && perm.enabled === true) ||
                        (perm.name === "manage community events" && perm.enabled === true)
                      ) {
                        canManageEvents = true;
                      }
                    });
                  }
                }
              });
            }
          %>
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-3xl font-semibold">Events</h2>
            <% if (isMemberApproved) { %>
              <% if (canManageEvents) { %>
               <button onclick="openCreateEventModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-semibold shadow transition flex items-center text-lg">
                 <i class="fa fa-plus mr-3"></i> Create Event
               </button>
             <% } else { %>
               <button onclick="openNoEventPermissionModal()" class="bg-gray-500 text-white px-6 py-3 rounded-full font-semibold shadow opacity-60 cursor-not-allowed flex items-center text-lg" style="pointer-events:auto;">
                 <i class="fa fa-plus mr-3"></i> Create Event
               </button>
             <% } %>
           <% } %>
         </div>
         
         <% if (!isMemberApproved) { %>
           <div class="text-center py-12">
             <div class="bg-gray-800 rounded-lg p-8 border border-gray-700 shadow-lg opacity-70">
               <i class="fa fa-lock text-gray-400 text-4xl mb-4"></i>
               <h3 class="text-xl font-semibold text-gray-300 mb-2">Events Hidden</h3>
               <p class="text-gray-400 text-lg mb-4">You cannot view events as you are not a member yet.</p>
               <% if (isMemberPending) { %>
                 <button disabled class="bg-gray-500 text-white px-6 py-3 rounded-full font-semibold shadow transition text-lg cursor-not-allowed">
                   Pending
                 </button>
               <% } else { %>
                 <button onclick="openRequestJoinModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-semibold shadow transition text-lg">
                   Request to Join Here
                 </button>
               <% } %>
             </div>
           </div>
         <% } else { %>
         <%
           // Pagination for events
           const eventsPerPage = 4;
           const eventPage = parseInt((typeof query !== 'undefined' && query.eventPage) ? query.eventPage : 1, 10) || 1;
           const allEvents = community.community.events || [];
           const totalEventPages = Math.max(1, Math.ceil(allEvents.length / eventsPerPage));
           const pagedEvents = allEvents.slice((eventPage - 1) * eventsPerPage, eventPage * eventsPerPage);
         %>
         <ul class="text-left mx-auto max-w-4xl">
           <% pagedEvents.forEach(function(event) { %>
             <% if (isMemberApproved) { %>
               <li class="mb-6 p-6 rounded bg-gray-800 border border-gray-700 flex flex-col sm:flex-row items-start gap-6 relative">
                 <img src="<%= event.image || '/static/images/default-logo.png' %>" alt="Event Image" class="w-40 h-32 object-cover rounded mb-4 sm:mb-0" style="min-width:10rem; max-width:10rem; max-height:8rem;" />
                 <div class="flex-1">
                   <div class="flex items-center justify-between mb-3">
                     <div class="font-semibold text-2xl text-white"><%= event.title %></div>
                     <% if (canManageEvents) { %>
                       <button class="text-gray-400 hover:text-blue-400 z-10 bg-gray-900 bg-opacity-70 rounded-full p-2 ml-3" title="Edit Event" onclick="event.stopPropagation(); openEditEventModal('<%= event._id %>')">
                         <i class="fa fa-pencil-alt text-lg"></i>
                       </button>
                     <% } %>
                   </div>
                   <div class="text-gray-400 text-lg mb-3"><%= new Date(event.scheduledDate).toLocaleString() %></div>
                   <div class="text-gray-300 text-lg mb-3"><%= event.description %></div>
                   <% if (event.location) { %>
                     <div class="text-gray-500 text-base">Location: <%= event.location %></div>
                   <% } %>
                 </div>
               </li>
             <% } else { %>
               <li class="mb-6 p-6 rounded bg-gray-800 border border-gray-700 relative opacity-70 cursor-not-allowed flex flex-col sm:flex-row items-start gap-6">
                 <img src="<%= event.image || '/static/images/default-logo.png' %>" alt="Event Image" class="w-40 h-32 object-cover rounded mb-4 sm:mb-0" style="min-width:10rem; max-width:10rem; max-height:8rem;" />
                 <div class="flex-1 relative z-0">
                   <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-10">
                     <% if (isMemberApproved) { %>
                       <span class="bg-black bg-opacity-60 text-white text-base px-3 py-2 rounded">Private</span>
                     <% } else { %>
                       <span class="bg-black bg-opacity-60 text-white text-base px-3 py-2 rounded">Members Only</span>
                     <% } %>
                   </div>
                   <div class="font-semibold text-xl text-white mb-2"><%= event.title %></div>
                   <div class="text-gray-400 text-base mb-2"><%= new Date(event.scheduledDate).toLocaleString() %></div>
                   <div class="text-gray-300 text-base mb-2"><%= event.description %></div>
                   <% if (event.location) { %>
                     <div class="text-gray-500 text-sm">Location: <%= event.location %></div>
                   <% } %>
                   <% if (!isMemberApproved && !isMemberPending) { %>
                     <div class="absolute bottom-4 left-4 right-4 z-20">
                       <button onclick="event.stopPropagation(); openRequestJoinModal()" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded font-semibold transition text-sm">
                         Request to Join
                       </button>
                     </div>
                   <% } %>
                 </div>
               </li>
             <% } %>
           <% }); %>
         </ul>
         <% if (totalEventPages > 1) { %>
           <div class="flex justify-center items-center gap-4 mt-6">
             <form method="get" style="display:inline;">
               <% if (typeof query !== 'undefined') { %>
                 <% Object.keys(query).forEach(function(key) { %>
                   <% if (key !== 'eventPage') { %>
                     <input type="hidden" name="<%= key %>" value="<%= query[key] %>" />
                   <% } %>
                 <% }); %>
               <% } %>
               <input type="hidden" name="eventPage" value="<%= eventPage - 1 %>" />
               <button type="submit" class="px-6 py-3 rounded bg-gray-700 text-white font-semibold text-lg" <% if (eventPage <= 1) { %>disabled style="opacity:0.5;cursor:not-allowed;"<% } %>>Prev</button>
             </form>
             <span class="text-gray-300 text-lg">Page <%= eventPage %> of <%= totalEventPages %></span>
             <form method="get" style="display:inline;">
               <% if (typeof query !== 'undefined') { %>
                 <% Object.keys(query).forEach(function(key) { %>
                   <% if (key !== 'eventPage') { %>
                     <input type="hidden" name="<%= key %>" value="<%= query[key] %>" />
                   <% } %>
                 <% }); %>
               <% } %>
               <input type="hidden" name="eventPage" value="<%= eventPage + 1 %>" />
               <button type="submit" class="px-6 py-3 rounded bg-gray-700 text-white font-semibold text-lg" <% if (eventPage >= totalEventPages) { %>disabled style="opacity:0.5;cursor:not-allowed;"<% } %>>Next</button>
             </form>
           </div>
         <% } %>
         <% } %>
       </div>

        <!-- HeroUI Pro Features Section -->
        <div class="bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 py-16 mt-16 rounded-lg">
