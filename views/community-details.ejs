      // General Settings Modal Functions
      function openGeneralSettingsModal() {
        document.getElementById('generalSettingsModal').style.display = 'flex';
        
        // Show loading state immediately
        document.getElementById('generalSettingsLoading').style.display = 'flex';
        
        // Always refresh data when opening modal to show latest information
        refreshGeneralSettings();
        
