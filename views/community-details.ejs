      // Members Modal Functions
      let communityMembersData = [];
      let communityMembersPage = 1;
      let communityMembersLimit = 20;
      let communityMembersTotal = 0;
      let communityFilteredMembers = [];
      let communityCurrentSearchTerm = '';

      function openMembersModal() {
        // Show loading state on the card
        showMembersCardLoading();
        
        // Ensure the modal exists (create if needed)
        const modal = ensureMembersModalExists();
        
        if (!modal) {
          hideMembersCardLoading();
          showToast('Error: Could not create members modal', 3000, 'error');
          return;
        }
        
        // Modal exists, display it
        modal.style.display = 'flex';
        
        // Wait for all required elements to be available before loading members
        waitForMembersElements(() => {
          loadMembers();
        });
      }

      function closeMembersModal() {
        const modal = document.getElementById('membersModal');
        if (!modal) {
          return;
        }
        
        modal.style.display = 'none';
        // Reset search
        const searchInput = document.getElementById('memberSearchInput');
        if (searchInput) {
          searchInput.value = '';
        }
        communityCurrentSearchTerm = '';
        communityFilteredMembers = [];
        
        // Ensure card loading state is reset
        hideMembersCardLoading();
      }

      function closeMemberActionsModal() {
        const modal = document.getElementById('memberActionsModal');
        if (!modal) {
          return;
        }
        
        modal.style.display = 'none';
        
        // Clear the selected member info when modal is closed
        selectedMemberId = null;
        selectedMemberUsername = null;
      }

      async function loadMembers(page = 1) {
        const loadingDiv = document.getElementById('membersLoading');
        const listContainer = document.getElementById('membersListContainer');
        const paginationDiv = document.getElementById('membersPagination');
        
        // Safety check - ensure required elements exist (loadingDiv is optional)
        if (!listContainer || !paginationDiv) {
          return;
        }
        
        try {
          // Show loading if element exists
          if (loadingDiv) {
            loadingDiv.style.display = 'block';
          }
          listContainer.innerHTML = '';
          paginationDiv.style.display = 'none';
          
          const communityId = '<%= community._id %>';
          const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
          
          const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/members?limit=${communityMembersLimit}&page=${page}`);
          
          if (!response.ok) {
            throw new Error(`Failed to fetch members: ${response.status}`);
          }
          
          const data = await response.json();
          
          communityMembersData = data.members || [];
          communityMembersTotal = data.totalUsers || 0;
          communityMembersPage = page;
          
          // Apply current search filter if exists
          if (communityCurrentSearchTerm) {
            communityFilteredMembers = communityMembersData.filter(member => 
              member.user?.username?.toLowerCase().includes(communityCurrentSearchTerm.toLowerCase()) ||
              member.user?.email?.toLowerCase().includes(communityCurrentSearchTerm.toLowerCase()) ||
              getMemberRole(member)?.toLowerCase().includes(communityCurrentSearchTerm.toLowerCase())
            );
          } else {
            communityFilteredMembers = [...communityMembersData];
          }
          
          renderMembersList();
          updatePagination();
          
          // Hide pagination loading state after new page is loaded
          hidePaginationLoading();
          
        } catch (error) {
          listContainer.innerHTML = `
            <div style="color:#ef4444; text-align:center; padding:2rem;">
              <i class="fa fa-exclamation-triangle" style="font-size:2rem; margin-bottom:1rem;"></i>
              <p>Failed to load members: ${error.message}</p>
            </div>
          `;
          
          // Hide pagination loading state on error
          hidePaginationLoading();
        } finally {
          // Hide loading if element exists
          if (loadingDiv) {
            loadingDiv.style.display = 'none';
          }
          // Hide the card loading state when members are loaded (success or error)
          hideMembersCardLoading();
        }
      }

      function renderMembersList() {
        const listContainer = document.getElementById('membersListContainer');
        
        // Safety check - ensure the container exists
        if (!listContainer) {
          return;
        }
        
        if (communityFilteredMembers.length === 0) {
          listContainer.innerHTML = `
            <div style="text-align:center; padding:2rem; color:#a0aec0;">
              <i class="fa fa-users" style="font-size:2rem; margin-bottom:1rem;"></i>
              <p>${communityCurrentSearchTerm ? 'No members found matching your search.' : 'No members found.'}</p>
            </div>
          `;
          return;
        }
        
        const membersHtml = communityFilteredMembers.map(member => `
          <div class="member-item" style="background:#2d3748; border:1px solid #4a5568; border-radius:8px; padding:1rem; margin-bottom:0.75rem; cursor:pointer; transition:all 0.2s; hover:border-color:#3b82f6;" onclick="openMemberActions('${member._id}')">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <div style="flex:1;">
                <div style="display:flex; align-items:center; gap:0.75rem;">
                  <div style="width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#4a5568;">
                    ${member.user?.profilePicture ? 
                      `<img src="${member.user.profilePicture}" alt="${member.user.username || 'User'}" style="width:100%; height:100%; object-fit:cover;">` : 
                      `<i class="fa fa-user" style="color:#a0aec0; font-size:1.25rem;"></i>`
                    }
                  </div>
                  <div>
                    <h4 style="color:#fff; margin:0; font-size:1rem; font-weight:600;">
                      ${member.user?.username || 'Unknown User'}
                      ${member._id === '<%= community.community.ownerID %>' ? ' <i class="fa fa-crown" style="color:#f59e0b; font-size:0.75rem;"></i>' : ''}
                    </h4>
                    ${member.user?.callSign ? `<p style="color:#a0aec0; margin:0; font-size:0.75rem;">Call Sign: ${member.user.callSign}</p>` : ''}
                  </div>
                </div>
              </div>
              <div style="text-align:right;">
                <div style="color:#10b981; font-size:0.875rem; font-weight:500; margin-bottom:0.25rem;">
                  ${getMemberRole(member) || 'Member'}
                </div>
                <div style="color:#a0aec0; font-size:0.75rem;">
                  Member since ${getMemberJoinDate(member)}
                </div>
                ${member.user?.isOnline ? '<div style="color:#10b981; font-size:0.75rem;"><i class="fa fa-circle"></i> Online</div>' : ''}
              </div>
            </div>
          </div>
        `).join('');
        
        listContainer.innerHTML = membersHtml;
      }

      function updatePagination() {
        const paginationDiv = document.getElementById('membersPagination');
        const pageInfo = document.getElementById('pageInfo');
        const prevBtn = document.getElementById('prevPageBtn');
        const nextBtn = document.getElementById('nextPageBtn');
        
        // Safety check - ensure all required elements exist
        if (!paginationDiv || !pageInfo || !prevBtn || !nextBtn) {
          return;
        }
        
        const totalPages = Math.ceil(communityMembersTotal / communityMembersLimit);
        
        if (totalPages <= 1) {
          paginationDiv.style.display = 'none';
          return;
        }
        
        paginationDiv.style.display = 'flex';
        pageInfo.textContent = `Page ${communityMembersPage} of ${totalPages}`;
        
        prevBtn.disabled = communityMembersPage <= 1;
        prevBtn.style.opacity = communityMembersPage <= 1 ? '0.5' : '1';
        prevBtn.style.cursor = communityMembersPage <= 1 ? 'not-allowed' : 'pointer';
        
        nextBtn.disabled = communityMembersPage >= totalPages;
        nextBtn.style.opacity = communityMembersPage >= totalPages ? '0.5' : '1';
        nextBtn.style.cursor = communityMembersPage >= totalPages ? 'not-allowed' : 'pointer';
      }

      function changeMembersPage(direction) {
        const newPage = communityMembersPage + direction;
        const totalPages = Math.ceil(communityMembersTotal / communityMembersLimit);
        
        if (newPage >= 1 && newPage <= totalPages) {
          // Show pagination loading state
          showPaginationLoading();
          loadMembers(newPage);
        }
      }

      function searchMembers(searchTerm) {
        communityCurrentSearchTerm = searchTerm;
        
        if (!searchTerm.trim()) {
          communityFilteredMembers = [...communityMembersData];
        } else {
          const searchLower = searchTerm.toLowerCase();
          communityFilteredMembers = communityMembersData.filter(member => 
            member.user?.username?.toLowerCase().includes(searchLower) ||
            member.user?.email?.toLowerCase().includes(searchLower) ||
            getMemberRole(member)?.toLowerCase().includes(searchLower)
          );
        }
        
        renderMembersList();
      }

