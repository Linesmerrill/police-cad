                <button onclick="openNoInvitePermissionModal()" class="flex flex-col items-center p-6 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors text-lg" style="pointer-events:auto;">
                  <i class="fa-solid fa-user-plus w-8 h-8 mb-3 text-2xl"></i>
                  <span class="text-lg font-medium">Invite</span>
                </button>
              <% } %>
            <% } else { %>
              <!-- Non-members see disabled buttons with member-only modal -->
              <button onclick="openMemberOnlyModal()" class="flex flex-col items-center p-6 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors">
                <i class="fa-solid fa-bullhorn w-8 h-8 mb-3 text-2xl"></i>
                <span class="text-lg font-medium">Promote</span>
              </button>
              
              <button onclick="openMemberOnlyModal()" class="flex flex-col items-center p-6 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors">
                <i class="fa-solid fa-gear w-8 h-8 mb-3 text-2xl"></i>
                <span class="text-lg font-medium">Settings</span>
              </button>
              
              <button onclick="openMemberOnlyModal()" class="flex flex-col items-center p-6 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors">
                <i class="fa-solid fa-user-plus w-8 h-8 mb-3 text-2xl"></i>
                <span class="text-lg font-medium">Invite</span>
              </button>
            <% } %>
            
            <!-- Share button - always available -->
            <button onclick="copyCommunityUrl()" class="flex flex-col items-center p-6 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-colors">
              <i class="fa-solid fa-share-nodes w-8 h-8 mb-3 text-2xl"></i>
              <span class="text-lg font-medium">Share</span>
            </button>
          </div>
        </div>
          
        <%
          // Permission logic for managing departments
          let canManageDepartments = false;
          if (userId && community.community && Array.isArray(community.community.roles)) {
            community.community.roles.forEach(function(role) {
              if (Array.isArray(role.members) && role.members.includes(userId)) {
                if (Array.isArray(role.permissions)) {
                  role.permissions.forEach(function(perm) {
                    if (
                      (perm.name === "administrator" && perm.enabled === true) ||
                      (perm.name === "manage departments" && perm.enabled === true)
                    ) {
                      canManageDepartments = true;
                    }
                  });
                }
              }
            });
          }
        %>
        
        <!-- Departments Section -->
        <div id="departments-section" class="card">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-3xl font-semibold">Departments</h2>
            <% if (isMemberApproved) { %>
              <% if (canManageDepartments) { %>
                <button onclick="openCreateDepartmentModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-semibold shadow transition flex items-center text-lg">
                  <i class="fa fa-plus mr-3"></i> Create Department
                </button>
              <% } else { %>
                <button onclick="openNoDepartmentPermissionModal()" class="bg-gray-500 text-white px-6 py-3 rounded-full font-semibold shadow opacity-60 cursor-not-allowed flex items-center text-lg" style="pointer-events:auto;">
                  <i class="fa fa-plus mr-3"></i> Create Department
                </button>
              <% } %>
            <% } %>
          </div>
          
          <% if (!isMemberApproved) { %>
            <div class="text-center py-12">
              <div class="bg-gray-800 rounded-lg p-8 border border-gray-700 shadow-lg opacity-70">
                <i class="fa fa-lock text-gray-400 text-4xl mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-300 mb-2">Departments Hidden</h3>
                <p class="text-gray-400 text-lg mb-4">You cannot view departments as you are not a member yet.</p>
                <% if (isMemberPending) { %>
                  <button disabled class="bg-gray-500 text-white px-6 py-3 rounded-full font-semibold shadow transition text-lg cursor-not-allowed">
                    Pending
                  </button>
                <% } else { %>
                  <button onclick="openRequestJoinModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-semibold shadow transition text-lg">
                    Request to Join Here
                  </button>
                <% } %>
              </div>
            </div>
          <% } else if (departments && departments.length) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <% departments.forEach(function(dept) { 
                var templateName = dept.template && dept.template.name ? dept.template.name : '';
                var approvalRequired = dept.approvalRequired;
                var members = Array.isArray(dept.members) ? dept.members : [];
                var isMember = members.some(function(m) { return m.userID === userId && m.status === 'approved'; });
                var isAdmin = false;
                if (userId && community.community && Array.isArray(community.community.roles)) {
                  community.community.roles.forEach(function(role) {
                    if (Array.isArray(role.members) && role.members.includes(userId)) {
                      if (Array.isArray(role.permissions)) {
                        role.permissions.forEach(function(perm) {
                          if (perm.name === "administrator" && perm.enabled === true) {
                            isAdmin = true;
                          }
                        });
                      }
                    }
                  });
                }
                var canAccess = isAdmin || !approvalRequired || isMember;
                // Determine dashboard URL
                var dashboardUrl = '';
                var lowerTemplate = templateName.toLowerCase();
                if (lowerTemplate.includes('civilian')) {
                  dashboardUrl = `/civ-dashboard?dept=${encodeURIComponent(dept.name)}&d=${dept._id}`;
                } else if (lowerTemplate.includes('police')) {
                  dashboardUrl = `/police-dashboard?dept=${encodeURIComponent(dept.name)}&d=${dept._id}`;
                } else if (lowerTemplate.includes('fire') || lowerTemplate.includes('ems')) {
                  dashboardUrl = `/ems-dashboard?dept=${encodeURIComponent(dept.name)}&d=${dept._id}`;
                } else if (lowerTemplate.includes('dispatch')) {
                  dashboardUrl = `/dispatch-dashboard?dept=${encodeURIComponent(dept.name)}&d=${dept._id}`;
                }
              %>
                <div class="relative block bg-gray-800 rounded-lg shadow hover:shadow-lg transition p-6 border border-gray-700 <%= canAccess ? 'hover:border-blue-500 cursor-pointer' : 'opacity-70 cursor-not-allowed' %>"
                  <%- canAccess && dashboardUrl ? `onclick="navigateToDepartment('${dept._id}', '${dept.name.replace(/'/g, "\\'")}', '${templateName.replace(/'/g, "\\'")}')"` : '' %>>
                  <% if (canManageDepartments) { %>
                    <button class="absolute top-3 right-3 text-gray-400 hover:text-blue-400 z-10 bg-gray-900 bg-opacity-70 rounded-full p-2" title="Edit Department" onclick="event.stopPropagation(); openEditDepartmentModal('<%= dept._id %>');">
                      <i class="fa fa-pencil-alt text-lg"></i>
                    </button>
                  <% } %>
                  <img src="<%= dept.image || '/static/images/default-logo.png' %>" alt="<%= dept.name %>" class="w-full h-40 object-cover rounded mb-4" />
                  <div class="font-bold text-2xl text-white mb-3"><%= dept.name %></div>
                  <div class="text-gray-400 text-lg mb-3"><%= dept.description || '' %></div>
                  <div class="text-base text-gray-500"><%= dept.template && dept.template.name ? dept.template.name : '' %></div>
                  <% if (!canAccess) { %>
                    <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-10">
                      <span class="bg-black bg-opacity-60 text-white text-lg px-4 py-2 rounded">Members Only</span>
                    </div>
                  <% } %>
                </div>
              <% }); %>
            </div>
            <div class="flex justify-center items-center gap-4 mt-6">
              <form method="get" style="display:inline;">
                <input type="hidden" name="deptPage" value="<%= deptPagination.currentPage - 1 %>" />
                <button type="submit" class="px-6 py-3 rounded bg-gray-700 text-white font-semibold text-lg" <% if (deptPagination.currentPage <= 1) { %>disabled style="opacity:0.5;cursor:not-allowed;"<% } %>>Prev</button>
              </form>
              <span class="text-gray-300 text-lg">Page <%= deptPagination.currentPage %> of <%= deptPagination.totalPages %></span>
              <form method="get" style="display:inline;">
                <input type="hidden" name="deptPage" value="<%= deptPagination.currentPage + 1 %>" />
                <button type="submit" class="px-6 py-3 rounded bg-gray-700 text-white font-semibold text-lg" <% if (deptPagination.currentPage >= deptPagination.totalPages) { %>disabled style="opacity:0.5;cursor:not-allowed;"<% } %>>Next</button>
              </form>
            </div>
          <% } else if (isMemberApproved) { %>
            <p class="text-gray-400 text-lg">No departments listed.</p>
          <% } %>
        </div>
        
        <!-- Ad Banner Section -->
        <div class="bg-gradient-to-r from-green-900 via-blue-900 to-green-900 rounded-lg p-6 border border-green-700 shadow-lg my-8">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <i class="fa fa-star text-yellow-400 text-3xl"></i>
              <div>
                <h4 class="text-white font-semibold text-xl">Premium Features</h4>
                <p class="text-green-200 text-lg">Unlock advanced community management tools</p>
              </div>
            </div>
            <div class="flex items-center space-x-3">
              <button 
                onclick="showComingSoon()"
                class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg transition-colors text-lg font-semibold"
              >
                Learn More
              </button>
            </div>
          </div>
        </div>
        
                 <!-- Events Section -->


        <!-- Announcements Section -->
        <div id="announcements-section" class="card">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center space-x-3">
              <h2 class="text-3xl font-semibold">Announcements</h2>
              <div id="unread-count" class="bg-blue-500 text-white text-sm font-bold px-2 py-1 rounded-full hidden">
                <span id="unread-number">0</span>
              </div>
              <button 
                id="mark-all-read-btn"
                onclick="markAllAsRead()" 
                class="text-blue-400 hover:text-blue-300 text-sm font-medium transition-colors hidden"
              >
                Mark all as read
              </button>
            </div>
            <% if (isMemberApproved) { %>
              <button 
                onclick="<% if (canManageAnnouncements) { %>openCreateAnnouncementModal()<% } else { %>openNoAnnouncementPermissionModal()<% } %>" 
                class="px-6 py-3 rounded-full font-semibold shadow transition flex items-center text-lg <% if (canManageAnnouncements) { %>bg-blue-600 hover:bg-blue-700 text-white<% } else { %>bg-gray-500 text-white opacity-60 cursor-not-allowed<% } %>"
              >
                <i class="fa fa-plus mr-3"></i> Create Announcement
              </button>
            <% } %>
          </div>
          
          <% if (!isMemberApproved) { %>
            <div class="text-center py-12">
              <div class="bg-gray-800 rounded-lg p-8 border border-gray-700 shadow-lg opacity-70">
                <i class="fa fa-lock text-gray-400 text-4xl mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-300 mb-2">Announcements Hidden</h3>
                <p class="text-gray-400 text-lg mb-4">You cannot view announcements as you are not a member yet.</p>
                <% if (isMemberPending) { %>
                  <button disabled class="bg-gray-500 text-white px-6 py-3 rounded-full font-semibold shadow transition text-lg cursor-not-allowed">
                    Pending
                  </button>
                <% } else { %>
                  <button onclick="openRequestJoinModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-semibold shadow transition text-lg">
                    Request to Join Here
                  </button>
                <% } %>
              </div>
            </div>
          <% } else { %>
            <!-- Announcement Type Tabs -->
            <div class="flex flex-wrap gap-2 mb-6">
              <button 
                onclick="filterAnnouncements('all')" 
                id="tab-all"
                class="px-4 py-2 rounded-lg font-semibold transition-colors bg-blue-600 text-white"
              >
                All
              </button>
              <button 
                onclick="filterAnnouncements('main')" 
                id="tab-main"
                class="px-4 py-2 rounded-lg font-semibold transition-colors bg-gray-700 text-gray-300 hover:bg-gray-600"
              >
                <i class="fa fa-bullhorn mr-2"></i>Main
              </button>
              <button 
                onclick="filterAnnouncements('session')" 
                id="tab-session"
                class="px-4 py-2 rounded-lg font-semibold transition-colors bg-gray-700 text-gray-300 hover:bg-gray-600"
              >
                <i class="fa fa-calendar-day mr-2"></i>Session
              </button>
              <button 
                onclick="filterAnnouncements('training')" 
                id="tab-training"
                class="px-4 py-2 rounded-lg font-semibold transition-colors bg-gray-700 text-gray-300 hover:bg-gray-600"
              >
                <i class="fa fa-graduation-cap mr-2"></i>Training
              </button>
            </div>

            <!-- Announcements Container -->
            <div id="announcements-container" class="space-y-4">
              <div class="text-center py-8">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto"></div>
                <p class="text-gray-400 mt-2">Loading announcements...</p>
              </div>
            </div>

            <!-- Pagination Container -->
            <div id="announcements-pagination" class="mt-6">
              <!-- Pagination controls will be loaded here -->
            </div>
          <% } %>
        </div>

        <!-- Events Section -->
        <div id="events-section" class="card">
          <%
            // Permission logic for managing events (EJS, like departments)
            let canManageEvents = false;
            if (userId && community.community && Array.isArray(community.community.roles)) {
              community.community.roles.forEach(function(role) {
                if (Array.isArray(role.members) && role.members.includes(userId)) {
                  if (Array.isArray(role.permissions)) {
                    role.permissions.forEach(function(perm) {
                      if (
                        (perm.name === "administrator" && perm.enabled === true) ||
                        (perm.name === "manage community events" && perm.enabled === true)
                      ) {
                        canManageEvents = true;
                      }
                    });
                  }
                }
              });
            }
          %>
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-3xl font-semibold">Events</h2>
            <% if (isMemberApproved) { %>
              <% if (canManageEvents) { %>
               <button onclick="openCreateEventModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-semibold shadow transition flex items-center text-lg">
                 <i class="fa fa-plus mr-3"></i> Create Event
               </button>
             <% } else { %>
               <button onclick="openNoEventPermissionModal()" class="bg-gray-500 text-white px-6 py-3 rounded-full font-semibold shadow opacity-60 cursor-not-allowed flex items-center text-lg" style="pointer-events:auto;">
                 <i class="fa fa-plus mr-3"></i> Create Event
               </button>
             <% } %>
           <% } %>
         </div>
         
         <% if (!isMemberApproved) { %>
           <div class="text-center py-12">
             <div class="bg-gray-800 rounded-lg p-8 border border-gray-700 shadow-lg opacity-70">
               <i class="fa fa-lock text-gray-400 text-4xl mb-4"></i>
               <h3 class="text-xl font-semibold text-gray-300 mb-2">Events Hidden</h3>
               <p class="text-gray-400 text-lg mb-4">You cannot view events as you are not a member yet.</p>
               <% if (isMemberPending) { %>
                 <button disabled class="bg-gray-500 text-white px-6 py-3 rounded-full font-semibold shadow transition text-lg cursor-not-allowed">
                   Pending
                 </button>
               <% } else { %>
                 <button onclick="openRequestJoinModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-semibold shadow transition text-lg">
                   Request to Join Here
                 </button>
               <% } %>
             </div>
           </div>
         <% } else { %>
         <%
           // Pagination for events
           const eventsPerPage = 4;
           const eventPage = parseInt((typeof query !== 'undefined' && query.eventPage) ? query.eventPage : 1, 10) || 1;
           const allEvents = community.community.events || [];
           const totalEventPages = Math.max(1, Math.ceil(allEvents.length / eventsPerPage));
           const pagedEvents = allEvents.slice((eventPage - 1) * eventsPerPage, eventPage * eventsPerPage);
         %>
         <ul class="text-left mx-auto max-w-4xl">
           <% pagedEvents.forEach(function(event) { %>
             <% if (isMemberApproved) { %>
               <li class="mb-6 p-6 rounded bg-gray-800 border border-gray-700 flex flex-col sm:flex-row items-start gap-6 relative">
                 <img src="<%= event.image || '/static/images/default-logo.png' %>" alt="Event Image" class="w-40 h-32 object-cover rounded mb-4 sm:mb-0" style="min-width:10rem; max-width:10rem; max-height:8rem;" />
                 <div class="flex-1">
                   <div class="flex items-center justify-between mb-3">
                     <div class="font-semibold text-2xl text-white"><%= event.title %></div>
                     <% if (canManageEvents) { %>
                       <button class="text-gray-400 hover:text-blue-400 z-10 bg-gray-900 bg-opacity-70 rounded-full p-2 ml-3" title="Edit Event" onclick="event.stopPropagation(); openEditEventModal('<%= event._id %>')">
                         <i class="fa fa-pencil-alt text-lg"></i>
                       </button>
                     <% } %>
                   </div>
                   <div class="text-gray-400 text-lg mb-3"><%= new Date(event.scheduledDate).toLocaleString() %></div>
                   <div class="text-gray-300 text-lg mb-3"><%= event.description %></div>
                   <% if (event.location) { %>
                     <div class="text-gray-500 text-base">Location: <%= event.location %></div>
                   <% } %>
                 </div>
               </li>
             <% } else { %>
               <li class="mb-6 p-6 rounded bg-gray-800 border border-gray-700 relative opacity-70 cursor-not-allowed flex flex-col sm:flex-row items-start gap-6">
                 <img src="<%= event.image || '/static/images/default-logo.png' %>" alt="Event Image" class="w-40 h-32 object-cover rounded mb-4 sm:mb-0" style="min-width:10rem; max-width:10rem; max-height:8rem;" />
                 <div class="flex-1 relative z-0">
                   <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-10">
                     <span class="bg-black bg-opacity-60 text-white text-base px-3 py-2 rounded">Members Only</span>
                   </div>
                   <div class="font-semibold text-xl text-white mb-2"><%= event.title %></div>
                   <div class="text-gray-400 text-base mb-2"><%= new Date(event.scheduledDate).toLocaleString() %></div>
                   <div class="text-gray-300 text-base mb-2"><%= event.description %></div>
                   <% if (event.location) { %>
                     <div class="text-gray-500 text-sm">Location: <%= event.location %></div>
                   <% } %>
                 </div>
               </li>
             <% } %>
           <% }); %>
         </ul>
         <% if (totalEventPages > 1) { %>
           <div class="flex justify-center items-center gap-4 mt-6">
             <form method="get" style="display:inline;">
               <% if (typeof query !== 'undefined') { %>
                 <% Object.keys(query).forEach(function(key) { %>
                   <% if (key !== 'eventPage') { %>
                     <input type="hidden" name="<%= key %>" value="<%= query[key] %>" />
                   <% } %>
                 <% }); %>
               <% } %>
               <input type="hidden" name="eventPage" value="<%= eventPage - 1 %>" />
               <button type="submit" class="px-6 py-3 rounded bg-gray-700 text-white font-semibold text-lg" <% if (eventPage <= 1) { %>disabled style="opacity:0.5;cursor:not-allowed;"<% } %>>Prev</button>
             </form>
             <span class="text-gray-300 text-lg">Page <%= eventPage %> of <%= totalEventPages %></span>
             <form method="get" style="display:inline;">
               <% if (typeof query !== 'undefined') { %>
                 <% Object.keys(query).forEach(function(key) { %>
                   <% if (key !== 'eventPage') { %>
                     <input type="hidden" name="<%= key %>" value="<%= query[key] %>" />
                   <% } %>
                 <% }); %>
               <% } %>
               <input type="hidden" name="eventPage" value="<%= eventPage + 1 %>" />
               <button type="submit" class="px-6 py-3 rounded bg-gray-700 text-white font-semibold text-lg" <% if (eventPage >= totalEventPages) { %>disabled style="opacity:0.5;cursor:not-allowed;"<% } %>>Next</button>
             </form>
           </div>
         <% } %>
         <% } %>
       </div>

        <!-- HeroUI Pro Features Section -->
        <div class="bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 py-16 mt-16 rounded-lg">
