      function closeGeneralSettingsModal() {
        document.getElementById('generalSettingsModal').style.display = 'none';
      }

      function loadGeneralSettings() {
        // Get current general settings from the page data
        const communityData = <%- JSON.stringify(community || {}) %>;
        
        // Set civilian creation limits - use the actual field names from community JSON
        const enableLimits = communityData.community?.civilianCreationLimitsEnabled || false;
        
        const enableLimitsElement = document.getElementById('enableCivilianLimits');
        if (enableLimitsElement) {
          enableLimitsElement.checked = enableLimits;
        }
        
        toggleCivilianLimitsOptions(enableLimits);
        
        if (enableLimits) {
          const maxCivilians = communityData.community?.civilianCreationLimit || 5;
          
          const maxCiviliansElement = document.getElementById('maxCiviliansPerDept');
          if (maxCiviliansElement) {
            maxCiviliansElement.value = maxCivilians;
          }
        }
        
        // Set civilian approval system - use the actual field names from community JSON
        const enableApproval = communityData.community?.civilianApprovalSystemEnabled || false;
        
        const enableApprovalElement = document.getElementById('enableCivilianApproval');
        if (enableApprovalElement) {
          enableApprovalElement.checked = enableApproval;
        }
        
        toggleCivilianApprovalInfo(enableApproval);
        
        // Hide loading state
        document.getElementById('generalSettingsLoading').style.display = 'none';
      }

      function refreshGeneralSettings() {
        // Refresh community data from server and then load general settings
        const communityId = '<%= community._id %>';
        const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
        
        fetch(`${apiUrl}/api/v1/community/${communityId}`)
          .then(res => res.json())
          .then(data => {
            if (data.community) {
              // Update the page data with fresh information
              window.currentCommunityData = data.community;
              
              // Reload general settings with fresh data
              loadGeneralSettingsFromData(data.community);
            } else {
              console.error('Failed to refresh community data');
              // Fallback to loading from page data
              loadGeneralSettings();
            }
          })
          .catch(error => {
            console.error('Error refreshing general settings:', error);
            // Fallback to loading from page data
            loadGeneralSettings();
          });
      }

      function loadGeneralSettingsFromData(communityData) {
        // Set civilian creation limits - use the actual field names from community JSON
        const enableLimits = communityData?.civilianCreationLimitsEnabled || false;
        
        const enableLimitsElement = document.getElementById('enableCivilianLimits');
        if (enableLimitsElement) {
          enableLimitsElement.checked = enableLimits;
        }
        
        toggleCivilianLimitsOptions(enableLimits);
        
        if (enableLimits) {
          const maxCivilians = communityData?.civilianCreationLimit || 5;
          
          const maxCiviliansElement = document.getElementById('maxCiviliansPerDept');
          if (maxCiviliansElement) {
            maxCiviliansElement.value = maxCivilians;
          }
        }
        
        // Set civilian approval system - use the actual field names from community JSON
        const enableApproval = communityData?.civilianApprovalSystemEnabled || false;
        
        const enableApprovalElement = document.getElementById('enableCivilianApproval');
        if (enableApprovalElement) {
          enableApprovalElement.checked = enableApproval;
        }
        
        toggleCivilianApprovalInfo(enableApproval);
        
        // Hide loading state
        document.getElementById('generalSettingsLoading').style.display = 'none';
      }

      function setupGeneralSettingsEventListeners() {
        // Civilian limits toggle
        const enableLimitsCheckbox = document.getElementById('enableCivilianLimits');
        enableLimitsCheckbox.addEventListener('change', function() {
          toggleCivilianLimitsOptions(this.checked);
        });
        
        // Civilian approval toggle
        const enableApprovalCheckbox = document.getElementById('enableCivilianApproval');
        enableApprovalCheckbox.addEventListener('change', function() {
          toggleCivilianApprovalInfo(this.checked);
        });
      }

      function toggleCivilianLimitsOptions(show) {
        const optionsDiv = document.getElementById('civilianLimitsOptions');
        if (show) {
          optionsDiv.style.display = 'block';
        } else {
          optionsDiv.style.display = 'none';
        }
      }

      function toggleCivilianApprovalInfo(show) {
        const infoDiv = document.getElementById('civilianApprovalInfo');
        if (show) {
          infoDiv.style.display = 'block';
        } else {
          infoDiv.style.display = 'none';
        }
      }

      function saveGeneralSettings() {
        const enableLimits = document.getElementById('enableCivilianLimits').checked;
        const maxCivilians = enableLimits ? parseInt(document.getElementById('maxCiviliansPerDept').value) : 5;
        const enableApproval = document.getElementById('enableCivilianApproval').checked;
        
        // Use the actual field names that match the backend community model
        const updateData = {
          civilianCreationLimitsEnabled: enableLimits,
          civilianCreationLimit: maxCivilians,
          civilianApprovalSystemEnabled: enableApproval
        };
        
        // Save to server - use the same route as saveCommunityProfile
        const communityId = '<%= community._id %>';
        const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
        
        fetch(`${apiUrl}/api/v1/community/${communityId}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(updateData)
        })
        .then(res => {
          if (res.ok) {
            // Show success message
            showSettingsSuccess('General settings saved successfully!');
            closeGeneralSettingsModal();
          } else {
            throw new Error('Failed to save general settings');
          }
        })
        .catch(error => {
          console.error('Error saving general settings:', error);
          showSettingsError('Failed to save general settings. Please try again.');
