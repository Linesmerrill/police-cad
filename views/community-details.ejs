              <div class="flex justify-end gap-2 mt-6">
        <button type="button" onclick="deleteEditDepartment()" class="bg-red-600 hover:bg-red-700 text-white px-4 py-3 rounded font-semibold text-base">Delete</button>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-3 rounded font-semibold text-base">Save</button>
      </div>
    </form>
