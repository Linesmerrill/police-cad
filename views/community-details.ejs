      function ensureMembersModalExists() {
        let modal = document.getElementById('membersModal');
        if (!modal) {
  
          // Create the modal dynamically
          const modalHTML = `
            <div id="membersModal" class="heroui-modal" style="display:none; position:fixed; z-index:3000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center; overflow-y:auto;">
              <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:1000px; width:95%; max-height:90vh; position:relative; border:1px solid #35385a; overflow-y:auto;">
                <button onclick="closeMembersModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7; z-index:10;"><i class="fa fa-times"></i></button>
                
                <!-- Header -->
                <div style="text-align:center; margin-bottom:2rem; padding-bottom:1rem; border-bottom:1px solid #35385a;">
                  <i class="fa fa-users" style="font-size:3rem; color:#f59e0b; margin-bottom:1rem;"></i>
                  <h3 style="color:#fff; margin:0; font-size:1.75rem; font-weight:600;">Community Members</h3>
                  <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:1rem;">Manage and view community members</p>
                </div>

                <!-- Search Bar -->
                <div style="margin-bottom:2rem; padding:1.5rem; background:#2d3748; border-radius:12px; border:1px solid #4a5568;">
                  <label style="display:block; color:#fff; margin-bottom:0.5rem; font-weight:500; font-size:0.875rem; display:flex; align-items:center; gap:0.5rem;">
                    <i class="fa fa-search" style="color:#3b82f6;"></i>
                    Search Members
                  </label>
                  <input type="text" id="memberSearchInput" placeholder="Search by username, email, or role..." 
                         style="width:100%; padding:0.75rem 1rem; background:#1e2028; color:#fff; border:1px solid #4a5568; border-radius:6px; font-size:1rem; box-sizing:border-box;"
                         oninput="searchMembers(this.value)">
                </div>

                <!-- Members List -->
                <div id="membersListContainer" style="margin-bottom:2rem;">
                  <!-- Loading state -->
                  <div id="membersLoading" style="text-align:center; padding:2rem;">
                    <div class="loading-spinner" style="width:60px; height:60px; border:4px solid #4a5568; border-top:4px solid #f59e0b; border-radius:50%; animation:spin 1s linear infinite; margin:0 auto 1rem;"></div>
                    <p style="color:#a0aec0;">Loading members...</p>
                  </div>
                  
                  <!-- Pagination Loading State -->
                  <div id="paginationLoading" style="display:none; text-align:center; padding:2rem;">
                    <div class="loading-spinner" style="width:40px; height:40px; border:3px solid #4a5568; border-top:3px solid #f59e0b; border-radius:50%; animation:spin 1s linear infinite; margin:0 auto 1rem;"></div>
                    <p style="color:#a0aec0; font-size:0.875rem;">Loading page...</p>
                  </div>
                </div>

                <!-- Pagination -->
                <div id="membersPagination" style="display:none; text-align:center; margin-bottom:2rem;">
                  <div style="display:flex; gap:0.5rem; justify-content:center; align-items:center;">
                    <button id="prevPageBtn" onclick="changeMembersPage(-1)" style="background:#4a5568; color:#fff; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:pointer; font-size:0.875rem;">
                      <i class="fa fa-chevron-left"></i> Previous
                    </button>
                    <span id="pageInfo" style="color:#a0aec0; font-size:0.875rem; padding:0 1rem;">
                      Page 1 of 1
                    </span>
                    <button id="nextPageBtn" onclick="changeMembersPage(1)" style="background:#4a5568; color:#fff; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:pointer; font-size:0.875rem;">
                      Next <i class="fa fa-chevron-right"></i>
                    </button>
                  </div>
                </div>

                <!-- Action Buttons -->
                <div style="display:flex; gap:1rem; justify-content:center; padding-top:1rem; border-top:1px solid #35385a;">
                  <button onclick="closeMembersModal()" style="background:#6b7280; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1rem;">
                    Close
                  </button>
                </div>
              </div>
            </div>
          `;
          
                    document.body.insertAdjacentHTML('beforeend', modalHTML);
          
          // Wait a moment for the DOM to update, then verify all elements exist
          setTimeout(() => {
            const loadingDiv = document.getElementById('membersLoading');
            const paginationLoading = document.getElementById('paginationLoading');
            const listContainer = document.getElementById('membersListContainer');
            
            // If loading div is missing, recreate it
            if (!loadingDiv && listContainer) {
              const loadingHTML = `
                <div id="membersLoading" style="text-align:center; padding:2rem;">
                  <div class="loading-spinner" style="width:60px; height:60px; border:4px solid #4a5568; border-top:4px solid #f59e0b; border-radius:50%; animation:spin 1s linear infinite; margin:0 auto 1rem;"></div>
                  <p style="color:#a0aec0;">Loading members...</p>
                </div>
              `;
              listContainer.innerHTML = loadingHTML;
            }
            
            // If pagination loading div is missing, recreate it
            if (!paginationLoading && listContainer) {
              const paginationLoadingHTML = `
                <div id="paginationLoading" style="display:none; text-align:center; padding:2rem;">
                  <div class="loading-spinner" style="width:40px; height:40px; border:3px solid #4a5568; border-top:3px solid #f59e0b; border-radius:50%; animation:spin 1s linear infinite; margin:0 auto 1rem;"></div>
                  <p style="color:#a0aec0; font-size:0.875rem;">Loading page...</p>
              </div>
            `;
              listContainer.insertAdjacentHTML('beforeend', paginationLoadingHTML);
            }
          }, 50);
          
          return document.getElementById('membersModal');
        }
        return modal;
      }

      function waitForMembersElements(callback, maxAttempts = 10) {
        let attempts = 0;
        
        const checkElements = () => {
          attempts++;
          
          const loadingDiv = document.getElementById('membersLoading');
          const listContainer = document.getElementById('membersListContainer');
          const paginationDiv = document.getElementById('membersPagination');
          
          // If loadingDiv is missing, try to recreate it
          if (!loadingDiv && listContainer) {
            const loadingHTML = `
              <div id="membersLoading" style="text-align:center; padding:2rem;">
                <div class="loading-spinner" style="width:60px; height:60px; border:4px solid #4a5568; border-top:4px solid #f59e0b; border-radius:50%; animation:spin 1s linear infinite; margin:0 auto 1rem;"></div>
                <p style="color:#a0aec0;">Loading members...</p>
              </div>
            `;
            listContainer.innerHTML = loadingHTML;
          }
          
          // If paginationLoading is missing, try to recreate it
          const paginationLoading = document.getElementById('paginationLoading');
          if (!paginationLoading && listContainer) {
            const paginationLoadingHTML = `
              <div id="paginationLoading" style="display:none; text-align:center; padding:2rem;">
                <div class="loading-spinner" style="width:40px; height:40px; border:3px solid #4a5568; border-top:3px solid #f59e0b; border-radius:50%; animation:spin 1s linear infinite; margin:0 auto 1rem;"></div>
                <p style="color:#a0aec0; font-size:0.875rem;">Loading page...</p>
                </div>
            `;
            listContainer.insertAdjacentHTML('beforeend', paginationLoadingHTML);
          }
          
          // Check again after potential recreation
          const newLoadingDiv = document.getElementById('membersLoading');
          const newPaginationLoading = document.getElementById('paginationLoading');
          
          if (newLoadingDiv && listContainer && paginationDiv && newPaginationLoading) {
            callback();
          } else if (attempts >= maxAttempts) {
            hideMembersCardLoading();
            showToast('Error: Could not initialize members modal properly', 3000, 'error');
          } else {
            setTimeout(checkElements, 100);
          }
        };
        
        checkElements();
      }
    </script>

