          <h1 id="community-overview-name" class="text-5xl font-bold mb-4">
            <%= community.community.name %>
            <% if ((['elite','premium','standard'].includes(community.community.subscription?.plan)) && community.community.subscription?.active) { %>
              <svg viewBox="0 0 24 24" class="w-8 h-8 inline-block ml-3 align-middle" style="vertical-align: middle;">
                <circle cx="12" cy="12" r="10" fill="#eab308" />
                <path d="M8 12.5l3 3 5-5" stroke="#000" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% } %>
          </h1>
          <div class="flex flex-wrap justify-center gap-3 mb-4">
            <% if (community.community.tags && community.community.tags.length) { %>
              <% community.community.tags.forEach(function(tag) { %>
                <span class="inline-block bg-gray-700 text-gray-200 text-lg px-4 py-2 rounded-full"><%= tag %></span>
              <% }); %>
            <% } %>
          </div>
          <p class="text-gray-300 mb-4 text-xl"><%= community.community.promotionalText %></p>
          <p class="text-gray-400 mb-4 text-lg"><%= community.community.promotionalDescription %></p>
          <p id="community-overview-description" class="text-gray-400 mb-4 text-lg"><%= community.community.description %></p>
          <p class="text-gray-400 mb-4 text-xl font-medium"><%= community.community.membersCount === 1 ? '1 Member' : community.community.membersCount + ' Members' %></p>
          <div class="flex flex-wrap justify-center gap-4 mb-4">
            <% if (community.community.links && community.community.links.length) { %>
              <% community.community.links.forEach(function(link) { %>
                <a href="<%= link.url %>" target="_blank" class="text-blue-400 hover:underline text-lg">🔗 <%= link.label %></a>
              <% }); %>
            <% } %>
          </div>
        </div>

        <!-- HeroUI Pro Stats Section -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6 mb-8">
          <div class="bg-gray-800 rounded-lg p-3 md:p-6 border border-gray-700 shadow-lg">
            <div class="flex items-center space-x-2 md:space-x-4">
              <div class="bg-blue-600 p-2 md:p-3 rounded-lg">
                <i class="fa fa-users text-white text-lg md:text-2xl"></i>
              </div>
              <div>
                        <div class="text-xl md:text-3xl font-bold text-white"><%= community.community.membersCount %></div>
        <div class="text-gray-400 text-sm md:text-lg">Total <%= community.community.membersCount === 1 ? 'Member' : 'Members' %></div>
              </div>
            </div>
          </div>
          
          <div class="bg-gray-800 rounded-lg p-3 md:p-6 border border-gray-700 shadow-lg">
            <div class="flex items-center space-x-2 md:space-x-4">
              <div class="bg-green-600 p-2 md:p-3 rounded-lg">
                <i class="fa fa-building text-white text-lg md:text-2xl"></i>
              </div>
              <div>
                <% if (isMemberApproved) { %>
                  <div class="text-xl md:text-3xl font-bold text-white"><%= departments ? departments.length : 0 %></div>
                  <div class="text-gray-400 text-sm md:text-lg">Departments</div>
                <% } else { %>
                  <div class="text-xl md:text-3xl font-bold text-gray-500 relative group">
                    ?
                    <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-900 text-white text-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                      Request to join to view
                      <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-900"></div>
                    </div>
                  </div>
                  <div class="text-gray-500 text-sm md:text-lg">Departments</div>
                <% } %>
              </div>
            </div>
          </div>
          
          <div class="bg-gray-800 rounded-lg p-3 md:p-6 border border-gray-700 shadow-lg">
            <div class="flex items-center space-x-2 md:space-x-4">
              <div class="bg-indigo-600 p-2 md:p-3 rounded-lg">
                <i class="fa fa-bullhorn text-white text-lg md:text-2xl"></i>
              </div>
              <div>
                <% if (isMemberApproved) { %>
                  <div class="text-xl md:text-3xl font-bold text-white" id="announcements-count">0</div>
                  <div class="text-gray-400 text-sm md:text-lg">Announcements</div>
                <% } else { %>
                  <div class="text-xl md:text-3xl font-bold text-gray-500 relative group">
                    ?
                    <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-900 text-white text-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                      Request to join to view
                      <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-900"></div>
                    </div>
                  </div>
                  <div class="text-gray-500 text-sm md:text-lg">Announcements</div>
                <% } %>
              </div>
            </div>
          </div>
          
          <div class="bg-gray-800 rounded-lg p-3 md:p-6 border border-gray-700 shadow-lg">
            <div class="flex items-center space-x-2 md:space-x-4">
              <div class="bg-purple-600 p-2 md:p-3 rounded-lg">
                <i class="fa fa-calendar text-white text-lg md:text-2xl"></i>
              </div>
              <div>
                <% if (isMemberApproved) { %>
                  <div class="text-xl md:text-3xl font-bold text-white"><%= community.community.events ? community.community.events.length : 0 %></div>
                  <div class="text-gray-400 text-sm md:text-lg">Events</div>
                <% } else { %>
                  <div class="text-xl md:text-3xl font-bold text-gray-500 relative group">
                    ?
                    <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-900 text-white text-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                      Request to join to view
                      <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-900"></div>
                    </div>
                  </div>
                  <div class="text-gray-500 text-sm md:text-lg">Events</div>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Ad Banner Section -->
        <div class="bg-gradient-to-r from-blue-900 via-purple-900 to-blue-900 rounded-lg p-6 border border-blue-700 shadow-lg mb-8">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <i class="fa fa-rocket text-yellow-400 text-3xl"></i>
              <div>
                <h4 class="text-white font-semibold text-xl">Boost Your Community</h4>
                <p class="text-blue-200 text-lg">Get featured placement and premium features</p>
              </div>
            </div>
            <div class="flex items-center space-x-3">
              <button 
                onclick="showComingSoon()"
                class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition-colors text-lg font-semibold"
              >
                Upgrade Now
              </button>
            </div>
          </div>
        </div>
        
        <% let isOwner = false;
           if (user && user._doc && community.community && community.community.ownerID) {
             isOwner = String(community.community.ownerID) === String(user._doc._id);
           }
        %>
        <% if (isMemberApproved && memberSinceYear) { %>
          <div class="mb-6 flex items-center justify-between">
            <div class="text-green-400 font-semibold flex items-center text-xl">
              <svg class="w-7 h-7 mr-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Member since '<%= memberSinceYear %>
            </div>
            <% if (isOwner) { %>
              <button onclick="openOwnerCannotLeaveModal()" class="bg-gray-500 text-white px-6 py-3 rounded-full font-semibold shadow cursor-not-allowed opacity-60 text-lg" style="pointer-events:auto;">
                Leave Community
              </button>
            <% } else { %>
              <button onclick="openLeaveCommunityModal()" class="bg-red-600 text-white px-6 py-3 rounded-full font-semibold shadow hover:bg-red-700 transition text-lg">
                Leave Community
              </button>
            <% } %>
          </div>
        <% } %>
        <% if (isMemberPending) { %>
          <div class="mb-6 text-yellow-400 font-semibold text-xl">Your request to join is pending approval.</div>
        <% } %>

        <!-- Community Actions Section -->
        <div id="community-actions" class="card mb-8">
          <h3 class="text-2xl font-semibold mb-6 text-center">Community Actions</h3>
          <div class="flex justify-center space-x-6">
            <% if (isMemberApproved) { %>
              <!-- Promote - Coming soon -->
              <button onclick="showComingSoonModal('Promote Community', 'This feature will allow you to promote your community to reach more members. Coming soon!')" class="flex flex-col items-center p-6 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors">
                <i class="fa-solid fa-bullhorn w-8 h-8 mb-3 text-2xl"></i>
                <span class="text-lg font-medium">Promote</span>
              </button>
              
              <%
                let canManageSettings = false;
                const userId = user && user._doc ? String(user._doc._id) : null;
                if (userId && community.community && Array.isArray(community.community.roles)) {
                  community.community.roles.forEach(function(role) {
                    if (Array.isArray(role.members) && role.members.includes(userId)) {
                      if (Array.isArray(role.permissions)) {
                        role.permissions.forEach(function(perm) {
                          if (
                            (perm.name === "administrator" && perm.enabled === true) ||
                            (perm.name === "manage community settings" && perm.enabled === true)
                          ) {
                            canManageSettings = true;
                          }
                        });
                      }
                    }
                  });
                }
              %>

              <% if (canManageSettings) { %>
                <button id="mainSettingsButton" class="flex flex-col items-center p-6 bg-purple-600 hover:bg-purple-700 text-white rounded-lg transition-colors">
                  <i class="fa-solid fa-gear w-8 h-8 mb-3 text-2xl"></i>
                  <span class="text-lg font-medium">Settings</span>
                </button>
              <% } else { %>
                <button id="noSettingsPermissionButton" class="flex flex-col items-center p-6 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors text-lg" style="pointer-events:auto;">
                  <i class="fa-solid fa-gear w-8 h-8 mb-3 text-2xl"></i>
                  <span class="text-lg font-medium">Settings</span>
                </button>
              <% } %>
              
              <%
                // Permission logic for managing members (invite)
                let canManageMembers = false;
                if (userId && community.community && Array.isArray(community.community.roles)) {
                  community.community.roles.forEach(function(role) {
                    if (Array.isArray(role.members) && role.members.includes(userId)) {
                      if (Array.isArray(role.permissions)) {
                        role.permissions.forEach(function(perm) {
                          if (
                            (perm.name === "administrator" && perm.enabled === true) ||
                            (perm.name === "manage members" && perm.enabled === true)
                          ) {
                            canManageMembers = true;
                          }
                        });
                      }
                    }
                  });
                }
              %>
              <!-- Invite - Coming soon -->
              <button onclick="showComingSoonModal('Invite Members', 'This feature will allow you to invite new members to your community. Coming soon!')" class="flex flex-col items-center p-6 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors">
                <i class="fa-solid fa-user-plus w-8 h-8 mb-3 text-2xl"></i>
                <span class="text-lg font-medium">Invite</span>
              </button>
            <% } else { %>
              <!-- Non-members see disabled buttons with member-only modal -->
              <button onclick="showComingSoonModal('Promote Community', 'This feature will allow you to promote your community to reach more members. Coming soon!')" class="flex flex-col items-center p-6 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors">
                <i class="fa-solid fa-bullhorn w-8 h-8 mb-3 text-2xl"></i>
                <span class="text-lg font-medium">Promote</span>
              </button>
              
              <button id="memberOnlySettingsButton" class="flex flex-col items-center p-6 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors">
                <i class="fa-solid fa-gear w-8 h-8 mb-3 text-2xl"></i>
                <span class="text-lg font-medium">Settings</span>
              </button>
              
              <button onclick="showComingSoonModal('Invite Members', 'This feature will allow you to invite new members to your community. Coming soon!')" class="flex flex-col items-center p-6 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors">
                <i class="fa-solid fa-user-plus w-8 h-8 mb-3 text-2xl"></i>
                <span class="text-lg font-medium">Invite</span>
              </button>
            <% } %>
            
            <!-- Share button - always available -->
            <button onclick="copyCommunityUrl()" class="flex flex-col items-center p-6 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-colors">
              <i class="fa-solid fa-share-nodes w-8 h-8 mb-3 text-2xl"></i>
              <span class="text-lg font-medium">Share</span>
            </button>
          </div>
        </div>
          
        <%
          // Permission logic for managing departments
          let canManageDepartments = false;
          if (userId && community.community && Array.isArray(community.community.roles)) {
            community.community.roles.forEach(function(role) {
              if (Array.isArray(role.members) && role.members.includes(userId)) {
                if (Array.isArray(role.permissions)) {
                  role.permissions.forEach(function(perm) {
                    if (
                      (perm.name === "administrator" && perm.enabled === true) ||
                      (perm.name === "manage departments" && perm.enabled === true)
                    ) {
                      canManageDepartments = true;
                    }
                  });
                }
              }
            });
          }
        %>
        
        <!-- Departments Section -->
        <div id="departments-section" class="card">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-3xl font-semibold">Departments</h2>
            <% if (isMemberApproved) { %>
              <% if (canManageDepartments) { %>
                <button onclick="openCreateDepartmentModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-semibold shadow transition flex items-center text-lg">
                  <i class="fa fa-plus mr-3"></i> Create Department
                </button>
              <% } else { %>
                <button onclick="openNoDepartmentPermissionModal()" class="bg-gray-500 text-white px-6 py-3 rounded-full font-semibold shadow opacity-60 cursor-not-allowed flex items-center text-lg" style="pointer-events:auto;">
                  <i class="fa fa-plus mr-3"></i> Create Department
                </button>
              <% } %>
            <% } %>
          </div>
          
          <% if (!isMemberApproved) { %>
            <div class="text-center py-12">
              <div class="bg-gray-800 rounded-lg p-8 border border-gray-700 shadow-lg opacity-70">
                <i class="fa fa-lock text-gray-400 text-4xl mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-300 mb-2">Departments Hidden</h3>
                <p class="text-gray-400 text-lg mb-4">You cannot view departments as you are not a member yet.</p>
                <% if (isMemberPending) { %>
                  <button disabled class="bg-gray-500 text-white px-6 py-3 rounded-full font-semibold shadow transition text-lg cursor-not-allowed">
                    Pending
                  </button>
                <% } else { %>
                  <button onclick="openRequestJoinModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-semibold shadow transition text-lg">
                    Request to Join Here
                  </button>
                <% } %>
              </div>
            </div>
          <% } else if (departments && departments.length) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <% departments.forEach(function(dept) { 
                var templateName = dept.template && dept.template.name ? dept.template.name : '';
                var approvalRequired = dept.approvalRequired;
                var members = Array.isArray(dept.members) ? dept.members : [];
                var isMember = members.some(function(m) { return m.userID === userId && m.status === 'approved'; });
                var isAdmin = false;
                if (userId && community.community && Array.isArray(community.community.roles)) {
                  community.community.roles.forEach(function(role) {
                    if (Array.isArray(role.members) && role.members.includes(userId)) {
                      if (Array.isArray(role.permissions)) {
                        role.permissions.forEach(function(perm) {
                          if (perm.name === "administrator" && perm.enabled === true) {
                            isAdmin = true;
                          }
                        });
                      }
                    }
                  });
                }
                var canAccess = isAdmin || !approvalRequired || isMember;
                // Determine dashboard URL
                var dashboardUrl = '';
                var lowerTemplate = templateName.toLowerCase();
                if (lowerTemplate.includes('civilian')) {
                  dashboardUrl = `/civ-dashboard?dept=${encodeURIComponent(dept.name)}&d=${dept._id}`;
                } else if (lowerTemplate.includes('police')) {
                  dashboardUrl = `/police-dashboard?dept=${encodeURIComponent(dept.name)}&d=${dept._id}`;
                } else if (lowerTemplate.includes('fire') || lowerTemplate.includes('ems')) {
                  dashboardUrl = `/ems-dashboard?dept=${encodeURIComponent(dept.name)}&d=${dept._id}`;
                } else if (lowerTemplate.includes('dispatch')) {
                  dashboardUrl = `/dispatch-dashboard?dept=${encodeURIComponent(dept.name)}&d=${dept._id}`;
                }
              %>
                <div class="relative block bg-gray-800 rounded-lg shadow hover:shadow-lg transition p-6 border border-gray-700 <%= canAccess ? 'hover:border-blue-500 cursor-pointer' : 'opacity-70 cursor-not-allowed' %>"
                  <%- canAccess && dashboardUrl ? `onclick="navigateToDepartment('${dept._id}', '${dept.name.replace(/'/g, "\\'")}', '${templateName.replace(/'/g, "\\'")}')"` : '' %>>
                  <% if (canManageDepartments) { %>
                    <button class="absolute top-3 right-3 text-gray-400 hover:text-blue-400 z-10 bg-gray-900 bg-opacity-70 rounded-full p-2" title="Edit Department" onclick="event.stopPropagation(); openEditDepartmentModal('<%= dept._id %>');">
                      <i class="fa fa-pencil-alt text-lg"></i>
                    </button>
                  <% } %>
                  <img src="<%= dept.image || '/static/images/default-logo.png' %>" alt="<%= dept.name %>" class="w-full h-40 object-cover rounded mb-4" />
                  <div class="font-bold text-2xl text-white mb-3"><%= dept.name %></div>
                  <div class="text-gray-400 text-lg mb-3"><%= dept.description || '' %></div>
                  <div class="text-base text-gray-500"><%= dept.template && dept.template.name ? dept.template.name : '' %></div>
                  <% if (!canAccess) { %>
                    <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-10">
                      <% if (isMemberApproved) { %>
                        <span class="bg-black bg-opacity-60 text-white text-lg px-4 py-2 rounded">Private</span>
                      <% } else { %>
                        <span class="bg-black bg-opacity-60 text-white text-lg px-4 py-2 rounded">Members Only</span>
                      <% } %>
                    </div>
                    <% if (isMemberApproved) { %>
                      <div class="absolute bottom-4 left-4 right-4 z-20">
                        <button disabled class="w-full bg-gray-500 text-white px-4 py-2 rounded font-semibold transition text-sm department-join-btn cursor-not-allowed" data-department-id="<%= dept._id %>">
                          Checking...
                        </button>
                      </div>
                    <% } else if (!isMemberPending) { %>
                      <div class="absolute bottom-4 left-4 right-4 z-20">
                        <button onclick="event.stopPropagation(); openRequestJoinModal()" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded font-semibold transition text-sm">
                          Request to Join
                        </button>
                      </div>
                    <% } %>
                  <% } %>
                </div>
              <% }); %>
            </div>
            <div class="flex justify-center items-center gap-4 mt-6">
              <form method="get" style="display:inline;">
                <input type="hidden" name="deptPage" value="<%= deptPagination.currentPage - 1 %>" />
                <button type="submit" class="px-6 py-3 rounded bg-gray-700 text-white font-semibold text-lg" <% if (deptPagination.currentPage <= 1) { %>disabled style="opacity:0.5;cursor:not-allowed;"<% } %>>Prev</button>
              </form>
              <span class="text-gray-300 text-lg">Page <%= deptPagination.currentPage %> of <%= deptPagination.totalPages %></span>
              <form method="get" style="display:inline;">
                <input type="hidden" name="deptPage" value="<%= deptPagination.currentPage + 1 %>" />
                <button type="submit" class="px-6 py-3 rounded bg-gray-700 text-white font-semibold text-lg" <% if (deptPagination.currentPage >= deptPagination.totalPages) { %>disabled style="opacity:0.5;cursor:not-allowed;"<% } %>>Next</button>
              </form>
            </div>
          <% } else if (isMemberApproved) { %>
            <p class="text-gray-400 text-lg">No departments listed.</p>
          <% } %>
        </div>
        
        <!-- Ad Banner Section -->
        <div class="bg-gradient-to-r from-green-900 via-blue-900 to-green-900 rounded-lg p-6 border border-green-700 shadow-lg my-8">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <i class="fa fa-star text-yellow-400 text-3xl"></i>
              <div>
                <h4 class="text-white font-semibold text-xl">Premium Features</h4>
                <p class="text-green-200 text-lg">Unlock advanced community management tools</p>
              </div>
            </div>
            <div class="flex items-center space-x-3">
