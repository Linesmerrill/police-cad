<div id="toast" style="display:none; position:fixed; bottom:2rem; left:50%; transform:translateX(-50%); background:#23272f; color:#fff; padding:1rem 2rem; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.2); z-index:3000; font-weight:500;">
  <span id="toast-message"></span>
