<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= community.name %> - Community Details</title>
    <link rel="shortcut icon" type="image/ico" href="/static/images/favicon.ico" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      body {
        background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
        color: #e2e8f0;
      }
      /* .hero-img class removed, use Tailwind classes for image ratio */
      .card {
        background: #23272f;
        border-radius: 1rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.2);
        padding: 2rem;
        margin-bottom: 2rem;
      }
      @media (max-width: 640px) {
        .card { padding: 1rem; }
      }
      
      /* notification styles */
      .notification-badge {
        position: absolute;
        top: 10px;
        right: 8px;
        background-color: #dc3545;
        color: white;
        border-radius: 50%;
        width: 18px;
        height: 18px;
        font-size: 10px;
        line-height: 18px;
        text-align: center;
        display: none;
      }
      .notification-badge.show {
        display: block;
      }
      #notification-symbol { font-size: 1.5em; }
    </style>
  </head>
  <body>
    <script>
      var API_URL = '<%= policeCadApiUrl %>';
    </script>
    <% // --- Permission logic for userId and canManageDepartments (moved to very top for global use) --- %>
    <%
      // Get userId for permission checks
      var userId = null;
      if (user && user._doc && user._doc._id) {
        userId = String(user._doc._id);
      } else if (user && user.user && user.user._id) {
        userId = String(user.user._id);
      }
      // Permission logic for managing departments
      var canManageDepartments = false;
      if (userId && community.community && Array.isArray(community.community.roles)) {
        community.community.roles.forEach(function(role) {
          if (Array.isArray(role.members) && role.members.includes(userId)) {
            if (Array.isArray(role.permissions)) {
              role.permissions.forEach(function(perm) {
                if (
                  (perm.name === "administrator" && perm.enabled === true) ||
                  (perm.name === "manage departments" && perm.enabled === true)
                ) {
                  canManageDepartments = true;
                }
              });
            }
          }
        });
      }
    %>
    <script>
      window.departmentsData = <%- JSON.stringify(departments) %>;
      window.dbUser = <%- JSON.stringify(user || {}) %>;
      window.canManageDepartmentsFlag = <%= canManageDepartments %>;
    </script>
    <!-- Header Bar -->
    <nav class="flex items-center justify-between px-4 py-3 bg-gray-900 shadow-lg sticky top-0 z-20">
      <div class="flex items-center space-x-2">
        <a href="/" class="flex items-center space-x-2">
          <img src="/static/images/favicon-32x32.png" alt="LPC Logo" class="h-8 w-8" />
          <span class="text-xl font-bold text-white">Lines Police CAD</span>
        </a>
      </div>
      <div class="flex items-center space-x-4">
        <% if (user) { %>
          <a onclick="openAccountModal()" class="text-gray-300 hover:text-white" style="cursor: pointer;">
            <ion-icon name="person-circle-outline" class="text-3xl align-middle"></ion-icon>
          </a>
        <% } else { %>
          <a href="/login-civ" class="text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-full font-semibold">Login</a>
        <% } %>
      </div>
    </nav>
    <!-- Back Link -->
    <div class="max-w-3xl mx-auto px-4 mt-6 mb-2">
      <a href="/communities" class="inline-block text-blue-400 hover:underline text-base mb-4">← Back to Communities</a>
    </div>
    <div class="max-w-3xl mx-auto py-8 px-4">
      <% if (community.community) { %>
        <% 
          let isMemberApproved = false;
          let isMemberPending = false;
          let memberSinceYear = null;
          // Get community ID from the route parameter (already decoded by the route)
          let communityId = community._id;
          if (communityId && typeof communityId === 'object' && communityId.$oid) {
            communityId = communityId.$oid;
          }
          
          if (user && user._doc && user._doc.user && Array.isArray(user._doc.user.communities) && communityId) {
            user._doc.user.communities.forEach(function(c) {
              if (String(c.communityId) === String(communityId) && c.status === 'approved') {
                isMemberApproved = true;
                // Extract year from MongoDB ObjectId string (first 4 bytes are timestamp)
                if (c._id && typeof c._id === 'string') {
                  const objectId = c._id;
                  const timestamp = parseInt(objectId.substring(0, 8), 16) * 1000;
                  const date = new Date(timestamp);
                  memberSinceYear = date.getFullYear().toString().slice(-2);
                }
              }
              if (String(c.communityId) === String(communityId) && c.status === 'pending') {
                isMemberPending = true;
              }
            });
          }
        %>
        <% if (user && community.community && !isMemberApproved && !isMemberPending) { %>
          <button onclick="openRequestJoinModal()" class="bg-blue-600 text-white px-6 py-2 rounded-full font-bold shadow hover:bg-blue-700 transition mb-4">
            Request to Join
          </button>
        <% } %>
        <% let isOwner = false;
           if (user && user._doc && community.community && community.community.ownerID) {
             isOwner = String(community.community.ownerID) === String(user._doc._id);
           }
        %>
        <% if (isMemberApproved && memberSinceYear) { %>
          <div class="mb-4 flex items-center justify-between">
            <div class="text-green-400 font-semibold flex items-center">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Member since '<%= memberSinceYear %>
            </div>
            <% if (isOwner) { %>
              <button onclick="openOwnerCannotLeaveModal()" class="bg-gray-500 text-white px-4 py-2 rounded-full font-semibold shadow cursor-not-allowed opacity-60">
                Leave Community
              </button>
            <% } else { %>
              <button onclick="openLeaveCommunityModal()" class="bg-red-600 text-white px-4 py-2 rounded-full font-semibold shadow hover:bg-red-700 transition">
                Leave Community
              </button>
            <% } %>
          </div>
        <% } %>
        <% if (isMemberPending) { %>
          <div class="mb-4 text-yellow-400 font-semibold">Your request to join is pending approval.</div>
        <% } %>
        <div class="card text-center">
          <img src="<%= community.community.imageLink || '/static/images/default-logo.png' %>" alt="<%= community.community.name %>" class="w-5/6 h-1/3 mx-auto rounded-t-lg object-cover mb-4" />
          <h1 class="text-3xl font-bold mb-2">
            <%= community.community.name %>
            <% if ((['elite','premium','standard'].includes(community.community.subscription?.plan)) && community.community.subscription?.active) { %>
              <svg viewBox="0 0 24 24" class="w-6 h-6 inline-block ml-2 align-middle" style="vertical-align: middle;">
                <circle cx="12" cy="12" r="10" fill="#eab308" />
                <path d="M8 12.5l3 3 5-5" stroke="#000" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% } %>
          </h1>
          <div class="flex flex-wrap justify-center gap-2 mb-2">
            <% if (community.community.tags && community.community.tags.length) { %>
              <% community.community.tags.forEach(function(tag) { %>
                <span class="inline-block bg-gray-700 text-gray-200 text-xs px-2 py-1 rounded-full"><%= tag %></span>
              <% }); %>
            <% } %>
          </div>
          <p class="text-gray-300 mb-2"><%= community.community.promotionalText %></p>
          <p class="text-gray-400 mb-4"><%= community.community.promotionalDescription %></p>
          <p class="text-gray-400 mb-2"><%= community.community.description %></p>
          <p class="text-gray-400 mb-4"><%= community.community.membersCount %> Members</p>
          <div class="flex flex-wrap justify-center gap-4 mb-4">
            <% if (community.community.links && community.community.links.length) { %>
              <% community.community.links.forEach(function(link) { %>
                <a href="<%= link.url %>" target="_blank" class="text-blue-400 hover:underline">🔗 <%= link.label %></a>
              <% }); %>
            <% } %>
          </div>
        </div>
        <% if (isMemberApproved) { %>
          <div class="card mb-6">
            <h3 class="text-lg font-semibold mb-4 text-center">Community Actions</h3>
            <div class="flex justify-center space-x-4">
              <button onclick="openPromoteModal()" class="flex flex-col items-center p-4 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                <i class="fa-solid fa-bullhorn w-6 h-6 mb-2 text-xl"></i>
                <span class="text-sm font-medium">Promote</span>
              </button>
              
              <%
                let canManageSettings = false;
                const userId = user && user._doc ? String(user._doc._id) : null;
                if (userId && community.community && Array.isArray(community.community.roles)) {
                  community.community.roles.forEach(function(role) {
                    if (Array.isArray(role.members) && role.members.includes(userId)) {
                      if (Array.isArray(role.permissions)) {
                        role.permissions.forEach(function(perm) {
                          if (
                            (perm.name === "administrator" && perm.enabled === true) ||
                            (perm.name === "manage community settings" && perm.enabled === true)
                          ) {
                            canManageSettings = true;
                          }
                        });
                      }
                    }
                  });
                }
              %>

              <% if (canManageSettings) { %>
                <button onclick="openSettingsModal()" class="flex flex-col items-center p-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg transition-colors">
                  <i class="fa-solid fa-gear w-6 h-6 mb-2 text-xl"></i>
                  <span class="text-sm font-medium">Settings</span>
                </button>
              <% } else { %>
                <button onclick="openNoSettingsPermissionModal()" class="flex flex-col items-center p-4 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors" style="pointer-events:auto;">
                  <i class="fa-solid fa-gear w-6 h-6 mb-2 text-xl"></i>
                  <span class="text-sm font-medium">Settings</span>
                </button>
              <% } %>
              
              <%
                // Permission logic for managing members (invite)
                let canManageMembers = false;
                if (userId && community.community && Array.isArray(community.community.roles)) {
                  community.community.roles.forEach(function(role) {
                    if (Array.isArray(role.members) && role.members.includes(userId)) {
                      if (Array.isArray(role.permissions)) {
                        role.permissions.forEach(function(perm) {
                          if (
                            (perm.name === "administrator" && perm.enabled === true) ||
                            (perm.name === "manage members" && perm.enabled === true)
                          ) {
                            canManageMembers = true;
                          }
                        });
                      }
                    }
                  });
                }
              %>
              <% if (canManageMembers) { %>
                <button onclick="openInviteModal()" class="flex flex-col items-center p-4 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors">
                  <i class="fa-solid fa-user-plus w-6 h-6 mb-2 text-xl"></i>
                  <span class="text-sm font-medium">Invite</span>
                </button>
              <% } else { %>
                <button onclick="openNoInvitePermissionModal()" class="flex flex-col items-center p-4 bg-gray-500 text-white rounded-lg opacity-60 cursor-not-allowed transition-colors" style="pointer-events:auto;">
                  <i class="fa-solid fa-user-plus w-6 h-6 mb-2 text-xl"></i>
                  <span class="text-sm font-medium">Invite</span>
                </button>
              <% } %>
              <button onclick="copyCommunityUrl()" class="flex flex-col items-center p-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-colors">
                <i class="fa-solid fa-share-nodes w-6 h-6 mb-2 text-xl"></i>
                <span class="text-sm font-medium">Share</span>
              </button>
            </div>
          </div>
          
          <%
            // Permission logic for managing departments
            let canManageDepartments = false;
            if (userId && community.community && Array.isArray(community.community.roles)) {
              community.community.roles.forEach(function(role) {
                if (Array.isArray(role.members) && role.members.includes(userId)) {
                  if (Array.isArray(role.permissions)) {
                    role.permissions.forEach(function(perm) {
                      if (
                        (perm.name === "administrator" && perm.enabled === true) ||
                        (perm.name === "manage departments" && perm.enabled === true)
                      ) {
                        canManageDepartments = true;
                      }
                    });
                  }
                }
              });
            }
          %>
          <div class="card">
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-xl font-semibold">Departments</h2>
              <% if (canManageDepartments) { %>
                <button onclick="openCreateDepartmentModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-full font-semibold shadow transition flex items-center">
                  <i class="fa fa-plus mr-2"></i> Create Department
                </button>
              <% } else { %>
                <button onclick="openNoDepartmentPermissionModal()" class="bg-gray-500 text-white px-4 py-2 rounded-full font-semibold shadow opacity-60 cursor-not-allowed flex items-center" style="pointer-events:auto;">
                  <i class="fa fa-plus mr-2"></i> Create Department
                </button>
              <% } %>
            </div>
            <% if (departments && departments.length) { %>
              <div id="departments-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
              <div class="flex justify-center items-center gap-4 mt-4" id="departments-pagination-controls"></div>
            <% } else { %>
              <p class="text-gray-400">No departments listed.</p>
            <% } %>
          </div>
        <% } else { %>
          <div class="card">
            <h2 class="text-xl font-semibold mb-2">Departments</h2>
            <% if (community.community.departments && community.community.departments.length) { %>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <% community.community.departments.forEach(function(dept) { 
  var isPublic = dept.approvalRequired === false;
  var isMember = Array.isArray(dept.members) && dept.members.some(function(m) { return m.userID === userId && m.status === 'approved'; });
  var canAccess = canManageDepartments || isPublic || isMember;
  var shouldDisable = !isMemberApproved || !user;
%>
  <div class="block bg-gray-800 rounded-lg shadow transition p-4 border border-gray-700 min-h-64 relative <%= (!shouldDisable && canAccess) ? 'hover:shadow-lg hover:border-blue-500 cursor-pointer' : 'opacity-60 pointer-events-none' %>">
    <img src="<%= dept.image || '/static/images/default-logo.png' %>" alt="<%= dept.name %>" class="w-full h-32 object-cover rounded mb-2" />
    <div class="font-bold text-lg text-white mb-1"><%= dept.name %></div>
    <div class="text-gray-400 text-sm mb-1"><%= dept.description || '' %></div>
    <div class="text-xs text-gray-500"><%= dept.template?.name || '' %></div>
    <% if (shouldDisable) { %>
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <span class="bg-black bg-opacity-60 text-white text-xs px-2 py-1 rounded">Members Only</span>
      </div>
    <% } %>
  </div>
<% }); %>
              </div>
            <% } else { %>
              <p class="text-gray-400">No departments listed.</p>
            <% } %>
          </div>
        <% } %>
        <%
  // Get userId for permission checks
  var userId = null;
  if (user && user._doc && user._doc._id) {
    userId = String(user._doc._id);
  } else if (user && user.user && user.user._id) {
    userId = String(user.user._id);
  }
%>
<%
  // Permission logic for managing events (EJS, like departments)
  let canManageEvents = false;
  if (userId && community.community && Array.isArray(community.community.roles)) {
    community.community.roles.forEach(function(role) {
      if (Array.isArray(role.members) && role.members.includes(userId)) {
        if (Array.isArray(role.permissions)) {
          role.permissions.forEach(function(perm) {
            if (
              (perm.name === "administrator" && perm.enabled === true) ||
              (perm.name === "manage community events" && perm.enabled === true)
            ) {
              canManageEvents = true;
            }
          });
        }
      }
    });
  }
%>
<div class="card">
  <div class="flex items-center justify-between mb-2">
    <h2 class="text-xl font-semibold">Events</h2>
    <% if (isMemberApproved) { %>
      <% if (canManageEvents) { %>
        <button onclick="openCreateEventModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-full font-semibold shadow transition flex items-center">
          <i class="fa fa-plus mr-2"></i> Create Event
        </button>
      <% } else { %>
        <button onclick="openNoEventPermissionModal()" class="bg-gray-500 text-white px-4 py-2 rounded-full font-semibold shadow opacity-60 cursor-not-allowed flex items-center" style="pointer-events:auto;">
          <i class="fa fa-plus mr-2"></i> Create Event
        </button>
      <% } %>
    <% } %>
  </div>
  <% if (community.community.events && community.community.events.length) { %>
    <ul class="text-left mx-auto max-w-xl">
      <% community.community.events.forEach(function(event) { %>
        <% if (isMemberApproved) { %>
          <li class="mb-4 p-3 rounded bg-gray-800 border border-gray-700">
            <div class="font-semibold text-lg text-white mb-1"><%= event.title %></div>
            <div class="text-gray-400 text-sm mb-1"><%= new Date(event.scheduledDate).toLocaleString() %></div>
            <div class="text-gray-300 text-sm mb-1"><%= event.description %></div>
            <% if (event.location) { %>
              <div class="text-gray-500 text-xs">Location: <%= event.location %></div>
            <% } %>
          </li>
        <% } else { %>
          <li class="mb-4 p-3 rounded bg-gray-800 border border-gray-700 relative opacity-70 cursor-not-allowed">
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-10">
              <span class="bg-black bg-opacity-60 text-white text-xs px-2 py-1 rounded">Members Only</span>
            </div>
            <div class="relative z-0">
              <div class="font-semibold text-lg text-white mb-1"><%= event.title %></div>
              <div class="text-gray-400 text-sm mb-1"><%= new Date(event.scheduledDate).toLocaleString() %></div>
              <div class="text-gray-300 text-sm mb-1"><%= event.description %></div>
              <% if (event.location) { %>
                <div class="text-gray-500 text-xs">Location: <%= event.location %></div>
              <% } %>
            </div>
          </li>
        <% } %>
      <% }); %>
    </ul>
  <% } else { %>
    <p class="text-gray-400">No events yet.</p>
  <% } %>
</div>

<!-- No Event Permission Modal -->
<div id="noEventPermissionModal" class="heroui-modal" style="display:none; position:fixed; z-index:2000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:500px; width:90%; position:relative; border:1px solid #35385a;">
    <button id="noEventPermissionModalClose" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
    <div style="text-align:center; margin-bottom:1.5rem;">
      <i class="fa fa-lock" style="font-size:3rem; color:#f56565; margin-bottom:1rem;"></i>
      <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">No Permission</h3>
    </div>
    <div style="color:#a0aec0; text-align:center; padding:1rem; margin-bottom:1.5rem;">
      <p>You do not have permission to create events.</p>
      <p style="font-size:0.9rem; margin-top:0.5rem; color:#f56565;">Request the <strong>manage community events</strong> permission from an admin.</p>
    </div>
    <div style="margin-top:2rem; text-align:center;">
      <button id="noEventPermissionModalCancel" type="button" style="background:#35385a; color:#fff; border:none; border-radius:8px; padding:0.6rem 1.2rem; font-weight:500; cursor:pointer;">
        Close
      </button>
    </div>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var closeBtn = document.getElementById('noEventPermissionModalClose');
  var cancelBtn = document.getElementById('noEventPermissionModalCancel');
  if (closeBtn) closeBtn.onclick = function() {
    document.getElementById('noEventPermissionModal').style.display = 'none';
  };
  if (cancelBtn) cancelBtn.onclick = function() {
    document.getElementById('noEventPermissionModal').style.display = 'none';
  };
});
</script>

      <% } else { %>
        <div class="card text-center">
          <h2 class="text-2xl font-bold mb-4">Community Not Found</h2>
          <p class="text-gray-400">Sorry, we couldn't load this community's details.</p>
        </div>
      <% } %>
    </div>
    
    <!-- HeroUI Pro Notifications Modal -->
    <div id="notificationModal" class="heroui-modal" style="display:none; position:fixed; z-index:2000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
      <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:500px; width:90%; max-height:80vh; overflow-y:auto; position:relative; border:1px solid #35385a;">
        <button id="notificationModalClose" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
        
        <h3 style="color:#fff; margin:0 0 1.5rem 0; font-size:1.5rem; font-weight:600;">
          Notifications
        </h3>
        
        <div id="notification-error" style="display:none; background:#f56565; color:#fff; border-radius:8px; padding:1rem; margin-bottom:1.5rem; border:1px solid #e53e3e;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <strong>Error!</strong> <span id="notification-error-message"></span>
            <button type="button" onclick="document.getElementById('notification-error').style.display = 'none'" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer;">
              <i class="fa fa-times"></i>
            </button>
          </div>
        </div>
        
        <div id="notification-loading" style="display:flex; justify-content:center; align-items:center; padding:3rem;">
          <div style="color:#a0aec0; font-style:italic;">Loading notifications...</div>
        </div>
        
        <!-- Notifications List -->
        <div id="notification-list" style="display:none; max-height:60vh; overflow-y:auto;">
          <!-- Dynamic notifications will be loaded here -->
        </div>
        
        <!-- No Notifications State -->
        <div id="no-notifications" style="display:none; text-align:center; padding:3rem; color:#a0aec0;">
          <i class="fa fa-bell-slash" style="font-size:3rem; margin-bottom:1rem; opacity:0.5;"></i>
          <p style="font-style:italic; font-size:1.1rem; margin:0;">No notifications found.</p>
        </div>
        
        <div id="notification-load-more" style="display:none; text-align:center; margin-top:1.5rem;">
          <button onclick="loadMoreNotifications()" style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%); color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; transition:all 0.2s;">
            Load More
          </button>
        </div>
        
        <div style="margin-top:2rem; text-align:center;">
