        infoElement.innerHTML = `
          <div style="text-align:left; background:#2d3748; padding:1rem; border-radius:8px; border:1px solid #4a5568;">
            <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem;">
              <div style="width:60px; height:60px; border-radius:50%; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#4a5568;">
                ${member.user?.profilePicture ? 
                  `<img src="${member.user.profilePicture}" alt="${member.user.username || 'User'}" style="width:100%; height:100%; object-fit:cover;">` : 
                  `<i class="fa fa-user" style="color:#a0aec0; font-size:2rem;"></i>`
                }
              </div>
              <div>
                <h4 style="color:#fff; margin:0; font-size:1.25rem; font-weight:600;">${member.user?.username || 'Unknown User'}</h4>
                ${member.user?.callSign ? `<p style="color:#a0aec0; margin:0; font-size:1rem;">Call Sign: ${member.user.callSign}</p>` : ''}
              </div>
            </div>
            <div style="border-top:1px solid #4a5568; padding-top:1rem;">
              <p><strong>Role:</strong> ${getMemberRole(member) || 'Member'}</p>
              <p><strong>Status:</strong> ${member.user?.isOnline ? '<span style="color:#10b981;">Online</span>' : '<span style="color:#6b7280;">Offline</span>'}</p>
              <p><strong>Member since:</strong> ${getMemberJoinDate(member)}</p>
              ${member.user?.dispatchStatus ? `<p><strong>Dispatch Status:</strong> ${member.user.dispatchStatus}</p>` : ''}
            </div>
          </div>
        `;
        
        // Populate action buttons based on permissions
        actionsContainer.innerHTML = '';
        
        if (canManageMembers || isOwner) {
          // Don't allow actions on yourself
          if (member._id !== '<%= user._doc._id %>') {
