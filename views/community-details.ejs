          Visibility
          <span class="relative group">
            <i class="fa fa-info-circle text-gray-400 cursor-pointer"></i>
            <span class="absolute left-6 top-0 w-64 bg-gray-900 text-gray-200 text-xs rounded shadow-lg px-3 py-2 z-50 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
              <strong>Public</strong>: Anyone in your community can access it.<br/>
              <strong>Private</strong>: Only those you add can access it (e.g. Police, Dispatch, etc).
            </span>
          </span>
        </label>
        <div class="flex items-center gap-3 mt-2">
          <span id="editDeptVisibilityPublic" class="text-sm font-medium <%= !false ? 'text-blue-400' : 'text-gray-400' %>">Public</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="editDeptApprovalRequired" class="sr-only peer" onchange="updateEditDeptVisibilityLabel()">
            <div class="w-11 h-6 bg-gray-600 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-blue-500 rounded-full peer peer-checked:bg-blue-600 transition-all"></div>
            <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full shadow transition-all peer-checked:translate-x-5"></div>
          </label>
          <span id="editDeptVisibilityPrivate" class="text-sm font-medium <%= false ? 'text-blue-400' : 'text-gray-400' %>">Private</span>
        </div>
      </div>
      <div id="createDeptStep1Error" class="text-red-400 text-sm mb-2" style="display:none;"></div>
      <div class="flex justify-end gap-2 mt-6">
        <button type="button" onclick="deleteEditDepartment()" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded font-semibold">Delete</button>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded font-semibold">Save</button>
      </div>
    </form>
  </div>
</div> 

<script>
function saveEditDepartment() {
  const deptId = currentEditDepartment;
  const communityId = '<%= community._id %>';
  const name = document.getElementById('editDeptName').value.trim();
  const description = document.getElementById('editDeptDescription').value.trim();
  const imageInput = document.getElementById('editDeptImage');
  const saveBtn = document.querySelector('#editDepartmentModal button[type="submit"]');
  if (!name) {
    if (typeof showToast === 'function') {
      showToast('Department name is required', 2500);
    } else {
      alert('Department name is required');
    }
    saveBtn.disabled = false;
    saveBtn.textContent = 'Save';
    return;
  }
  saveBtn.disabled = true;
  saveBtn.textContent = 'Saving...';

  // Prepare payload
  const approvalRequired = document.getElementById('editDeptApprovalRequired').checked;
  const payload = { name, description, approvalRequired };
  // If a new image is selected, upload it (placeholder: just use base64 for now)
  if (imageInput.files && imageInput.files[0]) {
    const reader = new FileReader();
    reader.onload = function(ev) {
      payload.image = ev.target.result;
      doUpdate();
    };
    reader.readAsDataURL(imageInput.files[0]);
  } else {
    doUpdate();
  }

  function doUpdate() {
    fetch(`${API_URL}/community/${communityId}/departments/${deptId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(res => {
        if (!res.ok) throw new Error('Failed to update department');
        return res.json();
      })
      .then(() => {
        closeEditDepartmentModal();
        if (typeof showToast === 'function') {
          showToast('Department updated successfully', 2500);
        } else {
          alert('Department updated successfully');
        }
        setTimeout(() => window.location.reload(), 1200);
      })
      .catch(err => {
        alert(err.message || 'Failed to update department');
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save';
      });
  }
}
function deleteEditDepartment() {
  const deptId = currentEditDepartment;
  const communityId = '<%= community._id %>';
  if (confirm('Are you sure you want to delete this department? This action is irreversible.')) {
    const deleteBtn = document.querySelector('#editDepartmentModal button.bg-red-600');
    deleteBtn.disabled = true;
    deleteBtn.textContent = 'Deleting...';
    fetch(`${API_URL}/community/${communityId}/departments/${deptId}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    })
      .then(res => {
        if (!res.ok) throw new Error('Failed to delete department');
        return res.json();
      })
      .then(() => {
        closeEditDepartmentModal();
        window.location.reload();
      })
      .catch(err => {
        alert(err.message || 'Failed to delete department');
        deleteBtn.disabled = false;
        deleteBtn.textContent = 'Delete';
      });
  }
}
</script> 

<script>
