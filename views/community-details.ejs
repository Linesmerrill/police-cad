    <!-- Set global variables for JS -->
    <script>
      window.dbUser = <%- JSON.stringify(user && user._doc ? user._doc : user || {}) %>;
      window.communityId = "<%= community._id %>";
      window.jwtToken = "<%= user && user._doc ? user._doc.jwtToken || '' : '' %>";
      window.canManageAnnouncements = <%- canManageAnnouncements %>;
      
      // For testing - ensure we have a user ID for mock data
      if (!window.dbUser._id) {
        window.dbUser._id = 'mock-user-1';
        window.dbUser.user = window.dbUser.user || {};
        window.dbUser.user.username = 'TestUser';
      }
      
    </script>
    <!-- Include announcements.js for announcement functionality -->
<script src="/static/js/announcements.js"></script>

    <% if (user && user._doc) { %>
      <!-- Account Management Modal -->
      <% include account-management %>
      
      <!-- Notification Modal -->
      <% include partials/notificationModal %>
      
      <!-- Modal Event Listeners -->
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          // Account button click handler
          const accountBtn = document.getElementById('accountBtn');
          if (accountBtn) {
            accountBtn.addEventListener('click', function() {
              fillAccountDetails();
              document.getElementById('accountModal').style.display = 'flex';
            });
          }
          
          // Account modal close button
          const accountModalClose = document.getElementById('accountModalClose');
          if (accountModalClose) {
            accountModalClose.addEventListener('click', function() {
              document.getElementById('accountModal').style.display = 'none';
            });
          }
          
          // Notification button click handler
          const notificationBtn = document.getElementById('notificationBtn');
          if (notificationBtn) {
            notificationBtn.addEventListener('click', function() {
              document.getElementById('notificationModal').style.display = 'flex';
              fetchNotifications(0);
            });
          }
          
          // Notification modal close button
          const notificationModalClose = document.getElementById('notificationModalClose');
          if (notificationModalClose) {
            notificationModalClose.addEventListener('click', function() {
              document.getElementById('notificationModal').style.display = 'none';
            });
          }
          
          // Notification modal cancel button
          const notificationModalCancel = document.getElementById('notificationModalCancel');
          if (notificationModalCancel) {
            notificationModalCancel.addEventListener('click', function() {
              document.getElementById('notificationModal').style.display = 'none';
            });
          }
          
          // Close modals when clicking outside
          window.addEventListener('click', function(event) {
            const accountModal = document.getElementById('accountModal');
            const notificationModal = document.getElementById('notificationModal');
            const deactivateModal = document.getElementById('deactivateAccountModal');
            
            if (event.target === accountModal && (!deactivateModal || deactivateModal.style.display === 'none')) {
              accountModal.style.display = 'none';
            }
            if (event.target === notificationModal) {
              notificationModal.style.display = 'none';
            }
          });
          
          // Initialize notification count on page load
          if (dbUser && dbUser._id) {
            // Initialize notification count using the function from notifications.js
            fetchNotificationCount();
          }
          
          // Set up all modal close handlers
          const modalCloseHandlers = [
            { id: 'promoteModalClose', modalId: 'promoteModal' },
            { id: 'promoteModalCancel', modalId: 'promoteModal' },
            { id: 'settingsModalClose', modalId: 'settingsModal' },
            { id: 'settingsModalCancel', modalId: 'settingsModal' },
            { id: 'inviteModalClose', modalId: 'inviteModal' },
            { id: 'inviteModalCancel', modalId: 'inviteModal' },
            { id: 'requestJoinModalClose', modalId: 'requestJoinModal' },
            { id: 'requestJoinModalCancel', modalId: 'requestJoinModal' },
            { id: 'leaveCommunityModalClose', modalId: 'leaveCommunityModal' },
            { id: 'leaveCommunityModalCancel', modalId: 'leaveCommunityModal' },
            { id: 'ownerCannotLeaveModalClose', modalId: 'ownerCannotLeaveModal' },
            { id: 'ownerCannotLeaveModalCancel', modalId: 'ownerCannotLeaveModal' },
            { id: 'noSettingsPermissionModalClose', modalId: 'noSettingsPermissionModal' },
            { id: 'noSettingsPermissionModalCancel', modalId: 'noSettingsPermissionModal' },
            { id: 'noInvitePermissionModalClose', modalId: 'noInvitePermissionModal' },
            { id: 'noInvitePermissionModalCancel', modalId: 'noInvitePermissionModal' },
            { id: 'noDepartmentPermissionModalClose', modalId: 'noDepartmentPermissionModal' },
            { id: 'noDepartmentPermissionModalCancel', modalId: 'noDepartmentPermissionModal' },
            { id: 'noEventPermissionModalClose', modalId: 'noEventPermissionModal' },
            { id: 'noEventPermissionModalCancel', modalId: 'noEventPermissionModal' },
            { id: 'noAnnouncementPermissionModalClose', modalId: 'noAnnouncementPermissionModal' },
            { id: 'noAnnouncementPermissionModalCancel', modalId: 'noAnnouncementPermissionModal' }
          ];
          
          modalCloseHandlers.forEach(handler => {
            const element = document.getElementById(handler.id);
            if (element) {
              element.onclick = function() {
                document.getElementById(handler.modalId).style.display = 'none';
              };
            }
          });
          
          // Set up leave community confirm handler
          const leaveCommunityModalConfirm = document.getElementById('leaveCommunityModalConfirm');
          if (leaveCommunityModalConfirm) {
            leaveCommunityModalConfirm.onclick = function() {
              submitLeaveCommunity();
            };
          }
        });
        
        // Fill account details function (same as community dashboard)
        function fillAccountDetails() {
          if (dbUser && dbUser.user) {
            const emailField = document.getElementById('accountEmail');
            const usernameField = document.getElementById('accountUsername');
            const callSignField = document.getElementById('accountCallSign');
            const profilePicture = document.getElementById('profilePicture');
            
            if (emailField) emailField.value = dbUser.user.email;
            if (usernameField) {
              usernameField.value = dbUser.user.username;
              usernameField.defaultValue = dbUser.user.username; // Set default for change detection
            }
            if (callSignField) {
              callSignField.value = dbUser.user.callSign;
              callSignField.defaultValue = dbUser.user.callSign; // Set default for change detection
            }
            if (profilePicture) {
              const profileImageUrl = dbUser.user.profilePicture || '/static/images/civ-unknown-user.png';
              profilePicture.style.backgroundImage = `url(${profileImageUrl})`;
            }
          }
        }
      </script>
    <% } %> 
    
