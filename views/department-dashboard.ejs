      <h2 class="dd-sidebar-dept"><%= departmentName || 'Department' %></h2>
      <p class="dd-sidebar-community">
        <i class="fa fa-circle"></i>
        <%= communityName || 'Community' %>
      </p>
    </div>

    <div class="dd-sidebar-nav">
      <!-- Dashboard nav -->
      <div class="dd-nav-section">
        <div class="dd-nav-section-label">Dashboard</div>
        <a class="dd-nav-item active" data-panel="overview" onclick="ddNavTo('overview')">
          <i class="fa fa-th-large"></i>
          Overview
        </a>
      </div>

      <!-- Component nav — built dynamically -->
      <div class="dd-nav-section" id="dd-nav-components">
        <div class="dd-nav-section-label">Components</div>
        <!-- Injected by JS based on enabledComponents -->
      </div>

      <!-- Departments -->
      <div class="dd-nav-section">
        <div class="dd-nav-section-label">Departments</div>
        <div class="dd-dept-list" id="dd-dept-list">
          <!-- Injected by JS -->
        </div>
      </div>

      <!-- Utilities -->
      <div class="dd-nav-section">
        <div class="dd-nav-section-label">Utilities</div>
        <a class="dd-nav-item" id="dd-nav-notifications" onclick="window.ddOpenNotifications && window.ddOpenNotifications()" style="cursor:pointer;">
          <i class="fa fa-bell"></i>
          Notifications
          <span class="dd-nav-badge" id="dd-notif-count" style="display:none;">0</span>
        </a>
        <a class="dd-nav-item" id="dd-nav-settings" data-panel="departmentSettings" onclick="window.ddNavTo && window.ddNavTo('departmentSettings')" style="cursor:pointer;">
          <i class="fa fa-gear"></i>
          Settings
        </a>
      </div>

      <!-- Navigation -->
      <div class="dd-nav-section">
        <div class="dd-nav-section-label">Navigation</div>
        <a class="dd-nav-item" href="<%= communityUrl %>">
          <i class="fa fa-arrow-left"></i>
          Back to Community
        </a>
        <a class="dd-nav-item" href="/communities">
          <i class="fa fa-layer-group"></i>
          All Communities
        </a>
        <a class="dd-nav-item" href="/most-wanted?c=<%= encodedCommunityId %>">
          <i class="fa fa-star"></i>
          Most Wanted
        </a>
        <a class="dd-nav-item" href="<%= encodedCommunityId ? '/community/' + encodedCommunityId + '/map' : '/map-interactive' %>">
          <i class="fa fa-map"></i>
          Map
        </a>
        <a class="dd-nav-item" href="/court-cases?c=<%= encodedCommunityId %>">
          <i class="fa fa-briefcase"></i>
          Court Cases
        </a>
        <a class="dd-nav-item" href="/help">
          <i class="fa fa-circle-question"></i>
          Help & Tutorials
        </a>
        <a class="dd-nav-item" href="/contact-us" target="_blank">
          <i class="fa fa-headset"></i>
          Support
        </a>
        <a class="dd-nav-item" href="/logout">
          <i class="fa fa-sign-out-alt"></i>
          Sign Out
        </a>
      </div>
    </div>

    <div class="dd-sidebar-footer">
      <a href="/profile" style="text-decoration:none;">
        <div class="dd-sidebar-user">
          <div class="dd-user-avatar"><% if (user.user && user.user.profilePicture) { %><img src="<%= user.user.profilePicture %>" alt=""><% } else { %><%= userInitial %><% } %></div>
          <div class="dd-user-info">
            <div class="dd-user-name"><%= username %></div>
            <div id="dd-user-role"><span class="dd-user-role-default">Department Member</span></div>
            <% include partials/rank-sidebar-badge %>
          </div>
        </div>
      </a>
    </div>
  </aside>

  <!-- ════════ Main ════════ -->
  <main class="dd-main">
    <div class="dd-topbar">
      <div class="dd-topbar-left">
        <div class="dd-topbar-title" id="dd-topbar-title">Overview</div>
        <span class="dd-topbar-dept-badge" id="dd-topbar-dept-badge" style="display:none;"></span>
      </div>
      <div class="dd-topbar-actions">
        <button class="dd-topbar-btn dd-switch-classic" id="dd-switch-classic" title="Switch back to Classic Dashboard" style="display:none;width:auto;padding:0 0.625rem;gap:0.375rem;font-size:0.6875rem;font-weight:500;color:var(--dd-text-muted);" onclick="ddSwitchToClassic()">
          <i class="fa fa-arrow-rotate-left" style="font-size:0.625rem;"></i> Classic
        </button>
        <button class="dd-topbar-btn" title="Refresh" onclick="ddRefresh()">
          <i class="fa fa-arrows-rotate"></i>
        </button>
        <a class="dd-topbar-btn" href="/profile" title="Profile">
          <i class="fa fa-user"></i>
        </a>
      </div>
    </div>

    <div class="dd-content" id="dd-content">
      <!-- Loading state -->
      <div id="dd-loading" class="dd-spinner"></div>

      <!-- Content panels injected by JS -->
      <div id="dd-panels" style="display:none;"></div>

      <!-- Rank Progress (styled to match DD) -->
      <div id="dd-rank-wrap" style="margin-bottom:1rem;">
        <% include partials/rank-progress-card %>
      </div>
      <style>
        #dd-rank-wrap #myRankStatsCard {
          max-width: 100% !important;
          margin: 0 !important;
          padding: 0 !important;
        }
        #dd-rank-wrap #myRankStatsCard > div {
          background: var(--dd-glass) !important;
          border: 1px solid var(--dd-glass-border) !important;
          border-radius: var(--dd-radius) !important;
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          box-shadow: none !important;
          padding: 0.875rem 1.125rem !important;
          overflow: hidden !important;
        }
        /* Compact header row */
        #dd-rank-wrap #myRankStatsCard > div > div:first-child {
          margin-bottom: 10px !important;
          gap: 8px !important;
        }
        #dd-rank-wrap #myRankStatsCard > div > div:first-child > div:first-child {
          gap: 10px !important;
        }
        #dd-rank-wrap #myRankStatsCard > div > div:first-child > div:first-child > div:first-child {
          width: 36px !important; height: 36px !important; border-radius: 8px !important;
          background: var(--dd-accent-glow) !important; border-color: rgba(139,92,246,0.2) !important;
        }
        #dd-rank-wrap #myRankStatsCard > div > div:first-child > div:first-child > div:first-child i {
          font-size: 16px !important; color: var(--dd-accent) !important;
        }
        #dd-rank-wrap #myRankName {
          font-family: 'Outfit', sans-serif !important;
          font-size: 0.9375rem !important; line-height: 1.2 !important;
        }
        #dd-rank-wrap #myRankPrefix {
          background: var(--dd-accent-glow) !important;
          color: var(--dd-accent) !important;
          font-size: 0.625rem !important; padding: 2px 7px !important;
        }
        #dd-rank-wrap span[style*="Current Rank"], #dd-rank-wrap #myRankStatsCard > div > div:first-child > div:first-child > div:last-child > span:last-child {
          font-size: 0.6875rem !important;
        }
        #dd-rank-wrap #nextRankInfo {
          font-size: 0.75rem !important;
        }
        #dd-rank-wrap #nextRankInfo > span:first-child {
          font-size: 0.5625rem !important;
        }
        #dd-rank-wrap #nextRankName {
          font-size: 0.875rem !important; color: var(--dd-text) !important;
        }
        /* Progress bars */
        #dd-rank-wrap #rankProgressBars {
          max-height: 120px !important; gap: 8px !important;
        }
        /* Toggle button */
        #dd-rank-wrap #rankStatsToggle {
          background: var(--dd-glass) !important;
          border: 1px solid var(--dd-glass-border) !important;
          border-radius: var(--dd-radius-sm) !important;
          color: var(--dd-accent) !important;
          font-family: 'Outfit', sans-serif !important;
          font-size: 0.75rem !important;
          margin-top: 10px !important;
          padding: 7px !important;
        }
        #dd-rank-wrap #rankStatsToggle:hover {
          background: var(--dd-glass-hover) !important;
        }
        /* Stats grid */
        #dd-rank-wrap #rankStatsGrid {
          gap: 8px !important;
        }
        #dd-rank-wrap #rankStatsGrid > div {
          background: var(--dd-surface) !important;
          border: 1px solid var(--dd-glass-border) !important;
          border-radius: var(--dd-radius-sm) !important;
          padding: 10px 8px !important;
        }
        #dd-rank-wrap #rankStatsGrid > div > div:first-child {
          font-size: 1.25rem !important;
        }
        #dd-rank-wrap #rankStatsGrid > div > div:last-child {
          font-size: 0.5625rem !important; margin-top: 4px !important;
        }
        @media (max-width: 640px) {
          #dd-rank-wrap #myRankStatsCard > div { padding: 0.75rem !important; }
          #dd-rank-wrap #rankStatsGrid { grid-template-columns: repeat(2, 1fr) !important; }
        }
      </style>
    </div>
  </main>

  <!-- Toast -->
  <div class="dd-toast" id="dd-toast"></div>

  <% include partials/rank-modals %>

  <!-- Unified Modal -->
  <div class="dd-modal-overlay" id="dd-modal-overlay">
    <div class="dd-modal" id="dd-modal">
      <div class="dd-modal-header">
        <h3 id="dd-modal-title"></h3>
        <button class="dd-modal-close" id="dd-modal-close"><i class="fa fa-times"></i></button>
      </div>
      <div class="dd-modal-body">
        <div class="dd-modal-icon" id="dd-modal-icon"></div>
        <p id="dd-modal-msg" style="color:var(--dd-text);"></p>
        <p class="dd-modal-detail" id="dd-modal-detail"></p>
      </div>
      <div class="dd-modal-footer" id="dd-modal-footer"></div>
    </div>
  </div>

  <script>
  (function() {
    'use strict';

    // ── Config ──
    var API_URL = '<%= apiUrl || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    var departmentId = '<%= departmentId || "" %>';
    var dbUser = <%- JSON.stringify(user) %>;
    var communityId = dbUser.user?.lastAccessedCommunity?.communityID || '';
    var userId = dbUser._id || dbUser.user?._id || '';
    var userName = dbUser.user?.username || 'Judge';

    // Expose config for external component JS files (dd-civilians.js, etc.)
    window.ddConfig = {
      API_URL: API_URL,
      communityId: communityId,
      userId: userId,
      departmentId: departmentId,
      dbUser: dbUser,
      userName: userName
    };

    var enabledComponents = {};
    var pendingWarrants = [];
    var tenCodes = [];
    var penalCodesData = [];
    var penalCodesCurrency = 'USD';
    var expandedWarrantId = null;
    var currentTemplateName = '';

    // ── Component Registry ──
    // Each key maps to a component definition that can be rendered.
    // New templates just add components here.
    var componentRegistry = {
      reviewWarrants: {
        label: 'Review Warrants',
        icon: 'fa-gavel',
        navIcon: 'fa-gavel',
        gridClass: 'dd-grid-full',
        accentColor: 'var(--dd-accent)',
        render: renderWarrantsPanel,
        init: loadPendingWarrants
      },
      notepad: {
        label: 'Notepad',
        icon: 'fa-sticky-note',
        navIcon: 'fa-sticky-note',
        gridClass: 'dd-grid-full',
        accentColor: 'var(--dd-amber)',
        overviewHidden: true,
        render: renderNotepadPanel,
        init: initNotepad
      },
      allWarrants: {
        label: 'All Warrants',
        icon: 'fa-folder-open',
        navIcon: 'fa-folder-open',
        gridClass: 'dd-grid-full',
        accentColor: 'var(--dd-blue)',
        render: renderAllWarrantsPanel,
        init: loadAllWarrants
      },
      '10CodesInterface': {
        label: '10-Codes',
        icon: 'fa-list-ol',
        navIcon: 'fa-list-ol',
        gridClass: '',
        accentColor: 'var(--dd-blue)',
        render: renderCodesPanel,
        init: loadTenCodes
      },
      penalCodes: {
        label: 'Penal Codes',
        icon: 'fa-scale-balanced',
        navIcon: 'fa-scale-balanced',
        gridClass: 'dd-grid-full',
        accentColor: 'var(--dd-amber)',
        render: renderPenalCodesPanel,
        init: loadPenalCodes
      },
      courtCases: {
        label: 'Court Cases',
        icon: 'fa-briefcase',
        navIcon: 'fa-briefcase',
        gridClass: 'dd-grid-full',
        accentColor: 'var(--dd-accent)',
        render: renderCourtCasesPanel,
        init: loadCourtCases
      },
      // ── Civilian template components ──
      createCivilians: {
        label: 'Civilians',
        icon: 'fa-users',
        navIcon: 'fa-users',
        gridClass: 'dd-grid-full',
        accentColor: 'var(--dd-blue)',
        render: function(key) { return window.ddCivRender ? window.ddCivRender(key) : '<div class="dd-empty"><i class="fa fa-users"></i><p>Loading civilians...</p></div>'; },
        init: function() { if (window.ddCivInit) window.ddCivInit(); }
      },
      createVehicles: {
        label: 'Vehicles',
        icon: 'fa-car',
        navIcon: 'fa-car',
        gridClass: 'dd-grid-full',
        accentColor: 'var(--dd-green)',
        render: function(key) { return window.ddVehRender ? window.ddVehRender(key) : '<div class="dd-empty"><i class="fa fa-car"></i><p>Loading vehicles...</p></div>'; },
        init: function() { if (window.ddVehInit) window.ddVehInit(); }
      },
      createFirearms: {
        label: 'Firearms',
        icon: 'fa-crosshairs',
        navIcon: 'fa-crosshairs',
        gridClass: 'dd-grid-full',
        accentColor: 'var(--dd-red)',
        render: function(key) { return window.ddFirearmRender ? window.ddFirearmRender(key) : '<div class="dd-empty"><i class="fa fa-crosshairs"></i><p>Loading firearms...</p></div>'; },
        init: function() { if (window.ddFirearmInit) window.ddFirearmInit(); }
      },
      call911: {
        label: 'Call 911',
        icon: 'fa-phone',
        navIcon: 'fa-phone',
        gridClass: '',
        accentColor: 'var(--dd-red)',
        sidebarAction: function() {
          // Clicking in sidebar should open the 911 modal directly, not navigate
          if (window.ddOpen911) window.ddOpen911();
          else ddToast('911 system loading...', 'error');
        },
        render: function(key) {
          return '' +
            '<div class="dd-card-body" style="padding:0;" onclick="window.ddOpen911 ? window.ddOpen911() : window.ddToast(\'Loading...\', \'error\');" role="button" tabindex="0">' +
              '<div style="position:relative; overflow:hidden; border-radius:var(--dd-radius); cursor:pointer; transition:all 0.2s;">' +
                /* Pulsing background glow */
                '<div style="position:absolute; inset:0; background:radial-gradient(ellipse at 30% 50%, rgba(239,68,68,0.12) 0%, transparent 70%); pointer-events:none;"></div>' +
                '<div style="display:flex; align-items:center; gap:1rem; padding:1.25rem 1.5rem;">' +
                  /* Animated icon ring */
                  '<div style="position:relative; width:52px; height:52px; flex-shrink:0;">' +
                    '<div style="position:absolute; inset:0; border-radius:50%; border:2px solid rgba(239,68,68,0.3); animation:dd-911-ring 2s ease-in-out infinite;"></div>' +
                    '<div style="width:100%; height:100%; border-radius:50%; background:linear-gradient(135deg, rgba(239,68,68,0.2), rgba(220,38,38,0.1)); display:flex; align-items:center; justify-content:center;">' +
                      '<i class="fa fa-phone" style="color:#ef4444; font-size:1.125rem;"></i>' +
                    '</div>' +
                  '</div>' +
                  /* Text content */
                  '<div style="flex:1; min-width:0;">' +
                    '<div style="font-size:0.9375rem; font-weight:700; color:#fff; letter-spacing:0.01em;">Emergency Services</div>' +
                    '<div style="font-size:0.75rem; color:var(--dd-text-muted); margin-top:0.2rem;">Tap to contact 911</div>' +
                  '</div>' +
                  /* Arrow indicator */
                  '<div style="color:rgba(239,68,68,0.5); font-size:0.875rem;">' +
                    '<i class="fa fa-chevron-right"></i>' +
                  '</div>' +
                '</div>' +
              '</div>' +
            '</div>';
        },
        init: function() {
          // Inject the pulse animation if not already present
          if (!document.getElementById('dd-911-card-anim')) {
            var style = document.createElement('style');
            style.id = 'dd-911-card-anim';
            style.textContent = '@keyframes dd-911-ring { 0%,100% { transform:scale(1); opacity:0.6; } 50% { transform:scale(1.15); opacity:0.2; } }';
            document.head.appendChild(style);
          }
        }
      },
      // ── Department Management (always available) ──
      departmentSettings: {
        label: 'Department Management',
        icon: 'fa-cog',
        navIcon: 'fa-cog',
        gridClass: 'dd-grid-full',
        accentColor: 'var(--dd-accent)',
        overviewHidden: true,
        sidebarHidden: true,
        render: function(key) { return window.ddSettingsRender ? window.ddSettingsRender(key) : '<div class="dd-empty"><i class="fa fa-cog"></i><p>Loading settings...</p></div>'; },
        init: function() { if (window.ddSettingsInit) window.ddSettingsInit(); }
      }
    };

    // ── Department type config ──
    var deptTypeConfig = {
      police:   { icon: 'fa-shield',          color: '#3b82f6', route: 'police' },
      dispatch: { icon: 'fa-headset',         color: '#8b5cf6', route: 'dispatch' },
      fire:     { icon: 'fa-fire-extinguisher', color: '#f97316', route: 'ems' },
      ems:      { icon: 'fa-medkit',           color: '#22c55e', route: 'ems' },
      civilian: { icon: 'fa-user',             color: '#6b7280', route: 'department' },
      judicial: { icon: 'fa-gavel',            color: '#f59e0b', route: 'department' }
    };

    // ── Initialize ──
    $(document).ready(function() {
      fetchDepartmentData();
      loadSidebarDepartments();
    });

    function fetchDepartmentData() {
      if (!departmentId || !/^[a-f0-9]{24}$/i.test(departmentId)) {
        showError('No department selected.');
        return;
      }
      if (communityId && !/^[a-f0-9]{24}$/i.test(communityId)) {
        showError('Invalid community.');
        return;
      }
      $.ajax({
        url: API_URL + '/api/v1/community/' + encodeURIComponent(communityId) + '/departments/' + encodeURIComponent(departmentId),
        method: 'GET',
        success: function(dept) {
          // Store full department data for settings panel and other uses
          window.ddConfig.departmentData = dept?.department || dept || {};
          var template = dept?.department?.template;
          if (template && template.components) {
            template.components.forEach(function(comp) {
              enabledComponents[comp.name] = comp.enabled;
            });
          }
          currentTemplateName = (template && template.name || '').toLowerCase();
          // Always enable department management
          enabledComponents['departmentSettings'] = true;
          buildDashboard();
        },
        error: function() {
          // Fallback: show all components from registry
          Object.keys(componentRegistry).forEach(function(k) {
            enabledComponents[k] = true;
          });
          buildDashboard();
        }
      });
    }

    // ── Department type indicator helpers ──
    function hexToRgba(hex, alpha) {
      var r = parseInt(hex.slice(1, 3), 16);
      var g = parseInt(hex.slice(3, 5), 16);
      var b = parseInt(hex.slice(5, 7), 16);
      return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
    }

    function lightenHex(hex, amount) {
      var r = parseInt(hex.slice(1, 3), 16);
      var g = parseInt(hex.slice(3, 5), 16);
      var b = parseInt(hex.slice(5, 7), 16);
      r = Math.min(255, Math.round(r + (255 - r) * amount));
      g = Math.min(255, Math.round(g + (255 - g) * amount));
      b = Math.min(255, Math.round(b + (255 - b) * amount));
      return 'rgb(' + r + ',' + g + ',' + b + ')';
    }

    function applyDeptTypeIndicator() {
      var dtc = deptTypeConfig[currentTemplateName];
      if (!dtc) return;

      var color = dtc.color;
      var labelMap = { police: 'Police', dispatch: 'Dispatch', fire: 'Fire', ems: 'EMS', civilian: 'Civilian', judicial: 'Judicial' };
      var label = labelMap[currentTemplateName] || currentTemplateName.charAt(0).toUpperCase() + currentTemplateName.slice(1);

      // Frosted glow line on topbar bottom
      var gradient = 'linear-gradient(90deg, transparent 0%, ' + color + ' 30%, ' + color + ' 70%, transparent 100%)';
      document.querySelector('.dd-topbar').style.setProperty('--dd-dept-glow', gradient);

      // Department badge
      var $badge = $('#dd-topbar-dept-badge');
      $badge
        .html('<i class="fa ' + dtc.icon + '"></i> ' + label)
        .css({
          background: hexToRgba(color, 0.12),
          border: '1px solid ' + hexToRgba(color, 0.25),
          color: lightenHex(color, 0.3)
        })
        .show();
    }

    function buildDashboard() {
      buildSidebarNav();
      buildPanels();
      checkWarrantApprovalMode();
      applyDeptTypeIndicator();
      loadRecordsStats();

      // Show "Switch to Classic" button for civilian template departments
      if (currentTemplateName === 'civilian') {
        var classicBtn = document.getElementById('dd-switch-classic');
        if (classicBtn) classicBtn.style.display = '';
      }

$('#dd-loading').hide();
      $('#dd-panels').show();

      // Init each enabled component
      Object.keys(componentRegistry).forEach(function(key) {
        if (enabledComponents[key] && componentRegistry[key].init) {
          componentRegistry[key].init();
        }
      });

      // Auto-navigate to a section from hash (e.g. #penalCodes) or query param (?section=penalCodes)
      var urlSection = window.location.hash.replace('#', '') ||
                       new URLSearchParams(window.location.search).get('section');
      if (urlSection && urlSection !== 'overview' && componentRegistry[urlSection] && enabledComponents[urlSection]) {
        ddNavTo(urlSection);
      } else {
        ddNavTo('overview');
      }
    }

    // Expose internals for dd-settings.js to sync sidebar on component toggle
    window.ddConfig._enabledComponents = enabledComponents;
    window.ddConfig._componentRegistry = componentRegistry;
    window.ddBuildSidebarNav = buildSidebarNav;

    // ── Sidebar Nav ──
    function buildSidebarNav() {
      var $nav = $('#dd-nav-components');
      // Keep section label, remove old items
      $nav.find('.dd-nav-item').remove();

      // Build ordered list: use template.components order, then append
      // any registry-only items (like departmentSettings) not in the array
      var dept = window.ddConfig.departmentData || {};
      var tplComps = (dept.template && dept.template.components) || [];
      var ordered = [];
      var seen = {};
      tplComps.forEach(function(c) { if (c.name) { ordered.push(c.name); seen[c.name] = true; } });
      Object.keys(componentRegistry).forEach(function(key) { if (!seen[key]) ordered.push(key); });

      ordered.forEach(function(key) {
        if (!enabledComponents[key]) return;
        var comp = componentRegistry[key];
        if (!comp || comp.sidebarHidden) return;
        var $item = $('<a class="dd-nav-item" data-panel="' + key + '">' +
          '<i class="fa ' + comp.navIcon + '"></i>' +
          comp.label +
          (key === 'reviewWarrants' ? '<span class="dd-nav-badge" id="dd-warrant-count" style="display:none;">0</span>' : '') +
          (key === 'courtCases' ? '<span class="dd-nav-badge dd-cc-live-badge" id="dd-cc-live-count" style="display:none;">0</span><span class="dd-nav-badge" id="dd-cc-pending-count" style="display:none;">0</span>' : '') +
          '</a>');
        if (comp.sidebarAction) {
          $item.on('click', function() { comp.sidebarAction(); });
        } else {
          $item.on('click', function() { ddNavTo(key); });
        }
        $nav.append($item);
      });
    }

    // ── Build Panels ──
    function buildPanels() {
      var $panels = $('#dd-panels');
      $panels.empty();

      // Stats sections
      var hasCourt = !!enabledComponents.courtCases;
      var hasWarrants = !!enabledComponents.reviewWarrants;

      // If both sections exist, use side-by-side layout; if only one, single column
      var sectionsClass = (hasWarrants && hasCourt) ? 'dd-stats-sections' : 'dd-stats-sections';
      var $statsRow = $('<div class="' + sectionsClass + ' dd-animate-in" id="dd-stats-row"></div>');

      // Warrants section
      if (hasWarrants) {
        $statsRow.append(
          '<div class="dd-stats-section dd-animate-in" style="--section-accent:var(--dd-accent); animation-delay:0.02s;">' +
            '<div class="dd-stats-section-header">' +
              '<div class="dd-stats-section-icon"><i class="fa fa-gavel"></i></div>' +
              '<div class="dd-stats-section-title">Warrants</div>' +
            '</div>' +
            '<div class="dd-stats-section-grid">' +
              '<div class="dd-stat-mini">' +
                '<div class="dd-stat-mini-value accent" id="dd-stat-pending">—</div>' +
                '<div class="dd-stat-mini-label" data-icon="pending">Pending</div>' +
              '</div>' +
              '<div class="dd-stat-mini">' +
                '<div class="dd-stat-mini-value green" id="dd-stat-approved">—</div>' +
                '<div class="dd-stat-mini-label" data-icon="approved">Approved</div>' +
              '</div>' +
              '<div class="dd-stat-mini">' +
                '<div class="dd-stat-mini-value red" id="dd-stat-denied">—</div>' +
                '<div class="dd-stat-mini-label" data-icon="denied">Denied</div>' +
              '</div>' +
              '<div class="dd-stat-mini">' +
                '<div class="dd-stat-mini-value amber" id="dd-stat-total">—</div>' +
                '<div class="dd-stat-mini-label" data-icon="total">Total</div>' +
              '</div>' +
            '</div>' +
          '</div>'
        );
      }

      // Court Cases section
      if (hasCourt) {
        $statsRow.append(
          '<div class="dd-stats-section dd-animate-in" style="--section-accent:var(--dd-amber); animation-delay:0.06s;">' +
            '<div class="dd-stats-section-header">' +
              '<div class="dd-stats-section-icon"><i class="fa fa-briefcase"></i></div>' +
              '<div class="dd-stats-section-title">Court Cases</div>' +
            '</div>' +
            '<div class="dd-stats-section-grid">' +
              '<div class="dd-stat-mini">' +
                '<div class="dd-stat-mini-value amber" id="dd-ov-cc-pending">—</div>' +
                '<div class="dd-stat-mini-label" data-icon="pending">Pending</div>' +
              '</div>' +
              '<div class="dd-stat-mini">' +
                '<div class="dd-stat-mini-value blue" id="dd-ov-cc-scheduled">—</div>' +
                '<div class="dd-stat-mini-label" data-icon="scheduled">Scheduled</div>' +
              '</div>' +
              '<div class="dd-stat-mini">' +
                '<div class="dd-stat-mini-value red" id="dd-ov-cc-active">—</div>' +
                '<div class="dd-stat-mini-label" data-icon="active">Active</div>' +
              '</div>' +
              '<div class="dd-stat-mini">' +
                '<div class="dd-stat-mini-value green" id="dd-ov-cc-completed">—</div>' +
                '<div class="dd-stat-mini-label" data-icon="closed">Completed</div>' +
              '</div>' +
            '</div>' +
          '</div>'
        );
      }

      // Civilians section (for civilian template)
      var hasCivs = !!enabledComponents.createCivilians;
      var hasVehs = !!enabledComponents.createVehicles;
      var hasFirearms = !!enabledComponents.createFirearms;

      if (hasCivs || hasVehs || hasFirearms) {
        $statsRow.append(
          '<div class="dd-stats-section dd-animate-in" style="--section-accent:var(--dd-blue); animation-delay:0.02s;">' +
            '<div class="dd-stats-section-header">' +
              '<div class="dd-stats-section-icon"><i class="fa fa-id-card"></i></div>' +
              '<div class="dd-stats-section-title">Records</div>' +
            '</div>' +
            '<div class="dd-stats-section-grid">' +
              (hasCivs ? '<div class="dd-stat-mini"><div class="dd-stat-mini-value blue" id="dd-stat-civs">—</div><div class="dd-stat-mini-label" data-icon="civilians">Civilians</div></div>' : '') +
              (hasVehs ? '<div class="dd-stat-mini"><div class="dd-stat-mini-value green" id="dd-stat-vehs">—</div><div class="dd-stat-mini-label" data-icon="vehicles">Vehicles</div></div>' : '') +
              (hasFirearms ? '<div class="dd-stat-mini"><div class="dd-stat-mini-value red" id="dd-stat-firearms">—</div><div class="dd-stat-mini-label" data-icon="firearms">Firearms</div></div>' : '') +
            '</div>' +
          '</div>'
        );
      }

      // Adjust grid columns based on how many stat sections exist
      var statSections = (hasWarrants ? 1 : 0) + (hasCourt ? 1 : 0) + ((hasCivs || hasVehs || hasFirearms) ? 1 : 0);
      if (statSections === 1) {
        $statsRow.css('grid-template-columns', '1fr');
      }

      // Overview panel: shows all components in a grid
      var $overview = $('<div id="dd-panel-overview"></div>');
      $overview.append($statsRow);
      var $grid = $('<div class="dd-grid dd-animate-in"></div>');

      // Sort keys so priority components (call911) appear first in overview
      var priorityKeys = ['call911'];
      var orderedKeys = Object.keys(componentRegistry).slice();
      orderedKeys.sort(function(a, b) {
        var aP = priorityKeys.indexOf(a);
        var bP = priorityKeys.indexOf(b);
        if (aP !== -1 && bP !== -1) return aP - bP;
        if (aP !== -1) return -1;
        if (bP !== -1) return 1;
        return 0;
      });

      var visibleIdx = 0;
      var overviewVisibleCount = 0;
      orderedKeys.forEach(function(key) {
        if (!enabledComponents[key]) return;
        var comp = componentRegistry[key];
        // Components with overviewHidden are only accessible from sidebar, not shown on overview grid
        var hideOnOverview = comp.overviewHidden;
        var $card = $('<div class="dd-card ' + comp.gridClass + ' dd-animate-in" id="dd-component-' + key + '" style="--card-accent:' + comp.accentColor + '; animation-delay:' + (visibleIdx * 0.08 + 0.15) + 's"></div>');
        $card.html(comp.render(key));
        if (hideOnOverview) {
          $card.addClass('dd-overview-hidden');
        } else {
          overviewVisibleCount++;
        }
        $grid.append($card);
        visibleIdx++;
      });

      // Empty state when no visible components on overview
      if (overviewVisibleCount === 0 && statSections === 0) {
        $grid.append(
          '<div class="dd-card dd-grid-full dd-animate-in dd-overview-empty" style="animation-delay:0.15s;">' +
            '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:3rem 1.5rem;text-align:center;">' +
              '<div style="width:64px;height:64px;border-radius:50%;background:rgba(139,92,246,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">' +
                '<i class="fa fa-cubes" style="font-size:1.5rem;color:var(--dd-accent);"></i>' +
              '</div>' +
              '<div style="font-size:1rem;font-weight:600;color:var(--dd-text);margin-bottom:0.35rem;">No components enabled</div>' +
              '<div id="dd-empty-state-action" style="font-size:0.8125rem;color:var(--dd-text-muted);max-width:360px;line-height:1.5;">' +
                'This department doesn\'t have any components enabled yet.' +
              '</div>' +
            '</div>' +
          '</div>'
        );
      }

      $overview.append($grid);

      // Move rank progress card into the overview, between stats and grid
      var $rankWrap = $('#dd-rank-wrap');
      if ($rankWrap.length) {
        $rankWrap.insertAfter($statsRow);
      }

      $panels.append($overview);

      // NOTE: We no longer create separate focused panels.
      // ddNavTo handles focus mode by hiding the stats row and
      // collapsing other cards within the overview grid.
    }

    // ── Warrant Approval Mode Banner ──
    function checkWarrantApprovalMode() {
      if (!communityId || !departmentId) return;

      $.ajax({
        url: API_URL + '/api/v1/community/' + communityId,
        method: 'GET',
        success: function(res) {
          var community = res.community || res;
          // Store community data for settings panel (roles, permissions)
          window.ddConfig.communityData = community;

          // Re-render settings component now that permissions are available
          if (window.ddSettingsInit) window.ddSettingsInit();

          // Check creation limits now that community data is available
          if (window.ddLimits) {
            window.ddLimits.check('civilian');
            window.ddLimits.check('vehicle');
            window.ddLimits.check('firearm');
          }

          // Resolve all user roles for sidebar display
          var userRoles = [];
          var roles = community.roles || [];
          // Palette of distinct colours for role tags
          var rolePalette = [
            { bg: 'rgba(99,102,241,0.18)',  color: '#818cf8' },
            { bg: 'rgba(34,197,94,0.18)',   color: '#4ade80' },
            { bg: 'rgba(245,158,11,0.18)',  color: '#fbbf24' },
            { bg: 'rgba(239,68,68,0.18)',   color: '#f87171' },
            { bg: 'rgba(168,85,247,0.18)',  color: '#c084fc' },
            { bg: 'rgba(6,182,212,0.18)',   color: '#22d3ee' },
            { bg: 'rgba(244,114,182,0.18)', color: '#f472b6' },
            { bg: 'rgba(251,146,60,0.18)',  color: '#fb923c' }
          ];
          for (var ri = 0; ri < roles.length; ri++) {
            var role = roles[ri];
            var roleMembers = role.members || [];
            if (roleMembers.indexOf(userId) !== -1 && role.name) {
              userRoles.push(role.name);
            }
          }
          if (userRoles.length) {
            var tagsHtml = '<div class="dd-user-roles">';
            for (var ti = 0; ti < userRoles.length; ti++) {
              var pc = rolePalette[ti % rolePalette.length];
              tagsHtml += '<span class="dd-user-role-tag" style="background:' + pc.bg + ';color:' + pc.color + ';">' + userRoles[ti] + '</span>';
            }
            tagsHtml += '</div>';
            $('#dd-user-role').html(tagsHtml);
          }

          // Update empty-state action based on permissions
          var $emptyAction = $('#dd-empty-state-action');
          if ($emptyAction.length) {
            var isOwner = (community.ownerID || '') === userId;
            var canManageDepts = isOwner;
            if (!canManageDepts) {
              for (var pi = 0; pi < roles.length; pi++) {
                var pr = roles[pi];
                if ((pr.members || []).indexOf(userId) === -1) continue;
                (pr.permissions || []).forEach(function(p) {
                  if ((p.name === 'manage departments' || p.name === 'administrator') && p.enabled) canManageDepts = true;
                });
              }
            }
            if (canManageDepts) {
              $emptyAction.html(
                'This department doesn\'t have any components enabled yet. Go to <strong>Settings</strong> to manage components.' +
                '<div style="margin-top:1rem;">' +
                  '<button onclick="window.ddNavTo && window.ddNavTo(\'departmentSettings\')" style="padding:0.5rem 1rem;background:var(--dd-accent);color:#fff;border:none;border-radius:8px;font-size:0.8125rem;font-weight:600;cursor:pointer;font-family:\'Outfit\',sans-serif;">' +
                    '<i class="fa fa-cog" style="margin-right:0.35rem;"></i> Open Settings' +
                  '</button>' +
                '</div>'
              );
            } else {
              $emptyAction.html(
                'This department doesn\'t have any components enabled yet.<br>' +
                'Ask a community admin to enable components from <strong>Settings</strong>.'
              );
            }
          }

          // Find this department in the community and check if it's judicial
          var departments = community.departments || [];
          var isJudicial = false;
          for (var i = 0; i < departments.length; i++) {
            if (departments[i]._id === departmentId) {
              var tplName = (departments[i].template && departments[i].template.name || '').toLowerCase();
              isJudicial = tplName === 'judicial';
              break;
            }
          }
          if (!isJudicial) return;

          var mode = community.warrantApprovalMode || 'auto-approve';
          if (mode === 'require-judge') return;

          var modeLabel = mode === 'random'
            ? 'Random (auto-approves ~' + (community.warrantRandomApprovalRate || 70) + '% of warrants)'
            : 'Auto-Approve (all warrants are approved instantly)';

          var $banner = $(
            '<div class="dd-warrant-mode-banner dd-animate-in">' +
              '<i class="fa fa-exclamation-triangle"></i>' +
              '<div>' +
                '<strong>Warrant approval is set to: ' + modeLabel + '</strong><br>' +
                'Warrants are not being routed to judges for review. To require judicial approval, have a community admin go to ' +
                '<strong>Community Settings &rarr; General Settings</strong>, scroll down to the ' +
                '<strong>Judicial</strong> section, and select <strong>Require Judge</strong>.' +
              '</div>' +
            '</div>'
          );

          var $statsRow = $('#dd-stats-row');
          if ($statsRow.length) {
            $statsRow.after($banner);
          }
        }
      });
    }

    // ── Navigation ──
    function ddNavTo(panel) {
      // Update sidebar
      $('.dd-nav-item').removeClass('active');
      if (panel === 'overview') {
        $('.dd-nav-item[data-panel="overview"]').addClass('active');
      } else {
        $('.dd-nav-item[data-panel="' + panel + '"]').addClass('active');
      }

      // Update topbar title
      if (panel === 'overview') {
        $('#dd-topbar-title').text('Overview');
      } else if (componentRegistry[panel]) {
        $('#dd-topbar-title').text(componentRegistry[panel].label);
      }

      // All content lives inside #dd-panel-overview.
      // In overview mode: show stats + all cards.
      // In focus mode: hide stats, show only the target card full-width.
      var $overview = $('#dd-panel-overview');
      $overview.show();

      var $statsRow = $('#dd-stats-row');
      var $warrantBanner = $('.dd-warrant-mode-banner');
      var $grid = $overview.find('.dd-grid');
      var $allCards = $grid.children('.dd-card');

      var $rankWrap = $('#dd-rank-wrap');

      if (panel === 'overview') {
        // Show everything except overview-hidden components
        $statsRow.show();
        $rankWrap.show();
        $warrantBanner.show();
        $allCards.each(function() {
          var $c = $(this);
          $c.toggle(!$c.hasClass('dd-overview-hidden'));
        });
        // Restore original grid classes
        $allCards.each(function() {
          var $c = $(this);
          var orig = $c.data('orig-grid-class');
          if (orig !== undefined) {
            if (orig) {
              $c.addClass(orig);
            } else {
              $c.removeClass('dd-grid-full');
            }
            $c.removeData('orig-grid-class');
          }
        });
      } else {
        // Focus on one component: hide stats, rank, hide other cards, make target full-width
        $statsRow.hide();
        $rankWrap.hide();
        $warrantBanner.hide();
        $allCards.hide();

        var $target = $('#dd-component-' + panel);
        if ($target.length) {
          // Save original grid class so we can restore in overview mode
          if ($target.data('orig-grid-class') === undefined) {
            $target.data('orig-grid-class', $target.hasClass('dd-grid-full') ? 'dd-grid-full' : '');
          }
          $target.addClass('dd-grid-full').show();
        }
      }

      // Update URL hash for bookmarking and refresh persistence
      if (!ddNavTo._fromPopState && window.location.hash !== '#' + panel) {
        history.pushState({ panel: panel }, '', '#' + panel);
      }
      ddNavTo._fromPopState = false;

      // Close mobile sidebar and restore hamburger
      $('.dd-sidebar').removeClass('open');
      $('#dd-sidebar-open').css('display', '');

      // Scroll to top of content area
      var $content = $('#dd-content');
      if ($content.length) $content.scrollTop(0);
    }
    window.ddNavTo = ddNavTo;

    // Handle browser back/forward
    window.addEventListener('popstate', function() {
      var hash = window.location.hash.replace('#', '') || 'overview';
      if (hash === 'overview' || (componentRegistry[hash] && enabledComponents[hash])) {
        ddNavTo._fromPopState = true;
        ddNavTo(hash);
      }
    });

    function ddRefresh() {
      Object.keys(componentRegistry).forEach(function(key) {
        if (enabledComponents[key] && componentRegistry[key].init) {
          componentRegistry[key].init();
        }
      });
      ddToast('Dashboard refreshed', 'success');
    }
    window.ddRefresh = ddRefresh;

    function ddSwitchToClassic() {
      var btn = document.getElementById('dd-switch-classic');
      if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa fa-spinner fa-spin" style="font-size:0.625rem;"></i> Switching...'; }
      var cfg = window.ddConfig || {};
      $.ajax({
        url: cfg.API_URL + '/api/v1/user-preferences/' + encodeURIComponent(cfg.userId),
        method: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify({ betaCivDashboard: false, userId: cfg.userId }),
        complete: function() {
          window.location.href = '/civ-dashboard' + window.location.search;
        }
      });
    }
    window.ddSwitchToClassic = ddSwitchToClassic;

    // ══════════════════════════════════════════
    //  WARRANT REVIEW COMPONENT
    // ══════════════════════════════════════════
    function renderWarrantsPanel(key) {
      return '<div class="dd-card-header">' +
          '<div class="dd-card-header-left">' +
            '<div class="dd-card-icon" style="background:rgba(139,92,246,0.15);color:var(--dd-accent);"><i class="fa fa-gavel"></i></div>' +
            '<div><h3 class="dd-card-title">Pending Warrants</h3><p class="dd-card-subtitle">Awaiting judicial review</p></div>' +
          '</div>' +
          '<span class="dd-nav-badge dd-warrant-header-count" style="display:none;">0</span>' +
        '</div>' +
        '<div class="dd-card-body">' +
          '<div id="dd-warrants-loading" class="dd-spinner"></div>' +
          '<div id="dd-warrants-empty" class="dd-empty" style="display:none;">' +
            '<div class="dd-empty-icon-wrap"><i class="fa fa-check"></i></div>' +
            '<p class="dd-empty-title">All clear</p>' +
            '<p class="dd-empty-sub">No pending warrants to review</p>' +
          '</div>' +
          '<div id="dd-warrants-list" class="dd-warrant-list"></div>' +
        '</div>';
    }

    function loadPendingWarrants() {
      if (!communityId) return;
      // Show loading in all instances (overview + focused)
      $('.dd-warrant-list').empty();
      $('[id$="-warrants-loading"]').show();
      $('[id$="-warrants-empty"]').hide();

      $.ajax({
        url: API_URL + '/api/v1/warrants/pending/community/' + communityId + '?limit=50&page=0',
        method: 'GET',
        success: function(result) {
          pendingWarrants = result.data || [];
          renderWarrantsList();
          updateWarrantCount();
        },
        error: function() {
          $('[id$="-warrants-loading"]').hide();
          $('[id$="-warrants-empty"]').show().find('.dd-empty-title').text('Unable to load warrants');
        }
      });
    }

    function renderWarrantsList() {
      $('[id$="-warrants-loading"]').hide();
      var $lists = $('.dd-warrant-list');
      $lists.empty();

      if (pendingWarrants.length === 0) {
        $('[id$="-warrants-empty"]').show();
        return;
      }
      $('[id$="-warrants-empty"]').hide();

      pendingWarrants.forEach(function(w, i) {
        var d = w.warrant || {};
        var typeClass = d.warrantType || 'arrest';
        var charges = (d.charges || []).join(', ') || 'No charges listed';
        var date = formatDate(d.createdAt);
        var isExpanded = expandedWarrantId === w._id;

        var html = '<div class="dd-warrant-item' + (isExpanded ? ' expanded' : '') + '" data-id="' + w._id + '" style="animation-delay:' + (i * 0.04) + 's">' +
          '<div class="dd-warrant-summary" onclick="ddToggleWarrant(\'' + w._id + '\')">' +
            '<div class="dd-warrant-type-indicator ' + typeClass + '"></div>' +
            '<div class="dd-warrant-info">' +
              '<p class="dd-warrant-name">' + esc(d.accusedFirstName || '') + ' ' + esc(d.accusedLastName || '') + '</p>' +
              '<div class="dd-warrant-meta">' +
                '<span class="dd-badge dd-badge-' + typeClass + '">' + esc(typeClass) + '</span>' +
              '</div>' +
              '<p class="dd-warrant-charges">' + esc(charges) + '</p>' +
              '<div class="dd-warrant-footer-meta">' +
                '<span><i class="fa fa-user"></i>' + esc(d.requestingOfficerName || 'Unknown') + '</span>' +
                '<span><i class="fa fa-calendar"></i>' + date + '</span>' +
              '</div>' +
            '</div>' +
            '<i class="fa fa-chevron-down dd-warrant-expand-icon"></i>' +
          '</div>' +
          '<div class="dd-warrant-detail">' +
            '<div class="dd-warrant-detail-inner">' +
              '<div class="dd-detail-section">' +
                '<div class="dd-detail-label">Probable Cause</div>' +
                '<p class="dd-detail-value">' + esc(d.probableCause || 'No probable cause provided.') + '</p>' +
              '</div>' +
              (Array.isArray(d.charges) && d.charges.length > 0 ?
                '<div class="dd-detail-section">' +
                  '<div class="dd-detail-label">Charges</div>' +
                  '<ul class="dd-detail-charges-list">' + d.charges.map(function(c) { return '<li>' + esc(c) + '</li>'; }).join('') + '</ul>' +
                '</div>' : '') +
              (d.warrantType === 'search' && d.searchLocation ?
                '<div class="dd-detail-section">' +
                  '<div class="dd-detail-label">Search Location</div>' +
                  '<p class="dd-detail-value">' + esc(d.searchLocation) + '</p>' +
                '</div>' : '') +
              '<div class="dd-detail-section">' +
                '<div class="dd-detail-label">Requesting Officer</div>' +
                '<p class="dd-detail-value">' + esc(d.requestingOfficerName || 'Unknown') + '</p>' +
              '</div>' +
              '<div class="dd-judge-form">' +
                '<div class="dd-detail-label" style="margin-bottom:0.5rem;">Judge Notes</div>' +
                '<textarea class="dd-judge-textarea" id="dd-notes-' + w._id + '" placeholder="Enter your notes (optional)..."></textarea>' +
                '<div class="dd-judge-actions">' +
                  '<button class="dd-btn dd-btn-approve" onclick="ddReviewWarrant(\'' + w._id + '\', true)">' +
                    '<i class="fa fa-check-circle"></i> Approve' +
                  '</button>' +
                  '<button class="dd-btn dd-btn-deny" onclick="ddReviewWarrant(\'' + w._id + '\', false)">' +
                    '<i class="fa fa-times-circle"></i> Deny' +
                  '</button>' +
                  '<button class="dd-btn dd-btn-deny" onclick="ddDeleteWarrant(\'' + w._id + '\',\'' + esc((d.accusedFirstName || '') + ' ' + (d.accusedLastName || '')).trim() + '\')" style="margin-left:auto;">' +
                    '<i class="fa fa-trash"></i> Delete' +
                  '</button>' +
                '</div>' +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>';

        $lists.append(html);
      });
    }

    function updateWarrantCount() {
      var count = pendingWarrants.length;
      var $badges = $('#dd-warrant-count, .dd-warrant-header-count');
      if (count > 0) {
        $badges.text(count).show();
      } else {
        $badges.hide();
      }
      // Update stats
      $('#dd-stat-pending').text(count);
      loadWarrantStats();
    }

    function loadWarrantStats() {
      if (!communityId) return;
      var base = API_URL + '/api/v2/warrants/community/' + communityId + '?limit=1&page=0';
      // Fetch total, approved, and denied counts in parallel
      $.ajax({
        url: base,
        method: 'GET',
        success: function(result) {
          $('#dd-stat-total').text(result.totalCount || 0);
        },
        error: function() { $('#dd-stat-total').text('—'); }
      });
      $.ajax({
        url: base + '&status=approved',
        method: 'GET',
        success: function(result) {
          $('#dd-stat-approved').text(result.totalCount || 0);
        },
        error: function() { $('#dd-stat-approved').text('—'); }
      });
      $.ajax({
        url: base + '&status=denied',
        method: 'GET',
        success: function(result) {
          $('#dd-stat-denied').text(result.totalCount || 0);
        },
        error: function() { $('#dd-stat-denied').text('—'); }
      });
    }

    function loadRecordsStats() {
      if (!userId) return;
      // Lightweight v2 calls (limit=1) just to get totalCount
      if ($('#dd-stat-civs').length) {
        $.ajax({
          url: API_URL + '/api/v2/civilians/user/' + userId + '?limit=1&page=0&active_community_id=' + communityId,
          method: 'GET',
          success: function(res) { $('#dd-stat-civs').text(res.totalCount || 0); },
          error: function() { $('#dd-stat-civs').text('—'); }
        });
      }
      if ($('#dd-stat-vehs').length) {
        $.ajax({
          url: API_URL + '/api/v2/vehicles/user/' + userId + '?limit=1&page=0&active_community_id=' + communityId,
          method: 'GET',
          success: function(res) { $('#dd-stat-vehs').text(res.totalCount || 0); },
          error: function() { $('#dd-stat-vehs').text('—'); }
        });
      }
      if ($('#dd-stat-firearms').length) {
        $.ajax({
          url: API_URL + '/api/v2/firearms/user/' + userId + '?limit=1&page=0&active_community_id=' + communityId,
          method: 'GET',
          success: function(res) { $('#dd-stat-firearms').text(res.totalCount || 0); },
          error: function() { $('#dd-stat-firearms').text('—'); }
        });
      }
    }

    window.ddToggleWarrant = function(id) {
      expandedWarrantId = (expandedWarrantId === id) ? null : id;
      $('.dd-warrant-item').each(function() {
        if ($(this).data('id') === id) {
          $(this).toggleClass('expanded');
        } else {
          $(this).removeClass('expanded');
        }
      });
    };

    window.ddDeleteWarrant = function(warrantId, accusedName) {
      ddModal({
        type: 'danger',
        icon: 'fa-trash',
        title: 'Delete Warrant',
        message: 'Permanently delete the warrant for <strong>' + esc(accusedName || 'this individual') + '</strong>? This cannot be undone.',
        confirmText: 'Delete',
        onConfirm: function() {
          $.ajax({
            url: API_URL + '/api/v1/warrant/' + warrantId,
            method: 'DELETE',
            success: function() {
              ddToast('Warrant deleted successfully', 'success');
              expandedWarrantId = null;
              expandedAllWarrantId = null;
              loadPendingWarrants();
              loadAllWarrants();
            },
            error: function() {
              ddToast('Failed to delete warrant', 'error');
            }
          });
        }
      });
    };

    window.ddReviewWarrant = function(warrantId, approved) {
      var notes = $('#dd-notes-' + warrantId).val() || '';
      var $btns = $('.dd-warrant-item[data-id="' + warrantId + '"] .dd-btn');
      $btns.prop('disabled', true);

      $.ajax({
        url: API_URL + '/api/v1/warrant/' + warrantId + '/review',
        method: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify({
          approved: approved,
          judgeNotes: notes,
          judgeID: userId,
          judgeName: userName
        }),
        success: function() {
          ddToast('Warrant ' + (approved ? 'approved' : 'denied') + ' successfully', 'success');
          expandedWarrantId = null;
          loadPendingWarrants();
        },
        error: function() {
          ddToast('Failed to review warrant', 'error');
          $btns.prop('disabled', false);
        }
      });
    };

