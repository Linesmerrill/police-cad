        '<div class="dd-cc-modal">' +
          '<div class="dd-cc-modal-head">' +
            '<div class="dd-cc-modal-title"><i class="fa fa-gavel" style="color:var(--dd-accent);margin-right:0.4rem;"></i> Create Court Session</div>' +
