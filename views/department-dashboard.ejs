    function loadSidebarDepartments() {
      if (!communityId) return;
      var encodedCommunityId = btoa(communityId).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');

      $.ajax({
        url: API_URL + '/api/v1/community/' + communityId + '/departments',
        method: 'GET',
        success: function(data) {
          var departments = (data && data.departments) || [];
          renderSidebarDepartments(departments, encodedCommunityId);
        },
        error: function() {
          // Silently fail — sidebar just won't show departments
        }
      });
    }

    function renderSidebarDepartments(departments, encodedCommunityId) {
      var $list = $('#dd-dept-list');
      $list.empty();

      // Access checks (same logic as departments.js sidebar)
      var currentUserId = dbUser._id || '';
      var isOwner = (dbUser.user?.lastAccessedCommunity?.ownerID || '') === currentUserId;
      var userRole = dbUser.user?.lastAccessedCommunity?.role;
      var isAdmin = userRole && userRole.admin === true;

      departments.forEach(function(dept) {
        var template = (dept.template && dept.template.name || '').toLowerCase();
        var name = dept.name || 'Unknown';
        var deptId = dept._id;
        if (!deptId || !template) return;

        var config = deptTypeConfig[template] || { icon: 'fa-building', color: '#6b7280', route: null };
        var isCurrent = deptId === departmentId;

        // Check membership
        var members = Array.isArray(dept.members) ? dept.members : [];
        var userMembership = null;
        for (var i = 0; i < members.length; i++) {
          if ((members[i].userID || members[i]._id) === currentUserId) {
            userMembership = members[i];
            break;
          }
        }
        var isApprovedMember = userMembership && userMembership.status === 'approved';
        var isPendingMember = userMembership && userMembership.status === 'pending';
        var isPublicDept = dept.approvalRequired === false;
        var canAccess = isOwner || isAdmin || isPublicDept || isApprovedMember;

        // Build URL
        var encodedDeptId = btoa(deptId).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
        var params = '?dept=' + encodeURIComponent(name) + '&d=' + encodedDeptId + '&c=' + encodedCommunityId;
        var href = '#';

        // Determine route and whether it needs a form POST
        var useFormPost = false;
        var redirect = '';
        if (canAccess) {
          if (template === 'civilian') {
            href = '/civ-dashboard' + params;
          } else if (template === 'judicial') {
            href = '/department-dashboard' + params;
          } else if (['police', 'dispatch', 'fire', 'ems'].indexOf(template) !== -1) {
            useFormPost = true;
            if (template === 'police') {
              redirect = '/police-dashboard' + params;
            } else if (template === 'dispatch') {
              redirect = '/dispatch-dashboard' + params;
            } else {
              redirect = '/ems-dashboard' + params;
            }
          }
        }

        // Status icon for locked/pending
        var statusHtml = '';
        if (!canAccess) {
          if (isPendingMember) {
            statusHtml = '<i class="fa fa-clock" style="color:#3b82f6;font-size:0.625rem;flex-shrink:0;" title="Request pending"></i>';
          } else {
            statusHtml = '<i class="fa fa-lock" style="color:#fbbf24;font-size:0.625rem;flex-shrink:0;" title="No access"></i>';
          }
        }

        var classes = 'dd-dept-item';
        if (isCurrent) classes += ' current';
        if (!canAccess) classes += ' locked';

        var communityUrl = '/community/' + encodedCommunityId + '#departments-section';
        var safeName = name.replace(/\\/g, '\\\\').replace(/'/g, "\\'");

        var innerHtml =
          '<i class="fa ' + config.icon + '" style="color:' + config.color + ';' + (!canAccess ? 'opacity:0.4;' : '') + '"></i>' +
          '<span class="dd-dept-name" style="' + (!canAccess ? 'opacity:0.4;' : '') + '">' + esc(name) + '</span>' +
          (statusHtml || '<span class="dd-dept-badge" style="background:' + config.color + ';">' + esc(template) + '</span>');

        if (!canAccess) {
          var $item = $('<a class="' + classes + '" href="#" onclick="event.preventDefault(); ddShowAccessModal(\'' + safeName + '\', ' + !!isPendingMember + ', \'' + communityUrl + '\');">' + innerHtml + '</a>');
          $list.append($item);
        } else if (useFormPost) {
          var formId = 'dd-dept-form-' + deptId;
          var $item = $('<a class="' + classes + '" href="#" onclick="event.preventDefault(); document.getElementById(\'' + formId + '\').submit();">' + innerHtml + '</a>');
          var $form = $('<form id="' + formId + '" action="/select-department" method="POST" style="display:none;">' +
            '<input type="hidden" name="departmentId" value="' + deptId + '">' +
            '<input type="hidden" name="redirect" value="' + redirect + '">' +
            '</form>');
          $list.append($item);
          $list.append($form);
        } else {
          var $item = $('<a class="' + classes + '" href="' + href + '">' + innerHtml + '</a>');
          $list.append($item);
        }
      });
    }

    // ══════════════════════════════════════════
    //  UNIFIED MODAL SYSTEM
    // ══════════════════════════════════════════
    // Type configs: { accent (CSS color), iconBg, iconColor, confirmClass }
    var ddModalTypes = {
      danger:  { accent: 'var(--dd-red)',    iconBg: 'rgba(239,68,68,0.12)',   iconColor: '#fca5a5', btnClass: 'dd-modal-btn-danger' },
      warning: { accent: 'var(--dd-amber)',  iconBg: 'rgba(245,158,11,0.12)',  iconColor: '#fcd34d', btnClass: 'dd-modal-btn-warning' },
      info:    { accent: 'var(--dd-blue)',   iconBg: 'rgba(59,130,246,0.12)',   iconColor: '#93c5fd', btnClass: 'dd-modal-btn-primary' },
      confirm: { accent: 'var(--dd-accent)', iconBg: 'rgba(139,92,246,0.12)',  iconColor: '#c4b5fd', btnClass: 'dd-modal-btn-primary' },
      success: { accent: 'var(--dd-green)',  iconBg: 'rgba(34,197,94,0.12)',   iconColor: '#86efac', btnClass: 'dd-modal-btn-primary' }
    };

    var ddModalCallback = null;

    /**
     * Show a unified modal.
     * @param {Object} opts
     * @param {string} opts.type      - 'danger' | 'warning' | 'info' | 'confirm' | 'success'
     * @param {string} opts.icon      - FontAwesome class, e.g. 'fa-trash'
     * @param {string} opts.title     - Modal title text
     * @param {string} opts.message   - Main message (supports HTML)
     * @param {string} [opts.detail]  - Smaller subtext below message
     * @param {string} [opts.confirmText] - Confirm button label (default: 'Confirm')
     * @param {string} [opts.cancelText]  - Cancel button label (default: 'Cancel')
     * @param {Function} [opts.onConfirm] - Called when confirm is clicked
     * @param {Function} [opts.onCancel]  - Called when cancel/close is clicked
     * @param {Array}  [opts.buttons] - Custom buttons array: [{ label, class, href, onClick }]
     */
    function ddModal(opts) {
      var type = ddModalTypes[opts.type] || ddModalTypes.confirm;

      // Set accent color on the modal
      $('#dd-modal').css('--dd-modal-accent', type.accent);

      // Title
      $('#dd-modal-title').html('<i class="fa ' + (opts.icon || 'fa-info-circle') + '" style="color:' + type.iconColor + ';"></i> ' + esc(opts.title || 'Confirm'));

      // Icon
      $('#dd-modal-icon')
        .css('background', type.iconBg)
        .html('<i class="fa ' + (opts.icon || 'fa-info-circle') + '" style="color:' + type.iconColor + ';font-size:1.375rem;"></i>');

      // Message & detail
      $('#dd-modal-msg').html(opts.message || '');
      if (opts.detail) {
        $('#dd-modal-detail').html(opts.detail).show();
      } else {
        $('#dd-modal-detail').hide();
      }

      // Build footer buttons
      var $footer = $('#dd-modal-footer');
      $footer.empty();

      if (opts.buttons) {
        // Custom buttons
        opts.buttons.forEach(function(btn) {
          if (btn.href) {
            var $a = $('<a class="dd-modal-btn ' + (btn.class || 'dd-modal-btn-secondary') + '" href="' + btn.href + '"></a>');
            if (btn.icon) $a.append('<i class="fa ' + btn.icon + '"></i> ');
            $a.append(btn.label || 'OK');
            $footer.append($a);
          } else {
            var $b = $('<button class="dd-modal-btn ' + (btn.class || 'dd-modal-btn-secondary') + '"></button>');
            if (btn.icon) $b.append('<i class="fa ' + btn.icon + '"></i> ');
            $b.append(btn.label || 'OK');
            $b.on('click', function() {
              ddCloseModal();
              if (btn.onClick) btn.onClick();
            });
            $footer.append($b);
          }
        });
      } else {
        // Default: Cancel + Confirm
        var $cancel = $('<button class="dd-modal-btn dd-modal-btn-secondary"></button>').text(opts.cancelText || 'Cancel');
        $cancel.on('click', function() {
          ddCloseModal();
          if (opts.onCancel) opts.onCancel();
        });

        var $confirm = $('<button class="dd-modal-btn ' + type.btnClass + '"></button>');
        if (opts.confirmIcon) $confirm.append('<i class="fa ' + opts.confirmIcon + '"></i> ');
        $confirm.append(opts.confirmText || 'Confirm');
        $confirm.on('click', function() {
          ddCloseModal();
          if (opts.onConfirm) opts.onConfirm();
        });

        $footer.append($cancel).append($confirm);
      }

      // Store callback ref for Escape handling
      ddModalCallback = opts.onCancel || null;

      // Show
      $('#dd-modal-overlay').addClass('visible');
    }
    window.ddModal = ddModal;

    function ddCloseModal() {
      $('#dd-modal-overlay').removeClass('visible');
      ddModalCallback = null;
    }
    window.ddCloseModal = ddCloseModal;

    // Close button
    $(document).on('click', '#dd-modal-close', function() {
      var cb = ddModalCallback;
      ddCloseModal();
      if (cb) cb();
    });

    // Close on overlay click
    $(document).on('click', '#dd-modal-overlay', function(e) {
      if (e.target === this) {
        var cb = ddModalCallback;
        ddCloseModal();
        if (cb) cb();
      }
    });

    // Close on Escape
    $(document).on('keydown', function(e) {
      if (e.key === 'Escape' && $('#dd-modal-overlay').hasClass('visible')) {
        var cb = ddModalCallback;
        ddCloseModal();
        if (cb) cb();
      }
    });

    // ── Department Access Modal (uses unified system) ──
    function ddShowAccessModal(deptName, isPending, communityUrl) {
      if (isPending) {
        ddModal({
          type: 'info',
          icon: 'fa-clock',
          title: 'Request Pending',
          message: 'Your request to join <strong>' + esc(deptName) + '</strong> is pending approval.',
          detail: 'An administrator will review your request soon.',
          buttons: [
            { label: 'Close', class: 'dd-modal-btn-secondary', onClick: function() {} },
            { label: 'Go to Community', class: 'dd-modal-btn-primary', icon: 'fa-external-link-alt', href: communityUrl }
          ]
        });
      } else {
        ddModal({
          type: 'warning',
          icon: 'fa-lock',
          title: 'Access Restricted',
          message: 'You don\'t have access to the <strong>' + esc(deptName) + '</strong> department.',
          detail: 'You can request to join from the community details page.',
          buttons: [
            { label: 'Close', class: 'dd-modal-btn-secondary', onClick: function() {} },
            { label: 'Go to Community', class: 'dd-modal-btn-warning', icon: 'fa-external-link-alt', href: communityUrl }
          ]
        });
      }
    }
    window.ddShowAccessModal = ddShowAccessModal;

    // ── Hide a component entirely (card + nav) ──
    function hideComponent(key) {
      $('#dd-component-' + key).remove();
      $('#dd-component-focus-' + key).closest('[id^="dd-panel-"]').remove();
      $('.dd-nav-item[data-panel="' + key + '"]').remove();
      delete enabledComponents[key];

      // Reflow grid: if only one non-full-width card remains, make it full width
      var $grid = $('#dd-panel-overview .dd-grid');
      var $halfCards = $grid.children('.dd-card').not('.dd-grid-full');
      if ($halfCards.length === 1) {
        $halfCards.addClass('dd-grid-full');
      }
    }

    // ── Utilities ──
    function formatDate(dateStr) {
      if (!dateStr) return 'N/A';
      var d = new Date(dateStr);
      if (isNaN(d) || d.getFullYear() <= 1970) return 'N/A';
      return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function esc(str) {
      if (!str) return '';
      var div = document.createElement('div');
      div.appendChild(document.createTextNode(str));
      return div.innerHTML;
    }

    function ddToast(msg, type) {
      var $t = $('#dd-toast');
      $t.text(msg).removeClass('success error visible').addClass(type);
      setTimeout(function() { $t.addClass('visible'); }, 10);
      setTimeout(function() { $t.removeClass('visible'); }, 3000);
    }
    window.ddToast = ddToast;

    function showError(msg) {
      $('#dd-loading').hide();
      $('#dd-panels').html(
        '<div class="dd-empty" style="padding-top:6rem;">' +
          '<i class="fa fa-exclamation-triangle"></i>' +
          '<p class="dd-empty-title">' + esc(msg) + '</p>' +
        '</div>'
      ).show();
    }

  })();
  </script>
</body>
</html>
