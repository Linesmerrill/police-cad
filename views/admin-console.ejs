      // User Actions
      function viewUserDetails(userId) {
        $('#userModalTitle').text('Loading User Details...');
        $('#userModalBody').html('<div class="loading">Loading...</div>');
        $('#userModal').modal('show');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/users/${userId}`,
          method: 'GET',
          headers: { 'Authorization': API_TOKEN },
          success: function(data) {
            displayUserDetails(data.user);
          },
          error: function(xhr) {
            $('#userModalBody').html(`<div class="error">Error loading user: ${xhr.responseJSON?.error || 'Unknown error'}</div>`);
          }
        });
      }
      
      function displayUserDetails(user) {
        // Convert MongoDB ObjectId to creation date
        const createdAt = user._id ? new Date(parseInt(user._id.toString().substring(0, 8), 16) * 1000) : new Date(user.createdAt);
        
        // Handle password reset status
        let resetStatus = 'No reset requested';
        if (user.resetPasswordExpires) {
          const resetDate = new Date(user.resetPasswordExpires);
          const now = new Date();
          if (resetDate > now) {
            resetStatus = `Reset requested on ${resetDate.toLocaleDateString()} (expires ${resetDate.toLocaleString()})`;
          } else {
            resetStatus = `Reset requested on ${resetDate.toLocaleDateString()} (EXPIRED)`;
          }
        }
        
        $('#userModalTitle').text(`User: ${user.email || user.username}`);
        $('#userModalBody').html(`
          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Email</div>
              <div class="info-value">${user.email || 'N/A'}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Username</div>
              <div class="info-value">${user.username || 'N/A'}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Status</div>
              <div class="info-value">
                <span class="status-badge ${user.active ? 'status-active' : 'status-inactive'}">
                  ${user.active ? 'Active' : 'Inactive'}
                </span>
              </div>
            </div>
            <div class="info-item">
              <div class="info-label">Created</div>
              <div class="info-value">${createdAt.toLocaleDateString()}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Password Reset Status</div>
              <div class="info-value">${resetStatus}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Communities</div>
              <div class="info-value">${user.communities?.length || 0}</div>
            </div>
          </div>
          
          <div style="margin-top: 2rem;">
            <h5>Communities</h5>
            ${user.communities && user.communities.length > 0 ? user.communities.map(c => `
              <div style="background: #11131a; padding: 1rem; border-radius: 8px; margin: 0.5rem 0; border: 1px solid #2a2d45;">
                <strong>${c.name}</strong> - ${c.role || 'Member'}
                ${c.department ? `<br><small>Department: ${c.department}</small>` : ''}
              </div>
            `).join('') : '<p>No communities</p>'}
          </div>
        `);
      }
      
      function sendUserReset(userEmail) {
        showConfirmModal(
          'Send Password Reset',
          `Are you sure you want to send a password reset email to <strong>${userEmail}</strong>?`,
          function() {
            // Find and update the button to show loading state
            const resetButton = $(`button[onclick*="sendUserReset('${userEmail}')"]`);
            const originalText = resetButton.html();
            resetButton.html('<i class="fas fa-spinner fa-spin"></i> Sending...');
            resetButton.prop('disabled', true);
            
            $.ajax({
              url: '/forgot-password',
              method: 'POST',
              data: { email: userEmail },
              success: function(data) {
                showInfoModal('Success', 'Password reset email sent successfully to the user.');
              },
              error: function(xhr) {
                showInfoModal('Error', `Failed to send password reset email: ${xhr.responseText || 'Unknown error'}`);
              },
              complete: function() {
                // Restore button to original state
                resetButton.html(originalText);
                resetButton.prop('disabled', false);
              }
            });
          }
        );
      }
      
      function createTempPassword(userId) {
        showConfirmModal(
          'Create Temporary Password',
          'Are you sure you want to create a temporary password for this user? This will replace their current password.',
          function() {
            // Find and update the button to show loading state
            const tempButton = $(`button[onclick*="createTempPassword('${userId}')"]`);
            const originalText = tempButton.html();
            tempButton.html('<i class="fas fa-spinner fa-spin"></i> Creating...');
            tempButton.prop('disabled', true);
            
            // Store button reference for use in callbacks
            const buttonRef = tempButton;
            const textRef = originalText;
            
            $.ajax({
              url: `${API_BASE}/api/v1/admin/users/${userId}/temp-password`,
              method: 'POST',
              headers: { 'Authorization': API_TOKEN },
              success: function(data) {
                const expiresAt = data.expiresAt ? new Date(data.expiresAt).toLocaleString() : new Date(Date.now() + 24 * 60 * 60 * 1000).toLocaleString();
                showInfoModal(
                  'Temporary Password Created', 
                  `Temporary password created successfully!<br><br><strong>Password:</strong> ${data.tempPassword} <button class="btn btn-sm" onclick="copyToClipboard('${data.tempPassword}', event)" style="margin-left: 8px; padding: 4px 12px; font-size: 12px; background: #4f46e5; color: white; border: 1px solid #4f46e5; border-radius: 6px;"><i class="fas fa-copy"></i> Copy</button><br><strong>Expires:</strong> ${expiresAt}`
                );
              },
              error: function(xhr) {
                showInfoModal('Error', `Failed to create temporary password: ${xhr.responseJSON?.error || 'Unknown error'}`);
              },
              complete: function() {
                // Restore button to original state
                buttonRef.html(textRef);
                buttonRef.prop('disabled', false);
              }
            });
          }
        );
      }
      
