                    <i class="fas fa-users"></i> Members
                  </button>
                  <button class="btn btn-secondary btn-sm" onclick="viewCommunityRoles('${community.id}')">
                    <i class="fas fa-user-tag"></i> Roles
                  </button>
                </div>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <div class="info-label">Owner</div>
                  <div class="info-value">
                    ${(() => {
                      if (community.owner) {
                        if (community.owner.username && community.owner.email) {
                          return `${community.owner.username} (${community.owner.email})`;
                        } else if (community.owner.username) {
                          return community.owner.username;
                        } else if (community.owner.email) {
                          return community.owner.email;
                        }
                      }
                      return 'Unknown';
                    })()}
                  </div>
                </div>
                <div class="info-item">
                  <div class="info-label">Members</div>
                  <div class="info-value">${community.memberCount || 0}</div>
