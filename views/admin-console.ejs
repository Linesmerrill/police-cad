      // =====================================================
      // SUBSCRIPTIONS PANEL
      // User-centric dashboard: search by email → live RC + Stripe
      // snapshot → mismatch detection → 1-button DB sync.
      // =====================================================
        (function () {
          /* ============================================================
             Subscriptions panel — user-centric workflow.
             Wired to:
               GET  /api/v1/admin/subscription/users?q=...
               GET  /api/v1/admin/subscription/users/{id}
               POST /api/v1/admin/subscription/users/{id}/sync
             ============================================================ */

          let _debounceTimer = null;
          let _activeUserId  = null;
          let _activeReq     = 0;
          let _lastDetail    = null;
          let _paymentsExpanded = false;

          /* ------------------- utilities ------------------- */

          // Match the rest of the admin-console fetch pattern: no
          // `credentials: 'include'`. Adding credentials forces a CORS
          // preflight that requires the API to echo our exact origin in
          // Access-Control-Allow-Origin AND set
          // Access-Control-Allow-Credentials: true — which our admin CORS
          // config doesn't currently do. The result is a browser-side
          // "Failed to fetch" before the request even leaves.
          function api(path, opts) {
            return fetch(`${API_BASE}${path}`, Object.assign(
              { headers: { 'Accept': 'application/json' } },
              opts || {}
            ));
          }

          function debounce(fn, wait) {
            return function () {
              const args = arguments, ctx = this;
              clearTimeout(_debounceTimer);
              _debounceTimer = setTimeout(() => fn.apply(ctx, args), wait);
            };
          }

          function timeAgo(iso) {
            if (!iso) return '';
            const d = new Date(iso);
            const s = Math.round((Date.now() - d.getTime()) / 1000);
            if (s < 60)        return s + 's';
            const m = Math.round(s / 60);
            if (m < 60)        return m + 'm';
            const h = Math.round(m / 60);
            if (h < 24)        return h + 'h';
            const days = Math.round(h / 24);
            if (days < 30)     return days + 'd';
            const months = Math.round(days / 30);
            if (months < 12)   return months + 'mo';
            return Math.round(months / 12) + 'y';
          }

          function formatDate(iso) {
            if (!iso || iso === '0001-01-01T00:00:00Z') return '—';
            try {
              return new Date(iso).toLocaleDateString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric'
              });
            } catch (e) { return iso; }
          }

          function formatDateParts(iso) {
            if (!iso) return { day: '—', rest: '' };
            const d = new Date(iso);
            return {
              day: String(d.getDate()).padStart(2, '0'),
              rest: d.toLocaleDateString('en-US', { month: 'short' }) + ' ' + d.getFullYear(),
            };
          }

          function formatMonth(iso) {
            if (!iso) return '';
            return new Date(iso).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
          }

          function formatMoney(amount, currency) {
            if (amount == null) return '—';
            const cur = (currency || '').toUpperCase();
            const sym = cur === 'USD' || cur === '' ? '$' : '';
            return sym + Number(amount).toFixed(2);
          }

          /* ------------------- pills / marks ------------------- */

          function planPill(plan) {
            const p = (plan || 'free').toLowerCase();
            return `<span class="subs-pill subs-pill--${escapeHtml(p)}">${escapeHtml(p)}</span>`;
          }

          function activePill(active) {
            return active
              ? '<span class="subs-pill subs-pill--active"><i class="fas fa-circle" style="font-size:5px"></i>ACTIVE</span>'
              : '<span class="subs-pill subs-pill--inactive">FREE</span>';
          }

          function sourceMark(source) {
            if (source === 'stripe')     return '<span class="subs-source-mark subs-source-mark--stripe">S</span>';
            if (source === 'revenuecat') return '<span class="subs-source-mark subs-source-mark--revenuecat">R</span>';
            return '';
          }

          function rcLabel(s) {
            switch (s) {
              case 'ok':              return 'RC ok';
              case 'no_api_key':      return 'RC key missing';
              case 'user_not_found':  return 'RC: user unknown';
              case 'http_error':      return 'RC error';
              case 'parse_error':     return 'RC parse error';
              case 'no_user_id':      return 'RC: no user id';
              default:                return 'RC: ' + s;
            }
          }
          function stripeLabel(s) {
            switch (s) {
              case 'ok':              return 'Stripe ok';
              case 'no_customer_id':  return 'no Stripe customer';
              case 'http_error':      return 'Stripe error';
              default:                return 'Stripe: ' + s;
            }
          }

          /* ------------------- search ------------------- */

          async function runSearch(q) {
            const container = document.getElementById('subs-results');
            const titleEl   = document.getElementById('subs-results-title');
            const countEl   = document.getElementById('subs-results-count');
            if (!container) return;

            if (!q || q.length < 2) {
              titleEl.textContent = 'Search';
              countEl.textContent = '';
              container.innerHTML = `
                <div class="subs-results-state">
                  <div class="subs-empty-icon"><i class="fas fa-search"></i></div>
                  <div class="subs-empty-title">Find a customer</div>
                  <div class="subs-empty-body">Type at least 2 characters to search by email or username.</div>
                </div>`;
              return;
            }

            titleEl.textContent = 'Searching…';
            countEl.textContent = '';
            container.innerHTML = `
              <div class="subs-results-skel">
                ${'<div class="subs-skeleton"></div>'.repeat(5)}
              </div>`;

            try {
              const res  = await api(`/api/v1/admin/subscription/users?q=${encodeURIComponent(q)}`);
              if (!res.ok) throw new Error('HTTP ' + res.status);
              const body = await res.json();
              renderResults(body.data || [], q);
            } catch (err) {
              titleEl.textContent = 'Results';
              countEl.textContent = '';
              container.innerHTML = `
                <div class="subs-results-state">
                  <div class="subs-empty-icon subs-empty-icon--err"><i class="fas fa-exclamation"></i></div>
                  <div class="subs-empty-title">Search failed</div>
                  <div class="subs-empty-body">${escapeHtml(err.message || 'Unknown error')}</div>
                </div>`;
            }
          }

          function renderResults(items, q) {
            const container = document.getElementById('subs-results');
            const titleEl   = document.getElementById('subs-results-title');
            const countEl   = document.getElementById('subs-results-count');

            titleEl.textContent = q ? `“${q}”` : 'Results';
            countEl.textContent = items.length ? items.length + ' found' : '';

            if (!items.length) {
              container.innerHTML = `
                <div class="subs-results-state">
                  <div class="subs-empty-icon"><i class="fas fa-user-slash"></i></div>
                  <div class="subs-empty-title">No matches</div>
                  <div class="subs-empty-body">Try a different email or username.</div>
                </div>`;
              return;
            }

            container.innerHTML = items.map(u => `
              <div class="subs-result ${u.userId === _activeUserId ? 'is-active' : ''}"
                   data-uid="${escapeHtml(u.userId)}"
                   data-testid="subs-result">
                <div class="subs-result-row1">
                  <span class="subs-result-email" title="${escapeHtml(u.email || '')}">${escapeHtml(u.email || u.userId)}</span>
                  ${activePill(u.dbActive)}
                </div>
                <div class="subs-result-row2">
                  ${planPill(u.dbPlan)}
                  ${u.dbSource ? `<span class="subs-result-dot"></span><span>via ${escapeHtml(u.dbSource)}</span>` : ''}
                  ${u.lastEventAt ? `<span class="subs-result-ago">${escapeHtml(timeAgo(u.lastEventAt))}</span>` : ''}
                </div>
              </div>
            `).join('');

            container.querySelectorAll('.subs-result').forEach(el => {
              el.addEventListener('click', () => loadDetail(el.dataset.uid));
            });
          }

          /* ------------------- detail ------------------- */

          async function loadDetail(userId) {
            _activeUserId      = userId;
            _paymentsExpanded  = false;
            document.querySelectorAll('.subs-result').forEach(r => {
              r.classList.toggle('is-active', r.dataset.uid === userId);
            });

            const detail = document.getElementById('subs-detail');
            detail.innerHTML = renderDetailLoading();

            const reqId = ++_activeReq;

            try {
              const res  = await api(`/api/v1/admin/subscription/users/${encodeURIComponent(userId)}`);
              if (!res.ok) throw new Error('HTTP ' + res.status);
              const body = await res.json();
              if (reqId !== _activeReq) return; // stale
              _lastDetail = body;
              window._subsLastDetail = body;
              detail.innerHTML = renderDetail(body);
              wireDetailActions(body);
            } catch (err) {
              if (reqId !== _activeReq) return;
              detail.innerHTML = renderDetailError(err);
              const r = detail.querySelector('[data-retry]');
              if (r) r.addEventListener('click', () => loadDetail(userId));
            }
          }

          function renderDetailLoading() {
            return `
              <div class="subs-detail-state">
                <div class="subs-empty-icon subs-empty-icon--load"><i class="fas fa-spinner fa-spin"></i></div>
                <div class="subs-empty-title">Loading customer record…</div>
                <div class="subs-empty-body">Pulling live state from RevenueCat and Stripe.</div>
              </div>`;
          }

          function renderDetailError(err) {
            return `
              <div class="subs-detail-state">
                <div class="subs-empty-icon subs-empty-icon--err"><i class="fas fa-triangle-exclamation"></i></div>
                <div class="subs-empty-title">Failed to load</div>
                <div class="subs-empty-body">${escapeHtml(err.message || 'Unknown error')}</div>
                <button class="ac-btn" data-retry style="margin-top:1rem;">Retry</button>
              </div>`;
          }

          function renderDetail(d) {
            const initial = (d.user.email || d.user.id || '?').charAt(0).toUpperCase();
            const auth = d.authoritative || { status: 'none' };
            const mm   = d.mismatch || { hasMismatch: false };
            const payments = d.payments || [];

            // Inline styles below — the global cascade has been
            // overpowering even !important-flagged rules on these
            // children (likely a section/main-element collapse
            // somewhere upstream). Inline styles win over every
            // stylesheet rule short of inline !important, so the
            // detail spacing is now locked in here at the template.
            return `
              <div class="subs-detail-content" style="display:flex;flex-direction:column;gap:14px;margin:0;padding:0;">

                <header class="subs-user-head" style="margin:0;">
                  <div class="subs-user-identity">
                    <div class="subs-user-avatar">${escapeHtml(initial)}</div>
                    <div class="subs-user-meta">
                      <div class="subs-user-name">${escapeHtml(d.user.email || '(no email)')}</div>
                      <div class="subs-user-id">${escapeHtml(d.user.id)}${d.user.username ? ' · @' + escapeHtml(d.user.username) : ''}</div>
                    </div>
                  </div>
                  <div class="subs-user-actions">
                    <button class="subs-icon-btn" data-refresh title="Refresh from RC + Stripe">
                      <i class="fas fa-arrows-rotate"></i>
                    </button>
                  </div>
                </header>

                ${renderBanner(mm, auth)}
                ${renderComparison(d.user.subscription || {}, auth, mm)}
                ${renderTimeline(payments)}

              </div>`;
          }

          function renderBanner(mm, auth) {
            const expiresAt = auth.expiresAt ? new Date(auth.expiresAt) : null;
            const now = new Date();
            const stillInPeriod = expiresAt && expiresAt.getTime() > now.getTime();
            const cancelledButActive = auth.status === 'canceled' && stillInPeriod;
            const daysLeft = expiresAt
              ? Math.max(0, Math.ceil((expiresAt.getTime() - now.getTime()) / 86400000))
              : null;

            if (mm.hasMismatch) {
              const src = auth.source || 'authoritative source';
              return `
                <div class="subs-banner subs-banner--warn" style="margin:0 1.25rem;">
                  <div class="subs-banner-icon"><i class="fas fa-triangle-exclamation"></i></div>
                  <div class="subs-banner-body">
                    <div class="subs-banner-title">Database out of sync with ${escapeHtml(src)}</div>
                    <div class="subs-banner-sub">${escapeHtml(mm.summary || 'Apply the live state to MongoDB.')}</div>
                  </div>
                  <div>
                    <button class="subs-fix-btn" data-fix data-testid="subs-fix-btn">
                      <i class="fas fa-wand-magic-sparkles"></i>
                      <span>Fix in DB</span>
                    </button>
                  </div>
                </div>`;
            }

            let title, sub;
            if (cancelledButActive) {
              title = `Active — cancels in ${daysLeft} day${daysLeft === 1 ? '' : 's'}`;
              sub   = `${auth.plan || 'subscription'} via ${auth.source || '—'} · ends ${formatDate(auth.expiresAt)} (auto-renew off)`;
            } else if (auth.status === 'active') {
              title = `In sync — ${auth.plan || 'subscription'} active`;
              sub   = `Authoritative: ${auth.source || '—'}` +
                      (auth.expiresAt ? ` · renews ${formatDate(auth.expiresAt)} (${daysLeft}d)` : '');
            } else if (auth.status === 'none') {
              title = 'No active subscription';
              sub   = 'No record found in RevenueCat or Stripe for this user.';
            } else {
              title = `In sync — subscription ${auth.status}`;
              sub   = `Authoritative: ${auth.source || '—'}` +
                      (auth.expiresAt ? ` · period ended ${formatDate(auth.expiresAt)}` : '');
            }

            return `
              <div class="subs-banner subs-banner--ok" style="margin:0 1.25rem;">
                <div class="subs-banner-icon"><i class="fas fa-check"></i></div>
                <div class="subs-banner-body">
                  <div class="subs-banner-title">${escapeHtml(title)}</div>
                  <div class="subs-banner-sub">${escapeHtml(sub)}</div>
                </div>
              </div>`;
          }

          function renderComparison(dbSub, auth, mm) {
            const mmFields = new Set((mm.fields || []).map(f => f.field));

            const dbRows = [
              { key: 'Plan',         value: dbSub.plan || 'free',                 field: 'plan' },
              { key: 'Active',       value: dbSub.active ? 'true' : 'false',      field: 'active' },
              { key: 'Source',       value: dbSub.source || '—',                  field: 'source' },
              { key: 'Cycle',        value: dbSub.isAnnual ? 'annual' : 'monthly' },
              { key: 'Sub ID',       value: dbSub.id || '—',                      mono: true },
              { key: 'Stripe Cust',  value: dbSub.stripeCustomerId || '—',        mono: true },
              { key: 'Period End',   value: formatDate(dbSub.currentPeriodEnd || dbSub.expirationDate), field: 'periodEnd' },
              { key: 'Cancel At',    value: formatDate(dbSub.cancelAt),                                field: 'cancelAt' },
              { key: 'Created',      value: formatDate(dbSub.createdAt) },
              { key: 'Updated',      value: formatDate(dbSub.updatedAt) },
            ];

            const authRows = auth.status === 'none'
              ? [{ key: 'Status', value: 'no record found', dim: true }]
              : [
                  { key: 'Status',    value: auth.status || '—',         field: 'active' },
                  { key: 'Plan',      value: auth.plan || '—',           field: 'plan' },
                  { key: 'Source',    value: auth.source || '—',         field: 'source' },
                  { key: 'Store',     value: auth.store || '—' },
                  { key: 'Cycle',     value: auth.isAnnual ? 'annual' : 'monthly' },
                  { key: 'Product',   value: auth.productId || '—',      mono: true },
                  { key: 'Sub ID',    value: auth.subscriptionId || '—', mono: true },
                  { key: 'Price',     value: auth.priceUsd
                                        ? `$${Number(auth.priceUsd).toFixed(2)} ${auth.currency || ''}`.trim()
                                        : '—' },
                  { key: 'Purchased', value: formatDate(auth.purchasedAt) },
                  { key: 'Expires',   value: formatDate(auth.expiresAt), field: 'periodEnd' },
                  { key: 'Cancel At', value: formatDate(auth.cancelAt), field: 'cancelAt' },
                ];

            const sourceTag = (auth.source || 'live').toUpperCase();
            const statusMeta = auth.status === 'none'
              ? 'No live record found'
              : `${auth.status}${auth.source ? ' · ' + auth.source : ''}`;

            // Solo mode: when there's no authoritative record, the right-hand
            // "LIVE" column is just an empty placeholder. Collapse to a single
            // wide DB card with a 2-col field grid so 10 rows pack into 5.
            if (auth.status === 'none') {
              const live = (window._subsLastDetail || {}).liveSources || {};
              const rcStatus = live.revenuecat || '';
              const stStatus = live.stripe || '';
              const headerNote = live.note
                ? `<span class="subs-compare-soloflag subs-compare-soloflag--warn" title="${escapeHtml(live.note)}">${escapeHtml(rcLabel(rcStatus))} · ${escapeHtml(stripeLabel(stStatus))}</span>`
                : `<span class="subs-compare-soloflag">No live record in RevenueCat or Stripe</span>`;
              return `
                <div class="subs-section" style="margin:0 1.25rem;padding:0;display:flex;flex-direction:column;gap:8px;">
                  <div class="subs-section-head" style="margin:0;padding:0;">
                    <span class="subs-section-title">
                      <span class="subs-section-title-icon"><i class="fas fa-right-left"></i></span>
                      Subscription state
                    </span>
                    ${headerNote}
                  </div>
                  ${live.note ? `
                    <div class="subs-live-note">
                      <i class="fas fa-circle-info"></i>
                      <span>${escapeHtml(live.note)}</span>
                    </div>` : ''}
                  <div class="subs-compare subs-compare--solo" style="margin:0;">
                    <div class="subs-compare-col">
                      <div class="subs-compare-head">
                        <span class="subs-section-label">Our database</span>
                        <span class="subs-compare-tag">MONGO</span>
                      </div>
                      <div class="subs-field-list">
                        ${dbRows.map(r => renderField(r, false)).join('')}
                      </div>
                    </div>
                  </div>
                </div>`;
            }

            return `
              <div class="subs-section" style="margin:0 1.25rem;padding:0;display:flex;flex-direction:column;gap:8px;">
                <div class="subs-section-head" style="margin:0;padding:0;">
                  <span class="subs-section-title">
                    <span class="subs-section-title-icon"><i class="fas fa-right-left"></i></span>
                    Subscription state
                  </span>
                  <span class="subs-section-meta">${escapeHtml(statusMeta)}</span>
                </div>
                <div class="subs-compare" style="margin:0;">
                  <div class="subs-compare-col">
                    <div class="subs-compare-head">
                      <span class="subs-section-label">Our database</span>
                      <span class="subs-compare-tag">MONGO</span>
                    </div>
                    <div class="subs-field-list">
                      ${dbRows.map(r => renderField(r, mmFields.has(r.field))).join('')}
                    </div>
                  </div>
                  <div class="subs-compare-col">
                    <div class="subs-compare-head">
                      <span class="subs-section-label">Live${auth.source ? ' — ' + auth.source : ''}</span>
                      <span class="subs-compare-tag">${escapeHtml(sourceTag)}</span>
                    </div>
                    <div class="subs-field-list">
                      ${authRows.map(r => renderField(r, mmFields.has(r.field))).join('')}
                    </div>
                  </div>
                </div>
              </div>`;
          }

          function renderField(r, isMismatch) {
            const fieldCls = ['subs-field'];
            if (isMismatch) fieldCls.push('subs-field--mismatch');
            const valCls = ['subs-field-value'];
            if (r.dim)  valCls.push('subs-field-value-dim');
            if (r.mono) valCls.push('subs-field-value-mono');
            return `
              <div class="${fieldCls.join(' ')}">
                <div class="subs-field-key">${escapeHtml(r.key)}</div>
                <div class="${valCls.join(' ')}">${escapeHtml(String(r.value))}</div>
              </div>`;
          }

          function renderTimeline(payments) {
            const titleEl = `
              <span class="subs-section-title">
                <span class="subs-section-title-icon"><i class="fas fa-clock-rotate-left"></i></span>
                Payment history
              </span>`;

            if (!payments.length) {
              return `
                <div class="subs-section" style="margin:0 1.25rem;padding:0;display:flex;flex-direction:column;gap:8px;">
                  <div class="subs-section-head" style="margin:0;padding:0;">
                    ${titleEl}
                    <span class="subs-section-meta">no payments</span>
                  </div>
                  <div style="padding:1.75rem 0.5rem;text-align:center;color:var(--ac-text-dim);font-size:0.8125rem;border-top:1px solid var(--subs-rule);">
                    No payment history available for this user.
                  </div>
                </div>`;
            }

            const SHOW = 10;
            const visible = _paymentsExpanded ? payments : payments.slice(0, SHOW);
            const hidden  = payments.length - visible.length;

            // Group successive same-month rows
            const groups = [];
            let curMonth = null;
            visible.forEach(p => {
              const m = formatMonth(p.date);
              if (m !== curMonth) {
                curMonth = m;
                groups.push({ month: m, items: [] });
              }
              groups[groups.length - 1].items.push(p);
            });

            // Summary stats — only sum successful payments
            const successful = payments.filter(p => p.status === 'paid' || p.status === 'purchase');
            const total = successful.reduce((acc, p) => acc + (Number(p.amount) || 0), 0);

            return `
              <div class="subs-section" style="margin:0 1.25rem;padding:0;display:flex;flex-direction:column;gap:8px;">
                <div class="subs-section-head" style="margin:0;padding:0;">
                  ${titleEl}
                  <span class="subs-section-meta">${payments.length} event${payments.length === 1 ? '' : 's'} · ${successful.length} paid · $${total.toFixed(2)} total</span>
                </div>
                <div class="subs-timeline" data-testid="subs-timeline" style="margin:0;">
                  ${groups.map(g => `
                    <div class="subs-timeline-month">${escapeHtml(g.month)}</div>
                    ${g.items.map(renderPayment).join('')}
                  `).join('')}
                  ${hidden > 0 ? `<button class="subs-show-more" data-expand>Show ${hidden} more payment${hidden === 1 ? '' : 's'}</button>` : ''}
                </div>
              </div>`;
          }

          function renderPayment(p) {
            const parts = formatDateParts(p.date);
            const status = (p.status || 'default').toLowerCase();
            const known  = ['paid','failed','refunded','purchase','void'].includes(status);
            const cls    = 'subs-status-pill--' + (known ? status : 'default');

            const label    = p.productLabel || p.plan || '';
            const periodTo = p.effectiveUntil ? ` → ${formatDate(p.effectiveUntil)}` : '';
            const now      = Date.now();
            const isActive = p.effectiveUntil && new Date(p.effectiveUntil).getTime() > now;
            const activePill = isActive
              ? `<span class="subs-payment-active" title="Currently entitled">active</span>`
              : '';

            return `
              <div class="subs-payment">
                <div class="subs-payment-date">
                  <div class="subs-payment-date-day">${escapeHtml(parts.day)}</div>
                  <div class="subs-payment-date-rest">${escapeHtml(parts.rest)}</div>
                </div>
                <div class="subs-payment-main">
                  <div class="subs-payment-label">
                    ${sourceMark(p.source)}
                    <span class="subs-payment-sourcelabel">${escapeHtml(p.source || '')}</span>
                    ${label ? `<span class="subs-payment-plan">· ${escapeHtml(label)}</span>` : ''}
                    ${activePill}
                  </div>
                  ${p.effectiveUntil ? `<div class="subs-payment-period">${escapeHtml(formatDate(p.date))}${escapeHtml(periodTo)}</div>` : ''}
                  ${p.reference ? `<div class="subs-payment-ref">${escapeHtml(p.reference)}</div>` : ''}
                </div>
                <div class="subs-payment-amount">
                  ${escapeHtml(formatMoney(p.amount, p.currency))}<span class="subs-payment-amount-cur">${escapeHtml((p.currency || '').toUpperCase())}</span>
                </div>
                <div class="subs-payment-status">
                  <span class="subs-status-pill ${cls}">${escapeHtml(status)}</span>
                </div>
              </div>`;
          }

          /* ------------------- actions ------------------- */

          function wireDetailActions(data) {
            const detail = document.getElementById('subs-detail');

            const fixBtn = detail.querySelector('[data-fix]');
            if (fixBtn) fixBtn.addEventListener('click', () => runFix(data.user.id, fixBtn));

            const refresh = detail.querySelector('[data-refresh]');
            if (refresh) refresh.addEventListener('click', () => loadDetail(data.user.id));

            const expand = detail.querySelector('[data-expand]');
            if (expand) expand.addEventListener('click', () => {
              _paymentsExpanded = true;
              if (_lastDetail) {
                detail.innerHTML = renderDetail(_lastDetail);
                wireDetailActions(_lastDetail);
              }
            });
          }

          async function runFix(userId, btn) {
            btn.disabled = true;
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner"></i><span>Syncing…</span>';

            try {
              const res = await api(`/api/v1/admin/subscription/users/${encodeURIComponent(userId)}/sync`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ source: 'auto' }),
              });
              if (!res.ok) {
                let msg = 'HTTP ' + res.status;
                try { msg = (await res.json()).error || msg; } catch (e) { /* ignore */ }
                throw new Error(msg);
              }
              const body = await res.json();
              showToast('Synced from ' + (body.syncedFrom || 'live source'), 'ok');
              // Re-fetch so the banner flips and fields update
              await loadDetail(userId);
            } catch (err) {
              btn.disabled = false;
              btn.innerHTML = original;
              showToast('Sync failed: ' + (err.message || 'unknown'), 'error');
            }
          }

          /* ------------------- toast ------------------- */

          function showToast(msg, kind) {
            const existing = document.querySelector('.subs-toast');
            if (existing) existing.remove();
            const icon = kind === 'error' ? 'fa-times-circle' : 'fa-check-circle';
            const t = document.createElement('div');
            t.className = 'subs-toast subs-toast--' + (kind || 'ok');
            t.innerHTML = `
              <span class="subs-toast-icon--${kind || 'ok'}"><i class="fas ${icon}"></i></span>
              <span>${escapeHtml(msg)}</span>`;
            document.body.appendChild(t);
            setTimeout(() => { t.style.opacity = '0'; t.style.transition = 'opacity 0.3s'; }, 3200);
            setTimeout(() => t.remove(), 3700);
          }

          /* ------------------- public entry point ------------------- */

          window.initSubscriptionsPanel = function () {
            const input = document.getElementById('subs-q');
            if (!input || input.dataset.wired === '1') return;
            input.dataset.wired = '1';

            const debounced = debounce(() => runSearch(input.value.trim()), 220);
            input.addEventListener('input', debounced);
            input.addEventListener('keydown', e => {
              if (e.key === 'Enter') {
                e.preventDefault();
                runSearch(input.value.trim());
              }
            });

            // Global "/" shortcut to focus search (only when panel visible)
            const panel = document.getElementById('panel-subscriptions');
            if (panel && !panel.dataset.kbWired) {
              panel.dataset.kbWired = '1';
              document.addEventListener('keydown', e => {
                if (e.key !== '/') return;
                if (!panel.classList.contains('active')) return;
                const t = e.target;
                if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
                e.preventDefault();
                input.focus();
              });
            }

            setTimeout(() => input.focus(), 120);

            // Toggle is-stuck on the sticky search wrapper only after it
            // detaches from its anchor position. A 1px sentinel placed
            // right above the bar tells us when we've scrolled past it —
            // way cheaper than listening to scroll.
            const search = panel && panel.querySelector('.subs-search');
            if (search && !search.dataset.stickObs) {
              search.dataset.stickObs = '1';
              const sentinel = document.createElement('div');
              sentinel.style.cssText = 'position:absolute;top:-1px;left:0;width:1px;height:1px;pointer-events:none;';
              search.parentElement.insertBefore(sentinel, search);
              const io = new IntersectionObserver(entries => {
                search.classList.toggle('is-stuck', !entries[0].isIntersecting);
              }, { threshold: [0] });
              io.observe(sentinel);
            }
          };
        })();

      // =====================================================
      // METRICS PANEL
      // =====================================================
      var metricsSocket = null;
      var metricsInitialized = false;

      function loadMetricsPanel() {
        if (metricsInitialized) {
          // Already initialized, just re-fetch
          fetchBetaAdoptionMetrics();
          fetchBetaFeedback(currentFeedbackFlag, currentFeedbackStatus);
          return;
        }
        metricsInitialized = true;
        fetchBetaAdoptionMetrics();
        fetchDailyMetrics();
        initMetricsSocket();
        initFeedbackTabs();
        fetchBetaFeedback(currentFeedbackFlag, currentFeedbackStatus);
        initMetricsVisibility();
      }

      // -- Beta Adoption Metrics --

      function fetchBetaAdoptionMetrics() {
        $.ajax({
          url: API_BASE + '/api/v1/admin/beta-dashboard-metrics',
          method: 'GET',
          success: function(data) {
            applyBetaAdoptionMetrics(data);
          },
          error: function() {
            $('#metrics-beta-loading').html('<i class="fas fa-exclamation-triangle" style="color:var(--ac-red);"></i> Failed to load metrics');
          }
        });
      }

      function applyBetaAdoptionMetrics(data) {
        var optedIn = data.optedIn || 0;
        var classic = data.classic || 0;
        var total = data.total || 0;
        var pct = total > 0 ? Math.round((optedIn / total) * 100) : 0;

        $('#metrics-beta-opted').text(optedIn.toLocaleString());
        $('#metrics-beta-classic').text(classic.toLocaleString());
        $('#metrics-beta-total').text(total.toLocaleString());
        $('#metrics-beta-pct').text(pct + '%');
        $('#metrics-beta-bar').css('width', pct + '%');
        $('#metrics-beta-loading').hide();
        $('#metrics-beta-content').show();

        // Command dashboard (police) metrics
        var cmdOptedIn = data.cmdOptedIn || 0;
        var cmdClassic = data.cmdClassic || 0;
        var cmdPct = total > 0 ? Math.round((cmdOptedIn / total) * 100) : 0;

        $('#metrics-cmd-opted').text(cmdOptedIn.toLocaleString());
        $('#metrics-cmd-classic').text(cmdClassic.toLocaleString());
        $('#metrics-cmd-total').text(total.toLocaleString());
        $('#metrics-cmd-pct').text(cmdPct + '%');
        $('#metrics-cmd-bar').css('width', cmdPct + '%');
        $('#metrics-cmd-loading').hide();
        $('#metrics-cmd-content').show();

        // Command Bridge (dispatch) metrics — tracked independently.
        var cmdDispatchOptedIn = data.cmdDispatchOptedIn || 0;
        var cmdDispatchClassic = data.cmdDispatchClassic || 0;
        var cmdDispatchPct = total > 0 ? Math.round((cmdDispatchOptedIn / total) * 100) : 0;

        $('#metrics-cmd-dispatch-opted').text(cmdDispatchOptedIn.toLocaleString());
        $('#metrics-cmd-dispatch-classic').text(cmdDispatchClassic.toLocaleString());
        $('#metrics-cmd-dispatch-total').text(total.toLocaleString());
        $('#metrics-cmd-dispatch-pct').text(cmdDispatchPct + '%');
        $('#metrics-cmd-dispatch-bar').css('width', cmdDispatchPct + '%');
        $('#metrics-cmd-dispatch-loading').hide();
        $('#metrics-cmd-dispatch-content').show();
      }

      // -- Daily Trend Charts --

      function fetchDailyMetrics() {
        $.ajax({
          url: API_BASE + '/api/v1/admin/beta-dashboard-metrics/daily',
          method: 'GET',
          success: function(data) {
            if (data && data.days) {
              $('#chart-beta-card').show();
              $('#metrics-charts-row').show();
              renderTrendCharts(data.days);
            }
          },
          error: function() {
            // Silently fail — charts are supplementary
          }
        });
      }

      function renderTrendCharts(days) {
        var betaValues = days.map(function(d) { return d.betaOptIns; });
        var cmdValues = days.map(function(d) { return d.cmdOptIns || 0; });
        var userValues = days.map(function(d) { return d.newUsers; });
        var labels = days.map(function(d) {
          var parts = d.date.split('-');
          var dt = new Date(parts[0], parts[1] - 1, parts[2]);
          return dt.toLocaleDateString('en-US', { weekday: 'short' });
        });
        var fullLabels = days.map(function(d) {
          var parts = d.date.split('-');
          var dt = new Date(parts[0], parts[1] - 1, parts[2]);
          return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        });

        // Show command dashboard chart card BEFORE rendering so it has width
        $('#chart-cmd-card').show();

        renderLineChart('chart-beta', betaValues, labels, fullLabels, 'var(--ac-accent)', '#a78bfa');
        renderLineChart('chart-cmd', cmdValues, labels, fullLabels, '#38bdf8', '#7dd3fc');
        renderLineChart('chart-users', userValues, labels, fullLabels, 'var(--ac-green)', '#4ade80');

        // Update totals and trends
        var betaSum = betaValues.reduce(function(a,b) { return a+b; }, 0);
        var cmdSum = cmdValues.reduce(function(a,b) { return a+b; }, 0);
        var userSum = userValues.reduce(function(a,b) { return a+b; }, 0);
        $('#chart-beta-total').text(betaSum.toLocaleString());
        $('#chart-cmd-total').text(cmdSum.toLocaleString());
        $('#chart-users-total').text(userSum.toLocaleString());

        // Trend: compare last 3 days vs first 3 days
        var betaRecent = betaValues.slice(-3).reduce(function(a,b){return a+b;},0);
        var betaOlder = betaValues.slice(0,3).reduce(function(a,b){return a+b;},0);
        applyTrend('chart-beta-trend', betaRecent, betaOlder);

        var cmdRecent = cmdValues.slice(-3).reduce(function(a,b){return a+b;},0);
        var cmdOlder = cmdValues.slice(0,3).reduce(function(a,b){return a+b;},0);
        applyTrend('chart-cmd-trend', cmdRecent, cmdOlder);

        var userRecent = userValues.slice(-3).reduce(function(a,b){return a+b;},0);
        var userOlder = userValues.slice(0,3).reduce(function(a,b){return a+b;},0);
        applyTrend('chart-users-trend', userRecent, userOlder);
      }

      function applyTrend(elId, recent, older) {
        var $el = $('#' + elId);
        if (older === 0 && recent === 0) {
          $el.removeClass('up down').addClass('flat').html('&mdash;');
        } else if (older === 0) {
          $el.removeClass('down flat').addClass('up').html('<i class="fas fa-arrow-up" style="font-size:0.5rem;"></i> New');
        } else {
          var pct = Math.round(((recent - older) / older) * 100);
          if (pct > 0) {
            $el.removeClass('down flat').addClass('up').html('<i class="fas fa-arrow-up" style="font-size:0.5rem;"></i> +' + pct + '%');
          } else if (pct < 0) {
            $el.removeClass('up flat').addClass('down').html('<i class="fas fa-arrow-down" style="font-size:0.5rem;"></i> ' + pct + '%');
          } else {
            $el.removeClass('up down').addClass('flat').html('<i class="fas fa-minus" style="font-size:0.5rem;"></i> 0%');
          }
        }
      }

      function renderLineChart(prefix, values, labels, fullLabels, color1, color2) {
        var svg = document.getElementById(prefix + '-svg');
        var wrap = document.getElementById(prefix + '-wrap');
        var tooltip = document.getElementById(prefix + '-tooltip');
        var labelsEl = document.getElementById(prefix + '-labels');
        if (!svg || !wrap) return;

        var w = wrap.offsetWidth;
        var h = 120;
        svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);

        var maxVal = Math.max.apply(null, values);
        var allZero = maxVal === 0;
        if (maxVal === 0) maxVal = 1; // prevent division by zero

        // Show "no data" overlay if all values are zero
        var existingOverlay = wrap.querySelector('.ac-chart-no-data');
        if (existingOverlay) existingOverlay.remove();
        if (allZero) {
          var overlay = document.createElement('div');
          overlay.className = 'ac-chart-no-data';
          overlay.style.cssText = 'position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--ac-text-dim);font-size:0.8rem;font-weight:500;';
          overlay.textContent = 'No activity in the last 7 days';
          wrap.style.position = 'relative';
          wrap.appendChild(overlay);
        }

        var padTop = 8, padBot = 8, padX = 12;
        var chartH = h - padTop - padBot;
        var stepX = (w - padX * 2) / (values.length - 1 || 1);

        // Build points
        var points = values.map(function(v, i) {
          var x = padX + i * stepX;
          var y = padTop + chartH - (v / maxVal) * chartH;
          return { x: x, y: y, val: v };
        });

        // Build path
        var linePath = '';
        points.forEach(function(p, i) {
          if (i === 0) { linePath += 'M ' + p.x + ' ' + p.y; }
          else {
            // Smooth curve
            var prev = points[i - 1];
            var cpx = (prev.x + p.x) / 2;
            linePath += ' C ' + cpx + ' ' + prev.y + ', ' + cpx + ' ' + p.y + ', ' + p.x + ' ' + p.y;
          }
        });

        // Area path (fill under curve)
        var areaPath = linePath + ' L ' + points[points.length - 1].x + ' ' + (h - padBot) +
          ' L ' + points[0].x + ' ' + (h - padBot) + ' Z';

        // Grid lines (3 horizontal)
        var gridHTML = '';
        for (var g = 0; g <= 2; g++) {
          var gy = padTop + (chartH / 2) * g;
          gridHTML += '<line x1="' + padX + '" y1="' + gy + '" x2="' + (w - padX) + '" y2="' + gy + '" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>';
        }

        // Unique gradient IDs
        var gradId = prefix + '-grad';
        var areaGradId = prefix + '-area-grad';

        svg.innerHTML =
          '<defs>' +
            '<linearGradient id="' + gradId + '" x1="0%" y1="0%" x2="100%" y2="0%">' +
              '<stop offset="0%" stop-color="' + color1 + '"/>' +
              '<stop offset="100%" stop-color="' + color2 + '"/>' +
            '</linearGradient>' +
            '<linearGradient id="' + areaGradId + '" x1="0%" y1="0%" x2="0%" y2="100%">' +
              '<stop offset="0%" stop-color="' + color1 + '" stop-opacity="0.15"/>' +
              '<stop offset="100%" stop-color="' + color1 + '" stop-opacity="0"/>' +
            '</linearGradient>' +
          '</defs>' +
          gridHTML +
          '<path d="' + areaPath + '" fill="url(#' + areaGradId + ')"/>' +
          '<path d="' + linePath + '" fill="none" stroke="url(#' + gradId + ')" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="filter:drop-shadow(0 1px 4px rgba(139,92,246,0.3));">' +
            '<animate attributeName="stroke-dashoffset" from="1000" to="0" dur="1.2s" fill="freeze"/>' +
            '<animate attributeName="stroke-dasharray" from="1000" to="1000" dur="0.01s" fill="freeze"/>' +
          '</path>';

        // Add dots
        points.forEach(function(p, i) {
          var dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          dot.setAttribute('cx', p.x);
          dot.setAttribute('cy', p.y);
          dot.setAttribute('r', '4');
          dot.setAttribute('fill', '#08090c');
          dot.setAttribute('stroke', color2);
          dot.setAttribute('stroke-width', '2');
          dot.style.opacity = '0';
          dot.style.transition = 'opacity 0.15s, r 0.15s';
          dot.style.cursor = 'pointer';

          // Invisible larger hit area
          var hitArea = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          hitArea.setAttribute('cx', p.x);
          hitArea.setAttribute('cy', p.y);
          hitArea.setAttribute('r', '16');
          hitArea.setAttribute('fill', 'transparent');
          hitArea.style.cursor = 'pointer';

          hitArea.addEventListener('mouseenter', function() {
            dot.style.opacity = '1';
            dot.setAttribute('r', '5');
            tooltip.style.left = p.x + 'px';
            tooltip.style.top = (p.y - 10) + 'px';
            tooltip.querySelector('.ac-chart-tooltip-date').textContent = fullLabels[i];
            tooltip.querySelector('.ac-chart-tooltip-value').textContent = p.val.toLocaleString();
            tooltip.classList.add('visible');
          });
          hitArea.addEventListener('mouseleave', function() {
            dot.style.opacity = '0';
            dot.setAttribute('r', '4');
            tooltip.classList.remove('visible');
          });

          svg.appendChild(dot);
          svg.appendChild(hitArea);
        });

        // Labels
        labelsEl.innerHTML = '';
        labels.forEach(function(lbl) {
          var span = document.createElement('span');
          span.className = 'ac-chart-label';
          span.textContent = lbl;
          labelsEl.appendChild(span);
        });
      }

      // Redraw charts on window resize
      var chartResizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(chartResizeTimer);
        chartResizeTimer = setTimeout(function() {
          if (metricsInitialized && window._lastDailyMetrics) {
            renderTrendCharts(window._lastDailyMetrics);
          }
        }, 250);
      });

      // Store last data for resize re-render
      var _origRenderTrendCharts = renderTrendCharts;
      renderTrendCharts = function(days) {
        window._lastDailyMetrics = days;
        _origRenderTrendCharts(days);
      };

      // -- Section Toggle --

      function toggleMetricsSection(id) {
        var $section = $('#metrics-section-' + id);
        $section.toggleClass('collapsed');
      }

      // -- Beta Opt-Out Feedback --

      var currentFeedbackFlag = 'betaCommandDashboard';
      var currentFeedbackStatus = 'open';
      var bfbUndoTimer = null;
      // Canonical reason order + labels. Keeps the distribution columns
      // aligned across flags even when a reason has zero responses.
      var BFB_REASONS = [
        { key: 'too_buggy',        label: 'Too buggy',         color: '#ef4444' },
        { key: 'look_and_feel',    label: 'Look & feel',        color: '#f97316' },
        { key: 'preferred_old',    label: 'Preferred classic',  color: '#f59e0b' },
        { key: 'missing_features', label: 'Missing features',   color: '#a78bfa' },
        { key: 'performance',      label: 'Slow / laggy',       color: '#38bdf8' },
        { key: 'other',            label: 'Other',              color: '#94a3b8' },
      ];

      function initFeedbackTabs() {
        $('#bfb-tabs').on('click', '.bfb-tab', function() {
          var flag = $(this).data('flag');
          if (flag === currentFeedbackFlag) return;
          currentFeedbackFlag = flag;
          // Paint the active tab
          $('#bfb-tabs .bfb-tab').each(function() {
            var active = $(this).data('flag') === flag;
            $(this)
              .toggleClass('is-active', active)
              .css({
                'border-color': active ? 'rgba(56,189,248,0.35)' : 'rgba(148,163,184,0.15)',
                'background':   active ? 'rgba(56,189,248,0.12)' : 'transparent',
                'color':        active ? '#7dd3fc' : '#94a3b8',
              });
          });
          fetchBetaFeedback(currentFeedbackFlag, currentFeedbackStatus);
        });

        $('#bfb-status-tabs').on('click', '.bfb-status-tab', function() {
          var status = $(this).data('status');
          if (status === currentFeedbackStatus) return;
          currentFeedbackStatus = status;
          $('#bfb-status-tabs .bfb-status-tab').each(function() {
            var active = $(this).data('status') === status;
            $(this)
              .toggleClass('is-active', active)
              .css({
                'border-color': active ? 'rgba(56,189,248,0.35)' : 'rgba(148,163,184,0.15)',
                'background':   active ? 'rgba(56,189,248,0.12)' : 'transparent',
                'color':        active ? '#7dd3fc' : '#94a3b8',
              });
          });
          fetchBetaFeedback(currentFeedbackFlag, currentFeedbackStatus);
        });

        // Card actions are delegated so they survive re-renders.
        $('#bfb-entries').on('click', '.bfb-action', function(e) {
          e.preventDefault();
          var $btn = $(this);
          var id = $btn.data('id');
          var action = $btn.data('action');
          if (!id || !action) return;
          if (action === 'resolve' || action === 'reopen') {
            resolveBetaFeedback(id, action === 'resolve');
          } else if (action === 'delete') {
            confirmDeleteBetaFeedback(id);
          }
        });

        $('#bfb-toast-undo').on('click', function() {
          var id = $('#bfb-toast').data('id');
          if (!id) return;
          undoDeleteBetaFeedback(id);
        });

        $('#bfb-confirm-cancel').on('click', closeBfbConfirm);
        $('#bfb-confirm').on('click', function(e) { if (e.target === this) closeBfbConfirm(); });
        $('#bfb-confirm-ok').on('click', function() {
          var id = $('#bfb-confirm').data('id');
          closeBfbConfirm();
          if (id) deleteBetaFeedback(id);
        });

        // Hover affordance for the ghost icon buttons.
        $('#bfb-entries')
          .on('mouseenter', '.bfb-action', function() {
            var isDelete = $(this).data('action') === 'delete';
            $(this).css({
              opacity: '1',
              'background': isDelete ? 'rgba(239,68,68,0.12)' : 'rgba(34,197,94,0.12)',
              'border-color': isDelete ? 'rgba(239,68,68,0.35)' : 'rgba(34,197,94,0.35)',
              'color': isDelete ? '#fca5a5' : '#86efac',
            });
          })
          .on('mouseleave', '.bfb-action', function() {
            $(this).css({
              opacity: '0.55',
              'background': 'transparent',
              'border-color': 'transparent',
              'color': 'var(--ac-text-dim)',
            });
          });
      }

      function fetchBetaFeedback(flag, status) {
        var apiUrl = '<%= POLICE_CAD_API_URL %>' + '/api/v1/admin/beta-feedback?flag=' + encodeURIComponent(flag) +
          '&status=' + encodeURIComponent(status || 'open') + '&limit=100';
        $('#bfb-loading').show();
        $('#bfb-content').hide();
        $.ajax({ url: apiUrl, method: 'GET' })
          .done(function(resp) { renderBetaFeedback(resp || {}); })
          .fail(function() {
            $('#bfb-loading').html('<i class="fas fa-triangle-exclamation"></i> Failed to load feedback.');
          });
      }

      function renderBetaFeedback(resp) {
        var total = resp.totalCount || 0;
        var counts = resp.reasonCounts || {};
        var entries = Array.isArray(resp.data) ? resp.data : [];
        var openCount = typeof resp.openCount === 'number' ? resp.openCount : 0;
        var resolvedCount = typeof resp.resolvedCount === 'number' ? resp.resolvedCount : 0;

        // Reason distribution chips
        var distHtml = BFB_REASONS.map(function(r) {
          var count = counts[r.key] || 0;
          var pct = total > 0 ? Math.round((count / total) * 100) : 0;
          return (
            '<div style="padding:0.625rem 0.75rem;border-radius:8px;background:var(--ac-glass);border:1px solid var(--ac-glass-border);">' +
              '<div style="display:flex;align-items:center;gap:0.4375rem;margin-bottom:0.375rem;">' +
                '<span style="width:8px;height:8px;border-radius:999px;background:' + r.color + ';"></span>' +
                '<span style="font-size:0.6875rem;color:var(--ac-text-muted);font-weight:600;">' + r.label + '</span>' +
              '</div>' +
              '<div style="font:700 1.25rem/1 \'JetBrains Mono\',ui-monospace,monospace;color:var(--ac-text);">' + count + '</div>' +
              '<div style="font-size:0.625rem;color:var(--ac-text-dim);margin-top:0.25rem;">' + pct + '%</div>' +
            '</div>'
          );
        }).join('');
        $('#bfb-distribution').html(distHtml);

        $('[data-status-count="open"]').text(openCount);
        $('[data-status-count="resolved"]').text(resolvedCount);

        var commentCount = typeof resp.commentCount === 'number' ? resp.commentCount : 0;
        $('#bfb-count').text(commentCount + (commentCount === 1 ? ' comment' : ' comments'));

        // Only show entries that have free-form feedback attached —
        // the counts above already summarise the reason enum, so we
        // don't need to list every row.
        var withText = entries.filter(function(e) { return e.feedback && e.feedback.trim(); });
        if (!withText.length) {
          $('#bfb-entries').empty();
          $('#bfb-empty').show();
        } else {
          $('#bfb-empty').hide();
          var entriesHtml = withText.map(function(e) { return renderBetaFeedbackCard(e); }).join('');
          $('#bfb-entries').html(entriesHtml);
        }

        $('#bfb-loading').hide();
        $('#bfb-content').show();
      }

      function renderBetaFeedbackCard(e) {
        var reasonMeta = BFB_REASONS.find(function(r) { return r.key === e.reason; }) || { label: e.reason, color: '#94a3b8' };
        var date = '';
        try { date = new Date(e.createdAt).toLocaleString(); } catch (_) { date = ''; }
        var context = e.context ? ' · <span style="color:var(--ac-text-dim);">' + $('<div>').text(e.context).html() + '</span>' : '';
        var resolved = !!e.resolvedAt;
        var resolvedDate = '';
        if (resolved) {
          try { resolvedDate = new Date(e.resolvedAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }); }
          catch (_) { resolvedDate = ''; }
        }
        var resolvedPill = resolved
          ? '<span style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.125rem 0.4375rem;border-radius:999px;background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.3);color:#4ade80;font-size:0.625rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;margin-left:0.4375rem;"><i class="fas fa-check" style="font-size:0.5625rem;"></i> Resolved' + (resolvedDate ? ' · ' + resolvedDate : '') + '</span>'
          : '';
        var cardOpacity = resolved ? '0.55' : '1';
        var actionBtnStyle = 'width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center;border-radius:7px;border:1px solid transparent;background:transparent;color:var(--ac-text-dim);cursor:pointer;transition:all 0.15s ease;opacity:0.55;';
        var resolveAction = resolved ? 'reopen' : 'resolve';
        var resolveIcon = resolved ? 'fa-rotate-left' : 'fa-check';
        var resolveTitle = resolved ? 'Reopen' : 'Mark resolved';
        var actionsHtml =
          '<div class="bfb-actions" style="display:inline-flex;gap:0.25rem;margin-left:0.5rem;">' +
            '<button type="button" class="bfb-action" data-id="' + e._id + '" data-action="' + resolveAction + '" title="' + resolveTitle + '" aria-label="' + resolveTitle + '" style="' + actionBtnStyle + '">' +
              '<i class="fas ' + resolveIcon + '" style="font-size:0.75rem;"></i>' +
            '</button>' +
            '<button type="button" class="bfb-action" data-id="' + e._id + '" data-action="delete" title="Delete (spam)" aria-label="Delete" style="' + actionBtnStyle + '">' +
              '<i class="fas fa-trash" style="font-size:0.75rem;"></i>' +
            '</button>' +
          '</div>';
        return (
          '<div class="bfb-card" data-id="' + e._id + '" style="padding:0.75rem 0.875rem;border-radius:8px;background:var(--ac-glass);border:1px solid var(--ac-glass-border);border-left:3px solid ' + reasonMeta.color + ';opacity:' + cardOpacity + ';transition:opacity 0.2s ease;">' +
            '<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.5rem;margin-bottom:0.375rem;flex-wrap:wrap;">' +
              '<div style="display:flex;align-items:center;flex-wrap:wrap;min-width:0;">' +
                '<span style="font-size:0.6875rem;font-weight:700;color:' + reasonMeta.color + ';text-transform:uppercase;letter-spacing:0.06em;">' + reasonMeta.label + '</span>' +
                resolvedPill +
              '</div>' +
              '<div style="display:flex;align-items:center;gap:0.5rem;">' +
                '<span style="font-size:0.625rem;color:var(--ac-text-dim);">' + $('<div>').text(date).html() + context + '</span>' +
                actionsHtml +
              '</div>' +
            '</div>' +
            '<div style="font-size:0.8125rem;color:var(--ac-text);line-height:1.5;white-space:pre-wrap;">' + $('<div>').text(e.feedback).html() + '</div>' +
          '</div>'
        );
      }

      function resolveBetaFeedback(id, resolved) {
        $.ajax({
          url: '/admin/beta-feedback/' + encodeURIComponent(id),
          method: 'PATCH',
          contentType: 'application/json',
          data: JSON.stringify({ resolved: !!resolved }),
        })
          .done(function() { fetchBetaFeedback(currentFeedbackFlag, currentFeedbackStatus); })
          .fail(function() { showBfbErrorToast('Failed to update feedback'); });
      }

      function confirmDeleteBetaFeedback(id) {
        var $modal = $('#bfb-confirm');
        $modal.css('display', 'flex').data('id', id);
        var keyHandler = function(ev) {
          if (ev.key === 'Escape') closeBfbConfirm();
          else if (ev.key === 'Enter') { closeBfbConfirm(); deleteBetaFeedback(id); }
        };
        $(document).on('keydown.bfbConfirm', keyHandler);
      }

      function closeBfbConfirm() {
        $('#bfb-confirm').css('display', 'none').removeData('id');
        $(document).off('keydown.bfbConfirm');
      }

      function deleteBetaFeedback(id) {
        $.ajax({
          url: '/admin/beta-feedback/' + encodeURIComponent(id),
          method: 'DELETE',
        })
          .done(function() {
            // Optimistically pull the card out of view so the list shrinks immediately.
            $('#bfb-entries .bfb-card[data-id="' + id + '"]').remove();
            showBfbUndoToast(id);
            // Refresh counts in the background.
            fetchBetaFeedback(currentFeedbackFlag, currentFeedbackStatus);
          })
          .fail(function() { showBfbErrorToast('Failed to delete feedback'); });
      }

      function undoDeleteBetaFeedback(id) {
        $.ajax({
          url: '/admin/beta-feedback/' + encodeURIComponent(id) + '?undo=true',
          method: 'DELETE',
        })
          .done(function() {
            hideBfbToast();
            fetchBetaFeedback(currentFeedbackFlag, currentFeedbackStatus);
          })
          .fail(function() { showBfbErrorToast('Undo failed'); });
      }

      function showBfbUndoToast(id) {
        var $toast = $('#bfb-toast');
        $toast.data('id', id);
        $('#bfb-toast-msg').text('Feedback deleted');
        $('#bfb-toast-undo').show();
        $toast.css('display', 'flex');
        if (bfbUndoTimer) { clearTimeout(bfbUndoTimer); }
        bfbUndoTimer = setTimeout(hideBfbToast, 5000);
      }

      function showBfbErrorToast(msg) {
        var $toast = $('#bfb-toast');
        $toast.removeData('id');
        $('#bfb-toast-msg').text(msg);
        $('#bfb-toast-undo').hide();
        $toast.css('display', 'flex');
        if (bfbUndoTimer) { clearTimeout(bfbUndoTimer); }
        bfbUndoTimer = setTimeout(hideBfbToast, 3500);
      }

      function hideBfbToast() {
        $('#bfb-toast').css('display', 'none').removeData('id');
        if (bfbUndoTimer) { clearTimeout(bfbUndoTimer); bfbUndoTimer = null; }
      }

      // -- Socket.IO Live Updates --

      function initMetricsSocket() {
        if (typeof io === 'undefined') {
          $('#metrics-live-dot').addClass('disconnected');
          $('#metrics-live-label').text('Live updates unavailable');
          return;
        }

        try {
          metricsSocket = io({ transports: ['websocket'], reconnection: true });
        } catch (e) {
          $('#metrics-live-dot').addClass('disconnected');
          $('#metrics-live-label').text('Live updates unavailable');
          return;
        }

        metricsSocket.on('connect', function() {
          metricsSocket.emit('join_admin_metrics');
          $('#metrics-live-dot').removeClass('disconnected');
          $('#metrics-live-label').text('Live');
        });

        metricsSocket.on('connect_error', function() {
          $('#metrics-live-dot').addClass('disconnected');
          $('#metrics-live-label').text('Connection error');
        });

        metricsSocket.on('disconnect', function() {
          $('#metrics-live-dot').addClass('disconnected');
          $('#metrics-live-label').text('Reconnecting...');
        });

        metricsSocket.on('beta_metrics_updated', function(data) {
          applyBetaAdoptionMetrics(data);
        });
      }

      // -- Visibility API Auto-Refresh --

      function initMetricsVisibility() {
        document.addEventListener('visibilitychange', function() {
          if (document.visibilityState === 'visible') {
            // Check if metrics panel is currently active
            var $panel = $('#panel-metrics');
            if ($panel.hasClass('active')) {
              fetchBetaAdoptionMetrics();
            }
          }
        });
      }

      // =====================================================
      // ADMIN WIKI
      // =====================================================
      function initAdminWiki() {
        updateAdminWikiActiveLink();
        // Check for deep link (e.g. #wiki/reset-owner)
        var hash = window.location.hash.replace('#', '');
        var parts = hash.split('/');
        if (parts.length === 2 && parts[0] === 'wiki' && parts[1]) {
          var target = document.getElementById(parts[1]);
          if (target) {
            setTimeout(function() {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 200);
          }
        }
      }

      function filterAdminWiki(query) {
        var q = query.toLowerCase().trim();
        var sidebar = document.getElementById('aw-sidebar');
        if (!sidebar) return;
        var groups = sidebar.querySelectorAll('.aw-nav-group-title');
        var links = sidebar.querySelectorAll('.aw-nav-link');

        if (!q) {
          groups.forEach(function(g) { g.style.display = ''; });
          links.forEach(function(l) { l.style.display = ''; });
          return;
        }

        var visibleGroups = new Set();
        links.forEach(function(link) {
          var text = link.textContent.toLowerCase();
          var prev = link.previousElementSibling;
          while (prev && !prev.classList.contains('aw-nav-group-title')) {
            prev = prev.previousElementSibling;
          }
          var groupText = prev ? prev.textContent.toLowerCase() : '';

          if (text.indexOf(q) !== -1 || groupText.indexOf(q) !== -1) {
            link.style.display = '';
            if (prev) visibleGroups.add(prev);
          } else {
            link.style.display = 'none';
          }
        });

        groups.forEach(function(g) {
          g.style.display = visibleGroups.has(g) ? '' : 'none';
        });
      }

      function updateAdminWikiActiveLink() {
        var content = document.getElementById('aw-content');
        if (!content) return;

        var links = document.querySelectorAll('.aw-nav-link');
        var subsections = content.querySelectorAll('.aw-subsection[id]');

        // Click handlers for smooth scrolling + URL update
        links.forEach(function(link) {
          link.addEventListener('click', function(e) {
            e.preventDefault();
            var href = this.getAttribute('href');
            var sectionId = href.replace('#', '');
            var target = document.querySelector(href);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              history.replaceState(null, null, '#wiki/' + sectionId);
            }
          });
        });

        // Scroll spy — only runs when wiki panel is active
        function onScroll() {
          var wikiPanel = document.getElementById('panel-wiki');
          if (!wikiPanel || !wikiPanel.classList.contains('active')) return;

          var scrollY = window.scrollY + 200;
          var current = '';
          subsections.forEach(function(section) {
            if (section.offsetTop <= scrollY) {
              current = section.id;
            }
          });
          links.forEach(function(link) {
            link.classList.remove('active');
            if (link.getAttribute('href') === '#' + current) {
              link.classList.add('active');
            }
          });
          if (current) {
            history.replaceState(null, null, '#wiki/' + current);
          }
        }

        window.addEventListener('scroll', onScroll);
        onScroll();
      }

    </script>


