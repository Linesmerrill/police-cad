            <div class="ac-metrics-section-body">
              <p style="font-size:0.75rem;color:var(--ac-text-muted);margin:0 0 1rem;">Track how many users have opted into the new command dashboard for police/LEO departments.</p>

              <div id="metrics-cmd-loading" style="text-align:center;padding:2rem;color:var(--ac-text-muted);">
                <i class="fas fa-spinner fa-spin"></i> Loading metrics...
              </div>

              <div id="metrics-cmd-content" style="display:none;">
                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(170px, 1fr));gap:1rem;margin-bottom:1.5rem;">
                  <div class="ac-stat" style="--stat-accent:#38bdf8;animation-delay:0s;">
