        let html = '';
        users.forEach((user, index) => {
          // The search API doesn't return resetPasswordExpires, so we'll fetch it separately
          // For now, show loading state - we'll fetch and update after rendering
          const resetStatus = formatPasswordResetStatus(null); // Start with null, will update
          html += `
            <div class="result-card" data-user-id="${user.id}" data-user-index="${index}">
              <div class="result-header">
                <div>
                  <h5 class="result-title">${user.email || 'No Email'}</h5>
                  <p class="result-subtitle">Username: ${user.username || 'No Username'} | ID: ${user.id}</p>
                </div>
                <div class="action-buttons">
                  <button class="btn btn-secondary btn-sm" onclick="viewUserDetails('${user.id}')">
                    <i class="fas fa-eye"></i> View Details
                  </button>
                  <button class="btn btn-secondary btn-sm" onclick="initiateUserPasswordReset('${user.id}', '${user.email}')">
                    <i class="fas fa-key"></i> Reset Password
                  </button>
                  ${user.isDeactivated ? `<button class="btn btn-success btn-sm" onclick="reactivateUserAccount('${user.id}', '${user.email}')">
                    <i class="fas fa-user-check"></i> Reactivate Account
                  </button>` : ''}
                </div>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <div class="info-label">Status</div>
                  <div class="info-value">
                    <span class="status-badge ${user.isDeactivated ? 'status-inactive' : 'status-active'}">
                      ${user.isDeactivated ? 'Deactivated' : 'Active'}
                    </span>
                  </div>
                </div>
                <div class="info-item">
                  <div class="info-label">Created</div>
                  <div class="info-value">${new Date(user.createdAt).toLocaleDateString()}</div>
                </div>
                <div class="info-item">
                  <div class="info-label">Password Reset Status</div>
                  <div class="info-value reset-status-${user.id}">
                    <span style="color: #9aa0b4;"><i class="fas fa-spinner fa-spin"></i> Loading...</span>
                  </div>
                </div>
              </div>
            </div>
          `;
        });
        
        // After rendering, fetch reset password status for each user
        // Fetch in parallel but stagger slightly to avoid overwhelming the API
        users.forEach((user, index) => {
          setTimeout(() => {
            $.ajax({
              url: `${API_BASE}/api/v1/admin/users/${user.id}`,
              method: 'GET',
              success: function(data) {
                if (data.user) {
                  const resetPasswordExpires = data.user.user?.resetPasswordExpires || data.user.resetPasswordExpires;
                  const resetStatus = formatPasswordResetStatus(resetPasswordExpires);
                  $(`.reset-status-${user.id}`).html(resetStatus.html);
                } else {
                  $(`.reset-status-${user.id}`).html('<span style="color: #9aa0b4;">Never requested</span>');
                }
              },
              error: function(xhr) {
                // Silently fail and show "Never requested"
                $(`.reset-status-${user.id}`).html('<span style="color: #9aa0b4;">Never requested</span>');
              }
            });
          }, index * 50); // Stagger requests by 50ms to avoid overwhelming the API
        });
        
        // Add pagination controls
        html += generatePaginationControls('user', totalRecords, currentPage);
        
        $('#userResults').html(html);
      }
      
