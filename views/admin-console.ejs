      // Helper function to format password reset status
      function formatPasswordResetStatus(resetPasswordExpires) {
        if (!resetPasswordExpires) {
          return {
            html: '<span style="color: #9aa0b4;">Never requested</span>',
            text: 'Never requested'
          };
        }
        
        // Handle MongoDB date format { "$date": "2025-11-27T21:21:12.678Z" }
        let expirationDate;
        if (resetPasswordExpires.$date) {
          expirationDate = new Date(resetPasswordExpires.$date);
        } else if (typeof resetPasswordExpires === 'string') {
          expirationDate = new Date(resetPasswordExpires);
        } else {
          expirationDate = new Date(resetPasswordExpires);
        }
        
        // Check if date is valid
        if (isNaN(expirationDate.getTime())) {
          return {
            html: '<span style="color: #9aa0b4;">Never requested</span>',
            text: 'Never requested'
          };
        }
        
        const now = new Date();
        // Calculate when reset was requested (approximately 1 hour before expiration)
        const resetRequestedDate = new Date(expirationDate.getTime() - 3600000);
        const hoursSinceRequest = (now.getTime() - resetRequestedDate.getTime()) / (1000 * 60 * 60);
        const isExpired = expirationDate < now;
        const isRecent = !isExpired && hoursSinceRequest < 24;
        
        const dateStr = resetRequestedDate.toLocaleDateString();
        
        if (isExpired) {
          return {
            html: `
              <span style="color: #6b7280; opacity: 0.7;">
                ${dateStr}
              </span>
              <span class="status-badge status-muted" style="margin-left: 0.5rem;">Expired</span>
            `,
            text: `${dateStr} (Expired)`
          };
        } else if (isRecent) {
          return {
            html: `
              <span style="color: #10b981;">
                ${dateStr}
              </span>
            `,
            text: dateStr
          };
        } else {
          return {
            html: `<span style="color: #9aa0b4;">${dateStr}</span>`,
            text: dateStr
          };
        }
      }
      
