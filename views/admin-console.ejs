                      <i class="fas fa-search"></i> ${ownerDisplay}
                    </button>
                  ` : ownerDisplay;
                })()}
              </div>
            </div>
            <div class="info-item">
              <div class="info-label">Visibility</div>
              <div class="info-value">
                <span class="status-badge ${getVisibilityStatusClass(community.visibility)}">
                  ${getVisibilityDisplayText(community.visibility)}
                </span>
              </div>
            </div>
            <div class="info-item">
              <div class="info-label">Created</div>
              <div class="info-value">${new Date(community.createdAt).toLocaleDateString()}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Total Members</div>
              <div class="info-value">${community.memberCount || 0}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Departments</div>
              <div class="info-value">${community.departments?.length || 0}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Subscription</div>
              <div class="info-value">
                ${(() => {
                  if (community.subscription && community.subscription.active) {
                    const plan = community.subscription.plan || 'Unknown';
                    const expirationDate = community.subscription.expirationDate ? new Date(community.subscription.expirationDate).toLocaleDateString() : 'Unknown';
                    const purchaseDate = community.subscription.purchaseDate ? new Date(community.subscription.purchaseDate).toLocaleDateString() : 'Unknown';
                    const isAnnual = community.subscription.isAnnual;
                    const durationText = isAnnual ? 'Annual' : `${community.subscription.durationMonths || 1} Month${community.subscription.durationMonths > 1 ? 's' : ''}`;
                    
                    // Enhanced plan display with better formatting
                    const planDisplay = plan === 'elite' ? 'Elite' : 
                                     plan === 'premium' ? 'Premium' : 
                                     plan === 'standard' ? 'Standard' : 
                                     plan === 'basic' ? 'Basic' : 
                                     plan.charAt(0).toUpperCase() + plan.slice(1);
                    
                    // Check if subscription is expiring soon (within 30 days)
                    const expDate = new Date(community.subscription.expirationDate);
                    const now = new Date();
                    const daysUntilExpiry = Math.ceil((expDate - now) / (1000 * 60 * 60 * 24));
                    const isExpiringSoon = daysUntilExpiry <= 30 && daysUntilExpiry > 0;
                    const isExpired = daysUntilExpiry <= 0;
                    
                    // Dynamic status badge color based on expiry
                    const statusClass = isExpired ? 'status-inactive' : isExpiringSoon ? 'status-warning' : 'status-active';
                    const statusText = isExpired ? 'Expired' : isExpiringSoon ? 'Expiring Soon' : 'Active';
                    
                    return `
                      <span class="status-badge ${statusClass}" style="margin-bottom: 0.5rem; display: block;">${statusText}</span>
                      <div style="font-size: 0.9rem; color: #9aa0b4;">
                        <div><strong>Plan:</strong> ${planDisplay}</div>
                        <div><strong>Duration:</strong> ${durationText}</div>
                        <div><strong>Started:</strong> ${purchaseDate}</div>
                        <div><strong>Expires:</strong> ${expirationDate}</div>
                        ${isExpiringSoon ? `<div style="color: #f59e0b; font-weight: bold;">⚠️ Expires in ${daysUntilExpiry} day${daysUntilExpiry > 1 ? 's' : ''}</div>` : ''}
                        ${isExpired ? `<div style="color: #ef4444; font-weight: bold;">❌ Subscription expired</div>` : ''}
                      </div>
                    `;
                  } else if (community.subscription && !community.subscription.active) {
                    // Subscription exists but is inactive
                    const plan = community.subscription.plan || 'Unknown';
                    const planDisplay = plan === 'elite' ? 'Elite' : 
                                     plan === 'premium' ? 'Premium' : 
                                     plan === 'standard' ? 'Standard' : 
                                     plan === 'basic' ? 'Basic' : 
                                     plan.charAt(0).toUpperCase() + plan.slice(1);
                    
                    // Check if it's expired or just inactive
                    const expDate = community.subscription.expirationDate ? new Date(community.subscription.expirationDate) : null;
                    const now = new Date();
                    const isExpired = expDate && expDate < now;
                    const daysSinceExpiry = expDate ? Math.ceil((now - expDate) / (1000 * 60 * 60 * 24)) : null;
                    
                    return `
                      <span class="status-badge status-inactive" style="margin-bottom: 0.5rem; display: block;">Inactive</span>
                      <div style="font-size: 0.9rem; color: #9aa0b4;">
                        <div><strong>Plan:</strong> ${planDisplay}</div>
                        <div><strong>Status:</strong> ${isExpired ? 'Expired' : 'Cancelled'}</div>
                        ${isExpired && daysSinceExpiry ? `<div style="color: #9ca3af;">Expired ${daysSinceExpiry} day${daysSinceExpiry > 1 ? 's' : ''} ago</div>` : ''}
                        ${expDate ? `<div><strong>Expired:</strong> ${expDate.toLocaleDateString()}</div>` : ''}
                      </div>
                    `;
                  } else {
                    // No subscription data
                    return `
                      <span class="status-badge status-muted">No Subscription</span>
                    `;
                  }
                })()}
              </div>
            </div>
          </div>
          
          <div style="margin-top: 2rem;">
            <h5>Departments (${community.departmentCount || 0})</h5>
            ${(() => {
              const departments = community.departments || [];
              const departmentsCount = departments.length;
              if (departmentsCount > 0) {
                return `
                  <div id="departmentsList">
                    ${generateDepartmentsList(departments, 0, 5)}
                  </div>
                  ${departmentsCount > 5 ? generateDepartmentsPagination(departmentsCount, 0) : ''}
                `;
              } else {
                return '<p style="color: #9aa0b4; text-align: center;">No departments</p>';
              }
            })()}
          </div>
          <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.06); display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <button class="ac-btn ac-btn-accent" onclick="openOwnershipResetWizard('${community.id}', '${(community.name || '').replace(/'/g, "\\'")}')">
              <i class="fas fa-shield-alt"></i> Reset Owner & Roles
            </button>
            <button class="ac-btn" onclick="openRemoveMemberForm('${community.id}', '${(community.name || '').replace(/'/g, "\\'")}')">
              <i class="fas fa-user-slash"></i> Remove Member
            </button>
          </div>
        `);
      }

