      // Helper functions for departments pagination
      function generateDepartmentsList(departments, startIndex, count) {
        const endIndex = Math.min(startIndex + count, departments.length);
        const pageDepartments = departments.slice(startIndex, endIndex);
        
        let html = '';
        pageDepartments.forEach(dept => {
          html += `
            <div style="background: #11131a; padding: 1rem; border-radius: 8px; margin: 0.5rem 0; border: 1px solid #2a2d45;">
              <strong>${dept.name || 'Unnamed Department'}</strong> - ${dept.memberCount || 0} ${(dept.memberCount || 0) === 1 ? 'member' : 'members'}
            </div>
          `;
        });
        
        return html;
      }
      
      function generateDepartmentsPagination(totalDepartments, currentPage) {
        const departmentsPerPage = 5;
        const totalPages = Math.ceil(totalDepartments / departmentsPerPage);
        
        if (totalPages <= 1) {
          return '';
        }
        
        const startResult = currentPage * departmentsPerPage + 1;
        const endResult = Math.min((currentPage + 1) * departmentsPerPage, totalDepartments);
        
        let html = `
          <div class="departments-pagination" style="margin-top: 1rem; text-align: center; padding: 1rem; border-top: 1px solid #2a2d45;">
            <div class="pagination-info" style="margin-bottom: 1rem; color: #9aa0b4;">
              Showing ${startResult}-${endResult} of ${totalDepartments} departments
            </div>
            <div class="pagination-controls">
        `;
        
        // Previous button
        if (currentPage > 0) {
          html += `<button class="btn btn-secondary btn-sm" onclick="changeDepartmentsPage(-1)" style="margin-right: 0.5rem;">
            <i class="fas fa-chevron-left"></i> Previous
          </button>`;
        } else {
          html += `<button class="btn btn-secondary btn-sm" disabled style="margin-right: 0.5rem;">
            <i class="fas fa-chevron-left"></i> Previous
          </button>`;
        }
        
        // Page info
        html += `<span style="margin: 0 1rem; color: #9aa0b4;">Page ${currentPage + 1} of ${totalPages}</span>`;
        
        // Next button
        if (currentPage < totalPages - 1) {
          html += `<button class="btn btn-secondary btn-sm" onclick="changeDepartmentsPage(1)" style="margin-left: 0.5rem;">
            Next <i class="fas fa-chevron-right"></i>
          </button>`;
        } else {
          html += `<button class="btn btn-secondary btn-sm" disabled style="margin-left: 0.5rem;">
            Next <i class="fas fa-chevron-right"></i>
          </button>`;
        }
        
        html += `
            </div>
          </div>
        `;
        
        return html;
      }
      

      
      function changeDepartmentsPage(direction) {
        const newPage = currentDepartmentsPage + direction;
        const totalPages = Math.ceil(currentCommunityDepartments.length / 5);
        
        if (newPage < 0 || newPage >= totalPages) {
          return;
        }
        
        currentDepartmentsPage = newPage;
        
        // Update departments list
        $('#departmentsList').html(generateDepartmentsList(currentCommunityDepartments, currentDepartmentsPage, 5));
        
        // Update pagination controls
        const totalDepartments = currentCommunityDepartments.length;
        $('.departments-pagination').replaceWith(generateDepartmentsPagination(totalDepartments, currentDepartmentsPage));
      }
      
      // Helper functions for visibility display
      function getVisibilityStatusClass(visibility) {
        switch(visibility) {
          case 'public':
            return 'status-active';
          case 'private':
            return 'status-inactive';
          default:
            return 'status-muted';
        }
      }
      
      function getVisibilityDisplayText(visibility) {
        switch(visibility) {
          case 'public':
            return 'Public';
          case 'private':
            return 'Private';
          default:
            return 'Unknown';
        }
      }
      
      // Function to search for a user by email and switch to users tab
      function searchUserByEmail(userEmail) {
        // Validate email
        if (!userEmail || userEmail.trim() === '') {
          showInfoModal('Invalid Email', 'Cannot search for empty email address.');
          return;
        }
        
        // Close the community modal
        $('#communityModal').modal('hide');

        // Wait a moment for modal to close, then switch panels
        setTimeout(() => {
          acNavTo('users');

          // Set the search input value
          $('#userSearch').val(userEmail);

          // Trigger the search
          searchUsers(userEmail, 0);
          
          // Track this action
          trackAdminAction('user_search', `Searched for user from community details: "${userEmail}"`);
        }, 300);
      }
      
      // Admin Management Functions
      function showAddAdminModal() {
        $('#newAdminEmail').val('');
        $('#adminRole').val('admin');
        
        // Clear any previous error messages
        $('#addAdminModal .alert').remove();
        
        $('#addAdminModal').modal('show');
      }
      
      function addNewAdmin() {
        // Check if user has permission to create admins
        if (!roles.includes('owner')) {
          showInfoModal('Error', 'Access denied. Owner privileges required to create admin users.');
          return;
        }
        
        const email = $('#newAdminEmail').val().trim();
        const role = $('#adminRole').val();
        
        if (!email) {
          showInfoModal('Error', 'Please enter an email address');
          return;
        }
        
        if (!email.includes('@')) {
          showInfoModal('Error', 'Please enter a valid email address');
          return;
        }
        
        // Show loading state
        const addButton = $('#addAdminModal .btn-gradient');
        const originalText = addButton.html();
        addButton.html('<i class="fas fa-spinner fa-spin"></i> Adding...');
        addButton.prop('disabled', true);
        

        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/users`,
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          data: JSON.stringify({ 
            email: email, 
            role: role,
            // Send current user's credentials for permission check
            currentUser: {
              email: currentUserEmail,
              roles: roles
            }
          }),
          contentType: 'application/json',
          success: function(data) {
            $('#addAdminModal').modal('hide');
            showAdminResetLink(data.resetLink, email, role);
            
            // Log the admin creation action
            logAdminAction('admin_creation', 'Admin user created', `Created new admin user: ${email} with role: ${role}`);
          },
          error: function(xhr) {
            // Show error message in the current modal instead of opening a new one
            let errorMessage = 'Unknown error';
            let errorCode = '';
            let isDuplicateUser = false;
            
            // Try to get the error message and code from the response
            if (xhr.responseJSON) {
              errorMessage = xhr.responseJSON.error || 'Unknown error';
              errorCode = xhr.responseJSON.code || '';
              isDuplicateUser = errorCode === 'DUPLICATE_USER';
            } else if (xhr.responseText) {
              // Fallback to response text if JSON parsing failed
              try {
                const response = JSON.parse(xhr.responseText);
                if (response.error) {
                  errorMessage = response.error;
                  errorCode = response.code || '';
                  isDuplicateUser = errorCode === 'DUPLICATE_USER';
                }
              } catch (e) {
                // If we can't parse JSON, use the raw response text
                errorMessage = xhr.responseText || 'Unknown error';
              }
            }
            
            let errorHtml = `
              <div class="alert alert-danger" style="background: #ef4444; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i>
                ${errorMessage}
              </div>
            `;
            
            // If it's a duplicate user, add a button to send them a new reset password
            if (isDuplicateUser) {
              const email = $('#newAdminEmail').val().trim();
              errorHtml += `
                <div class="alert alert-info" style="background: #3b82f6; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                  <i class="fas fa-info-circle" style="margin-right: 8px;"></i>
                  This admin already exists. You can send them a new password reset link.
                  <div style="margin-top: 1rem;">
                    <button class="btn btn-secondary" onclick="sendExistingAdminReset('${email}')">
                      <i class="fas fa-envelope" style="margin-right: 8px;"></i>Send New Reset Password
                    </button>
                  </div>
                </div>
              `;
            }
            
            // Insert error message at the top of the modal body
            $('#addAdminModal .modal-body').prepend(errorHtml);
          },
          complete: function() {
            // Restore button state
            addButton.html(originalText);
            addButton.prop('disabled', false);
          }
        });
      }
      
      function showAdminResetLink(resetLink, email, role) {
        $('#adminResetLinkBody').html(`
          <div class="alert alert-success" style="background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
            <i class="fas fa-check-circle" style="margin-right: 8px;"></i>
            Admin account created successfully for <strong>${email}</strong> with role <strong>${role}</strong>
          </div>
          
          <div class="form-group">
            <label style="color: #e5e7eb; margin-bottom: 0.5rem;">Set Password Link</label>
            <div class="input-group">
              <input type="text" class="form-control" value="${resetLink}" readonly 
                     style="background: #11131a; border: 1px solid #2a2d45; color: #e5e7eb;">
              <div class="input-group-btn">
                <button class="btn btn-gradient" onclick="copyToClipboard('${resetLink}', event)">
                  <i class="fas fa-copy"></i> Copy
                </button>
              </div>
            </div>
          </div>
          
          <div class="form-group">
            <label style="color: #e5e7eb; margin-bottom: 0.5rem;">Send Set Password Email</label>
            <button class="btn btn-secondary btn-block" onclick="sendAdminResetEmail('${email}')">
              <i class="fas fa-envelope" style="margin-right: 8px;"></i>Send Set Password Email to ${email}
            </button>
          </div>
          
          <div class="alert alert-info" style="background: #3b82f6; color: #fff; border: none; border-radius: 8px; padding: 1rem;">
            <i class="fas fa-info-circle" style="margin-right: 8px;"></i>
            The new admin can use this link to create their password and then login to the admin console.
          </div>
        `);
        
        $('#adminResetLinkModal').modal('show');
      }
      
      function sendAdminResetEmail(email) {
        const safeEmail = escapeHtml(email);
        const button = $(`button[onclick*="sendAdminResetEmail('${safeEmail}')"]`);
        button.data('original-html', button.html());
        button.html('<i class="fas fa-spinner fa-spin"></i> Sending...');
        button.prop('disabled', true);

        $.ajax({
          url: `${API_BASE}/api/v1/admin/send-reset-email`,
          method: 'POST',

          data: JSON.stringify({ email: email }),
          contentType: 'application/json',
          success: function(data) {
            // Show success message in the current modal instead of opening a new one
            const successHtml = `
              <div class="alert alert-success" style="background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-check-circle" style="margin-right: 8px;"></i>
                Password reset email sent successfully to ${safeEmail}
              </div>
            `;

            // Insert success message at the top of the modal body
            $('#adminResetLinkBody').prepend(successHtml);

            // Disable the send email button since it was sent
            button.prop('disabled', true);
            button.html('<i class="fas fa-check"></i> Email Sent');
            button.removeClass('btn-secondary').addClass('btn-success');

            // Track this action
            trackAdminAction('admin_reset_email', `Sent password reset email to admin: ${email}`);
          },
          error: function(xhr) {
            // Show error message in the current modal
            const errorMsg = escapeHtml(xhr.responseJSON?.error || 'Unknown error');
            const errorHtml = `
              <div class="alert alert-danger" style="background: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i>
                Failed to send email: ${errorMsg}
            </div>
            `;

            // Insert error message at the top of the modal body
            $('#adminResetLinkBody').prepend(errorHtml);
          },
          complete: function() {
            // Only restore button if there was an error
            if (button.hasClass('btn-success')) {
              return; // Button was successfully sent, don't change it
            }
            button.html(button.data('original-html'));
            button.prop('disabled', false);
          }
        });
      }
      
      function sendExistingAdminReset(email) {
        // Show loading state
        const safeEmail = escapeHtml(email);
        const button = $(`button[onclick*="sendExistingAdminReset('${safeEmail}')"]`);
        button.data('original-html', button.html());
        button.html('<i class="fas fa-spinner fa-spin"></i> Sending...');
        button.prop('disabled', true);

        $.ajax({
          url: `${API_BASE}/api/v1/admin/send-reset-email`,
          method: 'POST',

          data: JSON.stringify({ email: email }),
          contentType: 'application/json',
          success: function(data) {
            // Replace the error and info alerts with success message
            $('#addAdminModal .alert').remove();

            const successHtml = `
              <div class="alert alert-success" style="background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-check-circle" style="margin-right: 8px;"></i>
                New password reset email sent successfully to ${safeEmail}
              </div>
            `;

            $('#addAdminModal .modal-body').prepend(successHtml);

            // Disable the send button and change its text
            button.prop('disabled', true);
            button.html('<i class="fas fa-check"></i> Email Sent');
            button.removeClass('btn-secondary').addClass('btn-success');

            // Clear the email input since we successfully sent the reset
            $('#newAdminEmail').val('');

            // Track this action
            trackAdminAction('admin_reset_existing', `Sent reset email to existing admin: ${email}`);
          },
          error: function(xhr) {
            // Show error message
            const errorMessage = escapeHtml(
              (xhr.responseJSON && xhr.responseJSON.error) ? xhr.responseJSON.error : 'Unknown error'
            );

            const errorHtml = `
              <div class="alert alert-danger" style="background: #ef4444; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i>
                Failed to send reset email: ${errorMessage}
              </div>
            `;

            $('#addAdminModal .modal-body').prepend(errorHtml);
          },
          complete: function() {
            // Only restore button if there was an error
            if (button.hasClass('btn-success')) {
              return; // Button was successfully sent, don't change it
            }
            button.html(button.data('original-html'));
            button.prop('disabled', false);
          }
        });
      }

      // =====================================================
      // CONTENT CREATOR MANAGEMENT FUNCTIONS
