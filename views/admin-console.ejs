          $('#searchCCBtn').click();
        }
      });

      function loadCCStats() {
        // Load submitted count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=submitted&limit=1`,
          method: 'GET',
          success: function(data) {
            const count = data.pagination?.totalItems || 0;
            $('#ccStatPending').text(count);
            // Update filter badge
            if (count > 0) {
              $('#ccSubmittedCount').text(count).show();
            } else {
              $('#ccSubmittedCount').hide();
            }
          }
        });

        // Load under_review count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=under_review&limit=1`,
          method: 'GET',
          success: function(data) {
            const count = data.pagination?.totalItems || 0;
            $('#ccStatUnderReview').text(count);
            // Update filter badge
            if (count > 0) {
              $('#ccUnderReviewCount').text(count).show();
            } else {
              $('#ccUnderReviewCount').hide();
            }
          }
        });

        // Load approved count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=approved&limit=1`,
          method: 'GET',
          success: function(data) {
            $('#ccStatApproved').text(data.pagination?.totalItems || 0);
          }
        });

        // Load rejected count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=rejected&limit=1`,
          method: 'GET',
          success: function(data) {
            $('#ccStatRejected').text(data.pagination?.totalItems || 0);
          }
        });

        // Load active creators count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creators?status=active&limit=1`,
          method: 'GET',
          success: function(data) {
            $('#ccStatActive').text(data.pagination?.totalItems || 0);
          }
        });

        // Load withdrawn count for the filter badge
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=withdrawn&limit=1`,
          method: 'GET',
          success: function(data) {
            const count = data.pagination?.totalItems || 0;
            if (count > 0) {
              $('#ccWithdrawnCount').text(count).show();
            } else {
              $('#ccWithdrawnCount').hide();
            }
          }
        });
      }

      function loadCCPendingCount() {
        let submittedCount = 0;
        let underReviewCount = 0;

        // Load submitted count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=submitted&limit=1`,
          method: 'GET',
          success: function(data) {
            submittedCount = data.pagination?.totalItems || 0;
            if (submittedCount > 0) {
              $('#ccSubmittedCount').text(submittedCount).show();
            } else {
              $('#ccSubmittedCount').hide();
            }
            updateTabBadge();
          },
          error: function() {
            $('#ccSubmittedCount').hide();
            updateTabBadge();
          }
        });

        // Load under_review count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=under_review&limit=1`,
          method: 'GET',
          success: function(data) {
            underReviewCount = data.pagination?.totalItems || 0;
            if (underReviewCount > 0) {
              $('#ccUnderReviewCount').text(underReviewCount).show();
            } else {
              $('#ccUnderReviewCount').hide();
            }
            updateTabBadge();
          },
          error: function() {
            $('#ccUnderReviewCount').hide();
            updateTabBadge();
          }
        });

        // Update tab badge to show submitted (red) or under_review (yellow) count
        function updateTabBadge() {
          if (submittedCount > 0) {
            // Show red badge for submitted applications (needs first review)
            $('#ccPendingBadge').text(submittedCount).css('background', '#ef4444').show();
          } else if (underReviewCount > 0) {
            // Show yellow badge for under_review applications (needs second approval)
            $('#ccPendingBadge').text(underReviewCount).css('background', '#f59e0b').show();
          } else {
            $('#ccPendingBadge').hide();
          }
        }
      }

      function loadCCApplications() {
        const searchQuery = $('#ccSearch').val().trim();
        let url = `${API_BASE}/api/v1/admin/content-creator-applications?page=${currentCCPage}&limit=${ccPageSize}`;

        if (currentCCStatus) {
          url += `&status=${currentCCStatus}`;
        } else {
          // "All" excludes withdrawn - show only active applications
          url += `&exclude_status=withdrawn`;
        }

        $('#ccApplicationResults').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading applications...</div>');

        $.ajax({
          url: url,
          method: 'GET',
          success: function(data) {
            displayCCApplications(data.applications || [], data.pagination);
          },
          error: function(xhr) {
            $('#ccApplicationResults').html('<div class="loading">Failed to load applications</div>');
            showInfoModal('Error', `Error loading applications: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }

      function displayCCApplications(applications, pagination) {
        if (applications.length === 0) {
          $('#ccApplicationResults').html(`
            <div class="no-users-found">
              <div class="no-users-message">
                <i class="fas fa-inbox" style="font-size: 3rem; color: #667eea; margin-bottom: 1rem;"></i>
                <h4 style="color: #e5e7eb;">No Applications Found</h4>
                <p style="color: #9aa0b4;">There are no applications matching your criteria.</p>
              </div>
            </div>
          `);
          $('#ccPagination').hide();
          return;
        }

        let html = '';
        const currentAdminId = getCurrentAdminId();

        applications.forEach(app => {
          const appId = app._id || app.id;
          const displayName = app.displayName || 'Unknown';
          const status = app.status || 'unknown';
          const createdAt = app.createdAt ? new Date(app.createdAt).toLocaleDateString() : 'Unknown';
          const primaryPlatform = app.primaryPlatform || 'Unknown';

          // Calculate total followers
          let totalFollowers = 0;
          if (app.platforms && Array.isArray(app.platforms)) {
            totalFollowers = app.platforms.reduce((sum, p) => sum + (p.followerCount || 0), 0);
          }

          // Check if current admin already approved
          const currentAdminAlreadyApproved = app.firstApprovalBy && app.firstApprovalBy === currentAdminId;

          // Status badge styling
          const statusColors = {
            'submitted': { bg: '#3b82f6', label: 'Submitted' },
            'under_review': { bg: '#f59e0b', label: 'Under Review' },
            'approved': { bg: '#10b981', label: 'Approved' },
            'rejected': { bg: '#ef4444', label: 'Rejected' },
            'withdrawn': { bg: '#6b7280', label: 'Withdrawn' }
          };
          const statusStyle = statusColors[status] || { bg: '#6b7280', label: status };

          // Build approval progress badge
          let approvalBadgeHtml = '';
          if (status === 'under_review' && app.firstApprovalBy) {
            approvalBadgeHtml = `<span style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; font-size: 0.85rem; padding: 0.2rem 0.6rem; border-radius: 10px; margin-left: 6px; font-weight: 600;"><i class="fas fa-user-check" style="margin-right: 3px;"></i>1/2</span>`;
          }

          // Build approve button based on whether current admin already approved
          let approveButtonHtml = '';
          if (status === 'submitted' || status === 'under_review') {
            if (currentAdminAlreadyApproved) {
              approveButtonHtml = `
                <button class="btn btn-success btn-sm" disabled style="opacity: 0.5; cursor: not-allowed;">
                  <i class="fas fa-check"></i> Approved
                </button>
              `;
            } else {
              approveButtonHtml = `
                <button class="btn btn-success btn-sm" onclick="approveCCApplication('${appId}')">
                  <i class="fas fa-check"></i> Approve
                </button>
              `;
            }
          }

          // Build first approval info line
          let firstApprovalInfoHtml = '';
          if (app.firstApprovalBy && (status === 'under_review' || status === 'submitted')) {
            const approvalTime = app.firstApprovalAt ? new Date(app.firstApprovalAt).toLocaleString([], { month: 'numeric', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
            firstApprovalInfoHtml = `<span style="color: #f59e0b; font-size: 0.95rem; margin-left: 8px;"><i class="fas fa-user-check" style="margin-right: 4px;"></i>1st approval${approvalTime ? ' on ' + approvalTime : ''}${currentAdminAlreadyApproved ? ' (you)' : ''}</span>`;
          }

          html += `
            <div class="result-card">
              <div class="result-header">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <div>
                    <h5 class="result-title" style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                      ${displayName}
                      <span class="status-badge" style="background: ${statusStyle.bg}; color: #fff; font-size: 0.7rem; padding: 0.2rem 0.6rem;">${statusStyle.label}</span>
                      ${approvalBadgeHtml}
                    </h5>
                    <p class="result-subtitle">Applied: ${createdAt} | Platform: ${primaryPlatform} | Followers: ${totalFollowers.toLocaleString()}${firstApprovalInfoHtml}</p>
                  </div>
                </div>
                <div class="action-buttons">
                  <button class="btn btn-secondary btn-sm" onclick="viewCCApplication('${appId}')">
                    <i class="fas fa-eye"></i> View Details
                  </button>
                  ${approveButtonHtml}
                  ${status === 'submitted' || status === 'under_review' ? `
                    <button class="btn btn-danger btn-sm" onclick="showRejectModal('${appId}')">
                      <i class="fas fa-times"></i> Reject
                    </button>
                  ` : ''}
                  ${status === 'approved' && app.creatorId ? (
                    app.creatorStatus === 'removed' ? `
                    <button class="btn btn-danger btn-sm" disabled style="opacity: 0.5; cursor: not-allowed;">
                      <i class="fas fa-user-slash"></i> Removed
                    </button>
                  ` : `
                    <button class="btn btn-danger btn-sm" onclick="showRemoveModal('${app.creatorId}', '${displayName.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}')">
                      <i class="fas fa-user-slash"></i> Remove
                    </button>
                  `) : ''}
                </div>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <div class="info-label">Description</div>
                  <div class="info-value" style="max-height: 60px; overflow: hidden; text-overflow: ellipsis;">${app.description || 'No description'}</div>
                </div>
              </div>
            </div>
          `;
        });

        $('#ccApplicationResults').html(html);

        // Update pagination
        if (pagination && pagination.totalPages > 1) {
          let paginationHtml = '';

          // Previous button
          paginationHtml += `
            <li class="page-item ${pagination.hasPrevPage ? '' : 'disabled'}">
              <a class="page-link" href="#" onclick="changeCCPage(${currentCCPage - 1}); return false;" style="background: #1e2028; border-color: #35385a; color: #e5e7eb;">
                <i class="fas fa-chevron-left"></i>
              </a>
            </li>
          `;

          // Page numbers
          for (let i = 1; i <= pagination.totalPages; i++) {
            if (i === currentCCPage || i === 1 || i === pagination.totalPages || (i >= currentCCPage - 1 && i <= currentCCPage + 1)) {
              paginationHtml += `
                <li class="page-item ${i === currentCCPage ? 'active' : ''}">
                  <a class="page-link" href="#" onclick="changeCCPage(${i}); return false;"
                     style="background: ${i === currentCCPage ? '#667eea' : '#1e2028'}; border-color: #35385a; color: #e5e7eb;">
                    ${i}
                  </a>
                </li>
              `;
            } else if (i === currentCCPage - 2 || i === currentCCPage + 2) {
              paginationHtml += `<li class="page-item disabled"><span class="page-link" style="background: #1e2028; border-color: #35385a; color: #9aa0b4;">...</span></li>`;
            }
          }

          // Next button
          paginationHtml += `
            <li class="page-item ${pagination.hasNextPage ? '' : 'disabled'}">
              <a class="page-link" href="#" onclick="changeCCPage(${currentCCPage + 1}); return false;" style="background: #1e2028; border-color: #35385a; color: #e5e7eb;">
                <i class="fas fa-chevron-right"></i>
              </a>
            </li>
          `;

          $('#ccPaginationList').html(paginationHtml);
          $('#ccPagination').show();
        } else {
          $('#ccPagination').hide();
        }
      }

      function changeCCPage(page) {
        currentCCPage = page;
        loadCCApplications();
      }

      function viewCCApplication(appId) {
        $('#ccApplicationModalTitle').text('Loading Application...');
        $('#ccApplicationModalBody').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading...</div>');
        $('#ccApplicationModalFooter').html('<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>');
        $('#ccApplicationModal').modal('show');

        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications/${appId}`,
          method: 'GET',
          success: function(app) {
            displayCCApplicationDetails(app);
          },
          error: function(xhr) {
            $('#ccApplicationModalBody').html('<div class="loading">Failed to load application details</div>');
          }
        });
      }

      function displayCCApplicationDetails(app) {
        const appId = app._id || app.id;
        const displayName = app.displayName || 'Unknown';
        const status = app.status || 'unknown';
        const createdAt = app.createdAt ? new Date(app.createdAt).toLocaleString() : 'Unknown';
        const reviewedAt = app.reviewedAt ? new Date(app.reviewedAt).toLocaleString() : 'N/A';
        const primaryPlatform = app.primaryPlatform || 'Unknown';

        // Status badge styling
        const statusColors = {
          'submitted': { bg: '#3b82f6', label: 'Submitted' },
          'under_review': { bg: '#f59e0b', label: 'Under Review' },
          'approved': { bg: '#10b981', label: 'Approved' },
          'rejected': { bg: '#ef4444', label: 'Rejected' },
          'withdrawn': { bg: '#6b7280', label: 'Withdrawn' }
        };
        const statusStyle = statusColors[status] || { bg: '#6b7280', label: status };

        // Build platforms HTML
        let platformsHtml = '';
        if (app.platforms && Array.isArray(app.platforms)) {
          app.platforms.forEach(p => {
            const platformIcons = {
              'youtube': 'fab fa-youtube',
              'twitch': 'fab fa-twitch',
              'tiktok': 'fab fa-tiktok',
              'instagram': 'fab fa-instagram',
              'twitter': 'fab fa-twitter',
              'facebook': 'fab fa-facebook',
              'other': 'fas fa-globe'
            };
            const icon = platformIcons[p.type] || 'fas fa-globe';

            const cleanHandle = p.handle ? p.handle.replace(/^@+/, '') : '';
            const safeHandle = escapeHtml(cleanHandle);

            // Build the actual profile URL from platform type + handle
            const platformBaseUrls = {
              twitch: 'https://twitch.tv/',
              youtube: 'https://youtube.com/@',
              tiktok: 'https://tiktok.com/@',
              instagram: 'https://instagram.com/',
              twitter: 'https://twitter.com/',
              facebook: 'https://facebook.com/'
            };
            // Always prefer building URL from platform type + handle when both are known
            // p.url from the database is unreliable (can contain wrong domains)
            let profileUrl = '';
            if (cleanHandle && platformBaseUrls[p.type]) {
              profileUrl = platformBaseUrls[p.type] + cleanHandle;
            } else if (p.url) {
              profileUrl = p.url;
            }
            const safeProfileUrl = escapeHtml(profileUrl);

            const profileLink = (safeProfileUrl && safeHandle)
              ? `<a href="${safeProfileUrl}" target="_blank" rel="noopener noreferrer" style="color: #667eea; text-decoration: none; font-size: 1rem;">@${safeHandle} <i class="fas fa-external-link-alt" style="font-size: 0.625rem; margin-left: 4px; opacity: 0.7;"></i></a>`
              : safeProfileUrl
                ? `<a href="${safeProfileUrl}" target="_blank" rel="noopener noreferrer" style="color: #667eea; text-decoration: none; font-size: 1rem; word-break: break-all;">${safeProfileUrl} <i class="fas fa-external-link-alt" style="font-size: 0.625rem; margin-left: 4px; opacity: 0.7;"></i></a>`
                : (safeHandle ? `<span style="color: #9aa0b4; font-size: 1rem;">@${safeHandle}</span>` : '');

            platformsHtml += `
              <div class="info-item" style="margin-bottom: 1rem; padding: 1rem; background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
                  <i class="${icon}" style="color: #667eea; font-size: 1.25rem;"></i>
                  <span style="color: #e5e7eb; font-weight: 600; text-transform: capitalize; font-size: 1.1rem;">${escapeHtml(p.type)}</span>
                  ${profileLink}
                </div>
                <div style="color: #e5e7eb; font-size: 1rem; font-weight: 500;">
                  ${(p.followerCount || 0).toLocaleString()} followers
                </div>
              </div>
            `;
          });
        }

        // Check if current admin already approved
        const currentAdminId = getCurrentAdminId();
        const currentAdminAlreadyApproved = app.firstApprovalBy && app.firstApprovalBy === currentAdminId;

        // Build approval progress badge
        let approvalProgressHtml = '';
        if (status === 'under_review' && app.firstApprovalBy) {
          approvalProgressHtml = `
            <span style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.85rem; margin-left: 0.5rem;">
              <i class="fas fa-user-check" style="margin-right: 4px;"></i>1/2 Approvals
            </span>
          `;
        } else if (status === 'approved') {
          approvalProgressHtml = `
            <span style="background: rgba(16, 185, 129, 0.2); color: #10b981; padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.85rem; margin-left: 0.5rem;">
              <i class="fas fa-check-double" style="margin-right: 4px;"></i>2/2 Approvals
            </span>
          `;
        }

        $('#ccApplicationModalTitle').text(`Application: ${displayName}`);
        $('#ccApplicationModalBody').html(`
          <div style="margin-bottom: 1rem; display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <span class="status-badge" style="background: ${statusStyle.bg};">${statusStyle.label}</span>
            ${approvalProgressHtml}
          </div>

          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Display Name</div>
              <div class="info-value">${displayName}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Primary Platform</div>
              <div class="info-value">${primaryPlatform}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Applied At</div>
              <div class="info-value">${createdAt}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Reviewed At</div>
              <div class="info-value">${reviewedAt}</div>
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <h5 style="color: #e5e7eb; margin-bottom: 1rem;">
              <i class="fas fa-share-alt" style="margin-right: 8px; color: #667eea;"></i>Platforms
            </h5>
            <div style="background: #11131a; border-radius: 8px; padding: 1rem;">
              ${platformsHtml || '<p style="color: #9aa0b4;">No platforms listed</p>'}
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <h5 style="color: #e5e7eb; margin-bottom: 1rem;">
              <i class="fas fa-align-left" style="margin-right: 8px; color: #667eea;"></i>Description
            </h5>
            <div style="background: #11131a; border-radius: 8px; padding: 1rem; color: #e5e7eb; white-space: pre-wrap;">
              ${app.description || 'No description provided'}
            </div>
          </div>

          ${app.firstApprovalBy ? `
            <div style="margin-top: 1.5rem;">
              <h5 style="color: ${status === 'approved' ? '#10b981' : '#f59e0b'}; margin-bottom: 1rem;">
                <i class="fas fa-user-check" style="margin-right: 8px;"></i>First Approval${app.firstApprovalByName ? ' (' + app.firstApprovalByName + ')' : ''}
              </h5>
              <div style="background: rgba(${status === 'approved' ? '16, 185, 129' : '245, 158, 11'}, 0.1); border: 1px solid rgba(${status === 'approved' ? '16, 185, 129' : '245, 158, 11'}, 0.3); border-radius: 8px; padding: 1rem;">
                <p style="margin-bottom: 0; color: #e5e7eb;">
                  <i class="fas fa-check" style="color: #10b981; margin-right: 8px;"></i>
                  First approval received${app.firstApprovalAt ? ' on ' + new Date(app.firstApprovalAt).toLocaleString([], { month: 'numeric', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : ''}.
                  ${status !== 'approved' ? '<strong style="color: #f59e0b;">Awaiting second approval from a different admin.</strong>' : ''}
                </p>
              </div>
            </div>
          ` : ''}

          ${status === 'approved' && app.reviewedAt ? `
            <div style="margin-top: 1rem;">
              <h5 style="color: #10b981; margin-bottom: 1rem;">
                <i class="fas fa-check-double" style="margin-right: 8px;"></i>Second Approval${app.reviewedByName ? ' (' + app.reviewedByName + ')' : ''}
              </h5>
              <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; padding: 1rem;">
                <p style="margin-bottom: 0; color: #e5e7eb;">
                  <i class="fas fa-check" style="color: #10b981; margin-right: 8px;"></i>
                  Second approval received on ${new Date(app.reviewedAt).toLocaleString([], { month: 'numeric', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })}.
                </p>
              </div>
            </div>
          ` : ''}

          ${app.rejectionReason ? `
            <div style="margin-top: 1.5rem;">
              <h5 style="color: #ef4444; margin-bottom: 1rem;">
                <i class="fas fa-times-circle" style="margin-right: 8px;"></i>Rejection Details
              </h5>
              <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 1rem;">
                <p style="margin-bottom: 0.5rem;"><strong>Reason:</strong> ${app.rejectionReason}</p>
                ${app.feedback ? `<p style="margin-bottom: 0.5rem;"><strong>Feedback:</strong> ${app.feedback}</p>` : ''}
                ${app.adminNotes ? `<p style="margin-bottom: 0; color: #9aa0b4;"><strong>Admin Notes:</strong> ${app.adminNotes}</p>` : ''}
              </div>
            </div>
          ` : ''}
        `);

        // Update footer with action buttons if status allows
        if (status === 'submitted' || status === 'under_review') {
          const approveLabel = app.firstApprovalBy ? 'Second Approve' : 'First Approve';
          const approveIcon = app.firstApprovalBy ? 'fa-check-double' : 'fa-check-circle';

          // Check if current admin already gave first approval
          let approveButtonHtml = '';
          if (currentAdminAlreadyApproved) {
            // Disable button and show message
            approveButtonHtml = `
              <button type="button" class="btn btn-success" disabled style="opacity: 0.6; cursor: not-allowed;">
                <i class="fas fa-check" style="margin-right: 8px;"></i>You Already Approved
              </button>
            `;
          } else {
            approveButtonHtml = `
              <button type="button" class="btn btn-success" onclick="approveCCApplication('${appId}')">
                <i class="fas ${approveIcon}" style="margin-right: 8px;"></i>${approveLabel}
              </button>
            `;
          }

          // Check if current admin is an owner (can use override)
          // Use the globally parsed 'roles' variable instead of re-parsing currentUserRoles
          const isOwner = roles.includes('owner');

          // Owner override button (shown to owners for any pending application - allows bypassing dual-approval entirely)
          let ownerOverrideHtml = '';
          if (isOwner && (status === 'submitted' || status === 'under_review')) {
            ownerOverrideHtml = `
              <button type="button" class="btn" onclick="approveCCApplication('${appId}', true)" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; color: white;">
                <i class="fas fa-shield-alt" style="margin-right: 8px;"></i>Override Approve
              </button>
            `;
          }

          $('#ccApplicationModalFooter').html(`
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            <button type="button" class="btn btn-danger" onclick="$('#ccApplicationModal').modal('hide'); showRejectModal('${appId}');">
              <i class="fas fa-times-circle" style="margin-right: 8px;"></i>Reject
            </button>
            ${approveButtonHtml}
            ${ownerOverrideHtml}
          `);

          // Add a note if current admin already approved
          if (currentAdminAlreadyApproved) {
            $('#ccApplicationModalFooter').append('<div style="width: 100%; margin-top: 0.75rem; text-align: center; color: #f59e0b; font-size: 0.85rem;"><i class="fas fa-info-circle" style="margin-right: 4px;"></i>A different admin must provide the second approval</div>');
          }
        } else if (status === 'approved' && app.creatorId) {
          // For approved creators, show a Remove from Program button (or disabled if already removed)
          const creatorId = app.creatorId;
          const safeDisplayName = displayName.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
          const isRemoved = app.creatorStatus === 'removed';
          $('#ccApplicationModalFooter').html(`
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            ${isRemoved ? `
              <button type="button" class="btn btn-danger" disabled style="opacity: 0.5; cursor: not-allowed;">
                <i class="fas fa-user-slash" style="margin-right: 8px;"></i>Removed
              </button>
            ` : `
              <button type="button" class="btn btn-danger" onclick="$('#ccApplicationModal').modal('hide'); showRemoveModal('${creatorId}', '${safeDisplayName}');">
                <i class="fas fa-user-slash" style="margin-right: 8px;"></i>Remove from Program
              </button>
            `}
          `);
        } else {
          $('#ccApplicationModalFooter').html('<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>');
        }
      }

      function approveCCApplication(appId, ownerOverride = false) {
        const processingMessage = ownerOverride
          ? '<i class="fas fa-spinner fa-spin"></i> Processing approval with owner override...'
          : '<i class="fas fa-spinner fa-spin"></i> Processing approval...';
        showInfoModal('Processing', processingMessage);

        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications/${appId}/approve`,
          method: 'POST',
          contentType: 'application/json',
          headers: {
            'X-User-ID': getCurrentAdminId()
          },
          data: JSON.stringify({ ownerOverride: ownerOverride }),
          success: function(data) {
            $('#infoModal').modal('hide');
            $('#ccApplicationModal').modal('hide');

            if (data.ownerOverride) {
              // Approved via owner override
              showInfoModal('Success', `
                <i class="fas fa-shield-alt" style="color: #667eea; margin-right: 8px;"></i>
                Application approved via <strong>owner override</strong>! A content creator profile has been created.
              `);
            } else if (data.needsSecond) {
              // First approval recorded, needs second
              showInfoModal('First Approval Recorded', `
                <i class="fas fa-user-check" style="color: #f59e0b; margin-right: 8px;"></i>
                Your approval has been recorded. This application now requires a <strong>second approval</strong> from a different admin before the creator profile is created.
              `);
            } else {
              // Fully approved
              showInfoModal('Success', '<i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i>Application approved successfully! A content creator profile has been created.');
            }

            loadCCApplications();
            loadCCStats();
            loadCCPendingCount(); // Update badge
          },
          error: function(xhr) {
            $('#infoModal').modal('hide');

            // Handle specific error cases
            if (xhr.status === 403) {
              // Forbidden - not an owner trying to use override
              showInfoModal('Not Authorized', `
                <i class="fas fa-lock" style="color: #ef4444; margin-right: 8px;"></i>
                Only <strong>owners</strong> can use the override option.
              `);
            } else if (xhr.status === 409) {
              // Conflict - either already approved by this admin or already processed
              const errorMsg = xhr.responseJSON?.error || '';
              if (errorMsg.includes('already approved')) {
                showInfoModal('Already Approved', `
                  <i class="fas fa-info-circle" style="color: #f59e0b; margin-right: 8px;"></i>
                  You have already approved this application. A <strong>different admin</strong> must provide the second approval.
                `);
              } else {
                showInfoModal('Already Processed', `
                  <i class="fas fa-info-circle" style="color: #f59e0b; margin-right: 8px;"></i>
                  This application has already been processed.
                `);
              }
              // Refresh the list to show updated status
              loadCCApplications();
              loadCCStats();
              loadCCPendingCount();
            } else {
              const errorMsg = xhr.responseJSON?.error || xhr.statusText || 'Unknown error';
              showInfoModal('Error', `<i class="fas fa-exclamation-circle" style="color: #ef4444; margin-right: 8px;"></i>Failed to approve application: ${errorMsg}`);
            }
          },
          complete: function() {
            // Ensure modal backdrop is always cleaned up
            setTimeout(function() {
              if (!$('.modal.show').length) {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css('padding-right', '');
              }
            }, 300);
          }
        });
      }

      function showRejectModal(appId) {
        $('#rejectApplicationId').val(appId);
        $('#rejectionReason').val('');
        $('#rejectionFeedback').val('');
        $('#rejectionAdminNotes').val('');
        $('#ccRejectModal').modal('show');
      }

      $('#confirmRejectBtn').click(function() {
        const appId = $('#rejectApplicationId').val();
        const reason = $('#rejectionReason').val();
        const feedback = $('#rejectionFeedback').val();
        const adminNotes = $('#rejectionAdminNotes').val();

        if (!reason) {
          alert('Please select a rejection reason');
          return;
        }

        const button = $(this);
        button.prop('disabled', true);
        button.html('<i class="fas fa-spinner fa-spin"></i> Rejecting...');

        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications/${appId}/reject`,
          method: 'POST',
          contentType: 'application/json',
          headers: {
            'X-User-ID': getCurrentAdminId()
          },
          data: JSON.stringify({
            rejectionReason: reason,
            feedback: feedback,
            adminNotes: adminNotes
          }),
          success: function(data) {
            $('#ccRejectModal').modal('hide');
            showInfoModal('Success', '<i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i>Application rejected successfully.');
            loadCCApplications();
            loadCCStats();
            loadCCPendingCount(); // Update badge
          },
          error: function(xhr) {
            showInfoModal('Error', `<i class="fas fa-exclamation-circle" style="color: #ef4444; margin-right: 8px;"></i>Failed to reject application: ${xhr.responseJSON?.error || 'Unknown error'}`);
          },
          complete: function() {
            button.prop('disabled', false);
            button.html('<i class="fas fa-times-circle" style="margin-right: 8px;"></i>Reject Application');
            // Ensure modal backdrop is always cleaned up
            setTimeout(function() {
              if (!$('.modal.show').length) {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css('padding-right', '');
              }
            }, 300);
          }
        });
      });

      // Content Creator Removal Functions
      function showRemoveModal(creatorId, displayName) {
        $('#removeCreatorId').val(creatorId);
        $('#removeCreatorName').text(displayName);
        $('#removalReason').val('');
        $('#removalDetails').val('');
        $('#ccRemoveModal').modal('show');
      }

      $('#confirmRemoveBtn').click(function() {
        const creatorId = $('#removeCreatorId').val();
        const reason = $('#removalReason').val();
        const details = $('#removalDetails').val();

        if (!reason) {
          alert('Please select a reason for removal');
          return;
        }

        // Combine reason and details
        const fullReason = details ? `${reason}: ${details}` : reason;

        const button = $(this);
        button.prop('disabled', true);
        button.html('<i class="fas fa-spinner fa-spin"></i> Removing...');

        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creators/${creatorId}/remove`,
          method: 'POST',
          contentType: 'application/json',
          headers: {
            'X-User-ID': getCurrentAdminId()
          },
          data: JSON.stringify({
            reason: fullReason
          }),
          success: function(data) {
            $('#ccRemoveModal').modal('hide');
            showInfoModal('Success', '<i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i>Creator has been removed from the program. They have been notified via email.');
            loadCCApplications();
            loadCCStats();
          },
          error: function(xhr) {
            showInfoModal('Error', `<i class="fas fa-exclamation-circle" style="color: #ef4444; margin-right: 8px;"></i>Failed to remove creator: ${xhr.responseJSON?.error || 'Unknown error'}`);
          },
          complete: function() {
            button.prop('disabled', false);
            button.html('<i class="fas fa-user-slash" style="margin-right: 8px;"></i>Remove from Program');
            // Ensure modal backdrop is always cleaned up
            setTimeout(function() {
              if (!$('.modal.show').length) {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css('padding-right', '');
              }
            }, 300);
          }
        });
      });


      // =====================================================
      // METRICS PANEL
      // =====================================================
      var metricsSocket = null;
      var metricsInitialized = false;

      function loadMetricsPanel() {
        if (metricsInitialized) {
          // Already initialized, just re-fetch
          fetchBetaAdoptionMetrics();
          return;
        }
        metricsInitialized = true;
        fetchBetaAdoptionMetrics();
        fetchDailyMetrics();
        initMetricsSocket();
        initMetricsVisibility();
      }

      // -- Beta Adoption Metrics --

      function fetchBetaAdoptionMetrics() {
        $.ajax({
          url: API_BASE + '/api/v1/admin/beta-dashboard-metrics',
          method: 'GET',
          success: function(data) {
            applyBetaAdoptionMetrics(data);
          },
          error: function() {
            $('#metrics-beta-loading').html('<i class="fas fa-exclamation-triangle" style="color:var(--ac-red);"></i> Failed to load metrics');
          }
        });
      }

      function applyBetaAdoptionMetrics(data) {
        var optedIn = data.optedIn || 0;
        var classic = data.classic || 0;
        var total = data.total || 0;
        var pct = total > 0 ? Math.round((optedIn / total) * 100) : 0;

        $('#metrics-beta-opted').text(optedIn.toLocaleString());
        $('#metrics-beta-classic').text(classic.toLocaleString());
        $('#metrics-beta-total').text(total.toLocaleString());
        $('#metrics-beta-pct').text(pct + '%');
        $('#metrics-beta-bar').css('width', pct + '%');
        $('#metrics-beta-loading').hide();
        $('#metrics-beta-content').show();
      }

      // -- Daily Trend Charts --

      function fetchDailyMetrics() {
        $.ajax({
          url: API_BASE + '/api/v1/admin/beta-dashboard-metrics/daily',
          method: 'GET',
          success: function(data) {
            if (data && data.days) {
              renderTrendCharts(data.days);
              $('#metrics-charts-row').show();
            }
          },
          error: function() {
            // Silently fail — charts are supplementary
          }
        });
      }

      function renderTrendCharts(days) {
        var betaValues = days.map(function(d) { return d.betaOptIns; });
        var userValues = days.map(function(d) { return d.newUsers; });
        var labels = days.map(function(d) {
          var parts = d.date.split('-');
          var dt = new Date(parts[0], parts[1] - 1, parts[2]);
          return dt.toLocaleDateString('en-US', { weekday: 'short' });
        });
        var fullLabels = days.map(function(d) {
          var parts = d.date.split('-');
          var dt = new Date(parts[0], parts[1] - 1, parts[2]);
          return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        });

        renderLineChart('chart-beta', betaValues, labels, fullLabels, 'var(--ac-accent)', '#a78bfa');
        renderLineChart('chart-users', userValues, labels, fullLabels, 'var(--ac-green)', '#4ade80');

        // Update totals and trends
        var betaSum = betaValues.reduce(function(a,b) { return a+b; }, 0);
        var userSum = userValues.reduce(function(a,b) { return a+b; }, 0);
        $('#chart-beta-total').text(betaSum.toLocaleString());
        $('#chart-users-total').text(userSum.toLocaleString());

        // Trend: compare last 3 days vs first 3 days
        var betaRecent = betaValues.slice(-3).reduce(function(a,b){return a+b;},0);
        var betaOlder = betaValues.slice(0,3).reduce(function(a,b){return a+b;},0);
        applyTrend('chart-beta-trend', betaRecent, betaOlder);

        var userRecent = userValues.slice(-3).reduce(function(a,b){return a+b;},0);
        var userOlder = userValues.slice(0,3).reduce(function(a,b){return a+b;},0);
        applyTrend('chart-users-trend', userRecent, userOlder);
      }

      function applyTrend(elId, recent, older) {
        var $el = $('#' + elId);
        if (older === 0 && recent === 0) {
          $el.removeClass('up down').addClass('flat').html('&mdash;');
        } else if (older === 0) {
          $el.removeClass('down flat').addClass('up').html('<i class="fas fa-arrow-up" style="font-size:0.5rem;"></i> New');
        } else {
          var pct = Math.round(((recent - older) / older) * 100);
          if (pct > 0) {
            $el.removeClass('down flat').addClass('up').html('<i class="fas fa-arrow-up" style="font-size:0.5rem;"></i> +' + pct + '%');
          } else if (pct < 0) {
            $el.removeClass('up flat').addClass('down').html('<i class="fas fa-arrow-down" style="font-size:0.5rem;"></i> ' + pct + '%');
          } else {
            $el.removeClass('up down').addClass('flat').html('<i class="fas fa-minus" style="font-size:0.5rem;"></i> 0%');
          }
        }
      }

      function renderLineChart(prefix, values, labels, fullLabels, color1, color2) {
        var svg = document.getElementById(prefix + '-svg');
        var wrap = document.getElementById(prefix + '-wrap');
        var tooltip = document.getElementById(prefix + '-tooltip');
        var labelsEl = document.getElementById(prefix + '-labels');
        if (!svg || !wrap) return;

        var w = wrap.offsetWidth;
        var h = 120;
        svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);

        var maxVal = Math.max.apply(null, values);
        if (maxVal === 0) maxVal = 1; // prevent division by zero

        var padTop = 8, padBot = 8, padX = 12;
        var chartH = h - padTop - padBot;
        var stepX = (w - padX * 2) / (values.length - 1 || 1);

        // Build points
        var points = values.map(function(v, i) {
          var x = padX + i * stepX;
          var y = padTop + chartH - (v / maxVal) * chartH;
          return { x: x, y: y, val: v };
        });

        // Build path
        var linePath = '';
        points.forEach(function(p, i) {
          if (i === 0) { linePath += 'M ' + p.x + ' ' + p.y; }
          else {
            // Smooth curve
            var prev = points[i - 1];
            var cpx = (prev.x + p.x) / 2;
            linePath += ' C ' + cpx + ' ' + prev.y + ', ' + cpx + ' ' + p.y + ', ' + p.x + ' ' + p.y;
          }
        });

        // Area path (fill under curve)
        var areaPath = linePath + ' L ' + points[points.length - 1].x + ' ' + (h - padBot) +
          ' L ' + points[0].x + ' ' + (h - padBot) + ' Z';

        // Grid lines (3 horizontal)
        var gridHTML = '';
        for (var g = 0; g <= 2; g++) {
          var gy = padTop + (chartH / 2) * g;
          gridHTML += '<line x1="' + padX + '" y1="' + gy + '" x2="' + (w - padX) + '" y2="' + gy + '" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>';
        }

        // Unique gradient IDs
        var gradId = prefix + '-grad';
        var areaGradId = prefix + '-area-grad';

        svg.innerHTML =
          '<defs>' +
            '<linearGradient id="' + gradId + '" x1="0%" y1="0%" x2="100%" y2="0%">' +
              '<stop offset="0%" stop-color="' + color1 + '"/>' +
              '<stop offset="100%" stop-color="' + color2 + '"/>' +
            '</linearGradient>' +
            '<linearGradient id="' + areaGradId + '" x1="0%" y1="0%" x2="0%" y2="100%">' +
              '<stop offset="0%" stop-color="' + color1 + '" stop-opacity="0.15"/>' +
              '<stop offset="100%" stop-color="' + color1 + '" stop-opacity="0"/>' +
            '</linearGradient>' +
          '</defs>' +
          gridHTML +
          '<path d="' + areaPath + '" fill="url(#' + areaGradId + ')"/>' +
          '<path d="' + linePath + '" fill="none" stroke="url(#' + gradId + ')" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="filter:drop-shadow(0 1px 4px rgba(139,92,246,0.3));">' +
            '<animate attributeName="stroke-dashoffset" from="1000" to="0" dur="1.2s" fill="freeze"/>' +
            '<animate attributeName="stroke-dasharray" from="1000" to="1000" dur="0.01s" fill="freeze"/>' +
          '</path>';

        // Add dots
        points.forEach(function(p, i) {
          var dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          dot.setAttribute('cx', p.x);
          dot.setAttribute('cy', p.y);
          dot.setAttribute('r', '4');
          dot.setAttribute('fill', '#08090c');
          dot.setAttribute('stroke', color2);
          dot.setAttribute('stroke-width', '2');
          dot.style.opacity = '0';
          dot.style.transition = 'opacity 0.15s, r 0.15s';
          dot.style.cursor = 'pointer';

          // Invisible larger hit area
          var hitArea = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          hitArea.setAttribute('cx', p.x);
          hitArea.setAttribute('cy', p.y);
          hitArea.setAttribute('r', '16');
          hitArea.setAttribute('fill', 'transparent');
          hitArea.style.cursor = 'pointer';

          hitArea.addEventListener('mouseenter', function() {
            dot.style.opacity = '1';
            dot.setAttribute('r', '5');
            tooltip.style.left = p.x + 'px';
            tooltip.style.top = (p.y - 10) + 'px';
            tooltip.querySelector('.ac-chart-tooltip-date').textContent = fullLabels[i];
            tooltip.querySelector('.ac-chart-tooltip-value').textContent = p.val.toLocaleString();
            tooltip.classList.add('visible');
          });
          hitArea.addEventListener('mouseleave', function() {
            dot.style.opacity = '0';
            dot.setAttribute('r', '4');
            tooltip.classList.remove('visible');
          });

          svg.appendChild(dot);
          svg.appendChild(hitArea);
        });

        // Labels
        labelsEl.innerHTML = '';
        labels.forEach(function(lbl) {
          var span = document.createElement('span');
          span.className = 'ac-chart-label';
          span.textContent = lbl;
          labelsEl.appendChild(span);
        });
      }

      // Redraw charts on window resize
      var chartResizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(chartResizeTimer);
        chartResizeTimer = setTimeout(function() {
          if (metricsInitialized && window._lastDailyMetrics) {
            renderTrendCharts(window._lastDailyMetrics);
          }
        }, 250);
      });

      // Store last data for resize re-render
      var _origRenderTrendCharts = renderTrendCharts;
      renderTrendCharts = function(days) {
        window._lastDailyMetrics = days;
        _origRenderTrendCharts(days);
      };

      // -- Section Toggle --

      function toggleMetricsSection(id) {
        var $section = $('#metrics-section-' + id);
        $section.toggleClass('collapsed');
      }

      // -- Socket.IO Live Updates --

      function initMetricsSocket() {
        if (typeof io === 'undefined') {
          $('#metrics-live-dot').addClass('disconnected');
          $('#metrics-live-label').text('Live updates unavailable');
          return;
        }

        try {
          metricsSocket = io({ transports: ['websocket'], reconnection: true });
        } catch (e) {
          $('#metrics-live-dot').addClass('disconnected');
          $('#metrics-live-label').text('Live updates unavailable');
          return;
        }

        metricsSocket.on('connect', function() {
          metricsSocket.emit('join_admin_metrics');
          $('#metrics-live-dot').removeClass('disconnected');
          $('#metrics-live-label').text('Live');
        });

        metricsSocket.on('connect_error', function() {
          $('#metrics-live-dot').addClass('disconnected');
          $('#metrics-live-label').text('Connection error');
        });

        metricsSocket.on('disconnect', function() {
          $('#metrics-live-dot').addClass('disconnected');
          $('#metrics-live-label').text('Reconnecting...');
        });

        metricsSocket.on('beta_metrics_updated', function(data) {
          applyBetaAdoptionMetrics(data);
        });
      }

      // -- Visibility API Auto-Refresh --

      function initMetricsVisibility() {
        document.addEventListener('visibilitychange', function() {
          if (document.visibilityState === 'visible') {
            // Check if metrics panel is currently active
            var $panel = $('#panel-metrics');
            if ($panel.hasClass('active')) {
              fetchBetaAdoptionMetrics();
            }
          }
        });
      }

    </script>


