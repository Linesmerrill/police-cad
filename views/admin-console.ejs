          listId = 'pendingUsersRecentSearches';
        } else if (tabType === 'users') {
          sectionId = 'recentSearchesSection';
          listId = 'recentSearchesList';
        } else {
          sectionId = 'recentSearchesSectionCommunities';
          listId = 'recentSearchesListCommunities';
        }
        
        const section = $(`#${sectionId}`);
        const list = $(`#${listId}`);
        
        if (searches.length === 0) {
          section.hide();
          return;
        }
        
        section.show();
        
        let html = '';
        searches.forEach(search => {
          const safeQuery = escapeHtml(search.query);
          const safeType = escapeHtml(search.type);
          const typeLabel = search.type === 'users' ? 'Users' : search.type === 'pending_users' ? 'Pending Users' : 'Communities';
          html += `
            <div class="recent-search-item" onclick="performRecentSearch('${safeQuery}', '${safeType}')">
              <span class="search-text">${safeQuery}</span>
              <span class="search-type">${escapeHtml(typeLabel)}</span>
              <button class="remove-btn" onclick="removeRecentSearch('${safeQuery}', '${safeType}', event)">
