        const button = $(this);
        button.prop('disabled', true);
        button.html('<i class="fas fa-spinner fa-spin"></i> Rejecting...');

        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications/${appId}/reject`,
