        }
        
        let html = '';
        admins.forEach(admin => {
          const adminId = admin.id || admin._id || 'unknown';
          const adminRoles = Array.isArray(admin.roles) ? admin.roles : (admin.role ? [admin.role] : ['admin']);
          const adminEmail = admin.email || 'Unknown';
          const adminCreatedAt = admin.createdAt ? new Date(admin.createdAt).toLocaleDateString() : 'Unknown';
          
          // Display roles as comma-separated list
          const rolesDisplay = adminRoles.join(', ');
          
          html += `
