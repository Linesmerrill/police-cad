          &copy; <%= new Date().getFullYear() %> Lines Police CAD
          <% if (typeof buildVersion !== 'undefined' && buildVersion) { %>
            &middot; v<%= buildVersion %>
          <% } %>
        </div>
        <div class="ac-footer-links">
          <a href="https://linespolice-cad.com" target="_blank">Website</a>
          <a href="https://discord.gg/linespolicecad" target="_blank">Discord</a>
        </div>
      </div>
    </footer>

  </body>
