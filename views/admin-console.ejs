      }
      
      // Recent Searches Management Functions
      function addToRecentSearches(query, type) {
        if (!query || !query.trim()) return;
        
        const searchItem = {
          query: query.trim(),
          type: type,
          timestamp: Date.now()
        };
        
        // Get existing searches from localStorage
        let recentSearches = JSON.parse(localStorage.getItem('adminRecentSearches') || '[]');
        
        // Remove duplicate if exists
        recentSearches = recentSearches.filter(item => 
          !(item.query.toLowerCase() === query.toLowerCase() && item.type === type)
        );
        
        // Add new search to beginning
        recentSearches.unshift(searchItem);
        
        // Keep only last 10 searches
        if (recentSearches.length > 10) {
          recentSearches = recentSearches.slice(0, 10);
        }
        
        // Save to localStorage
        localStorage.setItem('adminRecentSearches', JSON.stringify(recentSearches));
        
        // Update UI
        updateRecentSearchesUI();
      }
      
      function updateRecentSearchesUI() {
        const recentSearches = JSON.parse(localStorage.getItem('adminRecentSearches') || '[]');
        
        // Update Pending Users tab recent searches
        updateTabRecentSearches('pendingUsers', recentSearches.filter(item => item.type === 'pending_users'));
        
        // Update Users tab recent searches
        updateTabRecentSearches('users', recentSearches.filter(item => item.type === 'users'));
        
        // Update Communities tab recent searches
        updateTabRecentSearches('communities', recentSearches.filter(item => item.type === 'communities'));
      }
      
      function updateTabRecentSearches(tabType, searches) {
        let sectionId, listId;
        
        if (tabType === 'pendingUsers') {
          sectionId = 'pendingUsersRecentSearches';
          listId = 'pendingUsersRecentSearches';
        } else if (tabType === 'users') {
          sectionId = 'recentSearchesSection';
          listId = 'recentSearchesList';
        } else {
          sectionId = 'recentSearchesSectionCommunities';
          listId = 'recentSearchesListCommunities';
        }
        
        const section = $(`#${sectionId}`);
        const list = $(`#${listId}`);
        
        if (searches.length === 0) {
          section.hide();
          return;
        }
        
        section.show();
        
        let html = '';
        searches.forEach(search => {
          html += `
            <div class="recent-search-item" onclick="performRecentSearch('${search.query}', '${search.type}')">
              <span class="search-text">${search.query}</span>
              <span class="search-type">${search.type === 'users' ? 'Users' : search.type === 'pending_users' ? 'Pending Users' : 'Communities'}</span>
              <button class="remove-btn" onclick="removeRecentSearch('${search.query}', '${search.type}', event)">
                <i class="fas fa-times"></i>
              </button>
            </div>
          `;
        });
        
        list.html(html);
      }
      
      function performRecentSearch(query, type) {
        if (type === 'pending_users') {
          // Switch to Pending Users tab
          $('a[href="#pending-users-tab"]').tab('show');
          // Set search input value
          $('#pendingUserSearch').val(query);
          // Perform search
          searchPendingUsers(query, 0);
        } else if (type === 'users') {
          // Switch to Users tab
          $('a[href="#users-tab"]').tab('show');
          // Set search input value
          $('#userSearch').val(query);
          // Perform search
          searchUsers(query, 0);
        } else if (type === 'communities') {
          // Switch to Communities tab
          $('a[href="#communities-tab"]').tab('show');
          // Set search input value
          $('#communitySearch').val(query);
          // Perform search
          searchCommunities(query, 0);
        }
