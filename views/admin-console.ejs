      function removeRecentSearch(query, type, event) {
        event.stopPropagation(); // Prevent triggering the search
        
        let recentSearches = JSON.parse(localStorage.getItem('adminRecentSearches') || '[]');
        recentSearches = recentSearches.filter(item => 
          !(item.query.toLowerCase() === query.toLowerCase() && item.type === type)
        );
        
        localStorage.setItem('adminRecentSearches', JSON.stringify(recentSearches));
        updateRecentSearchesUI();
      }
      
      function clearAllRecentSearches(tabType) {
        if (!tabType) return; // Safety check
        
        // Clear only specific tab type
        let recentSearches = JSON.parse(localStorage.getItem('adminRecentSearches') || '[]');
        recentSearches = recentSearches.filter(item => item.type !== tabType);
        localStorage.setItem('adminRecentSearches', JSON.stringify(recentSearches));
        
