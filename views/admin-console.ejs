                <div class="info-item">
                  <div class="info-label">Visibility</div>
                  <div class="info-value">
                    <span class="status-badge ${getVisibilityStatusClass(community.visibility)}">
                      ${getVisibilityDisplayText(community.visibility)}
                    </span>
                  </div>
                </div>
                <div class="info-item">
                  <div class="info-label">Created</div>
                  <div class="info-value">${new Date(community.createdAt).toLocaleDateString()}</div>
                </div>
                <div class="info-item">
                  <div class="info-label">Departments</div>
                  <div class="info-value">${community.departments?.length || 0}</div>
                </div>
              </div>
            </div>
