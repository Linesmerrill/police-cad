              </div>

              <!-- Confirm dialog for destructive feedback actions -->
              <div id="bfb-confirm" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(2,6,23,0.7);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);align-items:center;justify-content:center;">
                <div style="width:90%;max-width:380px;border-radius:14px;background:rgba(15,23,42,0.98);border:1px solid rgba(148,163,184,0.18);box-shadow:0 30px 80px rgba(2,6,23,0.65);overflow:hidden;">
                  <div style="height:2px;background:#ef4444;opacity:0.8;"></div>
                  <div style="padding:1.125rem 1.25rem 0.5rem;display:flex;gap:0.75rem;align-items:flex-start;">
                    <div style="width:38px;height:38px;border-radius:10px;background:rgba(239,68,68,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                      <i class="fas fa-trash" style="color:#fca5a5;font-size:1rem;"></i>
                    </div>
                    <div>
                      <div style="font-size:0.9375rem;font-weight:600;color:var(--ac-text);">Delete this feedback?</div>
                      <div style="font-size:0.8125rem;color:var(--ac-text-muted);margin-top:0.25rem;line-height:1.45;">It'll be hidden from the list. You'll have a few seconds to undo.</div>
                    </div>
                  </div>
                  <div style="padding:1rem 1.25rem 1.125rem;display:flex;gap:0.5rem;justify-content:flex-end;">
                    <button type="button" id="bfb-confirm-cancel" style="padding:0.5rem 0.875rem;border-radius:8px;border:1px solid var(--ac-glass-border);background:transparent;color:var(--ac-text-muted);font:600 0.8125rem/1 inherit;cursor:pointer;">Cancel</button>
                    <button type="button" id="bfb-confirm-ok" style="padding:0.5rem 0.875rem;border-radius:8px;border:1px solid rgba(239,68,68,0.4);background:rgba(239,68,68,0.18);color:#fca5a5;font:700 0.8125rem/1 inherit;cursor:pointer;display:inline-flex;align-items:center;gap:0.375rem;"><i class="fas fa-trash" style="font-size:0.75rem;"></i> Delete</button>
