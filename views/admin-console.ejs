        </div>

        <div class="ac-nav-section">
          <div class="ac-nav-section-label">Search</div>
          <div class="ac-nav-item" data-panel="users">
            <i class="fas fa-users"></i> Users
          </div>
          <div class="ac-nav-item" data-panel="pending-users">
            <i class="fas fa-user-clock"></i> Pending Users
          </div>
          <div class="ac-nav-item" data-panel="communities">
            <i class="fas fa-building"></i> Communities
          </div>
        </div>

        <div class="ac-nav-section">
          <div class="ac-nav-section-label">Management</div>
          <div class="ac-nav-item" id="content-creators-tab" data-panel="content-creators" style="display: none;">
            <i class="fas fa-video"></i> Content Creators
            <span id="ccPendingBadge" class="ac-nav-badge" style="display: none;"></span>
          </div>
          <div class="ac-nav-item" id="admin-management-tab" data-panel="admin-management" style="display: none;">
            <i class="fas fa-shield-alt"></i> Admin Management
          </div>
          <div class="ac-nav-item" id="email-tab" data-panel="email" style="display: none;">
            <i class="fas fa-envelope"></i> Email
          </div>
          <div class="ac-nav-item" data-panel="metrics">
            <i class="fas fa-chart-line"></i> Metrics
          </div>
        </div>
      </nav>

      <div class="ac-sidebar-footer">
        <div class="ac-sidebar-user">
          <div class="ac-user-avatar">
            <% if (admin && admin.profilePicture) { %>
              <img src="<%= admin.profilePicture %>" alt="" />
            <% } else { %>
              <i class="fas fa-user"></i>
            <% } %>
          </div>
          <div class="ac-user-info">
            <div class="ac-user-name"><%= admin && admin.firstName && admin.lastName ? admin.firstName + ' ' + admin.lastName : (admin && admin.email ? admin.email : 'Admin') %></div>
            <div class="ac-user-role">Administrator</div>
          </div>
        </div>
        <div class="ac-sidebar-actions">
          <a href="/admin/profile" class="ac-sidebar-action" title="Edit Profile"><i class="fas fa-user-edit"></i></a>
          <a href="#" onclick="adminLogout(); return false;" class="ac-sidebar-action ac-logout" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
        </div>
      </div>
    </aside>

    <main class="ac-main">
      <header class="ac-topbar">
        <h1 class="ac-topbar-title" id="ac-topbar-title">Dashboard</h1>
        <div class="ac-topbar-actions">
          <div id="add-admin-section" style="display: none;">
            <button class="ac-btn ac-btn-accent" onclick="showAddAdminModal()">
              <i class="fas fa-plus"></i> Add Admin
            </button>
          </div>
        </div>
      </header>

      <div class="ac-content">

        <!-- Panel: Dashboard -->
        <div class="ac-panel active" id="panel-dashboard">
          <div class="ac-dashboard-welcome">
            <h2>Welcome back<%= admin && admin.firstName ? ', ' + admin.firstName : '' %></h2>
            <p>Here's an overview of your admin console.</p>
          </div>

          <div class="ac-section-label">Overview</div>
          <div class="ac-stats">
            <div class="ac-stat" style="--stat-accent:var(--ac-accent); animation-delay:0.02s;">
              <i class="fas fa-shield-alt ac-stat-icon"></i>
              <div class="ac-stat-value" id="dash-stat-admins">&mdash;</div>
              <div class="ac-stat-label">Total Admins</div>
            </div>
            <div class="ac-stat" style="--stat-accent:#ef4444; animation-delay:0.06s;">
              <i class="fas fa-inbox ac-stat-icon"></i>
              <div class="ac-stat-value" id="dash-stat-submitted">&mdash;</div>
              <div class="ac-stat-label">CC Submitted</div>
            </div>
            <div class="ac-stat" style="--stat-accent:#f59e0b; animation-delay:0.10s;">
              <i class="fas fa-search ac-stat-icon"></i>
              <div class="ac-stat-value" id="dash-stat-review">&mdash;</div>
              <div class="ac-stat-label">CC Under Review</div>
            </div>
            <div class="ac-stat" style="--stat-accent:var(--ac-green); animation-delay:0.14s;">
              <i class="fas fa-star ac-stat-icon"></i>
              <div class="ac-stat-value" id="dash-stat-active-cc">&mdash;</div>
              <div class="ac-stat-label">Active Creators</div>
            </div>
          </div>

          <div class="ac-section-label">Quick Actions</div>
          <div class="ac-quick-actions">
            <a class="ac-quick-action" href="#" onclick="acNavTo('users'); return false;">
              <div class="ac-quick-action-icon" style="background:rgba(99,102,241,0.12); color:var(--ac-accent);">
                <i class="fas fa-search"></i>
              </div>
              <div class="ac-quick-action-text">
                <strong>Search Users</strong>
                <span>Look up users by email</span>
              </div>
            </a>
            <a class="ac-quick-action" href="#" onclick="acNavTo('pending-users'); return false;">
              <div class="ac-quick-action-icon" style="background:rgba(245,158,11,0.12); color:#f59e0b;">
                <i class="fas fa-user-clock"></i>
              </div>
              <div class="ac-quick-action-text">
                <strong>Pending Users</strong>
                <span>Review verification requests</span>
              </div>
            </a>
            <a class="ac-quick-action" href="#" onclick="acNavTo('communities'); return false;">
              <div class="ac-quick-action-icon" style="background:rgba(16,185,129,0.12); color:var(--ac-green);">
                <i class="fas fa-building"></i>
              </div>
              <div class="ac-quick-action-text">
                <strong>Communities</strong>
                <span>Search communities</span>
              </div>
            </a>
            <a class="ac-quick-action" href="#" id="dash-qa-cc" onclick="acNavTo('content-creators'); return false;" style="display:none;">
              <div class="ac-quick-action-icon" style="background:rgba(239,68,68,0.12); color:#ef4444;">
                <i class="fas fa-video"></i>
              </div>
              <div class="ac-quick-action-text">
                <strong>Content Creators</strong>
                <span>Manage CC applications</span>
              </div>
            </a>
          </div>

          <div class="ac-section-label" id="dash-pending-cc-label" style="display:none;">Pending Applications</div>
          <div class="dash-pending-cc" id="dash-pending-cc-container" style="display:none;">
            <div class="dash-pending-cc-header">
              <h4>
                <i class="fas fa-inbox" style="color:#ef4444;"></i>
                Content Creator Applications
                <span class="pending-count" id="dash-pending-cc-count" style="display:none;">0</span>
              </h4>
              <a href="#" onclick="acNavTo('content-creators'); return false;" style="font-size:0.75rem; color:var(--ac-accent); text-decoration:none; font-weight:500;">
                View All <i class="fas fa-arrow-right" style="margin-left:4px; font-size:0.625rem;"></i>
              </a>
            </div>
            <div id="dash-pending-cc-list">
              <div style="text-align:center; padding:1rem; color:var(--ac-text-muted);">
                <i class="fas fa-spinner fa-spin"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel: Users -->
        <div class="ac-panel" id="panel-users">
          <div class="ac-card">
            <div class="ac-card-body">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="userSearch" class="form-control ac-input" placeholder="Search users by email or username..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchUsersBtn" class="ac-btn ac-btn-accent ac-btn-block">
                    <i class="fas fa-search"></i> Search Users
                  </button>
                </div>
              </div>
              <div class="recent-searches-section" id="recentSearchesSection" style="display: none;">
                <div class="recent-searches-header">
                  <h6 class="recent-searches-title"><i class="fas fa-history"></i> Recent Searches</h6>
                  <button class="ac-btn-link" onclick="clearAllRecentSearches('users')">Clear All</button>
                </div>
                <div class="recent-searches-list" id="recentSearchesList"></div>
              </div>
              <div id="userResults"></div>
            </div>
          </div>
        </div>

        <!-- Panel: Pending Users -->
        <div class="ac-panel" id="panel-pending-users">
          <div class="ac-card">
            <div class="ac-card-body">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="pendingUserSearch" class="form-control ac-input" placeholder="Search pending users by email address..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchPendingUsersBtn" class="ac-btn ac-btn-accent ac-btn-block">
                    <i class="fas fa-search"></i> Search Pending Users
                  </button>
                </div>
              </div>
              <div class="recent-searches">
                <h6><i class="fas fa-history" style="margin-right: 8px;"></i>Recent Searches</h6>
                <div id="pendingUsersRecentSearches" class="recent-searches-list"></div>
              </div>
              <div id="pendingUserResults" class="search-results"></div>
            </div>
          </div>
        </div>

        <!-- Panel: Communities -->
        <div class="ac-panel" id="panel-communities">
          <div class="ac-card">
            <div class="ac-card-body">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="communitySearch" class="form-control ac-input" placeholder="Search communities by name..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchCommunitiesBtn" class="ac-btn ac-btn-accent ac-btn-block">
                    <i class="fas fa-search"></i> Search Communities
                  </button>
                </div>
              </div>
              <div class="recent-searches-section" id="recentSearchesSectionCommunities" style="display: none;">
                <div class="recent-searches-header">
                  <h6 class="recent-searches-title"><i class="fas fa-history"></i> Recent Searches</h6>
                  <button class="ac-btn-link" onclick="clearAllRecentSearches('communities')">Clear All</button>
                </div>
                <div class="recent-searches-list" id="recentSearchesListCommunities"></div>
              </div>
              <div id="communityResults"></div>
            </div>
          </div>
        </div>

        <!-- Panel: Content Creators -->
        <div class="ac-panel" id="panel-content-creators">
          <div class="ac-card">
            <div class="ac-card-body">
              <div style="margin-bottom: 1rem;">
                <div class="btn-group" role="group" id="ccStatusFilter">
                  <button type="button" class="btn btn-secondary cc-status-btn active" data-status="">All</button>
                  <button type="button" class="btn btn-secondary cc-status-btn" data-status="submitted">
                    <i class="fas fa-inbox" style="margin-right: 4px;"></i>Submitted <span id="ccSubmittedCount" class="badge" style="background: #ef4444; margin-left: 4px; display: none;"></span>
                  </button>
                  <button type="button" class="btn btn-secondary cc-status-btn" data-status="under_review">
                    <i class="fas fa-search" style="margin-right: 4px;"></i>Under Review <span id="ccUnderReviewCount" class="badge" style="background: #f59e0b; margin-left: 4px; display: none;"></span>
                  </button>
                  <button type="button" class="btn btn-secondary cc-status-btn" data-status="approved">
                    <i class="fas fa-check-circle" style="margin-right: 4px;"></i>Approved
                  </button>
                  <button type="button" class="btn btn-secondary cc-status-btn" data-status="rejected">
                    <i class="fas fa-times-circle" style="margin-right: 4px;"></i>Rejected
                  </button>
                  <button type="button" class="btn btn-secondary cc-status-btn" data-status="withdrawn">
                    <i class="fas fa-undo" style="margin-right: 4px;"></i>Withdrawn <span id="ccWithdrawnCount" class="badge" style="background: #6b7280; margin-left: 4px; display: none;"></span>
                  </button>
                </div>
              </div>
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="ccSearch" class="form-control ac-input" placeholder="Search applications by display name..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchCCBtn" class="ac-btn ac-btn-accent ac-btn-block">
                    <i class="fas fa-search"></i> Search Applications
                  </button>
                </div>
              </div>
              <div style="display: flex; gap: 0.75rem; margin-top: 1rem;" id="ccStatsRow">
                <div style="flex: 1; min-width: 0;">
                  <div class="stat-card" style="padding: 0.75rem 0.5rem;"><div class="stat-number" id="ccStatPending" style="font-size: 1.25rem;">-</div><div class="stat-label" style="font-size: 0.65rem; white-space: nowrap;">SUBMITTED</div></div>
                </div>
                <div style="flex: 1; min-width: 0;">
                  <div class="stat-card" style="padding: 0.75rem 0.5rem;"><div class="stat-number" id="ccStatUnderReview" style="color: #f59e0b; font-size: 1.25rem;">-</div><div class="stat-label" style="font-size: 0.65rem; white-space: nowrap;">UNDER REVIEW</div></div>
                </div>
                <div style="flex: 1; min-width: 0;">
                  <div class="stat-card" style="padding: 0.75rem 0.5rem;"><div class="stat-number" id="ccStatApproved" style="font-size: 1.25rem;">-</div><div class="stat-label" style="font-size: 0.65rem; white-space: nowrap;">APPROVED</div></div>
                </div>
                <div style="flex: 1; min-width: 0;">
                  <div class="stat-card" style="padding: 0.75rem 0.5rem;"><div class="stat-number" id="ccStatRejected" style="font-size: 1.25rem;">-</div><div class="stat-label" style="font-size: 0.65rem; white-space: nowrap;">REJECTED</div></div>
                </div>
                <div style="flex: 1; min-width: 0;">
                  <div class="stat-card" style="padding: 0.75rem 0.5rem;"><div class="stat-number" id="ccStatActive" style="font-size: 1.25rem;">-</div><div class="stat-label" style="font-size: 0.65rem; white-space: nowrap;">ACTIVE</div></div>
                </div>
              </div>
              <div id="ccApplicationResults">
                <div class="loading" style="text-align: center; padding: 2rem; color: #9aa0b4;">
                  <i class="fas fa-spinner fa-spin"></i> Loading applications...
                </div>
              </div>
              <div id="ccPagination" style="margin-top: 1rem; display: none;">
                <nav><ul class="pagination justify-content-center" id="ccPaginationList"></ul></nav>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel: Admin Management -->
        <div class="ac-panel" id="panel-admin-management">
          <div class="ac-card">
            <div class="ac-card-body">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="adminSearch" class="form-control ac-input" placeholder="Search admins by email..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchAdminsBtn" class="ac-btn ac-btn-accent ac-btn-block">
                    <i class="fas fa-search"></i> Search Admins
                  </button>
                </div>
              </div>
              <div id="adminResults">
                <div class="loading" style="text-align: center; padding: 2rem; color: #9aa0b4;">
                  <i class="fas fa-spinner fa-spin"></i> Loading all admins...
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel: Email -->
        <div class="ac-panel" id="panel-email">
          <div class="ac-card">
            <div class="ac-card-body">
              <div class="form-group">
                <label for="emailTo" class="ac-label">To (email address)</label>
                <input type="email" id="emailTo" class="form-control ac-input" placeholder="recipient@example.com" />
              </div>
              <div class="form-group">
                <label for="emailSubject" class="ac-label">Subject</label>
                <input type="text" id="emailSubject" class="form-control ac-input" placeholder="Email subject line" />
              </div>
              <div class="form-group">
                <label for="emailBody" class="ac-label">Body (plain text)</label>
                <textarea id="emailBody" class="form-control ac-input" rows="10" placeholder="Type your message here. Line breaks will be preserved." style="resize: vertical; min-height: 200px;"></textarea>
              </div>
              <button type="button" id="sendEmailBtn" class="ac-btn ac-btn-accent ac-btn-block">
                <i class="fas fa-paper-plane"></i> Send Email
              </button>
            </div>
          </div>
        </div>

        <!-- Panel: Metrics -->
        <div class="ac-panel" id="panel-metrics">

          <!-- Live connection indicator -->
          <div class="ac-metrics-live-wrap">
            <span class="ac-metrics-live-dot disconnected" id="metrics-live-dot"></span>
            <span class="ac-metrics-live-label" id="metrics-live-label">Connecting...</span>
          </div>

          <!-- Section: Beta Civilian Dashboard Adoption -->
          <div class="ac-metrics-section" id="metrics-section-beta">
            <div class="ac-metrics-section-header" onclick="toggleMetricsSection('beta')">
              <div class="ac-metrics-section-title">
                <i class="fas fa-flask"></i>
                <span>Beta Civilian Dashboard Adoption</span>
              </div>
              <i class="fas fa-chevron-down ac-metrics-section-chevron"></i>
            </div>
            <div class="ac-metrics-section-body">
              <p style="font-size:0.75rem;color:var(--ac-text-muted);margin:0 0 1rem;">Track how many users have opted into the new civilian dashboard experience.</p>

              <div id="metrics-beta-loading" style="text-align:center;padding:2rem;color:var(--ac-text-muted);">
                <i class="fas fa-spinner fa-spin"></i> Loading metrics...
              </div>

              <div id="metrics-beta-content" style="display:none;">
                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(170px, 1fr));gap:1rem;margin-bottom:1.5rem;">
                  <div class="ac-stat" style="--stat-accent:var(--ac-accent);animation-delay:0s;">
                    <i class="fas fa-flask ac-stat-icon"></i>
                    <div class="ac-stat-value" id="metrics-beta-opted">&mdash;</div>
                    <div class="ac-stat-label">Beta Dashboard</div>
                  </div>
                  <div class="ac-stat" style="--stat-accent:var(--ac-blue);animation-delay:0.04s;">
                    <i class="fas fa-desktop ac-stat-icon"></i>
                    <div class="ac-stat-value" id="metrics-beta-classic">&mdash;</div>
                    <div class="ac-stat-label">Classic Dashboard</div>
                  </div>
                  <div class="ac-stat" style="--stat-accent:var(--ac-green);animation-delay:0.08s;">
                    <i class="fas fa-users ac-stat-icon"></i>
                    <div class="ac-stat-value" id="metrics-beta-total">&mdash;</div>
                    <div class="ac-stat-label">Total Users</div>
                  </div>
                </div>

                <!-- Adoption bar -->
                <div style="background:var(--ac-glass);border:1px solid var(--ac-glass-border);border-radius:var(--ac-radius);padding:1rem;">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.625rem;">
                    <span style="font-size:0.75rem;font-weight:600;color:var(--ac-text);">Adoption Rate</span>
                    <span style="font-size:0.8125rem;font-weight:700;color:var(--ac-accent);" id="metrics-beta-pct">&mdash;</span>
                  </div>
                  <div style="height:10px;border-radius:5px;background:var(--ac-blue);overflow:hidden;">
                    <div id="metrics-beta-bar" style="height:100%;border-radius:5px 0 0 5px;background:linear-gradient(90deg,var(--ac-accent),#a78bfa);width:0%;transition:width 0.8s ease;min-width:0;"></div>
                  </div>
                  <div style="display:flex;justify-content:space-between;margin-top:0.5rem;">
                    <span style="font-size:0.625rem;color:var(--ac-text-dim);"><i class="fas fa-circle" style="color:var(--ac-accent);font-size:0.375rem;vertical-align:middle;margin-right:0.25rem;"></i>Beta</span>
                    <span style="font-size:0.625rem;color:var(--ac-text-dim);"><i class="fas fa-circle" style="color:var(--ac-blue);font-size:0.375rem;vertical-align:middle;margin-right:0.25rem;"></i>Classic</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Trend Charts -->
          <div class="ac-charts-row" id="metrics-charts-row" style="display:none;">
            <div class="ac-chart-card" style="--chart-accent:var(--ac-accent);animation-delay:0.1s;">
              <div class="ac-chart-header">
                <div>
                  <div class="ac-chart-title">Beta Opt-Ins</div>
                  <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.25rem;">
                    <span class="ac-chart-value" id="chart-beta-total">&mdash;</span>
                    <span class="ac-chart-trend flat" id="chart-beta-trend">&mdash;</span>
                  </div>
                </div>
                <span style="font-size:0.625rem;color:var(--ac-text-dim);font-weight:500;">Last 7 days</span>
              </div>
              <div class="ac-chart-svg-wrap" id="chart-beta-wrap">
                <svg class="ac-chart-svg" id="chart-beta-svg" preserveAspectRatio="none"></svg>
                <div class="ac-chart-tooltip" id="chart-beta-tooltip">
                  <div class="ac-chart-tooltip-date"></div>
                  <div class="ac-chart-tooltip-value"></div>
                </div>
              </div>
              <div class="ac-chart-labels" id="chart-beta-labels"></div>
            </div>

            <div class="ac-chart-card" style="--chart-accent:var(--ac-green);animation-delay:0.2s;">
              <div class="ac-chart-header">
                <div>
                  <div class="ac-chart-title">New Registrations</div>
                  <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.25rem;">
                    <span class="ac-chart-value" id="chart-users-total">&mdash;</span>
                    <span class="ac-chart-trend flat" id="chart-users-trend">&mdash;</span>
                  </div>
                </div>
                <span style="font-size:0.625rem;color:var(--ac-text-dim);font-weight:500;">Last 7 days</span>
              </div>
              <div class="ac-chart-svg-wrap" id="chart-users-wrap">
                <svg class="ac-chart-svg" id="chart-users-svg" preserveAspectRatio="none"></svg>
                <div class="ac-chart-tooltip" id="chart-users-tooltip">
                  <div class="ac-chart-tooltip-date"></div>
                  <div class="ac-chart-tooltip-value"></div>
                </div>
              </div>
              <div class="ac-chart-labels" id="chart-users-labels"></div>
            </div>
          </div>

        </div>

      </div><!-- end ac-content -->
    </main>


    <!-- User Details Modal -->
    <div class="modal fade" id="userModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="userModalTitle">User Details</h4>
          </div>
          <div class="modal-body" id="userModalBody">
            <!-- User details will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Community Details Modal -->
    <div class="modal fade" id="communityModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
