    function caseGenerateStep4PromptText() {
      var oldOwner = caseState._oldOwner;
      var who = oldOwner ? displayUser(oldOwner) : 'the previous owner';
      var text = 'Before we wrap up, two quick questions about ' + who + ':\n\n';
      text += '1. Do you want us to remove ' + who + ' from the community?\n';
      text += '   ☐ Yes    ☐ No\n\n';
      text += '2. Do you want us to ban them from rejoining in the future?\n';
      text += '   ☐ Yes    ☐ No\n\n';
      text += 'Please confirm both so we can finish the ownership reset.';
      return text;
    }

    function caseCopyStep4Prompt() {
      navigator.clipboard.writeText(caseGenerateStep4PromptText()).then(function() {
        $('#caseCopyStep4PromptBtn').html('<i class="fas fa-check"></i> Copied!');
        setTimeout(function() { $('#caseCopyStep4PromptBtn').html('<i class="fas fa-copy"></i> Copy'); }, 2000);
      });
    }

    function caseSkipStep4() {
      saveCaseStep('removeBadActor', { skipped: true }, function() { renderCaseStep(); });
    }

    function caseLookupBadActor() {
      var email = $('#caseBadActorEmail').val().trim();
      if (!email) { $('#caseBadActorError').text('Please enter an email address.').show(); return; }
      $('#caseStep4Btn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Looking up...');
      $('#caseBadActorError').hide();
      $.ajax({
        url: API_BASE + '/api/v1/admin/search/users',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ query: email, page: 0, limit: 1 }),
        success: function(data) {
          var users = data.users || [];
          var exactMatch = users.find(function(u) { return u.email && u.email.toLowerCase() === email.toLowerCase(); });
          if (!exactMatch) {
            $('#caseBadActorError').text('No user found with that email address.').show();
            $('#caseStep4Btn').prop('disabled', false).html('<i class="fas fa-search"></i> Look Up User');
            return;
          }
          caseState._badActor = { id: exactMatch.id, email: exactMatch.email, username: exactMatch.username };
          var userRoles = (caseState._roles || []).filter(function(r) { return r.members.some(function(m) { return m.id === exactMatch.id; }); }).map(function(r) { return r.name; });
          var previewHtml = '<div style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">';
          previewHtml += '<div style="color: var(--ac-text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">User to Remove</div>';
          previewHtml += '<div style="color: #fff; font-weight: 600;">' + displayUser(exactMatch) + '</div>';
          previewHtml += '<div style="color: var(--ac-text-muted); font-size: 0.85rem;">' + (exactMatch.email || '') + '</div>';
          previewHtml += '<div style="color: var(--ac-text-muted); font-size: 0.75rem;">ID: ' + exactMatch.id + '</div>';
          if (userRoles.length > 0) {
            previewHtml += '<div style="margin-top: 0.5rem; color: var(--ac-amber); font-size: 0.85rem;"><i class="fas fa-shield-alt"></i> In roles: ' + userRoles.join(', ') + '</div>';
          }
          previewHtml += '<div style="margin-top: 1rem;"><label style="display: flex; align-items: center; cursor: pointer; color: var(--ac-text);"><input type="checkbox" id="caseBanCheckbox" style="margin-right: 0.5rem;"> Also ban this user from rejoining this community</label></div>';
          previewHtml += '</div>';
          $('#caseBadActorPreview').html(previewHtml).show();
          $('#caseStep4Btn').prop('disabled', false).html('<i class="fas fa-user-slash"></i> Remove User').off('click').on('click', caseConfirmRemoval);
        },
        error: function() {
          $('#caseBadActorError').text('Failed to search for user.').show();
          $('#caseStep4Btn').prop('disabled', false).html('<i class="fas fa-search"></i> Look Up User');
        }
      });
    }

    function caseConfirmRemoval() {
      var ban = $('#caseBanCheckbox').is(':checked');
      var user = caseState._badActor;
      showConfirmModal(
        'Confirm User Removal',
        '<p>You are about to remove <strong>' + displayUser(user) + (user && user.email ? ' (' + user.email + ')' : '') + '</strong> from <strong>' + caseState.communityName + '</strong>.</p>' +
        '<p>This will:</p><ul>' +
        '<li>Remove them from all roles</li>' +
        '<li>Remove the community from their account</li>' +
        '<li>Clear their last accessed community</li>' +
        (ban ? '<li style="color: var(--ac-red);"><strong>Ban them from rejoining</strong></li>' : '') +
        '</ul><p style="color: var(--ac-amber);"><i class="fas fa-exclamation-triangle"></i> This action will be logged.</p>',
        function() { caseExecuteRemoval(ban); }
      );
    }

    function caseExecuteRemoval(ban) {
      $('#case-detail-content').html('<div style="text-align: center; padding: 2rem;"><div class="loading">Removing user...</div></div>');
      $.ajax({
        url: API_BASE + '/api/v1/admin/communities/' + caseState.communityId + '/remove-member',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ userEmail: caseState._badActor.email, ban: ban, currentUser: { email: currentUserEmail, roles: roles } }),
        success: function() {
          saveCaseStep('removeBadActor', {
            badActor: caseState._badActor,
            banned: ban,
            skipped: false
          }, function() { renderCaseStep(); });
        },
        error: function(xhr) {
          var msg = extractAjaxError(xhr);
          var safeMsg = $('<div>').text(msg).html();
          $('#case-detail-content').html('<div style="color: var(--ac-red); padding: 2rem; text-align: center;"><div style="margin-bottom: 0.75rem;"><i class="fas fa-exclamation-triangle"></i> Failed to remove user</div><div style="background: rgba(0,0,0,0.25); border: 1px solid rgba(239,68,68,0.3); border-radius: 6px; padding: 0.75rem; color: var(--ac-text); font-size: 0.85rem; text-align: left; white-space: pre-wrap; word-break: break-word; margin-bottom: 1rem;">' + safeMsg + '</div><button class="ac-btn" onclick="renderCaseStep()">Retry</button></div>');
        }
      });
    }

    // ── Case Step 5: Summary ──
    function renderCaseStep5_Summary(isReadOnly) {
      // Refresh roles for accurate summary
      $.ajax({
        url: API_BASE + '/api/v1/admin/communities/' + caseState.communityId + '/roles',
        method: 'GET',
        success: function(rolesRes) {
          caseState._roles = rolesRes.roles || [];
          caseState._dangerousRoles = caseState._roles.filter(function(r) { return r.hasAdminPermission && !r.isHeadAdmin; });
          renderCaseStep5_SummaryContent(isReadOnly);
        },
        error: function() { renderCaseStep5_SummaryContent(isReadOnly); }
      });
    }

    function renderCaseStep5_SummaryContent(isReadOnly) {
      var steps = caseState.steps;
      var isCancelled = caseState.status === 'cancelled';
      // For cancelled cases, show the step where it was cancelled; for completed, show step 5
      var displayStep = 5;
      if (isCancelled) {
        var stepKeys = ['transferOwnership', 'headAdmin', 'roleAudit', 'removeBadActor', 'summary'];
        displayStep = 1;
        for (var si = 0; si < stepKeys.length; si++) {
          if (steps[stepKeys[si]] && steps[stepKeys[si]].completed) {
            displayStep = si + 2;
          } else {
            break;
          }
        }
        if (displayStep > 5) displayStep = 5;
      }
      var html = renderCaseStepper(displayStep);
      html += '<div style="text-align: center; margin-bottom: 1.5rem;">';
      if (isCancelled) {
        html += '<div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(239,68,68,0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">';
        html += '<i class="fas fa-times" style="color: var(--ac-red); font-size: 1.5rem;"></i></div>';
        html += '<h5 style="color: #fff;">Case Cancelled</h5>';
        // Show which step it was cancelled at
        var cancelStepNames = ['Owner', 'Head Admin', 'Role Audit', 'Remove User', 'Summary'];
        var cancelStepKeys = ['transferOwnership', 'headAdmin', 'roleAudit', 'removeBadActor', 'summary'];
        var cancelledAtStep = 1;
        for (var si = 0; si < cancelStepKeys.length; si++) {
          if (steps[cancelStepKeys[si]] && steps[cancelStepKeys[si]].completed) {
            cancelledAtStep = si + 2;
          } else {
            break;
          }
        }
        if (cancelledAtStep <= 5) {
          html += '<p style="color: var(--ac-text-muted); font-size: 0.85rem;">Cancelled at Step ' + cancelledAtStep + ': ' + cancelStepNames[cancelledAtStep - 1] + '</p>';
        }
        if (caseState.cancelledReason) {
          html += '<p style="color: var(--ac-text-muted); font-size: 0.85rem;">Reason: ' + caseState.cancelledReason + '</p>';
        }
        if (caseState.cancelledBy) {
          html += '<p style="color: var(--ac-text-muted); font-size: 0.8rem;">By: ' + caseState.cancelledBy + '</p>';
        }
      } else {
        html += '<div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(34,197,94,0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">';
        html += '<i class="fas fa-check" style="color: var(--ac-green); font-size: 1.5rem;"></i></div>';
        html += '<h5 style="color: #fff;">Ownership Reset ' + (isReadOnly ? 'Completed' : 'Complete') + '</h5>';
      }
      html += '</div>';

      html += '<div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">';
      html += '<h6 style="color: #fff; margin-bottom: 0.75rem;">Actions Taken</h6>';
      // Performers contribution line
      var performers = caseCollectPerformers();
      if (performers.length > 0) {
        html += '<div style="padding: 0 0 0.5rem 0; color: var(--ac-text-muted); font-size: 0.8rem;"><i class="fas fa-user-shield" style="margin-right: 0.5rem;"></i> Performed by: ' + caseFormatPerformers(performers) + '</div>';
      }
      html += '<div style="color: var(--ac-text); font-size: 0.85rem;">';
      if (steps.transferOwnership.completed && steps.transferOwnership.newOwner) {
        html += '<div style="padding: 0.25rem 0;"><i class="fas fa-check" style="color: var(--ac-green); margin-right: 0.5rem;"></i> Ownership transferred to ' + displayUser(steps.transferOwnership.newOwner) + (steps.transferOwnership.newOwner.email ? ' (' + steps.transferOwnership.newOwner.email + ')' : '') + '</div>';
      }
      if (steps.transferOwnership.addedToHeadAdmin && steps.transferOwnership.newOwner) {
        html += '<div style="padding: 0.25rem 0;"><i class="fas fa-check" style="color: var(--ac-green); margin-right: 0.5rem;"></i> ' + displayUser(steps.transferOwnership.newOwner) + ' added to Head Admin role</div>';
      }
      if (steps.removeBadActor.completed && !steps.removeBadActor.skipped && steps.removeBadActor.badActor) {
        html += '<div style="padding: 0.25rem 0;"><i class="fas fa-check" style="color: var(--ac-green); margin-right: 0.5rem;"></i> ' + displayUser(steps.removeBadActor.badActor) + ' removed from community</div>';
      }
      if (steps.removeBadActor.banned && steps.removeBadActor.badActor) {
        html += '<div style="padding: 0.25rem 0;"><i class="fas fa-check" style="color: var(--ac-green); margin-right: 0.5rem;"></i> ' + displayUser(steps.removeBadActor.badActor) + ' banned from rejoining</div>';
      }
      if (steps.removeBadActor.skipped) {
        html += '<div style="padding: 0.25rem 0; color: var(--ac-text-muted);"><i class="fas fa-forward" style="margin-right: 0.5rem;"></i> Bad actor removal skipped</div>';
      }
      if (caseState._dangerousRoles && caseState._dangerousRoles.length > 0) {
        html += '<div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid rgba(255,255,255,0.06);">';
        html += '<div style="color: var(--ac-amber); font-size: 0.85rem;"><i class="fas fa-exclamation-triangle"></i> Roles with Administrator permission still active:</div>';
        caseState._dangerousRoles.forEach(function(role) {
          html += '<div style="padding: 0.25rem 0; padding-left: 1.5rem; color: var(--ac-text-muted); font-size: 0.85rem;">\u2022 ' + role.name + ' \u2014 ' + (role.members.map(function(m) { return displayUser(m); }).join(', ') || 'No members') + '</div>';
        });
        html += '</div>';
      }
      html += '</div></div>';

      // Copy block
      html += '<div style="position: relative; margin-top: 1rem;">';
      html += '<button class="ac-btn" onclick="caseCopySummary()" style="position: absolute; top: 0.5rem; right: 0.5rem; font-size: 0.75rem; padding: 0.25rem 0.75rem;" id="caseCopySummaryBtn"><i class="fas fa-copy"></i> Copy</button>';
      html += '<pre style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 1rem; padding-right: 5rem; color: var(--ac-text-muted); font-size: 0.8rem; white-space: pre-wrap; word-break: break-word; max-height: 250px; overflow-y: auto; font-family: \'JetBrains Mono\', monospace;">' + caseGenerateSummaryText() + '</pre>';
      html += '</div>';

      if (!isReadOnly) {
        html += '<div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">';
        html += '<button class="ac-btn ac-btn-accent" onclick="caseComplete()"><i class="fas fa-check"></i> Done</button>';
        html += '</div>';
      } else {
        html += '<div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">';
        html += '<button class="ac-btn" onclick="backToCasesList()"><i class="fas fa-arrow-left"></i> Back to Cases</button>';
        html += '</div>';
      }

      $('#case-detail-content').html(html);
    }

    // Collect every admin who touched the case (creator + each step's performer),
    // de-duped by email, in the order they first contributed.
    function caseCollectPerformers() {
      var seen = {};
      var ordered = [];
      function add(p) {
        if (!p) return;
        var key = (p.adminEmail || p.adminName || '').toLowerCase();
        if (!key || seen[key]) return;
        seen[key] = true;
        ordered.push(p);
      }
      add(caseState.createdBy);
      var steps = caseState.steps || {};
      ['transferOwnership', 'headAdmin', 'roleAudit', 'removeBadActor', 'summary'].forEach(function(k) {
        if (steps[k] && steps[k].performedBy) add(steps[k].performedBy);
      });
      return ordered;
    }

    function caseFormatPerformers(performers) {
      if (!performers || !performers.length) return 'Unknown';
      return performers.map(function(p) {
        var name = p.adminName || p.adminEmail || 'Unknown';
        var role = p.adminRole || 'admin';
        return name + ' (' + role + ')';
      }).join(', ');
    }

    function caseGenerateSummaryText() {
      var steps = caseState.steps;
      var isCancelled = caseState.status === 'cancelled';
      var now = new Date().toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });

      if (isCancelled) {
        var text = '\u274c CASE CANCELLED \u2014 Community: "' + caseState.communityName + '"\n';
        text += 'Cancelled by: ' + (caseState.cancelledBy || 'Unknown') + ' on ' + now + '\n';
        text += 'Reason: ' + (caseState.cancelledReason || 'No reason provided') + '\n';
        // Show any actions that were taken before cancellation
        var hasActions = steps.transferOwnership.completed || steps.removeBadActor.completed;
        if (hasActions) {
          text += '\nActions taken before cancellation:\n';
          var n = 1;
          if (steps.transferOwnership.completed && steps.transferOwnership.newOwner) {
            var oldOwnerName = displayUser(steps.transferOwnership.oldOwner);
            text += n++ + '. Ownership transferred: ' + oldOwnerName + ' \u2192 ' + displayUser(steps.transferOwnership.newOwner) + '\n';
          }
          if (steps.transferOwnership.addedToHeadAdmin && steps.transferOwnership.newOwner) {
            text += n++ + '. ' + displayUser(steps.transferOwnership.newOwner) + ' added to Head Admin role\n';
          }
          if (steps.removeBadActor.completed && !steps.removeBadActor.skipped && steps.removeBadActor.badActor) {
            text += n++ + '. ' + displayUser(steps.removeBadActor.badActor) + ' removed from community\n';
          }
          if (steps.removeBadActor.banned && steps.removeBadActor.badActor) {
            text += n++ + '. ' + displayUser(steps.removeBadActor.badActor) + ' banned from community\n';
          }
        }
        return text;
      }

      var text = '\u2705 OWNERSHIP RESET COMPLETE \u2014 Community: "' + caseState.communityName + '"\n';
      text += 'Performed by: ' + caseFormatPerformers(caseCollectPerformers()) + ' on ' + now + '\n\n';
      text += 'Actions taken:\n';
      var n = 1;
      if (steps.transferOwnership.completed && steps.transferOwnership.newOwner) {
        var oldOwnerName = displayUser(steps.transferOwnership.oldOwner);
        text += n++ + '. Ownership transferred: ' + oldOwnerName + ' \u2192 ' + displayUser(steps.transferOwnership.newOwner) + '\n';
      }
      if (steps.transferOwnership.addedToHeadAdmin) {
        text += n++ + '. ' + displayUser(steps.transferOwnership.newOwner) + ' added to Head Admin role\n';
      }
      if (steps.removeBadActor.completed && !steps.removeBadActor.skipped && steps.removeBadActor.badActor) {
        text += n++ + '. ' + displayUser(steps.removeBadActor.badActor) + ' removed from community\n';
      }
      if (steps.removeBadActor.banned && steps.removeBadActor.badActor) {
        text += n++ + '. ' + displayUser(steps.removeBadActor.badActor) + ' banned from community\n';
      }
      if (caseState._dangerousRoles && caseState._dangerousRoles.length > 0) {
        text += '\n\u26a0\ufe0f Roles with Administrator permission still active:\n';
        caseState._dangerousRoles.forEach(function(role) {
          text += '\u2022 ' + role.name + ' \u2014 Members: ' + (role.members.map(function(m) { return displayUser(m); }).join(', ') || 'None') + '\n';
        });
      }
      return text;
    }

    function caseCopySummary() {
      navigator.clipboard.writeText(caseGenerateSummaryText()).then(function() {
        $('#caseCopySummaryBtn').html('<i class="fas fa-check"></i> Copied!');
        setTimeout(function() { $('#caseCopySummaryBtn').html('<i class="fas fa-copy"></i> Copy'); }, 2000);
      });
    }

    function caseComplete() {
      saveCaseStep('summary', {}, function() {
        $.ajax({
          url: API_BASE + '/api/v1/admin/cases/' + caseState.id + '/complete',
          method: 'PATCH',
          contentType: 'application/json',
          data: JSON.stringify({}),
          success: function() { backToCasesList(); },
          error: function() { backToCasesList(); }
        });
      });
    }

      function initiateUserPasswordReset(userId, userEmail) {
        showConfirmModal(
          'Initiate User Password Reset',
          `This will send a password reset email to <strong>${userEmail}</strong>. The user must complete the reset themselves using the link in their email.<br><br><strong>Note:</strong> You will not see the reset link or password. This is for security.`,
          function() {
            // Find and update the button to show loading state
            const resetButton = $(`button[onclick*="initiateUserPasswordReset('${userId}', '${userEmail}')"]`);
            const originalText = resetButton.html();
            resetButton.html('<i class="fas fa-spinner fa-spin"></i> Sending...');
            resetButton.prop('disabled', true);
            
            // Store button reference for use in callbacks
            const buttonRef = resetButton;
            const textRef = originalText;
            
            // Use the existing forgot-password route directly
            $.ajax({
              url: '/forgot-password',
              method: 'POST',
              data: { email: userEmail },
              success: function(data) {
                showInfoModal(
                  'Password Reset Initiated', 
                  `Password reset email sent successfully to <strong>${userEmail}</strong>!<br><br>The user will receive an email with a secure reset link. They must complete the password reset themselves.<br><br><strong>Security Note:</strong> You cannot see the reset link or new password.`
                );
                // Track this action for the logged-in admin
                trackAdminAction('user_reset_initiated', `Initiated password reset for user: ${userEmail}`);
              },
              error: function(xhr) {
                showInfoModal('Error', `Failed to initiate password reset: ${xhr.responseText || 'Unknown error'}`);
              },
              complete: function() {
                // Restore button to original state
                buttonRef.html(textRef);
                buttonRef.prop('disabled', false);
              }
