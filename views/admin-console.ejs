                    <i class="fas fa-user-tag"></i> Roles
                  </button>
                </div>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <div class="info-label">Owner</div>
                  <div class="info-value">${community.owner?.email || 'Unknown'}</div>
                </div>
                <div class="info-item">
                  <div class="info-label">Members</div>
                  <div class="info-value">${community.memberCount || 0}</div>
                </div>
                <div class="info-item">
