            $.ajax({
              url: `${API_BASE}/api/v1/admin/users/${userId}/reactivate`,
              method: 'POST',
              data: JSON.stringify({ 
                currentUser: {
                  email: currentUserEmail,
                  roles: roles
                }
              }),
              contentType: 'application/json',
              timeout: 10000, // 10 second timeout
              success: function(data) {
                showInfoModal('Success', `Account reactivated successfully for <strong>${userEmail}</strong>!`);
                
                // Track this action - use 'account_reactivated' type to match backend spec
                logAdminAction('account_reactivated', 'User account reactivated', `Reactivated account for user: ${userEmail}`);
                
                // Refresh the user results to show updated status
                const currentQuery = $('#userSearch').val().trim();
                if (currentQuery) {
                  searchUsers(currentQuery, currentUserPage);
                }
              },
              error: function(xhr, status, error) {
                let errorMessage = 'Unknown error occurred';
                
                if (status === 'timeout') {
                  errorMessage = 'Request timed out. The backend may not be responding.';
                } else if (xhr.status === 404) {
                  errorMessage = 'Reactivate endpoint not found. Backend may not be implemented yet.';
                } else if (xhr.status === 403) {
                  errorMessage = 'Permission denied. You may not have admin privileges.';
                } else if (xhr.responseJSON?.error) {
                  errorMessage = xhr.responseJSON.error;
                } else if (xhr.statusText) {
                  errorMessage = `${xhr.status}: ${xhr.statusText}`;
                }
                
                showInfoModal('Reactivation Failed', `Failed to reactivate account: ${errorMessage}`);
              },
              complete: function() {
                // Restore button to original state
                reactivateButton.html(originalText);
                reactivateButton.prop('disabled', false);
              }
            });
          }
        );
      }
      
