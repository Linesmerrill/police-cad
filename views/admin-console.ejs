                    <i class="fas fa-key"></i> Reset Password
                  </button>
                  ${user.isDeactivated ? `<button class="btn btn-success btn-sm" onclick="reactivateUserAccount('${user.id}', '${user.email}')">
                    <i class="fas fa-user-check"></i> Reactivate Account
                  </button>` : ''}
                </div>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <div class="info-label">Status</div>
                  <div class="info-value">
                    <span class="status-badge ${user.isDeactivated ? 'status-inactive' : 'status-active'}">
                      ${user.isDeactivated ? 'Deactivated' : 'Active'}
                    </span>
                  </div>
                </div>
                <div class="info-item">
                  <div class="info-label">Created</div>
                  <div class="info-value">${new Date(user.createdAt).toLocaleDateString()}</div>
                </div>
                <div class="info-item">
