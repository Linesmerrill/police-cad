      // Helper functions for departments pagination
      function generateDepartmentsList(departments, startIndex, count) {
        const endIndex = Math.min(startIndex + count, departments.length);
        const pageDepartments = departments.slice(startIndex, endIndex);
        
        let html = '';
        pageDepartments.forEach(dept => {
          html += `
            <div style="background: #11131a; padding: 1rem; border-radius: 8px; margin: 0.5rem 0; border: 1px solid #2a2d45;">
              <strong>${dept.name || 'Unnamed Department'}</strong> - ${dept.memberCount || 0} ${(dept.memberCount || 0) === 1 ? 'member' : 'members'}
            </div>
          `;
        });
        
        return html;
      }
      
      function generateDepartmentsPagination(totalDepartments, currentPage) {
        const departmentsPerPage = 5;
        const totalPages = Math.ceil(totalDepartments / departmentsPerPage);
        
        if (totalPages <= 1) {
          return '';
        }
        
        const startResult = currentPage * departmentsPerPage + 1;
        const endResult = Math.min((currentPage + 1) * departmentsPerPage, totalDepartments);
        
        let html = `
          <div class="departments-pagination" style="margin-top: 1rem; text-align: center; padding: 1rem; border-top: 1px solid #2a2d45;">
            <div class="pagination-info" style="margin-bottom: 1rem; color: #9aa0b4;">
              Showing ${startResult}-${endResult} of ${totalDepartments} departments
            </div>
            <div class="pagination-controls">
        `;
        
        // Previous button
        if (currentPage > 0) {
          html += `<button class="btn btn-secondary btn-sm" onclick="changeDepartmentsPage(-1)" style="margin-right: 0.5rem;">
            <i class="fas fa-chevron-left"></i> Previous
          </button>`;
        } else {
          html += `<button class="btn btn-secondary btn-sm" disabled style="margin-right: 0.5rem;">
            <i class="fas fa-chevron-left"></i> Previous
          </button>`;
        }
        
        // Page info
        html += `<span style="margin: 0 1rem; color: #9aa0b4;">Page ${currentPage + 1} of ${totalPages}</span>`;
        
        // Next button
        if (currentPage < totalPages - 1) {
          html += `<button class="btn btn-secondary btn-sm" onclick="changeDepartmentsPage(1)" style="margin-left: 0.5rem;">
            Next <i class="fas fa-chevron-right"></i>
          </button>`;
        } else {
          html += `<button class="btn btn-secondary btn-sm" disabled style="margin-left: 0.5rem;">
            Next <i class="fas fa-chevron-right"></i>
          </button>`;
        }
        
        html += `
            </div>
          </div>
        `;
        
        return html;
      }
      

      
      function changeDepartmentsPage(direction) {
        const newPage = currentDepartmentsPage + direction;
        const totalPages = Math.ceil(currentCommunityDepartments.length / 5);
        
        if (newPage < 0 || newPage >= totalPages) {
          return;
        }
        
        currentDepartmentsPage = newPage;
        
        // Update departments list
        $('#departmentsList').html(generateDepartmentsList(currentCommunityDepartments, currentDepartmentsPage, 5));
        
        // Update pagination controls
        const totalDepartments = currentCommunityDepartments.length;
        $('.departments-pagination').replaceWith(generateDepartmentsPagination(totalDepartments, currentDepartmentsPage));
      }
      
