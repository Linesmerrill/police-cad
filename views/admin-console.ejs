      // Generate pagination controls for search results
      function generatePaginationControls(type, totalResults, currentPage) {
        const totalPages = Math.ceil(totalResults / resultsPerPage);
        
        if (totalPages <= 1) {
          return '';
        }
        
        const startResult = currentPage * resultsPerPage + 1;
        const endResult = Math.min((currentPage + 1) * resultsPerPage, totalResults);
        
        let html = `
          <div class="pagination-container" style="margin-top: 2rem; text-align: center; padding: 1rem; border-top: 1px solid #2a2d45;">
            <div class="pagination-info" style="margin-bottom: 1rem; color: #9aa0b4;">
              Showing ${startResult}-${endResult} of ${totalResults} results
            </div>
            <div class="pagination-controls">
        `;
        
        // Previous button
        if (currentPage > 0) {
          html += `<button class="btn btn-secondary btn-sm" onclick="change${type.charAt(0).toUpperCase() + type.slice(1)}Page(-1)" style="margin-right: 0.5rem;">
            <i class="fas fa-chevron-left"></i> Previous
          </button>`;
        } else {
          html += `<button class="btn btn-secondary btn-sm" disabled style="margin-right: 0.5rem;">
            <i class="fas fa-chevron-left"></i> Previous
          </button>`;
        }
        
        // Page info
        html += `<span style="margin: 0 1rem; color: #9aa0b4;">Page ${currentPage + 1} of ${totalPages}</span>`;
        
        // Next button
        if (currentPage < totalPages - 1) {
          html += `<button class="btn btn-secondary btn-sm" onclick="change${type.charAt(0).toUpperCase() + type.slice(1)}Page(1)" style="margin-left: 0.5rem;">
            Next <i class="fas fa-chevron-right"></i>
          </button>`;
        } else {
          html += `<button class="btn btn-secondary btn-sm" disabled style="margin-left: 0.5rem;">
            Next <i class="fas fa-chevron-right"></i>
          </button>`;
        }
        
        html += `
            </div>
          </div>
        `;
        
        return html;
      }
      
      // User Actions
      function viewUserDetails(userId) {
        $('#userModalTitle').text('Loading User Details...');
        $('#userModalBody').html('<div class="loading">Loading...</div>');
        $('#userModal').modal('show');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/users/${userId}`,
          method: 'GET',

          success: function(data) {
            displayUserDetails(data.user);
          },
          error: function(xhr) {
            $('#userModalBody').html(`<div class="error">Error loading user: ${xhr.responseJSON?.error || 'Unknown error'}</div>`);
          }
        });
      }
      
      function displayUserDetails(user) {
        // Convert MongoDB ObjectId to creation date
