<!DOCTYPE html>
<html>
  <head>
    <% include ad-header %>
    <meta charset="utf-8">
    <title>LPC - Admin Console</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/static/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/static/css/styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
      body { 
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0b1220 100%);
        color: #e5e7eb;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      .admin-navbar {
        background: rgba(30, 32, 40, 0.95) !important;
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #35385a;
        min-height: 60px;
      }
      .admin-navbar .navbar-brand { 
        color: #fff !important; 
        font-weight: 600; 
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      .admin-navbar .btn-link { 
        color: #9aa0b4 !important; 
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      .admin-navbar .btn-link:hover { color: #c7cbe2 !important; }
      .admin-navbar .navbar-nav > li > span {
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      
      .admin-container { margin-top: 80px; padding: 2rem 0; }
      .search-card {
        background: #1e2028;
        border: 1px solid #35385a;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      }
      .search-input {
        background: #11131a;
        border: 1px solid #2a2d45;
        color: #e5e7eb;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
      }
      .search-input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102,126,234,0.25);
        outline: none;
      }
      .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        color: #fff;
        transition: all 0.2s;
      }
      .btn-gradient:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        color: #fff;
      }
      .btn-secondary {
        background: #35385a;
        border: 1px solid #4a4f7a;
        color: #e5e7eb;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s;
      }
      .btn-secondary:hover {
        background: #4a4f7a;
        color: #fff;
      }
      
      .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
      }
      .result-card {
        background: #1e2028;
        border: 1px solid #35385a;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
      }
      .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #2a2d45;
      }
      .result-title { font-size: 1.25rem; font-weight: 600; color: #fff; margin: 0; }
      .result-subtitle { color: #9aa0b4; font-size: 0.9rem; }
      .action-buttons { display: flex; gap: 0.5rem; flex-wrap: wrap; }
      .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin: 1rem 0;
      }
      .info-item {
        background: #11131a;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #2a2d45;
      }
      .info-label { color: #9aa0b4; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.25rem; }
      .info-value { color: #e5e7eb; font-weight: 500; }
      .status-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
      }
      .status-active { background: #10b981; color: #fff; }
      .status-inactive { background: #ef4444; color: #fff; }
      .status-pending { background: #f59e0b; color: #fff; }
      .loading { text-align: center; padding: 2rem; color: #9aa0b4; }
      .error { background: #dc2626; color: #fff; padding: 1rem; border-radius: 8px; margin: 1rem 0; }
      .success { background: #059669; color: #fff; padding: 1rem; border-radius: 8px; margin: 1rem 0; }
      .search-tabs { margin-bottom: 1.5rem; }
      .search-tabs .nav-tabs { border-bottom: 1px solid #2a2d45; }
      .search-tabs .nav-tabs > li > a {
        background: transparent;
        border: none;
        color: #9aa0b4;
        border-radius: 8px 8px 0 0;
        margin-right: 0.5rem;
        padding: 0.75rem 1.5rem;
      }
      .search-tabs .nav-tabs > li.active > a,
      .search-tabs .nav-tabs > li > a:hover {
        background: #667eea;
        color: #fff;
        border: none;
      }
      .search-tabs .tab-content { padding-top: 1rem; }
      
      .input-group-btn .btn {
        border-radius: 0 8px 8px 0;
        border-left: none;
      }
      
      .input-group .form-control {
        border-radius: 8px 0 0 8px;
      }
      
      /* Activity Tracking Styles */
      .stat-card {
        background: #11131a;
        border: 1px solid #2a2d45;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        margin-bottom: 1rem;
      }
      
      .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 0.5rem;
      }
      
      .stat-label {
        color: #9aa0b4;
        font-size: 0.9rem;
        text-transform: uppercase;
      }
      
      .timeline-filters {
        margin-bottom: 1.5rem;
      }
      
      .timeline-filters .btn {
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
      }
      
      .timeline-filters .btn.active {
        background: #667eea;
        border-color: #667eea;
      }
      
      .chart-container {
        background: #11131a;
        border: 1px solid #2a2d45;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        min-height: 200px;
      }
      
      .chart-bars {
        display: flex;
        align-items: end;
        justify-content: space-around;
        height: 150px;
        padding: 1rem 0;
      }
      
      .chart-bar {
        background: linear-gradient(135deg, #667eea, #764ba2);
        border-radius: 4px 4px 0 0;
        min-width: 30px;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      
      .bar-label {
        position: absolute;
        bottom: -25px;
        font-size: 0.8rem;
        color: #9aa0b4;
        transform: rotate(-45deg);
        white-space: nowrap;
      }
      
      .activity-item {
        display: flex;
        align-items: flex-start;
        padding: 1rem;
        border-bottom: 1px solid #2a2d45;
      }
      
      .activity-item:last-child {
        border-bottom: none;
      }
      
      .activity-icon {
        margin-right: 1rem;
        font-size: 1.2rem;
        margin-top: 0.2rem;
      }
      
      .activity-content {
        flex: 1;
      }
      
      .activity-title {
        color: #e5e7eb;
        font-weight: 600;
        margin-bottom: 0.25rem;
      }
      
      .activity-time {
        color: #9aa0b4;
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
      }
      
      .activity-details {
        color: #9aa0b4;
        font-size: 0.9rem;
        font-style: italic;
      }
      
      .text-success { color: #10b981 !important; }
      .text-warning { color: #f59e0b !important; }
      .text-info { color: #3b82f6 !important; }
      .text-primary { color: #667eea !important; }
      .text-secondary { color: #9aa0b4 !important; }
      .text-muted { color: #6b7280 !important; }
      
      /* Role Management Styles */
      .role-management h6 {
        color: #e5e7eb;
        margin-bottom: 0.75rem;
        font-weight: 600;
      }
      
      .current-roles {
        margin-bottom: 1rem;
      }
      
      .role-checkboxes {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      
      .role-checkbox {
        display: flex;
        align-items: center;
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 8px;
        transition: background-color 0.2s;
      }
      
      .role-checkbox:hover {
        background: #2a2d45;
      }
      
      .role-checkbox input[type="checkbox"] {
        margin-right: 0.75rem;
        transform: scale(1.2);
      }
      
      .role-checkbox span {
        color: #e5e7eb;
        font-weight: 500;
      }
      
      .role-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: flex-end;
      }
      
      /* Admin Actions Container */
      .admin-actions-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: stretch;
      }
      
      .admin-actions-container .btn {
        flex: 1;
        min-width: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        white-space: nowrap;
      }
      
      .admin-actions-container .btn i {
        flex-shrink: 0;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-default navbar-fixed-top admin-navbar">
      <div class="container-fluid">
        <div class="navbar-header">
          <a class="navbar-brand" href="/admin/console">
            <img src="/static/images/dispatch-logo-512.png" style="width:32px; height:32px; margin-right:10px; border-radius:8px;" />
            LPC Admin Console
          </a>
        </div>
        <div class="navbar-collapse collapse">
          <ul class="nav navbar-nav navbar-right">
            <li>
              <span style="color: #9aa0b4;">
                <i class="fas fa-user" style="margin-right: 8px;"></i>
                <%= admin && admin.email ? admin.email : 'Admin' %>
              </span>
            </li>
            <li>
              <form action="/admin/logout" method="post" style="display:inline;">
                <button type="submit" class="btn btn-link">
                  <i class="fas fa-sign-out-alt" style="margin-right: 8px;"></i>Logout
                </button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container admin-container">
      <div class="search-card">
        <h2 style="margin-bottom: 1.5rem; color: #fff; font-weight: 700;">
          <i class="fas fa-search" style="margin-right: 12px; color: #667eea;"></i>
          Admin Search & Management
        </h2>
        
        <div class="admin-actions" style="margin-bottom: 1.5rem; text-align: right;">
          <button class="btn btn-gradient" onclick="showAddAdminModal()">
            <i class="fas fa-plus" style="margin-right: 8px;"></i>Add Admin
          </button>
        </div>
        
        <div class="search-tabs">
          <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" class="active">
              <a href="#users-tab" data-toggle="tab">
                <i class="fas fa-users" style="margin-right: 8px;"></i>Users
              </a>
            </li>
            <li role="presentation">
              <a href="#communities-tab" data-toggle="tab">
                <i class="fas fa-building" style="margin-right: 8px;"></i>Communities
              </a>
            </li>
            <li role="presentation" id="admin-management-tab">
              <a href="#admin-management-tab-content" data-toggle="tab">
                <i class="fas fa-shield-alt" style="margin-right: 8px;"></i>Admin Management
              </a>
            </li>
          </ul>
          
          <div class="tab-content">
            <!-- Users Tab -->
            <div role="tabpanel" class="tab-pane active" id="users-tab">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="userSearch" class="form-control search-input" 
                         placeholder="Search users by email or username..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchUsersBtn" class="btn btn-gradient btn-block">
                    <i class="fas fa-search" style="margin-right: 8px;"></i>Search Users
                  </button>
                </div>
              </div>
              <div id="userResults"></div>
            </div>
            
            <!-- Communities Tab -->
            <div role="tabpanel" class="tab-pane" id="communities-tab">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="communitySearch" class="form-control search-input" 
                         placeholder="Search communities by name..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchCommunitiesBtn" class="btn btn-gradient btn-block">
                    <i class="fas fa-search" style="margin-right: 8px;"></i>Search Communities
                  </button>
                </div>
              </div>
              <div id="communityResults"></div>
            </div>
            
            <!-- Admin Management Tab -->
            <div role="tabpanel" class="tab-pane" id="admin-management-tab-content">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="adminSearch" class="form-control search-input" 
                         placeholder="Search admins by email..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchAdminsBtn" class="btn btn-gradient btn-block">
                    <i class="fas fa-search" style="margin-right: 8px;"></i>Search Admins
                  </button>
                </div>
              </div>
              <div id="adminResults">
                <div class="loading" style="text-align: center; padding: 2rem; color: #9aa0b4;">
                  <i class="fas fa-spinner fa-spin"></i> Loading all admins...
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- User Details Modal -->
    <div class="modal fade" id="userModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="userModalTitle">User Details</h4>
          </div>
          <div class="modal-body" id="userModalBody">
            <!-- User details will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Community Details Modal -->
    <div class="modal fade" id="communityModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="communityModalTitle">Community Details</h4>
          </div>
          <div class="modal-body" id="communityModalBody">
            <!-- Community details will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="confirmModalTitle">Confirm Action</h4>
          </div>
          <div class="modal-body" id="confirmModalBody">
            <!-- Confirmation message will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-gradient" id="confirmModalBtn">Confirm</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Success/Info Modal -->
    <div class="modal fade" id="infoModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="infoModalTitle">Information</h4>
          </div>
          <div class="modal-body" id="infoModalBody">
            <!-- Info message will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-gradient" data-dismiss="modal">OK</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Add Admin Modal -->
    <div class="modal fade" id="addAdminModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title">Add New Admin</h4>
          </div>
          <div class="modal-body">
            <div class="form-group">
              <label for="newAdminEmail" style="color: #e5e7eb; margin-bottom: 0.5rem;">Email Address</label>
              <input type="email" id="newAdminEmail" class="form-control" 
                     placeholder="Enter email address" 
                     style="background: #11131a; border: 1px solid #2a2d45; color: #e5e7eb;">
            </div>
            <div class="form-group">
              <label for="adminRole" style="color: #e5e7eb; margin-bottom: 0.5rem;">Admin Role</label>
              <select id="adminRole" class="form-control" 
                      style="background: #11131a; border: 1px solid #2a2d45; color: #e5e7eb;">
                <option value="admin">Admin</option>
                <option value="owner">Owner</option>
              </select>
            </div>
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-gradient" onclick="addNewAdmin()">
              <i class="fas fa-plus" style="margin-right: 8px;"></i>Add Admin
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Reset Link Modal -->
    <div class="modal fade" id="adminResetLinkModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title">Admin Account Created</h4>
          </div>
          <div class="modal-body" id="adminResetLinkBody">
            <!-- Reset link and options will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Details Modal -->
    <div class="modal fade" id="adminDetailsModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="adminDetailsModalTitle">Admin Details</h4>
          </div>
          <div class="modal-body" id="adminDetailsModalBody">
            <!-- Admin details will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Role Management Modal -->
    <div class="modal fade" id="roleManagementModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="roleManagementModalTitle">Manage Admin Roles</h4>
          </div>
          <div class="modal-body" id="roleManagementModalBody">
            <!-- Role management interface will be loaded here -->
          </div>
        </div>
      </div>
    </div>

    <script src="/static/js/jquery.min.js"></script>
    <script src="/static/js/bootstrap.min.js"></script>
    <script>
      // Global API configuration
      const API_BASE = '<%= process.env.POLICE_CAD_API_URL || "/api" %>';
      const API_TOKEN = '<%= process.env.POLICE_CAD_API_TOKEN || "" %>';
      
      // Check current user role and show admin management tab if owner
      $(document).ready(function() {
        // Check if current user is owner (you can modify this logic based on your backend)
        const currentUserEmail = '<%= admin && admin.email ? admin.email : "" %>';
        const currentUserRoles = '<%= admin && admin.roles ? JSON.stringify(admin.roles) : (admin && admin.role ? JSON.stringify([admin.role]) : "[]") %>';
        
        // Parse roles array
        let roles = [];
        try {
          roles = JSON.parse(currentUserRoles);
        } catch (e) {
          roles = [];
        }
        
        // Show admin management tab if user has owner role
        if (roles.includes('owner')) {
          $('#admin-management-tab').show();
        }
        
        // Load all admins when admin management tab is clicked
        $('a[href="#admin-management-tab-content"]').on('click', function() {
          loadAllAdmins();
        });
        
        // Event delegation for admin action buttons
