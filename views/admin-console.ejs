      // Function to search for a user by email and switch to users tab
      function searchUserByEmail(userEmail) {
        // Validate email
        if (!userEmail || userEmail.trim() === '') {
          showInfoModal('Invalid Email', 'Cannot search for empty email address.');
          return;
        }
        
        // Close the community modal
        $('#communityModal').modal('hide');

        // Wait a moment for modal to close, then switch panels
        setTimeout(() => {
          acNavTo('users');

          // Set the search input value
          $('#userSearch').val(userEmail);

          // Trigger the search
          searchUsers(userEmail, 0);
          
          // Track this action
          trackAdminAction('user_search', `Searched for user from community details: "${userEmail}"`);
        }, 300);
      }
      
      // Admin Management Functions
      function showAddAdminModal() {
        $('#newAdminEmail').val('');
        $('#adminRole').val('admin');
        
        // Clear any previous error messages
        $('#addAdminModal .alert').remove();
        
        $('#addAdminModal').modal('show');
