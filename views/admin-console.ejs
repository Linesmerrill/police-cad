<!DOCTYPE html>
<html>
  <head>
    <% include ad-header %>
    <meta charset="utf-8">
    <title>LPC - Admin Console</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/static/images/admin-favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/images/admin-favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/images/admin-favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/images/admin-apple-touch-icon.png">
    <link rel="stylesheet" href="/static/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/static/css/styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
      html, body { 
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0b1220 100%);
        background-attachment: fixed;
        background-size: cover;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        overflow-x: hidden;
      }
      
      /* Ensure background covers overscroll areas */
      html {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0b1220 100%);
        background-attachment: fixed;
        background-size: cover;
      }
      
      body { 
        color: #e5e7eb;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      .admin-navbar {
        background: rgba(30, 32, 40, 0.95) !important;
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #35385a;
        min-height: 60px;
      }
      .admin-navbar .navbar-brand { 
        color: #fff !important; 
        font-weight: 600; 
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      .admin-navbar .btn-link { 
        color: #9aa0b4 !important; 
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      .admin-navbar .btn-link:hover { color: #c7cbe2 !important; }
      .admin-navbar .navbar-nav > li > span {
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      
      .admin-container { margin-top: 80px; padding: 2rem 0; }
      .search-card {
        background: #1e2028;
        border: 1px solid #35385a;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      }
      .search-input {
        background: #11131a;
        border: 1px solid #2a2d45;
        color: #e5e7eb;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
      }
      .search-input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102,126,234,0.25);
        outline: none;
      }
      .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        color: #fff;
        transition: all 0.2s;
      }
      .btn-gradient:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        color: #fff;
      }
      .btn-secondary {
        background: #35385a;
        border: 1px solid #4a4f7a;
        color: #e5e7eb;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s;
      }
      .btn-secondary:hover {
        background: #4a4f7a;
        color: #fff;
      }
      
      .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
      }
      .result-card {
        background: #1e2028;
        border: 1px solid #35385a;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
      }
      .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #2a2d45;
      }
      .result-title { font-size: 1.25rem; font-weight: 600; color: #fff; margin: 0; }
      .result-subtitle { color: #9aa0b4; font-size: 0.9rem; }
      .action-buttons { display: flex; gap: 0.5rem; flex-wrap: wrap; }
      .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin: 1rem 0;
        width: 100%;
        overflow: hidden;
      }
      .info-item {
        background: #11131a;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #2a2d45;
        min-width: 0; /* Allows grid items to shrink below content size */
        overflow: hidden;
      }
      
      /* Specific styling for owner info item */
      .owner-info-item {
        word-break: break-all;
        overflow-wrap: break-word;
        word-wrap: break-word;
      }
      .info-label { color: #9aa0b4; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.25rem; }
      .info-value { 
        color: #e5e7eb; 
        font-weight: 500; 
        word-wrap: break-word;
        overflow-wrap: break-word;
        max-width: 100%;
        white-space: normal;
        overflow: hidden;
      }
      .status-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
      }
      .status-active { background: #10b981; color: #fff; }
      .status-inactive { background: #ef4444; color: #fff; }
      .status-pending { background: #f59e0b; color: #fff; }
      .status-muted { background: #6b7280; color: #fff; }
      
      /* Owner button specific styling */
      .owner-search-button {
        color: #667eea !important;
        text-decoration: none !important;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        max-width: 100% !important;
        white-space: normal !important;
        text-align: left !important;
        display: inline-block !important;
        width: 100% !important;
      }
      
      /* Modal overflow handling */
      .modal-content {
        overflow: hidden;
        width: 100%;
      }
      
      .modal-body {
        overflow-x: hidden !important;
        width: 100% !important;
      }
      
      .loading { text-align: center; padding: 2rem; color: #9aa0b4; }
      .error { background: #dc2626; color: #fff; padding: 1rem; border-radius: 8px; margin: 1rem 0; }
      .success { background: #059669; color: #fff; padding: 1rem; border-radius: 8px; margin: 1rem 0; }
      .search-tabs { margin-bottom: 1.5rem; }
      .search-tabs .nav-tabs { border-bottom: 1px solid #2a2d45; }
      .search-tabs .nav-tabs > li > a {
        background: transparent;
        border: none;
        color: #9aa0b4;
        border-radius: 8px 8px 0 0;
        margin-right: 0.5rem;
        padding: 0.75rem 1.5rem;
      }
      .search-tabs .nav-tabs > li.active > a,
      .search-tabs .nav-tabs > li > a:hover {
        background: #667eea;
        color: #fff;
        border: none;
      }
      .search-tabs .tab-content { padding-top: 1rem; }
      
      .input-group-btn .btn {
        border-radius: 0 8px 8px 0;
        border-left: none;
      }
      
      .input-group .form-control {
        border-radius: 8px 0 0 8px;
      }
      
      /* Activity Tracking Styles */
      .stat-card {
        background: #11131a;
        border: 1px solid #2a2d45;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        margin-bottom: 1rem;
      }
      
      .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 0.5rem;
      }
      
      .stat-label {
        color: #9aa0b4;
        font-size: 0.9rem;
        text-transform: uppercase;
      }
      
      .timeline-filters {
        margin-bottom: 1.5rem;
      }
      
      .timeline-filters .btn {
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
      }
      
      .timeline-filters .btn.active {
        background: #667eea;
        border-color: #667eea;
      }
      
      .chart-container {
        background: #11131a;
        border: 1px solid #2a2d45;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        min-height: 200px;
        overflow: hidden;
      }
      
      .chart-bars {
        display: flex;
        align-items: end;
        justify-content: space-between;
        height: 150px;
        padding: 1rem 0;
        gap: 8px;
      }
      
      .chart-bar {
        background: linear-gradient(135deg, #667eea, #764ba2);
        border-radius: 4px 4px 0 0;
        flex: 1;
        min-width: 20px;
        max-width: 40px;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      
      .chart-bar-empty {
        background: transparent !important;
        border: 1px solid #374151;
        border-bottom: none;
      }
      
      .bar-label {
        position: absolute;
        bottom: -25px;
        font-size: 0.7rem;
        color: #9aa0b4;
        transform: rotate(-45deg);
        white-space: nowrap;
        max-width: 60px;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      
      .activity-item {
        display: flex;
        align-items: flex-start;
        padding: 1rem;
        border-bottom: 1px solid #2a2d45;
      }
      
      .activity-item:last-child {
        border-bottom: none;
      }
      
      .activity-icon {
        margin-right: 1rem;
        font-size: 1.2rem;
        margin-top: 0.2rem;
      }
      
      .activity-content {
        flex: 1;
      }
      
      .activity-title {
        color: #e5e7eb;
        font-weight: 600;
        margin-bottom: 0.25rem;
      }
      
      .activity-time {
        color: #9aa0b4;
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
      }
      
      .activity-details {
        color: #9aa0b4;
        font-size: 0.9rem;
        font-style: italic;
      }
      
      .text-success { color: #10b981 !important; }
      .text-warning { color: #f59e0b !important; }
      .text-info { color: #3b82f6 !important; }
      .text-primary { color: #667eea !important; }
      .text-secondary { color: #9aa0b4 !important; }
      .text-muted { color: #6b7280 !important; }
      
      /* Role Management Styles */
      .role-management h6 {
        color: #e5e7eb;
        margin-bottom: 0.75rem;
        font-weight: 600;
      }
      
      .current-roles {
        margin-bottom: 1rem;
      }
      
      .role-checkboxes {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      
      .role-checkbox {
        display: flex;
        align-items: center;
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 8px;
        transition: background-color 0.2s;
      }
      
      .role-checkbox:hover {
        background: #2a2d45;
      }
      
      .role-checkbox input[type="checkbox"] {
        margin-right: 0.75rem;
        transform: scale(1.2);
      }
      
      .role-checkbox span {
        color: #e5e7eb;
        font-weight: 500;
      }
      
      .role-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: flex-end;
      }
      
      /* Admin Actions Container */
      .admin-actions-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: stretch;
      }
      
      .admin-actions-container .btn {
        flex: 1;
        min-width: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        white-space: nowrap;
      }
      
      .admin-actions-container .btn i {
        flex-shrink: 0;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-default navbar-fixed-top admin-navbar">
      <div class="container-fluid">
        <div class="navbar-header">
          <a class="navbar-brand" href="/admin/console">
            <img src="/static/images/dispatch-logo-512.png" style="width:32px; height:32px; margin-right:10px; border-radius:8px;" />
            LPC Admin Console
          </a>
        </div>
        <div class="navbar-collapse collapse">
          <ul class="nav navbar-nav navbar-right">
            <li>
              <span style="color: #9aa0b4;">
                <i class="fas fa-user" style="margin-right: 8px;"></i>
                <%= admin && admin.email ? admin.email : 'Admin' %>
              </span>
            </li>
            <li>
              <button type="button" class="btn btn-link" onclick="adminLogout()">
                <i class="fas fa-sign-out-alt" style="margin-right: 8px;"></i>Logout
              </button>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container admin-container">
      <div class="search-card">
        <h2 style="margin-bottom: 1.5rem; color: #fff; font-weight: 700;">
          <i class="fas fa-search" style="margin-right: 12px; color: #667eea;"></i>
          Admin Search & Management
        </h2>
        
        <div class="admin-actions" style="margin-bottom: 1.5rem; text-align: right; display: none;" id="add-admin-section">
          <button class="btn btn-gradient" onclick="showAddAdminModal()">
            <i class="fas fa-plus" style="margin-right: 8px;"></i>Add Admin
          </button>
        </div>
        
        <div class="search-tabs">
          <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" class="active">
              <a href="#users-tab" data-toggle="tab">
                <i class="fas fa-users" style="margin-right: 8px;"></i>Users
              </a>
            </li>
            <li role="presentation">
              <a href="#communities-tab" data-toggle="tab">
                <i class="fas fa-building" style="margin-right: 8px;"></i>Communities
              </a>
            </li>
            <li role="presentation" id="admin-management-tab" style="display: none;">
              <a href="#admin-management-tab-content" data-toggle="tab">
                <i class="fas fa-shield-alt" style="margin-right: 8px;"></i>Admin Management
              </a>
            </li>
          </ul>
          
          <div class="tab-content">
            <!-- Users Tab -->
            <div role="tabpanel" class="tab-pane active" id="users-tab">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="userSearch" class="form-control search-input" 
                         placeholder="Search users by email or username..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchUsersBtn" class="btn btn-gradient btn-block">
                    <i class="fas fa-search" style="margin-right: 8px;"></i>Search Users
                  </button>
                </div>
              </div>
              <div id="userResults"></div>
            </div>
            
            <!-- Communities Tab -->
            <div role="tabpanel" class="tab-pane" id="communities-tab">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="communitySearch" class="form-control search-input" 
                         placeholder="Search communities by name..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchCommunitiesBtn" class="btn btn-gradient btn-block">
                    <i class="fas fa-search" style="margin-right: 8px;"></i>Search Communities
                  </button>
                </div>
              </div>
              <div id="communityResults"></div>
            </div>
            
            <!-- Admin Management Tab -->
            <div role="tabpanel" class="tab-pane" id="admin-management-tab-content">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="adminSearch" class="form-control search-input" 
                         placeholder="Search admins by email..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchAdminsBtn" class="btn btn-gradient btn-block">
                    <i class="fas fa-search" style="margin-right: 8px;"></i>Search Admins
                  </button>
                </div>
              </div>
              <div id="adminResults">
                <div class="loading" style="text-align: center; padding: 2rem; color: #9aa0b4;">
                  <i class="fas fa-spinner fa-spin"></i> Loading all admins...
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- User Details Modal -->
    <div class="modal fade" id="userModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="userModalTitle">User Details</h4>
          </div>
          <div class="modal-body" id="userModalBody">
            <!-- User details will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Community Details Modal -->
    <div class="modal fade" id="communityModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="communityModalTitle">Community Details</h4>
          </div>
          <div class="modal-body" id="communityModalBody">
            <!-- Community details will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="confirmModalTitle">Confirm Action</h4>
          </div>
          <div class="modal-body" id="confirmModalBody">
            <!-- Confirmation message will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-gradient" id="confirmModalBtn">Confirm</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Success/Info Modal -->
    <div class="modal fade" id="infoModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="infoModalTitle">Information</h4>
          </div>
          <div class="modal-body" id="infoModalBody">
            <!-- Info message will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-gradient" data-dismiss="modal">OK</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Add Admin Modal -->
    <div class="modal fade" id="addAdminModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title">Add New Admin</h4>
          </div>
          <div class="modal-body">
            <div class="form-group">
              <label for="newAdminEmail" style="color: #e5e7eb; margin-bottom: 0.5rem;">Email Address</label>
              <input type="email" id="newAdminEmail" class="form-control" 
                     placeholder="Enter email address" 
                     style="background: #11131a; border: 1px solid #2a2d45; color: #e5e7eb;">
            </div>
            <div class="form-group">
              <label for="adminRole" style="color: #e5e7eb; margin-bottom: 0.5rem;">Admin Role</label>
              <select id="adminRole" class="form-control" 
                      style="background: #11131a; border: 1px solid #2a2d45; color: #e5e7eb;">
                <option value="admin">Admin</option>
                <option value="owner">Owner</option>
              </select>
            </div>
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-gradient" onclick="addNewAdmin()">
              <i class="fas fa-plus" style="margin-right: 8px;"></i>Add Admin
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Reset Link Modal -->
    <div class="modal fade" id="adminResetLinkModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title">Admin Account Created</h4>
          </div>
          <div class="modal-body" id="adminResetLinkBody">
            <!-- Reset link and options will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Details Modal -->
    <div class="modal fade" id="adminDetailsModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="adminDetailsModalTitle">Admin Details</h4>
          </div>
          <div class="modal-body" id="adminDetailsModalBody">
            <!-- Admin details will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Role Management Modal -->
    <div class="modal fade" id="roleManagementModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="roleManagementModalTitle">Manage Admin Roles</h4>
          </div>
          <div class="modal-body" id="roleManagementModalBody">
            <!-- Role management interface will be loaded here -->
          </div>
        </div>
      </div>
    </div>

    <script src="/static/js/jquery.min.js"></script>
    <script src="/static/js/bootstrap.min.js"></script>
    <script>
      // Global API configuration - using Go backend API
      const API_BASE = '<%= POLICE_CAD_API_URL %>';
      
      // Show success/error messages on page load
      $(document).ready(function() {
        var successMessage = '<%= success || "" %>';
        var errorMessage = '<%= error || "" %>';
        
        if (successMessage) {
          showToast('success', successMessage);
        }
        if (errorMessage) {
          showToast('error', errorMessage);
        }
      });
      
      // Global variables for current user info
      let currentUserEmail = '';
      let roles = [];
      
      // Function to update UI based on current user roles
      function updateUIForUserRoles() {
        // Safety check - if no user data, hide everything
        if (!currentUserEmail || !roles || roles.length === 0) {
          $('#admin-management-tab').hide();
          $('#add-admin-section').hide();
          $('#adminResults').html('');
          $('#userResults').html('');
          return;
        }
        
        if (roles.includes('owner')) {
          $('#admin-management-tab').show();
          $('#add-admin-section').show();
        } else {
          $('#admin-management-tab').hide();
          $('#add-admin-section').hide();
          $('#admin-management-tab-content').hide();
          
          // Clear any admin data that might be displayed
          $('#adminResults').html('');
          $('#userResults').html('');
        }
      }
      
      // Function to clear user data (call this on logout)
      function clearUserData() {
        currentUserEmail = '';
        roles = [];
        updateUIForUserRoles();
      }
      
      // Activity tracking functions
      async function adminLogout() {
        try {
          // Track logout activity first
          await logAdminAction('logout', 'Admin logged out', 'Admin user logged out of the system');
          
          // Then proceed with actual logout
          window.location.href = '/admin/logout';
        } catch (error) {
          // Still logout even if tracking fails
          window.location.href = '/admin/logout';
        }
      }
      
      async function logAdminAction(type, title, details) {
        try {
          const response = await fetch(`${API_BASE}/api/v1/admin/activity/log`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              adminId: '<%= admin && admin.id ? admin.id : "" %>',
              type: type,
              title: title,
              details: details,
              timestamp: new Date().toISOString(),
              currentUser: {
                email: currentUserEmail,
                roles: roles
              }
            })
          });
          
          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }
        } catch (error) {
          // Silently handle logging errors to avoid console noise
        }
      }
      
      // Check current user role and show admin management tab if owner
      $(document).ready(function() {
        // Check if current user is owner (you can modify this logic based on your backend)
        currentUserEmail = '<%= admin && admin.email ? admin.email : "" %>';
        const currentUserRoles = '<%= admin && admin.roles ? JSON.stringify(admin.roles) : (admin && admin.role ? JSON.stringify([admin.role]) : "[]") %>';
        
        // Parse roles array - handle HTML entity encoding
        try {
          // First decode HTML entities, then parse JSON
          const decodedRoles = currentUserRoles
            .replace(/&#34;/g, '"')  // Replace &#34; with "
            .replace(/&quot;/g, '"') // Replace &quot; with "
            .replace(/&amp;/g, '&')  // Replace &amp; with &
            .replace(/&lt;/g, '<')   // Replace &lt; with <
            .replace(/&gt;/g, '>');  // Replace &gt; with >
          
          roles = JSON.parse(decodedRoles);
        } catch (e) {
          // Fallback to single role if available
          const fallbackRole = '<%= admin && admin.role ? admin.role : "" %>';
          if (fallbackRole) {
            roles = [fallbackRole];
          }
        }
        
        // Update UI based on user roles
        updateUIForUserRoles();
        
        // Load all admins when admin management tab is shown (using Bootstrap's shown.bs.tab event)
        $('a[href="#admin-management-tab-content"]').on('shown.bs.tab', function() {
          // Clear any existing results from other tabs
          clearTabResults('admin');
          
          // Then load the admins
          loadAllAdmins();
        });
        
        // Clear results when switching tabs
        $('a[href="#users-tab"]').on('click', function() {
          clearTabResults('users');
        });
        
        $('a[href="#communities-tab"]').on('click', function() {
          clearTabResults('communities');
        });
        
        // Function to clear results from other tabs
        function clearTabResults(activeTab) {
          if (activeTab !== 'users') {
            $('#userResults').html('');
          }
          if (activeTab !== 'communities') {
            $('#communityResults').html('');
          }
          if (activeTab !== 'admin') {
            $('#adminResults').html('');
          }
        }
        
        // Event delegation for admin action buttons
        $(document).on('click', '.admin-action-btn', function() {
          const action = $(this).data('action');
          const adminId = $(this).data('admin-id');
          const email = $(this).data('email');
          const roles = $(this).data('roles');
          
          switch(action) {
            case 'view-details':
              viewAdminDetails(adminId);
              break;
            case 'change-role':
              changeAdminRole(adminId, roles);
              break;
            case 'send-reset':
              sendAdminReset(email);
              break;
            case 'delete-admin':
              deleteAdmin(adminId, email);
              break;
            case 'view-activity':
              viewAdminActivity(adminId, email);
              break;
          }
        });
        
        // Event delegation for timeline filter buttons
        $(document).on('click', '.timeline-filters .btn', function() {
          const clickedButton = $(this);
          const timeframe = clickedButton.data('timeframe');
          
          // Remove active class from all buttons
          $('.timeline-filters .btn').removeClass('active');
          
          // Add active class to clicked button
          clickedButton.addClass('active');
          
          filterActivity(timeframe);
        });
        
        // Auto-search on page load if there's a query
        const userQuery = $('#userSearch').val().trim();
        if (userQuery) {
          currentUserPage = 0;
          searchUsers(userQuery, 0);
        }
        
        // Auto-search communities on page load if there's a query
        const communityQuery = $('#communitySearch').val().trim();
        if (communityQuery) {
          currentCommunityPage = 0;
          searchCommunities(communityQuery, 0);
        }
      });
      
      // Admin Management Functions
      function loadAllAdmins() {
        // Check if user has permission to view admins
        if (!roles.includes('owner')) {
          $('#adminResults').html('<div class="loading">Access denied. Owner privileges required.</div>');
          return;
        }
        
        $('#adminResults').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading all admins...</div>');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/admins`,
          method: 'POST',
          data: JSON.stringify({
            currentUser: {
              email: currentUserEmail,
              roles: roles
            }
          }),
          contentType: 'application/json',
          success: function(data) {
            displayAdminResults(data.admins || []);
          },
          error: function(xhr) {
            $('#adminResults').html('<div class="loading">Failed to load admins</div>');
            showInfoModal('Error', `Error loading admins: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }
      
      // Search Admins
      $('#searchAdminsBtn').click(function() {
        const query = $('#adminSearch').val().trim();
        if (!query) {
          // If no search term, load all admins
          loadAllAdmins();
          return;
        }
        searchAdmins(query);
      });
      
      $('#adminSearch').keypress(function(e) {
        if (e.which === 13) {
          $('#searchAdminsBtn').click();
        }
      });
      
      function searchAdmins(query) {
        $('#adminResults').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Searching admins...</div>');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/search/admins`,
          method: 'POST',
          data: JSON.stringify({ 
            query: query,
            currentUser: {
              email: currentUserEmail,
              roles: roles
            }
          }),
          contentType: 'application/json',
          success: function(data) {
            displayAdminResults(data.admins || []);
          },
          error: function(xhr) {
            $('#adminResults').html('<div class="loading">No admins found</div>');
            showInfoModal('Search Error', `Error searching admins: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }
      
      function displayAdminResults(admins) {
        if (admins.length === 0) {
          $('#adminResults').html('<div class="loading">No admins found</div>');
          return;
        }
        
        let html = '';
        admins.forEach(admin => {
          const adminId = admin.id || admin._id || 'unknown';
          const adminRoles = Array.isArray(admin.roles) ? admin.roles : (admin.role ? [admin.role] : ['admin']);
          const adminEmail = admin.email || 'Unknown';
          const adminCreatedAt = admin.createdAt ? new Date(admin.createdAt).toLocaleDateString() : 'Unknown';
          
          // Display roles as comma-separated list
          const rolesDisplay = adminRoles.join(', ');
          
          html += `
            <div class="result-card">
              <div class="result-header">
                <div>
                  <h5 class="result-title">${adminEmail}</h5>
                  <p class="result-subtitle">Roles: ${rolesDisplay} | Created: ${adminCreatedAt}</p>
                </div>
                <div class="action-buttons">
                  <button class="btn btn-secondary btn-sm admin-action-btn" data-action="view-details" data-admin-id="${adminId}">
                    <i class="fas fa-eye"></i> View Details
                  </button>
                  <button class="btn btn-secondary btn-sm admin-action-btn" data-action="change-role" data-admin-id="${adminId}" data-roles='${JSON.stringify(adminRoles)}'>
                    <i class="fas fa-user-edit"></i> Change Roles
                  </button>
                  <button class="btn btn-secondary btn-sm admin-action-btn" data-action="send-reset" data-email="${adminEmail}">
                    <i class="fas fa-envelope"></i> Send Reset
                  </button>
                  <button class="btn btn-danger btn-sm admin-action-btn" data-action="delete-admin" data-admin-id="${adminId}" data-email="${adminEmail}">
                    <i class="fas fa-trash"></i> Delete
                  </button>
                </div>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <div class="info-label">Status</div>
                  <div class="info-value">
                    <span class="status-badge ${admin.active ? 'status-active' : 'status-inactive'}">
                      ${admin.active ? 'Active' : 'Inactive'}
                    </span>
                  </div>
                </div>
                <div class="info-item">
                  <div class="info-label">Created By</div>
                  <div class="info-value">${admin.createdBy || 'System'}</div>
                </div>
                <div class="info-item">
                  <div class="info-label">Last Login</div>
                  <div class="info-value">${admin.lastLoginAt ? new Date(admin.lastLoginAt).toLocaleDateString() : 'Never'}</div>
                </div>
              </div>
            </div>
          `;
        });
        $('#adminResults').html(html);
      }
      
      function viewAdminDetails(adminId) {
        $('#adminDetailsModalTitle').text('Loading Admin Details...');
        $('#adminDetailsModalBody').html('<div class="loading">Loading...</div>');
        $('#adminDetailsModal').modal('show');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/admins/${adminId}`,
          method: 'GET',

          success: function(data) {
            if (data.admin) {
              displayAdminDetails(data.admin);
            } else {
              $('#adminDetailsModalBody').html('<div class="loading">Invalid admin data received</div>');
            }
          },
          error: function(xhr) {
            $('#adminDetailsModalBody').html('<div class="loading">Failed to load admin details</div>');
            showInfoModal('Error', `Error loading admin: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }
      
      function displayAdminDetails(admin) {
        // Add null checks and defaults
        const email = admin.email || 'Unknown';
        const roles = Array.isArray(admin.roles) ? admin.roles : (admin.role ? [admin.role] : ['admin']);
        const isActive = admin.active !== undefined ? admin.active : true;
        const createdAt = admin.createdAt ? new Date(admin.createdAt).toLocaleDateString() : 'Unknown';
        const createdBy = admin.createdBy || 'System';
        const lastLoginAt = admin.lastLoginAt ? new Date(admin.lastLoginAt).toLocaleDateString() : 'Never';
        const adminId = admin.id || admin._id || 'unknown';
        
        // Check if user has owner role
        const hasOwnerRole = roles.includes('owner');
        const hasAdminRole = roles.includes('admin');
        
        $('#adminDetailsModalTitle').text(`Admin: ${email}`);
        $('#adminDetailsModalBody').html(`
          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Email</div>
              <div class="info-value">${email}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Roles</div>
              <div class="info-value">
                ${roles.map(role => `
                  <span class="status-badge ${role === 'owner' ? 'status-active' : 'status-pending'}" style="margin-right: 0.5rem;">
                    ${role.charAt(0).toUpperCase() + role.slice(1)}
                  </span>
                `).join('')}
              </div>
            </div>
            <div class="info-item">
              <div class="info-label">Status</div>
              <div class="info-value">
                <span class="status-badge ${isActive ? 'status-active' : 'status-inactive'}">
                  ${isActive ? 'Active' : 'Inactive'}
                </span>
              </div>
            </div>
            <div class="info-item">
              <div class="info-label">Created</div>
              <div class="info-value">${createdAt}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Created By</div>
              <div class="info-value">${createdBy}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Last Login</div>
              <div class="info-value">${lastLoginAt}</div>
            </div>
          </div>
          
          <div style="margin-top: 2rem;">
            <h5>Actions</h5>
            <div class="admin-actions-container">
              <button class="btn btn-secondary admin-action-btn" data-action="change-role" data-admin-id="${adminId}" data-roles='${JSON.stringify(roles)}'>
                <i class="fas fa-user-edit"></i> Change Roles
              </button>
              <button class="btn btn-secondary admin-action-btn" data-action="send-reset" data-email="${email}">
                <i class="fas fa-envelope"></i> Send Password Reset
              </button>
              <button class="btn btn-secondary admin-action-btn" data-action="view-activity" data-admin-id="${adminId}" data-email="${email}">
                <i class="fas fa-chart-line"></i> View Activity
              </button>
              <button class="btn btn-danger admin-action-btn" data-action="delete-admin" data-admin-id="${adminId}" data-email="${email}">
                <i class="fas fa-trash"></i> Delete Admin
              </button>
            </div>
          </div>
        `);
      }
      
      function viewAdminActivity(adminId, adminEmail) {
        // Check if user has permission to view admin activity
        if (!roles.includes('owner')) {
          showInfoModal('Error', 'Access denied. Owner privileges required to view admin activity.');
          return;
        }
        
        // Set the modal data for the current admin
        $('#adminDetailsModal').data('currentAdminId', adminId);
        
        $('#adminDetailsModalTitle').text(`Admin Activity: ${adminEmail}`);
        
        // Show the modal first
        $('#adminDetailsModal').modal('show');
        
        // Generate the initial HTML structure first
        displayAdminActivity({});
        
        // Then load initial activity with default timeframe (7 days)
        viewAdminActivityWithTimeframe(adminId, '7d', currentActivityPage, activityPageSize);
      }
      
      function displayAdminActivity(activity) {
        // Always create the HTML structure, even for empty data
        // This ensures the component IDs exist for future updates
        
        // Get current active timeframe to preserve button state
        const currentActiveTimeframe = $('.timeline-filters .btn.active').data('timeframe') || '7d';
        
        const html = `
          <div class="activity-overview" id="activityMetrics">
            <div class="row">
              <div class="col-md-3">
                <div class="stat-card">
                  <div class="stat-number">0</div>
                  <div class="stat-label">Total Logins</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="stat-card">
                  <div class="stat-number">0</div>
                  <div class="stat-label">Password Resets</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="stat-card">
                  <div class="stat-number">0</div>
                  <div class="stat-label">Password Resets Initiated</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="stat-card">
                  <div class="stat-number">0m</div>
                  <div class="stat-label">Avg Session</div>
                </div>
              </div>
            </div>
          </div>
          
          <div style="margin-top: 2rem;">
            <h5>Activity Timeline</h5>
            <div class="timeline-filters">
              <button class="btn btn-sm btn-secondary ${currentActiveTimeframe === '1d' ? 'active' : ''}" data-timeframe="1d">1 Day</button>
              <button class="btn btn-sm btn-secondary ${currentActiveTimeframe === '7d' ? 'active' : ''}" data-timeframe="7d">7 Days</button>
              <button class="btn btn-sm btn-secondary ${currentActiveTimeframe === '30d' ? 'active' : ''}" data-timeframe="30d">30 Days</button>
              <button class="btn btn-sm btn-secondary ${currentActiveTimeframe === '1m' ? 'active' : ''}" data-timeframe="1m">1 Month</button>
              <button class="btn btn-sm btn-secondary ${currentActiveTimeframe === '3m' ? 'active' : ''}" data-timeframe="3m">3 Months</button>
              <button class="btn btn-sm btn-secondary ${currentActiveTimeframe === '6m' ? 'active' : ''}" data-timeframe="6m">6 Months</button>
              <button class="btn btn-sm btn-secondary ${currentActiveTimeframe === '1y' ? 'active' : ''}" data-timeframe="1y">1 Year</button>
              <button class="btn btn-sm btn-secondary ${currentActiveTimeframe === 'all' ? 'active' : ''}" data-timeframe="all">All Time</button>
            </div>
            
            <div class="activity-chart" id="activityChart">
              <div class="text-center" style="padding: 2rem; color: #9aa0b4;">
                <i class="fas fa-chart-line" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                <p>Loading chart data...</p>
              </div>
            </div>
            
            <div class="recent-activity">
              <h6>Recent Activity</h6>
              <div id="activityList">
                <div class="text-center" style="padding: 1rem; color: #9aa0b4;">
                  <i class="fas fa-spinner fa-spin" style="font-size: 1.5rem; margin-bottom: 0.5rem;"></i>
                  <p>Loading activity data...</p>
                </div>
              </div>
              

            </div>
            
            <div style="margin-top: 1rem; text-align: center;">
              <button class="btn btn-primary btn-sm" onclick="refreshActivityData()">
                <i class="fas fa-sync-alt"></i> Refresh Activity
              </button>
            </div>
          </div>
        `;
        
        $('#adminDetailsModalBody').html(html);
        
        // Note: Click handlers are set up using event delegation in the document ready function
        // Data will be loaded via updateActivityComponents() after this
      }
      
      // Global variables for activity pagination (updated for backend pagination)
      let currentActivityPage = 1;
      let activityPageSize = 5;
      let totalActivityPages = 1;
      let totalActivityRecords = 0;
      let allActivities = [];
      
      // Global variables for search pagination
      let currentUserPage = 0;
      let currentCommunityPage = 0;
      let resultsPerPage = 5;
      let allUsers = [];
      let allCommunities = [];
      
      // User pagination variables
      let totalUserPages = 1;
      let totalUserRecords = 0;
      
      // Community pagination variables
      let totalCommunityPages = 1;
      let totalCommunityRecords = 0;
      
      // Departments pagination variables
      let currentDepartmentsPage = 0;
      let currentCommunityId = null;
      let currentCommunityDepartments = [];
      
      function generateRecentActivityList(activities, startIndex = 0, count = 5) {
        if (!activities || activities.length === 0) {
          return '<p style="color: #9aa0b4; text-align: center; padding: 1rem;">No recent activity recorded</p>';
        }
        
        // Sort activities by timestamp (newest first)
        const sortedActivities = [...activities].sort((a, b) => {
          const dateA = new Date(a.timestamp);
          const dateB = new Date(b.timestamp);
          return dateB - dateA; // Newest first
        });
        
        // Store sorted activities globally for pagination
        allActivities = sortedActivities;
        
        // Calculate pagination
        const endIndex = Math.min(startIndex + count, sortedActivities.length);
        const pageActivities = sortedActivities.slice(startIndex, endIndex);
        
        let html = '';
        pageActivities.forEach(activity => {
          const icon = getActivityIcon(activity.type);
          const timeAgo = getTimeAgo(activity.timestamp);
          
          html += `
            <div class="activity-item">
              <div class="activity-icon">${icon}</div>
              <div class="activity-content">
                <div class="activity-title">${activity.title}</div>
                <div class="activity-time">${timeAgo}</div>
                ${activity.details ? `<div class="activity-details">${activity.details}</div>` : ''}
              </div>
            </div>
          `;
        });
        
        return html;
      }
      
      function changeActivityPage(direction) {
        const newPage = currentActivityPage + direction;
        
        // Clamp to valid range
        if (newPage < 1 || newPage > totalActivityPages) {
          return;
        }
        
        currentActivityPage = newPage;
        
        // Get current admin ID and timeframe
        const adminId = $('#adminDetailsModal').data('currentAdminId');
        const currentTimeframe = $('.timeline-filters .btn.active').data('timeframe') || '7d';
        
        if (adminId) {
          // Reload activity data for the new page
          viewAdminActivityWithTimeframe(adminId, currentTimeframe, currentActivityPage, activityPageSize);
        }
      }
      
      // Old pagination function removed - replaced with updateActivityPaginationControls
      
      function getActivityIcon(type) {
        const icons = {
          'login': '<i class="fas fa-sign-in-alt text-success"></i>',
          'logout': '<i class="fas fa-sign-out-alt text-warning"></i>',
          'password_reset': '<i class="fas fa-key text-info"></i>',
          'password_reset_initiated': '<i class="fas fa-envelope text-info"></i>',
          'role_change': '<i class="fas fa-user-edit text-primary"></i>',
          'admin_action': '<i class="fas fa-cog" style="color: #667eea;"></i>',
          'user_reset_initiated': '<i class="fas fa-envelope text-info"></i>',
          'user_search': '<i class="fas fa-search" style="color: #8b5cf6;"></i>',
          'community_search': '<i class="fas fa-search" style="color: #8b5cf6;"></i>',
          'user_reactivate': '<i class="fas fa-user-check text-success"></i>',
          'admin_creation': '<i class="fas fa-user-plus text-primary"></i>',
          'admin_deletion': '<i class="fas fa-user-minus text-danger"></i>',
          'admin_reset_existing': '<i class="fas fa-envelope text-info"></i>',
          'admin_reset_email': '<i class="fas fa-envelope text-info"></i>'
        };
        return icons[type] || '<i class="fas fa-circle text-muted"></i>';
      }
      
      function getTimeAgo(timestamp) {
        const now = new Date();
        const time = new Date(timestamp);
        const diffMs = now - time;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMs / 3600000);
        const diffDays = Math.floor(diffMs / 86400000);
        
        if (diffMins < 1) return 'Just now';
        if (diffMins < 60) return `${diffMins}m ago`;
        if (diffHours < 24) return `${diffHours}h ago`;
        if (diffDays < 7) return `${diffDays}d ago`;
        return time.toLocaleDateString();
      }
      
      function renderActivityChart(activity) {
        // Simple chart using HTML/CSS for now
        // You can integrate Chart.js or D3.js for better charts later
        const chartData = activity.chartData || [];
        
        if (!chartData || chartData.length === 0) {
          $('#activityChart').html(`
            <div class="text-center" style="padding: 2rem; color: #9aa0b4;">
              <i class="fas fa-chart-line" style="font-size: 2rem; margin-bottom: 1rem;"></i>
              <p>No chart data available</p>
            </div>
          `);
          return;
        }
        
        // Check if all values are 0 (no activity)
        const hasAnyActivity = chartData.some(day => day.value > 0);
        
        if (!hasAnyActivity) {
          $('#activityChart').html(`
            <div class="text-center" style="padding: 2rem; color: #9aa0b4;">
              <i class="fas fa-chart-line" style="font-size: 2rem; margin-bottom: 1rem;"></i>
              <p>No activity recorded for this timeframe</p>
            </div>
          `);
          return;
        }
        
        const chartHtml = `
          <div class="chart-container">
            <div class="chart-bars">
              ${chartData.map(day => `
                ${day.value > 0 ? `
                  <div class="chart-bar" style="height: ${day.value * 2}px;" title="${day.date}: ${day.value} activities">
                    <div class="bar-label">${day.date}</div>
                  </div>
                ` : `
                  <div class="chart-bar chart-bar-empty" title="${day.date}: ${day.value} activities">
                    <div class="bar-label">${day.date}</div>
                  </div>
                `}
              `).join('')}
            </div>
