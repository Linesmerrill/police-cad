      $('#searchCommunitiesBtn').click(function() {
        const query = $('#communitySearch').val().trim();
        if (!query) {
          showInfoModal('Search Required', 'Please enter a search term to find communities.');
          return;
        }
        // Reset pagination for new search
        currentCommunityPage = 0;
        searchCommunities(query, 0);
      });
      
      $('#communitySearch').keypress(function(e) {
        if (e.which === 13) {
          $('#searchCommunitiesBtn').click();
        }
      });
      
      function searchCommunities(query, page = 0) {
        $('#communityResults').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Searching communities...</div>');
        
        // Track search activity
        trackAdminAction('community_search', `Searched for communities with query: "${query}"`);
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/search/communities`,
          method: 'POST',
          data: JSON.stringify({ 
            query: query,
            page: page,
            limit: resultsPerPage
          }),
          contentType: 'application/json',
          success: function(data) {
            if (data.communities && data.pagination) {
              // Store pagination info
              currentCommunityPage = data.pagination.currentPage || 0;
              totalCommunityPages = data.pagination.totalPages || 1;
              totalCommunityRecords = data.pagination.totalRecords || 0;
              
              displayCommunityResultsPage(data.communities, currentCommunityPage, totalCommunityRecords, totalCommunityPages);
            } else {
              // Fallback for old backend response
              displayCommunityResults(data.communities || []);
            }
          },
          error: function(xhr) {
            $('#communityResults').html('<div class="loading">No communities found</div>');
            showInfoModal('Search Error', `Error searching communities: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
        
        // Add to recent searches
        addToRecentSearches(query, 'communities');
      }
      
      function displayCommunityResults(communities) {
        // Fallback function for old backend responses
        if (communities.length === 0) {
          $('#communityResults').html('<div class="loading">No communities found</div>');
          return;
        }
        
        // Store all communities globally for pagination
        allCommunities = communities;
        currentCommunityPage = 0;
        
        // Display first page
        displayCommunityResultsPage(communities, 0, communities.length, Math.ceil(communities.length / resultsPerPage));
      }
      
      function displayCommunityResultsPage(communities, currentPage, totalRecords, totalPages) {
        if (!communities || communities.length === 0) {
          $('#communityResults').html('<div class="loading">No communities found</div>');
          return;
        }
        
        let html = '';
