          $('#userResults').html('<div class="loading">No users found</div>');
          return;
        }
        
        // Store all users globally for pagination
        allUsers = users;
        currentUserPage = 0;
        
        // Display first page
        displayUserResultsPage(users, 0, users.length, Math.ceil(users.length / resultsPerPage));
      }
      
