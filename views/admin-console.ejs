                  <div class="info-value reset-status-${user.id}">
                    <span style="color: #9aa0b4;"><i class="fas fa-spinner fa-spin"></i> Loading...</span>
                  </div>
                </div>
              </div>
            </div>
          `;
        });
        
        // After rendering, fetch reset password status for each user
        // Fetch in parallel but stagger slightly to avoid overwhelming the API
        users.forEach((user, index) => {
          setTimeout(() => {
            $.ajax({
              url: `${API_BASE}/api/v1/admin/users/${user.id}`,
              method: 'GET',
              success: function(data) {
                if (data.user) {
                  const resetPasswordExpires = data.user.user?.resetPasswordExpires || data.user.resetPasswordExpires;
                  const resetStatus = formatPasswordResetStatus(resetPasswordExpires);
                  $(`.reset-status-${user.id}`).html(resetStatus.html);
                } else {
                  $(`.reset-status-${user.id}`).html('<span style="color: #9aa0b4;">Never requested</span>');
                }
              },
              error: function(xhr) {
                // Silently fail and show "Never requested"
                $(`.reset-status-${user.id}`).html('<span style="color: #9aa0b4;">Never requested</span>');
              }
            });
          }, index * 50); // Stagger requests by 50ms to avoid overwhelming the API
        });
        
        // Add pagination controls
        html += generatePaginationControls('user', totalRecords, currentPage);
        
        $('#userResults').html(html);
      }
      
