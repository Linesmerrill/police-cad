    <script src="/static/js/jquery.min.js"></script>
    <script src="/static/js/bootstrap.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
      if (typeof io === 'undefined') {
        var _s = document.createElement('script');
        _s.src = 'https://cdn.socket.io/4.7.2/socket.io.min.js';
        document.head.appendChild(_s);
      }
    </script>
    <script>
      // Global API configuration - using Go backend API
      const API_BASE = '<%= POLICE_CAD_API_URL %>';

      // Utility: escape a string for safe insertion into HTML
      function escapeHtml(str) {
        if (typeof str !== 'string') return '';
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      // =====================================================
      // SIDEBAR NAVIGATION
      // =====================================================
      const panelTitleMap = {
        'dashboard': 'Dashboard',
        'users': 'Users',
        'pending-users': 'Pending Users',
        'communities': 'Communities',
        'cases': 'Cases',
        'content-creators': 'Content Creators',
        'admin-management': 'Admin Management',
        'email': 'Email',
        'metrics': 'Metrics',
        'wiki': 'Wiki',
        'subscriptions': 'Subscriptions'
      };

      // Data-load callbacks for lazy-loaded panels
      const panelLoadCallbacks = {
        'dashboard': function() { if (typeof loadDashboardStats === 'function') loadDashboardStats(); if (typeof loadDashboardPendingCC === 'function') loadDashboardPendingCC(); },
        'admin-management': function() { if (typeof loadAllAdmins === 'function') loadAllAdmins(); },
        'content-creators': function() { if (typeof loadCCApplications === 'function') { loadCCApplications(); loadCCStats(); } },
        'metrics': function() { loadMetricsPanel(); },
        'subscriptions': function() { initSubscriptionsPanel(); },
        'cases': function() {
          var hash = window.location.hash.replace('#', '');
          // Handle cases/N deep link
          if (hash.indexOf('cases/') === 0) {
            var caseId = hash.split('/')[1];
            if (caseId) { viewCase(caseId); return; }
          }
          // Handle cases?status=X filter
          var statusMatch = hash.match(/[?&]status=([^&]+)/);
          var status = statusMatch ? statusMatch[1] : '';
          loadCases(status);
        },
        'wiki': function() { initAdminWiki(); }
      };

      // Track which panels have been loaded
      const panelLoaded = {};

      function acNavTo(panel) {
        // Hide all panels, show the target
        document.querySelectorAll('.ac-panel').forEach(function(p) { p.classList.remove('active'); });
        var target = document.getElementById('panel-' + panel);
        if (target) target.classList.add('active');

        // Update sidebar active state
        document.querySelectorAll('.ac-nav-item').forEach(function(n) { n.classList.remove('active'); });
        var navItem = document.querySelector('.ac-nav-item[data-panel="' + panel + '"]');
        if (navItem) navItem.classList.add('active');

        // Update topbar title
        var titleEl = document.getElementById('ac-topbar-title');
        if (titleEl && panelTitleMap[panel]) titleEl.textContent = panelTitleMap[panel];

        // Update topbar actions
        var addAdminSection = document.getElementById('add-admin-section');
        if (addAdminSection) addAdminSection.style.display = (panel === 'admin-management') ? '' : 'none';

        // Update URL hash
        window.location.hash = panel;

        // Lazy-load data for panels that need it
        if (!panelLoaded[panel] && Object.prototype.hasOwnProperty.call(panelLoadCallbacks, panel)) {
          panelLoadCallbacks[panel]();
          panelLoaded[panel] = true;
        }

        // Close sidebar on mobile
        var sidebar = document.querySelector('.ac-sidebar');
        if (sidebar && window.innerWidth < 1024) {
          sidebar.classList.remove('open');
          var toggleBtn = document.getElementById('ac-sidebar-open');
          if (toggleBtn) toggleBtn.style.display = '';
        }
      }

      // Sidebar nav click handler
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.ac-nav-item').forEach(function(item) {
          item.addEventListener('click', function() {
            var panel = this.getAttribute('data-panel');
            if (panel) acNavTo(panel);
          });
        });
      });

      // Show success/error messages on page load
      $(document).ready(function() {
        var successMessage = '<%= success || "" %>';
        var errorMessage = '<%= error || "" %>';

        if (successMessage) {
          showToast('success', successMessage);
        }
        if (errorMessage) {
          showToast('error', errorMessage);
        }
      });

      // Global variables for current user info
      let currentUserEmail = '';
      let roles = [];
      
      // Function to update UI based on current user roles
      function updateUIForUserRoles() {
        // Safety check - if no user data, hide everything
        if (!currentUserEmail || !roles || roles.length === 0) {
          $('#admin-management-tab').hide();
          $('#content-creators-tab').hide();
          $('#add-admin-section').hide();
          $('#adminResults').html('');
          $('#userResults').html('');
          return;
        }

        // Show content creators tab for admin and owner roles
        if (roles.includes('owner') || roles.includes('admin')) {
          $('#content-creators-tab').show();
          $('#dash-qa-cc').show();
        } else {
          $('#content-creators-tab').hide();
          $('#dash-qa-cc').hide();
        }

        if (roles.includes('owner')) {
          $('#admin-management-tab').show();
          $('#add-admin-section').show();
          $('#email-tab').show();
        } else {
          $('#admin-management-tab').hide();
          $('#add-admin-section').hide();
          $('#panel-admin-management').hide();
          $('#email-tab').hide();
          $('#panel-email').hide();

          // Clear any admin data that might be displayed
          $('#adminResults').html('');
          $('#userResults').html('');
        }
      }
      
      // Dashboard stats loader
      var lastKnownSubmittedCount = null;
      var ccPollInterval = null;

      function loadDashboardStats() {
        // Admins count (lightweight count endpoint)
        $.ajax({
          url: API_BASE + '/api/v1/admin/admins/count',
          method: 'GET',
          success: function(data) {
            $('#dash-stat-admins').text(data && data.count != null ? data.count : '—');
          },
          error: function() { $('#dash-stat-admins').text('—'); }
        });

        // CC submitted count
        $.ajax({
          url: API_BASE + '/api/v1/admin/content-creator-applications?status=submitted&limit=1',
          method: 'GET',
          success: function(data) {
            var count = (data && data.pagination) ? data.pagination.totalItems : 0;
            $('#dash-stat-submitted').text(count);
            // Seed the initial count so polling doesn't fire a false toast
            if (lastKnownSubmittedCount === null) lastKnownSubmittedCount = count;
          },
          error: function() { $('#dash-stat-submitted').text('0'); }
        });

        // CC under review count
        $.ajax({
          url: API_BASE + '/api/v1/admin/content-creator-applications?status=under_review&limit=1',
          method: 'GET',
          success: function(data) {
            var count = (data && data.pagination) ? data.pagination.totalItems : 0;
            $('#dash-stat-review').text(count);
          },
          error: function() { $('#dash-stat-review').text('0'); }
        });

        // Active creators count
        $.ajax({
          url: API_BASE + '/api/v1/admin/content-creators?status=active&limit=1',
          method: 'GET',
          success: function(data) {
            var count = (data && data.pagination) ? data.pagination.totalItems : 0;
            $('#dash-stat-active-cc').text(count);
          },
          error: function() { $('#dash-stat-active-cc').text('0'); }
        });
      }

      // =====================================================
      // DASHBOARD — PENDING CC APPLICATIONS
      // =====================================================
      function loadDashboardPendingCC() {
        // Only show for admin/owner roles
        if (!roles.includes('owner') && !roles.includes('admin')) return;

        $('#dash-pending-cc-label').show();
        $('#dash-pending-cc-container').show();

        $.ajax({
          url: API_BASE + '/api/v1/admin/content-creator-applications?status=submitted&limit=5',
          method: 'GET',
          success: function(data) {
            var apps = (data && data.applications) ? data.applications : [];
            var total = (data && data.pagination) ? data.pagination.totalItems : 0;
            renderDashboardPendingCC(apps, total);
          },
          error: function() {
            renderDashboardPendingCC([], 0);
          }
        });
      }

      function renderDashboardPendingCC(apps, total) {
        var list = $('#dash-pending-cc-list');
        var countBadge = $('#dash-pending-cc-count');

        if (!apps || apps.length === 0) {
          countBadge.hide();
          list.html(`
            <div class="dash-cc-all-clear">
              <div class="dash-cc-all-clear-icon">
                <i class="fas fa-check"></i>
              </div>
              <strong>All caught up!</strong>
              <span>No pending applications to review</span>
            </div>
          `);
          return;
        }

        countBadge.text(total).show();

        var platformIcons = {
          twitch: { icon: 'fab fa-twitch', bg: 'rgba(145,70,255,0.12)', color: '#9146FF' },
          youtube: { icon: 'fab fa-youtube', bg: 'rgba(255,0,0,0.1)', color: '#FF0000' },
          tiktok: { icon: 'fab fa-tiktok', bg: 'rgba(255,255,255,0.08)', color: '#fff' },
          other: { icon: 'fas fa-globe', bg: 'rgba(99,102,241,0.12)', color: 'var(--ac-accent)' }
        };

        var html = '';
        apps.forEach(function(app) {
          var appId = app._id || app.id || '';
          var displayName = escapeHtml(app.displayName || 'Unknown');
          var platform = app.primaryPlatform || 'other';
          var pIcon = platformIcons[platform] || platformIcons.other;
          var totalFollowers = 0;
          if (app.platforms && app.platforms.length) {
            app.platforms.forEach(function(p) { totalFollowers += (p.followerCount || 0); });
          }
          var createdAt = app.createdAt ? new Date(app.createdAt).toLocaleDateString() : '';

          html += `
            <div class="dash-pending-cc-item">
              <div class="dash-pending-cc-item-info">
                <div class="dash-pending-cc-platform-icon" style="background:${pIcon.bg}; color:${pIcon.color};">
                  <i class="${pIcon.icon}"></i>
                </div>
                <div class="dash-pending-cc-item-text">
                  <strong>${displayName}</strong>
                  <span>${escapeHtml(platform)} &middot; ${totalFollowers.toLocaleString()} followers &middot; ${escapeHtml(createdAt)}</span>
                </div>
              </div>
              <div class="dash-pending-cc-item-actions">
                <button class="btn btn-secondary btn-sm" onclick="acNavTo('content-creators'); setTimeout(function(){ viewCCApplication('${escapeHtml(appId)}'); }, 300);" style="font-size:0.75rem; padding:0.3rem 0.75rem;">
                  Review
                </button>
              </div>
            </div>
          `;
        });

        if (total > 5) {
          html += `
            <div style="text-align:center; padding-top:0.75rem;">
              <a href="#" onclick="acNavTo('content-creators'); return false;" style="font-size:0.75rem; color:var(--ac-accent); text-decoration:none; font-weight:500;">
                View all ${total} applications <i class="fas fa-arrow-right" style="margin-left:4px; font-size:0.625rem;"></i>
              </a>
            </div>
          `;
        }

        list.html(html);
      }

      // =====================================================
      // LIVE CC APPLICATION NOTIFICATIONS (polling)
      // =====================================================
      function pollCCSubmissions() {
        $.ajax({
          url: API_BASE + '/api/v1/admin/content-creator-applications?status=submitted&limit=1',
          method: 'GET',
          success: function(data) {
            var count = (data && data.pagination) ? data.pagination.totalItems : 0;

            if (lastKnownSubmittedCount !== null && count > lastKnownSubmittedCount) {
              var diff = count - lastKnownSubmittedCount;
              var msg = diff === 1
                ? 'New content creator application submitted!'
                : diff + ' new content creator applications submitted!';
              showLiveToast(msg);

              // Update the dashboard stat card
              $('#dash-stat-submitted').text(count);

              // Also refresh the sidebar badge
              if (typeof loadCCPendingCount === 'function') loadCCPendingCount();
            }

            lastKnownSubmittedCount = count;
          }
        });
      }

      function showLiveToast(message) {
        var id = 'live-toast-' + Date.now();
        var html = '<div id="' + id + '" class="ac-live-toast">' +
          '<div class="ac-live-toast-icon"><i class="fas fa-video"></i></div>' +
          '<div class="ac-live-toast-body">' +
            '<strong>Content Creator</strong>' +
            '<span>' + message + '</span>' +
          '</div>' +
          '<button onclick="$(\'#' + id + '\').fadeOut(function(){$(this).remove()})"><i class="fas fa-times"></i></button>' +
        '</div>';

        $('body').append(html);
        var el = $('#' + id);
        // Trigger animation after append
        setTimeout(function() { el.addClass('show'); }, 10);
        // Auto-dismiss after 8 seconds
        setTimeout(function() { el.removeClass('show'); setTimeout(function() { el.remove(); }, 400); }, 8000);
      }

      function startCCPolling() {
        if (ccPollInterval) return;
        ccPollInterval = setInterval(pollCCSubmissions, 30000); // every 30s
      }

      function stopCCPolling() {
        if (ccPollInterval) { clearInterval(ccPollInterval); ccPollInterval = null; }
      }

      // Function to clear user data (call this on logout)
      function clearUserData() {
        currentUserEmail = '';
        roles = [];
        updateUIForUserRoles();
      }
      
      // Activity tracking functions
      async function adminLogout() {
        try {
          // Track logout activity first
          await logAdminAction('logout', 'Admin logged out', 'Admin user logged out of the system');
          
          // Then proceed with actual logout
          window.location.href = '/admin/logout';
        } catch (error) {
          // Still logout even if tracking fails
          window.location.href = '/admin/logout';
        }
      }
      
      async function logAdminAction(type, title, details) {
        try {
          const response = await fetch(`${API_BASE}/api/v1/admin/activity/log`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              adminId: '<%= admin && admin.id ? admin.id : "" %>',
              type: type,
              title: title,
              details: details,
              timestamp: new Date().toISOString(),
              currentUser: {
                email: currentUserEmail,
                roles: roles
              }
            })
          });
          
          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }
        } catch (error) {
          // Silently handle logging errors to avoid console noise
        }
      }
      
      // Check current user role and show admin management tab if owner
      $(document).ready(function() {
        // Check if current user is owner (you can modify this logic based on your backend)
        currentUserEmail = '<%= admin && admin.email ? admin.email : "" %>';
        currentUserName = '<%= admin && admin.firstName ? admin.firstName + (admin.lastName ? " " + admin.lastName : "") : "Admin" %>';
        currentUserRole = roles.length > 0 ? roles[0] : 'admin';
        const currentUserRoles = '<%= admin && admin.roles ? JSON.stringify(admin.roles) : (admin && admin.role ? JSON.stringify([admin.role]) : "[]") %>';
        
        // Parse roles array - handle HTML entity encoding
        try {
          // First decode HTML entities, then parse JSON
          const decodedRoles = currentUserRoles
            .replace(/&#34;/g, '"')  // Replace &#34; with "
            .replace(/&quot;/g, '"') // Replace &quot; with "
            .replace(/&amp;/g, '&')  // Replace &amp; with &
            .replace(/&lt;/g, '<')   // Replace &lt; with <
            .replace(/&gt;/g, '>');  // Replace &gt; with >
          
          roles = JSON.parse(decodedRoles);
        } catch (e) {
          // Fallback to single role if available
          const fallbackRole = '<%= admin && admin.role ? admin.role : "" %>';
          if (fallbackRole) {
            roles = [fallbackRole];
          }
        }
        
        // Update UI based on user roles
        updateUIForUserRoles();

        // Send heartbeat to track last active time
        const heartbeatAdminId = '<%= admin && admin.id ? admin.id : "" %>';
        if (heartbeatAdminId) {
          fetch(`${API_BASE}/api/v1/admin/heartbeat`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ adminId: heartbeatAdminId })
          }).catch(() => {});
        }

        // Load pending content creator applications count for badge
        if (roles.includes('owner') || roles.includes('admin')) {
          loadCCPendingCount();
        }

        // Load dashboard stats on page load (dashboard is default panel)
        loadDashboardStats();
        loadDashboardPendingCC();
        panelLoaded['dashboard'] = true;

        // Start polling for live CC submission notifications
        if (roles.includes('owner') || roles.includes('admin')) {
          startCCPolling();
        }

        // Tab switching is now handled by acNavTo() via sidebar click handlers

        // Email tab - Send Email handler
        $('#sendEmailBtn').on('click', function() {
          var toEmail = $.trim($('#emailTo').val());
          var subject = $.trim($('#emailSubject').val());
          var body = $.trim($('#emailBody').val());

          if (!toEmail) {
            showInfoModal('Validation Error', 'Please enter a recipient email address.');
            return;
          }
          if (!subject) {
            showInfoModal('Validation Error', 'Please enter a subject line.');
            return;
          }
          if (!body) {
            showInfoModal('Validation Error', 'Please enter the email body.');
            return;
          }

          var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(toEmail)) {
            showInfoModal('Validation Error', 'Please enter a valid email address.');
            return;
          }

          showConfirmModal(
            'Confirm Send Email',
            'Are you sure you want to send this email to <strong>' + escapeHtml(toEmail) + '</strong>?',
            function() {
              $('#sendEmailBtn').prop('disabled', true).html(
                '<i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i>Sending...'
              );

              $.ajax({
                url: API_BASE + '/api/v1/admin/send-email',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                  toEmail: toEmail,
                  subject: subject,
                  body: body,
                  currentUser: {
                    email: currentUserEmail,
                    roles: roles
                  }
                }),
                success: function(data) {
                  $('#emailTo').val('');
                  $('#emailSubject').val('');
                  $('#emailBody').val('');
                  showInfoModal('Success', 'Email sent successfully to ' + $('<span>').text(toEmail).html() + '!');
                },
                error: function(xhr) {
                  var errorMsg = xhr.responseJSON && xhr.responseJSON.error
                    ? xhr.responseJSON.error
                    : 'Failed to send email. Please try again.';
                  showInfoModal('Error', errorMsg);
                },
                complete: function() {
                  $('#sendEmailBtn').prop('disabled', false).html(
                    '<i class="fas fa-paper-plane" style="margin-right: 8px;"></i>Send Email'
                  );
                }
              });
            }
          );
        });

        // Function to clear results from other tabs
        function clearTabResults(activeTab) {
          if (activeTab !== 'users') {
            $('#userResults').html('');
          }
          if (activeTab !== 'communities') {
            $('#communityResults').html('');
          }
          if (activeTab !== 'admin') {
            $('#adminResults').html('');
          }
        }
        
        // Event delegation for admin action buttons
        $(document).on('click', '.admin-action-btn', function() {
          const action = $(this).data('action');
          const adminId = $(this).data('admin-id');
          const email = $(this).data('email');
          const roles = $(this).data('roles');
          
          switch(action) {
            case 'view-details':
              viewAdminDetails(adminId);
              break;
            case 'change-role':
              changeAdminRole(adminId, roles);
              break;
            case 'send-reset':
              sendAdminReset(email);
              break;
            case 'delete-admin':
              deleteAdmin(adminId, email);
              break;
            case 'view-activity':
              viewAdminActivity(adminId, email);
              break;
          }
        });
        
        // Event delegation for timeline filter buttons
        $(document).on('click', '.timeline-filters .btn', function() {
          const clickedButton = $(this);
          const timeframe = clickedButton.data('timeframe');
          
          // Remove active class from all buttons
          $('.timeline-filters .btn').removeClass('active');
          
          // Add active class to clicked button
          clickedButton.addClass('active');
          
          filterActivity(timeframe);
        });
        
        // Auto-search on page load if there's a query
        const userQuery = $('#userSearch').val().trim();
        if (userQuery) {
          currentUserPage = 0;
          searchUsers(userQuery, 0);
        }
        
        // Auto-search communities on page load if there's a query
        const communityQuery = $('#communitySearch').val().trim();
        if (communityQuery) {
          currentCommunityPage = 0;
          searchCommunities(communityQuery, 0);
        }
        
        // Handle URL hash for panel selection
        const hash = window.location.hash;
        if (hash) {
          const panelId = hash.substring(1);
          // Map old tab hashes to new panel names for backwards compat
          const hashMap = {
            'users-tab': 'users',
            'pending-users-tab': 'pending-users',
            'communities-tab': 'communities',
            'content-creators-tab-content': 'content-creators',
            'admin-management-tab-content': 'admin-management',
            'email-tab-content': 'email',
            'beta-metrics': 'metrics'
          };
          var panel = hashMap[panelId] || panelId;
          // Handle deep link formats: cases/N and wiki/section-id
          if (panel.indexOf('cases/') === 0 || panel.indexOf('wiki/') === 0) {
            panel = panel.split('/')[0];
          }
          if (document.getElementById('panel-' + panel)) {
            acNavTo(panel);

            // If it's the communities panel, trigger a search if there's a query
            if (panel === 'communities') {
              const communityQuery = $('#communitySearch').val().trim();
              if (communityQuery) {
                currentCommunityPage = 0;
                searchCommunities(communityQuery, 0);
              }
            }
          }
        }
        
        // Initialize recent searches UI
        updateRecentSearchesUI();
      });
      
      // Admin Management Functions
      function loadAllAdmins() {
        // Check if user has permission to view admins
        if (!roles.includes('owner')) {
          $('#adminResults').html('<div class="loading">Access denied. Owner privileges required.</div>');
          return;
        }
        
        $('#adminResults').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading all admins...</div>');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/admins`,
          method: 'POST',
          data: JSON.stringify({
            currentUser: {
              email: currentUserEmail,
              roles: roles
            }
          }),
          contentType: 'application/json',
          success: function(data) {
            displayAdminResults(data.admins || []);
          },
          error: function(xhr) {
            $('#adminResults').html('<div class="loading">Failed to load admins</div>');
            showInfoModal('Error', `Error loading admins: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }
      
      // Search Admins
      $('#searchAdminsBtn').click(function() {
        const query = $('#adminSearch').val().trim();
        if (!query) {
          // If no search term, load all admins
          loadAllAdmins();
          return;
        }
        searchAdmins(query);
      });
      
      $('#adminSearch').keypress(function(e) {
        if (e.which === 13) {
          $('#searchAdminsBtn').click();
        }
      });
      
      function searchAdmins(query) {
        $('#adminResults').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Searching admins...</div>');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/search/admins`,
          method: 'POST',
          data: JSON.stringify({ 
            query: query,
            currentUser: {
              email: currentUserEmail,
              roles: roles
            }
          }),
          contentType: 'application/json',
          success: function(data) {
            displayAdminResults(data.admins || []);
          },
          error: function(xhr) {
            $('#adminResults').html('<div class="loading">No admins found</div>');
            showInfoModal('Search Error', `Error searching admins: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }
      
