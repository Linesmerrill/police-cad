          <style>
            /* ── Admin Wiki Layout ── */
            .aw-layout { display:flex; gap:2.5rem; align-items:flex-start; }
            .aw-sidebar {
              position:sticky; top:2rem; width:210px; flex-shrink:0;
              align-self:flex-start; max-height:calc(100vh - 4rem);
              overflow-y:auto; padding-right:0.35rem;
            }
            .aw-sidebar::-webkit-scrollbar { width:3px; }
            .aw-sidebar::-webkit-scrollbar-track { background:transparent; }
            .aw-sidebar::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.08); border-radius:3px; }
            .aw-content { flex:1; min-width:0; }

            /* ── Search ── */
            .aw-nav-search { position:relative; margin-bottom:0.75rem; }
            .aw-nav-search input {
              width:100%; padding:0.45rem 0.65rem 0.45rem 2rem;
              background:var(--ac-glass); border:1px solid var(--ac-glass-border);
              border-radius:var(--ac-radius-sm); color:var(--ac-text);
              font-size:0.78rem; font-family:inherit; outline:none;
              transition:border-color 0.2s, background 0.2s;
            }
            .aw-nav-search input::placeholder { color:var(--ac-text-dim); }
            .aw-nav-search input:focus { border-color:rgba(139,92,246,0.35); background:var(--ac-glass-hover); }

            /* ── Sidebar Nav ── */
            .aw-nav-group-title {
              display:flex; align-items:center; gap:0.4rem;
              font-size:0.68rem; font-weight:700; text-transform:uppercase;
              letter-spacing:0.08em; color:var(--ac-text-dim);
              padding:0.5rem 0.75rem; margin-top:1rem;
            }
            .aw-nav-group-title:first-child { margin-top:0; }
            .aw-nav-link {
              display:block; padding:0.4rem 0.75rem 0.4rem 1.5rem;
              font-size:0.8rem; color:var(--ac-text-muted); text-decoration:none;
              border-radius:var(--ac-radius-sm); border-left:2px solid transparent;
              transition:all 0.2s ease; cursor:pointer;
            }
            .aw-nav-link:hover { color:#fff; background:var(--ac-surface); }
            .aw-nav-link.active { color:var(--ac-accent); border-left-color:var(--ac-accent); background:var(--ac-accent-glow); }

            /* ── Section ── */
            .aw-section { margin-bottom:3rem; }
            .aw-section-header {
              display:flex; align-items:center; gap:0.875rem;
              margin-bottom:1.5rem; padding-bottom:1rem;
              border-bottom:1px solid var(--ac-glass-border);
            }
            .aw-section-icon {
              width:38px; height:38px; border-radius:10px;
              background:var(--ac-glass); border:1px solid var(--ac-glass-border);
              display:flex; align-items:center; justify-content:center;
              color:var(--ac-accent); font-size:0.95rem;
            }
            .aw-section-title { font-size:1.1rem; font-weight:700; color:#fff; }

            /* ── Subsection ── */
            .aw-subsection { margin-bottom:2rem; scroll-margin-top:2rem; }
            .aw-subsection-title { font-size:0.95rem; font-weight:600; color:#fff; margin-bottom:0.6rem; }
            .aw-text { font-size:0.84rem; color:var(--ac-text-muted); line-height:1.65; margin-bottom:0.75rem; }

            /* ── Steps ── */
            .aw-steps { display:flex; flex-direction:column; gap:0.6rem; margin:0.75rem 0 1rem; }
            .aw-step {
              display:flex; gap:0.875rem; padding:0.75rem 1rem;
              background:var(--ac-surface); border:1px solid var(--ac-glass-border);
              border-radius:var(--ac-radius-sm);
            }
            .aw-step-number {
              width:26px; height:26px; border-radius:50%;
              background:var(--ac-accent-glow); border:1px solid rgba(139,92,246,0.2);
              display:flex; align-items:center; justify-content:center;
              color:var(--ac-accent); font-weight:700; font-size:0.75rem; flex-shrink:0;
            }

            /* ── Tip Box ── */
            .aw-tip {
              display:flex; gap:0.75rem; padding:0.875rem 1rem;
              background:rgba(59,130,246,0.06); border:1px solid rgba(59,130,246,0.15);
              border-left:3px solid var(--ac-blue); border-radius:var(--ac-radius-sm);
              margin:0.75rem 0 1rem;
            }
            .aw-tip-icon { color:var(--ac-blue); font-size:0.85rem; flex-shrink:0; margin-top:0.1rem; }
            .aw-tip-text { font-size:0.8rem; color:var(--ac-text); line-height:1.55; }

            /* ── Sample Box ── */
            .aw-sample-box {
              background:var(--ac-surface); border:1px solid var(--ac-glass-border);
              border-radius:var(--ac-radius); margin:1rem 0 1.5rem; overflow:hidden;
            }
            .aw-sample-label {
              display:flex; align-items:center; gap:0.4rem;
              padding:0.55rem 1rem; font-size:0.7rem; font-weight:700;
              text-transform:uppercase; letter-spacing:0.06em;
              color:var(--ac-text-dim); background:rgba(255,255,255,0.02);
              border-bottom:1px solid var(--ac-glass-border);
            }
            .aw-sample-content { padding:1.25rem; pointer-events:none; opacity:0.85; user-select:none; }

            /* ── Sample form elements ── */
            .aw-form-group { margin-bottom:0.875rem; }
            .aw-form-label {
              display:block; font-size:0.75rem; font-weight:600;
              color:var(--ac-text-muted); margin-bottom:0.3rem;
              text-transform:uppercase; letter-spacing:0.04em;
            }
            .aw-form-input {
              width:100%; padding:0.5rem 0.75rem; font-size:0.82rem;
              font-family:inherit; color:var(--ac-text);
              background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1);
              border-radius:6px; outline:none;
            }
            .aw-btn {
              display:inline-flex; align-items:center; gap:0.35rem;
              padding:0.5rem 1rem; font-size:0.8rem; font-weight:600;
              font-family:inherit; border:none; border-radius:6px; cursor:default;
            }
            .aw-btn-accent { background:var(--ac-accent); color:#fff; }
            .aw-btn-green { background:var(--ac-green); color:#fff; }
            .aw-btn-red { background:var(--ac-red); color:#fff; }
            .aw-btn-outline { background:transparent; border:1px solid var(--ac-glass-border); color:var(--ac-text); }
            .aw-btn-amber { background:rgba(234,179,8,0.15); border:1px solid rgba(234,179,8,0.3); color:#eab308; }
            .aw-badge {
              display:inline-flex; align-items:center; padding:0.15rem 0.5rem;
              font-size:0.65rem; font-weight:700; text-transform:uppercase;
              letter-spacing:0.04em; border-radius:4px;
            }
            .aw-badge-active { background:rgba(34,197,94,0.15); color:var(--ac-green); }
            .aw-badge-deactivated { background:rgba(239,68,68,0.15); color:var(--ac-red); }
            .aw-badge-open { background:rgba(59,130,246,0.15); color:var(--ac-blue); }
            .aw-badge-completed { background:rgba(148,163,184,0.15); color:#94a3b8; }
            .aw-badge-cancelled { background:rgba(239,68,68,0.15); color:var(--ac-red); }

            /* ── Detail rows ── */
            .aw-detail-row {
              display:flex; justify-content:space-between; align-items:center;
              padding:0.45rem 0; border-bottom:1px solid rgba(255,255,255,0.04); font-size:0.8rem;
            }
            .aw-detail-label { color:var(--ac-text-muted); }
            .aw-detail-value { color:var(--ac-text); font-weight:600; }

            /* ── Stepper sample ── */
            .aw-stepper { display:flex; gap:0.25rem; margin-bottom:1rem; }
            .aw-stepper-step {
              flex:1; text-align:center; padding:0.5rem 0.25rem;
              font-size:0.7rem; font-weight:600; border-radius:4px;
              background:var(--ac-glass); border:1px solid var(--ac-glass-border);
              color:var(--ac-text-dim);
            }
            .aw-stepper-step.active { background:var(--ac-accent-glow); border-color:rgba(139,92,246,0.3); color:var(--ac-accent); }
            .aw-stepper-step.done { background:rgba(34,197,94,0.1); border-color:rgba(34,197,94,0.2); color:var(--ac-green); }

            /* ── Checkbox mock ── */
            .aw-checkbox {
              display:inline-flex; align-items:center; gap:0.4rem;
              font-size:0.8rem; color:var(--ac-text-muted);
            }
            .aw-checkbox-box {
              width:14px; height:14px; border:1px solid rgba(255,255,255,0.15);
              border-radius:3px; background:rgba(255,255,255,0.05);
            }

            /* ── Responsive ── */
            @media (max-width:768px) {
              .aw-layout { flex-direction:column; gap:0; }
              .aw-sidebar {
                position:static; width:100%; max-height:none;
                padding-bottom:1rem; border-bottom:1px solid var(--ac-glass-border);
                margin-bottom:1rem;
              }
            }
          </style>

