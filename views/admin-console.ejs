                  <button type="button" class="bfb-status-tab" data-status="resolved" style="padding:0.3125rem 0.6875rem;border-radius:999px;border:1px solid var(--ac-glass-border);background:transparent;color:var(--ac-text-muted);font:600 0.6875rem/1 inherit;cursor:pointer;letter-spacing:0.04em;">Resolved <span class="bfb-status-count" data-status-count="resolved" style="opacity:0.75;">0</span></button>
                  <button type="button" class="bfb-status-tab" data-status="all" style="padding:0.3125rem 0.6875rem;border-radius:999px;border:1px solid var(--ac-glass-border);background:transparent;color:var(--ac-text-muted);font:600 0.6875rem/1 inherit;cursor:pointer;letter-spacing:0.04em;">All</button>
