      function addNewAdmin() {
        // Check if user has permission to create admins
        if (!roles.includes('owner')) {
          showInfoModal('Error', 'Access denied. Owner privileges required to create admin users.');
          return;
        }
        
        const email = $('#newAdminEmail').val().trim();
        const role = $('#adminRole').val();
        
        if (!email) {
          showInfoModal('Error', 'Please enter an email address');
          return;
        }
        
        if (!email.includes('@')) {
          showInfoModal('Error', 'Please enter a valid email address');
          return;
        }
        
        // Show loading state
        const addButton = $('#addAdminModal .btn-gradient');
        const originalText = addButton.html();
        addButton.html('<i class="fas fa-spinner fa-spin"></i> Adding...');
        addButton.prop('disabled', true);
        

        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/users`,
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          data: JSON.stringify({ 
            email: email, 
            role: role,
            // Send current user's credentials for permission check
            currentUser: {
              email: currentUserEmail,
              roles: roles
            }
          }),
          contentType: 'application/json',
          success: function(data) {
            $('#addAdminModal').modal('hide');
            showAdminResetLink(data.resetLink, email, role);
            
            // Log the admin creation action
            logAdminAction('admin_creation', 'Admin user created', `Created new admin user: ${email} with role: ${role}`);
          },
          error: function(xhr) {
            // Show error message in the current modal instead of opening a new one
            let errorMessage = 'Unknown error';
            let errorCode = '';
            let isDuplicateUser = false;
            
            // Try to get the error message and code from the response
            if (xhr.responseJSON) {
              errorMessage = xhr.responseJSON.error || 'Unknown error';
              errorCode = xhr.responseJSON.code || '';
              isDuplicateUser = errorCode === 'DUPLICATE_USER';
            } else if (xhr.responseText) {
              // Fallback to response text if JSON parsing failed
              try {
                const response = JSON.parse(xhr.responseText);
                if (response.error) {
                  errorMessage = response.error;
                  errorCode = response.code || '';
                  isDuplicateUser = errorCode === 'DUPLICATE_USER';
                }
              } catch (e) {
                // If we can't parse JSON, use the raw response text
                errorMessage = xhr.responseText || 'Unknown error';
              }
            }
            
            let errorHtml = `
              <div class="alert alert-danger" style="background: #ef4444; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i>
                ${errorMessage}
              </div>
            `;
            
            // If it's a duplicate user, add a button to send them a new reset password
            if (isDuplicateUser) {
              const email = $('#newAdminEmail').val().trim();
              errorHtml += `
                <div class="alert alert-info" style="background: #3b82f6; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                  <i class="fas fa-info-circle" style="margin-right: 8px;"></i>
                  This admin already exists. You can send them a new password reset link.
                  <div style="margin-top: 1rem;">
                    <button class="btn btn-secondary" onclick="sendExistingAdminReset('${email}')">
                      <i class="fas fa-envelope" style="margin-right: 8px;"></i>Send New Reset Password
                    </button>
                  </div>
                </div>
              `;
            }
            
            // Insert error message at the top of the modal body
            $('#addAdminModal .modal-body').prepend(errorHtml);
          },
          complete: function() {
            // Restore button state
            addButton.html(originalText);
            addButton.prop('disabled', false);
          }
        });
      }
      
      function showAdminResetLink(resetLink, email, role) {
        $('#adminResetLinkBody').html(`
          <div class="alert alert-success" style="background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
            <i class="fas fa-check-circle" style="margin-right: 8px;"></i>
            Admin account created successfully for <strong>${email}</strong> with role <strong>${role}</strong>
          </div>
          
          <div class="form-group">
            <label style="color: #e5e7eb; margin-bottom: 0.5rem;">Set Password Link</label>
            <div class="input-group">
              <input type="text" class="form-control" value="${resetLink}" readonly 
                     style="background: #11131a; border: 1px solid #2a2d45; color: #e5e7eb;">
              <div class="input-group-btn">
                <button class="btn btn-gradient" onclick="copyToClipboard('${resetLink}', event)">
                  <i class="fas fa-copy"></i> Copy
                </button>
              </div>
            </div>
          </div>
          
          <div class="form-group">
            <label style="color: #e5e7eb; margin-bottom: 0.5rem;">Send Set Password Email</label>
            <button class="btn btn-secondary btn-block" onclick="sendAdminResetEmail('${email}')">
              <i class="fas fa-envelope" style="margin-right: 8px;"></i>Send Set Password Email to ${email}
            </button>
          </div>
          
          <div class="alert alert-info" style="background: #3b82f6; color: #fff; border: none; border-radius: 8px; padding: 1rem;">
            <i class="fas fa-info-circle" style="margin-right: 8px;"></i>
            The new admin can use this link to create their password and then login to the admin console.
          </div>
        `);
        
        $('#adminResetLinkModal').modal('show');
      }
      
      function sendAdminResetEmail(email) {
        const button = $(`button[onclick*="sendAdminResetEmail('${email}')"]`);
        const originalText = button.html();
        button.html('<i class="fas fa-spinner fa-spin"></i> Sending...');
        button.prop('disabled', true);
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/send-reset-email`,
          method: 'POST',

          data: JSON.stringify({ email: email }),
          contentType: 'application/json',
          success: function(data) {
            // Show success message in the current modal instead of opening a new one
            const successHtml = `
              <div class="alert alert-success" style="background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-check-circle" style="margin-right: 8px;"></i>
                Password reset email sent successfully to ${email}
              </div>
            `;
            
            // Insert success message at the top of the modal body
            $('#adminResetLinkBody').prepend(successHtml);
            
            // Disable the send email button since it was sent
            button.prop('disabled', true);
            button.html('<i class="fas fa-check"></i> Email Sent');
            button.removeClass('btn-secondary').addClass('btn-success');
            
            // Track this action
            trackAdminAction('admin_reset_email', `Sent password reset email to admin: ${email}`);
          },
          error: function(xhr) {
            // Show error message in the current modal
            const errorHtml = `
              <div class="alert alert-danger" style="background: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i>
                Failed to send email: ${xhr.responseJSON?.error || 'Unknown error'}
            </div>
            `;
            
            // Insert error message at the top of the modal body
            $('#adminResetLinkBody').prepend(errorHtml);
          },
          complete: function() {
            // Only restore button if there was an error
            if (button.hasClass('btn-success')) {
              return; // Button was successfully sent, don't change it
            }
            button.html(originalText);
            button.prop('disabled', false);
          }
        });
      }
      
      function sendExistingAdminReset(email) {
        // Show loading state
        const button = $(`button[onclick*="sendExistingAdminReset('${email}')"]`);
        const originalText = button.html();
        button.html('<i class="fas fa-spinner fa-spin"></i> Sending...');
        button.prop('disabled', true);

        $.ajax({
          url: `${API_BASE}/api/v1/admin/send-reset-email`,
          method: 'POST',

          data: JSON.stringify({ email: email }),
          contentType: 'application/json',
          success: function(data) {
            // Replace the error and info alerts with success message
            $('#addAdminModal .alert').remove();

            const successHtml = `
              <div class="alert alert-success" style="background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-check-circle" style="margin-right: 8px;"></i>
                New password reset email sent successfully to ${email}
              </div>
            `;

            $('#addAdminModal .modal-body').prepend(successHtml);

            // Disable the send button and change its text
            button.prop('disabled', true);
            button.html('<i class="fas fa-check"></i> Email Sent');
            button.removeClass('btn-secondary').addClass('btn-success');

            // Clear the email input since we successfully sent the reset
            $('#newAdminEmail').val('');
            
            // Track this action
            trackAdminAction('admin_reset_existing', `Sent reset email to existing admin: ${email}`);
          },
          error: function(xhr) {
            // Show error message
            let errorMessage = 'Unknown error';
            if (xhr.responseJSON && xhr.responseJSON.error) {
              errorMessage = xhr.responseJSON.error;
            }
            
            const errorHtml = `
              <div class="alert alert-danger" style="background: #ef4444; color: #fff; border: none; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i>
                Failed to send reset email: ${errorMessage}
              </div>
            `;
            
            $('#addAdminModal .modal-body').prepend(errorHtml);
          },
          complete: function() {
            // Only restore button if there was an error
            if (button.hasClass('btn-success')) {
              return; // Button was successfully sent, don't change it
            }
            button.html(originalText);
            button.prop('disabled', false);
          }
        });
      }

      // =====================================================
      // CONTENT CREATOR MANAGEMENT FUNCTIONS
      // =====================================================

      let currentCCPage = 1;
      let currentCCStatus = '';
      let ccPageSize = 10;

      // Load content creator applications when tab is shown
      $('a[href="#content-creators-tab-content"]').on('shown.bs.tab', function() {
        loadCCApplications();
        loadCCStats();
      });

      // Status filter buttons
      $(document).on('click', '.cc-status-btn', function() {
        $('.cc-status-btn').removeClass('active');
        $(this).addClass('active');
        currentCCStatus = $(this).data('status');
        currentCCPage = 1;
        loadCCApplications();
      });

      // Search button click
      $('#searchCCBtn').click(function() {
        currentCCPage = 1;
        loadCCApplications();
      });

      // Search on enter key
      $('#ccSearch').keypress(function(e) {
        if (e.which === 13) {
          $('#searchCCBtn').click();
        }
      });

      function loadCCStats() {
        // Load pending count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=submitted&limit=1`,
          method: 'GET',
          success: function(data) {
            $('#ccStatPending').text(data.pagination?.totalItems || 0);
          }
        });

        // Load approved count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=approved&limit=1`,
          method: 'GET',
          success: function(data) {
            $('#ccStatApproved').text(data.pagination?.totalItems || 0);
          }
        });

        // Load rejected count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=rejected&limit=1`,
          method: 'GET',
          success: function(data) {
            $('#ccStatRejected').text(data.pagination?.totalItems || 0);
          }
        });

        // Load active creators count
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creators?status=active&limit=1`,
          method: 'GET',
          success: function(data) {
            $('#ccStatActive').text(data.pagination?.totalItems || 0);
          }
        });
      }

      function loadCCPendingCount() {
        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications?status=submitted&limit=1`,
          method: 'GET',
          success: function(data) {
            const count = data.pagination?.totalItems || 0;
            if (count > 0) {
              $('#ccPendingBadge').text(count).show();
            } else {
              $('#ccPendingBadge').hide();
            }
          },
          error: function() {
            $('#ccPendingBadge').hide();
          }
        });
      }

      function loadCCApplications() {
        const searchQuery = $('#ccSearch').val().trim();
        let url = `${API_BASE}/api/v1/admin/content-creator-applications?page=${currentCCPage}&limit=${ccPageSize}`;

        if (currentCCStatus) {
          url += `&status=${currentCCStatus}`;
        }

        $('#ccApplicationResults').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading applications...</div>');

        $.ajax({
          url: url,
          method: 'GET',
          success: function(data) {
            displayCCApplications(data.applications || [], data.pagination);
          },
          error: function(xhr) {
            $('#ccApplicationResults').html('<div class="loading">Failed to load applications</div>');
            showInfoModal('Error', `Error loading applications: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }

      function displayCCApplications(applications, pagination) {
        if (applications.length === 0) {
          $('#ccApplicationResults').html(`
            <div class="no-users-found">
              <div class="no-users-message">
                <i class="fas fa-inbox" style="font-size: 3rem; color: #667eea; margin-bottom: 1rem;"></i>
                <h4 style="color: #e5e7eb;">No Applications Found</h4>
                <p style="color: #9aa0b4;">There are no applications matching your criteria.</p>
              </div>
            </div>
          `);
          $('#ccPagination').hide();
          return;
        }

        let html = '';
        applications.forEach(app => {
          const appId = app._id || app.id;
          const displayName = app.displayName || 'Unknown';
          const status = app.status || 'unknown';
          const createdAt = app.createdAt ? new Date(app.createdAt).toLocaleDateString() : 'Unknown';
          const primaryPlatform = app.primaryPlatform || 'Unknown';

          // Calculate total followers
          let totalFollowers = 0;
          if (app.platforms && Array.isArray(app.platforms)) {
            totalFollowers = app.platforms.reduce((sum, p) => sum + (p.followerCount || 0), 0);
          }

          // Status badge styling
          const statusColors = {
            'submitted': { bg: '#3b82f6', label: 'Submitted' },
            'under_review': { bg: '#f59e0b', label: 'Under Review' },
            'approved': { bg: '#10b981', label: 'Approved' },
            'rejected': { bg: '#ef4444', label: 'Rejected' },
            'withdrawn': { bg: '#6b7280', label: 'Withdrawn' }
          };
          const statusStyle = statusColors[status] || { bg: '#6b7280', label: status };

          html += `
            <div class="result-card">
              <div class="result-header">
                <div>
                  <h5 class="result-title">${displayName}</h5>
                  <p class="result-subtitle">Applied: ${createdAt} | Platform: ${primaryPlatform} | Followers: ${totalFollowers.toLocaleString()}</p>
                </div>
                <div class="action-buttons">
                  <span class="status-badge" style="background: ${statusStyle.bg}; margin-right: 0.5rem;">${statusStyle.label}</span>
                  <button class="btn btn-secondary btn-sm" onclick="viewCCApplication('${appId}')">
                    <i class="fas fa-eye"></i> View Details
                  </button>
                  ${status === 'submitted' || status === 'under_review' ? `
                    <button class="btn btn-success btn-sm" onclick="approveCCApplication('${appId}')">
                      <i class="fas fa-check"></i> Approve
                    </button>
                    <button class="btn btn-danger btn-sm" onclick="showRejectModal('${appId}')">
                      <i class="fas fa-times"></i> Reject
                    </button>
                  ` : ''}
                </div>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <div class="info-label">Description</div>
                  <div class="info-value" style="max-height: 60px; overflow: hidden; text-overflow: ellipsis;">${app.description || 'No description'}</div>
                </div>
              </div>
            </div>
          `;
        });

        $('#ccApplicationResults').html(html);

        // Update pagination
        if (pagination && pagination.totalPages > 1) {
          let paginationHtml = '';

          // Previous button
          paginationHtml += `
            <li class="page-item ${pagination.hasPrevPage ? '' : 'disabled'}">
              <a class="page-link" href="#" onclick="changeCCPage(${currentCCPage - 1}); return false;" style="background: #1e2028; border-color: #35385a; color: #e5e7eb;">
                <i class="fas fa-chevron-left"></i>
              </a>
            </li>
          `;

          // Page numbers
          for (let i = 1; i <= pagination.totalPages; i++) {
            if (i === currentCCPage || i === 1 || i === pagination.totalPages || (i >= currentCCPage - 1 && i <= currentCCPage + 1)) {
              paginationHtml += `
                <li class="page-item ${i === currentCCPage ? 'active' : ''}">
                  <a class="page-link" href="#" onclick="changeCCPage(${i}); return false;"
                     style="background: ${i === currentCCPage ? '#667eea' : '#1e2028'}; border-color: #35385a; color: #e5e7eb;">
                    ${i}
                  </a>
                </li>
              `;
            } else if (i === currentCCPage - 2 || i === currentCCPage + 2) {
              paginationHtml += `<li class="page-item disabled"><span class="page-link" style="background: #1e2028; border-color: #35385a; color: #9aa0b4;">...</span></li>`;
            }
          }

          // Next button
          paginationHtml += `
            <li class="page-item ${pagination.hasNextPage ? '' : 'disabled'}">
              <a class="page-link" href="#" onclick="changeCCPage(${currentCCPage + 1}); return false;" style="background: #1e2028; border-color: #35385a; color: #e5e7eb;">
                <i class="fas fa-chevron-right"></i>
              </a>
            </li>
          `;

          $('#ccPaginationList').html(paginationHtml);
          $('#ccPagination').show();
        } else {
          $('#ccPagination').hide();
        }
      }

      function changeCCPage(page) {
        currentCCPage = page;
        loadCCApplications();
      }

      function viewCCApplication(appId) {
        $('#ccApplicationModalTitle').text('Loading Application...');
        $('#ccApplicationModalBody').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading...</div>');
        $('#ccApplicationModalFooter').html('<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>');
        $('#ccApplicationModal').modal('show');

        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications/${appId}`,
          method: 'GET',
          success: function(app) {
            displayCCApplicationDetails(app);
          },
          error: function(xhr) {
            $('#ccApplicationModalBody').html('<div class="loading">Failed to load application details</div>');
          }
        });
      }

      function displayCCApplicationDetails(app) {
        const appId = app._id || app.id;
        const displayName = app.displayName || 'Unknown';
        const status = app.status || 'unknown';
        const createdAt = app.createdAt ? new Date(app.createdAt).toLocaleString() : 'Unknown';
        const reviewedAt = app.reviewedAt ? new Date(app.reviewedAt).toLocaleString() : 'N/A';
        const primaryPlatform = app.primaryPlatform || 'Unknown';

        // Status badge styling
        const statusColors = {
          'submitted': { bg: '#3b82f6', label: 'Submitted' },
          'under_review': { bg: '#f59e0b', label: 'Under Review' },
          'approved': { bg: '#10b981', label: 'Approved' },
          'rejected': { bg: '#ef4444', label: 'Rejected' },
          'withdrawn': { bg: '#6b7280', label: 'Withdrawn' }
        };
        const statusStyle = statusColors[status] || { bg: '#6b7280', label: status };

        // Build platforms HTML
        let platformsHtml = '';
        if (app.platforms && Array.isArray(app.platforms)) {
          app.platforms.forEach(p => {
            const platformIcons = {
              'youtube': 'fab fa-youtube',
              'twitch': 'fab fa-twitch',
              'tiktok': 'fab fa-tiktok',
              'instagram': 'fab fa-instagram',
              'twitter': 'fab fa-twitter',
              'facebook': 'fab fa-facebook',
              'other': 'fas fa-globe'
            };
            const icon = platformIcons[p.platform] || 'fas fa-globe';

            platformsHtml += `
              <div class="info-item" style="margin-bottom: 0.5rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <i class="${icon}" style="color: #667eea;"></i>
                  <span style="color: #e5e7eb; font-weight: 500;">${p.platform}</span>
                </div>
                <div style="margin-top: 0.25rem;">
                  <a href="${p.url}" target="_blank" style="color: #667eea; word-break: break-all;">${p.url}</a>
                </div>
                <div style="color: #9aa0b4; font-size: 0.9rem;">
                  ${(p.followerCount || 0).toLocaleString()} followers
                </div>
              </div>
            `;
          });
        }

        $('#ccApplicationModalTitle').text(`Application: ${displayName}`);
        $('#ccApplicationModalBody').html(`
          <div style="margin-bottom: 1rem;">
            <span class="status-badge" style="background: ${statusStyle.bg};">${statusStyle.label}</span>
          </div>

          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Display Name</div>
              <div class="info-value">${displayName}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Primary Platform</div>
              <div class="info-value">${primaryPlatform}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Applied At</div>
              <div class="info-value">${createdAt}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Reviewed At</div>
              <div class="info-value">${reviewedAt}</div>
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <h5 style="color: #e5e7eb; margin-bottom: 1rem;">
              <i class="fas fa-share-alt" style="margin-right: 8px; color: #667eea;"></i>Platforms
            </h5>
            <div style="background: #11131a; border-radius: 8px; padding: 1rem;">
              ${platformsHtml || '<p style="color: #9aa0b4;">No platforms listed</p>'}
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <h5 style="color: #e5e7eb; margin-bottom: 1rem;">
              <i class="fas fa-align-left" style="margin-right: 8px; color: #667eea;"></i>Description
            </h5>
            <div style="background: #11131a; border-radius: 8px; padding: 1rem; color: #e5e7eb; white-space: pre-wrap;">
              ${app.description || 'No description provided'}
            </div>
          </div>

          ${app.rejectionReason ? `
            <div style="margin-top: 1.5rem;">
              <h5 style="color: #ef4444; margin-bottom: 1rem;">
                <i class="fas fa-times-circle" style="margin-right: 8px;"></i>Rejection Details
              </h5>
              <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 1rem;">
                <p style="margin-bottom: 0.5rem;"><strong>Reason:</strong> ${app.rejectionReason}</p>
                ${app.feedback ? `<p style="margin-bottom: 0.5rem;"><strong>Feedback:</strong> ${app.feedback}</p>` : ''}
                ${app.adminNotes ? `<p style="margin-bottom: 0; color: #9aa0b4;"><strong>Admin Notes:</strong> ${app.adminNotes}</p>` : ''}
              </div>
            </div>
          ` : ''}
        `);

        // Update footer with action buttons if status allows
        if (status === 'submitted' || status === 'under_review') {
          $('#ccApplicationModalFooter').html(`
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            <button type="button" class="btn btn-danger" onclick="$('#ccApplicationModal').modal('hide'); showRejectModal('${appId}');">
              <i class="fas fa-times-circle" style="margin-right: 8px;"></i>Reject
            </button>
            <button type="button" class="btn btn-success" onclick="approveCCApplication('${appId}')">
              <i class="fas fa-check-circle" style="margin-right: 8px;"></i>Approve
            </button>
          `);
        } else {
          $('#ccApplicationModalFooter').html('<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>');
        }
      }

      function approveCCApplication(appId) {
        if (!confirm('Are you sure you want to approve this application? This will create a content creator profile for the user.')) {
          return;
        }

        showInfoModal('Processing', '<i class="fas fa-spinner fa-spin"></i> Approving application...');

        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications/${appId}/approve`,
          method: 'POST',
          contentType: 'application/json',
          success: function(data) {
            $('#infoModal').modal('hide');
            $('#ccApplicationModal').modal('hide');
            showInfoModal('Success', '<i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i>Application approved successfully! A content creator profile has been created.');
            loadCCApplications();
            loadCCStats();
            loadCCPendingCount(); // Update badge
          },
          error: function(xhr) {
            $('#infoModal').modal('hide');
            showInfoModal('Error', `<i class="fas fa-exclamation-circle" style="color: #ef4444; margin-right: 8px;"></i>Failed to approve application: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }

      function showRejectModal(appId) {
        $('#rejectApplicationId').val(appId);
        $('#rejectionReason').val('');
        $('#rejectionFeedback').val('');
        $('#rejectionAdminNotes').val('');
        $('#ccRejectModal').modal('show');
      }

      $('#confirmRejectBtn').click(function() {
        const appId = $('#rejectApplicationId').val();
        const reason = $('#rejectionReason').val();
        const feedback = $('#rejectionFeedback').val();
        const adminNotes = $('#rejectionAdminNotes').val();

        if (!reason) {
          alert('Please select a rejection reason');
          return;
        }

        const button = $(this);
        button.prop('disabled', true);
        button.html('<i class="fas fa-spinner fa-spin"></i> Rejecting...');

        $.ajax({
          url: `${API_BASE}/api/v1/admin/content-creator-applications/${appId}/reject`,
          method: 'POST',
          contentType: 'application/json',
          data: JSON.stringify({
            rejectionReason: reason,
            feedback: feedback,
            adminNotes: adminNotes
          }),
          success: function(data) {
            $('#ccRejectModal').modal('hide');
            showInfoModal('Success', '<i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i>Application rejected successfully.');
            loadCCApplications();
            loadCCStats();
            loadCCPendingCount(); // Update badge
          },
          error: function(xhr) {
            showInfoModal('Error', `<i class="fas fa-exclamation-circle" style="color: #ef4444; margin-right: 8px;"></i>Failed to reject application: ${xhr.responseJSON?.error || 'Unknown error'}`);
          },
          complete: function() {
            button.prop('disabled', false);
            button.html('<i class="fas fa-times-circle" style="margin-right: 8px;"></i>Reject Application');
          }
        });
      });


    </script>
    
    <!-- Admin Console Footer -->
    <footer class="admin-footer">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 2rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
          <img src="/static/images/dispatch-logo-512.png" alt="LPC Logo" style="width: 32px; height: 32px; border-radius: 8px;">
          <span style="font-size: 1.2rem; font-weight: 600; color: #e5e7eb; letter-spacing: 0.02em;">Lines Police CAD Admin Console</span>
        </div>
        <div style="font-size: 0.95rem; color: #9aa0b4; margin-bottom: 1rem;">
