    var caseState = null;
    var casesCurrentFilter = '';
    var casesCurrentPage = 0;

    // Mask an email for display when a user has no username set.
    // e.g. "merrill@gmail.com" -> "m***l@g*.c"
    function maskEmail(email) {
      if (!email) return null;
      var s = String(email).trim();
      if (s === '(unknown)') return null;
      var at = s.indexOf('@');
      if (at < 1 || at === s.length - 1) return null;
      var local = s.slice(0, at);
      var rest = s.slice(at + 1);
      var dot = rest.lastIndexOf('.');
      if (dot < 1 || dot === rest.length - 1) return null;
      var domain = rest.slice(0, dot);
      var tld = rest.slice(dot + 1);
      var maskedLocal = local.length <= 2 ? local.charAt(0) + '*' : local.charAt(0) + '***' + local.charAt(local.length - 1);
      var maskedDomain = domain.charAt(0) + '*';
      var maskedTld = tld.charAt(0);
      return maskedLocal + '@' + maskedDomain + '.' + maskedTld;
    }

    // Resolve a member-ish object (id/username/email) into a human-readable label.
    // Falls back to a masked email for old accounts with no username, then to a short id.
    function displayUser(u) {
      if (!u) return 'Unknown user';
      var name = u.username;
      if (name && typeof name === 'string') {
        name = name.trim();
        if (name && name !== '(unknown)') return name;
      }
      var masked = maskEmail(u.email);
      if (masked) return masked;
      var id = u.id || u._id;
      if (id) {
        var idStr = String(id);
        return 'Deleted user (' + idStr.slice(-6) + ')';
      }
      return 'Unknown user';
    }

    // Pull the most informative error string out of a jQuery xhr object.
    // Avoids the bare "Unknown error" message when the response isn't JSON.
    function extractAjaxError(xhr) {
      if (!xhr) return 'Network error (no response)';
      try {
        if (xhr.responseJSON) {
          var rj = xhr.responseJSON;
          if (rj.error) return rj.error;
          if (rj.message) return rj.message;
        }
      } catch (e) {}
      var txt = xhr.responseText;
      if (txt && typeof txt === 'string') {
        var trimmed = txt.trim();
        // Try to parse as JSON in case responseJSON wasn't auto-parsed
        if (trimmed.charAt(0) === '{') {
          try {
            var parsed = JSON.parse(trimmed);
            if (parsed && (parsed.error || parsed.message)) return parsed.error || parsed.message;
          } catch (e) {}
        }
        // Avoid dumping HTML error pages into the UI
        if (trimmed.charAt(0) !== '<' && trimmed.length < 300) return trimmed;
      }
      var status = xhr.status;
      var statusText = xhr.statusText;
      if (status === 0) return 'Network error — check your connection or VPN';
      if (status === 401) return 'Not authenticated (HTTP 401) — your session may have expired, please reload';
      if (status === 403) return 'Forbidden (HTTP 403) — your account does not have permission for this action';
      if (status === 404) return 'Not found (HTTP 404)';
      if (status === 408) return 'Request timed out (HTTP 408)';
      if (status === 500) return 'Server error (HTTP 500)';
      if (status === 502 || status === 503 || status === 504) return 'API is temporarily unavailable (HTTP ' + status + ')';
      if (status) return 'HTTP ' + status + (statusText ? ' ' + statusText : '');
      return 'Unknown error (no status)';
    }

    // Resolve the admin's current role in priority order for case actor records.
    function caseCurrentAdminRole() {
      if (typeof roles === 'undefined' || !roles || !roles.length) return 'admin';
      if (roles.indexOf('owner') !== -1) return 'owner';
      if (roles.indexOf('admin') !== -1) return 'admin';
      return roles[0] || 'admin';
    }

    function caseCurrentPerformer() {
      return {
        adminEmail: typeof currentUserEmail !== 'undefined' ? currentUserEmail : '',
        adminName: typeof currentUserName !== 'undefined' ? currentUserName : '',
        adminRole: caseCurrentAdminRole()
      };
    }

    function loadCases(status, page) {
      if (typeof page === 'undefined') page = 0;
      casesCurrentFilter = status;
      casesCurrentPage = page;

      // Update URL hash with filter
      var hashStr = 'cases';
      if (status) hashStr += '?status=' + status;
      history.replaceState(null, null, '#' + hashStr);

      // Update filter button styles
      ['caseFilterAll', 'caseFilterOpen', 'caseFilterCompleted', 'caseFilterCancelled'].forEach(function(id) {
        var btn = document.getElementById(id);
        if (btn) {
          btn.className = 'ac-btn' + (
            (id === 'caseFilterAll' && status === '') ||
            (id === 'caseFilterOpen' && status === 'open') ||
            (id === 'caseFilterCompleted' && status === 'completed') ||
            (id === 'caseFilterCancelled' && status === 'cancelled')
            ? ' ac-btn-accent' : '');
        }
      });

      var url = API_BASE + '/api/v1/admin/cases?page=' + page + '&limit=20';
      if (status) url += '&status=' + status;

      $('#cases-list').html('<div class="loading">Loading cases...</div>');
      $.ajax({
        url: url,
        method: 'GET',
        success: function(data) {
          var cases = data.cases || [];
          if (cases.length === 0) {
            $('#cases-list').html('<p style="color: var(--ac-text-muted); text-align: center; padding: 2rem;">No cases found.</p>');
            $('#cases-pagination').html('');
            return;
          }

          var html = '';
          cases.forEach(function(c) {
            var statusColor = c.status === 'open' ? 'var(--ac-amber)' : c.status === 'cancelled' ? 'var(--ac-red)' : 'var(--ac-green)';
            var statusBg = c.status === 'open' ? 'rgba(245,158,11,0.1)' : c.status === 'cancelled' ? 'rgba(239,68,68,0.1)' : 'rgba(34,197,94,0.1)';
            var statusLabel = c.status === 'open' ? 'OPEN' : c.status === 'cancelled' ? 'CANCELLED' : 'COMPLETED';
            var typeLabel = c.type === 'ownership_reset' ? 'Ownership Reset' : c.type;
            var createdAt = new Date(c.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
            var btnLabel = c.status === 'open' ? '<i class="fas fa-play"></i> Resume' : '<i class="fas fa-eye"></i> View';

            html += '<div class="result-card" style="margin-bottom: 0.75rem;">';
            html += '<div style="display: flex; justify-content: space-between; align-items: center;">';
            html += '<div style="flex: 1;">';
            html += '<div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">';
            html += '<span style="color: var(--ac-accent); font-weight: 700; font-size: 0.8rem; font-family: \'JetBrains Mono\', monospace;">#' + (c.caseNumber || '?') + '</span>';
            html += '<strong style="color: #fff;">' + (c.communityName || 'Unknown') + '</strong>';
            html += '<span style="color: ' + statusColor + '; background: ' + statusBg + '; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">' + statusLabel + '</span>';
            html += '</div>';
            html += '<div style="color: var(--ac-text-muted); font-size: 0.85rem;">';
            html += typeLabel + ' &middot; Created by ' + (c.createdBy.adminName || c.createdBy.adminEmail || 'Unknown') + ' &middot; ' + createdAt;
            html += '</div>';
            html += '</div>';
            html += '<div style="display: flex; gap: 0.5rem;">';
            if (c.status === 'open') {
              html += '<button class="ac-btn" onclick="promptCancelCase(\'' + c.id + '\')" style="white-space: nowrap; color: var(--ac-red);"><i class="fas fa-times"></i> Cancel</button>';
            }
            html += '<button class="ac-btn ac-btn-accent" onclick="viewCase(\'' + c.id + '\')" style="white-space: nowrap;">' + btnLabel + '</button>';
            html += '</div>';
            html += '</div>';
            if (c.status === 'cancelled' && c.cancelledReason) {
              html += '<div style="color: var(--ac-text-muted); font-size: 0.8rem; margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid rgba(255,255,255,0.06);"><strong style="color: var(--ac-red);">Cancelled:</strong> ' + c.cancelledReason + (c.cancelledBy ? ' — by ' + c.cancelledBy : '') + '</div>';
            }
            html += '</div>';
          });

          $('#cases-list').html(html);

          // Pagination
          var totalPages = Math.ceil(data.totalCount / data.limit);
          if (totalPages > 1) {
            var pagHtml = '<div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 1rem;">';
            if (page > 0) pagHtml += '<button class="ac-btn" onclick="loadCases(\'' + status + '\', ' + (page - 1) + ')">Previous</button>';
            pagHtml += '<span style="color: var(--ac-text-muted); padding: 0.5rem;">Page ' + (page + 1) + ' of ' + totalPages + '</span>';
            if (page < totalPages - 1) pagHtml += '<button class="ac-btn" onclick="loadCases(\'' + status + '\', ' + (page + 1) + ')">Next</button>';
            pagHtml += '</div>';
            $('#cases-pagination').html(pagHtml);
          } else {
            $('#cases-pagination').html('');
          }
        },
        error: function() {
          $('#cases-list').html('<p style="color: var(--ac-red); text-align: center; padding: 2rem;">Failed to load cases.</p>');
        }
      });
    }

    function backToCasesList() {
      caseState = null;
      $('#case-detail-view').hide();
      $('#cases-list-view').show();
      loadCases(casesCurrentFilter, casesCurrentPage);
    }

    function promptCancelCase(caseId) {
      var html = '<div style="padding: 1rem;">';
      html += '<label style="color: var(--ac-text-muted); font-size: 0.85rem; display: block; margin-bottom: 0.5rem;">Why is this case being cancelled? <span style="color: var(--ac-red);">*</span></label>';
      html += '<textarea id="cancelCaseReason" class="form-control" rows="2" placeholder="Enter cancellation reason..." oninput="toggleCancelCaseBtn()" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 8px; padding: 0.75rem; resize: vertical;"></textarea>';
      html += '<div id="cancelCaseError" style="display: none; color: var(--ac-red); font-size: 0.85rem; margin-top: 0.5rem;"></div>';
      html += '<div style="display: flex; gap: 0.5rem; margin-top: 0.75rem;">';
      html += '<button class="ac-btn" onclick="loadCases(casesCurrentFilter, casesCurrentPage)" style="color: var(--ac-red);">Nevermind</button>';
      html += '<button class="ac-btn ac-btn-accent" id="cancelCaseBtn" disabled onclick="executeCancelCase(\'' + caseId + '\')" style="opacity: 0.5; cursor: not-allowed;"><i class="fas fa-times"></i> Cancel Case</button>';
      html += '</div>';
      html += '</div>';
      showInfoModal('Cancel Case', html);
    }

    function toggleCancelCaseBtn() {
      var hasReason = $('#cancelCaseReason').val().trim().length > 0;
      $('#cancelCaseBtn').prop('disabled', !hasReason).css({ opacity: hasReason ? 1 : 0.5, cursor: hasReason ? 'pointer' : 'not-allowed' });
    }

    function executeCancelCase(caseId) {
      var reason = $('#cancelCaseReason').val().trim();
      if (!reason) {
        $('#cancelCaseError').text('Please enter a reason for cancellation.').show();
        return;
      }
      $('#cancelCaseBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Cancelling...');
      $.ajax({
        url: API_BASE + '/api/v1/admin/cases/' + caseId + '/cancel',
        method: 'PATCH',
        contentType: 'application/json',
        data: JSON.stringify({ reason: reason, currentUser: { email: currentUserEmail, roles: roles, name: currentUserName } }),
        success: function() {
          $('#infoModal').modal('hide');
          $('body').removeClass('modal-open');
          $('.modal-backdrop').remove();
          loadCases(casesCurrentFilter, casesCurrentPage);
        },
        error: function(xhr) {
          $('#cancelCaseError').text('Failed to cancel: ' + (xhr.responseJSON ? xhr.responseJSON.error : 'Unknown error')).show();
          $('#cancelCaseBtn').prop('disabled', false).html('<i class="fas fa-times"></i> Cancel Case');
        }
      });
    }

    function viewCase(caseId) {
      $('#cases-list-view').hide();
      $('#case-detail-view').show();
      $('#case-detail-content').html('<div class="loading">Loading case...</div>');

      $.ajax({
        url: API_BASE + '/api/v1/admin/cases/' + caseId,
        method: 'GET',
        success: function(data) {
          caseState = data['case'];
          // Update URL hash with case number for direct linking
          if (caseState.caseNumber) {
            history.replaceState(null, null, '#cases/' + caseState.caseNumber);
          }
          // Also load community and roles data for the workflow
          Promise.all([
            $.ajax({ url: API_BASE + '/api/v1/admin/communities/' + caseState.communityId, method: 'GET' }),
            $.ajax({ url: API_BASE + '/api/v1/admin/communities/' + caseState.communityId + '/roles', method: 'GET' }),
          ]).then(function(results) {
            caseState._community = results[0].community;
            caseState._roles = results[1].roles || [];
            caseState._dangerousRoles = caseState._roles.filter(function(r) { return r.hasAdminPermission && !r.isHeadAdmin; });
            // Set old owner from community data if not already in step 1
            if (caseState._community.owner && !caseState.steps.transferOwnership.oldOwner) {
              caseState._oldOwner = {
                id: caseState._community.owner.id,
                email: caseState._community.owner.email,
                username: caseState._community.owner.username
              };
            } else if (caseState.steps.transferOwnership.oldOwner) {
              caseState._oldOwner = caseState.steps.transferOwnership.oldOwner;
            }
            renderCaseStep();
          }).catch(function() {
            $('#case-detail-content').html('<div style="color: var(--ac-red); padding: 2rem; text-align: center;">Failed to load community data. <button class="ac-btn" onclick="viewCase(\'' + caseId + '\')">Retry</button></div>');
          });
        },
        error: function() {
          $('#case-detail-content').html('<div style="color: var(--ac-red); padding: 2rem; text-align: center;">Failed to load case.</div>');
        }
      });
    }

    function getCurrentCaseStep() {
      if (!caseState) return 1;
      var steps = caseState.steps;
      if (!steps.transferOwnership.completed) return 1;
      if (!steps.headAdmin.completed) return 2;
      if (!steps.roleAudit.completed) return 3;
      if (!steps.removeBadActor.completed) return 4;
      if (!steps.summary.completed) return 5;
      return 6; // all complete — show read-only summary
    }

    function renderCaseStep() {
      var step = getCurrentCaseStep();
      var isReadOnly = caseState.status === 'completed' || caseState.status === 'cancelled';
      // If case is completed or cancelled, show summary (read-only)
      if (isReadOnly || step >= 5) {
        renderCaseStep5_Summary(isReadOnly);
        return;
      }
      switch (step) {
        case 1: renderCaseStep1_TransferOwnership(); break;
        case 2: renderCaseStep2_HeadAdmin(); break;
        case 3: renderCaseStep3_RoleAudit(); break;
        case 4: renderCaseStep4_RemoveBadActor(); break;
        case 5: renderCaseStep5_Summary(false); break;
      }
    }

    function renderCaseStepper(currentStep) {
      var steps = ['Owner', 'Head Admin', 'Role Audit', 'Remove User', 'Summary'];
      var stepKeys = ['transferOwnership', 'headAdmin', 'roleAudit', 'removeBadActor', 'summary'];
      var isCancelled = caseState && caseState.status === 'cancelled';
      var isMobile = window.innerWidth < 768;
      if (isMobile) {
        return '<div style="text-align: center; color: var(--ac-text-muted); margin-bottom: 1.5rem; font-size: 0.9rem;">Step ' + currentStep + ' of 5: ' + steps[currentStep - 1] + '</div>';
      }
      var html = '<div style="display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; gap: 0.25rem;">';
      steps.forEach(function(step, i) {
        var stepNum = i + 1;
        var isActive = stepNum === currentStep;
        // Check actual completion from case data, not just position
        var isCompleted = caseState && caseState.steps && caseState.steps[stepKeys[i]] ? caseState.steps[stepKeys[i]].completed : false;
        var circleColor = isCompleted ? 'var(--ac-green)' : isActive ? 'var(--ac-accent)' : 'rgba(255,255,255,0.1)';
        var textColor = isActive ? '#fff' : 'var(--ac-text-muted)';
        html += '<div style="display: flex; align-items: center;">';
        html += '<div style="display: flex; flex-direction: column; align-items: center; min-width: 60px;">';
        html += '<div style="width: 28px; height: 28px; border-radius: 50%; background: ' + circleColor + '; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; color: #fff; font-weight: 600;">';
        html += isCompleted ? '<i class="fas fa-check" style="font-size: 0.7rem;"></i>' : stepNum;
        html += '</div>';
        html += '<span style="font-size: 0.7rem; color: ' + textColor + '; margin-top: 0.25rem;">' + step + '</span>';
        html += '</div>';
        if (stepNum < 5) {
          html += '<div style="width: 30px; height: 2px; background: ' + (isCompleted ? 'var(--ac-green)' : 'rgba(255,255,255,0.1)') + '; margin: 0 0.25rem; margin-bottom: 1rem;"></div>';
        }
        html += '</div>';
      });
      html += '</div>';
      return html;
    }

    function saveCaseStep(stepName, data, onSuccess) {
      data.currentUser = { email: currentUserEmail, roles: roles };
      // Record who completed this step so the summary can list every contributor
      if (data.performedBy === undefined) data.performedBy = caseCurrentPerformer();
      $.ajax({
        url: API_BASE + '/api/v1/admin/cases/' + caseState.id + '/steps/' + stepName,
        method: 'PATCH',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function(res) {
          // Preserve transient fields that aren't in the DB
          var transient = {
            _community: caseState._community,
            _roles: caseState._roles,
            _dangerousRoles: caseState._dangerousRoles,
            _oldOwner: caseState._oldOwner,
            _newOwner: caseState._newOwner,
            _badActor: caseState._badActor
          };
          caseState = res['case'];
          for (var key in transient) {
            if (transient[key] !== undefined) caseState[key] = transient[key];
          }
          if (onSuccess) onSuccess();
        },
        error: function(xhr) {
          showInfoModal('Error', 'Failed to save case progress: ' + extractAjaxError(xhr) + '. Your action was completed but the case state could not be updated. Please try again.');
        }
      });
    }

    // ── Case Step 1: Transfer Ownership ──
    function renderCaseStep1_TransferOwnership() {
      var owner = caseState._oldOwner;
      var html = renderCaseStepper(1);
      html += '<div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem;">';
      html += '<div style="color: var(--ac-text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">Current Owner</div>';
      html += '<div style="color: #fff; font-weight: 600;">' + displayUser(owner) + '</div>';
      html += '<div style="color: var(--ac-text-muted); font-size: 0.85rem;">' + (owner && owner.email ? owner.email : 'N/A') + '</div>';
      html += '<div style="color: var(--ac-text-muted); font-size: 0.75rem;">ID: ' + (owner && owner.id ? owner.id : 'N/A') + '</div>';
      html += '</div>';
      html += '<div style="margin-bottom: 1rem;">';
      html += '<label style="color: var(--ac-text-muted); font-size: 0.85rem; display: block; margin-bottom: 0.5rem;">New Owner Email</label>';
      html += '<input type="email" id="caseNewOwnerEmail" class="form-control" placeholder="Enter the new owner\'s email address" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 8px; padding: 0.75rem;">';
      html += '</div>';
      html += '<div id="caseNewOwnerPreview" style="display: none; background: rgba(139,92,246,0.1); border: 1px solid rgba(139,92,246,0.3); border-radius: 8px; padding: 1rem; margin-bottom: 1rem;"></div>';
      html += '<div id="caseNewOwnerError" style="display: none; color: var(--ac-red); font-size: 0.85rem; margin-bottom: 1rem;"></div>';
      html += '<div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">';
      html += '<button class="ac-btn ac-btn-accent" id="caseStep1Btn" onclick="caseLookupNewOwner()"><i class="fas fa-search"></i> Look Up User</button>';
      html += '</div>';
      $('#case-detail-content').html(html);
    }

    function caseLookupNewOwner() {
      var email = $('#caseNewOwnerEmail').val().trim();
      if (!email) { $('#caseNewOwnerError').text('Please enter an email address.').show(); return; }
      $('#caseStep1Btn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Looking up...');
      $('#caseNewOwnerError').hide();
      $.ajax({
        url: API_BASE + '/api/v1/admin/search/users',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ query: email, page: 0, limit: 1 }),
        success: function(data) {
          var users = data.users || [];
          var exactMatch = users.find(function(u) { return u.email && u.email.toLowerCase() === email.toLowerCase(); });
          if (!exactMatch) {
            $('#caseNewOwnerError').text('No user found with that email address.').show();
            $('#caseStep1Btn').prop('disabled', false).html('<i class="fas fa-search"></i> Look Up User');
            return;
          }
          caseState._newOwner = { id: exactMatch.id, email: exactMatch.email, username: exactMatch.username };
          var previewHtml = '<div style="color: var(--ac-text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">New Owner</div>';
          previewHtml += '<div style="color: #fff; font-weight: 600;">' + displayUser(exactMatch) + '</div>';
          previewHtml += '<div style="color: var(--ac-text-muted); font-size: 0.85rem;">' + (exactMatch.email || '') + '</div>';
          previewHtml += '<div style="color: var(--ac-text-muted); font-size: 0.75rem;">ID: ' + exactMatch.id + '</div>';
          $('#caseNewOwnerPreview').html(previewHtml).show();
          $('#caseStep1Btn').prop('disabled', false).html('<i class="fas fa-exchange-alt"></i> Transfer Ownership').off('click').on('click', caseConfirmTransfer);
        },
        error: function() {
          $('#caseNewOwnerError').text('Failed to search for user.').show();
          $('#caseStep1Btn').prop('disabled', false).html('<i class="fas fa-search"></i> Look Up User');
        }
      });
    }

    function caseConfirmTransfer() {
      var oldOwner = caseState._oldOwner;
      var newOwner = caseState._newOwner;
      showConfirmModal(
        'Confirm Ownership Transfer',
        '<p>You are about to transfer ownership of <strong>' + caseState.communityName + '</strong>:</p>' +
        '<p><strong>From:</strong> ' + (oldOwner ? displayUser(oldOwner) + (oldOwner.email ? ' (' + oldOwner.email + ')' : '') : 'Unknown') + '</p>' +
        '<p><strong>To:</strong> ' + displayUser(newOwner) + (newOwner.email ? ' (' + newOwner.email + ')' : '') + '</p>' +
        '<p style="color: var(--ac-amber);"><i class="fas fa-exclamation-triangle"></i> This action will be logged.</p>',
        function() { caseExecuteTransfer(); }
      );
    }

    function caseExecuteTransfer() {
      $('#case-detail-content').html('<div style="text-align: center; padding: 2rem;"><div class="loading">Transferring ownership...</div></div>');
      $.ajax({
        url: API_BASE + '/api/v1/admin/communities/' + caseState.communityId + '/transfer-ownership',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ newOwnerEmail: caseState._newOwner.email, currentUser: { email: currentUserEmail, roles: roles } }),
        success: function(data) {
          // Save step to case
          saveCaseStep('transferOwnership', {
            oldOwner: caseState._oldOwner,
            newOwner: caseState._newOwner,
            addedToHeadAdmin: data.addedToHeadAdmin || false
          }, function() {
            // Refresh roles data
            $.ajax({
              url: API_BASE + '/api/v1/admin/communities/' + caseState.communityId + '/roles',
              method: 'GET',
              success: function(rolesRes) {
                caseState._roles = rolesRes.roles || [];
                caseState._dangerousRoles = caseState._roles.filter(function(r) { return r.hasAdminPermission && !r.isHeadAdmin; });
                renderCaseStep();
              },
              error: function() { renderCaseStep(); }
            });
          });
        },
        error: function(xhr) {
          var msg = extractAjaxError(xhr);
          var safeMsg = $('<div>').text(msg).html();
          $('#case-detail-content').html('<div style="color: var(--ac-red); padding: 2rem; text-align: center;"><div style="margin-bottom: 0.75rem;"><i class="fas fa-exclamation-triangle"></i> Failed to transfer ownership</div><div style="background: rgba(0,0,0,0.25); border: 1px solid rgba(239,68,68,0.3); border-radius: 6px; padding: 0.75rem; color: var(--ac-text); font-size: 0.85rem; text-align: left; white-space: pre-wrap; word-break: break-word; margin-bottom: 1rem;">' + safeMsg + '</div><button class="ac-btn" onclick="renderCaseStep()">Retry</button></div>');
        }
      });
    }

    // ── Case Step 2: Head Admin Check ──
    function renderCaseStep2_HeadAdmin() {
      var headAdminRole = caseState._roles.find(function(r) { return r.isHeadAdmin; });
      var newOwner = caseState.steps.transferOwnership.newOwner;
      var newOwnerInHeadAdmin = headAdminRole && headAdminRole.members.some(function(m) { return m.id === newOwner.id; });
      var addedToHeadAdmin = caseState.steps.transferOwnership.addedToHeadAdmin;

      var html = renderCaseStepper(2);
      var newOwnerLabel = displayUser(newOwner);
      if (addedToHeadAdmin || newOwnerInHeadAdmin) {
        html += '<div style="text-align: center; padding: 1rem;">';
        html += '<div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(34,197,94,0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">';
        html += '<i class="fas fa-check" style="color: var(--ac-green); font-size: 1.5rem;"></i></div>';
        html += '<h5 style="color: #fff; margin-bottom: 0.5rem;">' + newOwnerLabel + ' is in the Head Admin role</h5>';
        html += '<p style="color: var(--ac-text-muted); font-size: 0.85rem;">' + (addedToHeadAdmin ? 'They were automatically added during the ownership transfer.' : 'They were already a member of this role.') + '</p>';
        html += '</div>';
      } else {
        html += '<div style="text-align: center; padding: 1rem;">';
        html += '<div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(245,158,11,0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">';
        html += '<i class="fas fa-exclamation-triangle" style="color: var(--ac-amber); font-size: 1.5rem;"></i></div>';
        html += '<h5 style="color: #fff; margin-bottom: 0.5rem;">' + newOwnerLabel + ' is NOT in the Head Admin role</h5>';
        html += '<p style="color: var(--ac-text-muted); font-size: 0.85rem;">This is unusual — the new owner should typically be in the Head Admin role.</p>';
        html += '</div>';
      }
      html += '<div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">';
      html += '<button class="ac-btn ac-btn-accent" onclick="caseCompleteStep2()">Continue <i class="fas fa-arrow-right"></i></button>';
      html += '</div>';
      $('#case-detail-content').html(html);
    }

    function caseCompleteStep2() {
      saveCaseStep('headAdmin', {
        addedToHeadAdmin: caseState.steps.transferOwnership.addedToHeadAdmin || false
      }, function() { renderCaseStep(); });
    }

    // ── Case Step 3: Role Audit ──
    function renderCaseStep3_RoleAudit() {
      var html = renderCaseStepper(3);
      var dangerousRoles = caseState._dangerousRoles || [];

      if (dangerousRoles.length === 0) {
        html += '<div style="text-align: center; padding: 1rem;">';
        html += '<div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(34,197,94,0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">';
        html += '<i class="fas fa-check" style="color: var(--ac-green); font-size: 1.5rem;"></i></div>';
        html += '<h5 style="color: #fff; margin-bottom: 0.5rem;">No other roles have Administrator permission</h5>';
        html += '<p style="color: var(--ac-text-muted); font-size: 0.85rem;">Only the Head Admin role has full admin access.</p>';
        html += '</div>';
      } else {
        html += '<div style="background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.3); border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">';
        html += '<div style="color: var(--ac-amber); font-weight: 600; margin-bottom: 0.5rem;">';
        html += '<i class="fas fa-exclamation-triangle"></i> ' + dangerousRoles.length + ' other role' + (dangerousRoles.length > 1 ? 's' : '') + ' with Administrator permission</div>';
        html += '<p style="color: var(--ac-text-muted); font-size: 0.85rem; margin: 0;">Members of these roles can still kick users, change settings, and perform admin actions.</p>';
        html += '</div>';
        dangerousRoles.forEach(function(role) {
          html += '<div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 1rem; margin-bottom: 0.75rem;">';
          html += '<div style="color: #fff; font-weight: 600; margin-bottom: 0.5rem;">' + role.name + '</div>';
          if (role.members && role.members.length > 0) {
            role.members.forEach(function(m) {
              html += '<div style="display: flex; align-items: center; padding: 0.35rem 0; color: var(--ac-text-muted); font-size: 0.85rem;">';
              html += '<i class="fas fa-user" style="margin-right: 0.5rem; font-size: 0.75rem;"></i>';
              html += displayUser(m) + ' <span style="margin-left: 0.5rem; font-size: 0.75rem;">(' + m.id + ')</span></div>';
            });
          } else {
            html += '<div style="color: var(--ac-text-muted); font-size: 0.85rem;">No members</div>';
          }
          html += '</div>';
        });
        // Copy block
        html += '<div style="position: relative; margin-top: 1rem;">';
        html += '<button class="ac-btn" onclick="caseCopyRoleAudit()" style="position: absolute; top: 0.5rem; right: 0.5rem; font-size: 0.75rem; padding: 0.25rem 0.75rem;" id="caseCopyRoleAuditBtn"><i class="fas fa-copy"></i> Copy</button>';
        html += '<pre style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 1rem; padding-right: 5rem; color: var(--ac-text-muted); font-size: 0.8rem; white-space: pre-wrap; word-break: break-word; max-height: 200px; overflow-y: auto; font-family: \'JetBrains Mono\', monospace;">' + caseGenerateRoleAuditText() + '</pre>';
        html += '</div>';
      }
      html += '<div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">';
      html += '<button class="ac-btn ac-btn-accent" onclick="caseCompleteStep3()">Continue <i class="fas fa-arrow-right"></i></button>';
      html += '</div>';
      $('#case-detail-content').html(html);
    }

    function caseGenerateRoleAuditText() {
      var newOwner = caseState.steps.transferOwnership.newOwner;
      var oldOwner = caseState.steps.transferOwnership.oldOwner || caseState._oldOwner;
      var text = '\u26a0\ufe0f ADMIN ROLES AUDIT \u2014 Community: "' + caseState.communityName + '"\n';
      text += 'New Owner: ' + displayUser(newOwner) + '\n';
      text += 'Previous Owner: ' + (oldOwner ? displayUser(oldOwner) : 'Unknown') + '\n\n';
      text += 'Roles with Administrator Permission:\n';
      var headAdmin = caseState._roles.find(function(r) { return r.isHeadAdmin; });
      if (headAdmin) {
        text += '\u2022 ' + headAdmin.name + ' (Head Admin) \u2014 Members: ' + (headAdmin.members.map(function(m) { return displayUser(m); }).join(', ') || 'None') + '\n';
      }
      (caseState._dangerousRoles || []).forEach(function(role) {
        text += '\u2022 ' + role.name + ' \u2014 Members: ' + (role.members.map(function(m) { return displayUser(m); }).join(', ') || 'None') + '\n';
      });
      text += '\nPlease confirm these role assignments are correct.';
      return text;
    }

    function caseCopyRoleAudit() {
      navigator.clipboard.writeText(caseGenerateRoleAuditText()).then(function() {
        $('#caseCopyRoleAuditBtn').html('<i class="fas fa-check"></i> Copied!');
        setTimeout(function() { $('#caseCopyRoleAuditBtn').html('<i class="fas fa-copy"></i> Copy'); }, 2000);
      });
    }

    function caseCompleteStep3() {
      saveCaseStep('roleAudit', {
        dangerousRoles: caseState._dangerousRoles || []
      }, function() { renderCaseStep(); });
    }

    // ── Case Step 4: Remove Bad Actor ──
    function renderCaseStep4_RemoveBadActor() {
      var html = renderCaseStepper(4);
      var prefillEmail = caseState._oldOwner ? caseState._oldOwner.email : '';
      html += '<div style="margin-bottom: 1rem;">';
      html += '<h5 style="color: #fff;">Remove a User from This Community <span style="color: var(--ac-text-muted); font-weight: 400; font-size: 0.85rem;">(Optional)</span></h5>';
      html += '<p style="color: var(--ac-text-muted); font-size: 0.85rem;">Use this to remove a bad actor who hijacked the community.</p>';
      html += '</div>';
      // Copy-paste prompt for staff to send to the requester
      html += '<div style="margin-bottom: 1.25rem;">';
      html += '<div style="color: var(--ac-text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">Ask the requester</div>';
      html += '<div style="position: relative;">';
      html += '<button class="ac-btn" onclick="caseCopyStep4Prompt()" style="position: absolute; top: 0.5rem; right: 0.5rem; font-size: 0.75rem; padding: 0.25rem 0.75rem;" id="caseCopyStep4PromptBtn"><i class="fas fa-copy"></i> Copy</button>';
      html += '<pre style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 1rem; padding-right: 5rem; color: var(--ac-text); font-size: 0.85rem; white-space: pre-wrap; word-break: break-word; font-family: \'JetBrains Mono\', monospace; margin: 0;">' + caseGenerateStep4PromptText() + '</pre>';
      html += '</div>';
      html += '</div>';
      html += '<div style="margin-bottom: 1rem;">';
      html += '<label style="color: var(--ac-text-muted); font-size: 0.85rem; display: block; margin-bottom: 0.5rem;">User Email to Remove</label>';
      html += '<input type="email" id="caseBadActorEmail" class="form-control" value="' + prefillEmail + '" placeholder="Enter the bad actor\'s email address" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 8px; padding: 0.75rem;">';
