      function getTimeAgo(timestamp) {
        const now = new Date();
        const time = new Date(timestamp);
        const diffMs = now - time;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMs / 3600000);
        const diffDays = Math.floor(diffMs / 86400000);
        
        if (diffMins < 1) return 'Just now';
        if (diffMins < 60) return `${diffMins}m ago`;
        if (diffHours < 24) return `${diffHours}h ago`;
        if (diffDays < 7) return `${diffDays}d ago`;
        return time.toLocaleDateString();
      }
      
      function renderActivityChart(activity) {
        // Timeline data comes from activity.timeline according to backend spec
        // Format: [{ date: "2025-12-17", count: 5 }, ...]
        const timeline = activity.timeline || [];
        
        if (!timeline || timeline.length === 0) {
          $('#activityChart').html(`
            <div class="text-center" style="padding: 2rem; color: #9aa0b4;">
              <i class="fas fa-chart-line" style="font-size: 2rem; margin-bottom: 1rem;"></i>
              <p>No chart data available</p>
            </div>
          `);
          return;
        }
        
        // Check if all values are 0 (no activity)
        const hasAnyActivity = timeline.some(day => day.count > 0);
        
        if (!hasAnyActivity) {
          $('#activityChart').html(`
            <div class="text-center" style="padding: 2rem; color: #9aa0b4;">
              <i class="fas fa-chart-line" style="font-size: 2rem; margin-bottom: 1rem;"></i>
              <p>No activity recorded for this timeframe</p>
            </div>
          `);
          return;
        }
        
        // Find max count for scaling
        const maxCount = Math.max(...timeline.map(day => day.count || 0), 1);
        
        const chartHtml = `
          <div class="chart-container">
            <div class="chart-bars">
              ${timeline.map(day => {
                const count = day.count || 0;
                const height = maxCount > 0 ? (count / maxCount) * 200 : 0; // Max height 200px
                return count > 0 ? `
                  <div class="chart-bar" style="height: ${height}px;" title="${day.date}: ${count} activities">
                    <div class="bar-label">${day.date}</div>
                  </div>
                ` : `
                  <div class="chart-bar chart-bar-empty" title="${day.date}: ${count} activities">
                    <div class="bar-label">${day.date}</div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
        
        $('#activityChart').html(chartHtml);
      }
      
