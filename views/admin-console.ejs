<!DOCTYPE html>
<html>
  <head>
    <% include ad-header %>
    <meta charset="utf-8">
    <title>LPC - Admin Console</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/static/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/static/css/styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
      body { 
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0b1220 100%);
        color: #e5e7eb;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      .admin-navbar {
        background: rgba(30, 32, 40, 0.95) !important;
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #35385a;
        min-height: 60px;
      }
      .admin-navbar .navbar-brand { 
        color: #fff !important; 
        font-weight: 600; 
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      .admin-navbar .btn-link { 
        color: #9aa0b4 !important; 
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      .admin-navbar .btn-link:hover { color: #c7cbe2 !important; }
      .admin-navbar .navbar-nav > li > span {
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      
      .admin-container { margin-top: 80px; padding: 2rem 0; }
      .search-card {
        background: #1e2028;
        border: 1px solid #35385a;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      }
      .search-input {
        background: #11131a;
        border: 1px solid #2a2d45;
        color: #e5e7eb;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
      }
      .search-input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102,126,234,0.25);
        outline: none;
      }
      .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        color: #fff;
        transition: all 0.2s;
      }
      .btn-gradient:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        color: #fff;
      }
      .btn-secondary {
        background: #35385a;
        border: 1px solid #4a4f7a;
        color: #e5e7eb;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s;
      }
      .btn-secondary:hover {
        background: #4a4f7a;
        color: #fff;
      }
      
      .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
      }
      .result-card {
        background: #1e2028;
        border: 1px solid #35385a;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
      }
      .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #2a2d45;
      }
      .result-title { font-size: 1.25rem; font-weight: 600; color: #fff; margin: 0; }
      .result-subtitle { color: #9aa0b4; font-size: 0.9rem; }
      .action-buttons { display: flex; gap: 0.5rem; flex-wrap: wrap; }
      .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin: 1rem 0;
      }
      .info-item {
        background: #11131a;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #2a2d45;
      }
      .info-label { color: #9aa0b4; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.25rem; }
      .info-value { color: #e5e7eb; font-weight: 500; }
      .status-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
      }
      .status-active { background: #10b981; color: #fff; }
      .status-inactive { background: #ef4444; color: #fff; }
      .status-pending { background: #f59e0b; color: #fff; }
      .loading { text-align: center; padding: 2rem; color: #9aa0b4; }
      .error { background: #dc2626; color: #fff; padding: 1rem; border-radius: 8px; margin: 1rem 0; }
      .success { background: #059669; color: #fff; padding: 1rem; border-radius: 8px; margin: 1rem 0; }
      .search-tabs { margin-bottom: 1.5rem; }
      .search-tabs .nav-tabs { border-bottom: 1px solid #2a2d45; }
      .search-tabs .nav-tabs > li > a {
        background: transparent;
        border: none;
        color: #9aa0b4;
        border-radius: 8px 8px 0 0;
        margin-right: 0.5rem;
        padding: 0.75rem 1.5rem;
      }
      .search-tabs .nav-tabs > li.active > a,
      .search-tabs .nav-tabs > li > a:hover {
        background: #667eea;
        color: #fff;
        border: none;
      }
      .search-tabs .tab-content { padding-top: 1rem; }
      
      .input-group-btn .btn {
        border-radius: 0 8px 8px 0;
        border-left: none;
      }
      
      .input-group .form-control {
        border-radius: 8px 0 0 8px;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-default navbar-fixed-top admin-navbar">
      <div class="container-fluid">
        <div class="navbar-header">
          <a class="navbar-brand" href="/admin/console">
            <img src="/static/images/dispatch-logo-512.png" style="width:32px; height:32px; margin-right:10px; border-radius:8px;" />
            LPC Admin Console
          </a>
        </div>
        <div class="navbar-collapse collapse">
          <ul class="nav navbar-nav navbar-right">
            <li>
              <span style="color: #9aa0b4;">
                <i class="fas fa-user" style="margin-right: 8px;"></i>
                <%= admin && admin.email ? admin.email : 'Admin' %>
              </span>
            </li>
            <li>
              <form action="/admin/logout" method="post" style="display:inline;">
                <button type="submit" class="btn btn-link">
                  <i class="fas fa-sign-out-alt" style="margin-right: 8px;"></i>Logout
                </button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container admin-container">
      <div class="search-card">
        <h2 style="margin-bottom: 1.5rem; color: #fff; font-weight: 700;">
          <i class="fas fa-search" style="margin-right: 12px; color: #667eea;"></i>
          Admin Search & Management
        </h2>
        
        <div class="admin-actions" style="margin-bottom: 1.5rem; text-align: right;">
          <button class="btn btn-gradient" onclick="showAddAdminModal()">
            <i class="fas fa-plus" style="margin-right: 8px;"></i>Add Admin
          </button>
        </div>
        
        <div class="search-tabs">
          <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" class="active">
              <a href="#users-tab" data-toggle="tab">
                <i class="fas fa-users" style="margin-right: 8px;"></i>Users
              </a>
            </li>
            <li role="presentation">
              <a href="#communities-tab" data-toggle="tab">
                <i class="fas fa-building" style="margin-right: 8px;"></i>Communities
              </a>
            </li>
          </ul>
          
          <div class="tab-content">
            <!-- Users Tab -->
            <div role="tabpanel" class="tab-pane active" id="users-tab">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="userSearch" class="form-control search-input" 
                         placeholder="Search users by email or username..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchUsersBtn" class="btn btn-gradient btn-block">
                    <i class="fas fa-search" style="margin-right: 8px;"></i>Search Users
                  </button>
                </div>
              </div>
              <div id="userResults"></div>
            </div>
            
            <!-- Communities Tab -->
            <div role="tabpanel" class="tab-pane" id="communities-tab">
              <div class="row">
                <div class="col-md-8">
                  <input type="text" id="communitySearch" class="form-control search-input" 
                         placeholder="Search communities by name..." />
                </div>
                <div class="col-md-4">
                  <button type="button" id="searchCommunitiesBtn" class="btn btn-gradient btn-block">
                    <i class="fas fa-search" style="margin-right: 8px;"></i>Search Communities
                  </button>
                </div>
              </div>
              <div id="communityResults"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- User Details Modal -->
    <div class="modal fade" id="userModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="userModalTitle">User Details</h4>
          </div>
          <div class="modal-body" id="userModalBody">
            <!-- User details will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Community Details Modal -->
    <div class="modal fade" id="communityModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="communityModalTitle">Community Details</h4>
          </div>
          <div class="modal-body" id="communityModalBody">
            <!-- Community details will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="confirmModalTitle">Confirm Action</h4>
          </div>
          <div class="modal-body" id="confirmModalBody">
            <!-- Confirmation message will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-gradient" id="confirmModalBtn">Confirm</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Success/Info Modal -->
    <div class="modal fade" id="infoModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title" id="infoModalTitle">Information</h4>
          </div>
          <div class="modal-body" id="infoModalBody">
            <!-- Info message will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-gradient" data-dismiss="modal">OK</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Add Admin Modal -->
    <div class="modal fade" id="addAdminModal" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title">Add New Admin</h4>
          </div>
          <div class="modal-body">
            <div class="form-group">
              <label for="newAdminEmail" style="color: #e5e7eb; margin-bottom: 0.5rem;">Email Address</label>
              <input type="email" id="newAdminEmail" class="form-control" 
                     placeholder="Enter email address" 
                     style="background: #11131a; border: 1px solid #2a2d45; color: #e5e7eb;">
            </div>
            <div class="form-group">
              <label for="adminRole" style="color: #e5e7eb; margin-bottom: 0.5rem;">Admin Role</label>
              <select id="adminRole" class="form-control" 
                      style="background: #11131a; border: 1px solid #2a2d45; color: #e5e7eb;">
                <option value="admin">Admin</option>
                <option value="owner">Owner</option>
              </select>
            </div>
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-gradient" onclick="addNewAdmin()">
              <i class="fas fa-plus" style="margin-right: 8px;"></i>Add Admin
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Reset Link Modal -->
    <div class="modal fade" id="adminResetLinkModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: #1e2028; border: 1px solid #35385a; color: #e5e7eb;">
          <div class="modal-header" style="border-bottom: 1px solid #2a2d45;">
            <button type="button" class="close" data-dismiss="modal" style="color: #9aa0b4;">
              <span>&times;</span>
            </button>
            <h4 class="modal-title">Admin Account Created</h4>
          </div>
          <div class="modal-body" id="adminResetLinkBody">
            <!-- Reset link and options will be loaded here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid #2a2d45;">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <script src="/static/js/jquery.min.js"></script>
    <script src="/static/js/bootstrap.min.js"></script>
    <script>
      // Global API configuration
      const API_BASE = '<%= process.env.POLICE_CAD_API_URL || "/api" %>';
      const API_TOKEN = '<%= process.env.POLICE_CAD_API_TOKEN || "" %>';
      
      // Modal helper functions
      function showConfirmModal(title, message, onConfirm) {
        $('#confirmModalTitle').text(title);
        $('#confirmModalBody').html(message);
        $('#confirmModalBtn').off('click').on('click', function() {
          onConfirm();
          $('#confirmModal').modal('hide');
        });
        $('#confirmModal').modal('show');
      }
      
      function showInfoModal(title, message) {
        $('#infoModalTitle').text(title);
        $('#infoModalBody').html(message);
        $('#infoModal').modal('show');
      }
      
      function copyToClipboard(text, event) {
        if (navigator.clipboard && window.isSecureContext) {
          // Use modern clipboard API
          navigator.clipboard.writeText(text).then(function() {
            // Show success feedback
            const button = event.target.closest('button');
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-check"></i> Copied!';
            button.style.background = '#10b981';
            button.style.borderColor = '#10b981';
            
            setTimeout(() => {
              button.innerHTML = originalText;
              button.style.background = '#4f46e5';
              button.style.borderColor = '#4f46e5';
            }, 2000);
          }).catch(function(err) {
            console.error('Failed to copy: ', err);
            fallbackCopyToClipboard(text, event);
          });
        } else {
          // Fallback for older browsers
          fallbackCopyToClipboard(text, event);
        }
      }
      
      function fallbackCopyToClipboard(text, event) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        
        try {
          document.execCommand('copy');
          // Show success feedback
          const button = event.target.closest('button');
          const originalText = button.innerHTML;
          button.innerHTML = '<i class="fas fa-check"></i> Copied!';
          button.style.background = '#10b981';
          button.style.borderColor = '#10b981';
          
          setTimeout(() => {
            button.innerHTML = originalText;
            button.style.background = '#4f46e5';
            button.style.borderColor = '#4f46e5';
          }, 2000);
        } catch (err) {
          console.error('Fallback copy failed: ', err);
        }
        
        document.body.removeChild(textArea);
      }
      
      // Search Users
      $('#searchUsersBtn').click(function() {
        const query = $('#userSearch').val().trim();
        if (!query) {
          showInfoModal('Search Required', 'Please enter a search term to find users.');
          return;
        }
        searchUsers(query);
      });
      
      $('#userSearch').keypress(function(e) {
        if (e.which === 13) {
          $('#searchUsersBtn').click();
        }
      });
      
      function searchUsers(query) {
        $('#userResults').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Searching users...</div>');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/search/users`,
          method: 'POST',
          headers: { 'Authorization': API_TOKEN },
          data: JSON.stringify({ query: query }),
          contentType: 'application/json',
          success: function(data) {
            displayUserResults(data.users || []);
          },
          error: function(xhr) {
            $('#userResults').html('<div class="loading">No users found</div>');
            showInfoModal('Search Error', `Error searching users: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }
      
      function displayUserResults(users) {
        if (users.length === 0) {
          $('#userResults').html('<div class="loading">No users found</div>');
          return;
        }
        
        let html = '';
        users.forEach(user => {
          html += `
            <div class="result-card">
              <div class="result-header">
                <div>
                  <h5 class="result-title">${user.email || 'No Email'}</h5>
                  <p class="result-subtitle">Username: ${user.username || 'No Username'} | ID: ${user.id}</p>
                </div>
                <div class="action-buttons">
                  <button class="btn btn-secondary btn-sm" onclick="viewUserDetails('${user.id}')">
                    <i class="fas fa-eye"></i> View Details
                  </button>
                  <button class="btn btn-secondary btn-sm" onclick="sendUserReset('${user.email}')">
                    <i class="fas fa-key"></i> Reset Password
                  </button>
                  <button class="btn btn-secondary btn-sm" onclick="createTempPassword('${user.id}')">
                    <i class="fas fa-temp-password"></i> Temp Password
                  </button>
                </div>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <div class="info-label">Status</div>
                  <div class="info-value">
                    <span class="status-badge ${user.active ? 'status-active' : 'status-inactive'}">
                      ${user.active ? 'Active' : 'Inactive'}
                    </span>
                  </div>
                </div>
                <div class="info-item">
                  <div class="info-label">Created</div>
                  <div class="info-value">${new Date(user.createdAt).toLocaleDateString()}</div>
                </div>
                <div class="info-item">
                  <div class="info-label">Password Reset Status</div>
                  <div class="info-value">${user.resetPasswordExpires ? 'Reset requested on ' + new Date(user.resetPasswordExpires).toLocaleDateString() : 'No reset requested'}</div>
                </div>
              </div>
            </div>
          `;
        });
        $('#userResults').html(html);
      }
      
      // Search Communities
      $('#searchCommunitiesBtn').click(function() {
        const query = $('#communitySearch').val().trim();
        if (!query) {
          showInfoModal('Search Required', 'Please enter a search term to find communities.');
          return;
        }
        searchCommunities(query);
      });
      
      $('#communitySearch').keypress(function(e) {
        if (e.which === 13) {
          $('#searchCommunitiesBtn').click();
        }
      });
      
      function searchCommunities(query) {
        $('#communityResults').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Searching communities...</div>');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/search/communities`,
          method: 'POST',
          headers: { 'Authorization': API_TOKEN },
          data: JSON.stringify({ query: query }),
          contentType: 'application/json',
          success: function(data) {
            displayCommunityResults(data.communities || []);
          },
          error: function(xhr) {
            $('#communityResults').html('<div class="loading">No communities found</div>');
            showInfoModal('Search Error', `Error searching communities: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }
      
      function displayCommunityResults(communities) {
        if (communities.length === 0) {
          $('#communityResults').html('<div class="loading">No communities found</div>');
          return;
        }
        
        let html = '';
        communities.forEach(community => {
          html += `
            <div class="result-card">
              <div class="result-header">
                <div>
                  <h5 class="result-title">${community.name || 'Unnamed Community'}</h5>
                  <p class="result-subtitle">ID: ${community.id}</p>
                </div>
                <div class="action-buttons">
                  <button class="btn btn-secondary btn-sm" onclick="viewCommunityDetails('${community.id}')">
                    <i class="eye"></i> View Details
                  </button>
                  <button class="btn btn-secondary btn-sm" onclick="viewCommunityMembers('${community.id}')">
                    <i class="fas fa-users"></i> Members
                  </button>
                  <button class="btn btn-secondary btn-sm" onclick="viewCommunityRoles('${community.id}')">
                    <i class="fas fa-user-tag"></i> Roles
                  </button>
                </div>
              </div>
              <div class="info-grid">
                <div class="info-item">
                  <div class="info-label">Owner</div>
                  <div class="info-value">${community.owner?.email || 'Unknown'}</div>
                </div>
                <div class="info-item">
                  <div class="info-label">Members</div>
                  <div class="info-value">${community.memberCount || 0}</div>
                </div>
                <div class="info-item">
                  <div class="info-label">Status</div>
                  <div class="info-value">
                    <span class="status-badge ${community.active ? 'status-active' : 'status-inactive'}">
                      ${community.active ? 'Active' : 'Inactive'}
                    </span>
                  </div>
                </div>
                <div class="info-item">
                  <div class="info-label">Created</div>
                  <div class="info-value">${new Date(community.createdAt).toLocaleDateString()}</div>
                </div>
              </div>
            </div>
          `;
        });
        $('#communityResults').html(html);
      }
      
      // User Actions
      function viewUserDetails(userId) {
        $('#userModalTitle').text('Loading User Details...');
        $('#userModalBody').html('<div class="loading">Loading...</div>');
        $('#userModal').modal('show');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/users/${userId}`,
          method: 'GET',
          headers: { 'Authorization': API_TOKEN },
          success: function(data) {
            displayUserDetails(data.user);
          },
          error: function(xhr) {
            $('#userModalBody').html(`<div class="error">Error loading user: ${xhr.responseJSON?.error || 'Unknown error'}</div>`);
          }
        });
      }
      
      function displayUserDetails(user) {
        // Convert MongoDB ObjectId to creation date
        const createdAt = user._id ? new Date(parseInt(user._id.toString().substring(0, 8), 16) * 1000) : new Date(user.createdAt);
        
        // Handle password reset status
        let resetStatus = 'No reset requested';
        if (user.resetPasswordExpires) {
          const resetDate = new Date(user.resetPasswordExpires);
          const now = new Date();
          if (resetDate > now) {
            resetStatus = `Reset requested on ${resetDate.toLocaleDateString()} (expires ${resetDate.toLocaleString()})`;
          } else {
            resetStatus = `Reset requested on ${resetDate.toLocaleDateString()} (EXPIRED)`;
          }
        }
        
        $('#userModalTitle').text(`User: ${user.email || user.username}`);
        $('#userModalBody').html(`
          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Email</div>
              <div class="info-value">${user.email || 'N/A'}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Username</div>
              <div class="info-value">${user.username || 'N/A'}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Status</div>
              <div class="info-value">
                <span class="status-badge ${user.active ? 'status-active' : 'status-inactive'}">
                  ${user.active ? 'Active' : 'Inactive'}
                </span>
              </div>
            </div>
            <div class="info-item">
              <div class="info-label">Created</div>
              <div class="info-value">${createdAt.toLocaleDateString()}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Password Reset Status</div>
              <div class="info-value">${resetStatus}</div>
            </div>
            <div class="info-item">
              <div class="info-label">Communities</div>
              <div class="info-value">${user.communities?.length || 0}</div>
            </div>
          </div>
          
          <div style="margin-top: 2rem;">
            <h5>Communities</h5>
            ${user.communities && user.communities.length > 0 ? user.communities.map(c => `
              <div style="background: #11131a; padding: 1rem; border-radius: 8px; margin: 0.5rem 0; border: 1px solid #2a2d45;">
                <strong>${c.name}</strong> - ${c.role || 'Member'}
                ${c.department ? `<br><small>Department: ${c.department}</small>` : ''}
              </div>
            `).join('') : '<p>No communities</p>'}
          </div>
        `);
      }
      
      function sendUserReset(userEmail) {
        showConfirmModal(
          'Send Password Reset',
          `Are you sure you want to send a password reset email to <strong>${userEmail}</strong>?`,
          function() {
            // Find and update the button to show loading state
            const resetButton = $(`button[onclick*="sendUserReset('${userEmail}')"]`);
            const originalText = resetButton.html();
            resetButton.html('<i class="fas fa-spinner fa-spin"></i> Sending...');
            resetButton.prop('disabled', true);
            
            $.ajax({
              url: '/forgot-password',
              method: 'POST',
              data: { email: userEmail },
              success: function(data) {
                showInfoModal('Success', 'Password reset email sent successfully to the user.');
              },
              error: function(xhr) {
                showInfoModal('Error', `Failed to send password reset email: ${xhr.responseText || 'Unknown error'}`);
              },
              complete: function() {
                // Restore button to original state
                resetButton.html(originalText);
                resetButton.prop('disabled', false);
              }
            });
          }
        );
      }
      
      function createTempPassword(userId) {
        showConfirmModal(
          'Create Temporary Password',
          'Are you sure you want to create a temporary password for this user? This will replace their current password.',
          function() {
            // Find and update the button to show loading state
            const tempButton = $(`button[onclick*="createTempPassword('${userId}')"]`);
            const originalText = tempButton.html();
            tempButton.html('<i class="fas fa-spinner fa-spin"></i> Creating...');
            tempButton.prop('disabled', true);
            
            // Store button reference for use in callbacks
            const buttonRef = tempButton;
            const textRef = originalText;
            
            $.ajax({
              url: `${API_BASE}/api/v1/admin/users/${userId}/temp-password`,
              method: 'POST',
              headers: { 'Authorization': API_TOKEN },
              success: function(data) {
                const expiresAt = data.expiresAt ? new Date(data.expiresAt).toLocaleString() : new Date(Date.now() + 24 * 60 * 60 * 1000).toLocaleString();
                showInfoModal(
                  'Temporary Password Created', 
                  `Temporary password created successfully!<br><br><strong>Password:</strong> ${data.tempPassword} <button class="btn btn-sm" onclick="copyToClipboard('${data.tempPassword}', event)" style="margin-left: 8px; padding: 4px 12px; font-size: 12px; background: #4f46e5; color: white; border: 1px solid #4f46e5; border-radius: 6px;"><i class="fas fa-copy"></i> Copy</button><br><strong>Expires:</strong> ${expiresAt}`
                );
              },
              error: function(xhr) {
                showInfoModal('Error', `Failed to create temporary password: ${xhr.responseJSON?.error || 'Unknown error'}`);
              },
              complete: function() {
                // Restore button to original state
                buttonRef.html(textRef);
                buttonRef.prop('disabled', false);
              }
            });
          }
        );
      }
      
