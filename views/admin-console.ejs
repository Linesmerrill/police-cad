                const fullName = `${community.owner.username} (${community.owner.email})`;
                return fullName.length > 50 ? fullName.substring(0, 47) + '...' : fullName;
              } else if (community.owner.username) {
                return community.owner.username.length > 50 ? community.owner.username.substring(0, 47) + '...' : community.owner.username;
              } else if (community.owner.email) {
                return community.owner.email.length > 50 ? community.owner.email.substring(0, 47) + '...' : community.owner.email;
              }
            }
            return 'Unknown';
          })();
          
          // Get owner ID
          const ownerId = community.owner?.id || community.owner?._id || 'Unknown';
          
          // Count roles
          const roleCount = community.rolesCount || 0;
          
          // Format created date with time
          const createdAt = community.createdAt ? (() => {
            const date = new Date(community.createdAt);
            return date.toLocaleDateString() + ' ' + date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
          })() : 'Unknown';
          
          html += `
