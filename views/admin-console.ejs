        </div>

        <!-- Panel: Subscriptions (user-centric dashboard) -->
        <style> goes inside (or just above) that panel; classes are subs-* scoped
               - <script> replaces the existing initSubscriptionsPanel implementation
               ======================================================================= -->


          <!-- ===================== HTML BLOCK ===================== -->
        <style>
            /* ========== Subscriptions panel — financial-terminal aesthetic ========== */
            /* styles.css ships landing-page rules that pad EVERY
               <section> (padding:100px 0; min-height:600px @≥768px) and
               <aside> (padding:50px 0) globally. That's what was
               creating 100+px dead zones around our cards and the
               sidebar. Override here so semantic elements rendered
               inside the subscriptions panel start from zero — the
               specific .subs-* classes can then apply real padding
               where they want it. */
            #panel-subscriptions section,
            #panel-subscriptions aside {
              min-height: 0 !important;
              padding: 0 !important;
            }

            #panel-subscriptions {
              --subs-warn: #f59e0b;
              --subs-warn-strong: #fbbf24;
              --subs-warn-bg: rgba(245, 158, 11, 0.08);
              --subs-warn-border: rgba(245, 158, 11, 0.32);
              --subs-ok: var(--ac-green, #10b981);
              --subs-err: #f87171;
              --subs-rule: rgba(255, 255, 255, 0.06);
              --subs-rule-strong: rgba(255, 255, 255, 0.1);
              --subs-mono: ui-monospace, "SFMono-Regular", "JetBrains Mono", Menlo, Consolas, monospace;
            }

            .subs-shell {
              display: flex;
              flex-direction: column;
              gap: 1rem;
              min-height: 600px;
            }

            /* ----- Sticky search bar -----
               Transparent by default so it doesn't paint a darker rectangle
               around the rounded search input. We only paint a backdrop
               when the bar has actually scrolled away from its anchor — a
               tiny shadow + blur make text underneath legible without the
               flat "dark square behind the bar" artifact.                  */
            .subs-search {
              position: sticky;
              top: 0;
              z-index: 2;
              padding: 0.25rem 0 0.5rem;
              background: transparent;
              transition: background 0.15s ease, box-shadow 0.15s ease;
            }
            .subs-search.is-stuck {
              background: rgba(8, 9, 12, 0.72);
              backdrop-filter: blur(10px) saturate(140%);
              -webkit-backdrop-filter: blur(10px) saturate(140%);
              box-shadow: 0 6px 18px -12px rgba(0, 0, 0, 0.6);
            }

            .subs-search-bar {
              display: flex;
              align-items: center;
              gap: 0.625rem;
              background: var(--ac-glass);
              border: 1px solid var(--ac-glass-border);
              border-radius: 12px;
              padding: 0 1rem;
              height: 52px;
              transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.2s ease;
            }

            .subs-search-bar:focus-within {
              border-color: rgba(139, 92, 246, 0.5);
              background: var(--ac-glass-hover);
              box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.08);
            }

            .subs-search-icon { color: var(--ac-text-dim); font-size: 0.9rem; }

            .subs-search-input {
              flex: 1;
              background: transparent;
              border: 0;
              outline: 0;
              color: var(--ac-text);
              font-size: 0.95rem;
              font-family: inherit;
              letter-spacing: -0.005em;
            }
            .subs-search-input::placeholder { color: var(--ac-text-dim); }

            .subs-search-kbd {
              font-family: var(--subs-mono);
              font-size: 0.6875rem;
              color: var(--ac-text-dim);
              padding: 2px 6px;
              border: 1px solid var(--subs-rule-strong);
              border-radius: 4px;
              letter-spacing: 0.04em;
            }

            /* ----- Two-column layout ----- */
            .subs-layout {
              display: grid;
              grid-template-columns: minmax(280px, 340px) 1fr;
              gap: 1rem;
              align-items: start;
            }
            @media (max-width: 1099px) {
              .subs-layout { grid-template-columns: 1fr; }
            }

            /* ----- Results sidebar -----
               align-self: start so the sidebar hugs its own content and
               doesn't get stretched to match the (much taller) detail
               pane's row track. max-height + internal scroll still kicks
               in for long lists, but a single-row result no longer leaves
               a half-screen of dead space underneath.                     */
            .subs-sidebar {
              align-self: start;
              background: var(--ac-glass);
              border: 1px solid var(--ac-glass-border);
              border-radius: var(--ac-radius, 12px);
              overflow: hidden;
              position: sticky;
              top: 76px;
              max-height: calc(100vh - 100px);
              display: flex;
              flex-direction: column;
            }

            .subs-sidebar-head {
              display: flex;
              justify-content: space-between;
              align-items: baseline;
              padding: 0.875rem 1rem;
              border-bottom: 1px solid var(--subs-rule);
            }

            .subs-section-label {
              font-size: 0.6875rem;
              font-weight: 700;
              letter-spacing: 0.14em;
              text-transform: uppercase;
              color: var(--ac-text-muted);
            }

            .subs-section-count {
              font-size: 0.6875rem;
              color: var(--ac-text-dim);
              font-variant-numeric: tabular-nums;
              font-family: var(--subs-mono);
            }

            .subs-results {
              overflow-y: auto;
            }

            .subs-result {
              display: block;
              padding: 0.75rem 1rem;
              border-left: 2px solid transparent;
              cursor: pointer;
              transition: background 0.12s ease, border-color 0.12s ease;
              position: relative;
            }
            .subs-result + .subs-result { border-top: 1px solid var(--subs-rule); }
            .subs-result:hover { background: var(--ac-glass-hover); }
            .subs-result.is-active {
              background: var(--ac-glass-hover);
              border-left-color: var(--ac-accent, #8b5cf6);
            }

            .subs-result-row1 {
              display: flex;
              align-items: center;
              gap: 0.5rem;
              font-size: 0.875rem;
            }
            .subs-result-email {
              font-weight: 500;
              color: var(--ac-text);
              white-space: nowrap;
              overflow: hidden;
              text-overflow: ellipsis;
              flex: 1;
              letter-spacing: -0.005em;
            }
            .subs-result-row2 {
              display: flex;
              align-items: center;
              gap: 0.5rem;
              margin-top: 0.375rem;
              font-size: 0.6875rem;
              color: var(--ac-text-muted);
            }
            .subs-result-dot {
              width: 3px; height: 3px; border-radius: 50%;
              background: var(--ac-text-dim); display: inline-block;
            }
            .subs-result-ago {
              margin-left: auto;
              font-variant-numeric: tabular-nums;
              font-family: var(--subs-mono);
              color: var(--ac-text-dim);
              letter-spacing: 0.02em;
            }

            /* ----- Reusable pills ----- */
            .subs-pill {
              display: inline-flex;
              align-items: center;
              gap: 0.3rem;
              padding: 2px 7px;
              border-radius: 4px;
              font-size: 0.625rem;
              font-weight: 700;
              letter-spacing: 0.06em;
              text-transform: uppercase;
              background: rgba(255, 255, 255, 0.04);
              color: var(--ac-text-muted);
              border: 1px solid var(--subs-rule);
              font-family: var(--subs-mono);
            }
            .subs-pill--active {
              background: rgba(16, 185, 129, 0.12);
              color: var(--subs-ok);
              border-color: rgba(16, 185, 129, 0.3);
            }
            .subs-pill--inactive { color: var(--ac-text-dim); }
            .subs-pill--free { color: var(--ac-text-dim); }
            .subs-pill--premium {
              color: #c084fc;
              border-color: rgba(192, 132, 252, 0.3);
              background: rgba(192, 132, 252, 0.08);
            }
            .subs-pill--premium_plus {
              color: #e879f9;
              border-color: rgba(232, 121, 249, 0.3);
              background: rgba(232, 121, 249, 0.08);
            }
            .subs-pill--base {
              color: #60a5fa;
              border-color: rgba(96, 165, 250, 0.3);
              background: rgba(96, 165, 250, 0.08);
            }

            /* ----- Detail pane shell ----- */
            .subs-detail {
              background: var(--ac-glass);
              border: 1px solid var(--ac-glass-border);
              border-radius: var(--ac-radius, 12px);
              position: relative;
            }
            /* Only the empty / loading / error placeholders need the
               520px tall pane — when real content renders, the card hugs
               its content so we don't leave a giant dead zone below. */
            .subs-detail:has(.subs-detail-state) { min-height: 520px; }

            .subs-detail-state {
              display: flex;
              flex-direction: column;
              align-items: center;
              justify-content: center;
              padding: 4rem 2rem;
              min-height: 520px;
              text-align: center;
            }

            .subs-empty-icon {
              width: 64px; height: 64px; border-radius: 50%;
              display: grid; place-items: center;
              background: var(--ac-glass-hover);
              border: 1px solid var(--subs-rule);
              color: var(--ac-text-dim);
              font-size: 1.5rem;
              margin-bottom: 1rem;
            }
