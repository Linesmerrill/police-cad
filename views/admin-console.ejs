      function searchUsers(query, page = 0) {
        $('#userResults').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Searching users...</div>');
        
        // Track search activity
        trackAdminAction('user_search', `Searched for users with query: "${query}"`);
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/search/users`,
          method: 'POST',
          data: JSON.stringify({ 
            query: query,
            page: page,
            limit: resultsPerPage
          }),
          contentType: 'application/json',
          success: function(data) {
            if (data.users && data.pagination) {
              // Store pagination info
              currentUserPage = data.pagination.currentPage || 0;
              totalUserPages = data.pagination.totalPages || 1;
              totalUserRecords = data.pagination.totalRecords || 0;
              
              displayUserResultsPage(data.users, currentUserPage, totalUserRecords, totalUserPages);
            } else {
              // Fallback for old backend response
              displayUserResults(data.users || []);
            }
            // Log the user search action
            logAdminAction('user_search', 'User search performed', `Searched for users with query: "${query}"`);
          },
          error: function(xhr) {
            $('#userResults').html('<div class="loading">No users found</div>');
            showInfoModal('Search Error', `Error searching users: ${xhr.responseJSON?.error || 'Unknown error'}`);
          }
        });
      }
      
      function displayUserResults(users) {
