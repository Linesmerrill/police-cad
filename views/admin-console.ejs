        const normalizedQuery = query.trim().toLowerCase();
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/search/users`,
          method: 'POST',
          data: JSON.stringify({ 
            query: normalizedQuery,
            page: page,
            limit: resultsPerPage
          }),
          contentType: 'application/json',
          success: function(data) {
            if (data.users && data.pagination && data.users.length > 0) {
              // Store pagination info
              currentUserPage = data.pagination.currentPage || 0;
              totalUserPages = data.pagination.totalPages || 1;
              totalUserRecords = data.pagination.totalRecords || 0;
              
              displayUserResultsPage(data.users, currentUserPage, totalUserRecords, totalUserPages);
            } else if (data.users && data.users.length > 0) {
              // Fallback for old backend response
              displayUserResults(data.users);
