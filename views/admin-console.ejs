      function getActivityIcon(type) {
        const icons = {
          'login': '<i class="fas fa-sign-in-alt text-success"></i>',
          'logout': '<i class="fas fa-sign-out-alt text-warning"></i>',
          'password_reset': '<i class="fas fa-key text-info"></i>',
          'password_reset_initiated': '<i class="fas fa-envelope text-info"></i>',
          'role_change': '<i class="fas fa-user-edit text-primary"></i>',
          'admin_action': '<i class="fas fa-cog" style="color: #667eea;"></i>',
          'user_reset_initiated': '<i class="fas fa-envelope text-info"></i>',
          'user_search': '<i class="fas fa-search" style="color: #8b5cf6;"></i>',
          'community_search': '<i class="fas fa-search" style="color: #8b5cf6;"></i>',
          'user_reactivate': '<i class="fas fa-user-check text-success"></i>',
          'admin_creation': '<i class="fas fa-user-plus text-primary"></i>',
          'admin_deletion': '<i class="fas fa-user-minus text-danger"></i>',
          'admin_reset_existing': '<i class="fas fa-envelope text-info"></i>',
          'admin_reset_email': '<i class="fas fa-envelope text-info"></i>'
        };
        return icons[type] || '<i class="fas fa-circle text-muted"></i>';
      }
      
      function getTimeAgo(timestamp) {
        const now = new Date();
        const time = new Date(timestamp);
        const diffMs = now - time;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMs / 3600000);
        const diffDays = Math.floor(diffMs / 86400000);
        
        if (diffMins < 1) return 'Just now';
        if (diffMins < 60) return `${diffMins}m ago`;
        if (diffHours < 24) return `${diffHours}h ago`;
        if (diffDays < 7) return `${diffDays}d ago`;
        return time.toLocaleDateString();
      }
      
      function renderActivityChart(activity) {
        // Timeline data comes from activity.timeline according to backend spec
        // Format: [{ date: "2025-12-17", count: 5 }, ...]
        const timeline = activity.timeline || [];
        
        if (!timeline || timeline.length === 0) {
          $('#activityChart').html(`
            <div class="text-center" style="padding: 2rem; color: #9aa0b4;">
              <i class="fas fa-chart-line" style="font-size: 2rem; margin-bottom: 1rem;"></i>
              <p>No chart data available</p>
            </div>
          `);
          return;
        }
        
        // Check if all values are 0 (no activity)
        const hasAnyActivity = timeline.some(day => day.count > 0);
        
        if (!hasAnyActivity) {
          $('#activityChart').html(`
            <div class="text-center" style="padding: 2rem; color: #9aa0b4;">
              <i class="fas fa-chart-line" style="font-size: 2rem; margin-bottom: 1rem;"></i>
              <p>No activity recorded for this timeframe</p>
            </div>
          `);
          return;
        }
        
        // Find max count for scaling
        const maxCount = Math.max(...timeline.map(day => day.count || 0), 1);
        
        const chartHtml = `
          <div class="chart-container">
            <div class="chart-bars">
              ${timeline.map(day => {
                const count = day.count || 0;
                const height = maxCount > 0 ? (count / maxCount) * 200 : 0; // Max height 200px
                return count > 0 ? `
                  <div class="chart-bar" style="height: ${height}px;" title="${day.date}: ${count} activities">
                    <div class="bar-label">${day.date}</div>
                  </div>
                ` : `
                  <div class="chart-bar chart-bar-empty" title="${day.date}: ${count} activities">
                    <div class="bar-label">${day.date}</div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
        
        $('#activityChart').html(chartHtml);
      }
      
      function filterActivity(timeframe) {
        // Update active filter button
        $('.timeline-filters .btn').removeClass('active');
        $(`.timeline-filters .btn[data-timeframe="${timeframe}"]`).addClass('active');
        
        // Reset pagination to first page when changing timeframe
        currentActivityPage = 1;
        
        // Call backend with new timeframe
        const adminId = $('#adminDetailsModal').data('currentAdminId');
        if (adminId) {
          viewAdminActivityWithTimeframe(adminId, timeframe, currentActivityPage, activityPageSize);
        }
      }
      
      function viewAdminActivityWithTimeframe(adminId, timeframe, page = 1, limit = 10) {
        // Show loading state for individual components instead of entire modal
        $('#activityMetrics').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading...</div>');
        $('#activityChart').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading chart...</div>');
        $('#activityList').html('<div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading activities...</div>');
        
        $.ajax({
          url: `${API_BASE}/api/v1/admin/admins/${adminId}/activity`,
          method: 'POST',
          data: JSON.stringify({
            currentUser: {
              email: currentUserEmail,
              roles: roles
            },
            timeframe: timeframe,
            page: page,
            limit: limit
          }),
          contentType: 'application/json',
          success: function(data) {
            if (data.activity) {
              // Extract pagination info from backend response
              if (data.activity.pagination) {
                currentActivityPage = data.activity.pagination.currentPage || 1;
                totalActivityPages = data.activity.pagination.totalPages || 1;
                totalActivityRecords = data.activity.pagination.totalRecords || 0;
                activityPageSize = data.activity.pagination.limit || 5;
              }
              
