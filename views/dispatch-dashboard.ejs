  <style>
    /* Signal 100 Banner - Modern Mobile-Friendly Design */
    #fixed-alert-banners {
      position: fixed;
      top: 60px;
      left: 300px;
      right: 0;
      z-index: 8;
      transition: left 0.3s;
    }
    #fixed-alert-banners.sidebar-collapsed {
      left: 0;
    }
    @media (max-width: 991.98px) {
      #fixed-alert-banners {
        left: 0;
      }
      #fixed-alert-banners.sidebar-collapsed {
        left: 300px;
      }
    }
    .signal-100-banner {
      background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
      padding: 6px 16px;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(220, 38, 38, 0.4);
      transition: all 0.3s ease;
      animation: signal100Glow 1.5s ease-in-out infinite;
    }
    .signal-100-banner:hover {
      background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
    }
    .signal-100-banner.hide {
      display: none;
    }
    .signal-100-banner.show {
      display: block;
    }
    @keyframes signal100Glow {
      0%, 100% { box-shadow: 0 4px 20px rgba(220, 38, 38, 0.4); }
      50% { box-shadow: 0 4px 30px rgba(220, 38, 38, 0.7); }
    }
    .signal-100-content {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .signal-100-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .signal-100-icon {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }
    .signal-100-icon i {
      font-size: 16px;
      color: #fff;
      z-index: 2;
      position: relative;
    }
    .signal-100-pulse {
      position: absolute;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      animation: signal100Pulse 1s ease-out infinite;
    }
    @keyframes signal100Pulse {
      0% { transform: scale(0.8); opacity: 1; }
      100% { transform: scale(1.8); opacity: 0; }
    }
    .signal-100-text {
      text-align: left;
      flex: 1;
      min-width: 0;
    }
    .signal-100-title {
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      letter-spacing: 1.5px;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    }
    .signal-100-details {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.9);
      margin-top: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .signal-100-tap {
      font-size: 10px;
      color: rgba(255, 255, 255, 0.7);
      text-transform: uppercase;
      letter-spacing: 1px;
      flex-shrink: 0;
      padding: 3px 8px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 4px;
    }
    @media (max-width: 480px) {
      .signal-100-banner {
        padding: 10px 12px;
      }
      .signal-100-content {
        gap: 8px;
      }
      .signal-100-icon {
        width: 28px;
        height: 28px;
      }
      .signal-100-icon i {
        font-size: 18px;
      }
      .signal-100-title {
        font-size: 15px;
        letter-spacing: 1px;
      }
      .signal-100-details {
        font-size: 11px;
      }
      .signal-100-tap {
        font-size: 9px;
        padding: 3px 6px;
      }
    }

    /* Panic Alert Banner */
    .panic-alerts-banner {
      max-height: 125px;
      overflow-y: auto;
      background: linear-gradient(135deg, #ea580c 0%, #9a3412 100%);
      box-shadow: 0 4px 20px rgba(234, 88, 12, 0.4);
      animation: panicGlow 2s ease-in-out infinite;
    }
    .panic-alerts-banner:empty { display: none; }
    .panic-alerts-banner::-webkit-scrollbar { width: 4px; }
    .panic-alerts-banner::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.3); border-radius: 2px; }
    @keyframes panicGlow {
      0%, 100% { box-shadow: 0 4px 20px rgba(234, 88, 12, 0.4); }
      50% { box-shadow: 0 4px 30px rgba(234, 88, 12, 0.7); }
    }
    .panic-alert-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 16px; min-height: 50px;
      border-bottom: 1px solid rgba(255,255,255,0.15);
      animation: panicPulseRow 1.5s ease-in-out infinite;
    }
    .panic-alert-row:last-child { border-bottom: none; }
    @keyframes panicPulseRow { 0%, 100% { opacity: 1; } 50% { opacity: 0.85; } }
    .panic-alert-content { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
    .panic-alert-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; flex-shrink: 0; }
    .panic-alert-icon i { font-size: 18px; color: #fff; z-index: 2; position: relative; }
    .panic-alert-icon .panic-pulse { position: absolute; width: 100%; height: 100%; background: rgba(255,255,255,0.3); border-radius: 50%; animation: panicPulse 1s ease-out infinite; }
    @keyframes panicPulse { 0% { transform: scale(0.8); opacity: 1; } 100% { transform: scale(1.8); opacity: 0; } }
    .panic-alert-text { flex: 1; min-width: 0; }
    .panic-alert-title { font-size: 13px; font-weight: 700; color: #fff; letter-spacing: 1.5px; text-transform: uppercase; }
    .panic-alert-details { font-size: 12px; color: rgba(255,255,255,0.9); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .panic-alert-clear-btn { background: rgba(255,255,255,0.2); border: none; color: #fff; width: 28px; height: 28px; border-radius: 4px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; font-size: 14px; transition: background 0.2s; }
    .panic-alert-clear-btn:hover { background: rgba(255,255,255,0.35); }
    .panic-alert-hide-btn { background: rgba(255,255,255,0.1); border: none; color: rgba(255,255,255,0.6); width: 28px; height: 28px; border-radius: 4px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; font-size: 12px; transition: background 0.2s; }
    .panic-alert-hide-btn:hover { background: rgba(255,255,255,0.2); }
    .panic-scroll-hint { background: #7c2d12; padding: 3px 0; text-align: center; font-size: 10px; color: rgba(255,255,255,0.7); letter-spacing: 0.5px; }
    @media (max-width: 480px) {
      .panic-alert-row { padding: 8px 12px; min-height: 44px; }
      .panic-alert-title { font-size: 11px; }
      .panic-alert-details { font-size: 11px; }
    }

    /* Clear Signal 100 Modal */
    .clear-signal-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.7);
