                                  box-shadow: 0 0 8px rgba(239, 68, 68, 0.6);
                                  animation: blink 1s infinite;
                                }

                                @keyframes blink {
                                  0%, 100% { opacity: 1; }
                                  50% { opacity: 0.3; }
                                }

                                .unit-info {
                                  flex: 1;
                                  min-width: 0;
                                }

                                .unit-callsign {
                                  font-weight: 700;
                                  color: #f1f5f9;
                                  font-size: 1.35rem;
                                }

                                .unit-name {
                                  font-size: 1.1rem;
                                  color: #94a3b8;
                                  white-space: nowrap;
                                  overflow: hidden;
                                  text-overflow: ellipsis;
                                }

                                .unit-departments {
                                  display: flex;
                                  flex-wrap: wrap;
                                  gap: 0.3rem;
                                  margin-top: 0.35rem;
                                  max-height: 3.2rem; /* ~2 lines of badges */
                                  overflow-y: auto;
                                  overflow-x: hidden;
                                  scrollbar-width: thin;
                                  scrollbar-color: rgba(99, 102, 241, 0.4) transparent;
                                }

                                .unit-departments::-webkit-scrollbar {
                                  width: 4px;
                                }

                                .unit-departments::-webkit-scrollbar-track {
                                  background: transparent;
                                }

                                .unit-departments::-webkit-scrollbar-thumb {
                                  background: rgba(99, 102, 241, 0.4);
                                  border-radius: 2px;
                                }

                                .dept-badge {
                                  display: inline-block;
                                  padding: 0.15rem 0.5rem;
                                  border-radius: 4px;
                                  font-size: 0.7rem;
                                  font-weight: 600;
                                  background: rgba(99, 102, 241, 0.2);
                                  color: #818cf8;
                                  border: 1px solid rgba(99, 102, 241, 0.3);
                                  white-space: nowrap;
                                }

                                /* Active department badge - highlighted */
                                .active-dept-badge {
                                  display: inline-block;
                                  padding: 0.15rem 0.5rem;
                                  border-radius: 4px;
                                  font-size: 0.7rem;
                                  font-weight: 700;
                                  background: rgba(16, 185, 129, 0.3);
                                  color: #34d399;
                                  border: 1px solid rgba(16, 185, 129, 0.5);
                                  white-space: nowrap;
                                  box-shadow: 0 0 6px rgba(16, 185, 129, 0.3);
                                }

                                /* Expand button for showing more departments */
                                .dept-expand-btn {
                                  display: inline-block;
                                  padding: 0.1rem 0.4rem;
                                  border-radius: 4px;
                                  font-size: 0.65rem;
                                  font-weight: 600;
                                  background: rgba(71, 85, 105, 0.4);
                                  color: #94a3b8;
                                  border: 1px solid rgba(71, 85, 105, 0.5);
                                  cursor: pointer;
                                  transition: all 0.2s ease;
                                }

                                .dept-expand-btn:hover {
                                  background: rgba(99, 102, 241, 0.3);
                                  color: #a5b4fc;
                                  border-color: rgba(99, 102, 241, 0.5);
                                }

                                .dept-expanded {
                                  display: flex;
                                  flex-wrap: wrap;
                                  gap: 0.3rem;
                                  margin-top: 0.3rem;
                                  padding-top: 0.3rem;
                                  border-top: 1px solid rgba(71, 85, 105, 0.3);
                                }

                                .dept-expanded.hidden {
                                  display: none;
                                }

                                .unit-status-badge {
                                  padding: 0.3rem 0.6rem;
                                  border-radius: 6px;
                                  font-size: 0.75rem;
                                  font-weight: 600;
                                  white-space: nowrap;
                                }

                                .unit-status-badge.online {
                                  background: rgba(16, 185, 129, 0.2);
                                  color: #10b981;
                                }

                                .unit-status-badge.offline {
                                  background: rgba(107, 114, 128, 0.2);
                                  color: #9ca3af;
                                }

                                .unit-status-badge.busy {
                                  background: rgba(245, 158, 11, 0.2);
                                  color: #f59e0b;
                                }

                                .unit-status-badge.emergency {
                                  background: rgba(239, 68, 68, 0.2);
                                  color: #ef4444;
                                }

                                .unit-status-select {
                                  padding: 0.5rem 0.75rem;
                                  border-radius: 6px;
                                  border: 1px solid rgba(71, 85, 105, 0.5);
                                  background: rgba(30, 41, 59, 0.8);
                                  color: #f1f5f9;
                                  font-size: 1.05rem;
                                  cursor: pointer;
                                  outline: none;
                                  min-width: 110px;
                                }

                                .unit-status-select:focus {
                                  border-color: #3b82f6;
                                }

                                .unit-loading {
                                  grid-column: 1 / -1;
                                  display: flex;
                                  align-items: center;
                                  justify-content: center;
                                  gap: 0.75rem;
                                  padding: 2rem;
                                  color: #64748b;
                                }

                                .unit-empty {
                                  grid-column: 1 / -1;
                                  text-align: center;
                                  padding: 2rem;
                                  color: #64748b;
                                }

                                .unit-pagination {
                                  display: none;
                                }

                                .page-btn {
                                  padding: 0.4rem 0.8rem;
                                  border: 1px solid rgba(71, 85, 105, 0.5);
                                  border-radius: 6px;
                                  background: rgba(30, 41, 59, 0.6);
                                  color: #94a3b8;
                                  cursor: pointer;
                                  transition: all 0.2s ease;
                                }

                                .page-btn:hover:not(:disabled) {
                                  background: rgba(59, 130, 246, 0.2);
                                  border-color: rgba(59, 130, 246, 0.5);
                                  color: #60a5fa;
                                }

                                .page-btn.active {
                                  background: #3b82f6;
                                  border-color: #3b82f6;
                                  color: white;
                                }

                                .page-btn:disabled {
                                  opacity: 0.5;
                                  cursor: not-allowed;
                                }

                                @media (max-width: 600px) {
                                  .unit-panel-header {
                                    flex-direction: column;
                                    align-items: flex-start;
                                  }
                                  .unit-controls {
                                    flex-direction: column;
                                  }
                                  .unit-grid {
                                    grid-template-columns: 1fr;
                                  }
                                }
                              </style>

                              <hr style="width: 88%;max-width: 100rem;">
                              
                            <%}%>
          </div>

        </div>
