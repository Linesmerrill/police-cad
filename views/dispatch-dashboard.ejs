            const otherDepts = userDepts.filter(d => d.name !== data.activeDepartmentName);

            let newDeptHtml = `<span class="active-dept-badge">${escapeHtml(data.activeDepartmentName)}</span>`;
            if (otherDepts.length > 0) {
              const otherBadges = otherDepts.map(d => `<span class="dept-badge">${escapeHtml(d.name)}</span>`).join('');
              newDeptHtml += `<span class="dept-expand-btn" onclick="toggleDeptExpand(this, event)" title="View all departments">+${otherDepts.length}</span>`;
              newDeptHtml += `<div class="dept-expanded hidden">${otherBadges}</div>`;
