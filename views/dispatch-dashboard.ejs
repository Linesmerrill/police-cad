    font-size: 14px;
    line-height: 1.4;
  }
  .btn-close-toast {
    background: none;
    border: none;
    color: white;
    font-size: 18px;
    padding: 8px 12px;
    align-self: flex-start;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  .btn-close-toast:hover {
    opacity: 1;
  }
  .btn-close-toast:focus {
    outline: none;
    box-shadow: none;
  }

