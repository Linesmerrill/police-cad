  function signal100(aboutUserId, aboutCallSign, aboutUsername) {
    //if it is already showing we don't want to show it again (there can only be 1 active
    // signal 100 per community)
    if (!$('#signal-100-banner').hasClass('show')) {
      var communityIdForSignal = dbUser.user?.lastAccessedCommunity?.communityID;
      if (!communityIdForSignal) return;

      var dispatchCallSign = getResolvedCallSign(dbUser._id, dbUser.user.callSign) || null;
      var myReq={
        userID: dbUser._id,
        userUsername: dbUser.user.username,
        userCallSign: dispatchCallSign,
        activeCommunity: communityIdForSignal,
        activatedBy: 'Dispatch',
        activatedByCallSign: dispatchCallSign,
        activatedByUsername: dbUser.user.username,
        // If Signal 100 is about a specific user (e.g., officer pressed it for themselves)
        aboutUserId: aboutUserId || null,
        aboutCallSign: aboutCallSign || null,
        aboutUsername: aboutUsername || null,
        timestamp: new Date().toISOString()
      }
      if ($('#panic-button-check-sound').prop('checked')) {
        var audioElement=document.createElement('audio');
        audioElement.setAttribute('src', '/static/audio/Dispatch_signal_100_beep_adj.mp3');
        audioElement.volume = dbUser.user.alertVolumeLevel/100 || 0.1;
        audioElement.play();
      }

      // Persist via Go API, then broadcast via Socket.IO
      $.ajax({
        url: API_URL + '/api/v1/community/' + communityIdForSignal + '/signal-100',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
          userId: dbUser._id,
          username: dbUser.user.username,
          callSign: dispatchCallSign || '',
          departmentName: 'Dispatch'
        }),
        success: function() {
          // Broadcast to other dashboards via Socket.IO
          if (dashboardSocket && dashboardSocket.connected) {
            dashboardSocket.emit('signal_100_button_update', myReq);
          }
        },
        error: function(xhr) {
          console.error('Error activating Signal 100 via API:', xhr.responseText);
          // Still broadcast via Socket.IO as fallback (server handler will retry DB)
          if (dashboardSocket && dashboardSocket.connected) {
            dashboardSocket.emit('signal_100_button_update', myReq);
          }
        }
      });

      // Update local banner immediately
      updateSignal100Banner(myReq);
    }
  }

  // Helper function to update Signal 100 banner with details
  function updateSignal100Banner(data) {
    const $banner = $('#signal-100-banner');
    const $details = $('#signal-100-details');

    // Store the user ID for when we clear the Signal 100
    // Priority: aboutUserId (the officer in distress), then userID (who triggered it)
    signal100UserId = data.aboutUserId || data.userID || null;

    // Build display name matching mobile format: "{callSign} ({department})" or "{username}"
    let activatorDisplay;
    if (data.activatedByCallSign) {
      const detail = data.activatedBy || data.activatedByUsername || '';
      activatorDisplay = detail ? `${data.activatedByCallSign} (${detail})` : data.activatedByCallSign;
    } else {
      activatorDisplay = data.activatedByUsername || data.activatedBy || 'Unknown';
    }

    const message = `Activated by ${activatorDisplay}`;

    // Update the details span
    if ($details.length) {
      $details.text(message);
    }

    // Show the banner
    $banner.removeClass('hide').addClass('show');

    adjustContentOffset();
    renderUnitsGrid();
    updateSignal100ButtonState();
  }

  // Toggle Signal 100 from the dispatch action button
  var _signal100Loading = false;
  function dispatchToggleSignal100() {
    if (_signal100Loading) return;
    var isActive = $('#signal-100-banner').hasClass('show');

    if (isActive) {
      // Clear it
      showClearSignal100Modal();
    } else {
      // Activate it
      _signal100Loading = true;
      $('#signal100ActionBtn').addClass('loading');
      $('#signal100BtnIcon').removeClass('fa-exclamation-triangle').addClass('fa-spinner fa-spin');
      signal100(null, null, null);
      setTimeout(function() {
        _signal100Loading = false;
        $('#signal100ActionBtn').removeClass('loading');
        $('#signal100BtnIcon').removeClass('fa-spinner fa-spin').addClass('fa-exclamation-triangle');
        updateSignal100ButtonState();
      }, 2000);
    }
  }

  // Sync the Signal 100 button state with banner visibility
  function updateSignal100ButtonState() {
    var isActive = $('#signal-100-banner').hasClass('show');
    var $btn = $('#signal100ActionBtn');
    var $text = $('#signal100BtnText');
    if (isActive) {
      $text.text('Clear Signal 100');
      $btn.addClass('active');
    } else {
      $text.text('Signal 100');
      $btn.removeClass('active');
    }
  }

