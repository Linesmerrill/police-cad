  function getResolvedCallSign(userId, globalCallSign) {
    const member = memberDataCache[userId];
    if (member && member.departmentCallSigns && member.activeDepartmentId) {
      const deptCallSign = member.departmentCallSigns[member.activeDepartmentId];
      if (deptCallSign) return deptCallSign;
