  <script>
  (function() {
    // === Penal Codes Modal ===

    var pcData = null;
    var pcCurrency = 'USD';
    var pcKnownCurrencies = { USD: '$', EUR: '\u20AC', GBP: '\u00A3', CAD: 'C$', AUD: 'A$' };

    function pcGetCurrencySymbol(code) {
      return pcKnownCurrencies[code] || code || '$';
    }

    function pcParseFine(val) {
      if (typeof val === 'number') return val;
      if (typeof val === 'string') { var n = parseInt(val.replace(/[^0-9]/g, ''), 10); return isNaN(n) ? 0 : n; }
      return 0;
    }

    function pcFormatFine(amount) {
      var n = pcParseFine(amount);
      if (!n) return '\u2014';
      var sym = pcGetCurrencySymbol(pcCurrency);
      return sym + n.toLocaleString();
    }

    var pcColors = {
      'traffic violations':  { color: '#3b82f6', bg: 'rgba(59,130,246,0.12)', icon: 'fa-car' },
      'petty misdemeanors':  { color: '#f59e0b', bg: 'rgba(245,158,11,0.12)', icon: 'fa-scale-balanced' },
      'misdemeanors':        { color: '#f97316', bg: 'rgba(249,115,22,0.12)', icon: 'fa-gavel' },
      'felonies':            { color: '#ef4444', bg: 'rgba(239,68,68,0.12)', icon: 'fa-handcuffs' },
      'other':               { color: '#8b5cf6', bg: 'rgba(139,92,246,0.12)', icon: 'fa-circle-exclamation' }
    };

    function pcGetStyle(name) {
      return pcColors[(name || '').toLowerCase().trim()] || { color: '#8b5cf6', bg: 'rgba(139,92,246,0.12)', icon: 'fa-folder' };
    }

    function pcEsc(str) {
      var d = document.createElement('div');
      d.appendChild(document.createTextNode(str || ''));
      return d.innerHTML;
    }

    function pcOpen(html) {
      $('#pc-content').html(html);
      $('#pc-overlay').addClass('active');
    }

    function pcClose() {
      $('#pc-overlay').removeClass('active');
      $('#pc-content').html('');
      pcData = null;
    }

    $(document).on('click', '#pc-overlay', function(e) { if (e.target === this) pcClose(); });
    $(document).on('keydown', function(e) {
      if (e.key === 'Escape' && $('#pc-overlay').hasClass('active')) pcClose();
    });

    function pcOpenSearch() {
      pcOpen(
        '<div class="pc-panel">' +
          '<div class="pc-header">' +
            '<h4><i class="fa fa-scale-balanced"></i> Penal Codes</h4>' +
            '<button class="pc-close" onclick="pcClose()">&times;</button>' +
          '</div>' +
          '<div class="pc-body">' +
            '<div class="pc-search-wrap">' +
              '<i class="fa fa-search"></i>' +
              '<input type="text" class="pc-search-input" id="pc-search" placeholder="Search violations..." oninput="pcFilter(this.value)">' +
            '</div>' +
            '<div id="pc-results"><div class="pc-loading"><i class="fa fa-spinner fa-spin"></i> Loading penal codes...</div></div>' +
          '</div>' +
        '</div>'
      );
      pcLoadData();
    }

    function pcLoadData() {
      var communityId = (typeof dbUser !== 'undefined') ? (dbUser.user && dbUser.user.lastAccessedCommunity && dbUser.user.lastAccessedCommunity.communityID) : null;
      if (!communityId) {
        $('#pc-results').html('<div class="pc-empty">No community found.</div>');
        return;
      }

      $.ajax({
        url: API_URL + '/api/v1/community/' + communityId + '/penal-codes',
        method: 'GET',
        success: function(data) {
          pcData = (data && data.categories) || [];
          pcCurrency = (data && data.currency) || 'USD';
          if (data && data.currencies) {
            data.currencies.forEach(function(c) { pcKnownCurrencies[c.code] = c.symbol; });
          }
          pcRender(pcData, '');
        },
        error: function() {
          $('#pc-results').html('<div class="pc-empty">Failed to load penal codes.</div>');
        }
      });
    }

    function pcHighlight(text, query) {
      if (!query) return pcEsc(text);
      var escaped = pcEsc(text);
      var q = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      return escaped.replace(new RegExp('(' + q + ')', 'gi'), '<span class="pc-highlight">$1</span>');
    }

    function pcRender(categories, query) {
      var $r = $('#pc-results');
      $r.empty();

      if (!categories || categories.length === 0) {
        $r.html('<div class="pc-empty">No violations found.</div>');
        return;
      }

      categories.forEach(function(cat, catIdx) {
        var s = pcGetStyle(cat.name);
        var violations = cat.violations || [];

        var rows = '';
        violations.forEach(function(v) {
          rows += '<tr>' +
            '<td class="pc-v-name">' + pcHighlight(v.name || '', query) + '</td>' +
            '<td class="pc-v-jail">' + pcHighlight(v.jailTime || 'N/A', query) + '</td>' +
            '<td class="pc-v-fine">' + pcHighlight(pcFormatFine(v.fine), query) + '</td>' +
            '<td class="pc-v-explanation" title="' + pcEsc(v.explanation || '') + '">' + pcHighlight(v.explanation || '\u2014', query) + '</td>' +
          '</tr>';
        });

        var html = '<div class="pc-category" style="--pc-color:' + s.color + ';--pc-bg:' + s.bg + ';">' +
          '<div class="pc-cat-header" onclick="pcToggle(' + catIdx + ')">' +
            '<div class="pc-cat-left">' +
              '<i class="fa fa-chevron-down pc-chevron pc-chev-' + catIdx + (query ? ' open' : '') + '"></i>' +
              '<div class="pc-cat-icon"><i class="fa ' + s.icon + '"></i></div>' +
              '<span class="pc-cat-name">' + pcEsc(cat.name || 'Category') + '</span>' +
              '<span class="pc-cat-count">' + violations.length + '</span>' +
            '</div>' +
          '</div>' +
          '<div class="pc-cat-body pc-body-' + catIdx + '"' + (query ? ' style="display:block;"' : '') + '>' +
            (rows ?
              '<table class="pc-table">' +
                '<thead><tr>' +
                  '<th>Violation</th><th>Jail Time</th><th>Fine</th><th>Explanation</th>' +
                '</tr></thead>' +
                '<tbody>' + rows + '</tbody>' +
              '</table>'
            : '<div class="pc-empty-cat">No violations in this category</div>') +
          '</div>' +
        '</div>';

        $r.append(html);
      });

      // Auto-expand all categories on first load (no search query)
      if (!query) {
        categories.forEach(function(cat, i) {
          pcToggle(i);
        });
      }
    }

    function pcFilter(query) {
      var q = (query || '').toLowerCase().trim();
      if (!q) {
        pcRender(pcData, '');
        return;
      }

      var filtered = (pcData || []).map(function(cat) {
        var matched = (cat.violations || []).filter(function(v) {
          return (v.name || '').toLowerCase().indexOf(q) !== -1 ||
                 (v.jailTime || '').toLowerCase().indexOf(q) !== -1 ||
                 String(v.fine || '').indexOf(q) !== -1 ||
                 (v.explanation || '').toLowerCase().indexOf(q) !== -1;
        });
        if (matched.length > 0) {
          return $.extend({}, cat, { violations: matched });
        }
        return null;
      }).filter(Boolean);

      pcRender(filtered, q);
    }

    function pcToggle(catIdx) {
      var $body = $('.pc-body-' + catIdx);
      var $chev = $('.pc-chev-' + catIdx);
      $body.slideToggle(200);
      $chev.toggleClass('open');
    }

    // Export to window
    window.pcOpenSearch = pcOpenSearch;
    window.pcClose = pcClose;
    window.pcFilter = pcFilter;
    window.pcToggle = pcToggle;
  })();
  </script>

