    currentUnitSearch = $(this).val();
    renderUnitsGrid();
  });

  // Toggle department expand/collapse
  function toggleDeptExpand(btn, event) {
    event.stopPropagation(); // Prevent card click
    const $expanded = $(btn).siblings('.dept-expanded');
    $expanded.toggleClass('hidden');
    // Update button text
    if ($expanded.hasClass('hidden')) {
      const count = $expanded.find('.dept-badge').length;
      $(btn).text('+' + count);
    } else {
      $(btn).text('−'); // minus sign to collapse
    }
  }

