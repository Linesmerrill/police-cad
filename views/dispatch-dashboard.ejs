  // Hide the clear Signal 100 confirmation modal
  function hideClearSignal100Modal(event) {
    // If called from overlay click, only close if clicking the overlay itself
    if (event && event.target !== event.currentTarget) return;
    $('#clear-signal-100-modal').removeClass('show');
  }

  // Track the user ID associated with the current Signal 100
  let signal100UserId = null;

  // Track user IDs with active panic alerts (for unit card styling)
  let activePanicUserIds = new Set();

  // Confirm and broadcast Signal 100 cleared
  function confirmClearSignal100() {
    const communityId = dbUser.user?.lastAccessedCommunity?.communityID;
    if (!communityId) return;

    var clearCallSign = getResolvedCallSign(dbUser._id, dbUser.user?.callSign);

    // Clear via Go API, then broadcast via Socket.IO
    $.ajax({
      url: API_URL + '/api/v1/community/' + communityId + '/signal-100',
      method: 'DELETE',
      contentType: 'application/json',
      data: JSON.stringify({
        clearedByUserId: dbUser._id,
        clearedByUsername: dbUser.user?.username || '',
        clearedByCallSign: clearCallSign || '',
      }),
      success: function() {
        if (dashboardSocket && dashboardSocket.connected) {
          dashboardSocket.emit('clear_signal_100', {
            activeCommunity: communityId,
            clearedByUserId: dbUser._id,
            clearedByUsername: dbUser.user?.username || '',
            clearedByCallSign: clearCallSign || '',
          });
        }
      },
      error: function(xhr) {
        console.error('Error clearing Signal 100 via API:', xhr.responseText);
        // Fallback: still emit Socket.IO (server handler will retry DB)
        if (dashboardSocket && dashboardSocket.connected) {
          dashboardSocket.emit('clear_signal_100', {
            activeCommunity: communityId,
            clearedByUserId: dbUser._id,
            clearedByUsername: dbUser.user?.username || '',
            clearedByCallSign: clearCallSign || '',
          });
        }
      }
    });

    // Helper to validate MongoDB ObjectId format (24 hex chars)
    function isValidObjectId(id) {
      return typeof id === 'string' && /^[a-fA-F0-9]{24}$/.test(id);
    }

    // Capture the userId before clearing it (for use in async callback)
    const userIdToUpdate = signal100UserId;

    // Clear the stored user ID immediately
    signal100UserId = null;

    // If we know which user triggered the Signal 100, update their status to Code 4
    // Validate the userId to prevent prototype pollution and ensure valid API calls
    if (userIdToUpdate && isValidObjectId(userIdToUpdate) && tenCodesCache.length > 0) {
      const code4 = tenCodesCache.find(tc =>
        tc.code.toLowerCase() === 'code 4' ||
        tc.description.toLowerCase().includes('under control')
      );

      if (code4) {
        // Update the unit's status via API
        $.ajax({
          url: `${API_URL}/api/v1/community/${encodeURIComponent(communityId)}/members/${encodeURIComponent(userIdToUpdate)}/tenCode`,
          method: 'PUT',
          data: JSON.stringify({
            departmentId: departmentId,
            tenCodeID: code4._id
          }),
          contentType: 'application/json',
          success: function(res) {
            // Update local cache
            if (!memberDataCache[userIdToUpdate]) memberDataCache[userIdToUpdate] = {};
            memberDataCache[userIdToUpdate].tenCodeID = code4._id;

            // Re-render to update card styling
            renderUnitsGrid();

            // Emit socket event for real-time updates
            if (dashboardSocket) {
              dashboardSocket.emit('update_status', {
                userID: userIdToUpdate,
                status: code4.code,
                statusCode: code4._id,
                setBy: dbUser.user?.username || 'Dispatch',
                communityId: communityId
              });
            }

            showRealTimeToast('status', 'Signal 100 Cleared - Unit set to Code 4', 'success');
          },
          error: function(xhr) {
            console.error('Error updating unit status to Code 4:', xhr.responseText);
            showRealTimeToast('status', 'Signal 100 Cleared', 'success');
          }
        });
      } else {
        showRealTimeToast('status', 'Signal 100 Cleared', 'success');
      }
    } else {
      showRealTimeToast('status', 'Signal 100 Cleared', 'success');
    }

    // Hide the banner and modal
    $('#signal-100-banner').removeClass('show').addClass('hide');
    $('#signal-100-details').text('');
    hideClearSignal100Modal();
    adjustContentOffset();
    updateSignal100ButtonState();
  }

  function clearSignal100() {
    // Legacy function - now handled by confirmClearSignal100
    confirmClearSignal100();
  }

