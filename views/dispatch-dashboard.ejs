          method: 'GET',
          success: function(s100Data) {
            if (s100Data && s100Data.active) {
              updateSignal100Banner({
                activatedBy: s100Data.activatedByDepartment || '',
                activatedByCallSign: s100Data.activatedByCallSign || '',
