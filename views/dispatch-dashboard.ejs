  function updateEmsStatus(status) {
    var socket=io({ transports: ["websocket"] });
    var onDuty=null
    var updateDuty=false
    if (status=='10-41') {
      onDuty=true
      updateDuty=true
      status="Online"
    } else if (status=='10-42') {
      onDuty=false
      updateDuty=true
      status="Offline"
    }
    myReq={
      vehicleID: $('#vehicleIDDispatch').val(),
      status: status,
      setBy: 'Dispatch',
      onDuty: onDuty,
      updateDuty: updateDuty
    }
    socket.emit('update_ems_status', myReq)

