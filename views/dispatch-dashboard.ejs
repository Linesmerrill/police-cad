  // Load and display units in the new panel
  function loadUnitsPanel() {
    const communityId = dbUser.user?.lastAccessedCommunity?.communityID;
    if (!communityId) return;

    // First, fetch ten codes and member data
    $.ajax({
      url: `${API_URL}/api/v1/community/${communityId}`,
      method: 'GET',
      success: function(commData) {
        tenCodesCache = commData.community?.tenCodes || [];

        // Preserve active department info from previous cache before overwriting
        const preservedActiveDepts = {};
        Object.keys(memberDataCache).forEach(userId => {
          if (memberDataCache[userId]?.activeDepartmentId || memberDataCache[userId]?.activeDepartmentName) {
            preservedActiveDepts[userId] = {
              activeDepartmentId: memberDataCache[userId].activeDepartmentId,
              activeDepartmentName: memberDataCache[userId].activeDepartmentName
            };
          }
        });

        memberDataCache = commData.community?.members || {};

        // Restore preserved active department info
        Object.keys(preservedActiveDepts).forEach(userId => {
          if (!memberDataCache[userId]) memberDataCache[userId] = {};
          memberDataCache[userId].activeDepartmentId = preservedActiveDepts[userId].activeDepartmentId;
          memberDataCache[userId].activeDepartmentName = preservedActiveDepts[userId].activeDepartmentName;
        });

        // Update community name in header
        if (commData.community?.name) {
          $('#community-name').text(commData.community.name);
        }

        // Update callsign displays with resolved (department-specific) callsign
        // For the sidebar, prefer the callsign for this page's department context over activeDepartmentId
        var myMember = memberDataCache[dbUser._id];
        var sidebarCS = '';
        if (myMember && myMember.departmentCallSigns && departmentId) {
          sidebarCS = myMember.departmentCallSigns[departmentId] || '';
        }
        if (!sidebarCS) {
          sidebarCS = getResolvedCallSign(dbUser._id, dbUser.user?.callSign);
        }
        if (sidebarCS) {
          $('#sidebar-callsign').text(sidebarCS);
          $('#createdByUsername').val(dbUser.user?.username + ' (' + sidebarCS + ')');
          $('#bolo-clearingOfficerUsername').val(dbUser.user?.username + ' (' + sidebarCS + ')');
        }

        // Fetch departments to build user-department mapping
        $.ajax({
          url: `${API_URL}/api/v1/community/${communityId}/departments`,
          method: 'GET',
          success: function(deptResponse) {
            departmentsCache = (deptResponse.departments || []).filter(d => d.template?.name !== 'Civilian');

            // Build user -> departments mapping
            userDepartmentMap = {};
            departmentsCache.forEach(dept => {
              if (dept.members && Array.isArray(dept.members)) {
                dept.members.forEach(member => {
                  const userId = member.userID || member._id;
                  if (userId) {
                    if (!userDepartmentMap[userId]) {
                      userDepartmentMap[userId] = [];
                    }
                    userDepartmentMap[userId].push({
                      _id: dept._id,
                      name: dept.name,
                      template: dept.template
                    });
                  }
                });
              }
            });

            // Populate department filter dropdown
            populateDepartmentFilter();

            // Then fetch all members
            fetchMembers(communityId);
          },
          error: function(xhr) {
            console.error('Error loading departments:', xhr.responseText);
            // Still fetch members even if departments fail
            fetchMembers(communityId);
          }
        });
      },
      error: function(xhr) {
        console.error('Error loading community data:', xhr.responseText);
      }
    });
  }

  // Fetch members (separated for reuse)
  function fetchMembers(communityId) {
    $.ajax({
      url: `${API_URL}/api/v1/community/${communityId}/members?limit=100`,
      method: 'GET',
      success: function(response) {
        // Handle various response formats
        if (Array.isArray(response)) {
          unitsCache = response;
        } else if (response && Array.isArray(response.data)) {
          unitsCache = response.data;
        } else if (response && Array.isArray(response.members)) {
          unitsCache = response.members;
        } else {
          console.warn('Unexpected members response format:', response);
          unitsCache = [];
        }
        renderUnitsGrid();
      },
      error: function(xhr) {
        console.error('Error loading units:', xhr.responseText);
        $('#unitGrid').html('<div class="unit-empty"><i class="fa fa-exclamation-circle"></i> Failed to load units</div>');
      }
    });
  }

  // Populate the department filter dropdown
  function populateDepartmentFilter() {
    const $select = $('#departmentFilter');
    $select.empty();
    $select.append('<option value="all">All Departments</option>');

    departmentsCache.forEach(dept => {
      $select.append(`<option value="${dept._id}">${dept.name}</option>`);
    });
  }

  // Filter units by department
  function filterByDepartment(departmentId) {
    currentDepartmentFilter = departmentId;
    renderUnitsGrid();
  }

  // Check if a code is specifically Signal 100 (for broadcasting alerts)
  function isSignal100Code(code, description) {
    const codeLower = (code || '').toLowerCase();
    const descLower = (description || '').toLowerCase();
    return codeLower.includes('signal 100') ||
           descLower.includes('signal 100') ||
           descLower.includes('hold all traffic');
  }

  // Check if a code is 10-99 (Officer needs assistance - also broadcasts to all)
  function is1099Code(code, description) {
    const codeLower = (code || '').toLowerCase();
    const descLower = (description || '').toLowerCase();
    return codeLower === '10-99' ||
           codeLower === '1099' ||
           descLower.includes('officer needs assistance') ||
           descLower.includes('officer in distress');
  }

  // Check if a status should broadcast to all officers
  function isBroadcastStatus(code, description) {
    return isSignal100Code(code, description) || is1099Code(code, description);
  }

  // Get status category from ten-code
  function getUnitStatusCategory(tenCodeId) {
    if (!tenCodeId) return 'none'; // No status set
    const tenCode = tenCodesCache.find(tc => tc._id === tenCodeId);
    if (!tenCode) return 'none';

    const code = tenCode.code?.toLowerCase() || '';
    const desc = tenCode.description?.toLowerCase() || '';

    // Emergency - including Signal 100, hold all, etc.
    if (code.includes('10-33') || code.includes('10-99') || code.includes('10-00') ||
        code.includes('signal 100') ||
        desc.includes('emergency') || desc.includes('pursuit') || desc.includes('officer down') ||
        desc.includes('shots fired') || desc.includes('hold all')) {
      return 'emergency';
    }
    // Offline - log out, off duty, Signal 42, etc.
    if (code.includes('10-42') || code.includes('10-7') || code.includes('signal 42') ||
        desc.includes('off duty') || desc.includes('out of service') || desc.includes('end of') ||
        desc.includes('log out') || desc.includes('logout')) {
      return 'offline';
    }
    // Busy
    if (code.includes('10-6') || code.includes('10-11') || code.includes('10-17') ||
        desc.includes('busy') || desc.includes('traffic stop') || desc.includes('en route')) {
      return 'busy';
    }
    // Online/Available - any other status
    return 'online';
  }

  // Render the units grid
  function renderUnitsGrid() {
    const $grid = $('#unitGrid');
    $grid.empty();

    // Safety check
    if (!Array.isArray(unitsCache)) {
      console.warn('unitsCache is not an array:', unitsCache);
      unitsCache = [];
    }

    // Filter units
    let filteredUnits = unitsCache.filter(unit => {
      const memberData = memberDataCache[unit._id] || {};
      const tenCodeId = memberData.tenCodeID;
      const statusCategory = getUnitStatusCategory(tenCodeId);

      // Apply status filter
      if (currentUnitFilter === 'online' && (statusCategory === 'offline' || statusCategory === 'none')) return false;
      if (currentUnitFilter === 'offline' && statusCategory !== 'offline' && statusCategory !== 'none') return false;

      // Apply department filter
      if (currentDepartmentFilter !== 'all') {
        const userDepts = userDepartmentMap[unit._id] || [];
        const inDept = userDepts.some(d => d._id === currentDepartmentFilter);
        if (!inDept) return false;
      }

      // Apply search
      if (currentUnitSearch) {
        const search = currentUnitSearch.toLowerCase();
        const username = (unit.user?.username || '').toLowerCase();
        const resolvedCallSign = getResolvedCallSign(unit._id, unit.user?.callSign).toLowerCase();
        const globalCallSign = (unit.user?.callSign || '').toLowerCase();
        const tenCode = tenCodesCache.find(tc => tc._id === tenCodeId);
        const statusText = (tenCode?.code || '').toLowerCase();
        // Also search in department names
        const userDepts = userDepartmentMap[unit._id] || [];
        const deptNames = userDepts.map(d => (d.name || '').toLowerCase()).join(' ');
        // Search across all department callsigns too
        const member = memberDataCache[unit._id];
        const allDeptCallSigns = member?.departmentCallSigns ? Object.values(member.departmentCallSigns).join(' ').toLowerCase() : '';

        if (!username.includes(search) && !resolvedCallSign.includes(search) && !globalCallSign.includes(search) && !statusText.includes(search) && !deptNames.includes(search) && !allDeptCallSigns.includes(search)) {
          return false;
        }
      }

      return true;
    });

    // Determine effective status category (panic/signal100 override ten-code category)
    function getEffectiveCategory(unitId) {
      if (activePanicUserIds.has(unitId)) return 'panic';
      if (signal100UserId === unitId && $('#signal-100-banner').hasClass('show')) return 'signal100-unit';
      const data = memberDataCache[unitId] || {};
      return getUnitStatusCategory(data.tenCodeID);
    }

    // Sort: panic first, then signal100, then emergency, then busy, online, offline, none
    filteredUnits.sort((a, b) => {
      const aCategory = getEffectiveCategory(a._id);
      const bCategory = getEffectiveCategory(b._id);

      const order = { panic: -2, 'signal100-unit': -1, emergency: 0, busy: 1, online: 2, offline: 3, none: 4 };
      return (order[aCategory] ?? 4) - (order[bCategory] ?? 4);
    });

    // Update stats
    let onlineCount = 0, offlineCount = 0;
    unitsCache.forEach(unit => {
      const memberData = memberDataCache[unit._id] || {};
      const category = getUnitStatusCategory(memberData.tenCodeID);
      if (category === 'offline' || category === 'none') offlineCount++;
      else onlineCount++;
    });

    $('#onlineCount').text(onlineCount);
    $('#offlineCount').text(offlineCount);
    $('#totalCount').text(unitsCache.length);

    if (filteredUnits.length === 0) {
      $grid.html('<div class="unit-empty"><i class="fa fa-users"></i> No units found</div>');
      return;
    }

    // Render unit cards
    filteredUnits.forEach(unit => {
      const memberData = memberDataCache[unit._id] || {};
      const tenCodeId = memberData.tenCodeID;
      const tenCode = tenCodesCache.find(tc => tc._id === tenCodeId);
      const statusCode = tenCode?.code || 'No Status';
      const baseCategory = getUnitStatusCategory(tenCodeId);
      const effectiveCategory = getEffectiveCategory(unit._id);
      // Use effective category for card styling (panic/signal100 overrides)
      const statusCategory = effectiveCategory;

      const resolvedCS = getResolvedCallSign(unit._id, unit.user?.callSign);
      const callSign = resolvedCS ? `Unit ${escapeHtml(resolvedCS)}` : 'No Unit #';
      const username = escapeHtml(unit.user?.username || 'Unknown');

      // Build alert badge if unit has active panic or signal 100
      let alertBadgeHtml = '';
      if (activePanicUserIds.has(unit._id)) {
        alertBadgeHtml = '<div class="unit-alert-badge panic-badge"><i class="fa fa-exclamation-triangle"></i> PANIC</div>';
      } else if (signal100UserId === unit._id && $('#signal-100-banner').hasClass('show')) {
        alertBadgeHtml = '<div class="unit-alert-badge signal100-badge"><i class="fa fa-exclamation-triangle"></i> SIGNAL 100</div>';
      }

      // Build status select options
      let selectOptions = '<option value="">No Status</option>';
      tenCodesCache.forEach(tc => {
        const selected = tc._id === tenCodeId ? 'selected' : '';
        selectOptions += `<option value="${escapeHtml(tc._id)}" ${selected}>${escapeHtml(tc.code)}</option>`;
      });

      // Get department badges for this unit
      const userDepts = userDepartmentMap[unit._id] || [];
      const activeDeptName = memberData.activeDepartmentName || null;
      const otherDepts = userDepts.filter(d => d.name !== activeDeptName);

      let deptBadgesHtml = '';
      if (activeDeptName) {
        // Show active department with expand button if they have other departments
        if (otherDepts.length > 0) {
          const otherBadges = otherDepts.map(d => `<span class="dept-badge">${escapeHtml(d.name)}</span>`).join('');
          deptBadgesHtml = `
            <div class="unit-departments">
              <span class="active-dept-badge">${escapeHtml(activeDeptName)}</span>
              <span class="dept-expand-btn" onclick="toggleDeptExpand(this, event)" title="View all departments">+${otherDepts.length}</span>
              <div class="dept-expanded hidden">${otherBadges}</div>
            </div>`;
        } else {
          deptBadgesHtml = `<div class="unit-departments"><span class="active-dept-badge">${escapeHtml(activeDeptName)}</span></div>`;
        }
      } else if (userDepts.length > 0) {
        // No active department - show all their departments
        const badges = userDepts.map(d => `<span class="dept-badge">${escapeHtml(d.name)}</span>`).join('');
        deptBadgesHtml = `<div class="unit-departments">${badges}</div>`;
      }

      const safeUserId = escapeHtml(unit._id);
      const cardHtml = `
        <div class="unit-card ${statusCategory}" data-user-id="${safeUserId}">
          <div class="unit-status-indicator ${statusCategory}"></div>
          <div class="unit-info">
            <div class="unit-callsign">${callSign}</div>
            <div class="unit-name">${username}</div>
            ${alertBadgeHtml}
            ${deptBadgesHtml}
          </div>
          <select class="unit-status-select" data-user-id="${safeUserId}" onchange="updateUnitStatus(this)">
            ${selectOptions}
          </select>
        </div>
      `;
      $grid.append(cardHtml);
    });
  }

  // Update unit status via API
  function updateUnitStatus(selectElement) {
    const userId = $(selectElement).data('user-id');
    const tenCodeId = $(selectElement).val();
    const communityId = dbUser.user?.lastAccessedCommunity?.communityID;

    if (!communityId || !userId) return;

    $.ajax({
      url: `${API_URL}/api/v1/community/${communityId}/members/${userId}/tenCode`,
      method: 'PUT',
      data: JSON.stringify({
        departmentId: departmentId,
        tenCodeID: tenCodeId || null,
        activeDepartmentId: memberDataCache[userId]?.activeDepartmentId || departmentId,
        activeDepartmentName: memberDataCache[userId]?.activeDepartmentName || ''
      }),
      contentType: 'application/json',
      success: function(res) {
        // Update local cache
        if (!memberDataCache[userId]) memberDataCache[userId] = {};
        memberDataCache[userId].tenCodeID = tenCodeId || null;

        // Re-render to update card styling
        renderUnitsGrid();

        // Get the ten code details
        const tenCode = tenCodesCache.find(tc => tc._id === tenCodeId);
        const statusCode = tenCode?.code || 'No Status';

        // Find the unit's info for the Signal 100 broadcast
        const unit = unitsCache.find(u => u._id === userId);
        const unitCallSign = getResolvedCallSign(userId, unit?.user?.callSign) || null;
        const unitUsername = unit?.user?.username || 'Unknown';

        // Emit socket event for real-time updates to other clients
        if (dashboardSocket) {
          // Check if this is an emergency broadcast status (Signal 100 or 10-99)
          const shouldBroadcast = tenCode && isBroadcastStatus(tenCode.code, tenCode.description);

          const emitData = {
            userID: userId,
            status: statusCode,
            statusCode: tenCodeId,
            setBy: dbUser.user?.username || 'Dispatch',
            communityId: communityId,
            broadcastToAll: shouldBroadcast,  // Flag for server to broadcast to all or just the user
            activeDepartmentId: memberDataCache[userId]?.activeDepartmentId || departmentId,
            activeDepartmentName: memberDataCache[userId]?.activeDepartmentName || ''
          };
          dashboardSocket.emit('update_status', emitData);

          // Check if this is Signal 100 or 10-99 - trigger community-wide alert
          if (shouldBroadcast && !$('#signal-100-banner').hasClass('show')) {
            var signal100Req = {
              userID: userId,
              userUsername: unitUsername,
              userCallSign: unitCallSign,
              activeCommunity: communityId,
              activatedBy: 'Dispatch',
              activatedByCallSign: getResolvedCallSign(dbUser._id, dbUser.user?.callSign) || null,
              activatedByUsername: dbUser.user?.username || 'Dispatch',
              aboutUserId: userId,
              aboutCallSign: unitCallSign,
              aboutUsername: unitUsername,
              statusCode: tenCode.code,
              timestamp: new Date().toISOString()
            };

            // Persist via Go API, then broadcast via Socket.IO
            $.ajax({
              url: API_URL + '/api/v1/community/' + communityId + '/signal-100',
              method: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({
                userId: dbUser._id,
                username: dbUser.user?.username || 'Dispatch',
                callSign: getResolvedCallSign(dbUser._id, dbUser.user?.callSign),
                departmentName: 'Dispatch'
              }),
              success: function() {
                if (dashboardSocket && dashboardSocket.connected) {
                  dashboardSocket.emit('signal_100_button_update', signal100Req);
                }
              },
              error: function(xhr) {
                console.error('Error activating Signal 100 via API:', xhr.responseText);
                if (dashboardSocket && dashboardSocket.connected) {
                  dashboardSocket.emit('signal_100_button_update', signal100Req);
                }
              }
            });

            // Update local banner immediately
            updateSignal100Banner({
              activatedBy: 'Dispatch',
              activatedByCallSign: getResolvedCallSign(dbUser._id, dbUser.user?.callSign),
              activatedByUsername: dbUser.user?.username,
              aboutUserId: userId,
              aboutCallSign: unitCallSign,
              aboutUsername: unitUsername
            });
          }
        } else {
          console.error('dashboardSocket is null/undefined');
        }

        showRealTimeToast('status', 'Unit status updated', 'success');
      },
      error: function(xhr) {
        console.error('Error updating unit status:', xhr.responseText);
        showRealTimeToast('status', 'Failed to update status', 'error');
      }
    });
  }

  // Filter units by status
  function filterUnits(filter) {
