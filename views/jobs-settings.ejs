<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jobs - Lines Police CAD</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="shortcut icon" type="image/ico" href="static/images/favicon.ico">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --es-bg: #08090c;
      --es-glass: rgba(255,255,255,0.04);
      --es-glass-border: rgba(255,255,255,0.06);
      --es-glass-hover: rgba(255,255,255,0.07);
      --es-text: #e2e8f0;
      --es-text-muted: #94a3b8;
      --es-text-dim: #64748b;
      --es-accent: #38bdf8;
      --es-accent-dim: rgba(56,189,248,0.12);
      --es-accent-border: rgba(56,189,248,0.25);
      --es-green: #22c55e;
      --es-red: #ef4444;
      --es-amber: #f59e0b;
      --es-radius: 12px;
    }
    body {
      background: var(--es-bg); color: var(--es-text);
      font-family: 'Outfit', -apple-system, sans-serif;
      min-height: 100vh; line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding-top: 36px;
    }
    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background: radial-gradient(ellipse 700px 500px at 10% 15%, rgba(56,189,248,0.06) 0%, transparent 70%);
    }
    .es-shell { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
    .es-header { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1.5rem; }
    .es-header-icon {
      width: 44px; height: 44px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      background: var(--es-accent-dim); color: var(--es-accent); font-size: 1.2rem;
      border: 1px solid var(--es-accent-border);
    }
    .es-title { font-size: 1.4rem; font-weight: 600; }
    .es-subtitle { font-size: 0.85rem; color: var(--es-text-muted); margin-top: 0.1rem; }
    .es-card { background: var(--es-glass); border: 1px solid var(--es-glass-border); border-radius: var(--es-radius); padding: 1.25rem 1.4rem; margin-bottom: 1rem; }
    .es-card.archived { opacity: 0.55; }
    .es-card-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; }
    .es-card-title { font-size: 1.05rem; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
    .es-card-title .es-rate { color: var(--es-accent); font-weight: 500; font-size: 0.92rem; }
    .es-card-actions { display: flex; gap: 0.4rem; }
    .es-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0.85rem; }
    @media (max-width: 600px) { .es-grid-2 { grid-template-columns: 1fr; } }
    .es-field { margin-bottom: 0; }
    .es-label { display: block; font-size: 0.78rem; color: var(--es-text-muted); margin-bottom: 0.3rem; }
    .es-input, .es-select, .es-textarea {
      width: 100%; padding: 0.5rem 0.7rem;
      background: rgba(255,255,255,0.02); color: var(--es-text);
      border: 1px solid var(--es-glass-border); border-radius: 8px;
      font: inherit; font-size: 0.88rem;
    }
    .es-input:focus, .es-select:focus, .es-textarea:focus { outline: none; border-color: var(--es-accent); }
    .es-textarea { resize: vertical; min-height: 64px; }
    .es-toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: 0.6rem; }
    .es-toggle-desc { font-size: 0.78rem; color: var(--es-text-dim); }
    .es-switch { position: relative; display: inline-block; width: 38px; height: 22px; flex-shrink: 0; }
    .es-switch input { opacity: 0; width: 0; height: 0; }
    .es-switch-track { position: absolute; cursor: pointer; inset: 0; background: rgba(255,255,255,0.1); border-radius: 22px; transition: 0.2s; }
    .es-switch-track::before { position: absolute; content: ''; height: 16px; width: 16px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.2s; }
    .es-switch input:checked + .es-switch-track { background: var(--es-accent); }
    .es-switch input:checked + .es-switch-track::before { transform: translateX(16px); }
    .es-btn {
      padding: 0.45rem 0.85rem; border-radius: 7px;
      background: var(--es-accent-dim); color: var(--es-accent);
      border: 1px solid var(--es-accent-border);
      font: inherit; font-size: 0.83rem; font-weight: 500;
      cursor: pointer; transition: background 120ms ease;
    }
    .es-btn:hover { background: rgba(56,189,248,0.2); }
    .es-btn.ghost { background: transparent; color: var(--es-text-muted); border-color: var(--es-glass-border); }
    .es-btn.ghost:hover { background: var(--es-glass-hover); color: var(--es-text); }
    .es-btn.danger { background: rgba(239,68,68,0.1); color: var(--es-red); border-color: rgba(239,68,68,0.25); }
    .es-btn.danger:hover { background: rgba(239,68,68,0.2); }
    .es-status { font-size: 0.8rem; }
    .es-status.saving { color: var(--es-text-muted); }
    .es-status.saved { color: var(--es-green); }
    .es-status.error { color: var(--es-red); }
    .es-empty {
      padding: 2rem 1rem; text-align: center; color: var(--es-text-dim);
      background: var(--es-glass); border: 1px dashed var(--es-glass-border);
      border-radius: var(--es-radius);
    }
    .es-add-row { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1.25rem; }
    .es-add-row .es-input { flex: 1; }
  </style>
</head>
<body>

<%- include('partials/standalone-utility', {
  user: user,
  communityName: communityName,
  pageLabel: 'Jobs',
  backHref: '/communities',
  backLabel: 'Back to dashboard'
}) %>

<div class="es-shell">
  <div class="es-header">
    <div class="es-header-icon"><i class="fa fa-briefcase"></i></div>
    <div>
      <div class="es-title">Jobs</div>
      <div class="es-subtitle">RP occupations civilians can pick up (Sanitation, Mechanic, Lawyer, etc.)</div>
    </div>
  </div>

  <div class="es-add-row">
    <input type="text" class="es-input" id="newJobName" placeholder="New job name (e.g. Sanitation Worker)" maxlength="80">
    <button class="es-btn" id="newJobBtn"><i class="fa fa-plus"></i> Add job</button>
  </div>

  <div id="jobsList"><div class="es-empty">Loading jobs…</div></div>
</div>

<script>
  const API_URL = "<%- apiUrl %>";
  const COMMUNITY_ID = "<%- communityId %>";
  const USER_ID = "<%- userId %>";

  let jobs = [];

  function fmtDollarsInput(cents) { return ((cents || 0) / 100).toFixed(2); }
  function dollarsToCents(v) {
    var n = parseFloat(v);
    if (!isFinite(n) || n < 0) return 0;
    return Math.round(n * 100);
  }
  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  async function loadJobs() {
    const host = document.getElementById('jobsList');
    try {
      const res = await fetch(`${API_URL}/api/v1/community/${COMMUNITY_ID}`);
      if (!res.ok) {
        const txt = await res.text().catch(() => '');
        throw new Error(`HTTP ${res.status}${txt ? ': ' + txt.slice(0, 200) : ''}`);
      }
      const data = await res.json();
      jobs = (data.community && data.community.jobs) || [];
      render();
    } catch (err) {
      console.error(err);
      host.innerHTML = '<div class="es-empty" style="color:var(--es-red);">Could not load jobs. ' + escapeHtml(err.message || '') + '</div>';
    }
  }

  function render() {
    const host = document.getElementById('jobsList');
    if (!jobs.length) {
      host.innerHTML = '<div class="es-empty">No jobs yet. Add your first one above.</div>';
      return;
    }
    jobs.sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0) || (a.name || '').localeCompare(b.name || ''));
    host.innerHTML = jobs.map(j => renderJobCard(j)).join('');
    jobs.forEach(j => wireJobCard(j._id));
  }

  function renderJobCard(j) {
    const id = j._id;
    return `
      <div class="es-card${j.archived ? ' archived' : ''}" data-job-id="${escapeHtml(id)}">
        <div class="es-card-head">
          <div class="es-card-title">
            <i class="fa fa-briefcase"></i>
            <span class="job-name-display">${escapeHtml(j.name || 'Untitled')}</span>
            <span class="es-rate">$${fmtDollarsInput(j.payPerHour)}/hr</span>
            ${j.archived ? '<span class="es-status" style="color:var(--es-text-dim);">· archived</span>' : ''}
          </div>
          <div class="es-card-actions">
            <button class="es-btn ghost" data-action="toggle"><i class="fa fa-chevron-down"></i> Edit</button>
            <button class="es-btn danger" data-action="delete"><i class="fa fa-trash"></i></button>
          </div>
        </div>
        <div class="es-card-body" id="body-${escapeHtml(id)}" style="display:none;">
          <div class="es-grid-2" style="margin-top:1rem;">
            <div class="es-field">
              <label class="es-label">Name</label>
              <input type="text" class="es-input" data-field="name" value="${escapeHtml(j.name || '')}" maxlength="80">
            </div>
            <div class="es-field">
              <label class="es-label">Pay ($/hour)</label>
              <input type="number" class="es-input" data-field="payPerHour" min="0" step="0.01" value="${fmtDollarsInput(j.payPerHour)}">
            </div>
          </div>
          <div class="es-field" style="margin-top:0.75rem;">
            <label class="es-label">Description</label>
            <textarea class="es-textarea" data-field="description" maxlength="300">${escapeHtml(j.description || '')}</textarea>
          </div>
          <div class="es-grid-2">
            <div class="es-field">
              <label class="es-label">Payout mode</label>
              <select class="es-select" data-field="payoutMode">
                <option value="on_heartbeat"${(j.payoutMode || 'on_heartbeat') === 'on_heartbeat' ? ' selected' : ''}>On heartbeat (live)</option>
                <option value="on_clockout"${j.payoutMode === 'on_clockout' ? ' selected' : ''}>On clock-out only</option>
              </select>
            </div>
            <div class="es-field">
              <label class="es-label">Max session (min)</label>
              <input type="number" class="es-input" data-field="maxSessionMinutes" min="1" step="1" value="${j.maxSessionMinutes || 120}">
            </div>
            <div class="es-field">
              <label class="es-label">AFK prompt (sec)</label>
              <input type="number" class="es-input" data-field="afkPromptIntervalSeconds" min="30" step="1" value="${j.afkPromptIntervalSeconds || 600}">
            </div>
            <div class="es-field">
              <label class="es-label">AFK grace (sec)</label>
              <input type="number" class="es-input" data-field="afkGraceSeconds" min="10" step="1" value="${j.afkGraceSeconds || 60}">
            </div>
          </div>
          <div class="es-toggle-row">
            <div>
              <div>Archive this job</div>
              <div class="es-toggle-desc">Archived jobs disappear from civilians' job picker, but existing assignments keep working.</div>
            </div>
            <label class="es-switch">
              <input type="checkbox" data-field="archived"${j.archived ? ' checked' : ''}>
              <span class="es-switch-track"></span>
            </label>
          </div>
          <div style="display:flex;gap:0.5rem;align-items:center;justify-content:flex-end;margin-top:1rem;">
            <span class="es-status" id="status-${escapeHtml(id)}"></span>
            <button class="es-btn" data-action="save"><i class="fa fa-floppy-disk"></i> Save</button>
          </div>
        </div>
      </div>
    `;
  }

  function wireJobCard(id) {
    const card = document.querySelector(`[data-job-id="${CSS.escape(id)}"]`);
    if (!card) return;
    card.querySelector('[data-action="toggle"]').addEventListener('click', () => {
      const body = card.querySelector('.es-card-body');
      const expanded = body.style.display !== 'none';
      body.style.display = expanded ? 'none' : 'block';
      card.querySelector('[data-action="toggle"] i').className = expanded ? 'fa fa-chevron-down' : 'fa fa-chevron-up';
    });
    card.querySelector('[data-action="save"]').addEventListener('click', () => saveJob(id));
    card.querySelector('[data-action="delete"]').addEventListener('click', () => deleteJob(id));
  }

  function readJobForm(id) {
    const card = document.querySelector(`[data-job-id="${CSS.escape(id)}"]`);
    const get = sel => card.querySelector(`[data-field="${sel}"]`);
    return {
      name: get('name').value.trim(),
      description: get('description').value.trim(),
      payPerHour: dollarsToCents(get('payPerHour').value),
      maxSessionMinutes: parseInt(get('maxSessionMinutes').value, 10) || 120,
      afkPromptIntervalSeconds: parseInt(get('afkPromptIntervalSeconds').value, 10) || 600,
      afkGraceSeconds: parseInt(get('afkGraceSeconds').value, 10) || 60,
      payoutMode: get('payoutMode').value === 'on_clockout' ? 'on_clockout' : 'on_heartbeat',
      archived: get('archived').checked,
    };
  }

  function setStatus(id, kind, msg) {
    const el = document.getElementById(`status-${id}`);
    if (!el) return;
    el.className = 'es-status ' + (kind || '');
    el.textContent = msg || '';
    if (kind === 'saved') setTimeout(() => { if (el.textContent === msg) { el.textContent = ''; el.className = 'es-status'; } }, 2000);
  }

  async function saveJob(id) {
    const body = readJobForm(id);
    if (!body.name) { setStatus(id, 'error', 'Name required'); return; }
    setStatus(id, 'saving', 'Saving…');
    try {
      const res = await fetch(`${API_URL}/api/v1/community/${COMMUNITY_ID}/jobs/${id}?userId=${encodeURIComponent(USER_ID)}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      // Local mirror so subsequent edits don't see stale data
      const i = jobs.findIndex(j => j._id === id);
      if (i >= 0) jobs[i] = Object.assign({}, jobs[i], body);
      setStatus(id, 'saved', 'Saved');
      // Refresh just the visible bits without collapsing the open card
      const card = document.querySelector(`[data-job-id="${CSS.escape(id)}"]`);
      if (card) {
        card.querySelector('.job-name-display').textContent = body.name;
        card.querySelector('.es-rate').textContent = '$' + fmtDollarsInput(body.payPerHour) + '/hr';
        card.classList.toggle('archived', body.archived);
      }
    } catch (err) {
      console.error(err);
      setStatus(id, 'error', 'Save failed');
    }
  }

  function deleteJob(id) {
    const j = jobs.find(x => x._id === id);
    const name = j ? j.name : 'this job';
    const proceed = () => doDeleteJob(id);
    if (window.ddModal) {
      window.ddModal({
        type: 'danger', icon: 'fa-trash',
        title: `Delete "${name}"?`,
        message: 'Civilians currently assigned to this job will be unassigned. Any inbox items and finished clock sessions are preserved.',
        confirmText: 'Delete',
        onConfirm: proceed,
      });
    } else if (confirm('Delete this job?')) {
      proceed();
    }
  }

  async function doDeleteJob(id) {
    try {
      const res = await fetch(`${API_URL}/api/v1/community/${COMMUNITY_ID}/jobs/${id}?userId=${encodeURIComponent(USER_ID)}`, {
        method: 'DELETE',
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      jobs = jobs.filter(j => j._id !== id);
      render();
    } catch (err) {
      console.error(err);
      if (window.ddModal) window.ddModal({ type: 'danger', icon: 'fa-triangle-exclamation', title: 'Delete failed', message: err.message });
    }
  }

  async function addJob() {
    const nameEl = document.getElementById('newJobName');
    const name = nameEl.value.trim();
    if (!name) { nameEl.focus(); return; }
    try {
      const res = await fetch(`${API_URL}/api/v1/community/${COMMUNITY_ID}/jobs?userId=${encodeURIComponent(USER_ID)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          payPerHour: 0,
          payoutMode: 'on_heartbeat',
          maxSessionMinutes: 120,
          afkPromptIntervalSeconds: 600,
          afkGraceSeconds: 60,
        }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (data && data.job) jobs.push(data.job);
      nameEl.value = '';
      render();
    } catch (err) {
      console.error(err);
      if (window.ddModal) window.ddModal({ type: 'danger', icon: 'fa-triangle-exclamation', title: 'Could not add job', message: err.message });
    }
  }

  document.getElementById('newJobBtn').addEventListener('click', addJob);
  document.getElementById('newJobName').addEventListener('keydown', e => { if (e.key === 'Enter') addJob(); });

  loadJobs();
</script>
</body>
</html>
