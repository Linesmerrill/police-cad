<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Economy Settings - Lines Police CAD</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="shortcut icon" type="image/ico" href="static/images/favicon.ico">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --es-bg: #08090c;
      --es-glass: rgba(255,255,255,0.04);
      --es-glass-border: rgba(255,255,255,0.06);
      --es-text: #e2e8f0;
      --es-text-muted: #94a3b8;
      --es-text-dim: #64748b;
      --es-accent: #38bdf8;
      --es-accent-dim: rgba(56,189,248,0.12);
      --es-accent-border: rgba(56,189,248,0.25);
      --es-green: #22c55e;
      --es-red: #ef4444;
      --es-radius: 12px;
    }
    body {
      background: var(--es-bg); color: var(--es-text);
      font-family: 'Outfit', -apple-system, sans-serif;
      min-height: 100vh; line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding-top: 36px;
    }
    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background: radial-gradient(ellipse 700px 500px at 10% 15%, rgba(56,189,248,0.06) 0%, transparent 70%);
    }
    .es-shell { position: relative; z-index: 1; max-width: 760px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
    .es-header { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1.5rem; }
    .es-header-icon {
      width: 44px; height: 44px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      background: var(--es-accent-dim); color: var(--es-accent); font-size: 1.2rem;
      border: 1px solid var(--es-accent-border);
    }
    .es-title { font-size: 1.4rem; font-weight: 600; }
    .es-subtitle { font-size: 0.85rem; color: var(--es-text-muted); margin-top: 0.1rem; }
    .es-card { background: var(--es-glass); border: 1px solid var(--es-glass-border); border-radius: var(--es-radius); padding: 1.4rem; margin-bottom: 1rem; }
    .es-section-title { font-size: 0.95rem; font-weight: 600; margin-bottom: 0.85rem; }
    .es-field { margin-bottom: 1rem; }
    .es-field:last-child { margin-bottom: 0; }
    .es-label { display: block; font-size: 0.82rem; color: var(--es-text-muted); margin-bottom: 0.4rem; }
    .es-input, .es-select {
      width: 100%; padding: 0.55rem 0.75rem;
      background: rgba(255,255,255,0.02); color: var(--es-text);
      border: 1px solid var(--es-glass-border); border-radius: 8px;
      font: inherit; font-size: 0.9rem;
    }
    .es-input:focus, .es-select:focus { outline: none; border-color: var(--es-accent); }
    .es-toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .es-toggle-desc { font-size: 0.78rem; color: var(--es-text-dim); margin-top: 0.15rem; }
    .es-switch { position: relative; display: inline-block; width: 40px; height: 22px; flex-shrink: 0; }
    .es-switch input { opacity: 0; width: 0; height: 0; }
    .es-switch-track { position: absolute; cursor: pointer; inset: 0; background: rgba(255,255,255,0.1); border-radius: 22px; transition: 0.2s; }
    .es-switch-track::before { position: absolute; content: ''; height: 16px; width: 16px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.2s; }
    .es-switch input:checked + .es-switch-track { background: var(--es-accent); }
    .es-switch input:checked + .es-switch-track::before { transform: translateX(18px); }
    .es-actions { display: flex; gap: 0.5rem; align-items: center; justify-content: flex-end; }
    .es-card-actions {
      display: flex; gap: 0.5rem; align-items: center; justify-content: flex-end;
      margin-top: 1.1rem; padding-top: 1rem;
      border-top: 1px dashed var(--es-glass-border);
    }

    /* Section divider — used to break community-wide settings from per-department list */
    .es-section-divider {
      display: flex; align-items: center; gap: 0.75rem;
      margin: 1.6rem 0 0.9rem;
      color: var(--es-text-muted);
      font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; font-weight: 600;
    }
    .es-section-divider::before,
    .es-section-divider::after {
      content: ''; flex: 1; height: 1px;
      background: linear-gradient(to right, transparent, var(--es-glass-border), transparent);
    }

    /* Card header (icon + title + subtitle) — used on Departments card */
    .es-card-head {
      display: flex; align-items: center; gap: 0.7rem;
      margin-bottom: 1rem;
    }
    .es-card-head-icon {
      width: 32px; height: 32px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      background: var(--es-accent-dim); color: var(--es-accent);
      border: 1px solid var(--es-accent-border);
      font-size: 0.78rem; flex-shrink: 0;
    }
    .es-card-head-title { font-size: 0.98rem; font-weight: 600; color: var(--es-text); }
    .es-card-head-sub { font-size: 0.76rem; color: var(--es-text-dim); margin-top: 0.1rem; }
    .es-btn {
      padding: 0.55rem 1.1rem; border-radius: 8px;
      background: var(--es-accent-dim); color: var(--es-accent);
      border: 1px solid var(--es-accent-border);
      font: inherit; font-size: 0.88rem; font-weight: 500;
      cursor: pointer; transition: background 120ms ease;
    }
    .es-btn:hover { background: rgba(56,189,248,0.2); }
    .es-status { font-size: 0.82rem; }
    .es-status.saving { color: var(--es-text-muted); }
    .es-status.saved { color: var(--es-green); }
    .es-status.error { color: var(--es-red); }

    /* Per-department list */
    .es-dept-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .es-dept {
      border: 1px solid var(--es-glass-border);
      border-radius: 10px;
      background: rgba(255,255,255,0.015);
      overflow: hidden;
      transition: border-color 120ms ease;
    }
    .es-dept.is-open { border-color: var(--es-accent-border); }
    .es-dept-header {
      display: flex; align-items: center; justify-content: space-between;
      gap: 0.75rem; padding: 0.75rem 0.9rem; cursor: pointer;
      user-select: none;
    }
    .es-dept-header:hover { background: rgba(255,255,255,0.02); }
    .es-dept-name { font-size: 0.92rem; font-weight: 500; color: var(--es-text); display: flex; align-items: center; gap: 0.55rem; min-width: 0; }
    .es-dept-name .es-dept-name-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .es-dept-pill {
      font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.05em;
      padding: 0.1rem 0.45rem; border-radius: 4px; font-weight: 600;
      flex-shrink: 0;
    }
    .es-dept-pill.on { color: var(--es-green); background: rgba(34,197,94,0.12); }
    .es-dept-pill.off { color: var(--es-text-dim); background: rgba(255,255,255,0.04); }
    .es-dept-chevron { color: var(--es-text-dim); font-size: 0.7rem; transition: transform 160ms ease; flex-shrink: 0; }
    .es-dept.is-open .es-dept-chevron { transform: rotate(90deg); }
    .es-dept-body {
      display: none;
      padding: 0.25rem 0.9rem 0.9rem;
      border-top: 1px dashed var(--es-glass-border);
    }
    .es-dept.is-open .es-dept-body { display: block; }
    .es-dept-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; margin-top: 0.85rem; }
    @media (max-width: 600px) { .es-dept-grid { grid-template-columns: 1fr; } }
    .es-dept-actions { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; margin-top: 0.85rem; }
    .es-dept-empty { color: var(--es-text-muted); font-size: 0.85rem; padding: 0.5rem 0; }
  </style>
</head>
<body>

<%- include('partials/standalone-utility', {
  user: user,
  communityName: communityName,
  pageLabel: 'Economy Settings',
  backHref: '/communities',
  backLabel: 'Back to dashboard'
}) %>

<div class="es-shell">
  <div class="es-header">
    <div class="es-header-icon"><i class="fa fa-coins"></i></div>
    <div>
      <div class="es-title">Economy Settings</div>
      <div class="es-subtitle">Community-wide controls for the new economy system</div>
    </div>
  </div>

  <div class="es-card">
    <div class="es-section-title">General</div>
    <div class="es-field es-toggle-row">
      <div>
        <div>Enable economy for this community</div>
        <div class="es-toggle-desc">Master switch. Departments also need to be individually enabled.</div>
      </div>
      <label class="es-switch">
        <input type="checkbox" id="es-enabled">
        <span class="es-switch-track"></span>
      </label>
    </div>
  </div>

  <div class="es-card">
    <div class="es-section-title">New civilian defaults</div>
    <div class="es-field">
      <label class="es-label" for="es-starting-balance">Default starting balance ($)</label>
      <input type="number" min="0" step="0.01" class="es-input" id="es-starting-balance" value="0">
    </div>
  </div>

  <div class="es-card">
    <div class="es-section-title">Fines & Inbox</div>
    <div class="es-field">
      <label class="es-label" for="es-fine-mode">Fine mode</label>
      <select class="es-select" id="es-fine-mode">
        <option value="inbox">Inbox — civilian reviews and pays (recommended)</option>
        <option value="auto_debit">Auto-debit at issue — fines are deducted immediately</option>
      </select>
    </div>
    <div class="es-field">
      <label class="es-label" for="es-due-days">Default due days</label>
      <input type="number" min="1" step="1" class="es-input" id="es-due-days" value="14">
    </div>
    <div class="es-field es-toggle-row">
      <div>
        <div>Allow negative balances</div>
        <div class="es-toggle-desc">When off, civilians can't pay an inbox item they can't afford.</div>
      </div>
      <label class="es-switch">
        <input type="checkbox" id="es-allow-neg">
        <span class="es-switch-track"></span>
      </label>
    </div>
    <div class="es-card-actions">
      <span class="es-status" id="es-status"></span>
      <button class="es-btn" id="es-save">Save community settings</button>
    </div>
  </div>

  <div class="es-section-divider">Per-department</div>

  <div class="es-card">
    <div class="es-card-head">
      <div class="es-card-head-icon"><i class="fa fa-building"></i></div>
      <div>
        <div class="es-card-head-title">Departments</div>
        <div class="es-card-head-sub">Same controls as each department's Settings → Economy tab.</div>
      </div>
    </div>
    <div class="es-dept-list" id="es-dept-list">
      <div class="es-dept-empty">Loading departments…</div>
    </div>
  </div>
</div>

<script>
  const API_URL = "<%- apiUrl %>";
  const COMMUNITY_ID = "<%- communityId %>";
  const USER_ID = "<%- userId %>";

  function setStatus(kind, msg) {
    const el = document.getElementById('es-status');
    el.className = 'es-status ' + (kind || '');
    el.textContent = msg || '';
    if (kind === 'saved') setTimeout(() => { if (el.textContent === msg) { el.textContent = ''; el.className = 'es-status'; } }, 2000);
  }

  async function load() {
    try {
      const res = await fetch(`${API_URL}/api/v1/community/${COMMUNITY_ID}`);
      if (!res.ok) throw new Error('community fetch failed');
      const data = await res.json();
      const econ = (data.community && data.community.economy) || {};
      document.getElementById('es-enabled').checked = !!econ.enabled;
      document.getElementById('es-starting-balance').value = (typeof econ.defaultStartingBalance === 'number' ? econ.defaultStartingBalance / 100 : 0).toFixed(2);
      document.getElementById('es-fine-mode').value = econ.fineMode === 'auto_debit' ? 'auto_debit' : 'inbox';
      document.getElementById('es-due-days').value = (typeof econ.defaultDueDays === 'number' && econ.defaultDueDays > 0) ? econ.defaultDueDays : 14;
      document.getElementById('es-allow-neg').checked = !!econ.allowNegativeBalance;
    } catch (err) {
      console.error(err);
      setStatus('error', 'Could not load settings');
    }
  }

  async function save() {
    const body = {
      economy: {
        enabled: document.getElementById('es-enabled').checked,
        defaultStartingBalance: Math.round((parseFloat(document.getElementById('es-starting-balance').value) || 0) * 100),
        fineMode: document.getElementById('es-fine-mode').value === 'auto_debit' ? 'auto_debit' : 'inbox',
        defaultDueDays: parseInt(document.getElementById('es-due-days').value, 10) || 14,
        allowNegativeBalance: document.getElementById('es-allow-neg').checked,
      }
    };
    setStatus('saving', 'Saving…');
    try {
      const res = await fetch(`${API_URL}/api/v1/community/${COMMUNITY_ID}?userId=${encodeURIComponent(USER_ID)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(`save failed: ${res.status}`);
      setStatus('saved', 'Saved');
    } catch (err) {
      console.error(err);
      setStatus('error', 'Save failed');
    }
  }

  document.getElementById('es-save').addEventListener('click', save);
  load();

  // ---------- Per-department economy ----------
  let DEPTS = [];

  function escHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  async function loadDepartments() {
    const host = document.getElementById('es-dept-list');
    try {
      const res = await fetch(`${API_URL}/api/v1/community/${COMMUNITY_ID}`);
      if (!res.ok) throw new Error('community fetch failed');
      const data = await res.json();
      DEPTS = (data.community && data.community.departments) || [];
      renderDepartments();
    } catch (err) {
      console.error(err);
      host.innerHTML = '<div class="es-dept-empty" style="color:var(--es-red);">Could not load departments.</div>';
    }
  }

  function renderDepartments() {
    const host = document.getElementById('es-dept-list');
    if (!DEPTS.length) {
      host.innerHTML = '<div class="es-dept-empty">This community has no departments yet.</div>';
      return;
    }
    host.innerHTML = DEPTS.map((d, idx) => {
      const enabled = d.economyEnabled === true;
      const basePay = (typeof d.basePayPerHour === 'number') ? (d.basePayPerHour / 100).toFixed(2) : '0.00';
      const maxSess = (typeof d.maxSessionMinutes === 'number' && d.maxSessionMinutes > 0) ? d.maxSessionMinutes : 120;
      const afkPrompt = (typeof d.afkPromptIntervalSeconds === 'number' && d.afkPromptIntervalSeconds > 0) ? d.afkPromptIntervalSeconds : 600;
      const afkGrace = (typeof d.afkGraceSeconds === 'number' && d.afkGraceSeconds > 0) ? d.afkGraceSeconds : 60;
      const payoutMode = d.payoutMode === 'on_clockout' ? 'on_clockout' : 'on_heartbeat';
      return `
        <div class="es-dept" data-idx="${idx}" data-dept-id="${escHtml(d._id)}">
          <div class="es-dept-header" data-action="toggle">
            <div class="es-dept-name">
              <span class="es-dept-pill ${enabled ? 'on' : 'off'}">${enabled ? 'On' : 'Off'}</span>
              <span class="es-dept-name-text">${escHtml(d.name || 'Untitled department')}</span>
            </div>
            <i class="fa fa-chevron-right es-dept-chevron"></i>
          </div>
          <div class="es-dept-body">
            <div class="es-field es-toggle-row">
              <div>
                <div>Enable economy for this department</div>
                <div class="es-toggle-desc">Members can clock in and earn pay when on.</div>
              </div>
              <label class="es-switch">
                <input type="checkbox" data-field="economyEnabled" ${enabled ? 'checked' : ''}>
                <span class="es-switch-track"></span>
              </label>
            </div>
            <div class="es-dept-grid">
              <div class="es-field">
                <label class="es-label">Base pay ($/hr)</label>
                <input type="number" min="0" step="0.01" class="es-input" data-field="basePayPerHour" value="${basePay}">
              </div>
              <div class="es-field">
                <label class="es-label">Payout mode</label>
                <select class="es-select" data-field="payoutMode">
                  <option value="on_heartbeat" ${payoutMode === 'on_heartbeat' ? 'selected' : ''}>On heartbeat (live)</option>
                  <option value="on_clockout" ${payoutMode === 'on_clockout' ? 'selected' : ''}>On clock-out only</option>
                </select>
              </div>
              <div class="es-field">
                <label class="es-label">Max session (minutes)</label>
                <input type="number" min="1" step="1" class="es-input" data-field="maxSessionMinutes" value="${maxSess}">
              </div>
              <div class="es-field">
                <label class="es-label">AFK prompt every (seconds)</label>
                <input type="number" min="30" step="1" class="es-input" data-field="afkPromptIntervalSeconds" value="${afkPrompt}">
              </div>
              <div class="es-field">
                <label class="es-label">AFK grace (seconds)</label>
                <input type="number" min="10" step="1" class="es-input" data-field="afkGraceSeconds" value="${afkGrace}">
              </div>
            </div>
            <div class="es-dept-actions">
              <span class="es-status" data-role="status"></span>
              <button class="es-btn" data-action="save">Save</button>
            </div>
          </div>
        </div>
      `;
    }).join('');

    host.querySelectorAll('.es-dept').forEach(deptEl => {
      const header = deptEl.querySelector('[data-action="toggle"]');
      header.addEventListener('click', () => deptEl.classList.toggle('is-open'));
      const saveBtn = deptEl.querySelector('[data-action="save"]');
      saveBtn.addEventListener('click', (e) => { e.stopPropagation(); saveDepartment(deptEl); });
      // Stop input clicks from collapsing the panel
      deptEl.querySelector('.es-dept-body').addEventListener('click', (e) => e.stopPropagation());
    });
  }

  async function saveDepartment(deptEl) {
    const idx = parseInt(deptEl.dataset.idx, 10);
    const dept = DEPTS[idx];
    if (!dept) return;
    const statusEl = deptEl.querySelector('[data-role="status"]');
    const setRowStatus = (kind, msg) => {
      statusEl.className = 'es-status ' + (kind || '');
      statusEl.textContent = msg || '';
      if (kind === 'saved') setTimeout(() => { if (statusEl.textContent === msg) { statusEl.textContent = ''; statusEl.className = 'es-status'; } }, 2000);
    };
    const get = (field) => deptEl.querySelector(`[data-field="${field}"]`);
    const enabled = get('economyEnabled').checked;
    let basePay = parseFloat(get('basePayPerHour').value);
    if (!isFinite(basePay) || basePay < 0) basePay = 0;
    let maxSess = parseInt(get('maxSessionMinutes').value, 10);
    if (!isFinite(maxSess) || maxSess < 1) maxSess = 120;
    let afkPrompt = parseInt(get('afkPromptIntervalSeconds').value, 10);
    if (!isFinite(afkPrompt) || afkPrompt < 30) afkPrompt = 600;
    let afkGrace = parseInt(get('afkGraceSeconds').value, 10);
    if (!isFinite(afkGrace) || afkGrace < 10) afkGrace = 60;
    const payoutMode = get('payoutMode').value === 'on_clockout' ? 'on_clockout' : 'on_heartbeat';

    setRowStatus('saving', 'Saving…');
    try {
      const res = await fetch(`${API_URL}/api/v1/community/${COMMUNITY_ID}/departments/${dept._id}?userId=${encodeURIComponent(USER_ID)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          economyEnabled: enabled,
          basePayPerHour: Math.round(basePay * 100),
          maxSessionMinutes: maxSess,
          afkPromptIntervalSeconds: afkPrompt,
          afkGraceSeconds: afkGrace,
          payoutMode: payoutMode,
        }),
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      dept.economyEnabled = enabled;
      dept.basePayPerHour = Math.round(basePay * 100);
      dept.maxSessionMinutes = maxSess;
      dept.afkPromptIntervalSeconds = afkPrompt;
      dept.afkGraceSeconds = afkGrace;
      dept.payoutMode = payoutMode;
      // Update the pill without re-rendering everything
      const pill = deptEl.querySelector('.es-dept-pill');
      pill.classList.toggle('on', enabled);
      pill.classList.toggle('off', !enabled);
      pill.textContent = enabled ? 'On' : 'Off';
      setRowStatus('saved', 'Saved');
    } catch (err) {
      console.error('dept save failed', err);
      setRowStatus('error', 'Save failed');
    }
  }

  loadDepartments();
</script>
</body>
</html>
