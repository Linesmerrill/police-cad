  <!-- Config must be set before dd-components.js loads -->
  <script>
    var _API_URL = '<%= apiUrl || "" %>';
    var _departmentId = '<%= departmentId || "" %>';
    var _dbUser = <%- JSON.stringify(user) %>;
    var _communityId = _dbUser.user?.lastAccessedCommunity?.communityID || '';
    var _userId = _dbUser._id || _dbUser.user?._id || '';
    var _userName = _dbUser.user?.username || 'Officer';

    window.ddConfig = {
      API_URL: _API_URL,
      communityId: _communityId,
      userId: _userId,
      departmentId: _departmentId,
      dbUser: _dbUser,
      userName: _userName,
      currentTemplateName: 'police',
      // Community-configured currency (sourced from community.penalCodes;
      // community.fines is deprecated). Picked up by dd-economy.js's
      // fmtMoney so wallet/inbox/on-the-clock amounts render with the
      // community's chosen symbol.
      currencyCode: <%- JSON.stringify(currencyCode || 'USD') %>,
      currencySymbol: <%- JSON.stringify(currencySymbol || '$') %>
    };
    window.cdConfig = window.ddConfig;
    window.dbUser = _dbUser;

    // Active-community / civilian flags for cdRequireCivilian (Wallet/Inbox
    // sidebar gate). command-dashboard is never a civilian template, so the
    // modal always links out to the community page for civilian creation.
    window.CD_HAS_CIVILIAN_IN_COMMUNITY = <%= hasCivilianInCommunity ? 'true' : 'false' %>;
    window.CD_COMMUNITY_NAME = <%- JSON.stringify(communityName || '') %>;
    window.CD_ENCODED_COMMUNITY_ID = <%- JSON.stringify(encodedCommunityId || '') %>;

    window.cdRequireCivilian = function(event, feature) {
      if (window.CD_HAS_CIVILIAN_IN_COMMUNITY) return true;
      if (event && event.preventDefault) event.preventDefault();
      var featureLabel = feature === 'inbox' ? 'inbox' : 'wallet';
      var communityLabel = window.CD_COMMUNITY_NAME || 'this community';
      var buttons = [{ label: 'Not now', class: 'dd-modal-btn-secondary' }];
      if (window.CD_ENCODED_COMMUNITY_ID) {
        buttons.push({
          label: 'Go to civilians', class: 'dd-modal-btn-primary', icon: 'fa-arrow-right',
          href: '/community/' + window.CD_ENCODED_COMMUNITY_ID + '#civilians-section'
        });
      }
      if (!window.ddModal) return true; // helper not ready yet — let the page render its empty state
      window.ddModal({
        type: 'info',
        icon: 'fa-user-plus',
        title: 'Create a civilian first',
        message: 'The ' + featureLabel + ' is tied to a civilian, but you don\'t have one in <strong>' +
                 String(communityLabel).replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}) +
                 '</strong> yet.',
        detail: 'Add a civilian in this community to start using the ' + featureLabel + '.',
        buttons: buttons,
      });
      return false;
    };

    // Helpers needed by dd-components.js
    window.esc = function(str) {
      if (!str) return '';
      var div = document.createElement('div');
      div.appendChild(document.createTextNode(str));
      return div.innerHTML;
    };
    window.ddToast = function(msg, type) {
      var stack = document.getElementById('cd-toast-stack');
      if (!stack) return;

      var colors = { success: 'var(--cd-green)', error: 'var(--cd-red)', warning: 'var(--cd-amber)' };
      var icons = { success: 'fa-check-circle', error: 'fa-times-circle', warning: 'fa-exclamation-circle' };
      var color = colors[type] || 'var(--cd-accent)';
      var icon = icons[type] || 'fa-info-circle';

      var el = document.createElement('div');
      el.className = 'cd-toast-item';
      el.style.borderLeftColor = color;
      el.innerHTML = '<i class="fa ' + icon + ' cd-toast-icon" style="color:' + color + ';"></i><span class="cd-toast-msg">' + msg + '</span>';

      // Click to dismiss
      el.onclick = function() { dismiss(); };

      stack.appendChild(el);

      // Cap at 5 visible toasts
      while (stack.children.length > 5) {
        stack.removeChild(stack.children[0]);
      }

      // Trigger show animation
      requestAnimationFrame(function() {
        requestAnimationFrame(function() { el.classList.add('show'); });
      });

      // Auto dismiss
      var timer = setTimeout(dismiss, 3000);
      function dismiss() {
        clearTimeout(timer);
        el.classList.remove('show');
        el.classList.add('hide');
        setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 250);
      }
    };
    window.cdToast = window.ddToast;
  </script>

  <!-- ════════════════════════════════════════════════════════
       Sidebar — Identity card wiring

       Two credential rows share one shape language but live different
       lives. Both stay hidden until their data is confirmed:

       • Rank row     — populated by mirroring #sidebar-rank-text (filled
                        by public/js/rank-progress.js) into #cd-rank-value.
                        Click → window.cdShowRankPanel() (defined below).
       • Call-sign row — fetched directly from
                         /api/v1/community/{cid}/members/{uid}/department-callsigns.
                         Click pill → inline edit (Enter saves, Esc/blur
                         cancels). Hidden if no dept context.
       ════════════════════════════════════════════════════════ -->
  <script>
  (function () {
    'use strict';

    // ── Rank credential — mirror partial text + bind modal ──
    (function bindRank() {
      var src = document.getElementById('sidebar-rank-text');
      var dst = document.getElementById('cd-rank-value');
      var row = document.getElementById('cd-cred-rank');
      if (!src || !dst || !row) {
        // Rank partial / row not in DOM yet — try again until it is.
        if (bindRank._attempts === undefined) bindRank._attempts = 0;
        if (++bindRank._attempts > 30) return;
        setTimeout(bindRank, 500);
        return;
      }

      function sync() {
        var t = (src.textContent || '').trim();
        if (t) {
          dst.textContent = t;
          row.hidden = false;
        } else {
          row.hidden = true;
        }
      }
      sync();
      // rank-progress.js writes to src after an async fetch — observe
      // so we update the moment the data lands.
      try {
        new MutationObserver(sync).observe(src, { childList: true, characterData: true, subtree: true });
      } catch (e) { /* MutationObserver unavailable — first sync is enough */ }

      row.addEventListener('click', function (e) {
        e.preventDefault();
        if (typeof window.cdShowRankPanel === 'function') {
          window.cdShowRankPanel();
        }
      });
    })();

    // ── Call-sign credential — fetch + inline edit ──
    var cfg = window.ddConfig || {};
    var apiBase = cfg.API_URL || '';
    var communityId = cfg.communityId || '';
    var userId = cfg.userId || '';
    var deptId = cfg.departmentId || '';
    if (!apiBase || !communityId || !userId || !deptId) return;

    var row = document.getElementById('cd-callsign-row');
    var pill = document.getElementById('cd-callsign-pill');
    var valueEl = document.getElementById('cd-callsign-value');
    var input = document.getElementById('cd-callsign-input');
    var contextEls = document.querySelectorAll('.cd-callsign-context');
    if (!row || !pill || !valueEl || !input) return;

    // Server-rendered department name + the user's profile-level call
    // sign. Used as a fallback display when no department-specific call
    // sign is set, and to disclose which scope the visible value comes
    // from in the credential's label parenthetical.
    var deptName = <%- JSON.stringify(typeof departmentName !== 'undefined' && departmentName ? departmentName : '') %>;
    var profileCallSign = (cfg.dbUser && cfg.dbUser.user && cfg.dbUser.user.callSign) ? String(cfg.dbUser.user.callSign) : '';

    var current = '';        // value currently displayed
    var currentSource = '';  // 'dept' | 'profile' | 'empty'
    var saving = false;
    var endpoint = apiBase + '/api/v1/community/' + encodeURIComponent(communityId) +
                   '/members/' + encodeURIComponent(userId) + '/department-callsigns';

    function setContext(source) {
      var label = '';
      if (source === 'dept') label = deptName ? '(' + deptName + ')' : '';
      else if (source === 'profile') label = '(Profile)';
      for (var i = 0; i < contextEls.length; i++) contextEls[i].textContent = label;
    }

    /* Decide what to show in the row given the latest dept-callsign
       fetch result:
         • dept value present  → show it, label "(DeptName)"
         • dept value empty,
           profile value present → show profile, label "(Profile)"
         • neither → "Set call sign" placeholder, no label suffix
       Returns the displayed string so callers can sync globals. */
    function paintFromMap(deptValue) {
      if (deptValue) {
        current = deptValue;
        currentSource = 'dept';
        valueEl.textContent = deptValue;
        valueEl.classList.remove('is-empty');
      } else if (profileCallSign) {
        current = profileCallSign;
        currentSource = 'profile';
        valueEl.textContent = profileCallSign;
        valueEl.classList.remove('is-empty');
      } else {
        current = '';
        currentSource = 'empty';
        valueEl.textContent = 'Set call sign';
        valueEl.classList.add('is-empty');
      }
      setContext(currentSource);
      return current;
    }

    function openEdit() {
      if (saving) return;
      // Pre-fill with the dept-level value only — never seed with the
      // profile fallback, otherwise users would unintentionally save it
      // as a department override on Enter.
      input.value = currentSource === 'dept' ? current : '';
      row.classList.add('is-editing');
      // Defer focus so the row's :focus-visible doesn't fight with the
      // input's outline before the layout settles.
      requestAnimationFrame(function () { input.focus(); input.select(); });
    }

    function closeEdit() {
      row.classList.remove('is-editing');
    }

    function flashSaved() {
      row.classList.add('is-saved');
      setTimeout(function () { row.classList.remove('is-saved'); }, 800);
    }

    function save() {
      var next = (input.value || '').trim();
      // No-op when the user typed back the dept value they already had.
      // Don't short-circuit when the visible source is 'profile', since
      // saving the same string then deliberately creates a dept override.
      if (next === current && currentSource === 'dept') { closeEdit(); return; }
      saving = true;
      row.classList.add('is-saving');
      fetch(endpoint, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ departmentId: deptId, callSign: next })
      })
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json().catch(function () { return {}; });
        })
        .then(function () {
          // Repaint with the new dept value — falls back to profile call
          // sign automatically when `next` is an empty string.
          var shown = paintFromMap(next);
          // Shared modules (cd-alerts.js panic / signal100) want the
          // resolved value regardless of source.
          window._resolvedDeptCallSign = shown || null;
          closeEdit();
          flashSaved();
        })
        .catch(function (err) {
          console.error('[cd-callsign] save failed:', err);
          if (window.ddToast) window.ddToast('Failed to update call sign', 'error');
        })
        .then(function () {
          saving = false;
          row.classList.remove('is-saving');
        });
    }

    // Initial fetch — gates row visibility. If the user has no membership
    // the API 404s and the row stays hidden (same as classic dashboards).
    fetch(endpoint)
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data) return;
        var map = data.departmentCallSigns || {};
        var shown = paintFromMap(map[deptId] || '');
        window._resolvedDeptCallSign = shown || null;
        row.hidden = false;
      })
      .catch(function () { /* silent — keep row hidden */ });

    pill.addEventListener('click', openEdit);
    // Make the icon-square clickable too — feels natural since the whole
    // row reads as a single unit. The pencil sits inside the trail and
    // already cascades because the row delegates to openEdit when a
    // non-input target is clicked while not editing.
    row.addEventListener('click', function (e) {
      if (row.classList.contains('is-editing')) return;
      // The pill button already handles its own clicks — bail to avoid
      // openEdit firing twice.
      if (e.target.closest('#cd-callsign-pill')) return;
      // Don't intercept clicks on the input or its container.
      if (e.target.closest('.cd-cred-input')) return;
      openEdit();
    });
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); save(); }
      else if (e.key === 'Escape') { e.preventDefault(); closeEdit(); }
    });
    input.addEventListener('blur', function () {
      // Slight delay so an Enter that triggered save doesn't race with
      // blur firing closeEdit before the saving state kicks in.
      setTimeout(function () {
        if (!row.classList.contains('is-editing')) return;
        if (saving) return;
        // Blur without Enter cancels — Enter is the explicit commit.
        closeEdit();
      }, 120);
    });
  })();
  </script>

