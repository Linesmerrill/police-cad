    function populateMDTColumns() {
      // Left column: render search components inline
      if (window.cdPersonSearchRender) {
        $('#cd-mdt-pane-person').html(window.cdPersonSearchRender('personSearch'));
        if (window.cdPersonSearchInit) window.cdPersonSearchInit();
      }
      if (window.cdVehicleSearchRender) {
        $('#cd-mdt-pane-vehicle').html(window.cdVehicleSearchRender('vehicleSearch'));
        if (window.cdVehicleSearchInit) window.cdVehicleSearchInit();
      }
      if (window.cdFirearmSearchRender) {
        $('#cd-mdt-pane-firearm').html(window.cdFirearmSearchRender('firearmSearch'));
        if (window.cdFirearmSearchInit) window.cdFirearmSearchInit();
      }

      // Center column: render calls inline
      if (window.cdCallsRender) {
        $('#cd-mdt-calls-content').html(window.cdCallsRender('activeCalls'));
        if (window.cdCallsInit) window.cdCallsInit();
      }

      // Right column: render BOLOs inline
      if (window.cdBolosRender) {
        $('#cd-mdt-intel-content').html(window.cdBolosRender('createBolos'));
        if (window.cdBolosInit) window.cdBolosInit();
      }

      // Update status badge
      loadMDTStatus();

      // Sync MDT column header counts from component badges
      setInterval(function() {
        var callCount = $('#cd-call-count').text() || '0';
        $('#cd-mdt-calls-count').text(callCount);
        $('#cd-mdt-mob-calls').text(callCount);
        // BOLOs: count visible active items
        var boloItems = $('#cd-mdt-intel-content .cd-bolo-item').not('.cd-bolo-cleared').length;
        $('#cd-mdt-bolos-count').text(boloItems || '0');
      }, 2000);
    }

    function loadMDTQuickCodes() {
      var communityData = (window.ddConfig || {}).communityData;
      if (!communityData) {
        // Fetch community data
        $.ajax({
          url: API_URL + '/api/v1/community/' + communityId,
          method: 'GET',
          success: function(res) {
            var community = res.community || res;
            window.ddConfig.communityData = community;
            renderMDTQuickCodes(community);
            loadMDTStatus();
          }
        });
      } else {
        renderMDTQuickCodes(communityData);
      }
    }

    function renderMDTQuickCodes(community) {
      var codes = community.tenCodes || [];
      var $row = $('#cd-mdt-quick-codes').empty();
      var maxShow = 10;
      for (var i = 0; i < Math.min(codes.length, maxShow); i++) {
        var c = codes[i];
        var isEmergency = (c.code || '').toLowerCase().indexOf('signal') !== -1;
        $row.append('<span class="cd-mdt-code-chip' + (isEmergency ? ' emergency' : '') + '" data-code-id="' + c._id + '" title="' + esc(c.description || '') + '">' + esc(c.code) + '</span>');
      }
      if (codes.length > maxShow) {
        $row.append('<span class="cd-mdt-code-chip" onclick="ddNavTo(\'10CodesInterface\')" style="color:var(--cd-accent);">+' + (codes.length - maxShow) + ' more</span>');
      }
    }

    function loadMDTStatus() {
      var communityData = (window.ddConfig || {}).communityData;
      if (!communityData) {
        // Community data not yet loaded — fetch it
        $.ajax({
          url: API_URL + '/api/v1/community/' + communityId,
          method: 'GET',
          success: function(res) {
            window.ddConfig.communityData = res.community || res;
            applyMDTStatus();
          }
        });
        return;
      }
      applyMDTStatus();
    }

    // ── Emergency buttons (immediate action) ──
    window.cdMdtSignal100 = function() {
      if (window.ddModal) {
        window.ddModal({
          type: 'danger', icon: 'fa-exclamation-triangle', title: 'Activate Signal 100',
          message: 'This will broadcast a <strong>Signal 100</strong> emergency alert to all units in the community.',
          detail: 'All radio traffic will be held except emergency communications.',
          confirmText: 'Activate Signal 100',
          onConfirm: function() {
            $.ajax({
              url: API_URL + '/api/v1/community/' + communityId + '/signal-100',
              method: 'POST', contentType: 'application/json',
              data: JSON.stringify({ userId: userId, username: userName }),
              success: function() { window.ddToast('Signal 100 activated', 'success'); if (window.cdFetchSignal100) window.cdFetchSignal100(); },
              error: function() { window.ddToast('Failed to activate Signal 100', 'error'); }
            });
          }
        });
      }
    };

    window.cdMdtPanic = function() {
      if (window.ddModal) {
        window.ddModal({
          type: 'warning', icon: 'fa-bolt', title: 'Activate Panic Alert',
          message: 'This will send a <strong>Panic Alert</strong> to all units, indicating you need immediate assistance.',
          confirmText: 'Send Panic Alert',
          onConfirm: function() {
            var deptName = (window.ddConfig.departmentData || {}).name || '';
            $.ajax({
              url: API_URL + '/api/v1/community/' + communityId + '/panic-alerts',
              method: 'POST', contentType: 'application/json',
              data: JSON.stringify({ userId: userId, username: userName, callSign: '', departmentType: currentTemplateName || 'police' }),
              success: function() { window.ddToast('Panic alert sent', 'success'); if (window.cdFetchPanicAlerts) window.cdFetchPanicAlerts(); },
              error: function() { window.ddToast('Failed to send panic alert', 'error'); }
            });
          }
        });
      }
    };

    function applyMDTStatus() {
      var communityData = (window.ddConfig || {}).communityData;
      if (!communityData) return;
      var members = communityData.members || {};
      var myMember = members[userId];
      if (!myMember || !myMember.tenCodeID) {
        $('#cd-mdt-status-text').text('No Status');
        return;
      }
      var codes = communityData.tenCodes || [];
      var active = codes.find(function(c) { return c._id === myMember.tenCodeID; });
      if (active) {
        $('#cd-mdt-status-text').text(active.code);
        var code = (active.code || '').toLowerCase();
        var desc = (active.description || '').toLowerCase();
        if (code.indexOf('signal 100') !== -1 || desc.indexOf('emergency') !== -1) {
          $('#cd-mdt-status-badge').css({ color: 'var(--cd-red)', borderColor: 'rgba(239,68,68,0.4)' });
        } else if (code.indexOf('10-8') !== -1 || code.indexOf('code 4') !== -1 || desc.indexOf('available') !== -1 || desc.indexOf('in service') !== -1 || desc.indexOf('under control') !== -1) {
          $('#cd-mdt-status-badge').css({ color: 'var(--cd-green)', borderColor: 'rgba(34,197,94,0.4)' });
        } else if (code.indexOf('10-7') !== -1 || code.indexOf('10-6') !== -1 || desc.indexOf('out of service') !== -1 || desc.indexOf('busy') !== -1) {
          $('#cd-mdt-status-badge').css({ color: 'var(--cd-amber)', borderColor: 'rgba(245,158,11,0.4)' });
        } else {
          $('#cd-mdt-status-badge').css({ color: 'var(--cd-accent)', borderColor: 'rgba(56,189,248,0.3)' });
        }
      } else {
        $('#cd-mdt-status-text').text('No Status');
      }

      // Update rank pill — poll briefly since rank loads async
      updateRankPill();
    }

    var _rankPillAttempts = 0;
    function updateRankPill() {
      var rankEl = document.getElementById('myRankName');
      if (rankEl && rankEl.textContent && rankEl.textContent.trim()) {
        $('#cd-mdt-rank-text').text(rankEl.textContent.trim());
        $('#cd-mdt-rank').show();
        _rankPillAttempts = 0;
      } else if (_rankPillAttempts < 10) {
        _rankPillAttempts++;
        setTimeout(updateRankPill, 1000); // retry every second for up to 10 seconds
      } else {
        $('#cd-mdt-rank').hide(); // no rank data — hide the pill
      }
    }

    // ══════════════════════════════════════════
    //  RANK MODAL
    // ══════════════════════════════════════════
    window.cdShowRankPanel = function() {
      var $rankCard = $('#myRankStatsCard');
      if (!$rankCard.length) {
        window.ddToast('Rank data not available', 'error');
        return;
      }

      // Remember where the card lives
      var $parent = $rankCard.parent();

      // Create overlay
      var $overlay = $('<div id="cd-rank-modal-overlay" style="position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,0.6);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.25s;cursor:pointer;padding:1rem;"></div>');
      // Outer container positions the X button; inner container scrolls
      var $outer = $('<div style="position:relative;width:90%;max-width:700px;cursor:default;"></div>');
      var $closeBtn = $('<button style="position:absolute;top:-14px;right:-14px;z-index:10;width:28px;height:28px;border-radius:50%;background:#1e293b;border:2px solid rgba(255,255,255,0.15);color:#fff;font-size:0.75rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.15s;box-shadow:0 2px 8px rgba(0,0,0,0.4);" onmouseenter="this.style.background=\'#ef4444\';this.style.borderColor=\'#ef4444\'" onmouseleave="this.style.background=\'#1e293b\';this.style.borderColor=\'rgba(255,255,255,0.15)\'"><i class="fa fa-times"></i></button>');
      var $wrap = $('<div style="max-height:80vh;overflow-y:auto;border-radius:var(--cd-radius);border:1px solid var(--cd-glass-border);background:var(--cd-bg);box-shadow:0 24px 80px rgba(0,0,0,0.5);scrollbar-width:thin;scrollbar-color:rgba(255,255,255,0.06) transparent;"></div>');

      // Move the actual card into the modal (not a clone — so buttons work)
      $rankCard.css({ display: 'block', maxWidth: '100%', margin: '0', padding: '0' });
      // Remove overflow:hidden from the card wrapper so it grows with content
      // The scrollable $wrap (max-height:80vh, overflow-y:auto) handles clipping
      $rankCard.css('overflow', 'auto');
      $rankCard.find('> div').first().css('overflow', 'auto');
      // Remove max-height constraints on collapsible sections so they expand fully
      $rankCard.find('#rankStatsCollapsible, #rankLadderCollapsible').css('max-height', 'none');
      $outer.append($closeBtn);
      $wrap.append($rankCard);
      $outer.append($wrap);
      $overlay.append($outer);
      $('body').append($overlay);

      // Prevent body scroll while modal is open
      $('body').css('overflow', 'hidden');

      requestAnimationFrame(function() { $overlay.css('opacity', '1'); });

      function closeRankModal() {
        $overlay.css('opacity', '0');
        setTimeout(function() {
          // Restore body scroll
          $('body').css('overflow', '');
          // Move the card back — restore original styles
          $rankCard.css({ maxWidth: '', margin: '', padding: '', overflow: '' });
          $rankCard.find('> div').first().css('overflow', '');
          $rankCard.find('#rankStatsCollapsible, #rankLadderCollapsible').css('max-height', '');
          $parent.append($rankCard);
          $overlay.remove();
        }, 250);
        $(document).off('keydown.rankModal');
      }

      $closeBtn.on('click', closeRankModal);
      $overlay.on('click', function(e) { if (e.target === this) closeRankModal(); });
      $(document).on('keydown.rankModal', function(e) { if (e.key === 'Escape') closeRankModal(); });
    };

    // ══════════════════════════════════════════
    //  PANEL NAVIGATION
    // ══════════════════════════════════════════
    function ddNavTo(panel) {
      // Update sidebar
      $('.cd-nav-item, .dd-nav-item').removeClass('active');
      if (panel === 'overview') {
        $('.cd-nav-item[data-panel="overview"]').addClass('active');
      } else {
        $('.dd-nav-item[data-panel="' + panel + '"]').addClass('active');
      }

      // Update topbar title
      if (panel === 'overview') {
        $('#dd-topbar-title').text('Command Center');
      } else if (componentRegistry[panel]) {
        $('#dd-topbar-title').text(componentRegistry[panel].label);
      }

      var $mdt = $('#cd-mdt-overview');
      var $focusedCards = $('#dd-focused-cards');
      var $rankWrap = $('#dd-rank-wrap');

      if (panel === 'overview') {
        // Show MDT grid, hide focused cards
        $mdt.show();
        $focusedCards.hide().children('.dd-card').hide();
        $rankWrap.hide();
        $('#dd-content').css('overflow', 'hidden');
        // Repopulate MDT columns (they were cleared when entering focused mode)
        populateMDTColumns();
      } else {
        // Clear MDT column content to avoid duplicate DOM IDs
        $('#cd-mdt-pane-person, #cd-mdt-pane-vehicle, #cd-mdt-pane-firearm').empty();
        $('#cd-mdt-calls-content, #cd-mdt-intel-content').empty();
        // Hide MDT grid, show focused card
        $mdt.hide();
        $rankWrap.hide();
        $focusedCards.show();
        $focusedCards.children('.dd-card').hide();
        var $target = $('#dd-component-' + panel);
        if ($target.length) {
          $target.show();
          var comp = componentRegistry[panel];
          if (comp && comp.init) comp.init();
        }
        $('#dd-content').css('overflow', 'auto');
      }

      if (!ddNavTo._fromPopState && window.location.hash !== '#' + panel) {
        history.pushState({ panel: panel }, '', '#' + panel);
      }
      ddNavTo._fromPopState = false;

      // Close mobile sidebar
      $('.cd-sidebar').removeClass('open');
      $('#cd-sidebar-open').css('display', '');
    }
    window.ddNavTo = ddNavTo;

    window.addEventListener('popstate', function() {
      var hash = window.location.hash.replace('#', '') || 'overview';
      if (hash === 'overview' || (componentRegistry[hash] && enabledComponents[hash])) {
        ddNavTo._fromPopState = true;
        ddNavTo(hash);
      }
    });

    // ══════════════════════════════════════════
    //  DEPT TYPE INDICATOR
    // ══════════════════════════════════════════
    function applyDeptTypeIndicator() {
      var dtc = deptTypeConfig[currentTemplateName];
      if (!dtc) return;
      var color = dtc.color;
      var labelMap = { police: 'Police', dispatch: 'Dispatch', fire: 'Fire', ems: 'EMS', civilian: 'Civilian', judicial: 'Judicial' };
      var label = labelMap[currentTemplateName] || currentTemplateName;
      var $badge = $('#dd-topbar-dept-badge');
      $badge.html('<i class="fa ' + dtc.icon + '"></i> ' + label)
        .css({ background: hexToRgba(color, 0.12), border: '1px solid ' + hexToRgba(color, 0.25), color: lightenHex(color, 0.3) })
        .show();
    }

    // ══════════════════════════════════════════
    //  MODAL SYSTEM
    // ══════════════════════════════════════════
    var ddModalTypes = {
      danger:  { accent: 'var(--dd-red)',    iconBg: 'rgba(239,68,68,0.12)',   iconColor: '#fca5a5', btnClass: 'dd-modal-btn-danger' },
      warning: { accent: 'var(--dd-amber)',  iconBg: 'rgba(245,158,11,0.12)',  iconColor: '#fcd34d', btnClass: 'dd-modal-btn-warning' },
      info:    { accent: 'var(--dd-blue)',   iconBg: 'rgba(59,130,246,0.12)',   iconColor: '#93c5fd', btnClass: 'dd-modal-btn-primary' },
      confirm: { accent: 'var(--dd-accent)', iconBg: 'rgba(56,189,248,0.12)',  iconColor: '#7dd3fc', btnClass: 'dd-modal-btn-primary' },
      success: { accent: 'var(--dd-green)',  iconBg: 'rgba(34,197,94,0.12)',   iconColor: '#86efac', btnClass: 'dd-modal-btn-primary' }
    };
    var ddModalCallback = null;

    function ddModal(opts) {
      var type = ddModalTypes[opts.type] || ddModalTypes.confirm;
      $('#dd-modal').css('--dd-modal-accent', type.accent);
      $('#dd-modal-title').html('<i class="fa ' + (opts.icon || 'fa-info-circle') + '" style="color:' + type.iconColor + ';"></i> ' + esc(opts.title || 'Confirm'));
      $('#dd-modal-icon').css('background', type.iconBg).html('<i class="fa ' + (opts.icon || 'fa-info-circle') + '" style="color:' + type.iconColor + ';font-size:1.375rem;"></i>');
      $('#dd-modal-msg').html(opts.message || '');
      if (opts.detail) { $('#dd-modal-detail').html(opts.detail).show(); } else { $('#dd-modal-detail').hide(); }

      var $footer = $('#dd-modal-footer').empty();
      if (opts.buttons) {
        opts.buttons.forEach(function(btn) {
          if (btn.href) {
            var $a = $('<a class="dd-modal-btn ' + (btn.class || 'dd-modal-btn-secondary') + '" href="' + btn.href + '"></a>');
            if (btn.icon) $a.append('<i class="fa ' + btn.icon + '"></i> ');
            $a.append(btn.label || 'OK'); $footer.append($a);
          } else {
            var $b = $('<button class="dd-modal-btn ' + (btn.class || 'dd-modal-btn-secondary') + '"></button>');
            if (btn.icon) $b.append('<i class="fa ' + btn.icon + '"></i> ');
            $b.append(btn.label || 'OK');
            $b.on('click', function() { ddCloseModal(); if (btn.onClick) btn.onClick(); });
            $footer.append($b);
          }
        });
      } else {
        var $cancel = $('<button class="dd-modal-btn dd-modal-btn-secondary"></button>').text(opts.cancelText || 'Cancel');
        $cancel.on('click', function() { ddCloseModal(); if (opts.onCancel) opts.onCancel(); });
        var $confirm = $('<button class="dd-modal-btn ' + type.btnClass + '"></button>');
        if (opts.confirmIcon) $confirm.append('<i class="fa ' + opts.confirmIcon + '"></i> ');
        $confirm.append(opts.confirmText || 'Confirm');
        $confirm.on('click', function() { ddCloseModal(); if (opts.onConfirm) opts.onConfirm(); });
        $footer.append($cancel).append($confirm);
      }
      ddModalCallback = opts.onCancel || null;
      $('#dd-modal-overlay').addClass('visible');
    }
    window.ddModal = ddModal;

    function ddCloseModal() { $('#dd-modal-overlay').removeClass('visible'); ddModalCallback = null; }
    window.ddCloseModal = ddCloseModal;

    $(document).on('click', '#dd-modal-close', function() { var cb = ddModalCallback; ddCloseModal(); if (cb) cb(); });
    $(document).on('click', '#dd-modal-overlay', function(e) { if (e.target === this) { var cb = ddModalCallback; ddCloseModal(); if (cb) cb(); } });
    $(document).on('keydown', function(e) { if (e.key === 'Escape' && $('#dd-modal-overlay').hasClass('visible')) { var cb = ddModalCallback; ddCloseModal(); if (cb) cb(); } });

    // ══════════════════════════════════════════
    //  DEPARTMENT ACCESS MODAL
    // ══════════════════════════════════════════
    function ddShowAccessModal(deptName, isPending, communityUrl) {
      if (isPending) {
        ddModal({ type: 'info', icon: 'fa-clock', title: 'Request Pending',
          message: 'Your request to join <strong>' + esc(deptName) + '</strong> is pending approval.',
          detail: 'An administrator will review your request soon.',
          buttons: [
            { label: 'Close', class: 'dd-modal-btn-secondary', onClick: function() {} },
            { label: 'Go to Community', class: 'dd-modal-btn-primary', icon: 'fa-external-link-alt', href: communityUrl }
          ]
        });
      } else {
        ddModal({ type: 'warning', icon: 'fa-lock', title: 'Access Restricted',
          message: 'You don\'t have access to the <strong>' + esc(deptName) + '</strong> department.',
          detail: 'You can request to join from the community details page.',
          buttons: [
            { label: 'Close', class: 'dd-modal-btn-secondary', onClick: function() {} },
            { label: 'Go to Community', class: 'dd-modal-btn-warning', icon: 'fa-external-link-alt', href: communityUrl }
          ]
        });
      }
    }
    window.ddShowAccessModal = ddShowAccessModal;

    // ══════════════════════════════════════════
    //  SWITCH TO CLASSIC / REFRESH
    // ══════════════════════════════════════════
    function cdSwitchToClassic() {
      var btn = document.getElementById('cd-switch-classic');
      if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa fa-spinner fa-spin" style="font-size:0.625rem;"></i> Switching...'; }
      $.ajax({
        url: API_URL + '/api/v1/user-preferences/' + encodeURIComponent(userId),
        method: 'PUT', contentType: 'application/json',
        data: JSON.stringify({ betaCommandDashboard: false, userId: userId }),
        complete: function() { window.location.href = '/police-dashboard' + window.location.search; }
      });
    }
    window.cdSwitchToClassic = cdSwitchToClassic;

    function ddRefresh() {
      cdToast('Refreshing...', 'info');
      Object.keys(componentRegistry).forEach(function(key) {
        if (enabledComponents[key] && componentRegistry[key].init) componentRegistry[key].init();
      });
      cdToast('Dashboard refreshed', 'success');
    }
    window.ddRefresh = ddRefresh;

    // ══════════════════════════════════════════
    //  SIDEBAR DEPARTMENTS
    // ══════════════════════════════════════════
    function loadSidebarDepartments() {
      if (!communityId) return;
      var encodedCommunityId = btoa(communityId).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
      $.ajax({
        url: API_URL + '/api/v1/community/' + communityId + '/departments',
        method: 'GET',
        success: function(data) {
          renderSidebarDepartments((data && data.departments) || [], encodedCommunityId);
        },
        error: function() {}
      });
    }

    function renderSidebarDepartments(departments, encodedCommunityId) {
      var $list = $('#cd-dept-list').empty();
      var currentUserId = dbUser._id || '';
      var isOwner = (dbUser.user?.lastAccessedCommunity?.ownerID || '') === currentUserId;
      var userRole = dbUser.user?.lastAccessedCommunity?.role;
      var isAdmin = userRole && userRole.admin === true;

      departments.forEach(function(dept) {
        var template = (dept.template && dept.template.name || '').toLowerCase();
        var name = dept.name || 'Unknown';
        var deptId = dept._id;
        if (!deptId || !template) return;

        var config = deptTypeConfig[template] || { icon: 'fa-building', color: '#6b7280', route: null };
        var isCurrent = deptId === departmentId;
        var members = Array.isArray(dept.members) ? dept.members : [];
        var userMembership = null;
        for (var i = 0; i < members.length; i++) {
          if ((members[i].userID || members[i]._id) === currentUserId) { userMembership = members[i]; break; }
        }
        var isApprovedMember = userMembership && userMembership.status === 'approved';
        var isPendingMember = userMembership && userMembership.status === 'pending';
        var isPublicDept = dept.approvalRequired === false;
        var canAccess = isOwner || isAdmin || isPublicDept || isApprovedMember;

        var encodedDeptId = btoa(deptId).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
        var params = '?dept=' + encodeURIComponent(name) + '&d=' + encodedDeptId + '&c=' + encodedCommunityId;
        var href = '#';
        var useFormPost = false;
        var redirect = '';
        if (canAccess) {
          if (template === 'civilian' || template === 'judicial') {
            href = '/department-dashboard' + params;
          } else if (['police', 'dispatch', 'fire', 'ems'].indexOf(template) !== -1) {
            useFormPost = true;
            if (template === 'police') redirect = '/command-dashboard' + params;
            else if (template === 'dispatch') redirect = '/dispatch-dashboard' + params;
            else redirect = '/ems-dashboard' + params;
          }
        }

        var statusHtml = '';
        if (!canAccess) {
          statusHtml = isPendingMember
            ? '<i class="fa fa-clock" style="color:#3b82f6;font-size:0.625rem;flex-shrink:0;" title="Request pending"></i>'
            : '<i class="fa fa-lock" style="color:#fbbf24;font-size:0.625rem;flex-shrink:0;" title="No access"></i>';
        }

        var classes = 'cd-dept-item' + (isCurrent ? ' current' : '') + (!canAccess ? ' locked' : '');
        var communityUrl = '/community/' + encodedCommunityId + '#departments-section';
        var safeName = name.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
        var innerHtml = '<i class="fa ' + config.icon + '" style="color:' + config.color + ';' + (!canAccess ? 'opacity:0.4;' : '') + '"></i>' +
          '<span class="cd-dept-name" style="' + (!canAccess ? 'opacity:0.4;' : '') + '">' + esc(name) + '</span>' +
          (statusHtml || '<span class="cd-dept-badge" style="background:' + config.color + ';">' + esc(template) + '</span>');

        if (!canAccess) {
          $list.append($('<a class="' + classes + '" href="#" onclick="event.preventDefault(); ddShowAccessModal(\'' + safeName + '\', ' + !!isPendingMember + ', \'' + communityUrl + '\');">' + innerHtml + '</a>'));
        } else if (useFormPost) {
          var formId = 'cd-dept-form-' + deptId;
          $list.append($('<a class="' + classes + '" href="#" onclick="event.preventDefault(); document.getElementById(\'' + formId + '\').submit();">' + innerHtml + '</a>'));
          $list.append($('<form id="' + formId + '" action="/select-department" method="POST" style="display:none;"><input type="hidden" name="departmentId" value="' + deptId + '"><input type="hidden" name="redirect" value="' + redirect + '"></form>'));
        } else {
          $list.append($('<a class="' + classes + '" href="' + href + '">' + innerHtml + '</a>'));
        }
      });
    }

    // ══════════════════════════════════════════
    //  INITIALIZE
    // ══════════════════════════════════════════
    $(document).ready(function() {
      fetchDepartmentData();
      loadSidebarDepartments();
    });

  })();
  </script>

