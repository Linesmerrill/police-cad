              '<div class="cd-mdt-launcher-item" onclick="ddNavTo(\'vehicleSearch\')"><i class="fa fa-car" style="color:var(--cd-green);"></i><span>Vehicle</span></div>' +
              '<div class="cd-mdt-launcher-item" onclick="ddNavTo(\'firearmSearch\')"><i class="fa fa-crosshairs" style="color:var(--cd-red);"></i><span>Firearm</span></div>' +
              '<div class="cd-mdt-launcher-item" onclick="ddNavTo(\'activeCalls\')"><i class="fa fa-radio" style="color:var(--cd-green);"></i><span>Calls</span><span class="cd-mdt-launcher-badge" id="cd-mdt-mob-calls">&mdash;</span></div>' +
              '<div class="cd-mdt-launcher-item" onclick="ddNavTo(\'createBolos\')"><i class="fa fa-bullhorn" style="color:var(--cd-amber);"></i><span>BOLOs</span></div>' +
              '<div class="cd-mdt-launcher-item" onclick="ddNavTo(\'10CodesInterface\')"><i class="fa fa-broadcast-tower" style="color:var(--cd-amber);"></i><span>Status</span></div>' +
