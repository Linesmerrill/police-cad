  <!-- Manage Ranks (shared partial + module) — used by dd-settings.js Ranks tab -->
  <template id="manage-ranks-tpl"><%- include('partials/manage-ranks', { rkmEmbedded: true }) %></template>
  <script src="/static/js/manage-ranks.js?v=<%= typeof buildVersion !== 'undefined' ? buildVersion : 'dev' %>"></script>
  <script>
    // Pending-promotions badge wiring (mirrors department-dashboard.ejs).
    window.ddRanksPendingCount = window.ddRanksPendingCount || {};
    window.ddRefreshRanksPendingBadge = function () {
      if (!window.manageRanks) return;
      var c = window.ddConfig || {};
      var deptId = (c.departmentData && c.departmentData._id) || '';
      window.manageRanks.configure({
        communityId: c.communityId,
        userId: c.userId
      });
      if (!deptId) return;
      window.manageRanks.fetchPendingCount(deptId).then(function (count) {
        window.ddRanksPendingCount[deptId] = count;
        var sidebar = document.getElementById('dd-settings-badge');
        if (sidebar) {
          if (count > 0) {
            sidebar.textContent = count > 99 ? '99+' : count;
            sidebar.style.display = '';
          } else {
            sidebar.style.display = 'none';
          }
        }
        var tabBadge = document.querySelector('[data-tab-badge="ranks"]');
        if (tabBadge) {
          if (count > 0) {
            tabBadge.textContent = count > 99 ? '99+' : count;
            tabBadge.style.display = '';
          } else {
            tabBadge.style.display = 'none';
          }
        }
      });
    };
    window.onPendingPromotionsCountChange = function (deptId, count) {
      window.ddRanksPendingCount[deptId] = count;
      var sidebar = document.getElementById('dd-settings-badge');
      if (sidebar) {
        if (count > 0) {
          sidebar.textContent = count > 99 ? '99+' : count;
          sidebar.style.display = '';
        } else {
          sidebar.style.display = 'none';
        }
      }
      var tabBadge = document.querySelector('[data-tab-badge="ranks"]');
      if (tabBadge) {
        if (count > 0) {
          tabBadge.textContent = count > 99 ? '99+' : count;
          tabBadge.style.display = '';
        } else {
          tabBadge.style.display = 'none';
        }
      }
    };
  </script>
