              if (enabledComponents['notepad']) tools.push('<div onclick="ddNavTo(\'notepad\')" style="display:flex;align-items:center;gap:0.625rem;padding:0.625rem 0.75rem;border-radius:var(--cd-radius-sm);background:var(--cd-glass);border:1px solid var(--cd-glass-border);cursor:pointer;"><i class="fa fa-sticky-note" style="color:var(--cd-amber);font-size:0.75rem;width:1.25rem;text-align:center;"></i><span style="font-size:0.8125rem;color:var(--cd-text-muted);font-weight:500;">Notepad</span><i class="fa fa-chevron-right" style="margin-left:auto;font-size:0.625rem;color:var(--cd-text-dim);"></i></div>');
              if (enabledComponents['courtCases']) tools.push('<div onclick="ddNavTo(\'courtCases\')" style="display:flex;align-items:center;gap:0.625rem;padding:0.625rem 0.75rem;border-radius:var(--cd-radius-sm);background:var(--cd-glass);border:1px solid var(--cd-glass-border);cursor:pointer;"><i class="fa fa-briefcase" style="color:var(--cd-accent);font-size:0.75rem;width:1.25rem;text-align:center;"></i><span style="font-size:0.8125rem;color:var(--cd-text-muted);font-weight:500;">Court Cases</span><i class="fa fa-chevron-right" style="margin-left:auto;font-size:0.625rem;color:var(--cd-text-dim);"></i></div>');
