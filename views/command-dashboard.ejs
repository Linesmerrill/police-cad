<!DOCTYPE html>
<html>

<head>
  <%- include('ad-header') %>
  <title>LPC - <%= departmentName || 'Command' %> Dashboard</title>
  <meta charset="utf-8">
  <meta name="description" content="Lines Roleplay Police CAD. Built to facilitate the needs of roleplay police and civilians." />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="shortcut icon" type="image/ico" href="static/images/favicon.ico">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/dd-components.css">
  <link rel="stylesheet" href="/static/css/cd-dispatch.css">
  <script src="/static/js/jquery.min.js?v=<%= typeof buildVersion !== 'undefined' ? buildVersion : 'dev' %>"></script>
  <style>
    /* ===================================================
       COMMAND DASHBOARD — Tactical Command Center
       =================================================== */

    :root {
      --cd-bg: #050a12;
      --cd-surface: rgba(255, 255, 255, 0.03);
      --cd-glass: rgba(255, 255, 255, 0.04);
      --cd-glass-border: rgba(255, 255, 255, 0.06);
      --cd-glass-hover: rgba(255, 255, 255, 0.07);
      --cd-text: #e2e8f0;
      --cd-text-muted: #64748b;
      --cd-text-dim: #475569;
      --cd-accent: #38bdf8;
      --cd-accent-glow: rgba(56, 189, 248, 0.15);
      --cd-green: #22c55e;
      --cd-red: #ef4444;
      --cd-amber: #f59e0b;
      --cd-blue: #3b82f6;
      --cd-sidebar-w: 280px;
      --cd-radius: 12px;
      --cd-radius-sm: 8px;
      /* Alias dd- vars so dd-*.js component CSS works */
      --dd-bg: var(--cd-bg);
      --dd-surface: var(--cd-surface);
      --dd-glass: var(--cd-glass);
      --dd-glass-border: var(--cd-glass-border);
      --dd-glass-hover: var(--cd-glass-hover);
      --dd-text: var(--cd-text);
      --dd-text-muted: var(--cd-text-muted);
      --dd-text-dim: var(--cd-text-dim);
      --dd-accent: var(--cd-accent);
      --dd-accent-glow: var(--cd-accent-glow);
      --dd-green: var(--cd-green);
      --dd-red: var(--cd-red);
      --dd-amber: var(--cd-amber);
      --dd-blue: var(--cd-blue);
      --dd-radius: var(--cd-radius);
      --dd-radius-sm: var(--cd-radius-sm);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; -webkit-text-size-adjust: 100%; }

    body.cd-body {
      margin: 0;
      padding: 0;
      background: var(--cd-bg);
      color: var(--cd-text);
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Ambient background mesh */
    .cd-bg-mesh {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background:
        radial-gradient(ellipse 80% 60% at 10% 20%, rgba(56, 189, 248, 0.06) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 85% 75%, rgba(59, 130, 246, 0.05) 0%, transparent 55%),
        radial-gradient(ellipse 50% 40% at 50% 50%, rgba(56, 189, 248, 0.03) 0%, transparent 50%);
      animation: cd-mesh-drift 30s ease-in-out infinite alternate;
    }
    @keyframes cd-mesh-drift { 0% { filter: hue-rotate(0deg); opacity: 1; } 100% { filter: hue-rotate(15deg); opacity: 0.8; } }

    .cd-grain {
      position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: 0.03;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-size: 200px;
    }

    /* ---- Sidebar ----
       Use 100dvh on top of the 100vh fallback so mobile browsers (Safari)
       size the sidebar to the *visible* viewport — otherwise the footer
       (rank + call-sign cards) gets pushed behind the bottom URL bar. */
    .cd-sidebar {
      position: fixed; top: 0; left: 0; width: var(--cd-sidebar-w);
      height: 100vh;
      height: 100dvh;
      background: rgba(5, 10, 18, 0.85);
      backdrop-filter: blur(24px) saturate(1.2); -webkit-backdrop-filter: blur(24px) saturate(1.2);
      border-right: 1px solid var(--cd-glass-border);
      display: flex; flex-direction: column; z-index: 100;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .cd-sidebar-header { padding: 1.25rem 1.25rem 1rem; border-bottom: 1px solid var(--cd-glass-border); }
    .cd-sidebar-brand { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--cd-text); font-weight: 600; font-size: 0.8125rem; }
    .cd-sidebar-brand img { width: 1.5rem; height: 1.5rem; border-radius: 6px; }
    .cd-sidebar-dept { font-size: 1rem; font-weight: 600; margin-top: 0.75rem; color: var(--cd-text); line-height: 1.3; }
    .cd-sidebar-community { font-size: 0.6875rem; color: var(--cd-text-muted); margin-top: 0.25rem; display: flex; align-items: center; gap: 0.375rem; }
    .cd-sidebar-community i { font-size: 0.375rem; color: var(--cd-green); }
    .cd-sidebar-close { display: none; background: none; border: none; color: var(--cd-text-muted); font-size: 1rem; cursor: pointer; padding: 0.25rem; }

    .cd-sidebar-nav { flex: 1; overflow-y: auto; padding: 0.75rem 0; }
    .cd-nav-section { padding: 0 0.75rem; margin-bottom: 0.5rem; }
    .cd-nav-section-label { font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--cd-text-dim); padding: 0.5rem 0.625rem 0.375rem; }
    .cd-nav-item { display: flex; align-items: center; gap: 0.625rem; padding: 0.5rem 0.625rem; border-radius: var(--cd-radius-sm); color: var(--cd-text-muted); text-decoration: none; font-size: 0.8125rem; font-weight: 400; cursor: pointer; transition: all 0.15s; border: 1px solid transparent; position: relative; }
    .cd-nav-item:hover { background: var(--cd-glass-hover); color: var(--cd-text); }
    .cd-nav-item.active { background: var(--cd-accent-glow); color: var(--cd-accent); font-weight: 500; border-color: rgba(56, 189, 248, 0.2); }
    .cd-nav-item i { width: 1.125rem; text-align: center; font-size: 0.8125rem; }
    .cd-nav-item.is-locked { opacity: 0.7; }
    .cd-nav-item.is-locked:hover { opacity: 1; }
    .cd-nav-lock { margin-left: auto; font-size: 0.625rem !important; width: auto !important; color: var(--cd-text-dim); }
    /* Small NEW badge — appears next to recently-shipped nav items.
       Auto-hides after the cutoff date so we don't have to remember
       to remove it.
       inline-flex + align-items: center handles vertical alignment
       against the sibling icon; the asymmetric horizontal padding
       compensates for the trailing letter-spacing on "W" so the
       glyphs sit optically centered inside the pill. */
    .cd-nav-new {
      margin-left: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 16px;
      padding: 0 0.45rem 0 calc(0.45rem + 0.06em);
      font-size: 0.55rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border-radius: 999px;
      background: rgba(34, 197, 94, 0.12);
      color: #4ade80;
      border: 1px solid rgba(34, 197, 94, 0.3);
      line-height: 1;
    }
    .cd-nav-item.is-locked + .cd-nav-new,
    .cd-nav-item .cd-nav-lock + .cd-nav-new { margin-left: 0.35rem; }

    /* Also style dd-nav-item for component nav built by buildSidebarNav */
    .dd-nav-item { display: flex; align-items: center; gap: 0.625rem; padding: 0.5rem 0.625rem; border-radius: var(--cd-radius-sm); color: var(--cd-text-muted); text-decoration: none; font-size: 0.8125rem; font-weight: 400; cursor: pointer; transition: all 0.15s; border: 1px solid transparent; position: relative; }
    .dd-nav-item:hover { background: var(--cd-glass-hover); color: var(--cd-text); }
    .dd-nav-item.active { background: var(--cd-accent-glow); color: #fff; font-weight: 500; border-color: rgba(56, 189, 248, 0.2); }
    .dd-nav-item i { width: 1.125rem; text-align: center; font-size: 0.8125rem; }

    /* Glass-style Beta pill, used inline next to nav labels. Time-gated
       in markup — auto-disappears after the cutoff date. */
    .cd-nav-beta {
      margin-left: auto;
      padding: 1px 6px;
      border-radius: 4px;
      background: linear-gradient(135deg, rgba(99,102,241,0.18), rgba(168,85,247,0.18));
      color: #c4b5fd;
      border: 1px solid rgba(139,92,246,0.32);
      font-size: 0.55rem;
      font-weight: 700;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      line-height: 1.45;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .cd-nav-beta + .cd-nav-badge,
    .cd-nav-beta + .dd-nav-badge { margin-left: 0.35rem; }

    /* Nav badge */
    .cd-nav-badge, .dd-nav-badge { margin-left: auto; background: var(--cd-accent); color: #fff; font-size: 0.625rem; font-weight: 700; padding: 0.125rem 0.5rem; border-radius: 99px; min-width: 20px; text-align: center; line-height: 1.4; animation: cd-badge-pulse 2s ease-in-out infinite; }
    @keyframes cd-badge-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
    @keyframes cd-beta-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }

    /* Departments list */
    .cd-dept-list { max-height: 180px; overflow-y: auto; margin: 0 -0.25rem; padding: 0 0.25rem; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.08) transparent; }
    .cd-dept-list::-webkit-scrollbar { width: 4px; }
    .cd-dept-list::-webkit-scrollbar-track { background: transparent; }
    .cd-dept-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 2px; }
    .cd-dept-item { display: flex; align-items: center; gap: 0.625rem; padding: 0.5rem 0.75rem; border-radius: var(--cd-radius-sm); color: var(--cd-text-muted); text-decoration: none; font-size: 0.75rem; font-weight: 500; cursor: pointer; transition: all 0.15s ease; border: 1px solid transparent; white-space: nowrap; overflow: hidden; }
    .cd-dept-item:hover { color: var(--cd-text); background: var(--cd-glass-hover); }
    .cd-dept-item.current { color: #fff; background: var(--cd-accent-glow); border-color: rgba(56, 189, 248, 0.2); }
    .cd-dept-item.locked { cursor: not-allowed; }
    .cd-dept-item.locked:hover { background: transparent; color: var(--cd-text-muted); }
    .cd-dept-item i { width: 16px; text-align: center; font-size: 0.75rem; flex-shrink: 0; }
    .cd-dept-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .cd-dept-badge { font-size: 0.5625rem; font-weight: 700; padding: 0.0625rem 0.375rem; border-radius: 99px; text-transform: uppercase; letter-spacing: 0.03em; flex-shrink: 0; color: #fff; }

    /* ── Sidebar footer — Identity card ──
       Two-zone layout. Top row is the identity head (avatar + name +
       role). Below it, a stack of credential rows that share one shape
       language: same rounded rect, same icon-square, same label/value
       pair. Different functions (rank → modal, call sign → inline edit)
       but visually a family. */
    .cd-sidebar-footer {
      padding: 0.875rem 0.875rem max(1rem, env(safe-area-inset-bottom));
      border-top: 1px solid var(--cd-glass-border);
    }
    .cd-id-card { display: flex; flex-direction: column; gap: 0.625rem; }

    /* ─ Identity head ─ */
    .cd-id-head { display: flex; align-items: center; gap: 0.625rem; padding: 0.125rem; }
    .cd-id-avatar { flex-shrink: 0; text-decoration: none; color: inherit; border-radius: 50%; transition: transform 0.18s cubic-bezier(0.16,1,0.3,1); display: block; }
    .cd-id-avatar:hover { transform: translateY(-1px); }
    .cd-id-avatar:focus-visible { outline: 2px solid var(--cd-accent); outline-offset: 3px; }
    .cd-id-avatar .cd-user-avatar { width: 2.25rem; height: 2.25rem; }
    .cd-id-name-link { flex: 1; min-width: 0; text-decoration: none; color: inherit; padding: 0.18rem 0.375rem; border-radius: 6px; transition: background 0.15s; }
    .cd-id-name-link:hover { background: var(--cd-glass-hover); }
    .cd-id-name-link:hover .cd-id-name { color: var(--cd-accent); }
    .cd-id-name { font-size: 0.875rem; font-weight: 600; color: var(--cd-text); line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color 0.15s; }
    .cd-id-role { font-size: 0.6875rem; color: var(--cd-text-muted); line-height: 1.3; margin-top: 0.0625rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* legacy aliases — some shared modules write the role into these
       classes; keep them consistent with the new typography */
    .cd-user-avatar { width: 2rem; height: 2rem; border-radius: 50%; background: var(--cd-accent-glow); color: var(--cd-accent); display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 0.75rem; overflow: hidden; flex-shrink: 0; }
    .cd-user-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .cd-user-info { min-width: 0; flex: 1; }
    .cd-user-name { font-size: 0.875rem; font-weight: 600; color: var(--cd-text); }
    .cd-user-role, .cd-user-role-default { font-size: 0.6875rem; color: var(--cd-text-muted); }

    /* ─ Credentials zone ─ */
    .cd-id-creds { display: flex; flex-direction: column; gap: 0.4rem; }

    .cd-cred-row {
      display: flex; align-items: center; gap: 0.55rem;
      width: 100%; padding: 0.45rem 0.55rem;
      background: var(--cd-glass); border: 1px solid var(--cd-glass-border);
      border-radius: 10px;
      font-family: inherit; color: var(--cd-text); text-align: left;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, transform 0.18s cubic-bezier(0.16,1,0.3,1);
    }
    button.cd-cred-row { appearance: none; }
    .cd-cred-row:hover { background: var(--cd-glass-hover); border-color: rgba(56,189,248,0.28); transform: translateY(-1px); }
    .cd-cred-row:focus-visible { outline: 2px solid var(--cd-accent); outline-offset: 2px; }
    .cd-cred-row[hidden] { display: none; }

    .cd-cred-icon {
      flex-shrink: 0;
      width: 1.625rem; height: 1.625rem;
      display: inline-flex; align-items: center; justify-content: center;
      border-radius: 7px;
      background: var(--cd-accent-glow); color: var(--cd-accent);
      font-size: 0.75rem;
    }

    .cd-cred-display, .cd-cred-editor {
      flex: 1; min-width: 0;
      display: flex; flex-direction: column; gap: 0;
      background: transparent; border: 0; padding: 0;
      text-align: left; cursor: pointer; color: inherit; font-family: inherit;
    }
    .cd-cred-editor { gap: 0.0625rem; }
    .cd-cred-label {
      font-size: 0.5625rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--cd-text-dim);
      line-height: 1.25;
    }
    /* Tiny parenthetical after a credential label — e.g. "CALL SIGN (LSPD)"
       or "CALL SIGN (Profile)" — to disclose the source/scope without
       competing with the uppercase tracked label itself. */
    .cd-cred-label-context {
      font-size: 0.5625rem; font-weight: 500;
      letter-spacing: 0.04em; text-transform: none;
      color: var(--cd-text-muted);
      margin-left: 0.2rem;
      max-width: 7.5rem;
      display: inline-block; vertical-align: bottom;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .cd-cred-label-context:empty { display: none; }
    .cd-cred-value {
      font-size: 0.8125rem; font-weight: 600; color: var(--cd-text);
      line-height: 1.25;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cd-cred-value.is-empty { font-style: italic; font-weight: 500; color: var(--cd-text-dim); }

    .cd-cred-trail {
      flex-shrink: 0;
      display: inline-flex; align-items: center; justify-content: center;
      width: 1rem; height: 1rem;
      color: var(--cd-text-dim); font-size: 0.6875rem;
      transition: color 0.15s, transform 0.15s;
    }
    .cd-cred-row:hover .cd-cred-trail { color: var(--cd-accent); }
    .cd-cred-row:hover .cd-cred-chevron { transform: translateX(2px); }

    /* Call-sign editor swap (display → input → spinner) */
    .cd-cred-callsign .cd-cred-editor { display: none; }
    .cd-cred-callsign.is-editing .cd-cred-display { display: none; }
    .cd-cred-callsign.is-editing .cd-cred-editor { display: flex; }
    .cd-cred-callsign.is-editing { cursor: text; border-color: rgba(56,189,248,0.5); box-shadow: 0 0 0 3px var(--cd-accent-glow); transform: none; }
    .cd-cred-callsign.is-editing:hover { transform: none; background: var(--cd-glass); }
    .cd-cred-callsign.is-editing .cd-cred-pencil { display: none; }
    .cd-cred-spinner { display: none; color: var(--cd-accent); }
    .cd-cred-callsign.is-saving .cd-cred-pencil { display: none; }
    .cd-cred-callsign.is-saving .cd-cred-spinner { display: inline-flex; }
    .cd-cred-input {
      width: 100%;
      background: transparent; border: 0; outline: 0; padding: 0;
      color: var(--cd-text);
      font-family: inherit; font-size: 0.8125rem; font-weight: 600;
      line-height: 1.25;
    }
    .cd-cred-input::placeholder { color: var(--cd-text-dim); font-weight: 500; font-style: italic; }
    .cd-cred-callsign.is-saved {
      background: rgba(34,197,94,0.1); border-color: rgba(34,197,94,0.32);
      transition: background 0.5s, border-color 0.5s;
    }
    .cd-cred-callsign.is-saved .cd-cred-icon { background: rgba(34,197,94,0.16); color: var(--cd-green); }
    .cd-cred-callsign.is-saved .cd-cred-value { color: var(--cd-green); }

    /* The shared rank-sidebar-badge partial stays in the DOM (so
       rank-progress.js still populates #sidebar-rank-text) but is
       visually replaced by .cd-cred-rank above. */
    .cd-rank-mirror, .cd-rank-mirror #sidebar-rank-badge { display: none !important; }

    /* ---- Main area ---- */
    .cd-main { margin-left: var(--cd-sidebar-w); min-height: 100vh; position: relative; z-index: 1; }

    .cd-topbar { display: flex; align-items: center; justify-content: space-between; padding: 0 1.5rem; height: 3.5rem; border-bottom: 1px solid var(--cd-glass-border); background: rgba(5, 10, 18, 0.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 50; }
    .cd-topbar-left { display: flex; align-items: center; gap: 0.75rem; }
    .cd-topbar-title { font-size: 0.9375rem; font-weight: 600; color: var(--cd-text); }
    .cd-topbar-actions { display: flex; align-items: center; gap: 0.375rem; }
    .cd-topbar-btn { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border-radius: var(--cd-radius-sm); border: 1px solid var(--cd-glass-border); background: var(--cd-glass); color: var(--cd-text-muted); font-size: 0.8125rem; cursor: pointer; transition: all 0.15s; text-decoration: none; }
    .cd-topbar-btn:hover { background: var(--cd-glass-hover); color: var(--cd-text); }
    .cd-topbar-dept-badge { display: none; font-size: 0.625rem; font-weight: 600; padding: 0.125rem 0.5rem; border-radius: 99px; letter-spacing: 0.02em; }

    /* ---- Content ---- */
    .cd-content { padding: 1.5rem; }

    /* Loading spinner */
    .cd-spinner { display: flex; align-items: center; justify-content: center; padding: 4rem 0; }
    .cd-spinner::after { content: ''; width: 2rem; height: 2rem; border: 2px solid var(--cd-glass-border); border-top-color: var(--cd-accent); border-radius: 50%; animation: cd-spin 0.8s linear infinite; }
    @keyframes cd-spin { to { transform: rotate(360deg); } }

    /* Mobile sidebar toggle */
    .cd-sidebar-toggle { display: none; width: 2.25rem; height: 2.25rem; border-radius: var(--cd-radius-sm); border: 1px solid var(--cd-glass-border); background: var(--cd-glass); color: var(--cd-text-muted); font-size: 1rem; cursor: pointer; align-items: center; justify-content: center; transition: all 0.15s; }
    .cd-sidebar-toggle:hover { background: var(--cd-glass-hover); color: var(--cd-text); }

    /* Toast stack */
    .cd-toast-stack { position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 9999; display: flex; flex-direction: column-reverse; gap: 0.5rem; pointer-events: none; }
    .cd-toast-item { background: rgba(5,10,18,0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid var(--cd-glass-border); border-radius: var(--cd-radius-sm); padding: 0.625rem 1rem; font-size: 0.8125rem; color: var(--cd-text); pointer-events: auto; opacity: 0; transform: translateY(0.5rem) scale(0.97); transition: all 0.25s cubic-bezier(0.4,0,0.2,1); border-left: 3px solid var(--cd-accent); display: flex; align-items: center; gap: 0.5rem; max-width: 22rem; cursor: pointer; }
    .cd-toast-item.show { opacity: 1; transform: translateY(0) scale(1); }
    .cd-toast-item.hide { opacity: 0; transform: translateY(-0.5rem) scale(0.97); }
    .cd-toast-icon { font-size: 0.875rem; flex-shrink: 0; }
    .cd-toast-msg { flex: 1; line-height: 1.4; }

    /* ═══ dd- classes reused from department-dashboard for component compatibility ═══ */

    /* Stats sections */
    .dd-stats-sections { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
    .dd-stats-section { background: var(--dd-glass); border: 1px solid var(--dd-glass-border); border-radius: var(--dd-radius); padding: 1rem 1.125rem; position: relative; overflow: hidden; }
    .dd-stats-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--section-accent, var(--dd-accent)); opacity: 0.5; }
    .dd-stats-section-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.875rem; }
    .dd-stats-section-icon { width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; background: rgba(255,255,255,0.04); color: var(--section-accent, var(--dd-accent)); border: 1px solid rgba(255,255,255,0.06); }
    .dd-stats-section-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--dd-text-muted); }
    .dd-stats-section-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
    .dd-stat-mini { text-align: center; padding: 0.5rem 0.25rem; border-radius: var(--dd-radius-sm); background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.03); transition: border-color 0.2s, background 0.2s; }
    .dd-stat-mini:hover { border-color: rgba(255,255,255,0.08); background: rgba(255,255,255,0.04); }
    .dd-stat-mini-value { font-size: 1.35rem; font-weight: 700; color: #fff; line-height: 1; margin-bottom: 0.2rem; font-variant-numeric: tabular-nums; }
    .dd-stat-mini-label { font-size: 0.6rem; color: var(--dd-text-dim); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
    .dd-stat-mini-value.accent { color: var(--dd-accent); }
    .dd-stat-mini-value.green { color: var(--dd-green); }
    .dd-stat-mini-value.red { color: var(--dd-red); }
    .dd-stat-mini-value.amber { color: var(--dd-amber); }
    .dd-stat-mini-value.blue { color: var(--dd-blue); }

    /* Glass Card */
    .dd-card { background: var(--dd-glass); border: 1px solid var(--dd-glass-border); border-radius: var(--dd-radius); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); overflow: hidden; transition: border-color 0.2s, box-shadow 0.2s; position: relative; }
    .dd-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--card-accent, var(--dd-glass-border)); opacity: 0.7; z-index: 1; }
    .dd-card:hover { border-color: rgba(255, 255, 255, 0.1); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2); }
    .dd-card-header { padding: 1.125rem 1.25rem; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--dd-glass-border); }
    .dd-card-header-left { display: flex; align-items: center; gap: 0.625rem; }
    .dd-card-icon { width: 32px; height: 32px; border-radius: var(--dd-radius-sm); display: flex; align-items: center; justify-content: center; font-size: 0.875rem; flex-shrink: 0; }
    .dd-card-title { font-size: 0.875rem; font-weight: 600; color: var(--dd-text); margin: 0; }
    .dd-card-subtitle { font-size: 0.6875rem; color: var(--dd-text-dim); margin: 0; }
    .dd-card-body { padding: 1.25rem; }

    /* Component Grid */
    .dd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .dd-grid-full { grid-column: 1 / -1; }

    /* Empty state */
    .dd-empty { text-align: center; padding: 2rem 1rem; color: var(--dd-text-muted); }
    .dd-empty-icon-wrap { width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.04); display: flex; align-items: center; justify-content: center; margin: 0 auto 0.75rem; }
    .dd-empty-icon-wrap i { font-size: 1.125rem; color: var(--dd-text-dim); }
    .dd-empty > i { font-size: 2rem; margin-bottom: 0.75rem; display: block; opacity: 0.3; }
    .dd-empty-title { font-size: 0.8125rem; font-weight: 600; color: var(--dd-text); margin-bottom: 0.25rem; }
    .dd-empty-sub { font-size: 0.75rem; color: var(--dd-text-dim); }
    .dd-empty p { font-size: 0.8125rem; }

    .dd-overview-hidden { display: none !important; }

    /* Spinner (for dd components) */
    .dd-spinner { display: flex; align-items: center; justify-content: center; padding: 3rem 0; }
    .dd-spinner::after { content: ''; width: 2rem; height: 2rem; border: 2px solid var(--dd-glass-border); border-top-color: var(--dd-accent); border-radius: 50%; animation: cd-spin 0.8s linear infinite; }

    /* Animate in */
    .dd-animate-in { opacity: 0; transform: translateY(12px); animation: dd-fade-in 0.4s ease forwards; }
    @keyframes dd-fade-in { to { opacity: 1; transform: translateY(0); } }

    /* Warrant mode banner */
    .dd-warrant-mode-banner { display: flex; align-items: flex-start; gap: 0.875rem; padding: 1rem 1.25rem; margin-bottom: 1.5rem; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: var(--dd-radius); color: var(--dd-text); font-size: 0.8125rem; line-height: 1.5; }
    .dd-warrant-mode-banner i { color: var(--dd-amber); font-size: 1.125rem; margin-top: 0.125rem; flex-shrink: 0; }

    /* Modal (dd-modal) */
    .dd-modal-overlay { position: fixed; inset: 0; z-index: 10001; background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1); }
    .dd-modal-overlay.visible { opacity: 1; pointer-events: auto; }
    .dd-modal { background: rgba(16, 17, 24, 0.97); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--dd-radius); width: 90%; max-width: 400px; overflow: hidden; transform: scale(0.92) translateY(12px); transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1); box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5), 0 0 1px rgba(255, 255, 255, 0.05) inset; position: relative; }
    .dd-modal-overlay.visible .dd-modal { transform: scale(1) translateY(0); }
    .dd-modal::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--dd-modal-accent, var(--dd-accent)); opacity: 0.8; }
    .dd-modal-header { padding: 1.25rem 1.25rem 0; display: flex; align-items: center; justify-content: space-between; }
    .dd-modal-header h3 { font-size: 0.9375rem; font-weight: 600; color: var(--dd-text); margin: 0; display: flex; align-items: center; gap: 0.5rem; }
    .dd-modal-close { width: 28px; height: 28px; border-radius: var(--dd-radius-sm); background: transparent; border: none; color: var(--dd-text-dim); font-size: 0.875rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
    .dd-modal-close:hover { color: #fff; background: var(--dd-glass-hover); }
    .dd-modal-body { padding: 1.5rem 1.25rem; text-align: center; }
    .dd-modal-icon { width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; margin: 0 auto 1rem; position: relative; }
    .dd-modal-icon::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; background: inherit; opacity: 0.3; filter: blur(8px); z-index: -1; }
    .dd-modal-body p { font-size: 0.8125rem; line-height: 1.5; margin: 0 0 0.375rem; }
    .dd-modal-body .dd-modal-detail { color: var(--dd-text-dim); font-size: 0.75rem; }
    .dd-modal-footer { padding: 0 1.25rem 1.25rem; display: flex; gap: 0.5rem; }
    .dd-modal-btn { flex: 1; padding: 0.5625rem 1rem; border-radius: var(--dd-radius-sm); font-family: 'Outfit', sans-serif; font-size: 0.8125rem; font-weight: 600; cursor: pointer; border: none; transition: all 0.15s; text-decoration: none; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem; }
    .dd-modal-btn-secondary { background: var(--dd-glass); border: 1px solid var(--dd-glass-border); color: var(--dd-text-muted); }
    .dd-modal-btn-secondary:hover { color: #fff; background: var(--dd-glass-hover); }
    .dd-modal-btn-primary { background: rgba(56, 189, 248, 0.2); border: 1px solid rgba(56, 189, 248, 0.3); color: var(--dd-accent); }
    .dd-modal-btn-primary:hover { background: rgba(56, 189, 248, 0.3); border-color: rgba(56, 189, 248, 0.5); color: #fff; text-decoration: none; }
    .dd-modal-btn-danger { background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.25); color: #fca5a5; }
    .dd-modal-btn-danger:hover { background: rgba(239, 68, 68, 0.25); border-color: rgba(239, 68, 68, 0.4); color: #fff; }
    .dd-modal-btn-warning { background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.25); color: #fcd34d; }
    .dd-modal-btn-warning:hover { background: rgba(245, 158, 11, 0.25); border-color: rgba(245, 158, 11, 0.4); color: #fff; }

    /* ── Rank card theme override (inline purple → command blue/cyan) ── */
    #dd-rank-wrap #myRankStatsCard { max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
    #dd-rank-wrap #myRankStatsCard > div {
      background: var(--cd-glass) !important;
      border: 1px solid var(--cd-glass-border) !important;
      border-radius: var(--cd-radius) !important;
      box-shadow: none !important;
    }
    #dd-rank-wrap #myRankStatsCard > div::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: var(--cd-accent); opacity: 0.5; border-radius: var(--cd-radius) var(--cd-radius) 0 0;
    }
    #dd-rank-wrap #myRankStatsCard > div { position: relative; overflow: hidden; }
    /* Icon */
    #dd-rank-wrap [style*="rgba(124,58,237"] { background: rgba(56,189,248,0.12) !important; border-color: rgba(56,189,248,0.25) !important; }
    #dd-rank-wrap .fa-shield { color: var(--cd-accent) !important; }
    /* Prefix badge */
    #dd-rank-wrap #myRankPrefix { background: rgba(56,189,248,0.15) !important; color: var(--cd-accent) !important; }
    /* Progress bars */
    #dd-rank-wrap #rankProgressBars { scrollbar-color: rgba(56,189,248,0.3) transparent !important; }
    #dd-rank-wrap [style*="background:linear-gradient"][style*="7c3aed"] { background: linear-gradient(90deg, var(--cd-accent), #7dd3fc) !important; }
    #dd-rank-wrap #rankProgressFade { background: linear-gradient(to top, var(--cd-bg) 0%, transparent 100%) !important; }
    /* Buttons (activity toggle, rank ladder) */
    #dd-rank-wrap button[style*="rgba(124,58,237"] {
      background: rgba(56,189,248,0.08) !important;
      border-color: rgba(56,189,248,0.15) !important;
      color: var(--cd-accent) !important;
    }
    #dd-rank-wrap button[style*="rgba(124,58,237"]:hover {
      background: rgba(56,189,248,0.14) !important;
    }
    /* Stats grid items */
    #dd-rank-wrap [style*="border:1px solid rgba(124,58,237"] {
      border-color: var(--cd-glass-border) !important;
      background: var(--cd-glass) !important;
    }

    /* ══════ MDT GRID LAYOUT ══════ */
    .cd-mdt { display: flex; flex-direction: column; height: calc(100vh - 3.5rem); overflow: hidden; }

    /* Status bar */
    .cd-mdt-status { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; background: rgba(0,0,0,0.3); border-bottom: 1px solid var(--cd-glass-border); flex-shrink: 0; flex-wrap: wrap; }
    .cd-mdt-status-code { display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.75rem; background: var(--cd-glass); border: 1px solid var(--cd-glass-border); border-radius: var(--cd-radius-sm); font-size: 0.75rem; font-weight: 600; color: var(--cd-accent); cursor: pointer; transition: all 0.15s; }
    .cd-mdt-status-code:hover { background: var(--cd-glass-hover); border-color: rgba(56,189,248,0.3); }
    .cd-mdt-status-code i { font-size: 0.625rem; }
    .cd-mdt-btn-signal { padding: 0.3125rem 0.75rem; border-radius: var(--cd-radius-sm); border: 1px solid rgba(239,68,68,0.3); background: rgba(239,68,68,0.08); color: #fca5a5; font-family: inherit; font-size: 0.6875rem; font-weight: 700; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; transition: all 0.15s; }
    .cd-mdt-btn-signal:hover { background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.5); }
    .cd-mdt-btn-panic { padding: 0.3125rem 0.75rem; border-radius: var(--cd-radius-sm); border: 1px solid rgba(245,158,11,0.3); background: rgba(245,158,11,0.08); color: #fcd34d; font-family: inherit; font-size: 0.6875rem; font-weight: 700; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; transition: all 0.15s; }
    .cd-mdt-btn-panic:hover { background: rgba(245,158,11,0.15); border-color: rgba(245,158,11,0.5); }
    .cd-mdt-rank-pill { margin-left: auto; display: flex; align-items: center; gap: 0.375rem; padding: 0.25rem 0.625rem; background: var(--cd-glass); border: 1px solid var(--cd-glass-border); border-radius: var(--cd-radius-sm); font-size: 0.6875rem; color: var(--cd-text-muted); cursor: pointer; transition: all 0.15s; }
    .cd-mdt-rank-pill:hover { background: var(--cd-glass-hover); border-color: rgba(56,189,248,0.3); color: var(--cd-text); }
    .cd-mdt-rank-pill i { color: var(--cd-accent); font-size: 0.625rem; }

    /* 3-column main */
    .cd-mdt-main { display: grid; grid-template-columns: 1fr 1.2fr 1fr; flex: 1; overflow: hidden; gap: 1px; background: var(--cd-glass-border); min-width: 0; }
    .cd-mdt-col { overflow-y: auto; background: var(--cd-bg); scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.06) transparent; padding-bottom: 2rem; min-width: 0; }
    .cd-mdt-col::-webkit-scrollbar { width: 4px; }
    .cd-mdt-col::-webkit-scrollbar-track { background: transparent; }
    .cd-mdt-col::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.06); border-radius: 2px; }

    /* Column headers */
    .cd-mdt-col-header { padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--cd-glass-border); background: var(--cd-bg); box-shadow: 0 1px 4px rgba(0,0,0,0.4); display: flex; align-items: center; gap: 0.5rem; position: sticky; top: 0; z-index: 5; }
    .cd-mdt-col-header i { color: var(--cd-accent); font-size: 0.75rem; }
    .cd-mdt-col-header span { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--cd-text-muted); }
    .cd-mdt-col-header .cd-mdt-col-count { margin-left: auto; padding: 0.0625rem 0.375rem; border-radius: 99px; background: rgba(56,189,248,0.15); color: var(--cd-accent); font-size: 0.5625rem; font-weight: 700; font-family: 'JetBrains Mono', monospace; }

    /* Search tabs in left column */
    .cd-mdt-search-tabs { display: flex; border-bottom: 1px solid var(--cd-glass-border); }
    .cd-mdt-search-tab { flex: 1; padding: 0.5rem; border: none; background: transparent; color: var(--cd-text-dim); font-family: inherit; font-size: 0.6875rem; font-weight: 500; cursor: pointer; transition: all 0.15s; border-bottom: 2px solid transparent; text-align: center; }
    .cd-mdt-search-tab:hover { color: var(--cd-text); background: rgba(255,255,255,0.02); }
    .cd-mdt-search-tab.active { color: var(--cd-accent); border-bottom-color: var(--cd-accent); font-weight: 600; }
    .cd-mdt-search-pane { display: none; }
    .cd-mdt-search-pane.active { display: block; }

    /* Bottom bar */
    .cd-mdt-bottom { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1px; background: var(--cd-glass-border); border-top: 1px solid var(--cd-glass-border); flex-shrink: 0; }
    .cd-mdt-bottom-cell { background: var(--cd-bg); padding: 0.5rem 0.75rem; }
    .cd-mdt-bottom-cell-header { display: flex; align-items: center; gap: 0.375rem; font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--cd-text-dim); margin-bottom: 0.375rem; cursor: pointer; }
    .cd-mdt-bottom-cell-header:hover { color: var(--cd-text-muted); }
    .cd-mdt-bottom-cell-header i { color: var(--cd-accent); font-size: 0.625rem; }

    /* 10-codes quick row in bottom bar */
    .cd-mdt-codes-row { display: flex; gap: 0.25rem; flex-wrap: wrap; }
    .cd-mdt-code-chip { padding: 0.1875rem 0.5rem; border-radius: 6px; border: 1px solid var(--cd-glass-border); background: var(--cd-glass); font-size: 0.625rem; font-weight: 600; color: var(--cd-text-muted); cursor: pointer; transition: all 0.15s; white-space: nowrap; }
    .cd-mdt-code-chip:hover { border-color: rgba(255,255,255,0.12); color: var(--cd-text); }
    .cd-mdt-code-chip.active { border-color: rgba(56,189,248,0.4); background: rgba(56,189,248,0.1); color: var(--cd-accent); }
    .cd-mdt-code-chip.emergency { color: var(--cd-red); border-color: rgba(239,68,68,0.3); }

    /* Global call component text overrides (applies in both MDT column and focused view) */
    .cd-call-title { font-size: 15px !important; color: #f1f5f9 !important; font-weight: 600 !important; white-space: normal !important; }
    .cd-call-desc { font-size: 13px !important; color: #94a3b8 !important; white-space: normal !important; }
    .cd-call-meta, .cd-call-meta span { font-size: 11px !important; color: #64748b !important; }
    .cd-call-item-header { padding: 12px 16px !important; min-height: 48px !important; }
    .cd-call-item { opacity: 1 !important; background: rgba(255,255,255,0.03) !important; }
    .cd-call-item:hover { background: rgba(255,255,255,0.06) !important; }
    .cd-call-item-main { font-size: 14px !important; color: #e2e8f0 !important; }
    .cd-call-status-dot { width: 10px !important; height: 10px !important; }
    /* MDT-only: hide component header (column header replaces it) */
    .cd-mdt-col .cd-bolo-header:first-child { display: none !important; }
    .cd-mdt-col .cd-call-list { max-height: none !important; }
    .cd-mdt-col .cd-bolo-list { max-height: none !important; overflow-y: visible !important; }
    /* BOLO text */
    .cd-bolo-header-text h3 { font-size: 15px !important; color: #fff !important; }
    .cd-bolo-header-text span { font-size: 11px !important; color: #64748b !important; }

    /* Focused mode: hide MDT, show single card */
    .cd-mdt-focused .cd-mdt { display: none; }

    /* Mobile launcher */
    .cd-mdt-launcher { display: none; }
    .cd-mdt-launcher-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; padding: 0.75rem; }
    .cd-mdt-launcher-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.375rem; padding: 1.25rem 0.5rem; border-radius: var(--cd-radius); background: var(--cd-glass); border: 1px solid var(--cd-glass-border); cursor: pointer; transition: all 0.15s; text-decoration: none; position: relative; }
    .cd-mdt-launcher-item:hover { background: var(--cd-glass-hover); border-color: rgba(255,255,255,0.1); }
    .cd-mdt-launcher-item i { font-size: 1.25rem; }
    .cd-mdt-launcher-item span { font-size: 0.6875rem; font-weight: 500; color: var(--cd-text-muted); text-align: center; }
    .cd-mdt-launcher-badge { position: absolute; top: 0.375rem; right: 0.375rem; padding: 0.0625rem 0.375rem; border-radius: 99px; background: var(--cd-accent); color: #fff; font-size: 0.5rem; font-weight: 700; font-family: 'JetBrains Mono', monospace; }

    /* ---- Responsive ---- */
    @media (max-width: 1023px) {
      .cd-mdt-main { grid-template-columns: 1fr 1fr; }
      .cd-mdt-col:nth-child(3) { display: none; } /* hide intel on tablet — available via sidebar */
      .cd-mdt-bottom { grid-template-columns: 1fr 1fr; }
      .cd-mdt-bottom-cell:nth-child(3) { display: none; }
    }

    @media (max-width: 768px) {
      .cd-sidebar { transform: translateX(-100%); width: 85vw; max-width: 320px; }
      .cd-sidebar.open { transform: translateX(0); box-shadow: 0 0 40px rgba(0, 0, 0, 0.5); }
      .cd-sidebar-close { display: block; }
      .cd-sidebar-toggle { display: flex; }
      .cd-topbar-dept-badge { display: none !important; }
      .cd-topbar { padding: 0 0.75rem; }
      .cd-main { margin-left: 0; }
      .dd-stats-sections { grid-template-columns: 1fr; }
      .dd-grid { grid-template-columns: 1fr; }
      .cd-content { padding: 0.5rem; }
      /* MDT: mobile launcher mode */
      .cd-mdt { height: auto; overflow: visible; }
      .cd-mdt-main { display: none; }
      .cd-mdt-bottom { display: none; }
      .cd-mdt-launcher { display: block; }
      .cd-mdt-status { flex-wrap: wrap; gap: 0.375rem; }
      .cd-mdt-rank-pill { margin-left: 0; width: 100%; justify-content: center; margin-top: 0.25rem; }
    }
    @media (max-width: 480px) {
      .cd-topbar { padding: 0 0.5rem; height: 2.75rem; }
      .cd-topbar-title { font-size: 0.8125rem; max-width: 120px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .cd-topbar-dept-badge { display: none !important; }
      #cd-beta-tag { font-size: 0.5rem; padding: 0.1rem 0.3rem; }
      .cd-topbar-btn { width: 1.625rem; height: 1.625rem; font-size: 0.6875rem; }
      #cd-switch-classic { font-size: 0.6rem !important; padding: 0 0.375rem !important; height: 1.625rem !important; }
      #cd-switch-classic i { margin-right: 0 !important; }
      .cd-topbar-actions { gap: 0.25rem; }
      .dd-stats-section-grid { grid-template-columns: repeat(auto-fit, minmax(60px, 1fr)); gap: 0.375rem; }
      .dd-stat-mini { padding: 0.4rem 0.25rem; }
      .dd-stat-mini-value { font-size: 1.1rem; }
      .dd-stat-mini-label { font-size: 0; line-height: 1; margin: 0; }
      .dd-stat-mini-label::before { font-size: 0.6rem; font-family: 'Font Awesome 5 Free', 'FontAwesome'; font-weight: 900; color: var(--dd-text-dim); }
      .dd-stat-mini-label[data-icon="pending"]::before { content: '\f017'; }
      .dd-stat-mini-label[data-icon="approved"]::before { content: '\f00c'; }
      .dd-stat-mini-label[data-icon="denied"]::before { content: '\f00d'; }
      .dd-stat-mini-label[data-icon="total"]::before { content: '\f0c8'; }
      .dd-stat-mini-label[data-icon="active"]::before { content: '\f06e'; }
      .dd-stat-mini-label[data-icon="scheduled"]::before { content: '\f073'; }
      .dd-stat-mini-label[data-icon="closed"]::before { content: '\f058'; }
    }
  </style>
</head>

