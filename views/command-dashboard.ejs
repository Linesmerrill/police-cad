              '<div style="display:flex; align-items:center; gap:1rem; padding:1.25rem 1.5rem;">' +
                '<div style="position:relative; width:52px; height:52px; flex-shrink:0;">' +
                  '<div style="position:absolute; inset:0; border-radius:50%; border:2px solid rgba(239,68,68,0.3); animation:dd-911-ring 2s ease-in-out infinite;"></div>' +
                  '<div style="width:100%; height:100%; border-radius:50%; background:linear-gradient(135deg, rgba(239,68,68,0.2), rgba(220,38,38,0.1)); display:flex; align-items:center; justify-content:center;">' +
                    '<i class="fa fa-phone" style="color:#ef4444; font-size:1.125rem;"></i>' +
                  '</div>' +
                '</div>' +
                '<div style="flex:1; min-width:0;">' +
                  '<div style="font-size:0.9375rem; font-weight:700; color:#fff; letter-spacing:0.01em;">Emergency Services</div>' +
                  '<div style="font-size:0.75rem; color:var(--dd-text-muted); margin-top:0.2rem;">Tap to contact 911</div>' +
                '</div>' +
