              '<div class="cd-mdt-status-code" id="cd-mdt-status-badge" onclick="ddNavTo(\'10CodesInterface\')" title="Click to change status">' +
                '<i class="fa fa-broadcast-tower"></i> <span id="cd-mdt-status-text">Loading...</span> <i class="fa fa-chevron-down"></i>' +
              '</div>' +
              '<button class="cd-mdt-btn-signal" onclick="cdMdtSignal100()"><i class="fa fa-exclamation-triangle"></i> Signal 100</button>' +
              '<button class="cd-mdt-btn-panic" onclick="cdMdtPanic()"><i class="fa fa-bolt"></i> Panic</button>' : '') +
            '<div class="cd-mdt-rank-pill" id="cd-mdt-rank" onclick="cdShowRankPanel()" title="View rank progress">' +
              '<i class="fa fa-shield"></i> <span id="cd-mdt-rank-text">—</span> <i class="fa fa-chevron-right" style="font-size:0.5rem;opacity:0.5;"></i>' +
            '</div>' +
          '</div>' +

          // 3-column main
          '<div class="cd-mdt-main">' +

            // LEFT: Search hub
            '<div class="cd-mdt-col" id="cd-mdt-col-search">' +
              '<div class="cd-mdt-col-header"><i class="fa fa-search"></i> <span>Search</span></div>' +
              '<div class="cd-mdt-search-tabs">' +
                '<button class="cd-mdt-search-tab active" data-search="person"><i class="fa fa-user-shield"></i> Person</button>' +
                '<button class="cd-mdt-search-tab" data-search="vehicle"><i class="fa fa-car"></i> Vehicle</button>' +
                '<button class="cd-mdt-search-tab" data-search="firearm"><i class="fa fa-crosshairs"></i> Firearm</button>' +
              '</div>' +
              '<div class="cd-mdt-search-pane active" data-pane="person" id="cd-mdt-pane-person"></div>' +
              '<div class="cd-mdt-search-pane" data-pane="vehicle" id="cd-mdt-pane-vehicle"></div>' +
              '<div class="cd-mdt-search-pane" data-pane="firearm" id="cd-mdt-pane-firearm"></div>' +
            '</div>' +

            // CENTER: Active Calls
            '<div class="cd-mdt-col" id="cd-mdt-col-calls">' +
              '<div class="cd-mdt-col-header"><i class="fa fa-radio"></i> <span>Active Calls</span> <span class="cd-mdt-col-count" id="cd-mdt-calls-count">&mdash;</span></div>' +
              '<div id="cd-mdt-calls-content"></div>' +
            '</div>' +

            // RIGHT: Active BOLOs
            '<div class="cd-mdt-col" id="cd-mdt-col-intel">' +
              '<div class="cd-mdt-col-header"><i class="fa fa-bullhorn"></i> <span>Active BOLOs</span> <span class="cd-mdt-col-count" id="cd-mdt-bolos-count">&mdash;</span></div>' +
              '<div id="cd-mdt-intel-content"></div>' +
            '</div>' +

          '</div>' +


          // Mobile launcher (hidden on desktop)
          '<div class="cd-mdt-launcher">' +
            '<div class="cd-mdt-launcher-grid">' +
              (enabledComponents['personSearch'] ? '<div class="cd-mdt-launcher-item" onclick="ddNavTo(\'personSearch\')"><i class="fa fa-user-shield" style="color:var(--cd-blue);"></i><span>Person</span></div>' : '') +
              (enabledComponents['vehicleSearch'] ? '<div class="cd-mdt-launcher-item" onclick="ddNavTo(\'vehicleSearch\')"><i class="fa fa-car" style="color:var(--cd-green);"></i><span>Vehicle</span></div>' : '') +
