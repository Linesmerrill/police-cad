      fire:     { icon: 'fa-fire-extinguisher',  color: '#f97316', route: 'ems' },
      ems:      { icon: 'fa-medkit',             color: '#22c55e', route: 'ems' },
      civilian: { icon: 'fa-user',               color: '#6b7280', route: 'department' },
      judicial: { icon: 'fa-gavel',              color: '#f59e0b', route: 'department' }
    };

    // ══════════════════════════════════════════
    //  FETCH DEPARTMENT DATA & BUILD
    // ══════════════════════════════════════════
    function fetchDepartmentData() {
      if (!departmentId || !/^[a-f0-9]{24}$/i.test(departmentId)) {
        // No department selected — enable all components as fallback
        Object.keys(componentRegistry).forEach(function(k) { enabledComponents[k] = true; });
        buildDashboard();
        return;
      }
      $.ajax({
        url: API_URL + '/api/v1/community/' + encodeURIComponent(communityId) + '/departments/' + encodeURIComponent(departmentId),
        method: 'GET',
        success: function(dept) {
          window.ddConfig.departmentData = dept?.department || dept || {};
          var template = dept?.department?.template;
          // Map backend template names to registry keys where they differ.
          // Dispatch template uses `nameSearch`; the registry implements it as `personSearch`.
          var tplToReg = { viewBolosAndWarrants: 'warrantDatabase', nameSearch: 'personSearch' };
          if (template && template.components) {
            template.components.forEach(function(comp) {
              var key = tplToReg[comp.name] || comp.name;
              enabledComponents[key] = comp.enabled;
            });
          }
          currentTemplateName = (template && template.name || '').toLowerCase() || 'police';
          // Keep the exposed config in sync so other components (cd-calls,
          // focused views) can branch on template without passing it through.
          if (window.ddConfig) window.ddConfig.currentTemplateName = currentTemplateName;
          enabledComponents['departmentSettings'] = true;
          // Default new components to enabled if not yet in stored template
          if (!enabledComponents.hasOwnProperty('activeCalls')) enabledComponents['activeCalls'] = true;
          if (!enabledComponents.hasOwnProperty('warrantDatabase')) enabledComponents['warrantDatabase'] = true;
          if (!enabledComponents.hasOwnProperty('penalCodes')) enabledComponents['penalCodes'] = true;
          buildDashboard();
        },
        error: function() {
          Object.keys(componentRegistry).forEach(function(k) { enabledComponents[k] = true; });
          buildDashboard();
        }
      });
    }

    function checkWarrantApprovalMode() {
      if (!communityId || !departmentId) return;
      $.ajax({
        url: API_URL + '/api/v1/community/' + communityId,
        method: 'GET',
        success: function(res) {
          var community = res.community || res;
          window.ddConfig.communityData = community;
          if (window.ddSettingsInit) window.ddSettingsInit();
          // Update MDT status bar now that community data is available
          applyMDTStatus();
        },
        error: function() {}
      });
    }

    // ══════════════════════════════════════════
    //  BUILD DASHBOARD
    // ══════════════════════════════════════════
    function buildDashboard() {
      buildSidebarNav();
      buildPanels();
      checkWarrantApprovalMode();
      applyDeptTypeIndicator();
      if (typeof window.ddRefreshRanksPendingBadge === 'function') window.ddRefreshRanksPendingBadge();

      $('#dd-loading').hide();
      $('#dd-panels').show();

      // MDT overview components are initialized in populateMDTColumns().
      // Focused-mode components init when navigated to via ddNavTo().
      // Only init non-overview components that aren't in the MDT columns.
      var mdtComponents = ['personSearch', 'vehicleSearch', 'firearmSearch', 'activeCalls', 'createBolos'];
      Object.keys(componentRegistry).forEach(function(key) {
        if (!enabledComponents[key]) return;
        if (mdtComponents.indexOf(key) !== -1) return; // already inited by MDT
        if (componentRegistry[key].init) {
          componentRegistry[key].init();
        }
      });

      // Auto-navigate from hash or query param
      var urlSection = window.location.hash.replace('#', '') ||
                       new URLSearchParams(window.location.search).get('section');
      if (urlSection && urlSection !== 'overview' && componentRegistry[urlSection] && enabledComponents[urlSection]) {
        ddNavTo(urlSection);
      } else {
        ddNavTo('overview');
      }
    }

    // Expose for dd-settings.js
    window.ddConfig._enabledComponents = enabledComponents;
    window.ddConfig._componentRegistry = componentRegistry;
    window.ddBuildSidebarNav = buildSidebarNav;

    // ══════════════════════════════════════════
    //  SIDEBAR NAV
    // ══════════════════════════════════════════
    function buildSidebarNav() {
      var $nav = $('#dd-nav-components');
      $nav.find('.dd-nav-item, .dd-nav-empty').remove();

      // Map backend template component names to frontend registry keys
      // where they differ (most are the same)
      var templateToRegistry = {
        viewBolosAndWarrants: 'warrantDatabase',
        nameSearch: 'personSearch'
      };

      var dept = window.ddConfig.departmentData || {};
      var tplComps = (dept.template && dept.template.components) || [];
      var ordered = [];
      var seen = {};
      tplComps.forEach(function(c) {
        if (!c.name) return;
        var key = templateToRegistry[c.name] || c.name;
        ordered.push(key);
        seen[key] = true;
      });
      Object.keys(componentRegistry).forEach(function(key) { if (!seen[key]) ordered.push(key); });

      ordered.forEach(function(key) {
        if (!enabledComponents[key]) return;
        var comp = componentRegistry[key];
        if (!comp || comp.sidebarHidden) return;
        var $item = $('<a class="dd-nav-item" data-panel="' + key + '">' +
          '<i class="fa ' + comp.navIcon + '"></i>' + comp.label +
          (key === 'reviewWarrants' ? '<span class="dd-nav-badge" id="dd-warrant-count" style="display:none;">0</span>' : '') +
          (key === 'courtCases' ? '<span class="dd-nav-badge dd-cc-live-badge" id="dd-cc-live-count" style="display:none;">0</span><span class="dd-nav-badge" id="dd-cc-pending-count" style="display:none;">0</span>' : '') +
          '</a>');
        if (comp.sidebarAction) {
          $item.on('click', function() { comp.sidebarAction(); });
        } else {
          $item.on('click', function() { ddNavTo(key); });
        }
        $nav.append($item);
      });

      // Show empty state if no components are visible
      if (!$nav.find('.dd-nav-item').length) {
        $nav.append('<div class="dd-nav-empty" style="padding:0.5rem 0.625rem;font-size:0.6875rem;color:var(--cd-text-dim);font-style:italic;">No components enabled</div>');
      }
    }

    // ══════════════════════════════════════════
    //  BUILD PANELS — MDT Grid Layout
    // ══════════════════════════════════════════
    function buildPanels() {
