    function submitWarrantReview(approved) {
      var warrantId = $('#review-warrant-id').val();
      if (!warrantId) return;
      var reviewData = {
        approved: approved,
        judgeNotes: $('#review-warrant-judge-notes').val() || '',
        judgeID: dbUser._id || '',
        judgeName: dbUser.user?.username || 'Judge'
      };
      $.ajax({
        url: `${API_URL}/api/v1/warrant/${warrantId}/review`,
        method: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify(reviewData),
        success: function() {
          $('#reviewWarrantModal').modal('hide');
          alert('Warrant ' + (approved ? 'approved' : 'denied') + ' successfully.');
          loadPendingWarrants();
        },
        error: function(xhr) {
          console.error('Error reviewing warrant:', xhr.responseText);
          alert('Failed to review warrant. Please try again.');
        }
      });
    }

    // === Warrant Database Search ===
    var warrantDbPage = 0;
    var warrantDbLimit = 8;
    var warrantDbTotalPages = 1;

    function searchWarrantDatabase(page) {
      if (page !== undefined) warrantDbPage = page;
      else warrantDbPage = 0;

      var communityId = dbUser.user?.lastAccessedCommunity?.communityID;
      var name = $('#warrant-search-name').val() || '';
      var warrantType = $('#warrant-search-type').val() || '';
      var status = $('#warrant-search-status').val() || '';

      var params = new URLSearchParams();
      if (name) params.append('name', name);
      if (warrantType) params.append('warrantType', warrantType);
      if (status) params.append('status', status);
      if (communityId) params.append('communityId', communityId);
      params.append('limit', warrantDbLimit);
      params.append('page', warrantDbPage);

      $('#warrant-db-loading').show();
      $('#warrant-db-results').hide();
      $('#warrant-db-empty').hide();

      $.ajax({
        url: `${API_URL}/api/v1/warrants/search?${params.toString()}`,
        method: 'GET',
        success: function(result) {
          $('#warrant-db-loading').hide();
          var warrants = result.data || [];
          var totalCount = result.totalCount || 0;
          warrantDbTotalPages = Math.max(1, Math.ceil(totalCount / warrantDbLimit));

          if (warrants.length === 0) {
            $('#warrant-db-empty').show();
            $('#warrant-db-results').hide();
            return;
          }

          $('#warrant-db-results').show();
          var $cards = $('#warrant-db-cards');
          $cards.empty();

          warrants.forEach(function(w) {
            var d = w.warrant || {};
            var typeLabel = (d.warrantType || 'unknown').charAt(0).toUpperCase() + (d.warrantType || '').slice(1);
            var statusLabel = (d.status || 'unknown').charAt(0).toUpperCase() + (d.status || '').slice(1);
            var statusClass = getWarrantDbStatusClass(d.status);
            var dateStr = d.createdAt ? new Date(d.createdAt).toLocaleDateString() : 'N/A';

            $cards.append(
              `<div class="col-md-3" style="margin-bottom: 15px;">
                <div style="background-color: #2a2a3e; border-radius: 8px; padding: 15px; cursor: pointer; border: 1px solid #333; height: 100%;"
                     onclick="openWarrantDbDetail('${w._id}')">
                  <div style="margin-bottom: 8px;">
                    <span class="badge ${statusClass}" style="font-size: 11px;">${escapeHtml(statusLabel)}</span>
                    <span class="badge badge-secondary" style="font-size: 11px; text-transform: capitalize;">${escapeHtml(typeLabel)}</span>
                  </div>
                  <h5 style="color: #fff; margin-bottom: 5px;">${escapeHtml(d.accusedFirstName || '')} ${escapeHtml(d.accusedLastName || '')}</h5>
                  <p style="color: #999; font-size: 12px; margin-bottom: 3px;">${escapeHtml((d.charges || []).slice(0, 2).join(', '))}</p>
                  <p style="color: #666; font-size: 11px; margin: 0;">${dateStr}</p>
                </div>
              </div>`
            );
          });

          // Update pagination
          $('#warrant-db-page-info').text('Page ' + (warrantDbPage + 1) + ' of ' + warrantDbTotalPages);
          $('#warrant-db-prev').prop('disabled', warrantDbPage <= 0);
          $('#warrant-db-next').prop('disabled', warrantDbPage >= warrantDbTotalPages - 1);
        },
        error: function(xhr) {
          $('#warrant-db-loading').hide();
          $('#warrant-db-empty').show();
          console.error('Error searching warrants:', xhr.responseText);
        }
      });
    }

    function warrantDbChangePage(delta) {
      var newPage = warrantDbPage + delta;
      if (newPage < 0 || newPage >= warrantDbTotalPages) return;
      searchWarrantDatabase(newPage);
    }

    function getWarrantDbStatusClass(status) {
      switch (status) {
        case 'approved': return 'badge-success';
        case 'pending': return 'badge-warning';
        case 'denied': return 'badge-danger';
        case 'executed': return 'badge-info';
        case 'expired': return 'badge-secondary';
        case 'withdrawn': return 'badge-secondary';
        default: return 'badge-secondary';
      }
    }

    function openWarrantDbDetail(warrantId) {
      $.ajax({
        url: `${API_URL}/api/v1/warrant/${warrantId}`,
        method: 'GET',
        success: function(w) {
          var d = w.warrant || {};
          var statusLabel = (d.status || 'unknown').charAt(0).toUpperCase() + (d.status || '').slice(1);
          var statusClass = getWarrantDbStatusClass(d.status);

          $('#warrant-detail-title').text((d.warrantType || 'Unknown').charAt(0).toUpperCase() + (d.warrantType || '').slice(1) + ' Warrant');
          $('#warrant-detail-status-badge').html('<span class="badge ' + statusClass + '" style="font-size: 14px; padding: 6px 16px;">' + escapeHtml(statusLabel) + '</span>');

          $('#wd-type').text(d.warrantType || 'N/A');
          $('#wd-status').text(d.status || 'N/A');
          $('#wd-accused').text((d.accusedFirstName || '') + ' ' + (d.accusedLastName || ''));
          $('#wd-charges').text((d.charges || []).join(', ') || 'N/A');
          $('#wd-probable-cause').text(d.probableCause || 'N/A');
          $('#wd-officer').text(d.requestingOfficerName || 'N/A');
          $('#wd-judge').text(d.judgeName || 'N/A');
          $('#wd-date-filed').text(d.createdAt ? new Date(d.createdAt).toLocaleDateString() : 'N/A');

          if (d.warrantType === 'search' && d.searchLocation) {
            $('#wd-search-loc-row').show();
            $('#wd-search-location').text(d.searchLocation);
          } else {
            $('#wd-search-loc-row').hide();
          }

          if (d.judgeNotes) {
            $('#wd-judge-notes-row').show();
            $('#wd-judge-notes').text(d.judgeNotes);
          } else {
            $('#wd-judge-notes-row').hide();
          }

          if (d.status === 'executed' && d.executingOfficerName) {
            $('#wd-executed-row').show();
            $('#wd-executed-by').text(d.executingOfficerName + (d.executedAt ? ' (' + new Date(d.executedAt).toLocaleDateString() + ')' : ''));
          } else {
            $('#wd-executed-row').hide();
          }

          if (d.reviewedAt) {
            $('#wd-reviewed-row').show();
            $('#wd-date-reviewed').text(new Date(d.reviewedAt).toLocaleDateString());
          } else {
            $('#wd-reviewed-row').hide();
          }

          $('#warrantDbDetailModal').modal('show');
        },
        error: function(xhr) {
          console.error('Error loading warrant detail:', xhr.responseText);
          alert('Failed to load warrant details.');
        }
      });
    }

    // Auto-search when warrant database modal opens
    $('#warrantDatabaseModal').on('shown.bs.modal', function() {
      if ($('#warrant-db-cards').children().length === 0) {
        searchWarrantDatabase(0);
      }
    });

    // Call filter and pagination state
    var currentCallFilter = 'open';
    var currentCallPage = 1;
    var callLimit = 10;

    // Set call filter and reload
    function setCallFilter(filter) {
      currentCallFilter = filter;
      currentCallPage = 1; // Reset to first page when filter changes

      // Update button styles
      $('#filterAllCalls, #filterOpenCalls, #filterClosedCalls')
        .removeClass('btn-primary').addClass('btn-secondary');
      if (filter === 'all') {
        $('#filterAllCalls').removeClass('btn-secondary').addClass('btn-primary');
      } else if (filter === 'open') {
        $('#filterOpenCalls').removeClass('btn-secondary').addClass('btn-primary');
      } else if (filter === 'closed') {
        $('#filterClosedCalls').removeClass('btn-secondary').addClass('btn-primary');
      }

      loadAssignedCalls();
    }

    // Change call page
    function changeCallPage(page) {
      if (page < 1) return;
      currentCallPage = page;
      loadAssignedCalls();
    }

    // AJAX function to load assigned calls
function loadAssignedCalls() {
  const communityId = dbUser.user?.lastAccessedCommunity.communityID;
  const userId = dbUser._id;
  if (!communityId) return;

  // Build query parameters
  let queryParams = `?limit=${callLimit}&page=${currentCallPage}`;
  if (currentCallFilter === 'open') queryParams += '&status=true';
  else if (currentCallFilter === 'closed') queryParams += '&status=false';
  // 'all' = no status param
  if (departmentId && departmentId !== 'undefined') {
    queryParams += `&departmentId=${departmentId}`;
  }

  // Determine heading text
  let headingText = 'Open Calls:';
  if (currentCallFilter === 'all') headingText = 'All Calls:';
  else if (currentCallFilter === 'closed') headingText = 'Closed Calls:';

  $.ajax({
    url: `https://police-cad-app-api-bc6d659b60b3.herokuapp.com/api/v2/calls/community/${communityId}${queryParams}`,
    method: 'GET',
    success: function(response) {
      const $container = $('#assigned-call-container');
      $container.find('a').remove();
      $container.find('span').remove();
      $container.find('.call-pagination').remove();
      $container.find('p').remove();

      // Handle both array and object response formats
      const calls = response.data || response;
      const totalCount = response.totalCount || calls.length;

      $container.append(`<span><h4>${headingText} </h4><h5>Click for details</h5></span>`);

      if (calls.length === 0) {
        $container.append('<p class="text-center" style="font-style: italic; font-size: 14px">No calls found.</p>');
      } else {
        calls.forEach(call => {
          const is911Call = (call?.call?.title?.startsWith('911:') || call?.call?.details?.startsWith('911:'));
          const isOpen = call?.call?.status === true;
          // Open 911 calls are red, open regular calls are green, closed calls are gray
          let alertClass = 'alert-secondary';
          if (isOpen) {
            alertClass = is911Call ? 'alert-danger' : 'alert-success';
          }
          const statusLabel = isOpen ? 'Open' : 'Closed';
          $container.append(
            `<a id="${call._id}" href="javascript:void(0)" onclick="event.stopPropagation(); populateCallDetails('${call._id}');">
              <div class="alert ${alertClass} alert-dismissible show" role="alert">
                <strong>[${statusLabel}]</strong> <span id="${call._id}-createdAt" style="text-transform:capitalize">
                  <time>${call?.call?.createdAt}</time> | Description: <span id="${call._id}-description">${call?.call?.title} | ${call?.call?.details}</span>
                </span>
              </div>
            </a>`
          );
        });
      }

      // Add pagination controls if needed
      if (totalCount > callLimit) {
        const totalPages = Math.ceil(totalCount / callLimit);
        $container.append(`
          <div class="call-pagination d-flex justify-content-between mt-2">
            <button class="btn btn-primary" onclick="changeCallPage(${currentCallPage - 1})" ${currentCallPage === 1 ? 'disabled' : ''}>Previous</button>
            <span class="align-self-center">Page ${currentCallPage} of ${totalPages}</span>
            <button class="btn btn-primary" onclick="changeCallPage(${currentCallPage + 1})" ${currentCallPage >= totalPages ? 'disabled' : ''}>Next</button>
          </div>
        `);
      }
    },
    error: function(xhr) {
      console.error('Error loading assigned calls:', xhr.responseText);
    }
  });
}

    // AJAX function to fetch 10-codes
function loadTenCodes() {
  const communityId = dbUser.user?.lastAccessedCommunity.communityID;
  if (!communityId) {
    $('#noTenCodes').text('Please join a community to view 10-codes.').show();
    $('#tenCodesTable').hide();
    $('#tenCodesPagination').hide();
    return;
  }
  if (!departmentId || departmentId === 'undefined') {
    $('#noTenCodes').text('Invalid or missing department. Please select a department from the community dashboard.').show();
    $('#tenCodesTable').hide();
    $('#tenCodesPagination').hide();
    return;
  }
  if (tenCodesCache.length > 0) {
    displayTenCodes(tenCodesCache);
    return;
  }
  $.ajax({
    url: `https://police-cad-app-api-bc6d659b60b3.herokuapp.com/api/v1/community/${communityId}`,
    method: 'GET',
    success: function(data) {
      communityData = data;
      tenCodesCache = data?.community?.tenCodes || [];
      
      // Set community name with fallback
      const communityName = data?.community?.name || 'Unknown Community';
      $('#community-name').text(communityName);
      
      // Build tenCodeMap
      tenCodeMap = {};
      tenCodesCache.forEach(tc => {
        tenCodeMap[tc._id] = tc.code;
      });
      filteredTenCodes = tenCodesCache;
      if (tenCodesCache.length === 0) {
        $('#noTenCodes').show();
        $('#tenCodesTable').hide();
        $('#tenCodesPagination').hide();
      } else {
        $('#noTenCodes').hide();
        $('#tenCodesTable').show();
        $('#tenCodesPagination').show();
        displayTenCodes(tenCodesCache);
      }
      // Load current status after tenCodesCache is populated
      loadCurrentStatus();
    },
    error: function(xhr) {
      console.error('Error loading community data:', xhr.responseText);
      
      // Try to set community name from user data as fallback
      const fallbackName = dbUser?.user?.lastAccessedCommunity?.communityName || 'Community';
      $('#community-name').text(fallbackName || 'Community');
      
      $('#noTenCodes').text('Failed to load 10-codes: ' + (xhr.responseJSON?.message || 'Unknown error')).show();
      $('#tenCodesTable').hide();
      $('#tenCodesPagination').hide();
    }
  });
}

// Track current status code ID for UI highlighting
var currentTenCodeID = null;

// Fetch and display user's current 10-code status
function loadCurrentStatus() {
  const userId = dbUser._id;
  const communityId = dbUser.user?.lastAccessedCommunity.communityID;
  $.ajax({
    url: `https://police-cad-app-api-bc6d659b60b3.herokuapp.com/api/v1/community/${communityId}`,
    method: 'GET',
    success: function(data) {
      const tenCodeID = data?.community?.members[userId]?.tenCodeID;
      if (tenCodeID && tenCodeMap[tenCodeID]) {
        currentTenCodeID = tenCodeID;
        const statusCode = tenCodeMap[tenCodeID];
        $('#currentStatus').text(`Your Current Status: ${statusCode}`);
        $('#statusSetBy').text(`Set By: ${dbUser.user.username}`);
        // Update new status panel
        $('#currentStatusCode').text(statusCode);
        updateStatusCardHighlights(tenCodeID);
      } else {
        currentTenCodeID = null;
        $('#currentStatus').text('Your Current Status: None');
        $('#statusSetBy').text('Set By: None');
        $('#currentStatusCode').text('--');
        updateStatusCardHighlights(null);
      }
    },
    error: function(xhr) {
      console.error('Error loading current status:', xhr.responseText);
      $('#currentStatus').text('Your Current Status: Unknown');
      $('#statusSetBy').text('Set By: None');
      $('#currentStatusCode').text('--');
    }
  });
}

// Update status card highlights based on current status
function updateStatusCardHighlights(activeCodeId) {
  // Remove active class from all cards
  $('.status-card, .code-list-item').removeClass('active');
  // Add active class to current status
  if (activeCodeId) {
    $(`.status-card[data-ten-code-id="${activeCodeId}"]`).addClass('active');
    $(`.code-list-item[data-ten-code-id="${activeCodeId}"]`).addClass('active');
  }

  // Update emergency state on the current status badge
  updateEmergencyBadgeState(activeCodeId);
}

// Update the current status badge to show emergency pulsing if needed
function updateEmergencyBadgeState(activeCodeId) {
  const $badge = $('#currentStatusBadge');

  if (activeCodeId) {
    // Find the ten code data
    const tenCode = tenCodesCache.find(tc => tc._id === activeCodeId);
    if (tenCode) {
      const category = getCodeCategory(tenCode.code, tenCode.description);
      if (category === 'emergency') {
        $badge.addClass('emergency');
        return;
      }
    }
  }

  // Remove emergency class if not an emergency status
  $badge.removeClass('emergency');
}

// Helper function to update Signal 100 banner with details
function updateSignal100Banner(data) {
  const $banner = $('#signal-100-banner');
  const $details = $('#signal-100-details');

  // Build display name matching mobile format: "{callSign} ({department})" or "{username}"
  let activatorDisplay;
  if (data.activatedByCallSign) {
    const detail = data.activatedBy || data.activatedByUsername || '';
    activatorDisplay = detail ? `${data.activatedByCallSign} (${detail})` : data.activatedByCallSign;
  } else {
    activatorDisplay = data.activatedByUsername || data.activatedBy || 'Unknown';
  }

  const message = `Activated by ${activatorDisplay}`;

  // Update the details span
  if ($details.length) {
    $details.text(message);
  }

  // Show the banner
  $banner.removeClass('hide').addClass('show');
  updateSignal100ButtonState();
}

// Show the clear Signal 100 confirmation modal
function showClearSignal100Modal() {
  $('#clear-signal-100-modal').addClass('show');
}

// Hide the clear Signal 100 confirmation modal
function hideClearSignal100Modal(event) {
  // If called from overlay click, only close if clicking the overlay itself
  if (event && event.target !== event.currentTarget) return;
  $('#clear-signal-100-modal').removeClass('show');
}

// Confirm and broadcast Signal 100 cleared
function confirmClearSignal100() {
  const communityId = dbUser.user?.lastAccessedCommunity?.communityID;

  // Emit clear signal to server with user info for tracking
  if (dashboardSocket && dashboardSocket.connected) {
    dashboardSocket.emit('clear_signal_100', {
      activeCommunity: communityId,
      clearedByUserId: dbUser._id,
      clearedByUsername: dbUser.user?.username || '',
      clearedByCallSign: dbUser.user?.callSign || '',
    });
  }

  // Find Code 4 in the ten codes cache and set status to it
  const code4 = tenCodesCache.find(tc =>
    tc.code.toLowerCase() === 'code 4' ||
    tc.description.toLowerCase().includes('under control')
  );

  if (code4) {
    // Update status to Code 4
    updateStatus(code4._id);
    currentTenCodeID = code4._id;
    updateStatusCardHighlights(code4._id);
  }

  // Hide the banner and modal locally
  $('#signal-100-banner').removeClass('show').addClass('hide');
  $('#signal-100-details').text('');
  hideClearSignal100Modal();

  // Show confirmation toast
  showRealTimeToast('status', 'Signal 100 Cleared - Status set to Code 4', 'success');
}

// Toggle show all codes section
function toggleAllCodes() {
  const section = $('#allCodesSection');
  const btn = $('#viewAllCodesBtn');
  if (section.is(':visible')) {
    section.slideUp(200);
    btn.removeClass('expanded');
    btn.find('span').text('View All Codes');
  } else {
    section.slideDown(200);
    btn.addClass('expanded');
    btn.find('span').text('Hide All Codes');
    displayAllCodes(filteredTenCodes);
  }
}

// Check if a code is specifically Signal 100 (for broadcasting alerts)
// This is separate from emergency category - only Signal 100 triggers the banner/broadcast
function isSignal100Code(code, description) {
  const codeLower = code.toLowerCase();
  const descLower = description.toLowerCase();
  return codeLower.includes('signal 100') ||
         descLower.includes('signal 100') ||
         descLower.includes('hold all traffic');
}

// Get category for a 10-code based on common patterns
function getCodeCategory(code, description) {
  const codeNum = code.replace(/\D/g, '');
  const descLower = description.toLowerCase();
  const codeLower = code.toLowerCase();

  // Emergency codes (for red styling) - includes Signal 100, 10-99, etc.
  if (descLower.includes('emergency') || descLower.includes('pursuit') ||
      descLower.includes('officer down') || descLower.includes('shots fired') ||
      descLower.includes('hold all') || codeLower.includes('signal 100') ||
      code === '10-33' || code === '10-99' || code === '10-00') {
    return 'emergency';
  }
  // Offline/End of shift
  if (descLower.includes('off duty') || descLower.includes('end of') ||
      descLower.includes('out of service') || code === '10-42' || code === '10-7') {
    return 'offline';
  }
  // Busy
  if (descLower.includes('busy') || descLower.includes('traffic stop') ||
      descLower.includes('investigation') || descLower.includes('en route') ||
      code === '10-6' || code === '10-11' || code === '10-17') {
    return 'busy';
  }
  // Available
  if (descLower.includes('available') || descLower.includes('in service') ||
      descLower.includes('clear') || code === '10-8' || code === '10-41') {
    return 'available';
  }
  return '';
}

// Display quick status grid with most common codes
function displayQuickStatusCodes(codes) {
  const quickGrid = $('#quickStatusGrid');
  quickGrid.empty();

  // Signal 100 and Panic (10-99) have dedicated static action buttons above,
  // so exclude them from the quick status grid
  const excludedCodes = ['signal 100', '10-99'];

  // Define preferred quick codes in order of priority
  const preferredCodes = [
    'code 4',     // Under Control
    'signal 41',  // Log on to MDT
    'signal 42',  // Log out of MDT
    '10-8',       // In Service
    '10-7',       // Out of Service
    '10-11',      // Traffic Stop
    '10-15',      // Subject in Custody
    '10-6'        // Busy
  ];

  // Find matching codes from the available codes
  const quickCodes = [];
  preferredCodes.forEach(preferred => {
    const found = codes.find(c => c.code.toLowerCase() === preferred.toLowerCase());
    if (found && !quickCodes.includes(found)) {
      quickCodes.push(found);
    }
  });

  // If we don't have 8, fill with remaining codes (excluding already added and excluded)
  if (quickCodes.length < 8) {
    codes.forEach(code => {
      if (quickCodes.length >= 8) return;
      if (excludedCodes.includes(code.code.toLowerCase())) return;
      if (!quickCodes.find(qc => qc._id === code._id)) {
        quickCodes.push(code);
      }
    });
  }

  quickCodes.forEach(code => {
    const category = getCodeCategory(code.code, code.description);
    const isActive = currentTenCodeID === code._id ? 'active' : '';
    quickGrid.append(
      `<div class="status-card ${category} ${isActive}"
           data-ten-code-id="${code._id}"
           onclick="selectTenCode('${code._id}')"
           title="${code.description}">
        <div class="status-card-code">${code.code}</div>
        <div class="status-card-desc">${code.description}</div>
      </div>`
    );
  });
}

// Display all codes in the expanded section
function displayAllCodes(codes) {
  const allGrid = $('#allCodesGrid');
  allGrid.empty();

  codes.forEach(code => {
    const category = getCodeCategory(code.code, code.description);
    const isActive = currentTenCodeID === code._id ? 'active' : '';
