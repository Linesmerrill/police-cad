    function openWarrantReview(warrantId) {
      $.ajax({
        url: `${API_URL}/api/v1/warrant/${warrantId}`,
        method: 'GET',
        success: function(w) {
          var d = w.warrant || {};
          $('#review-warrant-id').val(w._id);
          $('#review-warrant-type').val(d.warrantType || '');
          $('#review-warrant-accused').val((d.accusedFirstName || '') + ' ' + (d.accusedLastName || ''));
          $('#review-warrant-charges').val((d.charges || []).join(', '));
          $('#review-warrant-probable-cause').val(d.probableCause || '');
          $('#review-warrant-officer').val(d.requestingOfficerName || '');
          $('#review-warrant-date').val(d.createdAt ? new Date(d.createdAt).toLocaleDateString() : 'N/A');
          $('#review-warrant-judge-notes').val('');
          if (d.warrantType === 'search' && d.searchLocation) {
