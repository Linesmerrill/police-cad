    // === Judge Review Queue: Pending Warrants ===
    var _hasReviewWarrants = false;

    // Check if this department has the reviewWarrants component enabled
    function checkDepartmentComponents() {
      if (!departmentId || departmentId === 'undefined') return;
      $.ajax({
        url: `${API_URL}/api/v1/department/${departmentId}`,
        method: 'GET',
        success: function(dept) {
          var templateRef = dept?.department?.templateRef;
          if (templateRef && templateRef.enabledComponents) {
            var components = templateRef.enabledComponents;
            if (components.reviewWarrants) {
              _hasReviewWarrants = true;
              $('#pending-warrants-section').show();
              loadPendingWarrants();
            }
          }
        },
        error: function(xhr) {
          console.error('Error checking department components:', xhr.responseText);
        }
      });
    }

    function loadPendingWarrants() {
      if (!_hasReviewWarrants) return;
      const communityId = dbUser.user?.lastAccessedCommunity?.communityID;
      if (!communityId) return;
      $.ajax({
        url: `${API_URL}/api/v1/warrants/pending/community/${communityId}?limit=20&page=0`,
        method: 'GET',
        success: function(result) {
          var warrants = result.data || [];
          var $container = $('#pending-warrants-container');
          $container.empty();
          $container.append('<span><h4><i class="fa fa-gavel"></i> Pending Warrants: </h4><h5>Click to review</h5></span>');
          if (warrants.length === 0) {
            $container.append('<p style="color:#ccc;">No pending warrants to review.</p>');
            return;
          }
          warrants.forEach(function(w) {
            var d = w.warrant || {};
            var typeLabel = (d.warrantType || 'unknown').charAt(0).toUpperCase() + (d.warrantType || 'unknown').slice(1);
            var chargesText = (d.charges || []).join(', ') || 'N/A';
            var dateStr = d.createdAt ? new Date(d.createdAt).toLocaleDateString() : 'N/A';
            $container.append(
              `<a href="javascript:void(0)" onclick="event.stopPropagation(); openWarrantReview('${w._id}');">
                <div class="alert alert-info alert-dismissible show" role="alert">
                  <strong>${typeLabel} Warrant</strong> &mdash;
                  ${escapeHtml(d.accusedFirstName)} ${escapeHtml(d.accusedLastName)} |
                  Charges: ${escapeHtml(chargesText)} |
                  Officer: ${escapeHtml(d.requestingOfficerName || 'Unknown')} |
                  Filed: ${dateStr}
