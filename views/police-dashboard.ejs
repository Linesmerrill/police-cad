  // Initialize socket with retry logic
  function initializeRealtimeSocket() {
    if (typeof io === 'undefined') {
      // Retry after a short delay (socket.io CDN fallback may still be loading)
      setTimeout(initializeRealtimeSocket, 100);
      return;
    }

    dashboardSocket = io();
    window.dashboardSocket = dashboardSocket; // Sync global reference

    const communityId = dbUser.user?.lastAccessedCommunity?.communityID;

    // Function to join room and send initial requests
    function onSocketConnected() {
      // Join community room for targeted broadcasts
      if (communityId) {
        dashboardSocket.emit('join_community_room', { communityId: communityId });
      }

      // Load panic statuses
      var myReq={
        userID: dbUser._id,
        userUsername: dbUser.user.username,
        activeCommunity: dbUser.user?.lastAccessedCommunity.communityID
      }
      dashboardSocket.emit('load_panic_statuses', myReq);
    }

    // Connect handler - wait for connection before joining room
    if (dashboardSocket.connected) {
      onSocketConnected();
    } else {
      dashboardSocket.on('connect', onSocketConnected);
    }

    // Listen for room join confirmation
    dashboardSocket.on('joined_room', function(data) {
      // Room joined successfully
    });
    dashboardSocket.on('room_error', function(data) {
      console.error('Room error:', data);
    });

    dashboardSocket.on('disconnect', function() {
      // Socket disconnected
    });

    // ==========================================
    // REAL-TIME SOCKET LISTENERS
    // ==========================================

    // Listen for member status updates
    dashboardSocket.on('member_status_updated', function(data) {
      // Check if this update is for our community
      if (data.communityId && data.communityId !== communityId) return;

      // Update units display if dispatch view is showing
      updateUnitsDisplay(data);

      // Check if this update is for the current user (e.g., dispatch changed our status)
      if (data.userID === dbUser._id) {
        // Update our own status display
        const statusCode = data.status || 'Unknown';
        const setBy = data.setBy || 'Unknown';

        // Update the current status text
        $('#currentStatus').text(`Your Current Status: ${statusCode}`);
        $('#currentStatusCode').text(statusCode);

        // Update currentTenCodeID for highlighting and refresh the status cards
        if (data.statusCode) {
          currentTenCodeID = data.statusCode;
          updateStatusCardHighlights(data.statusCode);
        }

        // Show notification that someone else (dispatch) changed our status
        // Only show if setBy is different from our own username
        if (setBy && setBy !== dbUser.user.username) {
          showRealTimeToast('status', `${setBy} set your status to: ${statusCode}`, 'info');
        }
      }
      // Note: We don't show toasts for other users' routine status changes
      // Signal 100 and 10-99 notifications come through the signal_100_button_updated event
    });

