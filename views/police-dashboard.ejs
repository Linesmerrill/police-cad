      $.ajax({
        url: 'https://police-cad-app-api-bc6d659b60b3.herokuapp.com/api/v1/community/' + communityId + '/panic-alerts/' + alertId,
        method: 'DELETE',
        contentType: 'application/json',
        data: JSON.stringify({ clearedBy: dbUser._id }),
        success: function() {
          $('#panic-row-' + alertId).fadeOut(200, function() { $(this).remove(); });
          loadPanicStatuses();
        },
        error: function(xhr) {
          console.error('Error clearing panic alert:', xhr.responseText);
        }
      });
    }


