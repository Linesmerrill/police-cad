<script>
  // Detect browser and show appropriate instructions
  function detectBrowserAndShowInstructions() {
    const instructionsDiv = document.getElementById('browserInstructions');
    const incognitoDiv = document.getElementById('incognitoInstructions');
    if (!instructionsDiv) return;
    
    // Only replace content if we can detect the browser - otherwise keep default content
