    // AJAX function to load panic statuses
  function loadPanicStatuses() {
    const communityId = dbUser.user?.lastAccessedCommunity.communityID;
    if (!communityId) return;
      
      // Use correct panic-alerts API endpoint
      $.ajax({
        url: `${API_URL}/api/v1/community/${communityId}/panic-alerts?status=active`,
        method: 'GET',
        success: function(data) {
          // Handle both old and new API response formats
          let alerts = [];
          
          if (data.success && data.alerts) {
            alerts = data.alerts;
          } else if (data.panicAlerts && Array.isArray(data.panicAlerts)) {
            alerts = data.panicAlerts;
          } else if (data.activePanics && typeof data.activePanics === 'object') {
            alerts = Object.values(data.activePanics).map(panic => ({
              userId: panic.userId,
              username: panic.username,
              callSign: panic.callSign,
              departmentType: panic.departmentType,
              triggeredAt: panic.timestamp || panic.triggeredAt,
              communityId: panic.activeCommunityID
            }));
          }
          
          if (alerts.length > 0) {
            // Clear existing items and rebuild
            $('#panic-alert-items').empty();
            
            alerts.forEach(function(panicAlert) {
              const callSign = panicAlert.callSign || 'No Unit #';
              const itemId = 'panic-item-' + panicAlert.userId;
              const itemHtml = '' +
                '<div id="' + itemId + '" class="panic-item" data-user-id="' + panicAlert.userId + '" style="background-color:#f2dede; border-left:5px solid #dc3545; padding:12px; border-radius:4px; margin-bottom:10px; cursor:pointer;">' +
                  '<div style="font-weight:bold; color:#721c24; margin-bottom:6px;"><i class="fa fa-exclamation-triangle"></i> Panic Triggered</div>' +
                  '<div style="color:#333; font-size:0.95em;">' +
                    '<strong>Triggered by:</strong> ' + panicAlert.username + ' (' + callSign + ') - ' + panicAlert.departmentType.toUpperCase() + '<br>' +
                    '<strong>Time:</strong> ' + new Date(panicAlert.triggeredAt).toLocaleString() +
                  '</div>' +
                  '<div style="margin-top:6px;"><small style="color:#721c24; font-style:italic;">Click to view details and clear</small></div>' +
                '</div>';
              $('#panic-alert-items').append(itemHtml);
              
              // Bind click handler
              $('#' + itemId).off('click').on('click', function() {
                const communityIdToUse = dbUser.user?.lastAccessedCommunity?.communityID;
                $('#panic-id').val(panicAlert.userId);
                $('#panic-community-id').val(communityIdToUse);
                $('#panicDetailModal').modal('show');
              });
            });
            
            // Show alerts section and update count
            $('#active-alerts-section').show();
            $('#panic-alert-inline').removeClass('hide').addClass('show').attr('data-panic-active','true');
            $('#active-emergency-count').text('(' + alerts.length + ')');
            
            // Update panic button state
            if (alerts.some(alert => alert.userId === dbUser._id)) {
              // User triggered a panic - disable their button
              $('#panicButton').prop('disabled', true)
                .html('<i class="fa fa-spinner fa-spin" style="margin-right: 8px;"></i>🚨 PANIC ACTIVE 🚨')
                .removeClass('btn-danger')
                .addClass('btn-warning');
            } else {
              // User didn't trigger panic - show active but enabled
              $('#panicButton').prop('disabled', false)
                .html('<i class="fa fa-exclamation-triangle" style="margin-right: 8px;"></i>🚨 PANIC ACTIVE 🚨')
                .removeClass('btn-danger')
                .addClass('btn-warning');
            }
          } else {
            // No active panics - hide alerts section and reset button
            $('#active-alerts-section').hide();
            $('#panic-alert-inline').removeClass('show').addClass('hide').removeAttr('data-panic-active');
            $('#active-emergency-count').text('');
            
            $('#panicButton').prop('disabled', false)
              .html('<i class="fa fa-exclamation-triangle" style="margin-right: 8px;"></i>🚨 PANIC BUTTON 🚨')
              .removeClass('btn-warning')
              .addClass('btn-danger');
          }
        },
        error: function(xhr) {
          // API failed
          
          // If community not found, show a message
          if (xhr.status === 404) {
            // Community not found in database
            // Don't show panic alerts if community doesn't exist
            $('#active-alerts-section').hide();
            $('#panic-alert-inline').removeClass('show').addClass('hide').removeAttr('data-panic-active');
            $('#active-emergency-count').text('');
            
            $('#panicButton').prop('disabled', false)
              .html('<i class="fa fa-exclamation-triangle" style="margin-right: 8px;"></i>🚨 PANIC BUTTON 🚨')
              .removeClass('btn-warning')
              .addClass('btn-danger');
          }
        }
      });
    }

