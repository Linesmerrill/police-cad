            <input id="sidebar-callsign-input" type="text" maxlength="10" style="width:80%; padding:0.4rem 0.6rem; background:rgba(0,0,0,0.5); border:1px solid rgba(255,255,255,0.3); border-radius:6px; color:#fff; font-size:1rem; text-align:center;">
            <div style="margin-top:0.5rem;">
              <button type="button" style="background:#667eea; color:#fff; border:none; border-radius:5px; padding:0.35rem 1rem; font-size:0.9rem; cursor:pointer; margin-right:0.3rem;" onclick="saveSidebarCallSign()">Save</button>
              <button type="button" style="background:rgba(255,255,255,0.2); color:#fff; border:none; border-radius:5px; padding:0.35rem 1rem; font-size:0.9rem; cursor:pointer;" onclick="cancelSidebarCallSignEdit()">Cancel</button>
            </div>
          </div>
          <h5>Logged in as: Police Officer</h5>
        </div>
      </div>
