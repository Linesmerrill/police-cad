<% } %>
          </li>
          <!-- <li>
            <a data-toggle="modal" href="#10codesModal"><span class="fa fa-list-alt ml-3 mr-3"></span> 10-Codes</a>
          </li> -->
          <li>
            <a href="#javascriptDisabledModal" data-toggle="modal" data-target="#notepadModal" onclick="return handleNotepadClick(event);"><span class="fa fa-clipboard ml-3 mr-3"></span> Notepad</a>
          </li>
