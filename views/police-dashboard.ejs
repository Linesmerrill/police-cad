window.clearPanicAlert = function(userId, panicCommunityId) {
  const communityId = panicCommunityId || dbUser.user?.lastAccessedCommunity?.communityID;
  if (!communityId || !userId) return;
  
  $.ajax({
    url: API_URL + '/api/v1/community/' + communityId + '/panic-alerts/user/' + userId,
    method: 'DELETE',
    headers: { 'Content-Type': 'application/json' },
    data: JSON.stringify({ clearedBy: dbUser._id }),
    success: function(response) {
      // Emit socket event for real-time updates
      if (typeof socket !== 'undefined' && socket.connected) {
        socket.emit('clear_panic', {
          userID: userId,
          communityID: communityId
        });
      }
      
      $('#panicDetailModal').modal('hide');
      
      // Hide inline alert
      $('#panic-alert-inline').removeClass('show').addClass('hide')
