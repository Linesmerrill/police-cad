<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Judicial Dashboard - Lines Police CAD</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-void: #0a0a0f;
      --bg-deep: #0f1019;
      --bg-card: #171926;
      --bg-card-hover: #1d2033;
      --bg-elevated: #23263a;
      --bg-input: #1a1c2e;
      --border-subtle: rgba(255,255,255,0.06);
      --border-focus: rgba(212,175,55,0.4);
      --text-primary: #f0ede6;
      --text-secondary: #8a8d9e;
      --text-muted: #5c5f72;
      --accent-gold: #d4af37;
      --accent-gold-dim: rgba(212,175,55,0.15);
      --accent-gold-glow: rgba(212,175,55,0.08);
      --accent-primary: #667eea;
      --accent-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      --accent-gold-gradient: linear-gradient(135deg, #d4af37 0%, #b8941e 100%);
      --status-submitted-bg: #78350f;
      --status-submitted-text: #fbbf24;
      --status-review-bg: #1e3a5f;
      --status-review-text: #60a5fa;
      --status-scheduled-bg: #065f46;
      --status-scheduled-text: #6ee7b7;
      --status-progress-bg: #7f1d1d;
      --status-progress-text: #fca5a5;
      --status-completed-bg: #374151;
      --status-completed-text: #9ca3af;
      --font-display: 'DM Serif Display', Georgia, serif;
      --font-body: 'DM Sans', system-ui, -apple-system, sans-serif;
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --radius-xl: 18px;
      --shadow-card: 0 2px 12px rgba(0,0,0,0.3), 0 0 0 1px var(--border-subtle);
      --shadow-elevated: 0 8px 32px rgba(0,0,0,0.4);
      --shadow-gold: 0 0 20px rgba(212,175,55,0.1);
      --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html { font-size: 15px; }
    body {
      background: var(--bg-void);
      color: var(--text-primary);
      font-family: var(--font-body);
      min-height: 100vh;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* === BACKGROUND TEXTURE === */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse at 20% 0%, rgba(212,175,55,0.03) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 100%, rgba(102,126,234,0.03) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    /* === LAYOUT === */
    .jd-shell { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

    /* === HEADER === */
    .jd-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 2.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-subtle);
    }
    .jd-header-left { display: flex; align-items: center; gap: 1.25rem; }
    .jd-gavel-icon {
      width: 48px; height: 48px;
      background: var(--accent-gold-dim);
      border: 1px solid rgba(212,175,55,0.2);
      border-radius: var(--radius-md);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem; color: var(--accent-gold);
      box-shadow: var(--shadow-gold);
    }
    .jd-title {
      font-family: var(--font-display);
      font-size: 1.8rem;
      color: var(--text-primary);
      letter-spacing: -0.01em;
      line-height: 1.2;
    }
    .jd-subtitle { font-size: 0.9rem; color: var(--text-secondary); margin-top: 0.15rem; }
    .jd-subtitle a { color: var(--accent-gold); text-decoration: none; }
    .jd-header-actions { display: flex; gap: 0.75rem; align-items: center; }

    /* === BACK BUTTON === */
    .jd-back-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      color: var(--text-secondary); font-size: 0.85rem; text-decoration: none;
      padding: 0.4rem 0.75rem; border-radius: var(--radius-sm);
      transition: var(--transition);
      border: 1px solid transparent;
    }
    .jd-back-btn:hover { color: var(--text-primary); background: var(--bg-card); border-color: var(--border-subtle); }

    /* === BUTTONS === */
    .jd-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.6rem 1.1rem; border-radius: var(--radius-sm);
      font-family: var(--font-body); font-weight: 600; font-size: 0.88rem;
      border: none; cursor: pointer; transition: var(--transition);
      text-decoration: none; white-space: nowrap;
    }
    .jd-btn-primary { background: var(--accent-gradient); color: #fff; box-shadow: 0 2px 8px rgba(102,126,234,0.25); }
    .jd-btn-primary:hover { box-shadow: 0 4px 16px rgba(102,126,234,0.35); transform: translateY(-1px); }
    .jd-btn-gold { background: var(--accent-gold-gradient); color: #1a1200; box-shadow: 0 2px 8px rgba(212,175,55,0.2); }
    .jd-btn-gold:hover { box-shadow: 0 4px 16px rgba(212,175,55,0.3); transform: translateY(-1px); }
    .jd-btn-ghost {
      background: transparent; color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .jd-btn-ghost:hover { background: var(--bg-card); color: var(--text-primary); border-color: rgba(255,255,255,0.1); }
    .jd-btn-sm { padding: 0.4rem 0.75rem; font-size: 0.8rem; }
    .jd-btn-danger { background: #7f1d1d; color: #fca5a5; }
    .jd-btn-danger:hover { background: #991b1b; }

    /* === METRICS === */
    .jd-metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .jd-metric {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
      text-align: center;
      transition: var(--transition);
    }
    .jd-metric:hover { border-color: rgba(255,255,255,0.1); }
    .jd-metric-value {
      font-family: var(--font-display);
      font-size: 2.2rem;
      line-height: 1;
      margin-bottom: 0.35rem;
    }
    .jd-metric-value.gold { color: var(--accent-gold); }
    .jd-metric-value.blue { color: var(--accent-primary); }
    .jd-metric-value.green { color: #6ee7b7; }
    .jd-metric-value.red { color: #fca5a5; }
    .jd-metric-label { font-size: 0.85rem; color: var(--text-secondary); font-weight: 500; }

    /* === TABS === */
    .jd-tabs {
      display: flex; gap: 0;
      border-bottom: 1px solid var(--border-subtle);
      margin-bottom: 1.5rem;
      overflow-x: auto;
    }
    .jd-tab {
      padding: 0.75rem 1.25rem;
      font-weight: 600; font-size: 0.9rem;
      color: var(--text-muted);
      cursor: pointer; border: none; background: none;
      border-bottom: 2px solid transparent;
      transition: var(--transition);
      white-space: nowrap;
      font-family: var(--font-body);
      display: flex; align-items: center; gap: 0.5rem;
    }
    .jd-tab:hover { color: var(--text-secondary); }
    .jd-tab.active {
      color: var(--accent-gold);
      border-bottom-color: var(--accent-gold);
    }
    .jd-tab-count {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 20px; height: 20px; padding: 0 6px;
      border-radius: 10px; font-size: 0.72rem; font-weight: 700;
      background: var(--bg-elevated); color: var(--text-secondary);
    }
    .jd-tab.active .jd-tab-count {
      background: var(--accent-gold-dim); color: var(--accent-gold);
    }

    .jd-tab-content { display: none; }
    .jd-tab-content.active { display: block; }

    /* === CASE CARDS === */
    .jd-case-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .jd-case-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.25rem;
      display: flex; align-items: center; gap: 1rem;
      transition: var(--transition);
      cursor: default;
    }
    .jd-case-card:hover {
      border-color: rgba(255,255,255,0.1);
      background: var(--bg-card-hover);
    }
    .jd-case-avatar {
      width: 40px; height: 40px;
      border-radius: var(--radius-sm);
      background: var(--accent-gold-dim);
      display: flex; align-items: center; justify-content: center;
      color: var(--accent-gold); font-weight: 700; font-size: 1rem;
      flex-shrink: 0;
      border: 1px solid rgba(212,175,55,0.15);
    }
    .jd-case-info { flex: 1; min-width: 0; }
    .jd-case-name { font-weight: 600; font-size: 0.95rem; color: var(--text-primary); }
    .jd-case-meta { font-size: 0.82rem; color: var(--text-secondary); margin-top: 0.15rem; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
    .jd-case-meta-item { display: flex; align-items: center; gap: 0.3rem; }
    .jd-case-actions { display: flex; gap: 0.5rem; flex-shrink: 0; }

    /* === STATUS BADGES === */
    .jd-badge {
      display: inline-flex; align-items: center; gap: 0.3rem;
      font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;
      padding: 0.2rem 0.55rem; border-radius: var(--radius-sm);
    }
    .jd-badge-submitted { background: var(--status-submitted-bg); color: var(--status-submitted-text); }
    .jd-badge-in_review { background: var(--status-review-bg); color: var(--status-review-text); }
    .jd-badge-scheduled { background: var(--status-scheduled-bg); color: var(--status-scheduled-text); }
    .jd-badge-in_progress { background: var(--status-progress-bg); color: var(--status-progress-text); }
    .jd-badge-completed { background: var(--status-completed-bg); color: var(--status-completed-text); }

    /* === SESSION CARDS === */
    .jd-session-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
      transition: var(--transition);
    }
    .jd-session-card:hover { border-color: rgba(255,255,255,0.1); }
    .jd-session-card.live {
      border-color: rgba(239,68,68,0.3);
      box-shadow: 0 0 20px rgba(239,68,68,0.06);
    }
    .jd-session-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem; }
    .jd-session-title { font-weight: 600; font-size: 1rem; color: var(--text-primary); }
    .jd-session-subtitle { font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem; }
    .jd-live-dot {
      display: inline-block; width: 8px; height: 8px;
      border-radius: 50%; background: #ef4444; margin-right: 0.4rem;
      animation: jd-pulse 1.5s ease-in-out infinite;
    }
    @keyframes jd-pulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(239,68,68,0.4); }
      50% { opacity: 0.7; box-shadow: 0 0 0 6px rgba(239,68,68,0); }
    }
    .jd-session-meta { display: flex; gap: 1.5rem; margin-top: 0.75rem; font-size: 0.82rem; color: var(--text-secondary); }
    .jd-session-meta i { color: var(--text-muted); margin-right: 0.3rem; }

    /* === EMPTY STATE === */
    .jd-empty {
      text-align: center; padding: 3rem 1rem;
      color: var(--text-muted); font-size: 0.95rem;
    }
    .jd-empty i { font-size: 2rem; margin-bottom: 0.75rem; display: block; opacity: 0.4; }

    /* === MODAL === */
    .jd-modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);
      z-index: 10000;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden;
      transition: opacity 0.25s, visibility 0.25s;
    }
    .jd-modal-overlay.open { opacity: 1; visibility: visible; }
    .jd-modal {
      background: var(--bg-deep);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      width: 92%; max-width: 580px;
      max-height: 85vh; overflow-y: auto;
      box-shadow: var(--shadow-elevated);
      transform: translateY(12px) scale(0.97);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .jd-modal-overlay.open .jd-modal { transform: translateY(0) scale(1); }
    .jd-modal-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border-subtle);
    }
    .jd-modal-title {
      font-family: var(--font-display);
      font-size: 1.15rem; color: var(--text-primary);
    }
    .jd-modal-close {
      background: none; border: none; color: var(--text-muted);
      font-size: 1.3rem; cursor: pointer; padding: 0.25rem;
      transition: var(--transition);
    }
    .jd-modal-close:hover { color: var(--text-primary); }
    .jd-modal-body { padding: 1.5rem; }
    .jd-modal-footer {
      display: flex; justify-content: flex-end; gap: 0.75rem;
      padding: 1rem 1.5rem;
      border-top: 1px solid var(--border-subtle);
    }

    /* === FORM === */
    .jd-form-group { margin-bottom: 1.25rem; }
    .jd-form-label {
      display: block; font-size: 0.82rem; font-weight: 600;
      color: var(--text-secondary); margin-bottom: 0.4rem;
      text-transform: uppercase; letter-spacing: 0.04em;
    }
    .jd-form-input, .jd-form-textarea {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 0.65rem 0.85rem;
      color: var(--text-primary);
      font-family: var(--font-body);
      font-size: 0.9rem;
      transition: var(--transition);
    }
    .jd-form-input:focus, .jd-form-textarea:focus {
      outline: none;
      border-color: var(--border-focus);
      box-shadow: 0 0 0 3px var(--accent-gold-glow);
    }
    .jd-form-textarea { resize: vertical; min-height: 80px; }

    /* === DOCKET CHECKLIST === */
    .jd-docket-list { display: flex; flex-direction: column; gap: 0.5rem; max-height: 200px; overflow-y: auto; }
    .jd-docket-item {
      display: flex; align-items: center; gap: 0.75rem;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 0.6rem 0.85rem;
      cursor: pointer; transition: var(--transition);
    }
    .jd-docket-item:hover { border-color: rgba(255,255,255,0.1); }
    .jd-docket-item input[type="checkbox"] {
      width: 16px; height: 16px; accent-color: var(--accent-gold); cursor: pointer;
    }
    .jd-docket-item-info { flex: 1; }
    .jd-docket-item-name { font-size: 0.88rem; font-weight: 500; color: var(--text-primary); }
    .jd-docket-item-detail { font-size: 0.78rem; color: var(--text-secondary); }

    /* === LOADING === */
    .jd-loading {
      text-align: center; padding: 3rem;
      color: var(--text-muted); font-size: 0.9rem;
    }
    .jd-spinner {
      display: inline-block; width: 24px; height: 24px;
      border: 2px solid var(--border-subtle);
      border-top-color: var(--accent-gold);
      border-radius: 50%;
      animation: jd-spin 0.7s linear infinite;
      margin-bottom: 0.5rem;
    }
    @keyframes jd-spin { to { transform: rotate(360deg); } }

    /* === RESPONSIVE === */
    @media (max-width: 768px) {
      .jd-metrics { grid-template-columns: repeat(2, 1fr); }
      .jd-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
      .jd-case-card { flex-wrap: wrap; }
      .jd-case-actions { width: 100%; justify-content: flex-end; }
    }
    @media (max-width: 480px) {
      .jd-shell { padding: 1rem; }
      .jd-metrics { grid-template-columns: 1fr 1fr; gap: 0.5rem; }
      .jd-tabs { gap: 0; }
      .jd-tab { padding: 0.6rem 0.75rem; font-size: 0.82rem; }
    }
  </style>
</head>
<body>

<div class="jd-shell">
  <!-- Header -->
  <div class="jd-header">
    <div class="jd-header-left">
      <div class="jd-gavel-icon"><i class="fa fa-gavel"></i></div>
      <div>
        <div class="jd-title"><%= departmentName || 'Judicial Department' %></div>
        <div class="jd-subtitle">
          <a href="#" id="jd-community-name">Loading...</a> &middot; Court Management
        </div>
      </div>
    </div>
    <div class="jd-header-actions">
      <a href="/civ-dashboard" class="jd-back-btn"><i class="fa fa-arrow-left"></i> Dashboard</a>
      <button class="jd-btn jd-btn-gold" id="createSessionBtn"><i class="fa fa-plus"></i> Create Court Session</button>
    </div>
  </div>

  <!-- Metrics -->
  <div class="jd-metrics">
    <div class="jd-metric">
      <div class="jd-metric-value gold" id="metricPending">-</div>
      <div class="jd-metric-label">Pending Cases</div>
    </div>
    <div class="jd-metric">
      <div class="jd-metric-value blue" id="metricScheduled">-</div>
      <div class="jd-metric-label">Scheduled</div>
    </div>
    <div class="jd-metric">
      <div class="jd-metric-value red" id="metricActive">-</div>
      <div class="jd-metric-label">Active Sessions</div>
    </div>
    <div class="jd-metric">
      <div class="jd-metric-value green" id="metricCompleted">-</div>
      <div class="jd-metric-label">Completed</div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="jd-tabs">
    <button class="jd-tab active" data-tab="queue">
      <i class="fa fa-inbox"></i> Case Queue <span class="jd-tab-count" id="tabCountQueue">0</span>
    </button>
    <button class="jd-tab" data-tab="scheduled">
      <i class="fa fa-calendar-check"></i> Scheduled <span class="jd-tab-count" id="tabCountScheduled">0</span>
    </button>
    <button class="jd-tab" data-tab="active">
      <i class="fa fa-circle-play"></i> Active Sessions <span class="jd-tab-count" id="tabCountActive">0</span>
    </button>
    <button class="jd-tab" data-tab="history">
      <i class="fa fa-clock-rotate-left"></i> History
    </button>
  </div>

  <!-- Tab Content: Case Queue -->
  <div class="jd-tab-content active" id="tab-queue">
    <div class="jd-loading" id="queueLoading"><div class="jd-spinner"></div><br>Loading cases...</div>
    <div class="jd-case-list" id="queueList" style="display:none;"></div>
  </div>

  <!-- Tab Content: Scheduled -->
  <div class="jd-tab-content" id="tab-scheduled">
    <div class="jd-loading" id="scheduledLoading"><div class="jd-spinner"></div><br>Loading scheduled cases...</div>
    <div class="jd-case-list" id="scheduledList" style="display:none;"></div>
  </div>

  <!-- Tab Content: Active Sessions -->
  <div class="jd-tab-content" id="tab-active">
    <div class="jd-loading" id="activeLoading"><div class="jd-spinner"></div><br>Loading active sessions...</div>
    <div class="jd-case-list" id="activeList" style="display:none;"></div>
  </div>

  <!-- Tab Content: History -->
  <div class="jd-tab-content" id="tab-history">
    <div class="jd-loading" id="historyLoading"><div class="jd-spinner"></div><br>Loading session history...</div>
    <div class="jd-case-list" id="historyList" style="display:none;"></div>
  </div>
</div>

<!-- Create Session Modal -->
<div class="jd-modal-overlay" id="createSessionModal">
  <div class="jd-modal">
    <div class="jd-modal-head">
      <div class="jd-modal-title"><i class="fa fa-gavel" style="color:var(--accent-gold);margin-right:0.4rem;"></i> Create Court Session</div>
      <button class="jd-modal-close" id="closeSessionModal">&times;</button>
    </div>
    <div class="jd-modal-body">
      <div class="jd-form-group">
        <label class="jd-form-label">Session Title</label>
        <input type="text" class="jd-form-input" id="sessionTitle" placeholder="e.g., Morning Docket - Traffic Cases">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="jd-form-group">
          <label class="jd-form-label">Scheduled Start</label>
          <input type="datetime-local" class="jd-form-input" id="sessionStart">
        </div>
        <div class="jd-form-group">
          <label class="jd-form-label">Scheduled End</label>
          <input type="datetime-local" class="jd-form-input" id="sessionEnd">
        </div>
      </div>
      <div class="jd-form-group">
        <label class="jd-form-label">Select Cases for Docket</label>
        <div class="jd-docket-list" id="docketCaseList">
          <div class="jd-loading" style="padding:1rem;"><div class="jd-spinner"></div></div>
        </div>
      </div>
    </div>
    <div class="jd-modal-footer">
      <button class="jd-btn jd-btn-ghost" id="cancelSessionBtn">Cancel</button>
      <button class="jd-btn jd-btn-gold" id="submitSessionBtn"><i class="fa fa-plus"></i> Create Session</button>
    </div>
  </div>
</div>

<!-- Case Detail Modal -->
<div class="jd-modal-overlay" id="caseDetailModal">
  <div class="jd-modal" style="max-width:620px;">
    <div class="jd-modal-head">
      <div class="jd-modal-title"><i class="fa fa-file-lines" style="color:var(--accent-gold);margin-right:0.4rem;"></i> Case Details</div>
      <button class="jd-modal-close" onclick="$('#caseDetailModal').removeClass('open')">&times;</button>
    </div>
    <div class="jd-modal-body" id="caseDetailBody">
      <div class="jd-loading"><div class="jd-spinner"></div></div>
    </div>
    <div class="jd-modal-footer" id="caseDetailFooter"></div>
  </div>
</div>

<!-- Schedule Case Modal -->
<div class="jd-modal-overlay" id="scheduleCaseModal">
  <div class="jd-modal" style="max-width:440px;">
    <div class="jd-modal-head">
      <div class="jd-modal-title"><i class="fa fa-calendar" style="color:var(--accent-gold);margin-right:0.4rem;"></i> Schedule Court Date</div>
      <button class="jd-modal-close" onclick="$('#scheduleCaseModal').removeClass('open')">&times;</button>
    </div>
    <div class="jd-modal-body">
      <input type="hidden" id="scheduleCaseId">
      <div class="jd-form-group">
        <label class="jd-form-label">Court Date &amp; Time</label>
        <input type="datetime-local" class="jd-form-input" id="scheduleCaseDate">
      </div>
    </div>
    <div class="jd-modal-footer">
      <button class="jd-btn jd-btn-ghost" onclick="$('#scheduleCaseModal').removeClass('open')">Cancel</button>
      <button class="jd-btn jd-btn-gold" id="submitScheduleBtn"><i class="fa fa-check"></i> Schedule</button>
    </div>
  </div>
</div>

