<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>LPC - Admin Two-Factor</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/static/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/static/css/animate.min.css" />
    <link rel="stylesheet" href="/static/css/ionicons.min.css" />
    <link rel="stylesheet" href="/static/css/styles.css" />
    <link rel="icon" type="image/x-icon" href="/static/images/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/images/apple-touch-icon.png">
    <style>
      body { background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0b1220 100%); }
      .admin-hero { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }
      .admin-card { background: #1e2028; border-radius: 16px; border: 1px solid #35385a; box-shadow: 0 20px 50px rgba(0,0,0,0.35); color: #fff; }
      .admin-card .form-control { background: #11131a; border: 1px solid #2a2d45; color: #e5e7eb; }
      .admin-card .form-control:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.25); }
      .admin-title { font-weight: 700; margin-bottom: 0.25rem; }
      .admin-subtitle { color: #9aa0b4; margin-bottom: 1.5rem; }
      .btn-gradient { background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); border: none; }
      .btn-gradient:hover { opacity: 0.95; }
      .alert-compact { padding: 0.75rem 1rem; border-radius: 8px; }
      a.link-muted { color: #9aa0b4; }
      a.link-muted:hover { color: #c7cbe2; text-decoration: none; }
    </style>
  </head>
  <body>
    <nav id="topNav" class="navbar navbar-default navbar-fixed-top">
      <div class="container-fluid">
        <div class="navbar-header">
          <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-navbar">
            <span class="sr-only">Toggle navigation</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
          </button>
          <a class="navbar-brand page-scroll" href="/"><img style="display:inline; margin-top:-9px; vertical-align:text-top;" src="/static/images/favicon-32x32.png"></img> Lines Police CAD</a>
        </div>
        <div class="navbar-collapse collapse" id="bs-navbar">
          <ul class="nav navbar-nav navbar-right">
            <li><a href="/">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact-us">Contact Us</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <section class="admin-hero">
      <div class="container">
        <div class="row">
          <div class="col-sm-10 col-sm-offset-1 col-md-8 col-md-offset-2 col-lg-6 col-lg-offset-3">
            <div class="admin-card" style="padding: 2rem;">
              <div class="text-center" style="margin-bottom:1rem;">
                <img src="/static/images/dispatch-logo-512.png" alt="Admin" style="width:56px; height:56px; border-radius:12px; box-shadow:0 10px 25px rgba(0,0,0,0.35);" />
              </div>
              <h2 class="admin-title text-center"><%= hasPasskey ? 'Confirm it\'s you' : 'Two-factor code' %></h2>
              <p class="admin-subtitle text-center" id="adminMfaSubtitle"><%= hasPasskey ? 'Use your passkey, or a code from your authenticator app.' : 'Enter the 6-digit code from your authenticator app, or one of your backup codes.' %></p>

              <div class="alert alert-danger alert-compact" role="alert" data-testid="admin-mfa-error" id="adminMfaError" <% if (!(typeof error !== 'undefined' && error && error.length > 0)) { %>style="display:none;"<% } %>><%= typeof error !== 'undefined' && error ? error : '' %></div>

              <% if (hasPasskey) { %>
              <div id="adminPasskeyBlock">
                <button type="button" id="adminPasskeyBtn" class="btn btn-gradient btn-block btn-lg" style="border-radius:10px;" data-testid="admin-mfa-passkey">Use passkey</button>
                <div class="text-center" style="margin-top:0.75rem;">
                  <a href="#" class="link-muted" id="adminUseCodeLink">Use a code instead</a>
                </div>
              </div>
              <% } %>

              <form action="/admin/mfa" method="post" autocomplete="off" novalidate id="adminMfaCodeForm" <% if (hasPasskey) { %>style="display:none;"<% } %>>
                <div class="form-group">
                  <label for="adminMfaCode">Code</label>
                  <input id="adminMfaCode" type="text" name="code" class="form-control input-lg" inputmode="numeric" autocomplete="one-time-code" maxlength="11" placeholder="123456" required <% if (!hasPasskey) { %>autofocus<% } %> data-testid="admin-mfa-code" />
                </div>
                <button type="submit" class="btn btn-gradient btn-block btn-lg" style="border-radius:10px;" data-testid="admin-mfa-submit">Verify</button>
              </form>

              <div class="text-center" style="margin-top:1rem;">
                <a class="link-muted" href="/admin/logout">Use a different account</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <% include footer %>

    <script src="/static/js/jquery.min.js?v=<%= typeof buildVersion !== 'undefined' ? buildVersion : 'dev' %>"></script>
    <script src="/static/js/bootstrap.min.js?v=<%= typeof buildVersion !== 'undefined' ? buildVersion : 'dev' %>"></script>
    <% if (hasPasskey) { %>
    <script src="/static/js/admin-passkeys.js?v=<%= typeof buildVersion !== 'undefined' ? buildVersion : 'dev' %>"></script>
    <script>
      (function () {
        var btn = document.getElementById('adminPasskeyBtn');
        var errorEl = document.getElementById('adminMfaError');
        function showError(msg) { errorEl.textContent = msg; errorEl.style.display = ''; }
        function showCodeForm() {
          document.getElementById('adminMfaCodeForm').style.display = '';
          document.getElementById('adminPasskeyBlock').style.display = 'none';
          document.getElementById('adminMfaSubtitle').textContent = 'Enter the 6-digit code from your authenticator app, or one of your backup codes.';
          document.getElementById('adminMfaCode').focus();
        }
        document.getElementById('adminUseCodeLink').addEventListener('click', function (e) { e.preventDefault(); showCodeForm(); });
        if (!window.lpcPasskeys || !window.lpcPasskeys.supported) {
          showCodeForm();
          return;
        }
        function postJSON(url, body) {
          return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
        }
        function fail(res) {
          return res.json().catch(function () { return {}; }).then(function (data) {
            if (data.restart) { window.location = '/admin?error=' + encodeURIComponent(data.message || 'Your sign-in expired. Enter your password again.'); return; }
            throw new Error(data.message || 'Passkey sign-in is unavailable right now. Use a code instead.');
          });
        }
        btn.addEventListener('click', function () {
          btn.disabled = true;
          errorEl.style.display = 'none';
          postJSON('/admin/mfa/passkey/options')
            .then(function (res) { return res.ok ? res.json() : fail(res); })
            .then(function (options) {
              if (!options) return;
              return window.lpcPasskeys.get(options).then(function (credential) {
                return postJSON('/admin/mfa/passkey', { credential: credential });
              }).then(function (res) {
                if (res.ok) { window.location = res.redirected ? res.url : '/admin/console'; return; }
                return fail(res);
              }, function (err) { throw new Error(window.lpcPasskeys.describeError(err)); });
            })
            .catch(function (err) { showError(err.message); })
            .then(function () { btn.disabled = false; });
        });
      })();
    </script>
    <% } %>
  </body>
 </html>


