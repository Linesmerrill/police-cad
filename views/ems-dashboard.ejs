                  <option value="yes">Yes</option>
                  <option value="no">No</option>
                </select>
              </div>
              

              
              <!-- Error Display -->
              <div id="create-report-errors" class="alert alert-danger" style="display:none;"></div>
              
              <div class="text-center">
                <button type="button" class="btn btn-secondary margin-right-1" onclick="showSearchView()">
                  <i class="fa fa-arrow-left"></i> Back to Search
                </button>
                <button type="submit" class="btn btn-primary">
                  <i class="fa fa-save"></i> Create Report
                </button>
              </div>
            </form>
          </div>

