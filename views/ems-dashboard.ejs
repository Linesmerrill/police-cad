              <input type="hidden" id="new-report-activeCommunityID" name="activeCommunityID">
              
              <div class="form-group">
                <label for="new-report-date">Date: <span class="text-danger">*</span></label>
                <input type="date" id="new-report-date" name="date" class="form-control" required>
