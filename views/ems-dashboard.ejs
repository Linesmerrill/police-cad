    .wm-table tr:last-child td { border-bottom: none; }

    .wm-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
    }
    .wm-card {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 11px; padding: 18px 20px;
      cursor: pointer; transition: all 0.2s;
      position: relative; overflow: hidden;
    }
    .wm-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: var(--card-accent, rgba(255,255,255,0.05));
      opacity: 0; transition: opacity 0.2s;
    }
    .wm-card:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); transform: translateY(-1px); }
    .wm-card:hover::before { opacity: 1; }
    .wm-card[data-status="pending"] { --card-accent: #f59e0b; }
    .wm-card[data-status="approved"] { --card-accent: #22c55e; }
    .wm-card[data-status="denied"] { --card-accent: #ef4444; }
    .wm-card[data-status="executed"] { --card-accent: #6366f1; }
    .wm-card h5 { color: #f1f5f9; margin: 8px 0 5px; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
    .wm-card p { margin: 0; font-size: 12.5px; color: #525d75; line-height: 1.4; }
    .wm-card .wm-card-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 12px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.03); }
    .wm-card .wm-card-meta span { font-size: 11px; color: #3e4558; }

    .wm-empty { text-align: center; padding: 80px 20px; color: #3e4558; }
    .wm-empty i { font-size: 2.5rem; margin-bottom: 14px; display: block; opacity: 0.4; }
    .wm-empty p { font-size: 14px; margin: 0; }

    .wm-status-center { text-align: center; margin-bottom: 24px; }

    .wm-pagination {
      display: flex; align-items: center; justify-content: center;
      gap: 14px; margin-top: 24px; padding-top: 18px;
      border-top: 1px solid rgba(255,255,255,0.03);
    }
    .wm-pagination span { font-size: 12px; color: #4b5672; font-weight: 500; }

    .wm-notice {
      display: flex; align-items: center; gap: 10px;
      background: rgba(99,102,241,0.06); border: 1px solid rgba(99,102,241,0.1);
      border-radius: 8px; padding: 10px 16px; margin-bottom: 20px;
      font-size: 12.5px; color: #8892a8; line-height: 1.5;
    }
    .wm-notice i { color: #6366f1; font-size: 14px; flex-shrink: 0; }

    @media (min-width: 1200px) {
      .wm-panel { width: 92vw; max-width: 1440px; }
      .wm-panel.wm-md { width: 70vw; max-width: 960px; }
      .wm-header { padding: 22px 44px; }
      .wm-body { padding: 32px 44px 40px; }
      .wm-cards-grid { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
