                    <button id="deleteCallBtnOpen" type="button" class="btn btn-danger" onclick="showDeleteCallModal()">Delete</button>
                  </div>
                  <!-- Closed Call Buttons -->
                  <div id="closedCallButtons" style="display: none;">
                    <button id="reopenCallBtn" type="button" class="btn btn-success" onclick="showReopenCallModal()">Reopen Call</button>
                    <button id="deleteCallBtnClosed" type="button" class="btn btn-danger" onclick="showDeleteCallModal()">Delete</button>
                  </div>
                </div>
              </div>
            </fieldset>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mark as Completed Confirmation Modal -->
  <div id="markCompletedModalEms" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 9999;">
    <div class="modal-dialog modal-sm" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Mark as Completed</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to mark this call as completed?</p>
          <p class="text-muted small">The call will be moved to closed status and can be reopened later if needed.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-warning" onclick="confirmMarkAsCompleted()">Mark as Completed</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Reopen Call Confirmation Modal -->
  <div id="reopenCallModalEms" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 9999;">
    <div class="modal-dialog modal-sm" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Reopen Call</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to reopen this call?</p>
          <p class="text-muted small">The call will be moved back to open status and you can edit it again.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-success" onclick="confirmReopenCall()">Reopen Call</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Call Confirmation Modal -->
  <div id="deleteCallModalEms" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 9999;">
    <div class="modal-dialog modal-sm" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Delete Call</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to delete this call?</p>
          <p class="text-danger small"><strong>Warning:</strong> This action cannot be undone. All call data and notes will be permanently deleted.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-danger" onclick="confirmDeleteCall()">Delete Call</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Status Codes Modal -->
  <div id="statusCodesModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h4 class="modal-title">
            <i class="fas fa-broadcast-tower" style="margin-right: 0.5rem; color: #667eea;"></i>
            EMS Status Codes
          </h4>
          <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        </div>
        <div class="modal-body">
          <div class="heroui-search-container">
            <i class="fas fa-search heroui-search-icon"></i>
            <input type="text" id="statusCodeSearch" class="heroui-search-input" placeholder="Search by code or description...">
          </div>
          
          <div id="noStatusCodes" class="alert alert-info" style="display: none; background: #1e2028; border: 1px solid #35385a; color: #a0aec0;">
            <i class="fas fa-info-circle" style="margin-right: 0.5rem;"></i>
            No status codes available for this community.
          </div>
          
          <div id="statusCodesContent">
            <div class="heroui-codes-grid" id="statusCodesGrid">
              <!-- Status codes will be loaded here dynamically -->
            </div>
          </div>
          
          <div style="color: #a0aec0; margin-top: 1.5rem; padding-top: 1rem; font-size: 1rem; text-align: center; border-top: 1px solid #35385a;">
            <i class="fas fa-mouse-pointer" style="margin-right: 0.5rem;"></i>
            Click on a code to set as your status
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">
            <i class="fas fa-times" style="margin-right: 0.5rem;"></i>
            Close
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Initialize global variables for EMS Dashboard -->
  <script type="text/javascript">
    // all global router vars declared here to reduce duplication
    var dbUser = <%-JSON.stringify(user)%>;
    var dbVehicles = <%-JSON.stringify(vehicles)%>;
    var departmentId = <%- JSON.stringify(departmentId || null) %>;
    var departmentName = <%- JSON.stringify(departmentName || null) %>;
    var POLICE_CAD_API_URL = '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    var API_URL = POLICE_CAD_API_URL; // For notifications.js compatibility
  </script>

  <!-- Panic Detail Modal -->
  <div id="panicDetailModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Panic Alert</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <form id="clear-panic-form" class="form-horizontal" action="" method="post">
            <fieldset>
              <input id="panic-id" type="hidden" name="panic-id" value="">
              <p>Clear this panic alert?</p>
              <button id="clearPanic" type="button" class="btn btn-danger" onclick="hideModal('panicDetailModal')">Clear</button>
            </fieldset>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>

</html>
