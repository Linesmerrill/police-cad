  <style>
    /* Signal 100 Banner - Modern Mobile-Friendly Design */
    #fixed-alert-banners {
      position: fixed;
      top: 60px;
      left: 300px;
      right: 0;
      z-index: 8;
      transition: left 0.3s;
    }
    #fixed-alert-banners.sidebar-collapsed {
      left: 0;
    }
    @media (max-width: 991.98px) {
      #fixed-alert-banners {
        left: 0;
      }
      #fixed-alert-banners.sidebar-collapsed {
        left: 300px;
      }
    }
    .signal-100-banner {
      background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
      padding: 6px 16px;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(220, 38, 38, 0.4);
      transition: all 0.3s ease;
      animation: signal100Glow 1.5s ease-in-out infinite;
    }
    .signal-100-banner:hover {
      background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
    }
    .signal-100-banner.hide {
      display: none;
    }
    .signal-100-banner.show {
      display: block;
    }
    @keyframes signal100Glow {
      0%, 100% { box-shadow: 0 4px 20px rgba(220, 38, 38, 0.4); }
      50% { box-shadow: 0 4px 30px rgba(220, 38, 38, 0.7); }
    }
    .signal-100-content {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .signal-100-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .signal-100-icon {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }
    .signal-100-icon i {
      font-size: 16px;
      color: #fff;
      z-index: 2;
      position: relative;
    }
    .signal-100-pulse {
      position: absolute;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      animation: signal100Pulse 1s ease-out infinite;
    }
    @keyframes signal100Pulse {
      0% { transform: scale(0.8); opacity: 1; }
      100% { transform: scale(1.8); opacity: 0; }
    }
    .signal-100-text {
      text-align: left;
      flex: 1;
      min-width: 0;
    }
    .signal-100-title {
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      letter-spacing: 1.5px;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    }
    .signal-100-details {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.9);
      margin-top: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .signal-100-tap {
      font-size: 10px;
      color: rgba(255, 255, 255, 0.7);
      text-transform: uppercase;
      letter-spacing: 1px;
      flex-shrink: 0;
      padding: 3px 8px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 4px;
    }
    @media (max-width: 480px) {
      .signal-100-banner {
        padding: 10px 12px;
      }
      .signal-100-content {
        gap: 8px;
      }
      .signal-100-icon {
        width: 28px;
        height: 28px;
      }
      .signal-100-icon i {
        font-size: 18px;
      }
      .signal-100-title {
        font-size: 15px;
        letter-spacing: 1px;
      }
      .signal-100-details {
        font-size: 11px;
      }
      .signal-100-tap {
        font-size: 9px;
        padding: 3px 6px;
      }
    }

    /* Panic Alert Banner */
    .panic-alerts-banner {
      max-height: 125px;
      overflow-y: auto;
      background: linear-gradient(135deg, #ea580c 0%, #9a3412 100%);
      box-shadow: 0 4px 20px rgba(234, 88, 12, 0.4);
      animation: panicGlow 2s ease-in-out infinite;
    }
    .panic-alerts-banner:empty { display: none; }
    .panic-alerts-banner::-webkit-scrollbar { width: 4px; }
    .panic-alerts-banner::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.3); border-radius: 2px; }
    @keyframes panicGlow {
      0%, 100% { box-shadow: 0 4px 20px rgba(234, 88, 12, 0.4); }
      50% { box-shadow: 0 4px 30px rgba(234, 88, 12, 0.7); }
    }
    .panic-alert-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 16px; min-height: 50px;
      border-bottom: 1px solid rgba(255,255,255,0.15);
      animation: panicPulseRow 1.5s ease-in-out infinite;
    }
    .panic-alert-row:last-child { border-bottom: none; }
    @keyframes panicPulseRow { 0%, 100% { opacity: 1; } 50% { opacity: 0.85; } }
    .panic-alert-content { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
    .panic-alert-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; flex-shrink: 0; }
    .panic-alert-icon i { font-size: 18px; color: #fff; z-index: 2; position: relative; }
    .panic-alert-icon .panic-pulse { position: absolute; width: 100%; height: 100%; background: rgba(255,255,255,0.3); border-radius: 50%; animation: panicPulse 1s ease-out infinite; }
    @keyframes panicPulse { 0% { transform: scale(0.8); opacity: 1; } 100% { transform: scale(1.8); opacity: 0; } }
    .panic-alert-text { flex: 1; min-width: 0; }
    .panic-alert-title { font-size: 13px; font-weight: 700; color: #fff; letter-spacing: 1.5px; text-transform: uppercase; }
    .panic-alert-details { font-size: 12px; color: rgba(255,255,255,0.9); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .panic-alert-clear-btn { background: rgba(255,255,255,0.2); border: none; color: #fff; width: 28px; height: 28px; border-radius: 4px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; font-size: 14px; transition: background 0.2s; }
    .panic-alert-clear-btn:hover { background: rgba(255,255,255,0.35); }
    .panic-alert-hide-btn { background: rgba(255,255,255,0.1); border: none; color: rgba(255,255,255,0.6); width: 28px; height: 28px; border-radius: 4px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; font-size: 12px; transition: background 0.2s; }
    .panic-alert-hide-btn:hover { background: rgba(255,255,255,0.2); }
    .panic-alert-row.collapsed { min-height: 28px; padding: 4px 16px; animation: none; opacity: 0.65; }
    .panic-alert-row.collapsed .panic-alert-icon { display: none; }
    .panic-alert-row.collapsed .panic-alert-title { display: inline; font-size: 11px; letter-spacing: 0.5px; }
    .panic-alert-row.collapsed .panic-alert-details { display: inline; font-size: 11px; margin-top: 0; margin-left: 6px; }
    .panic-alert-row.collapsed .panic-alert-text { display: flex; align-items: center; }
    .panic-scroll-hint { background: #7c2d12; padding: 3px 0; text-align: center; font-size: 10px; color: rgba(255,255,255,0.7); letter-spacing: 0.5px; }
    @media (max-width: 480px) {
      .panic-alert-row { padding: 8px 12px; min-height: 44px; }
      .panic-alert-title { font-size: 11px; }
      .panic-alert-details { font-size: 11px; }
    }

    /* Clear Signal 100 Modal */
    .clear-signal-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.7);
      z-index: 99999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .clear-signal-modal-overlay.show {
      display: flex;
    }
    .clear-signal-modal {
      background: #1e293b;
      border-radius: 12px;
      padding: 24px;
      max-width: 360px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      animation: modalSlideIn 0.2s ease-out;
    }
    @keyframes modalSlideIn {
      from { transform: translateY(-20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .clear-signal-modal h3 {
      color: #fff;
      margin: 0 0 8px 0;
      font-size: 20px;
    }
    .clear-signal-modal p {
      color: #94a3b8;
      margin: 0 0 20px 0;
      font-size: 14px;
    }
    .clear-signal-modal-buttons {
      display: flex;
      gap: 12px;
    }
    .clear-signal-modal-buttons button {
      flex: 1;
      padding: 12px 16px;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .clear-signal-btn-cancel {
      background: #374151;
      color: #fff;
    }
    .clear-signal-btn-cancel:hover {
      background: #4b5563;
    }
    .clear-signal-btn-confirm {
      background: #dc2626;
      color: #fff;
    }
    .clear-signal-btn-confirm:hover {
      background: #ef4444;
    }

    /* Toast animation keyframes */
    @keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @keyframes slideOutRight { from { transform: translateX(0); opacity: 1; } to { transform: translateX(100%); opacity: 0; } }

    #persona-table tbody tr {
      cursor: pointer;
    }
    #persona-table tbody tr:hover {
      background-color: #3b82f6;
    }
    #vehicle-table tbody tr {
      cursor: pointer;
    }
    #vehicle-table tbody tr:hover {
      background-color: #3b82f6;
    }
    .rotate {
      transition: transform 0.3s ease;
    }
    .rotate.expanded {
      transform: rotate(90deg);
    }
    
    /* Medical Database Styles */
    .list-group-item-action {
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .list-group-item-action:hover {
      background-color: #f8f9fa;
      border-left: 4px solid #007bff;
    }
    
    .list-group-item-action h6 {
      margin-bottom: 0.5rem;
    }
    
    .list-group-item-action small {
      color: #6c757d;
    }
    
    .lds-facebook {
      display: inline-block;
      position: relative;
      width: 80px;
      height: 80px;
    }
    
    .lds-facebook div {
      display: inline-block;
      position: absolute;
      left: 8px;
      width: 16px;
      background: #007bff;
      animation: lds-facebook 1.2s cubic-bezier(0, 0.5, 0.5, 1) infinite;
    }
    
    .lds-facebook div:nth-child(1) {
      left: 8px;
      animation-delay: -0.24s;
    }
    
    .lds-facebook div:nth-child(2) {
      left: 32px;
      animation-delay: -0.12s;
    }
    
    .lds-facebook div:nth-child(3) {
      left: 56px;
      animation-delay: 0;
    }
    
    @keyframes lds-facebook {
      0% {
        top: 8px;
        height: 64px;
      }
      50%, 100% {
        top: 24px;
        height: 32px;
      }
    }

    /* HeroUI Pro Status Code Styles */
    :root {
      --primary-color: #667eea;
      --primary-dark: #5a67d8;
      --secondary-color: #764ba2;
      --accent-color: #f093fb;
      --success-color: #48bb78;
      --warning-color: #ed8936;
      --danger-color: #f56565;
      --dark-bg: #1a202c;
      --darker-bg: #171923;
      --card-bg: #2d3748;
      --text-primary: #f7fafc;
      --text-secondary: #a0aec0;
      --border-color: #4a5568;
      --shadow-lg: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    /* Status Panel Styles (matching Police Dashboard) */
    .status-panel {
      background: linear-gradient(135deg, #1a1f2e 0%, #2d3548 100%);
      border-radius: 12px;
      border: 1px solid rgba(239, 68, 68, 0.3);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.05);
      margin: 1.5rem auto;
      max-width: 800px;
      overflow: hidden;
    }

    .status-panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.5rem;
      background: rgba(239, 68, 68, 0.1);
      border-bottom: 1px solid rgba(239, 68, 68, 0.2);
    }

    .status-panel-title {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: #ef4444;
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: 0.05em;
    }

    .status-panel-title i {
      font-size: 1.25rem;
    }

    .current-status-badge {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(16, 185, 129, 0.2);
      padding: 0.5rem 1rem;
      border-radius: 20px;
      border: 1px solid rgba(16, 185, 129, 0.4);
      transition: all 0.3s ease;
    }

    /* Emergency badge state - pulsing red */
    .current-status-badge.emergency {
      background: rgba(239, 68, 68, 0.25);
      border-color: rgba(239, 68, 68, 0.6);
      animation: pulse-emergency-badge 1.5s ease-in-out infinite;
    }

    .current-status-badge.emergency .status-code {
      color: #ef4444;
    }

    @keyframes pulse-emergency-badge {
      0%, 100% {
        box-shadow: 0 0 10px rgba(239, 68, 68, 0.4);
        background: rgba(239, 68, 68, 0.2);
      }
      50% {
        box-shadow: 0 0 20px rgba(239, 68, 68, 0.7), 0 0 40px rgba(239, 68, 68, 0.3);
        background: rgba(239, 68, 68, 0.35);
      }
    }

    .status-label {
      color: #9ca3af;
      font-size: 0.85rem;
    }

    .status-code {
      color: #10b981;
      font-weight: 700;
      font-size: 1rem;
    }

    .quick-status-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 0.75rem;
      padding: 1.25rem;
    }

    .status-card {
      position: relative;
      background: rgba(30, 41, 59, 0.8);
      border: 2px solid rgba(71, 85, 105, 0.5);
      border-radius: 10px;
      padding: 1rem;
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: center;
    }

    .status-card:hover {
      border-color: #ef4444;
      background: rgba(239, 68, 68, 0.15);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    .status-card.active {
      border-color: #10b981;
      background: rgba(16, 185, 129, 0.2);
      box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
    }

    .status-card.active .status-card-code {
      color: #10b981;
    }

    .status-card-code {
      font-size: 1.25rem;
      font-weight: 700;
      color: #f1f5f9;
      margin-bottom: 0.25rem;
    }

    .status-card-desc {
      font-size: 0.75rem;
      color: #94a3b8;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .panic-badge {
      position: absolute;
      top: -8px;
      right: -8px;
      display: flex;
      align-items: center;
      gap: 3px;
      font-size: 0.65rem;
      font-weight: 700;
      background: #ef4444;
      color: #fff;
      padding: 3px 7px;
      border-radius: 6px;
      letter-spacing: 0.5px;
      box-shadow: 0 2px 8px rgba(239, 68, 68, 0.5);
      z-index: 1;
    }

    .panic-badge svg {
      width: 12px;
      height: 12px;
      fill: #fff;
    }

    /* Category Colors for EMS */
    .status-card.available { border-left: 4px solid #10b981; }
    .status-card.busy { border-left: 4px solid #f59e0b; }
    .status-card.emergency { border-left: 4px solid #ef4444; }
    .status-card.offline { border-left: 4px solid #6b7280; }

    /* Static action buttons row */
    .action-buttons-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      padding: 1.25rem 1.25rem 0;
    }
    .action-btn {
      position: relative;
      border: 2px solid;
      border-radius: 10px;
      padding: 0.875rem 1rem;
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .action-btn i { font-size: 1.1rem; }
    .action-btn-signal100 {
      background: rgba(153, 27, 27, 0.3);
      border-color: #dc2626;
      color: #fca5a5;
    }
    .action-btn-signal100:hover {
      background: rgba(220, 38, 38, 0.4);
      box-shadow: 0 4px 15px rgba(220, 38, 38, 0.4);
      transform: translateY(-2px);
    }
    .action-btn-panic {
      background: rgba(194, 65, 12, 0.3);
      border-color: #f97316;
      color: #fdba74;
    }
    .action-btn-panic:hover {
      background: rgba(249, 115, 22, 0.4);
      box-shadow: 0 4px 15px rgba(249, 115, 22, 0.4);
      transform: translateY(-2px);
    }
    .action-btn-panic.active {
      background: rgba(154, 52, 18, 0.8);
      border-color: #f97316;
    }
    .action-btn-signal100.active {
      background: rgba(153, 27, 27, 0.8);
      border-color: #dc2626;
    }
    .action-btn.loading {
      opacity: 0.6;
      pointer-events: none;
    }
    .action-btn .fa-spinner {
      animation: btn-spin 1s linear infinite;
    }
    @keyframes btn-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Emergency active state - pulsing red animation */
    .status-card.emergency.active {
      border-color: #ef4444;
      background: rgba(239, 68, 68, 0.25);
      box-shadow: 0 0 20px rgba(239, 68, 68, 0.5);
      animation: pulse-emergency-card 1.5s ease-in-out infinite;
    }

    .status-card.emergency.active .status-card-code {
      color: #ef4444;
    }

    @keyframes pulse-emergency-card {
      0%, 100% {
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.5);
        background: rgba(239, 68, 68, 0.2);
      }
      50% {
        box-shadow: 0 0 30px rgba(239, 68, 68, 0.8), 0 0 60px rgba(239, 68, 68, 0.4);
        background: rgba(239, 68, 68, 0.35);
      }
    }

    .view-all-codes-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: calc(100% - 2.5rem);
      margin: 0 1.25rem 1.25rem;
      padding: 0.75rem;
      background: rgba(239, 68, 68, 0.1);
      border: 1px dashed rgba(239, 68, 68, 0.4);
      border-radius: 8px;
      color: #ef4444;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .view-all-codes-btn:hover {
      background: rgba(239, 68, 68, 0.2);
      border-color: #ef4444;
    }

    .view-all-codes-btn.expanded i {
      transform: rotate(180deg);
