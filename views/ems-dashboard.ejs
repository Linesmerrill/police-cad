                  </div>
                  <div class="col-md-4">
                    <strong>Date of Birth:</strong> <span id="display-patient-dob">-</span>
                  </div>
                  <div class="col-md-4">
                    <strong>License #:</strong> <span id="display-patient-license">-</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Create Report Form -->
            <form id="createReportForm">
              <input type="hidden" id="new-report-civilianID" name="civilianID">
              <input type="hidden" id="new-report-name" name="name">
              <input type="hidden" id="new-report-dateOfBirth" name="dateOfBirth">
              <input type="hidden" id="new-report-license" name="license">
              <input type="hidden" id="new-report-reportingEmsID" name="reportingEmsID">
