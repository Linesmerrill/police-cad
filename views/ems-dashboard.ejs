              <div class="panel-heading">
                <h6 class="panel-title">Patient Information</h6>
              </div>
              <div class="panel-body">
                <div class="row">
                  <div class="col-md-6">
                    <strong>Name:</strong> <span id="med-name">-</span>
                  </div>
                  <div class="col-md-6">
                    <strong>Start Date:</strong> <span id="medicationStartDate">-</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Add Medication Form -->
