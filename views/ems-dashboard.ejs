              <input type="hidden" id="med-civilianID" name="civilianID">
              <input type="hidden" id="med-name-hidden" name="name">
              <input type="hidden" id="med-activeCommunityID" name="activeCommunityID">
              <input type="hidden" id="med-userID" name="userID">
              <input type="hidden" id="med-firstName" name="firstName">
              <input type="hidden" id="med-lastName" name="lastName">
              <input type="hidden" id="med-dateOfBirth" name="dateOfBirth">
              
              <div class="form-group">
                <label for="med-startDate">Start Date: <span class="text-danger">*</span></label>
                <input type="date" id="med-startDate" name="startDate" class="form-control" required>
              </div>
              
              <div class="form-group">
                <label for="med-medicationName">Medication Name: <span class="text-danger">*</span></label>
                <input type="text" id="med-medicationName" name="medicationName" class="form-control" placeholder="Enter medication name..." required>
              </div>
              
              <div class="form-group">
                <label for="med-dosage">Dosage: <span class="text-danger">*</span></label>
                <input type="text" id="med-dosage" name="dosage" class="form-control" placeholder="e.g., 100mg" required>
              </div>
              
              <div class="form-group">
                <label for="med-frequency">Frequency: <span class="text-danger">*</span></label>
                <input type="text" id="med-frequency" name="frequency" class="form-control" placeholder="e.g., daily, twice daily, mon,friday" required>
              </div>
              
              <div class="text-center">
                <button type="button" class="btn btn-secondary margin-right-1" onclick="showSearchView()">
                  <i class="fa fa-arrow-left"></i> Back to Search
                </button>
                <button type="submit" class="btn btn-success">
                  <i class="fa fa-plus"></i> Add Medication
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

