    .wm-search-bar > select { flex: 1; min-width: 0; }
    .wm-search-bar > button { flex: 0 0 auto; }

    .wm-input {
      background: rgba(255,255,255,0.035);
      border: 1px solid rgba(255,255,255,0.07);
