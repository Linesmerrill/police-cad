<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>LPC - Admin Profile</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/static/images/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/images/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/static/images/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/static/images/android-chrome-512x512.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/images/apple-touch-icon.png">
    <link rel="manifest" href="/static/images/site.webmanifest">
    <link rel="stylesheet" href="/static/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/static/css/styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
      html, body {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0b1220 100%);
        background-attachment: fixed;
        background-size: cover;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        overflow-x: hidden;
      }

      html {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0b1220 100%);
        background-attachment: fixed;
        background-size: cover;
      }

      body {
        color: #e5e7eb;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .admin-navbar {
        background: rgba(30, 32, 40, 0.95) !important;
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #35385a;
        min-height: 60px;
      }
      .admin-navbar .navbar-brand {
        color: #fff !important;
        font-weight: 600;
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      .admin-navbar .btn-link {
        color: #9aa0b4 !important;
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }
      .admin-navbar .btn-link:hover { color: #c7cbe2 !important; }
      .admin-navbar .navbar-nav > li > span {
        display: flex !important;
        align-items: center !important;
        height: 60px;
        padding: 15px 15px;
      }

      .admin-container {
        margin-top: 80px;
        padding: 2rem 0;
        flex: 1;
      }
      .profile-card {
        background: #1e2028;
        border: 1px solid #35385a;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
      }
      .form-group {
        margin-bottom: 1.5rem;
      }
      .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: #9aa0b4;
        font-weight: 500;
        font-size: 0.9rem;
      }
      .form-input {
        background: #11131a;
        border: 1px solid #2a2d45;
        color: #e5e7eb;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        width: 100%;
        box-sizing: border-box;
      }
      .form-input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102,126,234,0.25);
        outline: none;
      }
      .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        color: #fff;
        transition: all 0.2s;
        cursor: pointer;
      }
      .btn-gradient:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        color: #fff;
      }
      .btn-secondary {
        background: #2a2d45;
        border: 1px solid #35385a;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        color: #9aa0b4;
        transition: all 0.2s;
        cursor: pointer;
      }
      .btn-secondary:hover {
        background: #35385a;
        color: #e5e7eb;
      }

      .profile-picture-section {
        text-align: center;
        margin-bottom: 2rem;
      }
      .profile-picture-container {
        position: relative;
        display: inline-block;
      }
      .profile-picture {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #667eea;
        background: #11131a;
      }
      .profile-picture-overlay {
        position: absolute;
        bottom: 0;
        right: 0;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 2px solid #1e2028;
        transition: all 0.2s;
      }
      .profile-picture-overlay:hover {
        transform: scale(1.1);
      }
      .profile-picture-overlay i {
        color: #fff;
        font-size: 14px;
      }
      #profilePictureInput {
        display: none;
      }

      .setup-banner {
        background: linear-gradient(135deg, rgba(102,126,234,0.2) 0%, rgba(118,75,162,0.2) 100%);
        border: 1px solid rgba(102,126,234,0.3);
        border-radius: 12px;
        padding: 1rem 1.5rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .setup-banner i {
        color: #667eea;
        font-size: 1.5rem;
      }
      .setup-banner p {
        margin: 0;
        color: #e5e7eb;
      }

      .form-row {
        display: flex;
        gap: 1rem;
      }
      .form-row .form-group {
        flex: 1;
      }

      .password-section {
        background: #11131a;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .password-section span {
        color: #9aa0b4;
      }

      .alert {
        padding: 1rem 1.5rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
      }
      .alert-success {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #10b981;
      }
      .alert-error {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #ef4444;
      }

      .back-link {
        color: #9aa0b4;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 1rem;
        transition: color 0.2s;
      }
      .back-link:hover {
        color: #667eea;
      }

      /* Bootstrap 3 (loaded above) resets html to font-size: 10px,
         which makes every rem on this page render at 62.5% of intended
         size. Restore the conventional 16px baseline. */
      html { font-size: 16px; }

      /* =====================================================
         LINKED LPC ACCOUNT — section + modals
         ===================================================== */

      /* ---------- Section ---------- */
      .link-lpc-section {
        margin-top: 0.25rem;
        padding: 1.5rem;
        background: #14161e;
        border: 1px solid #2a2d45;
        border-radius: 14px;
        position: relative;
        overflow: hidden;
      }
      .link-lpc-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(102,126,234,0.07), transparent 60%);
        pointer-events: none;
      }
      .link-lpc-section > * { position: relative; }

      .link-lpc-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.875rem;
      }
      .link-lpc-title {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: #e5e7eb;
        letter-spacing: 0.01em;
      }
      .link-lpc-title-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: linear-gradient(135deg, rgba(102,126,234,0.22), rgba(118,75,162,0.18));
        border: 1px solid rgba(102,126,234,0.32);
        color: #b1bdf5;
        font-size: 12px;
      }

      .link-lpc-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 4px 10px 4px 9px;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        white-space: nowrap;
      }
      .link-lpc-chip-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
      }
      .link-lpc-chip.is-not-linked {
        background: rgba(154,160,180,0.1);
        color: #9aa0b4;
        border: 1px solid rgba(154,160,180,0.2);
      }
      .link-lpc-chip.is-not-linked .link-lpc-chip-dot { background: #9aa0b4; }
      .link-lpc-chip.is-linked {
        background: rgba(16,185,129,0.1);
        color: #34d399;
        border: 1px solid rgba(16,185,129,0.28);
      }
      .link-lpc-chip.is-linked .link-lpc-chip-dot {
        background: #10b981;
        box-shadow: 0 0 0 0 rgba(16,185,129,0.6);
        animation: lpcPulse 2.4s ease-out infinite;
      }
      @keyframes lpcPulse {
        0%   { box-shadow: 0 0 0 0 rgba(16,185,129,0.55); }
        70%  { box-shadow: 0 0 0 8px rgba(16,185,129,0); }
        100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }
      }

      .link-lpc-explainer {
        color: #9aa0b4;
        font-size: 0.875rem;
        line-height: 1.55;
        margin: 0 0 1.125rem;
        max-width: 56ch;
      }

      .link-lpc-note {
        display: flex;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        margin: 0 0 1.125rem;
        background: rgba(102,126,234,0.06);
        border: 1px solid rgba(102,126,234,0.2);
        border-left: 3px solid rgba(102,126,234,0.6);
        border-radius: 10px;
        color: #c7cbe2;
        font-size: 0.83rem;
        line-height: 1.55;
      }
      .link-lpc-note i {
        color: #8a9cf2;
        font-size: 14px;
        margin-top: 2px;
        flex: 0 0 auto;
      }
      .link-lpc-note strong { color: #e5e7eb; font-weight: 600; }
      .link-lpc-note em { color: #fbbf24; font-style: normal; font-weight: 600; }

      .link-lpc-empty {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 1rem;
      }
      .link-lpc-empty .btn-gradient {
        white-space: nowrap;
        padding: 0.625rem 1.125rem;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
      }

      .link-lpc-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.875rem 1rem;
        background: linear-gradient(135deg, rgba(102,126,234,0.08), rgba(118,75,162,0.04));
        border: 1px solid rgba(102,126,234,0.24);
        border-radius: 12px;
        margin-bottom: 1rem;
      }
      .link-lpc-avatar {
        position: relative;
        width: 44px;
        height: 44px;
        flex: 0 0 auto;
      }
      .link-lpc-avatar img {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        background: #11131a;
        border: 2px solid rgba(102,126,234,0.55);
        display: block;
      }
      .link-lpc-avatar::after {
        content: '';
        position: absolute;
        right: -2px;
        bottom: -2px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #10b981;
        border: 2px solid #14161e;
      }
      .link-lpc-card-meta { flex: 1; min-width: 0; }
      .link-lpc-card-username {
        display: block;
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .link-lpc-card-email {
        display: block;
        color: #9aa0b4;
        font-size: 0.83rem;
        margin-top: 1px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .link-lpc-card-since {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        color: #6b7290;
        font-size: 0.72rem;
        letter-spacing: 0.02em;
      }
      .link-lpc-card-since i { font-size: 9px; }

      .link-lpc-actions {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
        flex-wrap: wrap;
      }
      .link-lpc-actions .btn-secondary,
      .link-lpc-actions .btn-danger-outline {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .btn-danger-outline {
        background: transparent;
        border: 1px solid rgba(239,68,68,0.45);
        border-radius: 12px;
        padding: 0.5rem 1rem;
        font-weight: 600;
        color: #ef4444;
        transition: all 0.15s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
      }
      .btn-danger-outline:hover {
        background: rgba(239,68,68,0.1);
        border-color: #ef4444;
        color: #fca5a5;
      }
      .btn-danger-outline:focus { outline: none; box-shadow: 0 0 0 3px rgba(239,68,68,0.22); }
      .btn-danger-outline:disabled { opacity: 0.5; cursor: not-allowed; }

      .link-lpc-skeleton {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .skel {
        background: linear-gradient(90deg, #1e2028 0%, #2a2d45 50%, #1e2028 100%);
        background-size: 200% 100%;
        animation: lpcShimmer 1.4s ease-in-out infinite;
        border-radius: 8px;
      }
      .skel-header { height: 28px; width: 50%; }
      .skel-row { height: 64px; width: 100%; border-radius: 12px; }
      @keyframes lpcShimmer {
        0%   { background-position: 100% 0; }
        100% { background-position: -100% 0; }
      }

      /* ---------- LPC modals ---------- */
      .lpc-modal { color: #e5e7eb; }
      .lpc-modal .modal-dialog { max-width: 560px; }
      .lpc-modal-sm .modal-dialog { max-width: 460px; }

      .lpc-modal .modal-content {
        background: #1e2028;
        border: 1px solid #35385a;
        border-radius: 16px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.55);
        overflow: hidden;
      }
      .lpc-modal .modal-header {
        border-bottom: 1px solid #2a2d45;
        padding: 1.25rem 1.5rem;
        background: linear-gradient(180deg, rgba(102,126,234,0.06), transparent);
      }
      .lpc-modal .modal-title {
        color: #fff;
        font-weight: 700;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
      }
      .lpc-modal .modal-title-icon { color: #8a9cf2; font-size: 0.95rem; }
      .lpc-modal .modal-subtitle {
        margin: 6px 0 0;
        color: #9aa0b4;
        font-size: 0.85rem;
        line-height: 1.45;
      }
      .lpc-modal .close {
        color: #9aa0b4;
        text-shadow: none;
        opacity: 0.7;
        font-size: 1.5rem;
        font-weight: 400;
        margin-top: -2px;
      }
      .lpc-modal .close:hover { color: #e5e7eb; opacity: 1; }
      .lpc-modal .modal-body {
        padding: 1.5rem;
        max-height: calc(100vh - 240px);
        overflow-y: auto;
      }
      .lpc-modal .modal-footer {
        border-top: 1px solid #2a2d45;
        padding: 1rem 1.5rem;
        background: #181a22;
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
      }
      .lpc-modal .modal-footer .btn-gradient,
      .lpc-modal .modal-footer .btn-secondary,
      .lpc-modal .modal-footer .btn-danger-outline {
        padding: 0.6rem 1.25rem;
        font-size: 0.9rem;
      }
      .lpc-modal .btn-gradient:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none !important;
      }

      .lpc-step + .lpc-step { margin-top: 1.5rem; }
      .lpc-label {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #c7cbe2;
        margin-bottom: 0.625rem;
      }
      .lpc-step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0;
      }

      .lpc-search-wrap { position: relative; }
      .lpc-search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #6b7290;
        font-size: 13px;
        pointer-events: none;
      }
      .lpc-search-input {
        padding-left: 38px !important;
        padding-right: 38px !important;
      }
      .lpc-search-spinner {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #8a9cf2;
        font-size: 13px;
        opacity: 0;
        transition: opacity 0.15s;
      }
      .lpc-search-spinner.is-active { opacity: 1; }

      .lpc-results {
        margin-top: 0.625rem;
        max-height: 280px;
        overflow-y: auto;
        border-radius: 10px;
        background: #11131a;
        border: 1px solid #2a2d45;
        display: none;
        padding: 4px;
      }
      .lpc-results.is-active { display: block; }
      .lpc-results::-webkit-scrollbar { width: 8px; }
      .lpc-results::-webkit-scrollbar-thumb { background: #35385a; border-radius: 4px; }
      .lpc-results::-webkit-scrollbar-track { background: transparent; }

      .lpc-result {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 0.625rem 0.75rem;
        cursor: pointer;
        border: 1px solid transparent;
        border-radius: 8px;
        transition: background 0.12s, border-color 0.12s;
        outline: none;
      }
      .lpc-result + .lpc-result { margin-top: 2px; }
      .lpc-result:hover { background: rgba(102,126,234,0.07); }
      .lpc-result:focus-visible { box-shadow: 0 0 0 2px rgba(102,126,234,0.4); }
      .lpc-result.is-selected {
        background: rgba(102,126,234,0.13);
        border-color: rgba(102,126,234,0.55);
        box-shadow: 0 0 0 1px rgba(102,126,234,0.25), 0 4px 14px rgba(102,126,234,0.18);
      }
      .lpc-result-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #11131a;
        border: 1px solid #2a2d45;
        flex: 0 0 auto;
        object-fit: cover;
      }
      .lpc-result-meta { flex: 1; min-width: 0; }
      .lpc-result-username {
        color: #e5e7eb;
        font-size: 0.9rem;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .lpc-result-email {
        color: #9aa0b4;
        font-size: 0.78rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-top: 1px;
      }
      .lpc-result-radio {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2px solid #35385a;
        flex: 0 0 auto;
        position: relative;
        transition: border-color 0.12s;
      }
      .lpc-result.is-selected .lpc-result-radio { border-color: #8a9cf2; }
      .lpc-result.is-selected .lpc-result-radio::after {
        content: '';
        position: absolute;
        inset: 3px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
      }

      .lpc-results-empty,
      .lpc-results-error {
        padding: 1.5rem 1rem;
        text-align: center;
        color: #9aa0b4;
        font-size: 0.85rem;
      }
      .lpc-results-empty i,
      .lpc-results-error i {
        display: block;
        font-size: 1.4rem;
        margin-bottom: 0.5rem;
        color: #6b7290;
      }
      .lpc-results-error i { color: #f87171; }

      .lpc-selected-card {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 0.875rem 1rem;
        background: linear-gradient(135deg, rgba(102,126,234,0.09), rgba(118,75,162,0.05));
        border: 1px solid rgba(102,126,234,0.32);
        border-radius: 12px;
      }
      .lpc-selected-card img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(102,126,234,0.5);
        flex: 0 0 auto;
        background: #11131a;
      }
      .lpc-selected-card .meta { flex: 1; min-width: 0; }
      .lpc-selected-card .username {
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .lpc-selected-card .email {
        color: #9aa0b4;
        font-size: 0.8rem;
        display: block;
        margin-top: 1px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .lpc-selected-card .change-btn {
        background: transparent;
        border: 1px solid #35385a;
        color: #c7cbe2;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.75rem;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.15s;
        flex: 0 0 auto;
      }
      .lpc-selected-card .change-btn:hover {
        background: #2a2d45;
        border-color: #4a4d6a;
        color: #fff;
      }

      .lpc-disclaimer {
        display: flex;
        gap: 0.875rem;
        padding: 1rem 1.125rem;
        background: rgba(245,158,11,0.06);
        border: 1px solid rgba(245,158,11,0.22);
        border-left: 3px solid #f59e0b;
        border-radius: 12px;
      }
      .lpc-disclaimer-icon {
        color: #f59e0b;
        font-size: 18px;
        line-height: 1;
        margin-top: 2px;
        flex: 0 0 auto;
      }
      .lpc-disclaimer-body { flex: 1; min-width: 0; }
      .lpc-disclaimer-lede {
        margin: 0 0 0.5rem;
        color: #e5e7eb;
        font-size: 0.875rem;
        font-weight: 500;
      }
      .lpc-disclaimer-list {
        margin: 0 0 0.875rem;
        padding-left: 1.125rem;
        color: #c7cbe2;
        font-size: 0.83rem;
        line-height: 1.55;
      }
      .lpc-disclaimer-list li { margin-bottom: 0.35rem; }
      .lpc-disclaimer-list li:last-child { margin-bottom: 0; }
      .lpc-disclaimer-list strong { color: #fbbf24; font-weight: 600; }
      .lpc-terms-link {
        color: #fbbf24;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color 0.15s;
      }
      .lpc-terms-link:hover,
      .lpc-terms-link:focus { color: #fde68a; text-decoration: underline; }
      .lpc-terms-link:focus { outline: none; }

      .lpc-checkbox {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        cursor: pointer;
        padding: 0.625rem 0.75rem;
        background: rgba(0,0,0,0.2);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 8px;
        transition: border-color 0.15s, background 0.15s;
        user-select: none;
        margin: 0;
      }
      .lpc-checkbox:hover {
        border-color: rgba(102,126,234,0.32);
        background: rgba(102,126,234,0.05);
      }
      .lpc-checkbox input { position: absolute; opacity: 0; pointer-events: none; }
      .lpc-checkbox-box {
        width: 18px;
        height: 18px;
        border-radius: 5px;
        border: 1.5px solid #4a4d6a;
        background: #11131a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        margin-top: 1px;
        transition: all 0.15s;
      }
      .lpc-checkbox-box i {
        color: #fff;
        font-size: 10px;
        opacity: 0;
        transform: scale(0.6);
        transition: all 0.15s;
      }
      .lpc-checkbox input:checked + .lpc-checkbox-box {
        background: linear-gradient(135deg, #667eea, #764ba2);
        border-color: #667eea;
      }
      .lpc-checkbox input:checked + .lpc-checkbox-box i {
        opacity: 1;
        transform: scale(1);
      }
      .lpc-checkbox-text {
        color: #e5e7eb;
        font-size: 0.85rem;
        line-height: 1.45;
        font-weight: 400;
      }

      .lpc-modal-error {
        display: none;
        align-items: center;
        gap: 10px;
        padding: 0.75rem 1rem;
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.28);
        border-radius: 10px;
        color: #fca5a5;
        font-size: 0.85rem;
        margin-bottom: 1.25rem;
        line-height: 1.4;
      }
      .lpc-modal-error.is-visible { display: flex; }
      .lpc-modal-error i { font-size: 14px; flex: 0 0 auto; }

      .lpc-unlink-prompt {
        margin: 0;
        color: #c7cbe2;
        font-size: 0.92rem;
        line-height: 1.55;
      }
      .lpc-unlink-prompt strong { color: #fff; font-weight: 600; }

      .lpc-modal.in { z-index: 1060; }

      @media (max-width: 540px) {
        .link-lpc-empty { flex-direction: column; align-items: stretch; }
        .link-lpc-empty .btn-gradient { width: 100%; justify-content: center; }
        .link-lpc-card { flex-wrap: wrap; }
        .link-lpc-actions { width: 100%; }
        .link-lpc-actions .btn-secondary,
        .link-lpc-actions .btn-danger-outline {
          flex: 1;
          justify-content: center;
        }
        .lpc-modal .modal-footer { flex-wrap: wrap; }
        .lpc-modal .modal-footer .btn-gradient,
        .lpc-modal .modal-footer .btn-secondary,
        .lpc-modal .modal-footer .btn-danger-outline { flex: 1; justify-content: center; }
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-default navbar-fixed-top admin-navbar">
      <div class="container-fluid">
        <div class="navbar-header">
          <a class="navbar-brand" href="/admin/console">
            <img src="/static/images/dispatch-logo-512.png" style="width:32px; height:32px; margin-right:10px; border-radius:8px;" />
            LPC Admin Console
          </a>
        </div>
        <div class="navbar-collapse collapse">
          <ul class="nav navbar-nav navbar-right">
            <li>
              <span style="color: #9aa0b4;">
                <% if (admin && admin.profilePicture) { %>
                  <img src="<%= admin.profilePicture %>" style="width: 24px; height: 24px; border-radius: 50%; margin-right: 8px; object-fit: cover;" />
                <% } else { %>
                  <i class="fas fa-user" style="margin-right: 8px;"></i>
                <% } %>
                <%= admin && admin.firstName && admin.lastName ? admin.firstName + ' ' + admin.lastName : (admin && admin.email ? admin.email : 'Admin') %>
              </span>
            </li>
            <li>
              <form id="logoutForm" action="/admin/logout" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-link">
                  <i class="fas fa-sign-out-alt" style="margin-right: 8px;"></i>Logout
                </button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container admin-container">
      <a href="/admin/console" class="back-link">
        <i class="fas fa-arrow-left"></i>
        Back to Console
      </a>

      <div class="profile-card">
        <h2 style="margin-bottom: 1.5rem; color: #fff; font-weight: 700; text-align: center;">
          <i class="fas fa-user-edit" style="margin-right: 12px; color: #667eea;"></i>
          Admin Profile
        </h2>

        <% if (typeof setup !== 'undefined' && setup) { %>
          <div class="setup-banner">
            <i class="fas fa-info-circle"></i>
            <p>Please complete your profile by adding your first and last name.</p>
          </div>
        <% } %>

        <div id="alertContainer"></div>

        <form id="profileForm">
          <div class="profile-picture-section">
            <div class="profile-picture-container">
              <img id="profilePicturePreview"
                   src="<%= admin && admin.profilePicture ? admin.profilePicture : '/static/images/civ-unknown-user.png' %>"
                   class="profile-picture"
                   alt="Profile Picture" />
              <label for="profilePictureInput" class="profile-picture-overlay">
                <i class="fas fa-camera"></i>
              </label>
              <input type="file" id="profilePictureInput" accept="image/*" />
            </div>
            <p style="margin-top: 0.5rem; color: #9aa0b4; font-size: 0.85rem;">Click to upload a new photo</p>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="firstName">First Name <span style="color: #ef4444;">*</span></label>
              <input type="text" id="firstName" name="firstName" class="form-input"
                     value="<%= admin && admin.firstName ? admin.firstName : '' %>"
                     placeholder="Enter your first name" required />
            </div>
            <div class="form-group">
              <label for="lastName">Last Name <span style="color: #ef4444;">*</span></label>
              <input type="text" id="lastName" name="lastName" class="form-input"
                     value="<%= admin && admin.lastName ? admin.lastName : '' %>"
                     placeholder="Enter your last name" required />
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" class="form-input"
                   value="<%= admin && admin.email ? admin.email : '' %>"
                   placeholder="Enter your email" />
          </div>

          <div class="form-group">
            <label>Password</label>
            <div class="password-section">
              <span><i class="fas fa-lock" style="margin-right: 8px;"></i>Password is encrypted</span>
              <a href="/admin/forgot-password" class="btn-secondary" style="text-decoration: none;">
                <i class="fas fa-key" style="margin-right: 8px;"></i>Reset Password
              </a>
            </div>
          </div>

          <div class="form-group">
            <div class="link-lpc-section" id="linkLpcSection" aria-live="polite">
              <div class="link-lpc-skeleton" aria-busy="true">
                <div class="skel skel-header"></div>
                <div class="skel skel-row"></div>
              </div>
            </div>
          </div>

          <input type="hidden" id="profilePicture" name="profilePicture"
                 value="<%= admin && admin.profilePicture ? admin.profilePicture : '' %>" />

          <div style="text-align: center; margin-top: 2rem;">
            <button type="submit" class="btn-gradient" style="min-width: 200px;">
              <i class="fas fa-save" style="margin-right: 8px;"></i>Save Profile
            </button>
          </div>
        </form>
      </div>
    </div>

    <script src="/static/js/jquery.min.js"></script>
    <script src="/static/js/bootstrap.min.js"></script>
    <script src="/static/js/cloudinary-upload.js"></script>
    <script>
      // Cloudinary config
      window.CLOUDINARY_CLOUD_NAME = <%- JSON.stringify(CLOUDINARY_CLOUD_NAME || '') %>;
      window.CLOUDINARY_API_KEY = <%- JSON.stringify(CLOUDINARY_API_KEY || '') %>;
      window.CLOUDINARY_UPLOAD_PRESET = <%- JSON.stringify(CLOUDINARY_UPLOAD_PRESET || '') %>;

      const API_BASE = <%- JSON.stringify(POLICE_CAD_API_URL || '') %>;
      const adminId = <%- JSON.stringify(admin && admin.id ? String(admin.id) : '') %>;
      const adminData = {
        id: <%- JSON.stringify(admin && admin.id ? String(admin.id) : '') %>,
        email: <%- JSON.stringify(admin && admin.email ? admin.email : '') %>,
        roles: <%- JSON.stringify(admin && admin.roles ? admin.roles : []) %>
      };

      function showAlert(message, type) {
        const alertClass = type === 'success' ? 'alert-success' : 'alert-error';
        const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
        const $alert = $('<div>').addClass('alert ' + alertClass);
        $('<i>').addClass('fas ' + icon).css('margin-right', '8px').appendTo($alert);
        $alert.append(document.createTextNode(message));
        $('#alertContainer').empty().append($alert);

        // Auto-hide after 5 seconds
        setTimeout(() => {
          $('#alertContainer').html('');
        }, 5000);
      }

      $(document).ready(function() {
        // Profile picture upload
        $('#profilePictureInput').on('change', async function(e) {
        const file = e.target.files[0];
        if (!file) return;

        // Validate file size (max 5MB)
        if (file.size > 5 * 1024 * 1024) {
          showAlert('Image must be less than 5MB', 'error');
          return;
        }

        // Validate file type
        if (!file.type.startsWith('image/')) {
          showAlert('Please select an image file', 'error');
          return;
        }

        // Show preview immediately
        const reader = new FileReader();
        reader.onload = function(e) {
          $('#profilePicturePreview').attr('src', e.target.result);
        };
        reader.readAsDataURL(file);

        // Upload to Cloudinary
        try {
          showAlert('Uploading image...', 'success');
          const imageUrl = await window.uploadToCloudinary(file, API_BASE);
          $('#profilePicture').val(imageUrl);
          showAlert('Image uploaded successfully!', 'success');
        } catch (error) {
          console.error('Upload failed:', error);
          showAlert('Failed to upload image. Please try again.', 'error');
          // Revert preview - validate URL before using as src
          const currentUrl = $('#profilePicture').val();
          if (currentUrl && /^https?:\/\//i.test(currentUrl)) {
            $('#profilePicturePreview').attr('src', currentUrl);
          } else {
            $('#profilePicturePreview').attr('src', '/static/images/civ-unknown-user.png');
          }
        }
      });

      // Form submission
      // =====================================================
      // Linked LPC Account
      // =====================================================
      (function initLinkedLpcAccount() {
        if (!API_BASE || !adminId) return;

        const TERMS_VERSION = 'v1';
        const FALLBACK_AVATAR = '/static/images/civ-unknown-user.png';

        let currentLinked = null;
        let modalMode = 'link';
        let selectedUser = null;
        let searchDebounceTimer = null;
        let activeSearchToken = 0;
        let lastResults = [];

        const $section          = $('#linkLpcSection');
        const $linkModal        = $('#linkLpcModal');
        const $unlinkModal      = $('#unlinkLpcModal');
        const $searchInput      = $('#lpcUserSearch');
        const $searchResults    = $('#lpcSearchResults');
        const $searchSpinner    = $linkModal.find('.lpc-search-spinner');
        const $selectedSummary  = $('#lpcSelectedSummary');
        const $selectedCard     = $('#lpcSelectedCard');
        const $termsCheckbox    = $('#lpcTermsCheckbox');
        const $linkSubmitBtn    = $('#lpcLinkSubmitBtn');
        const $linkSubmitLabel  = $linkSubmitBtn.find('.lpc-submit-label');
        const $modalTitleText   = $('.lpc-modal-title-text');
        const $modalError       = $('#lpcLinkError');
        const $unlinkPrompt     = $('#lpcUnlinkPrompt');
        const $unlinkConfirmBtn = $('#lpcUnlinkConfirmBtn');

        function escapeHtml(str) {
          if (str == null) return '';
          return String(str)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        function safeAvatar(url) {
          if (typeof url === 'string' && /^https?:\/\//i.test(url)) return url;
          return FALLBACK_AVATAR;
        }
        function formatLinkedDate(value) {
          if (!value) return '';
          const d = new Date(value);
          if (isNaN(d.getTime())) return '';
          return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
        }
        function setSubmitEnabled() {
          $linkSubmitBtn.prop('disabled', !(selectedUser && $termsCheckbox.is(':checked')));
        }
        function showModalError(msg) {
          $modalError.find('span').text(msg || 'Something went wrong.');
          $modalError.addClass('is-visible');
        }
        function clearModalError() {
          $modalError.removeClass('is-visible').find('span').text('');
        }

        function renderSkeleton() {
          $section.html(
            '<div class="link-lpc-skeleton" aria-busy="true">' +
              '<div class="skel skel-header"></div>' +
              '<div class="skel skel-row"></div>' +
            '</div>'
          );
        }

        function renderNotLinked() {
          const adminEmail = (adminData && adminData.email) ? adminData.email : '';
          const matchNoteEmail = adminEmail
            ? 'an LPC account with the email <strong>' + escapeHtml(adminEmail) + '</strong>'
            : 'an LPC account using the same email as your admin account';
          $section.html(
            '<div class="link-lpc-head">' +
              '<div class="link-lpc-title">' +
                '<span class="link-lpc-title-icon"><i class="fas fa-link"></i></span>' +
                'Linked LPC Account' +
              '</div>' +
              '<span class="link-lpc-chip is-not-linked">' +
                '<span class="link-lpc-chip-dot"></span>Not linked' +
              '</span>' +
            '</div>' +
            '<p class="link-lpc-explainer">Link an LPC account to use admin-elevated features (like feature requests) inside LPC. Your admin account will continue to be used only for logging in to this console.</p>' +
            '<div class="link-lpc-note">' +
              '<i class="fas fa-info-circle"></i>' +
              '<span>While unlinked, your admin email already grants elevated access on ' + matchNoteEmail + ' by default. Only link if you want elevated access on a <em>different</em> LPC account &mdash; you can always disconnect later to return to this default behavior.</span>' +
            '</div>' +
            '<div class="link-lpc-empty">' +
              '<button type="button" class="btn-gradient" id="lpcLinkBtn">' +
                '<i class="fas fa-link" style="margin-right:8px;"></i>Link LPC Account' +
              '</button>' +
            '</div>'
          );
          $('#lpcLinkBtn').on('click', function () { openLinkModal('link'); });
        }

        function renderLinked(linked) {
          const username = linked.username || '(no username)';
          const linkedSince = formatLinkedDate(linked.linkedAt);
          $section.html(
            '<div class="link-lpc-head">' +
              '<div class="link-lpc-title">' +
                '<span class="link-lpc-title-icon"><i class="fas fa-link"></i></span>' +
                'Linked LPC Account' +
              '</div>' +
              '<span class="link-lpc-chip is-linked">' +
                '<span class="link-lpc-chip-dot"></span>Linked' +
              '</span>' +
            '</div>' +
            '<div class="link-lpc-card">' +
              '<div class="link-lpc-avatar">' +
                '<img src="' + escapeHtml(safeAvatar(linked.profilePicture)) + '" alt="" />' +
              '</div>' +
              '<div class="link-lpc-card-meta">' +
                '<span class="link-lpc-card-username">' + escapeHtml(username) + '</span>' +
                '<span class="link-lpc-card-email">' + escapeHtml(linked.email || '') + '</span>' +
                (linkedSince ? '<span class="link-lpc-card-since"><i class="fas fa-clock"></i>Linked on ' + escapeHtml(linkedSince) + '</span>' : '') +
              '</div>' +
            '</div>' +
            '<div class="link-lpc-actions">' +
              '<button type="button" class="btn-secondary" id="lpcRelinkBtn">' +
                '<i class="fas fa-exchange-alt"></i>Relink' +
              '</button>' +
              '<button type="button" class="btn-danger-outline" id="lpcUnlinkBtn">' +
                '<i class="fas fa-unlink"></i>Disconnect' +
              '</button>' +
            '</div>'
          );
          $section.find('.link-lpc-avatar img').on('error', function () { this.src = FALLBACK_AVATAR; });
          $('#lpcRelinkBtn').on('click', function () { openLinkModal('relink'); });
          $('#lpcUnlinkBtn').on('click', openUnlinkModal);
        }

        function renderLoadError() {
          $section.html(
            '<div class="link-lpc-head">' +
              '<div class="link-lpc-title">' +
                '<span class="link-lpc-title-icon"><i class="fas fa-link"></i></span>' +
                'Linked LPC Account' +
              '</div>' +
            '</div>' +
            '<p class="link-lpc-explainer" style="color:#fca5a5;">' +
              '<i class="fas fa-exclamation-circle" style="margin-right:6px;"></i>' +
              'Could not load linked account status. ' +
              '<a href="#" id="lpcRetryLoad" style="color:#8a9cf2;text-decoration:underline;">Retry</a>' +
            '</p>'
          );
          $('#lpcRetryLoad').on('click', function (e) { e.preventDefault(); loadLinkedState(); });
        }

        async function loadLinkedState() {
          renderSkeleton();
          try {
            const res = await fetch(API_BASE + '/api/v1/admin/admins/' + adminId + '/linked-lpc', {
              method: 'GET',
              headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (!res.ok || !data.success) { renderLoadError(); return; }
            currentLinked = data.linked || null;
            if (currentLinked) renderLinked(currentLinked); else renderNotLinked();
          } catch (err) {
            console.error('linked-lpc load failed', err);
            renderLoadError();
          }
        }

        function openLinkModal(mode) {
          modalMode = mode;
          selectedUser = null;
          lastResults = [];
          clearModalError();
          $searchInput.val('');
          $searchResults.removeClass('is-active').empty();
          $searchSpinner.removeClass('is-active');
          $termsCheckbox.prop('checked', false);
          $selectedSummary.attr('hidden', true);
          $selectedCard.empty();

          if (mode === 'relink') {
            $modalTitleText.text('Relink LPC Account');
            $linkSubmitLabel.text('Update Link');
          } else {
            $modalTitleText.text('Link LPC Account');
            $linkSubmitLabel.text('Link Account');
          }

          setSubmitEnabled();
          $linkModal.modal('show');
          setTimeout(function () { $searchInput.focus(); }, 250);
        }

        function handleSearchInput() {
          clearModalError();
          const q = $searchInput.val().trim();
          if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
          if (!q) {
            activeSearchToken++;
            $searchSpinner.removeClass('is-active');
            $searchResults.removeClass('is-active').empty();
            return;
          }
          $searchSpinner.addClass('is-active');
          searchDebounceTimer = setTimeout(function () { runSearch(q); }, 250);
        }

        async function runSearch(query) {
          const token = ++activeSearchToken;
          try {
            const res = await fetch(API_BASE + '/api/v1/admin/search/users', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ query: query, page: 0, limit: 10 })
            });
            const data = await res.json();
            if (token !== activeSearchToken) return;
            $searchSpinner.removeClass('is-active');
            if (!res.ok) { renderResultsError('Search failed. Try again.'); return; }
            const users = (data && data.users) || [];
            lastResults = users;
            renderResults(users);
          } catch (err) {
            if (token !== activeSearchToken) return;
            $searchSpinner.removeClass('is-active');
            renderResultsError('Network error.');
          }
        }

        function renderResults(users) {
          $searchResults.addClass('is-active');
          if (!users.length) {
            $searchResults.html(
              '<div class="lpc-results-empty">' +
                '<i class="fas fa-user-slash"></i>' +
                'No users matched that search.' +
              '</div>'
            );
            return;
          }
          let html = '';
          users.forEach(function (u) {
            const isSel = selectedUser && selectedUser.id === u.id;
            const username = u.username || '(no username)';
            const email = u.email || '';
            const avatar = safeAvatar(u.profilePicture);
            html +=
              '<div class="lpc-result' + (isSel ? ' is-selected' : '') + '" role="option" data-user-id="' + escapeHtml(u.id) + '" tabindex="0" aria-selected="' + (isSel ? 'true' : 'false') + '">' +
                '<img class="lpc-result-avatar" src="' + escapeHtml(avatar) + '" alt="" />' +
                '<div class="lpc-result-meta">' +
                  '<div class="lpc-result-username">' + escapeHtml(username) + '</div>' +
                  '<div class="lpc-result-email">' + escapeHtml(email) + '</div>' +
                '</div>' +
                '<div class="lpc-result-radio" aria-hidden="true"></div>' +
              '</div>';
          });
          $searchResults.html(html);
          $searchResults.find('.lpc-result-avatar').on('error', function () { this.src = FALLBACK_AVATAR; });

          $searchResults.find('.lpc-result')
            .on('click', function () {
              const userId = $(this).data('user-id');
              const u = lastResults.find(function (x) { return x.id === userId; });
              if (u) selectUser(u);
            })
            .on('keydown', function (e) {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                $(this).trigger('click');
              }
            });
        }

        function renderResultsError(msg) {
          $searchResults.addClass('is-active').html(
            '<div class="lpc-results-error">' +
              '<i class="fas fa-exclamation-triangle"></i>' +
              escapeHtml(msg) +
            '</div>'
          );
        }

        function selectUser(user) {
          selectedUser = user;
          $searchResults.find('.lpc-result').each(function () {
            const isSel = $(this).data('user-id') === user.id;
            $(this).toggleClass('is-selected', isSel).attr('aria-selected', isSel ? 'true' : 'false');
          });
          $selectedCard.html(
            '<img src="' + escapeHtml(safeAvatar(user.profilePicture)) + '" alt="" />' +
            '<div class="meta">' +
              '<span class="username">' + escapeHtml(user.username || '(no username)') + '</span>' +
              '<span class="email">' + escapeHtml(user.email || '') + '</span>' +
            '</div>' +
            '<button type="button" class="change-btn" id="lpcSelectedChangeBtn">Change</button>'
          );
          $selectedCard.find('img').on('error', function () { this.src = FALLBACK_AVATAR; });
          $selectedSummary.removeAttr('hidden');
          $('#lpcSelectedChangeBtn').on('click', clearSelection);
          setSubmitEnabled();
        }

        function clearSelection() {
          selectedUser = null;
          $selectedCard.empty();
          $selectedSummary.attr('hidden', true);
          $searchResults.find('.lpc-result').removeClass('is-selected').attr('aria-selected', 'false');
          setSubmitEnabled();
          $searchInput.focus();
        }

        async function submitLink() {
          if (!selectedUser || !$termsCheckbox.is(':checked')) return;
          clearModalError();
          const restoreLabel = modalMode === 'relink' ? 'Update Link' : 'Link Account';
          $linkSubmitBtn.prop('disabled', true);
          $linkSubmitLabel.html('<i class="fas fa-spinner fa-spin" style="margin-right:6px;"></i>' + (modalMode === 'relink' ? 'Updating' : 'Linking'));
          try {
            const res = await fetch(API_BASE + '/api/v1/admin/admins/' + adminId + '/link-lpc', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                lpcUserId: selectedUser.id,
                termsAccepted: true,
                termsVersion: TERMS_VERSION,
                currentUser: adminData
              })
            });
            const data = await res.json();
            if (!res.ok || !data.success) {
              const msg = (data && (data.error || data.message)) || 'Failed to link account.';
              showModalError(msg);
              return;
            }
            $linkModal.modal('hide');
            currentLinked = data.linked || null;
            if (currentLinked) renderLinked(currentLinked);
            else await loadLinkedState();
            if (typeof showAlert === 'function') {
              showAlert(modalMode === 'relink' ? 'LPC account relinked.' : 'LPC account linked successfully.', 'success');
            }
          } catch (err) {
            console.error('link error', err);
            showModalError('Network error. Please try again.');
          } finally {
            $linkSubmitLabel.text(restoreLabel);
            setSubmitEnabled();
          }
        }

        function openUnlinkModal() {
          if (!currentLinked) return;
          const display = currentLinked.username || currentLinked.email || 'this account';
          $unlinkPrompt.html(
            'Disconnect <strong>' + escapeHtml(display) + '</strong>? Elevated access on LPC linked features will be removed. You can link another account later.'
          );
          $unlinkModal.modal('show');
        }

        async function submitUnlink() {
          const original = $unlinkConfirmBtn.html();
          $unlinkConfirmBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>Disconnecting');
          try {
            const res = await fetch(API_BASE + '/api/v1/admin/admins/' + adminId + '/unlink-lpc', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ currentUser: adminData })
            });
            const data = await res.json();
            if (!res.ok || !data.success) {
              const msg = (data && (data.error || data.message)) || 'Failed to disconnect.';
              if (typeof showAlert === 'function') showAlert(msg, 'error');
              return;
            }
            $unlinkModal.modal('hide');
            currentLinked = null;
            renderNotLinked();
            if (typeof showAlert === 'function') showAlert('LPC account disconnected.', 'success');
          } catch (err) {
            console.error('unlink error', err);
            if (typeof showAlert === 'function') showAlert('Network error. Please try again.', 'error');
          } finally {
            $unlinkConfirmBtn.prop('disabled', false).html(original);
          }
        }

        $searchInput.on('input', handleSearchInput);
        $termsCheckbox.on('change', setSubmitEnabled);
        $linkSubmitBtn.on('click', submitLink);
        $unlinkConfirmBtn.on('click', submitUnlink);

        $linkModal.on('hidden.bs.modal', function () {
          selectedUser = null;
          activeSearchToken++;
          if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
          $searchInput.val('');
          $searchResults.removeClass('is-active').empty();
          $searchSpinner.removeClass('is-active');
          $termsCheckbox.prop('checked', false);
          $selectedSummary.attr('hidden', true);
          $selectedCard.empty();
          clearModalError();
          setSubmitEnabled();
        });

        loadLinkedState();
      })();

      $('#profileForm').on('submit', async function(e) {
        e.preventDefault();

        const firstName = $('#firstName').val().trim();
        const lastName = $('#lastName').val().trim();
        const email = $('#email').val().trim();
        const profilePicture = $('#profilePicture').val();

        if (!firstName || !lastName) {
          showAlert('First name and last name are required', 'error');
          return;
        }

        if (!adminId) {
          showAlert('Error: Admin ID not found. Please log out and log back in.', 'error');
          return;
        }

        if (!API_BASE) {
          showAlert('Error: API URL not configured.', 'error');
          return;
        }

        // Show saving state
        const $btn = $('#profileForm button[type="submit"]');
        const originalText = $btn.html();
        $btn.html('<i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i>Saving...').prop('disabled', true);

        try {
          const response = await fetch(`${API_BASE}/api/v1/admin/admins/${adminId}/profile`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              firstName,
              lastName,
              email,
              profilePicture,
              currentUser: adminData
            })
          });

          const data = await response.json();

          if (data.success) {
            showAlert('Profile updated successfully!', 'success');

            // Update session by posting to server
            await fetch('/admin/profile/update-session', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                firstName,
                lastName,
                email,
                profilePicture
              })
            });

            // If this was setup, redirect to console after a delay
            <% if (typeof setup !== 'undefined' && setup) { %>
              setTimeout(() => {
                window.location.href = '/admin/console';
              }, 1500);
            <% } %>
          } else {
            showAlert(data.error || 'Failed to update profile', 'error');
          }
        } catch (error) {
          console.error('Profile update failed:', error);
          showAlert('Failed to update profile. Please try again.', 'error');
        } finally {
          $btn.html(originalText).prop('disabled', false);
        }
      });
      }); // End $(document).ready()
    </script>

    <!-- Link / Relink LPC Account modal -->
    <div class="modal fade lpc-modal" id="linkLpcModal" tabindex="-1" role="dialog" aria-labelledby="linkLpcModalTitle" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
            <h4 class="modal-title" id="linkLpcModalTitle">
              <i class="fas fa-link modal-title-icon"></i>
              <span class="lpc-modal-title-text">Link LPC Account</span>
            </h4>
            <p class="modal-subtitle">Connect an LPC user to your admin account for elevated access on linked features.</p>
          </div>
          <div class="modal-body">
            <div class="lpc-modal-error" id="lpcLinkError" role="alert">
              <i class="fas fa-exclamation-triangle"></i>
              <span></span>
            </div>

            <div class="lpc-step">
              <div class="lpc-label">
                <span class="lpc-step-num">1</span>
                Search for an LPC user
              </div>
              <div class="lpc-search-wrap">
                <i class="fas fa-search lpc-search-icon"></i>
                <input type="text" id="lpcUserSearch" class="form-input lpc-search-input"
                       placeholder="Email or username" autocomplete="off" spellcheck="false" />
                <span class="lpc-search-spinner" aria-hidden="true">
                  <i class="fas fa-circle-notch fa-spin"></i>
                </span>
              </div>
              <div class="lpc-results" id="lpcSearchResults" role="listbox" aria-label="Search results"></div>
            </div>

            <div class="lpc-step lpc-selected-summary" id="lpcSelectedSummary" hidden>
              <div class="lpc-label">
                <span class="lpc-step-num">2</span>
                Account to link
              </div>
              <div class="lpc-selected-card" id="lpcSelectedCard"></div>
            </div>

            <div class="lpc-step">
              <div class="lpc-label">
                <span class="lpc-step-num">3</span>
                Review and accept the linking terms
              </div>
              <div class="lpc-disclaimer">
                <div class="lpc-disclaimer-icon"><i class="fas fa-shield-alt"></i></div>
                <div class="lpc-disclaimer-body">
                  <p class="lpc-disclaimer-lede">By linking this LPC account you agree to:</p>
                  <ol class="lpc-disclaimer-list">
                    <li>Abide by the <a href="/terms-and-conditions#admin-console-and-linked-accounts" target="_blank" rel="noopener" class="lpc-terms-link">LPC Admin Terms of Service</a> when using elevated features.</li>
                    <li>Only your linked LPC account will receive elevated access on LPC &mdash; your admin account will be used solely for admin console login.</li>
                    <li>Linkspolice CAD may revoke elevated access at any time for misuse.</li>
                  </ol>
                  <label class="lpc-checkbox">
                    <input type="checkbox" id="lpcTermsCheckbox" />
                    <span class="lpc-checkbox-box"><i class="fas fa-check"></i></span>
                    <span class="lpc-checkbox-text">I have read and agree to the LPC Admin Linking Terms.</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn-gradient" id="lpcLinkSubmitBtn" disabled>
              <span class="lpc-submit-label">Link Account</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Disconnect Confirmation -->
    <div class="modal fade lpc-modal lpc-modal-sm" id="unlinkLpcModal" tabindex="-1" role="dialog" aria-labelledby="unlinkLpcModalTitle" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
            <h4 class="modal-title" id="unlinkLpcModalTitle">
              <i class="fas fa-unlink modal-title-icon" style="color:#fca5a5;"></i>
              Disconnect Linked LPC Account
            </h4>
          </div>
          <div class="modal-body">
            <p class="lpc-unlink-prompt" id="lpcUnlinkPrompt">
              Disconnect this account? Elevated access on LPC linked features will be removed. You can link another account later.
            </p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-secondary" data-dismiss="modal">Keep linked</button>
            <button type="button" class="btn-danger-outline" id="lpcUnlinkConfirmBtn">
              <i class="fas fa-unlink"></i>
              Disconnect
            </button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
