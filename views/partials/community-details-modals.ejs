      // Search functionality for fines
      function searchFines(searchTerm) {
        const searchLower = searchTerm.toLowerCase().trim();
        const clearBtn = document.getElementById('clearSearchBtn');
        
        // Show/hide clear button based on search content
        if (searchTerm !== '') {
          clearBtn.style.display = 'block';
        } else {
          clearBtn.style.display = 'none';
        }
        
        if (searchTerm === '') {
          // Show all categories if search is empty - restore from original + any new additions
          restoreFullCategoriesList();
          
          // Remove search results count
          const existingCount = document.querySelector('.search-results-count');
          if (existingCount) {
            existingCount.remove();
          }
          return;
        }
        
        // Get current categories from the DOM (includes unsaved changes)
        const currentCategories = getCurrentCategoriesFromDOM();
        
        // Filter categories and fines based on search term
        const filteredCategories = currentCategories.map(category => {
          // Check if category name matches
          const categoryMatches = category.name.toLowerCase().includes(searchLower);
          
          // Filter fines within this category
          const filteredFines = category.fines.filter(fine => {
            const fineNameMatches = fine.name.toLowerCase().includes(searchLower);
            const amountMatches = fine.amount.toString().includes(searchLower);
            return fineNameMatches || amountMatches;
          });
          
          // Return category if it matches or has matching fines
          if (categoryMatches || filteredFines.length > 0) {
            return {
              ...category,
              // If category name matches, show ALL fines in that category
              // If only fine matches, show only matching fines
              fines: categoryMatches ? category.fines : filteredFines
            };
          }
          return null;
        }).filter(Boolean); // Remove null categories
        
        // Render filtered results
        renderFineCategories(filteredCategories);
        
        // Show search results count
        const totalResults = filteredCategories.reduce((sum, cat) => sum + cat.fines.length, 0);
        if (searchTerm !== '') {
          showSearchResultsCount(totalResults, filteredCategories.length);
        }
      }

      // Restore full categories list (original + new additions)
      function restoreFullCategoriesList() {
        // Get the original categories from server
        const originalCategories = window.originalFineCategories || [];
        
        // Get any new categories that were added but not saved
        const newCategories = getNewCategoriesOnly();
        
        // Combine original and new categories
        const fullCategories = [...originalCategories, ...newCategories];
        
        // Render the full list
        renderFineCategories(fullCategories);
      }

      // Get only the new categories that weren't in the original data
      function getNewCategoriesOnly() {
        const newCategories = [];
        const categoryDivs = document.querySelectorAll('#fineCategoriesContainer .fine-category');
        
        categoryDivs.forEach(categoryDiv => {
          const categoryNameInput = categoryDiv.querySelector('.category-name');
          if (categoryNameInput) {
            const categoryName = categoryNameInput.value.trim();
            if (categoryName) {
              // Check if this category exists in original data
              const existsInOriginal = window.originalFineCategories?.some(cat => cat.name === categoryName);
              
              if (!existsInOriginal) {
                // This is a new category
                const fines = [];
                const fineItems = categoryDivs.querySelectorAll('.fine-item');
                
                fineItems.forEach(fineItem => {
                  const fineNameInput = fineItem.querySelector('.fine-name');
                  const fineAmountInput = fineItem.querySelector('.fine-amount');
                  
                  if (fineNameInput && fineAmountInput) {
                    const fineName = fineNameInput.value.trim();
                    const fineAmount = parseFloat(fineAmountInput.value);
                    
                    if (fineName && !isNaN(fineAmount)) {
                      fines.push({
                        name: fineName,
                        amount: fineAmount
                      });
                    }
                  }
                });
                
                newCategories.push({
                  name: categoryName,
                  fines: fines
                });
              }
            }
          }
        });
        
        return newCategories;
      }

      // Check if there are unsaved changes
      function hasUnsavedChanges() {
        if (!window.originalFineCategories) return false;
        
        // Get current state from DOM
        const currentCategories = getCurrentCategoriesFromDOM();
        
        // Check if number of categories changed
        if (currentCategories.length !== window.originalFineCategories.length) {
          return true;
        }
        
        // Check each category for changes
        for (let i = 0; i < currentCategories.length; i++) {
          const current = currentCategories[i];
          const original = window.originalFineCategories[i];
          
          // If category name changed
          if (original && current.name !== original.name) {
            return true;
          }
          
          // If number of fines changed
          if (original && current.fines.length !== original.fines.length) {
            return true;
          }
          
          // Check each fine for changes
          if (original) {
            for (let j = 0; j < current.fines.length; j++) {
              const currentFine = current.fines[j];
              const originalFine = original.fines[j];
              
              if (!originalFine || 
                  currentFine.name !== originalFine.name || 
                  currentFine.amount !== originalFine.amount) {
                return true;
              }
            }
          }
        }
        
        // Check if currency changed
        const currentCurrency = document.getElementById('fineCurrency').value;
        if (currentCurrency === 'custom') {
          const customCurrency = document.getElementById('customCurrency').value;
          if (customCurrency !== (window.originalCurrency || 'USD')) {
            return true;
          }
        } else if (currentCurrency !== (window.originalCurrency || 'USD')) {
          return true;
        }
        
        return false;
      }

