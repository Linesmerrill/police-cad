<div id="edmConfirmOverlay" class="edm-confirm-overlay" onclick="if(event.target===this) edmConfirmClose();">
  <div class="edm-confirm-card">
    <div id="edmConfirmIcon" class="edm-confirm-icon" style="background:rgba(239,68,68,0.1);">
      <i class="fa fa-trash" style="color:#ef4444;"></i>
    </div>
    <h3 id="edmConfirmTitle" class="edm-confirm-title">Remove Photo?</h3>
    <p id="edmConfirmText" class="edm-confirm-text">This action cannot be undone.</p>
    <div class="edm-confirm-actions">
      <button class="edm-confirm-btn edm-confirm-btn-cancel" onclick="edmConfirmClose();">Cancel</button>
      <button id="edmConfirmBtn" class="edm-confirm-btn edm-confirm-btn-danger" onclick="edmConfirmResolve();">
        <i class="fa fa-trash"></i> Remove
      </button>
    </div>
  </div>
</div>

<script>
var _edmConfirmCallback = null;

function edmConfirm(opts) {
  // opts: { icon, iconBg, iconColor, title, text, confirmLabel, confirmIcon }
  var overlay = document.getElementById('edmConfirmOverlay');
  var iconEl = document.getElementById('edmConfirmIcon');
  var titleEl = document.getElementById('edmConfirmTitle');
  var textEl = document.getElementById('edmConfirmText');
  var btnEl = document.getElementById('edmConfirmBtn');

  iconEl.style.background = opts.iconBg || 'rgba(239,68,68,0.1)';
  iconEl.innerHTML = '<i class="fa fa-' + (opts.icon || 'trash') + '" style="color:' + (opts.iconColor || '#ef4444') + ';"></i>';
  titleEl.textContent = opts.title || 'Are you sure?';
  textEl.innerHTML = opts.text || '';
  btnEl.innerHTML = '<i class="fa fa-' + (opts.confirmIcon || 'trash') + '"></i> ' + (opts.confirmLabel || 'Remove');

  return new Promise(function(resolve) {
    _edmConfirmCallback = resolve;
    // Force reflow for animation
    overlay.classList.remove('is-open');
    void overlay.offsetWidth;
    overlay.classList.add('is-open');
  });
}

function edmConfirmResolve() {
  if (_edmConfirmCallback) _edmConfirmCallback(true);
  _edmConfirmCallback = null;
  document.getElementById('edmConfirmOverlay').classList.remove('is-open');
}

function edmConfirmClose() {
  if (_edmConfirmCallback) _edmConfirmCallback(false);
  _edmConfirmCallback = null;
  document.getElementById('edmConfirmOverlay').classList.remove('is-open');
}
</script>

