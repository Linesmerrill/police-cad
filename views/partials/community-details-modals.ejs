      function renderFineCategories(categories) {
        const container = document.getElementById('fineCategoriesContainer');
        container.innerHTML = '';
        
        if (categories.length === 0) {
          container.innerHTML = '<div style="text-align:center; color:#a0aec0; padding:2rem;">No fine categories configured yet. Click "Add Category" to get started.</div>';
          return;
        }
        
        categories.forEach((category, categoryIndex) => {
          const categoryDiv = document.createElement('div');
          categoryDiv.className = 'fine-category';
          categoryDiv.dataset.categoryIndex = categoryIndex;
          categoryDiv.style.cssText = 'margin-bottom:1.5rem; padding:1.5rem; background:#2d3748; border-radius:12px; border:1px solid #4a5568;';
          categoryDiv.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
              <input type="text" class="category-name" value="${category.name}" placeholder="Category Name" 
                     style="background:#1e2028; color:#fff; border:1px solid #4a5568; border-radius:6px; padding:0.5rem; font-size:1rem; flex:1; margin-right:1rem;">
              <button onclick="removeFineCategory(this)" style="background:#ef4444; color:#fff; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:pointer;">
                <i class="fa fa-trash"></i>
              </button>
            </div>
            <div class="fines-container" style="margin-bottom:1rem;">
              ${renderFines(category.fines || [], categoryIndex)}
            </div>
            <button onclick="addFine(this)" style="background:#3b82f6; color:#fff; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:pointer; font-size:0.875rem;">
              <i class="fa fa-plus" style="margin-right:0.5rem;"></i>
              Add Fine
            </button>
          `;
          container.appendChild(categoryDiv);
        });
      }

      function renderFines(fines, categoryIndex) {
        if (fines.length === 0) {
          return '<div class="no-fines-message" style="text-align:center; color:#a0aec0; padding:1rem;">No fines configured for this category.</div>';
        }

        return fines.map((fine, fineIndex) => `
          <div class="fine-item" style="display:flex; gap:0.5rem; margin-bottom:0.5rem; align-items:center;">
            <input type="text" class="fine-name" value="${fine.name}" placeholder="Fine Name"
                   style="background:#1e2028; color:#fff; border:1px solid #4a5568; border-radius:6px; padding:0.5rem; font-size:0.875rem; flex:1; min-width:0;">
            <input type="number" class="fine-amount" value="${fine.amount}" placeholder="Amount" min="0" step="0.01"
                   style="background:#1e2028; color:#fff; border:1px solid #4a5568; border-radius:6px; padding:0.5rem; font-size:0.875rem; width:80px; flex-shrink:0;">
            <button onclick="removeFine(this)" style="background:#ef4444; color:#fff; border:none; border-radius:6px; padding:0.5rem; cursor:pointer; font-size:0.875rem; flex-shrink:0; width:36px; height:36px; display:flex; align-items:center; justify-content:center;">
              <i class="fa fa-times"></i>
            </button>
          </div>
        `).join('');
      }

      function addFineCategory() {
