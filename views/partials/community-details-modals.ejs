      function saveGeneralSettings() {
        const enableLimits = document.getElementById('enableCivilianLimits').checked;
        const maxCivilians = enableLimits ? parseInt(document.getElementById('maxCiviliansPerDept').value) : 5;
        const enableApproval = document.getElementById('enableCivilianApproval').checked;

        // Get vehicle limits
        const enableVehicleLimits = document.getElementById('enableVehicleLimits').checked;
        const maxVehicles = enableVehicleLimits ? parseInt(document.getElementById('maxVehiclesPerDept').value) : 5;
        
        // Get firearm limits
        const enableFirearmLimits = document.getElementById('enableFirearmLimits').checked;
        const maxFirearms = enableFirearmLimits ? parseInt(document.getElementById('maxFirearmsPerDept').value) : 5;
        
        // Validate civilian limits if enabled
        if (enableLimits) {
          if (isNaN(maxCivilians) || maxCivilians < 1 || maxCivilians > 100) {
            // Show error and prevent saving
            validateMaxCiviliansInput(document.getElementById('maxCiviliansPerDept'));
            showSettingsError('Please fix the validation errors before saving.');
            return;
          }
        }
        
        // Validate vehicle limits if enabled
        if (enableVehicleLimits) {
          if (isNaN(maxVehicles) || maxVehicles < 1 || maxVehicles > 100) {
            // Show error and prevent saving
            validateMaxVehiclesInput(document.getElementById('maxVehiclesPerDept'));
            showSettingsError('Please fix the validation errors before saving.');
            return;
          }
        }
        
        // Validate firearm limits if enabled
        if (enableFirearmLimits) {
          if (isNaN(maxFirearms) || maxFirearms < 1 || maxFirearms > 100) {
            // Show error and prevent saving
            validateMaxFirearmsInput(document.getElementById('maxFirearmsPerDept'));
            showSettingsError('Please fix the validation errors before saving.');
            return;
          }
        }
        
        // Get warrant approval mode
        const warrantApprovalModeEl = document.querySelector('input[name="warrantApprovalMode"]:checked');
        const warrantApprovalMode = warrantApprovalModeEl ? warrantApprovalModeEl.value : 'auto-approve';
        const warrantRandomApprovalRate = parseInt(document.getElementById('warrantRandomApprovalRate').value) || 70;

        // Use the actual field names that match the backend community model
        const updateData = {
          civilianCreationLimitsEnabled: enableLimits,
          civilianCreationLimit: maxCivilians,
          civilianApprovalSystemEnabled: enableApproval,
          vehicleCreationLimitsEnabled: enableVehicleLimits,
          vehicleCreationLimit: maxVehicles,
          firearmCreationLimitsEnabled: enableFirearmLimits,
          firearmCreationLimit: maxFirearms,
          warrantApprovalMode: warrantApprovalMode,
          warrantRandomApprovalRate: warrantRandomApprovalRate
        };

        // Save to server - use the same route as saveCommunityProfile
        const communityId = '<%= community._id %>';
        const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

        fetch(`${apiUrl}/api/v1/community/${communityId}?userId=${window.dbUser?._id || ''}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updateData)
        })
        .then(res => {
          if (res.ok) {
            showSettingsSuccess('General settings saved successfully!');
            closeGeneralSettingsModal();
          } else {
            throw new Error('Failed to save general settings');
          }
        })
        .catch(error => {
          console.error('Error saving general settings:', error);
          showSettingsError('Failed to save general settings. Please try again.');
        });
      }

