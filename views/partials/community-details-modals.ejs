<script>
function saveEditDepartment() {
  console.log('saveEditDepartment called');
  const deptId = currentEditDepartment;
  const communityId = '<%= community._id %>';
  const name = document.getElementById('editDeptName').value.trim();
  const description = document.getElementById('editDeptDescription').value.trim();
  const imageUrl = document.getElementById('editDeptImageUrl').value;
  const saveBtn = document.querySelector('#editDepartmentModal button[type="submit"]');
  
  console.log('Department data:', { deptId, communityId, name, description, imageUrl });
  
  if (!name) {
    if (typeof showToast === 'function') {
      showToast('Department name is required', 2500);
    } else {
      alert('Department name is required');
    }
    saveBtn.disabled = false;
    saveBtn.textContent = 'Save';
    return;
  }
  
  saveBtn.disabled = true;
  saveBtn.textContent = 'Saving...';

  // Fetch the current department data to preserve all existing structure
  console.log('Fetching department data from API...');
  
  fetch(`${API_URL}/api/v1/community/${communityId}/departments/${deptId}`)
    .then(res => {
      if (!res.ok) throw new Error('Failed to fetch department data');
      return res.json();
    })
    .then(response => {
      console.log('API response:', response);
      const currentDept = response.department || response; // Handle both wrapped and unwrapped responses
      console.log('currentDept extracted:', currentDept);
      updateDepartment(currentDept);
    })
    .catch(err => {
      console.error('Error fetching department:', err);
      if (typeof showToast === 'function') {
        showToast('Failed to fetch department data', 3000, 'error');
      } else {
        alert('Failed to fetch department data');
      }
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save';
    });
  
  function updateDepartment(currentDept) {
    // Create the department object with only the fields we want to update
    const payload = {
      name, // Update name
      description, // Update description
      approvalRequired: document.getElementById('editDeptApprovalRequired').checked, // Update approval required
      image: imageUrl || currentDept.image // Update image (keep existing if no new one)
    };
    
    // Update the template components if template exists
    if (currentDept.template && currentDept.template.components) {
      // Prepare components for the new API endpoint
      const componentsToUpdate = currentDept.template.components.map(component => {
        const componentName = component.name;
        let isEnabled = component.enabled; // Default to current value
        
        // Override with form values for the components we're managing
        if (componentName === 'createCivilians') {
          isEnabled = document.getElementById('editDeptComponentCreateCivilians').checked;
        } else if (componentName === 'createVehicles') {
          isEnabled = document.getElementById('editDeptComponentCreateVehicles').checked;
        } else if (componentName === 'createFirearms') {
          isEnabled = document.getElementById('editDeptComponentCreateFirearms').checked;
        } else if (componentName === 'call911') {
          isEnabled = document.getElementById('editDeptComponentCall911').checked;
        }
        
        return {
          _id: {
            $oid: component._id
          },
          name: component.name,
          enabled: isEnabled
        };
      });
      
      // Update components using the new API endpoint
      updateDepartmentComponents(componentsToUpdate);
      return; // Exit early since we're handling components separately
    }
    
    doUpdate();
    
    function updateDepartmentComponents(componentsToUpdate) {
      console.log('Updating department components:', componentsToUpdate);
      
      fetch(`${API_URL}/api/v1/community/${communityId}/departments/${deptId}/components`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ components: componentsToUpdate })
      })
        .then(res => {
          if (!res.ok) throw new Error('Failed to update department components');
          return res.json();
        })
        .then(() => {
          console.log('Components updated successfully');
          // Now update the main department data
          doUpdate();
        })
        .catch(err => {
          console.error('Error updating components:', err);
          if (typeof showToast === 'function') {
            showToast('Failed to update department components', 3000, 'error');
          } else {
            alert('Failed to update department components');
          }
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save';
        });
    }

    function doUpdate() {
      console.log('doUpdate called with payload:', payload);
      console.log('API URL:', `${API_URL}/api/v1/community/${communityId}/departments/${deptId}`);
      
      fetch(`${API_URL}/api/v1/community/${communityId}/departments/${deptId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(res => {
          if (!res.ok) throw new Error('Failed to update department');
          return res.json();
        })
        .then(() => {
          closeEditDepartmentModal();
          if (typeof showToast === 'function') {
            showToast('Department updated successfully', 2500);
          } else {
            alert('Department updated successfully');
          }
          // Set flag to refresh component permissions when user returns to civilian dashboard
          sessionStorage.setItem('refreshComponentPermissions', 'true');
          setTimeout(() => window.location.reload(), 1200);
        })
        .catch(err => {
          alert(err.message || 'Failed to update department');
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save';
        });
    }
  }
}
function deleteEditDepartment() {
  const deptId = currentEditDepartment;
  const communityId = '<%= community._id %>';
  if (confirm('Are you sure you want to delete this department? This action is irreversible.')) {
    const deleteBtn = document.querySelector('#editDepartmentModal button.bg-red-600');
    deleteBtn.disabled = true;
    deleteBtn.textContent = 'Deleting...';
    fetch(`${API_URL}/api/v1/community/${communityId}/departments/${deptId}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    })
      .then(res => {
        if (!res.ok) throw new Error('Failed to delete department');
        return res.json();
      })
      .then(() => {
        closeEditDepartmentModal();
        window.location.reload();
      })
      .catch(err => {
        alert(err.message || 'Failed to delete department');
        deleteBtn.disabled = false;
        deleteBtn.textContent = 'Delete';
      });
  }
}
</script> 

