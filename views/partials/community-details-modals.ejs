function copyCommunityUrl() {
  const url = window.location.href;
  const icon = document.getElementById('shareBtnIcon');
  const text = document.getElementById('shareBtnText');

  function showCopiedFeedback() {
    // Change icon to check mark
    if (icon) {
      icon.className = 'fa fa-check';
    }
    if (text) {
      text.textContent = 'Copied!';
    }
    showToast('Link copied!', 2000);

    // Revert back to share icon after 2 seconds
    setTimeout(function() {
      if (icon) {
        icon.className = 'fa fa-share-nodes';
      }
      if (text) {
        text.textContent = 'Share';
      }
    }, 2000);
  }

  if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(function() {
      showCopiedFeedback();
    }, function() {
      showToast('Failed to copy link', 2000);
    });
  } else {
    // fallback for older browsers
    const tempInput = document.createElement('input');
    tempInput.value = url;
    document.body.appendChild(tempInput);
    tempInput.select();
    try {
      document.execCommand('copy');
      showCopiedFeedback();
    } catch (err) {
      showToast('Failed to copy link', 2000);
    }
    document.body.removeChild(tempInput);
  }
}

