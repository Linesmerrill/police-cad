    <!-- Main Penal Codes Modal -->
    <div id="penalCodesModal" class="pcm-overlay">
      <div class="pcm-container">
        <!-- Header -->
        <div class="pcm-header">
          <div class="pcm-header-left">
            <div class="pcm-header-icon"><i class="fa fa-scale-balanced"></i></div>
            <div>
              <h3>Penal Codes</h3>
              <p>Manage community violations &amp; penalties</p>
            </div>
          </div>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <a href="/help#settings-penal-import" target="_blank" class="pcm-close" title="Help" style="text-decoration:none; color:#64748b;"><i class="fa fa-circle-question"></i></a>
            <button class="pcm-close" onclick="attemptClosePenalCodesModal()"><i class="fa fa-times"></i></button>
          </div>
        </div>

        <!-- Toolbar: search + currency + add -->
        <div class="pcm-toolbar">
          <div class="pcm-search-wrap">
            <i class="fa fa-search"></i>
            <input type="text" class="pcm-search" id="pcSettingsSearch" placeholder="Search violations..." oninput="searchPenalCodes(this.value)">
          </div>
          <button class="pcm-currency-btn" onclick="openPcCurrencyPicker()" title="Currency">
            <span class="pcm-sym" id="pcmCurrencySym">$</span>
            <span id="pcmCurrencyCode">USD</span>
            <i class="fa fa-chevron-down"></i>
          </button>
          <button class="pcm-add-cat-btn" onclick="addPcCategory()">
            <i class="fa fa-plus"></i> Category
          </button>
          <button class="pcm-add-cat-btn" onclick="showPcExportMenu()" title="Export penal codes" style="background:rgba(16,185,129,0.15); color:#10b981; border-color:rgba(16,185,129,0.25);">
            <i class="fa fa-download"></i> Export
          </button>
          <button class="pcm-add-cat-btn" onclick="document.getElementById('pcImportFileInput').click()" title="Import penal codes" style="background:rgba(59,130,246,0.15); color:#3b82f6; border-color:rgba(59,130,246,0.25);">
            <i class="fa fa-upload"></i> Import
          </button>
          <button class="pcm-add-cat-btn" onclick="resetToDefaultPenalCodes()" title="Reset penal codes to defaults" style="background:rgba(245,158,11,0.15); color:#f59e0b; border-color:rgba(245,158,11,0.25);">
            <i class="fa fa-undo"></i> Reset
          </button>
          <input type="file" id="pcImportFileInput" accept=".json,.csv" style="display:none;" onchange="importPenalCodesFile(this)">
