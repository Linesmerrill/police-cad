<script>
// ===== Auto-Save System =====
var _edmAutoSaveTimer = null;
var _edmSaveStatusTimer = null;
var _edmIsSaving = false;

function setEditDeptSaveStatus(state, message) {
  var el = document.getElementById('editDeptSaveStatus');
  if (!el) return;
  el.className = 'edm-save-status';
  clearTimeout(_edmSaveStatusTimer);

  if (state === 'saving') {
    el.className = 'edm-save-status is-saving';
    el.innerHTML = '<div class="edm-save-spinner"></div><span>Saving\u2026</span>';
  } else if (state === 'saved') {
    el.className = 'edm-save-status is-saved';
    el.innerHTML = '<div class="edm-save-check"><i class="fa fa-check"></i></div><span>Saved</span>';
    _edmSaveStatusTimer = setTimeout(function() {
      el.innerHTML = '';
      el.className = 'edm-save-status';
    }, 2500);
  } else if (state === 'error') {
    el.className = 'edm-save-status is-error';
    el.innerHTML = '<span class="edm-save-error"><i class="fa fa-exclamation-circle"></i></span><span>' + (message || 'Save failed') + '</span>';
    _edmSaveStatusTimer = setTimeout(function() {
      el.innerHTML = '';
      el.className = 'edm-save-status';
    }, 4000);
  } else {
    el.innerHTML = '';
  }
}

function triggerEditDeptAutoSave(delay) {
  clearTimeout(_edmAutoSaveTimer);
  _edmAutoSaveTimer = setTimeout(function() {
    saveEditDepartment();
  }, delay || 800);
}

// Immediate save (for toggles)
function triggerEditDeptAutoSaveImmediate() {
  triggerEditDeptAutoSave(300);
}

// Debounced save (for text inputs)
function triggerEditDeptAutoSaveDebounced() {
  triggerEditDeptAutoSave(1000);
}

async function saveEditDepartment() {
  if (_edmIsSaving) return;
  var deptId = currentEditDepartment;
  var communityId = '<%= community._id %>';
  var name = document.getElementById('editDeptName').value.trim();
  var description = document.getElementById('editDeptDescription').value.trim();
  var imageUrl = document.getElementById('editDeptImageUrl').value;

  if (!name) {
    setEditDeptSaveStatus('error', 'Name is required');
    return;
  }

  _edmIsSaving = true;
  setEditDeptSaveStatus('saving');

  try {
    // Fetch the current department data to preserve all existing structure
    var fetchRes = await fetch(API_URL + '/api/v1/community/' + communityId + '/departments/' + deptId);
    if (!fetchRes.ok) throw new Error('Failed to fetch department data');

    var response = await fetchRes.json();
    var currentDept = response.department || response;

    // Determine image value: __DELETE__ means explicitly remove, empty means keep existing
    var finalImage;
    if (imageUrl === '__DELETE__') {
      finalImage = ''; // Explicitly delete the image
    } else if (imageUrl) {
      finalImage = imageUrl; // Use new uploaded image
    } else {
      finalImage = currentDept.image; // Keep existing image
    }

    // Create the department object with only the fields we want to update
    var toneSound = document.getElementById('editDeptToneSound') ? document.getElementById('editDeptToneSound').value : '';
    var restrictCb = document.getElementById('editDeptRestrictRecordDeletion');
    var recordsSectionEl = document.getElementById('editDeptRecordsSection');
    var recordsSectionVisible = recordsSectionEl && recordsSectionEl.style.display !== 'none';
    var payload = {
      name: name,
      description: description,
      approvalRequired: document.getElementById('editDeptApprovalRequired').checked,
      image: finalImage,
      toneSound: toneSound
    };
    // Only persist the records-lock flag on civilian-template depts (where the
    // section is rendered). Non-civilian depts never consult this flag, so
    // writing it would just be noise on the document.
    if (recordsSectionVisible && restrictCb) {
      payload.restrictCivilianRecordDeletion = restrictCb.checked;
    }

    // Update the template components - include in the same PATCH request
    if (currentDept.template) {
      // Read toggle states from the dynamically rendered checkboxes (includes merged components)
      var toggleStates = {};
      document.querySelectorAll('.edit-dept-component-toggle').forEach(function(cb) {
        toggleStates[cb.getAttribute('data-component-name')] = cb.checked;
      });

      // Start with existing components from the API
      var existingComponents = currentDept.template.components || [];
      var existingNames = {};
      var updatedComponents = existingComponents.map(function(component) {
        var componentName = component.name;
        existingNames[componentName] = true;
        var isEnabled = toggleStates.hasOwnProperty(componentName) ? toggleStates[componentName] : component.enabled;

        // Extract component ID - handle both string and {$oid: ...} formats
        var componentId = component._id;
        if (typeof componentId === 'object' && componentId !== null) {
          componentId = componentId.$oid || String(componentId);
        }

        return {
          _id: componentId,
          name: component.name,
          enabled: isEnabled
        };
      });

      // Add any new components from toggles that weren't in the original list
      Object.keys(toggleStates).forEach(function(toggleName) {
        if (!existingNames[toggleName]) {
          updatedComponents.push({
            name: toggleName,
            enabled: toggleStates[toggleName]
          });
        }
      });

      // Extract template ID - handle both string and {$oid: ...} formats
      var templateId = currentDept.template._id;
      if (typeof templateId === 'object' && templateId !== null) {
        templateId = templateId.$oid || String(templateId);
      }

      // Include updated template in the payload with clean structure
      payload.template = {
        _id: templateId,
        name: currentDept.template.name,
        description: currentDept.template.description || '',
        components: updatedComponents
      };
    }

    var updateRes = await fetch(API_URL + '/api/v1/community/' + communityId + '/departments/' + deptId + '?userId=' + (window.dbUser && window.dbUser._id || ''), {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    if (!updateRes.ok) {
      var errorText = await updateRes.text();
      console.error('Update failed with response:', errorText);
      throw new Error('Failed to update department');
    }

    await updateRes.json();
    setEditDeptSaveStatus('saved');
    // Set flag to refresh component permissions when user returns to civilian dashboard
    sessionStorage.setItem('refreshComponentPermissions', 'true');
    refreshDepartmentsGrid();

  } catch (err) {
    console.error('Error in saveEditDepartment:', err);
    setEditDeptSaveStatus('error', err.message || 'Save failed');
  } finally {
    _edmIsSaving = false;
  }
}
function deleteEditDepartment() {
  // Get the department name to show in the confirmation modal
  const deptName = document.getElementById('editDeptName').value || 'this department';
  document.getElementById('deleteDeptName').textContent = deptName;

  // Reset the delete button state (in case it was left in "Deleting..." state from previous delete)
  const deleteBtn = document.getElementById('confirmDeleteDeptBtn');
  deleteBtn.disabled = false;
  deleteBtn.innerHTML = '<i class="fa fa-trash"></i> Delete Department';

  // Show the custom delete confirmation modal
  document.getElementById('deleteDepartmentModal').style.display = 'flex';
}

function closeDeleteDepartmentModal() {
  document.getElementById('deleteDepartmentModal').style.display = 'none';
}

async function confirmDeleteDepartment() {
  const deptId = currentEditDepartment;
  const communityId = '<%= community._id %>';
  const deleteBtn = document.getElementById('confirmDeleteDeptBtn');

  deleteBtn.disabled = true;
  deleteBtn.innerHTML = '<i class="fa fa-spinner fa-spin mr-2"></i>Deleting...';

  try {
    const response = await fetch(`${API_URL}/api/v1/community/${communityId}/departments/${deptId}?userId=${window.dbUser?._id || ''}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    });

    if (!response.ok) throw new Error('Failed to delete department');

    closeDeleteDepartmentModal();
    closeEditDepartmentModal();
    showToast('Department deleted successfully', 2500);
    refreshDepartmentsGrid();
  } catch (err) {
    showToast(err.message || 'Failed to delete department', 3000, 'error');
    deleteBtn.disabled = false;
    deleteBtn.innerHTML = '<i class="fa fa-trash mr-2"></i>Delete Department';
  }
}
</script>

<script>
function updateEditDeptVisibilityLabel() {
  var checked = document.getElementById('editDeptApprovalRequired').checked;
  document.getElementById('editDeptVisibilityPublic').style.color = !checked ? '#60a5fa' : '#64748b';
  document.getElementById('editDeptVisibilityPrivate').style.color = checked ? '#60a5fa' : '#64748b';

  // Toggle members section based on public/private
  var isPublic = !checked;
  var memberBody = document.getElementById('editDeptMemberSectionBody');
  var publicNotice = document.getElementById('editDeptMemberPublicNotice');
  var addBtn = document.getElementById('editDeptAddMemberToggle');
  if (memberBody && publicNotice) {
    memberBody.style.display = isPublic ? 'none' : '';
    publicNotice.style.display = isPublic ? 'block' : 'none';
  }
  if (addBtn) {
    addBtn.style.display = isPublic ? 'none' : '';
  }
  var memberCount = document.getElementById('editDeptMemberCount');
  if (memberCount) {
    memberCount.style.display = isPublic ? 'none' : '';
  }
}

// ===== Department Members Management =====
var editDeptMembersPage = 1;
var editDeptMembersLimit = 10;
var editDeptMembersData = [];
var editDeptMembersTotalCount = 0;

function loadEditDeptMembers(departmentId, page) {
  if (!departmentId) return;
  page = page || 1;
  editDeptMembersPage = page;
  var communityId = '<%= community._id %>';
  var listEl = document.getElementById('editDeptMemberList');
  listEl.innerHTML = '<div class="edm-members-loading"><i class="fa fa-spinner fa-spin"></i> Loading...</div>';

  fetch(API_URL + '/api/v1/community/' + communityId + '/departments/' + departmentId + '/members?page=' + page + '&limit=' + editDeptMembersLimit)
    .then(function(res) { return res.json(); })
    .then(function(data) {
      // Normalize: API nests user data under .user
      editDeptMembersData = (data.data || []).map(function(m) {
        var u = m.user || {};
        return {
          userID: u.userID || m._id || '',
          username: u.username || '',
          profilePicture: u.profilePicture || '',
          rankId: m.rankId || ''
        };
      });
      editDeptMembersTotalCount = data.totalCount || 0;
      var countBadge = document.getElementById('editDeptMemberCount');
      if (countBadge) countBadge.textContent = editDeptMembersTotalCount + ' member' + (editDeptMembersTotalCount !== 1 ? 's' : '');
      renderEditDeptMembers();
      renderEditDeptMemberPagination();
    })
    .catch(function(err) {
      console.error('Failed to load department members:', err);
      listEl.innerHTML = '<div class="edm-members-empty">Failed to load members</div>';
    });
}

function renderEditDeptMembers(filter) {
  var listEl = document.getElementById('editDeptMemberList');
  var members = editDeptMembersData;
  if (filter) {
    var q = filter.toLowerCase();
    members = members.filter(function(m) {
      return (m.username || '').toLowerCase().indexOf(q) !== -1;
    });
  }
  if (members.length === 0) {
    listEl.innerHTML = '<div class="edm-members-empty">' + (filter ? 'No matching members' : 'No members yet') + '</div>';
    return;
  }
  listEl.innerHTML = members.map(function(m) {
    var avatar = m.profilePicture
      ? '<img src="' + m.profilePicture + '" alt="">'
      : '<i class="fa fa-user"></i>';
    var userId = m.userID || '';
    var isCurrentUser = window.dbUser && (window.dbUser._id === userId);
    var removeBtn = isCurrentUser ? '' :
      '<button type="button" class="edm-member-remove" onclick="removeEditDeptMember(\'' + userId + '\', \'' + (m.username || '').replace(/'/g, "\\'") + '\')" title="Remove member"><i class="fa fa-times"></i></button>';
    return '<div class="edm-member-row" data-username="' + (m.username || '').toLowerCase() + '">'
      + '<div class="edm-member-info">'
      + '<div class="edm-member-avatar">' + avatar + '</div>'
      + '<span class="edm-member-name">' + (m.username || 'Unknown') + '</span>'
      + '</div>'
      + '<div class="edm-member-actions">' + removeBtn + '</div>'
      + '</div>';
  }).join('');
}

function filterEditDeptMembers() {
  var q = document.getElementById('editDeptMemberSearch').value.trim();
  renderEditDeptMembers(q || null);
}

function renderEditDeptMemberPagination() {
  var paginationEl = document.getElementById('editDeptMemberPagination');
  var totalPages = Math.ceil(editDeptMembersTotalCount / editDeptMembersLimit);
  if (totalPages <= 1) {
    paginationEl.style.display = 'none';
    return;
  }
  paginationEl.style.display = 'flex';
  document.getElementById('editDeptMemberPageInfo').textContent = 'Page ' + editDeptMembersPage + ' of ' + totalPages;
  document.getElementById('editDeptMemberPrev').disabled = editDeptMembersPage <= 1;
  document.getElementById('editDeptMemberNext').disabled = editDeptMembersPage >= totalPages;
}

async function removeEditDeptMember(userId, username) {
  var confirmed = await edmConfirm({
    icon: 'user-times', iconBg: 'rgba(245,158,11,0.1)', iconColor: '#f59e0b',
    title: 'Remove Member?',
    text: 'Remove <strong style="color:#f1f5f9;">' + username + '</strong> from this department?',
    confirmLabel: 'Remove', confirmIcon: 'user-times'
  });
  if (!confirmed) return;
  var communityId = '<%= community._id %>';
  var departmentId = currentEditDepartment;
  fetch(API_URL + '/api/v1/community/' + communityId + '/departments/' + departmentId + '/remove-user', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ userId: userId })
  })
  .then(function(res) {
    if (!res.ok) throw new Error('Failed to remove member');
    return res.json();
  })
  .then(function() {
    if (typeof showToast === 'function') showToast('Member removed', 2000);
    loadEditDeptMembers(departmentId, editDeptMembersPage);
  })
  .catch(function(err) {
    console.error('Remove member error:', err);
    if (typeof showToast === 'function') showToast('Failed to remove member', 2500, 'error');
  });
}

// ===== Add Members Panel =====
var addMemberPage = 1;
var addMemberLimit = 10;
var addMemberTotalPages = 1;
var addMemberSearchTimer = null;
var addMemberCurrentData = [];

function toggleAddMemberPanel() {
  var panel = document.getElementById('editDeptAddMemberPanel');
  var btn = document.getElementById('editDeptAddMemberToggle');
  var isOpen = panel.classList.contains('is-open');
  if (isOpen) {
    panel.classList.remove('is-open');
    btn.innerHTML = '<i class="fa fa-plus"></i> <span>Add</span>';
    btn.style.borderColor = '';
    btn.style.color = '';
    btn.style.background = '';
    return;
  }
  panel.classList.add('is-open');
  btn.innerHTML = '<i class="fa fa-times"></i> <span>Done</span>';
  btn.style.borderColor = 'rgba(239, 68, 68, 0.2)';
  btn.style.color = '#f87171';
  btn.style.background = 'rgba(239, 68, 68, 0.06)';
  document.getElementById('editDeptAddMemberSearch').value = '';
  loadAddMemberPage(1);
}

function loadAddMemberPage(page) {
  page = page || 1;
  addMemberPage = page;
  var communityId = '<%= community._id %>';
  var listEl = document.getElementById('editDeptAddMemberList');
  listEl.innerHTML = '<div class="edm-members-loading"><i class="fa fa-spinner fa-spin"></i> Loading...</div>';

  var query = (document.getElementById('editDeptAddMemberSearch').value || '').trim();
  var url;
  if (query.length > 0) {
    // Use search endpoint
    url = API_URL + '/api/v1/community/' + communityId + '/members/search?q=' + encodeURIComponent(query) + '&page=' + page + '&limit=' + addMemberLimit;
  } else {
    // Use v2 members endpoint for browsing
    url = API_URL + '/api/v2/community/' + communityId + '/members?page=' + page + '&limit=' + addMemberLimit;
  }

  fetch(url)
    .then(function(res) { return res.json(); })
    .then(function(data) {
      var members = (data.members || []).map(function(m) {
        return {
          userId: m.id,
          username: m.username || 'Unknown',
          profilePicture: m.profilePicture || ''
        };
      });

      // Filter out members already in the department
      var existingIds = {};
      editDeptMembersData.forEach(function(m) { existingIds[m.userID] = true; });
      addMemberCurrentData = members.filter(function(m) { return !existingIds[m.userId]; });

      var pagination = data.pagination || {};
      addMemberTotalPages = pagination.totalPages || Math.ceil((pagination.totalCount || members.length) / addMemberLimit) || 1;

      renderAddMemberRows();
      renderAddMemberPagination();
    })
    .catch(function(err) {
      console.error('Failed to load community members:', err);
      listEl.innerHTML = '<div class="edm-members-empty">Failed to load members</div>';
    });
}

function renderAddMemberRows() {
  var listEl = document.getElementById('editDeptAddMemberList');
  if (addMemberCurrentData.length === 0) {
    var query = (document.getElementById('editDeptAddMemberSearch').value || '').trim();
    listEl.innerHTML = '<div class="edm-members-empty">' + (query ? 'No matching members' : 'No members to add on this page') + '</div>';
    return;
  }
  listEl.innerHTML = addMemberCurrentData.map(function(m) {
    var avatar = m.profilePicture
      ? '<img src="' + m.profilePicture + '" alt="" style="width:100%;height:100%;object-fit:cover;">'
      : '<i class="fa fa-user"></i>';
    return '<div class="edm-add-member-row">'
      + '<div class="edm-member-info">'
      + '<div class="edm-member-avatar">' + avatar + '</div>'
      + '<span class="edm-member-name">' + m.username + '</span>'
      + '</div>'
      + '<button type="button" class="edm-add-btn" onclick="addMemberToDept(\'' + m.userId + '\')" title="Add to department"><i class="fa fa-plus"></i></button>'
      + '</div>';
  }).join('');
}

function renderAddMemberPagination() {
  var paginationEl = document.getElementById('editDeptAddMemberPagination');
  if (addMemberTotalPages <= 1) {
    paginationEl.style.display = 'none';
    return;
  }
  paginationEl.style.display = 'flex';
  document.getElementById('editDeptAddMemberPageInfo').textContent = 'Page ' + addMemberPage + ' of ' + addMemberTotalPages;
  document.getElementById('editDeptAddMemberPrev').disabled = addMemberPage <= 1;
  document.getElementById('editDeptAddMemberNext').disabled = addMemberPage >= addMemberTotalPages;
}

function searchAddMemberList() {
  // Debounce search input
  clearTimeout(addMemberSearchTimer);
  addMemberSearchTimer = setTimeout(function() {
    loadAddMemberPage(1);
  }, 300);
}

function addMemberToDept(userId) {
  var communityId = '<%= community._id %>';
  var departmentId = currentEditDepartment;
  fetch(API_URL + '/api/v1/community/' + communityId + '/departments/' + departmentId + '/members', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ members: [userId] })
  })
  .then(function(res) {
    if (!res.ok) throw new Error('Failed to add member');
    return res.json();
  })
  .then(function() {
    if (typeof showToast === 'function') showToast('Member added', 2000);
    // Refresh department members list, then reload add-member page
    loadEditDeptMembers(departmentId, editDeptMembersPage);
    setTimeout(function() { loadAddMemberPage(addMemberPage); }, 500);
  })
  .catch(function(err) {
    console.error('Add member error:', err);
    if (typeof showToast === 'function') showToast('Failed to add member', 2500, 'error');
  });
}
</script>

