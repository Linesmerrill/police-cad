<script>
async function saveEditDepartment() {
  const deptId = currentEditDepartment;
  const communityId = '<%= community._id %>';
  const name = document.getElementById('editDeptName').value.trim();
  const description = document.getElementById('editDeptDescription').value.trim();
  const imageUrl = document.getElementById('editDeptImageUrl').value;
  const saveBtn = document.querySelector('#editDepartmentModal button[type="submit"]');

  if (!name) {
    if (typeof showToast === 'function') {
      showToast('Department name is required', 2500);
    } else {
      alert('Department name is required');
    }
    return;
  }

  saveBtn.disabled = true;
  saveBtn.textContent = 'Saving...';

  try {
    // Fetch the current department data to preserve all existing structure
    const fetchRes = await fetch(`${API_URL}/api/v1/community/${communityId}/departments/${deptId}`);
    if (!fetchRes.ok) throw new Error('Failed to fetch department data');

    const response = await fetchRes.json();
    const currentDept = response.department || response;

    // Determine image value: __DELETE__ means explicitly remove, empty means keep existing
    let finalImage;
    if (imageUrl === '__DELETE__') {
      finalImage = ''; // Explicitly delete the image
    } else if (imageUrl) {
      finalImage = imageUrl; // Use new uploaded image
    } else {
      finalImage = currentDept.image; // Keep existing image
    }

    // Create the department object with only the fields we want to update
    const payload = {
      name,
      description,
      approvalRequired: document.getElementById('editDeptApprovalRequired').checked,
      image: finalImage
    };

    // Update the template components - include in the same PATCH request
    if (currentDept.template) {
      // Read toggle states from the dynamically rendered checkboxes (includes merged components)
      const toggleStates = {};
      document.querySelectorAll('.edit-dept-component-toggle').forEach(function(cb) {
        toggleStates[cb.getAttribute('data-component-name')] = cb.checked;
      });

      // Start with existing components from the API
      const existingComponents = currentDept.template.components || [];
      const existingNames = {};
      const updatedComponents = existingComponents.map(component => {
        const componentName = component.name;
        existingNames[componentName] = true;
        const isEnabled = toggleStates.hasOwnProperty(componentName) ? toggleStates[componentName] : component.enabled;

        // Extract component ID - handle both string and {$oid: ...} formats
        let componentId = component._id;
        if (typeof componentId === 'object' && componentId !== null) {
          componentId = componentId.$oid || String(componentId);
        }

        return {
          _id: componentId,
          name: component.name,
          enabled: isEnabled
        };
      });

      // Add any new components from toggles that weren't in the original list (e.g. notepad on legacy depts)
      Object.keys(toggleStates).forEach(function(toggleName) {
        if (!existingNames[toggleName]) {
          updatedComponents.push({
            name: toggleName,
            enabled: toggleStates[toggleName]
          });
        }
      });

      // Extract template ID - handle both string and {$oid: ...} formats
      let templateId = currentDept.template._id;
      if (typeof templateId === 'object' && templateId !== null) {
        templateId = templateId.$oid || String(templateId);
      }

      // Include updated template in the payload with clean structure
      payload.template = {
        _id: templateId,
        name: currentDept.template.name,
        description: currentDept.template.description || '',
        components: updatedComponents
      };
    }

    const updateRes = await fetch(`${API_URL}/api/v1/community/${communityId}/departments/${deptId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    if (!updateRes.ok) {
      const errorText = await updateRes.text();
      console.error('Update failed with response:', errorText);
      throw new Error('Failed to update department');
    }

    await updateRes.json();

    closeEditDepartmentModal();
    if (typeof showToast === 'function') {
      showToast('Department updated successfully', 2500);
    } else {
      alert('Department updated successfully');
    }
    // Set flag to refresh component permissions when user returns to civilian dashboard
    sessionStorage.setItem('refreshComponentPermissions', 'true');
    refreshDepartmentsGrid();

  } catch (err) {
    console.error('Error in saveEditDepartment:', err);
    if (typeof showToast === 'function') {
      showToast(err.message || 'Failed to update department', 3000, 'error');
    } else {
      alert(err.message || 'Failed to update department');
    }
  } finally {
    // Always reset button state
    saveBtn.disabled = false;
    saveBtn.textContent = 'Save';
  }
}
function deleteEditDepartment() {
  // Get the department name to show in the confirmation modal
  const deptName = document.getElementById('editDeptName').value || 'this department';
  document.getElementById('deleteDeptName').textContent = deptName;

  // Reset the delete button state (in case it was left in "Deleting..." state from previous delete)
  const deleteBtn = document.getElementById('confirmDeleteDeptBtn');
  deleteBtn.disabled = false;
  deleteBtn.innerHTML = '<i class="fa fa-trash"></i> Delete Department';

  // Show the custom delete confirmation modal
  document.getElementById('deleteDepartmentModal').style.display = 'flex';
}

function closeDeleteDepartmentModal() {
  document.getElementById('deleteDepartmentModal').style.display = 'none';
}

async function confirmDeleteDepartment() {
  const deptId = currentEditDepartment;
  const communityId = '<%= community._id %>';
  const deleteBtn = document.getElementById('confirmDeleteDeptBtn');

  deleteBtn.disabled = true;
  deleteBtn.innerHTML = '<i class="fa fa-spinner fa-spin mr-2"></i>Deleting...';

  try {
    const response = await fetch(`${API_URL}/api/v1/community/${communityId}/departments/${deptId}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    });

    if (!response.ok) throw new Error('Failed to delete department');

    closeDeleteDepartmentModal();
    closeEditDepartmentModal();
    showToast('Department deleted successfully', 2500);
    refreshDepartmentsGrid();
  } catch (err) {
    showToast(err.message || 'Failed to delete department', 3000, 'error');
    deleteBtn.disabled = false;
    deleteBtn.innerHTML = '<i class="fa fa-trash mr-2"></i>Delete Department';
  }
}
</script>

