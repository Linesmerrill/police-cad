      function submitPcViolation() {
        var nameEl = document.getElementById('pcVioName');
        var jailEl = document.getElementById('pcVioJailTime');
        var name = nameEl.value.trim();
        var jailTime = jailEl.value.trim();
        var valid = true;

        nameEl.classList.remove('pcm-input-error');
        jailEl.classList.remove('pcm-input-error');
        if (!name) { nameEl.classList.add('pcm-input-error'); valid = false; }
        if (!jailTime) { jailEl.classList.add('pcm-input-error'); valid = false; }
        if (!valid) return;

        var data = {
          name: name,
          jailTime: jailTime,
          fine: parseInt(document.getElementById('pcVioFine').value, 10) || 0,
          explanation: document.getElementById('pcVioExplanation').value.trim()
        };

        if (pcSettingsViolationCallback) pcSettingsViolationCallback(data);
