            </div>
          `;
          membersList.insertAdjacentHTML('beforeend', paginationLoadingHTML);
          paginationLoading = document.getElementById('paginationLoading');
        }
        
        if (paginationLoading && membersList) {
          // Hide the current members list
          const memberItems = membersList.querySelectorAll('.member-item');
          memberItems.forEach(item => item.style.opacity = '0.3');
          
