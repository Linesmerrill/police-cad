<% /* --- Create Department Button (if user has permission) --- */ %>
<% if (typeof isMemberApproved !== 'undefined' && typeof canManageDepartments !== 'undefined' && isMemberApproved && canManageDepartments) { %>
  <button id="openCreateDepartmentModalBtn" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-full font-semibold shadow transition flex items-center mb-4">
    <i class="fa fa-plus mr-2"></i> Create Department
  </button>
<% } %>

<!-- HeroUI Pro Roles Management Modal -->
<div id="rolesModal" class="heroui-modal" style="display:none; position:fixed; z-index:3000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:900px; width:95%; position:relative; border:1px solid #35385a; max-height:90vh; overflow-y:auto;">
    <button onclick="closeRolesModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
    
    <div style="text-align:center; margin-bottom:2rem;">
      <i class="fa fa-users-cog" style="font-size:3rem; color:#8b5cf6; margin-bottom:1rem;"></i>
      <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Roles Management</h3>
      <p style="color:#a0aec0; margin:0.5rem 0 0 0;">Manage community roles and permissions</p>
    </div>

    <!-- Header with search and create button -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem; gap:1rem;">
      <div style="flex:1; max-width:400px;">
        <div style="position:relative;">
          <input type="text" id="rolesSearchInput" placeholder="Search roles..." style="width:100%; padding:0.75rem 1rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; color:#fff; font-size:1rem;">
          <button onclick="clearRolesSearch()" style="position:absolute; right:0.75rem; top:50%; transform:translateY(-50%); background:none; border:none; color:#a0aec0; cursor:pointer; display:none;" id="rolesSearchClear">
            <i class="fa fa-times"></i>
          </button>
        </div>
      </div>
      <div style="display:flex; align-items:center; gap:1rem;">
        <div style="color:#a0aec0; font-size:0.875rem;">
          <span id="rolesCount">0</span> <span id="rolesCountText">roles</span>
        </div>
        <button onclick="openCreateRoleModal()" style="background:#10b981; color:#fff; border:none; padding:0.75rem 1.5rem; border-radius:8px; font-weight:600; cursor:pointer; transition:all 0.2s; hover:background:#059669;">
          <i class="fa fa-plus" style="margin-right:0.5rem;"></i>
          Create Role
        </button>
      </div>
    </div>

    <!-- Loading state -->
    <div id="rolesLoading" style="text-align:center; padding:2rem;">
      <div class="loading-spinner" style="width:60px; height:60px; border:4px solid #4a5568; border-top:4px solid #f59e0b; border-radius:50%; animation:spin 1s linear infinite; margin:0 auto 1rem;"></div>
      <p style="color:#a0aec0;">Loading roles...</p>
    </div>

    <!-- Roles list -->
    <div id="rolesListContainer" style="display:none;">
      <div id="rolesList" style="display:grid; gap:1rem; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr));">
        <!-- Roles will be populated here -->
      </div>
    </div>

    <!-- Empty state -->
    <div id="rolesEmptyState" style="display:none; text-align:center; padding:3rem;">
      <i class="fa fa-users-cog" style="font-size:4rem; color:#4a5568; margin-bottom:1rem;"></i>
      <h4 style="color:#a0aec0; margin:0; font-size:1.25rem; font-weight:600;">No roles found</h4>
      <p style="color:#6b7280; margin:0.5rem 0 0 0;">Create your first role to get started</p>
    </div>
  </div>
</div>

<!-- Create Role Modal -->
<div id="createRoleModal" class="heroui-modal" style="display:none; position:fixed; z-index:4000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:600px; width:90%; position:relative; border:1px solid #35385a; max-height:90vh; overflow-y:auto;">
    
    <!-- Step 1: Create Role -->
    <div id="createRoleStep1" style="display:block;">
      <button onclick="closeCreateRoleModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
      
      <div style="text-align:center; margin-bottom:2rem;">
        <i class="fa fa-plus-circle" style="font-size:3rem; color:#10b981; margin-bottom:1rem;"></i>
        <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Step 1 of 2: Create a new role</h3>
      </div>

      <p style="color:#a0aec0; margin-bottom:1.5rem; text-align:center;">Give this role a unique name. You can always change this later.</p>

      <form id="createRoleForm">
        <div style="margin-bottom:1.5rem;">
          <label style="display:block; color:#e2e8f0; margin-bottom:0.5rem; font-weight:500;">Role Name</label>
          <input type="text" id="newRoleName" required style="width:100%; padding:0.75rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; color:#fff; font-size:1rem;" placeholder="Enter role name">
          <p style="color:#718096; font-size:0.875rem; margin-top:0.5rem;">e.g. admin, moderator, member, etc</p>
        </div>
        
        <div id="createRoleError" style="color:#ef4444; margin-bottom:1rem; display:none;"></div>
        
        <div style="display:flex; gap:1rem; justify-content:flex-end;">
          <button type="button" onclick="closeCreateRoleModal()" style="background:#6b7280; color:#fff; border:none; padding:0.75rem 1.5rem; border-radius:8px; font-weight:500; cursor:pointer;">Cancel</button>
          <button type="button" id="createRoleBtn" onclick="goToStep2()" style="background:#10b981; color:#fff; border:none; padding:0.75rem 1.5rem; border-radius:8px; font-weight:600; cursor:pointer;">Create</button>
        </div>
      </form>
    </div>
    
    <!-- Step 2: Add Members -->
    <div id="createRoleStep2" style="display:none;">
      <button onclick="closeCreateRoleModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
      
      <div style="text-align:center; margin-bottom:2rem;">
        <i class="fa fa-users" style="font-size:3rem; color:#10b981; margin-bottom:1rem;"></i>
        <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Step 2 of 2: Add Members</h3>
      </div>
      
      <p style="color:#a0aec0; margin-bottom:1.5rem; text-align:center;">Assign this role to your members. Members can have multiple roles. You can select up to 30 at a time.</p>
      
      <!-- Search Box -->
      <div style="margin-bottom:1.5rem;">
        <input type="text" id="memberSearchInput" placeholder="Search members..." style="width:100%; padding:0.75rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; color:#fff; font-size:1rem;">
      </div>
      
      <!-- Selected Members Display -->
      <div id="selectedMembersDisplay" style="margin-bottom:1.5rem; display:none;">
        <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
          <span style="color:#a0aec0; font-size:0.875rem;">Selected:</span>
          <span id="selectedCount" style="color:#10b981; font-weight:500;">0</span>
          <span style="color:#a0aec0; font-size:0.875rem;">/ 30</span>
        </div>
        <div id="selectedMembersList" style="display:flex; gap:0.5rem; flex-wrap:wrap; max-height:80px; overflow-y:auto; padding:0.5rem; background:#2d3748; border-radius:8px; border:1px solid #4a5568;">
          <!-- Selected members will be displayed here -->
        </div>
      </div>
      
      <!-- Members List -->
      <div id="createRoleMembersList" style="margin-bottom:2rem; max-height:300px; overflow-y:auto;">
        <!-- Members will be loaded here -->
      </div>
      
      <!-- Pagination -->
      <div id="createRolePagination" style="display:none; text-align:center; margin-bottom:2rem;">
        <!-- Pagination controls will be here -->
      </div>
      
      <div style="display:flex; gap:1rem; justify-content:space-between;">
        <button type="button" onclick="goBackToStep1()" style="background:#4a5568; color:#fff; border:none; padding:0.75rem 1.5rem; border-radius:8px; font-weight:500; cursor:pointer;">Back</button>
        <div style="display:flex; gap:1rem;">
          <button type="button" onclick="skipAddMembers()" style="background:#6b7280; color:#fff; border:none; padding:0.75rem 1.5rem; border-radius:8px; font-weight:500; cursor:pointer;">Skip this step</button>
          <button type="button" id="finishCreateRole" onclick="finishCreateRole()" disabled style="background:#10b981; color:#fff; border:none; padding:0.75rem 1.5rem; border-radius:8px; font-weight:500; cursor:pointer; opacity:0.5;">Finish</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Role Details Modal -->
<div id="roleDetailsModal" class="heroui-modal" style="display:none; position:fixed; z-index:4000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:800px; width:95%; position:relative; border:1px solid #35385a; max-height:90vh; overflow-y:auto;">
    <button onclick="closeRoleDetailsModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
    
    <div style="text-align:center; margin-bottom:2rem;">
      <i class="fa fa-user-shield" style="font-size:3rem; color:#8b5cf6; margin-bottom:1rem;"></i>
      <h3 id="roleDetailsTitle" style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Role Details</h3>
    </div>

    <!-- Role name editing -->
    <div style="margin-bottom:2rem; text-align:center;">
      <div style="display:flex; align-items:center; justify-content:center; gap:1rem;">
        <input type="text" id="editRoleName" style="padding:0.75rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; color:#fff; font-size:1.25rem; font-weight:600; text-align:center; min-width:200px;">
        <button onclick="saveRoleName()" style="background:#3b82f6; color:#fff; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:pointer; display:none;" id="saveRoleNameBtn">
          <i class="fa fa-check"></i>
        </button>
      </div>
    </div>

    <!-- Cards for Permissions and Members -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:2rem; margin-bottom:2rem;">
      <!-- Permissions Card -->
      <div style="background:#2d3748; border:1px solid #4a5568; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; hover:border-color:#8b5cf6;" onclick="openRolePermissionsModal()">
        <div style="text-align:center;">
          <div style="margin-bottom:0.5rem;">
            <i class="fa fa-shield-alt" style="font-size:2rem; color:#8b5cf6;"></i>
          </div>
          <h5 style="color:#fff; margin:0; font-size:1rem; font-weight:600;">Permissions</h5>
          <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage role permissions</p>
        </div>
      </div>

      <!-- Members Card -->
      <div style="background:#2d3748; border:1px solid #4a5568; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; hover:border-color:#10b981;" onclick="openRoleMembersModal()">
        <div style="text-align:center;">
          <div style="margin-bottom:0.5rem;">
            <i class="fa fa-users" style="font-size:2rem; color:#10b981;"></i>
          </div>
          <h5 style="color:#fff; margin:0; font-size:1rem; font-weight:600;">Members</h5>
          <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage role members</p>
        </div>
      </div>
    </div>

    <!-- Delete Role Button -->
    <div style="text-align:center;">
      <button id="deleteRoleBtn" onclick="deleteRoleConfirm()" style="background:#ef4444; color:#fff; border:none; padding:0.75rem 1.5rem; border-radius:8px; font-weight:600; cursor:pointer; transition:all 0.2s; hover:background:#dc2626;">
        <i class="fa fa-trash" style="margin-right:0.5rem;"></i>
        Delete Role
      </button>
    </div>
  </div>
</div>

<!-- Role Permissions Modal -->
<div id="rolePermissionsModal" class="heroui-modal" style="display:none; position:fixed; z-index:5000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:700px; width:95%; position:relative; border:1px solid #35385a; max-height:90vh; overflow-y:auto;">
    <button onclick="closeRolePermissionsModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
    
    <div style="text-align:center; margin-bottom:2rem;">
      <i class="fa fa-shield-alt" style="font-size:3rem; color:#8b5cf6; margin-bottom:1rem;"></i>
      <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Role Permissions</h3>
      <p id="rolePermissionsSubtitle" style="color:#a0aec0; margin:0.5rem 0 0 0;">Manage permissions for this role</p>
    </div>

    <!-- Search Bar -->
    <div style="margin-bottom:2rem;">
      <div style="position:relative;">
        <input type="text" id="permissionsSearchInput" placeholder="Search permissions..." style="width:100%; padding:0.75rem 1rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; color:#fff; font-size:1rem;">
        <button onclick="clearPermissionsSearch()" style="position:absolute; right:0.75rem; top:50%; transform:translateY(-50%); background:none; border:none; color:#a0aec0; cursor:pointer; display:none;" id="permissionsSearchClear">
          <i class="fa fa-times"></i>
        </button>
      </div>
    </div>

    <div id="permissionsList" style="margin-bottom:2rem;">
      <!-- Permissions will be populated here -->
    </div>

    <div style="display:flex; justify-content:flex-end; gap:1rem;">
      <button onclick="closeRolePermissionsModal()" style="background:#6b7280; color:#fff; border:none; padding:0.75rem 1.5rem; border-radius:8px; font-weight:500; cursor:pointer;">Cancel</button>
      <button id="savePermissionsBtn" onclick="saveRolePermissions()" style="background:#8b5cf6; color:#fff; border:none; padding:0.75rem 1.5rem; border-radius:8px; font-weight:600; cursor:pointer;">Save Permissions</button>
    </div>
  </div>
</div>

<!-- Administrator Confirm Modal -->
<div id="adminConfirmModal" style="display:none; position:fixed; z-index:6000; left:0; top:0; width:100vw; height:100vh; background:rgba(0,0,0,0.7); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:440px; width:90%; position:relative; border:1px solid #ef4444; box-shadow:0 0 30px rgba(239,68,68,0.3);">
    <div style="text-align:center; margin-bottom:1.5rem;">
      <i class="fa fa-exclamation-triangle" style="font-size:3rem; color:#ef4444; margin-bottom:1rem;"></i>
      <h3 style="color:#fff; margin:0; font-size:1.25rem; font-weight:700;">Grant Administrator?</h3>
    </div>
    <p style="color:#e5e7eb; font-size:0.95rem; line-height:1.6; text-align:center; margin:0 0 0.75rem 0;">
      This is a <strong style="color:#ef4444;">dangerous permission</strong> to grant.
    </p>
    <p style="color:#a0aec0; font-size:0.875rem; line-height:1.6; text-align:center; margin:0 0 1.5rem 0;">
      Members with this permission can access all settings and pages, manage all members and roles, and <strong style="color:#ef4444;">remove anyone from the community &mdash; including you</strong>.
    </p>
    <div style="display:flex; gap:0.75rem; justify-content:center;">
      <button onclick="closeAdminConfirmModal(false)" style="background:#374151; color:#fff; border:none; padding:0.7rem 1.5rem; border-radius:8px; font-weight:500; cursor:pointer; font-size:0.95rem;">Cancel</button>
      <button onclick="closeAdminConfirmModal(true)" style="background:#ef4444; color:#fff; border:none; padding:0.7rem 1.5rem; border-radius:8px; font-weight:600; cursor:pointer; font-size:0.95rem;">Yes, Grant Access</button>
    </div>
  </div>
</div>

<!-- Bans Management Modal -->
<div id="bansModal" class="heroui-modal" style="display:none; position:fixed; z-index:4000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:800px; width:95%; position:relative; border:1px solid #35385a; max-height:90vh; overflow-y:auto;">
    <button onclick="closeBansModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
    
    <div style="text-align:center; margin-bottom:2rem;">
      <i class="fa fa-ban" style="font-size:3rem; color:#ef4444; margin-bottom:1rem;"></i>
      <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Banned Users</h3>
      <p style="color:#a0aec0; margin:0.5rem 0 0 0;">Manage users banned from this community</p>
    </div>
    
    <!-- Search Box -->
    <div style="margin-bottom:1.5rem;">
      <div style="position:relative;">
        <input type="text" id="bansSearchInput" placeholder="Search banned users..." style="width:100%; padding:0.75rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; color:#fff; font-size:1rem; padding-right:3rem;">
        <button id="bansSearchClear" onclick="clearBansSearch()" style="position:absolute; right:0.75rem; top:50%; transform:translateY(-50%); background:none; border:none; color:#a0aec0; cursor:pointer; display:none; font-size:1.125rem;">
          <i class="fa fa-times"></i>
        </button>
      </div>
    </div>
    
    <!-- Bans Count -->
    <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem;">
      <div style="color:#a0aec0; font-size:0.875rem;">
        <span id="bansCount">0</span> <span id="bansCountText">banned users</span>
      </div>
    </div>
    
    <!-- Loading State -->
    <div id="bansLoading" style="text-align:center; padding:2rem; color:#a0aec0;">
      <i class="fa fa-spinner fa-spin" style="font-size:2rem; margin-bottom:1rem;"></i>
      <p>Loading banned users...</p>
    </div>
    
    <!-- Empty State -->
    <div id="bansEmptyState" style="text-align:center; padding:2rem; color:#a0aec0; display:none;">
      <i class="fa fa-ban" style="font-size:2rem; margin-bottom:1rem; opacity:0.5;"></i>
      <p>No banned users found</p>
    </div>
    
    <!-- Bans List Container -->
    <div id="bansListContainer" style="display:none;">
      <div id="bansList">
        <!-- Banned users will be loaded here -->
      </div>
    </div>
  </div>
</div>

<!-- Civilian Approvals Management Modal -->
<div id="civilianApprovalsModal" class="heroui-modal" style="display:none; position:fixed; z-index:4000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:1000px; width:95%; position:relative; border:1px solid #35385a; max-height:90vh; overflow-y:auto;">
    <button onclick="closeCivilianApprovalsModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
    
    <div style="text-align:center; margin-bottom:2rem;">
      <i class="fa fa-user-check" style="font-size:3rem; color:#ed8936; margin-bottom:1rem;"></i>
      <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Civilian Approvals</h3>
      <p style="color:#a0aec0; margin:0.5rem 0 0 0;">Review and manage civilian profile review requests</p>
    </div>
    
    <!-- Search Box -->
    <div style="margin-bottom:1.5rem;">
      <div style="position:relative;">
        <input type="text" id="civilianApprovalsSearchInput" placeholder="Search civilians awaiting review..." style="width:100%; padding:0.75rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; color:#fff; font-size:1rem; padding-right:3rem;" oninput="searchCivilianApprovals(this.value)">
        <button id="civilianApprovalsSearchClear" onclick="clearCivilianApprovalsSearch()" style="position:absolute; right:0.75rem; top:50%; transform:translateY(-50%); background:none; border:none; color:#a0aec0; cursor:pointer; display:none; font-size:1.125rem;">
          <i class="fa fa-times"></i>
        </button>
      </div>
    </div>
    
    <!-- Approvals Count -->
    <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem;">
      <div style="color:#a0aec0; font-size:0.875rem;">
        <span id="civilianApprovalsCount">0</span> <span id="civilianApprovalsCountText">awaiting review</span>
      </div>
    </div>
    
    <!-- Loading State -->
    <div id="civilianApprovalsLoading" style="text-align:center; padding:2rem; color:#a0aec0;">
      <i class="fa fa-spinner fa-spin" style="font-size:2rem; margin-bottom:1rem;"></i>
                      <p>Loading review requests...</p>
    </div>
    
    <!-- Empty State -->
    <div id="civilianApprovalsEmptyState" style="text-align:center; padding:2rem; color:#a0aec0; display:none;">
      <i class="fa fa-check-circle" style="font-size:2rem; margin-bottom:1rem; opacity:0.5; color:#10b981;"></i>
                      <p>No civilian review requests</p>
    </div>
    
    <!-- Approvals List Container -->
    <div id="civilianApprovalsListContainer" style="display:none;">
      <div id="civilianApprovalsList">
        <!-- Civilian review requests will be loaded here -->
      </div>
      
      <!-- Civilian Details View (hidden by default) -->
      <div id="civilianDetailsView" style="display:none;">
        <div style="margin-bottom:1.5rem;">
          <button id="backToApprovalsBtn" style="background:#6b7280; color:#fff; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:pointer; font-size:0.875rem; margin-bottom:1rem;">
            <i class="fa fa-arrow-left"></i> Back to Approvals
          </button>
          <h4 style="color:#fff; margin:0; font-size:1.25rem; font-weight:600;">Civilian Details</h4>
          <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Review and edit civilian information</p>
        </div>
        
        <!-- Civilian Photo Section -->
        <div style="margin-bottom:2rem; text-align:center;">
          <div style="position:relative; display:inline-block;">
