<div id="createEventModal" class="heroui-modal" style="display:none; position:fixed; z-index:3000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:500px; width:90%; position:relative; border:1px solid #35385a;">
    <button onclick="closeCreateEventModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
    <div style="text-align:center; margin-bottom:1.5rem;">
      <i class="fa fa-calendar-plus" style="font-size:3rem; color:#3b82f6; margin-bottom:1rem;"></i>
      <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Create Event</h3>
    </div>
    <form id="createEventForm" autocomplete="off">
      <div class="mb-4">
        <label class="block text-gray-300 mb-1">Event Image (Optional)</label>
        <div id="event-photo-upload" class="flex flex-col items-center justify-center border-2 border-dashed border-gray-500 rounded-lg p-4 bg-gray-800 cursor-pointer hover:border-blue-500 transition" onclick="document.getElementById('event-photo').click()">
          <img id="event-photo-preview" src="" alt="Preview" style="display:none; max-width:120px; max-height:120px; border-radius:0.5rem; margin-bottom:0.5rem;" />
          <i class="fa fa-camera text-2xl text-gray-400 mb-2"></i>
          <span class="text-gray-400 text-sm">Click to upload photo</span>
          <input type="file" id="event-photo" accept="image/*" style="display:none;" onchange="handleEventPhotoChange(event)" />
        </div>
      </div>
      <div class="mb-4">
        <label class="block text-gray-300 mb-1" for="event-title">Title *</label>
        <input type="text" id="event-title" required class="w-full text-gray-200 bg-gray-800 rounded p-2" />
      </div>
      <div class="mb-4">
        <label class="block text-gray-300 mb-1" for="event-date">Scheduled Date *</label>
        <input type="datetime-local" id="event-date" required class="w-full text-gray-200 bg-gray-800 rounded p-2" />
      </div>
      <div class="mb-4">
        <label class="block text-gray-300 mb-1" for="event-location">Location *</label>
        <input type="text" id="event-location" required class="w-full text-gray-200 bg-gray-800 rounded p-2" />
      </div>
      <div class="mb-4">
        <label class="block text-gray-300 mb-1" for="event-description">Description *</label>
        <textarea id="event-description" rows="3" required class="w-full text-gray-200 bg-gray-800 rounded p-2"></textarea>
      </div>
      <div class="mb-4">
        <label class="flex items-center gap-2 cursor-pointer text-gray-300">
          <input type="checkbox" id="event-required" class="w-4 h-4 rounded border-gray-500 bg-gray-800 text-blue-600 focus:ring-blue-500 focus:ring-offset-gray-800" style="accent-color: #3b82f6;" />
          <span>Attendance Required</span>
        </label>
      </div>
      <div id="createEventError" class="text-red-400 text-sm mb-2" style="display:none;"></div>
      <div class="flex justify-end gap-2 mt-6">
        <button type="button" onclick="closeCreateEventModal()" class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded">Cancel</button>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded font-semibold">Create</button>
      </div>
    </form>
  </div>
</div>
<script>
function openCreateEventModal() {
  document.getElementById('createEventModal').style.display = 'flex';
}
function closeCreateEventModal() {
  document.getElementById('createEventModal').style.display = 'none';
}
function handleEventPhotoChange(e) {
  const file = e.target.files[0];
  const preview = document.getElementById('event-photo-preview');
  if (file) {
    const reader = new FileReader();
    reader.onload = function(ev) {
      preview.src = ev.target.result;
      preview.style.display = 'block';
    };
    reader.readAsDataURL(file);
  } else {
    preview.src = '';
    preview.style.display = 'none';
  }
}
document.getElementById('createEventForm').onsubmit = async function(e) {
  e.preventDefault();
  const title = document.getElementById('event-title').value.trim();
  const scheduledDate = document.getElementById('event-date').value;
  const location = document.getElementById('event-location').value.trim();
  const description = document.getElementById('event-description').value.trim();
  const required = document.getElementById('event-required').checked;
  const communityID = '<%= community._id %>';
  const host = '<%= user && user._doc ? user._doc._id : "" %>';
  let image = '';
  const photoInput = document.getElementById('event-photo');

  if (!title || !scheduledDate || !location || !description) {
    document.getElementById('createEventError').textContent = 'All fields except image are required.';
    document.getElementById('createEventError').style.display = 'block';
    return;
  }
  document.getElementById('createEventError').style.display = 'none';

  // Upload image if one was selected
  if (photoInput && photoInput.files && photoInput.files[0]) {
    try {
      const file = photoInput.files[0];
      image = await uploadToCloudinary(file, 'events', `event_${Date.now()}`);
    } catch (uploadErr) {
      console.error('Image upload failed:', uploadErr);
      document.getElementById('createEventError').textContent = 'Failed to upload image. Please try again.';
      document.getElementById('createEventError').style.display = 'block';
      return;
    }
  }

  const payload = {
    communityID,
    title,
    scheduledDate: new Date(scheduledDate).toISOString(),
    image,
    location,
    description,
    host,
    coHosts: [],
    required
  };
  try {
    const res = await fetch(`${API_URL}/api/v1/community/${communityID}/events?userId=${window.dbUser?._id || ''}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (!res.ok) throw new Error('Failed to create event');
    const data = await res.json();
    closeCreateEventModal();
    // Reset form
    document.getElementById('createEventForm').reset();
    document.getElementById('event-photo-preview').style.display = 'none';
    // Use the event returned from the API (includes real _id)
    const newEvent = data.event || {
      // Fallback if API doesn't return event (shouldn't happen)
      _id: 'temp_' + Date.now(),
      title,
      scheduledDate: new Date(scheduledDate).toISOString(),
      image,
      location,
      description,
      host,
      coHosts: [],
      required,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString()
    };
    window.allEvents = window.allEvents || [];
    window.allEvents.push(newEvent);
    // Reset to page 1 to show events from the beginning (works correctly with filters)
    eventCurrentPage = 1;
    refreshEventsUI(true);
  } catch (err) {
    document.getElementById('createEventError').textContent = err.message || 'Failed to create event.';
    document.getElementById('createEventError').style.display = 'block';
  }
};
</script> 

<script>
// Announcement modal functions
function openCreateAnnouncementModal() {
  document.getElementById('createAnnouncementModal').style.display = 'flex';
}

function closeCreateAnnouncementModal() {
  document.getElementById('createAnnouncementModal').style.display = 'none';
  // Reset form
  document.getElementById('createAnnouncementForm').reset();
  document.getElementById('createAnnouncementError').style.display = 'none';
  // Clear any error highlighting
  clearAnnouncementFieldErrors();
}

function clearAnnouncementFieldErrors() {
  var fields = ['announcement-title', 'announcement-type', 'announcement-content'];
  fields.forEach(function(id) {
    var el = document.getElementById(id);
    if (el) {
      el.style.setProperty('border', '1px solid transparent', 'important');
      el.style.setProperty('box-shadow', 'none', 'important');
    }
  });
}

function highlightAnnouncementField(fieldId) {
  var el = document.getElementById(fieldId);
  if (el) {
    el.style.cssText = 'border: 2px solid #f87171 !important; box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.25) !important; background: #3b1f1f !important;';
    // Remove highlight after 4 seconds
    setTimeout(function() {
      el.style.cssText = 'border: 1px solid transparent; background: rgb(31, 41, 55);';
    }, 4000);
  }
}

function submitAnnouncement() {
  console.log('submitAnnouncement called');

  // Clear previous error states
  clearAnnouncementFieldErrors();
  var errorEl = document.getElementById('createAnnouncementError');
  if (errorEl) errorEl.style.display = 'none';

  var titleEl = document.getElementById('announcement-title');
  var typeEl = document.getElementById('announcement-type');
  var priorityEl = document.getElementById('announcement-priority');
  var contentEl = document.getElementById('announcement-content');
  var startTimeEl = document.getElementById('announcement-start-time');
  var endTimeEl = document.getElementById('announcement-end-time');

  var title = titleEl ? titleEl.value.trim() : '';
  var type = typeEl ? typeEl.value : '';
  var priority = priorityEl ? priorityEl.value : 'medium';
  var content = contentEl ? contentEl.value.trim() : '';
  var startTime = startTimeEl ? startTimeEl.value : '';
  var endTime = endTimeEl ? endTimeEl.value : '';

  console.log('Form values:', { title, type, content });

  // Validate required fields and highlight invalid ones
  var hasErrors = false;
  var errorMessages = [];

  if (!title) {
    console.log('Title is empty, highlighting');
    highlightAnnouncementField('announcement-title');
    errorMessages.push('Title');
    hasErrors = true;
  }
  if (!type) {
    console.log('Type is empty, highlighting');
    highlightAnnouncementField('announcement-type');
    errorMessages.push('Type');
    hasErrors = true;
  }
  if (!content) {
    console.log('Content is empty, highlighting');
    highlightAnnouncementField('announcement-content');
    errorMessages.push('Content');
    hasErrors = true;
  }

  if (hasErrors) {
    console.log('Has errors, showing error message');
    if (errorEl) {
      errorEl.textContent = 'Please fill in the required fields: ' + errorMessages.join(', ');
      errorEl.style.display = 'block';
    }
    return;
  }

  // TODO: Submit announcement to API
  // For now, show a success message
  var communityID = '<%= community._id %>';
  var payload = {
    title: title,
    type: type,
    priority: priority,
    content: content,
    startTime: startTime || null,
    endTime: endTime || null
  };

  // Show loading state on button
  var submitBtn = document.querySelector('#createAnnouncementForm button[type="submit"]');
  var originalContent = submitBtn.innerHTML;
  submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin mr-1"></i>Creating...';
  submitBtn.disabled = true;

  fetch(window.API_URL + '/api/v1/community/' + communityID + '/announcements', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  })
    .then(function(res) {
      if (!res.ok) throw new Error('Failed to create announcement');
      return res.json();
    })
    .then(function(data) {
      closeCreateAnnouncementModal();
      // Reload page to show new announcement
      window.location.reload();
    })
    .catch(function(err) {
      var errorEl = document.getElementById('createAnnouncementError');
      errorEl.textContent = err.message || 'Failed to create announcement.';
      errorEl.style.display = 'block';
      submitBtn.innerHTML = originalContent;
      submitBtn.disabled = false;
    });
}

function openNoAnnouncementPermissionModal() {
  document.getElementById('noAnnouncementPermissionModal').style.display = 'flex';
}

function closeNoAnnouncementPermissionModal() {
  document.getElementById('noAnnouncementPermissionModal').style.display = 'none';
}


</script>

