          if (isNaN(maxFirearms) || maxFirearms < 1 || maxFirearms > 100) {
            // Show error and prevent saving
            validateMaxFirearmsInput(document.getElementById('maxFirearmsPerDept'));
            showSettingsError('Please fix the validation errors before saving.');
            return;
          }
        }
        
        // Get warrant approval mode
        const warrantApprovalModeEl = document.querySelector('input[name="warrantApprovalMode"]:checked');
        const warrantApprovalMode = warrantApprovalModeEl ? warrantApprovalModeEl.value : 'auto-approve';
        const warrantRandomApprovalRate = parseInt(document.getElementById('warrantRandomApprovalRate').value) || 70;

        // Use the actual field names that match the backend community model
        const updateData = {
          civilianCreationLimitsEnabled: enableLimits,
          civilianCreationLimit: maxCivilians,
          civilianApprovalSystemEnabled: enableApproval,
          vehicleCreationLimitsEnabled: enableVehicleLimits,
          vehicleCreationLimit: maxVehicles,
          firearmCreationLimitsEnabled: enableFirearmLimits,
          firearmCreationLimit: maxFirearms,
          warrantApprovalMode: warrantApprovalMode,
          warrantRandomApprovalRate: warrantRandomApprovalRate
        };
        
        // Save to server - use the same route as saveCommunityProfile
        const communityId = '<%= community._id %>';
        const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
        
        fetch(`${apiUrl}/api/v1/community/${communityId}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(updateData)
        })
        .then(res => {
          if (res.ok) {
            // Show success message
            showSettingsSuccess('General settings saved successfully!');
            closeGeneralSettingsModal();
          } else {
            throw new Error('Failed to save general settings');
          }
        })
        .catch(error => {
          console.error('Error saving general settings:', error);
          showSettingsError('Failed to save general settings. Please try again.');
        });
      }

      function showSettingsSuccess(message) {
        const successDiv = document.getElementById('settingsSuccess');
        successDiv.textContent = message;
        successDiv.style.display = 'block';
        setTimeout(() => {
          successDiv.style.display = 'none';
        }, 3000);
      }

      function showSettingsError(message) {
        const errorDiv = document.getElementById('settingsError');
        errorDiv.textContent = message;
        errorDiv.style.display = 'block';
        setTimeout(() => {
          errorDiv.style.display = 'none';
        }, 5000);
      }

      // Fine Settings Modal Functions
      function openFineSettingsModal() {
        document.getElementById('fineSettingsModal').style.display = 'flex';
        
        // Show loading state immediately
        document.getElementById('fineSettingsLoading').style.display = 'flex';
        
        // Always refresh data when opening modal to show latest information
        refreshFineSettings();
        
        // Add event listener for currency change
        document.getElementById('fineCurrency').addEventListener('change', handleCurrencyChange);
      }

      function openPenalCodesSettings() {
        document.getElementById('penalCodesModal').style.display = 'flex';
        document.getElementById('pcSettingsLoading').style.display = 'flex';
        loadPenalCodeSettings();
      }

      // ═══════════════════════════════════════
      //  PENAL CODES SETTINGS MODAL
      // ═══════════════════════════════════════
      var pcSettingsData = [];       // categories array
      var pcSettingsCurrency = 'USD';
      var pcSettingsCurrencies = []; // currencies array for API
      var pcSettingsOriginal = '';   // JSON snapshot for dirty check
      var pcSettingsViolationCallback = null; // callback from sub-modal

      var pcCurrencySymbolMap = {
        'USD': '$', 'EUR': '€', 'GBP': '£', 'CAD': 'C$', 'AUD': 'A$'
      };

      var pcmAccents = [
        { accent: '#8b5cf6', bg: 'rgba(139,92,246,0.12)' },
        { accent: '#3b82f6', bg: 'rgba(59,130,246,0.12)' },
        { accent: '#fbbf24', bg: 'rgba(251,191,36,0.12)' },
        { accent: '#ef4444', bg: 'rgba(239,68,68,0.12)' },
        { accent: '#10b981', bg: 'rgba(16,185,129,0.12)' },
        { accent: '#ec4899', bg: 'rgba(236,72,153,0.12)' },
        { accent: '#f97316', bg: 'rgba(249,115,22,0.12)' },
        { accent: '#06b6d4', bg: 'rgba(6,182,212,0.12)' },
      ];
      var pcmCatIcons = ['fa-shield-halved','fa-car','fa-gun','fa-people-group','fa-cannabis','fa-gavel','fa-handcuffs','fa-building-columns'];

      function pcSettingsGetSymbol(code) {
        return pcCurrencySymbolMap[code] || code || '$';
      }

      function updatePcCurrencyDisplay() {
        var sym = pcSettingsGetSymbol(pcSettingsCurrency);
        document.getElementById('pcmCurrencySym').textContent = sym;
        document.getElementById('pcmCurrencyCode').textContent = pcSettingsCurrency;
      }

      function loadPenalCodeSettings() {
        var communityId = '<%= community._id %>';
        var apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

        fetch(apiUrl + '/api/v1/community/' + communityId + '/penal-codes')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            pcSettingsData = (data && data.categories) || [];
            pcSettingsCurrency = (data && data.currency) || 'USD';
            pcSettingsCurrencies = (data && data.currencies) || [];

            // Build symbol map from currencies array
            if (pcSettingsCurrencies.length > 0) {
              pcSettingsCurrencies.forEach(function(c) {
                pcCurrencySymbolMap[c.code] = c.symbol;
              });
            }

            updatePcCurrencyDisplay();
            pcSettingsOriginal = JSON.stringify({ categories: pcSettingsData, currency: pcSettingsCurrency });
            renderPcCategories(pcSettingsData);
            document.getElementById('pcSettingsLoading').style.display = 'none';
          })
          .catch(function(err) {
            console.error('[PenalCodesSettings] Load error:', err);
            document.getElementById('pcSettingsLoading').style.display = 'none';
            document.getElementById('pcCategoriesContainer').innerHTML =
              '<div class="pcm-empty-state"><i class="fa fa-exclamation-circle"></i><p>Failed to load penal codes.</p><p class="sub">Please try again.</p></div>';
          });
      }

      // ── Currency Picker ──

      function openPcCurrencyPicker() {
        var currencies = [
          { code: 'USD', sym: '$', label: 'US Dollar' },
          { code: 'EUR', sym: '€', label: 'Euro' },
          { code: 'GBP', sym: '£', label: 'British Pound' },
          { code: 'CAD', sym: 'C$', label: 'Canadian Dollar' },
          { code: 'AUD', sym: 'A$', label: 'Australian Dollar' },
        ];
        var html = '';
        currencies.forEach(function(c) {
          var active = c.code === pcSettingsCurrency ? ' active' : '';
          html += '<div class="pcm-cur-item' + active + '" onclick="selectPcCurrency(\'' + c.code + '\',\'' + escAttr(c.sym) + '\')">' +
            '<span class="sym">' + escHtml(c.sym) + '</span><span class="label">' + escHtml(c.label) + ' (' + c.code + ')</span></div>';
        });
        document.getElementById('pcCurrencyPickerList').innerHTML = html;
        document.getElementById('pcCurrencyCustomInput').value = '';
        document.getElementById('pcCurrencyPicker').style.display = 'flex';
      }

      function closePcCurrencyPicker() {
        document.getElementById('pcCurrencyPicker').style.display = 'none';
      }

      function selectPcCurrency(code, sym) {
        pcSettingsCurrency = code;
        pcCurrencySymbolMap[code] = sym;
        updatePcCurrencyDisplay();
        closePcCurrencyPicker();
        renderPcCategories(pcSettingsData);
      }

      function setPcCustomCurrency() {
        var val = document.getElementById('pcCurrencyCustomInput').value.trim().toUpperCase();
        if (!val) return;
        pcSettingsCurrency = val;
        updatePcCurrencyDisplay();
        closePcCurrencyPicker();
        renderPcCategories(pcSettingsData);
      }

      function renderPcCategories(categories) {
        var container = document.getElementById('pcCategoriesContainer');
        container.innerHTML = '';

        if (!categories || categories.length === 0) {
          container.innerHTML = '<div class="pcm-empty-state"><i class="fa fa-scale-balanced"></i><p>No penal code categories yet.</p><p class="sub">Click "+ Category" above to get started.</p></div>';
          return;
        }

        var sym = pcSettingsGetSymbol(pcSettingsCurrency);

        categories.forEach(function(cat, catIdx) {
          var violations = cat.violations || [];
          var accent = pcmAccents[catIdx % pcmAccents.length];
          var icon = cat.icon || pcmCatIcons[catIdx % pcmCatIcons.length];
          var vioCount = violations.length;
          var countLabel = vioCount === 1 ? '1 violation' : vioCount + ' violations';

          // Table body
          var tbody = '';
          if (violations.length === 0) {
            tbody = '<tr><td colspan="5" class="pcm-empty-cat">No violations — click "Add" to create one.</td></tr>';
          } else {
            violations.forEach(function(v, vIdx) {
              var fineDisplay = v.fine ? escHtml(sym) + Number(v.fine).toLocaleString() : '—';
              tbody +=
                '<tr data-cat="' + catIdx + '" data-vio="' + vIdx + '">' +
                  '<td class="pcm-v-name">' + escHtml(v.name) + '</td>' +
                  '<td class="pcm-v-jail">' + escHtml(v.jailTime || '—') + '</td>' +
                  '<td class="pcm-v-fine">' + fineDisplay + '</td>' +
                  '<td class="pcm-v-expl">' + escHtml(v.explanation || '') + '</td>' +
                  '<td class="pcm-v-actions">' +
                    '<button class="pcm-icon-btn" onclick="editPcViolation(' + catIdx + ',' + vIdx + ')" title="Edit"><i class="fa fa-pen"></i></button>' +
                    '<button class="pcm-icon-btn danger" onclick="removePcViolation(' + catIdx + ',' + vIdx + ')" title="Delete"><i class="fa fa-trash"></i></button>' +
                  '</td>' +
                '</tr>';
            });
          }

          var catHtml =
            '<div class="pcm-cat" data-cat-idx="' + catIdx + '" style="--pcm-accent:' + accent.accent + ';--pcm-icon-bg:' + accent.bg + ';">' +
              '<div class="pcm-cat-header" onclick="togglePcCategory(this)">' +
                '<div class="pcm-cat-left">' +
                  '<i class="fa fa-chevron-down pcm-cat-chevron open"></i>' +
                  '<div class="pcm-cat-icon"><i class="fa ' + escAttr(icon) + '"></i></div>' +
                  '<input class="pcm-cat-name-input" value="' + escAttr(cat.name) + '" placeholder="Category Name" onclick="event.stopPropagation()" onkeydown="if(event.key===\'Enter\')this.blur()">' +
                  '<span class="pcm-cat-count">' + countLabel + '</span>' +
                '</div>' +
                '<div class="pcm-cat-actions" onclick="event.stopPropagation()">' +
                  '<button class="pcm-add-vio" onclick="addPcViolation(' + catIdx + ')"><i class="fa fa-plus"></i> Add</button>' +
                  '<button class="pcm-icon-btn danger" onclick="removePcCategory(' + catIdx + ')" title="Delete category"><i class="fa fa-trash"></i></button>' +
                '</div>' +
              '</div>' +
              '<div class="pcm-cat-body open">' +
                '<table class="pcm-table">' +
                  '<thead><tr>' +
                    '<th>Violation</th><th>Jail Time</th><th>Fine</th><th>Explanation</th><th></th>' +
                  '</tr></thead>' +
                  '<tbody>' + tbody + '</tbody>' +
                '</table>' +
              '</div>' +
            '</div>';

          container.insertAdjacentHTML('beforeend', catHtml);
        });
      }

      function togglePcCategory(headerEl) {
        var chevron = headerEl.querySelector('.pcm-cat-chevron');
        var body = headerEl.nextElementSibling;
        if (body.classList.contains('open')) {
          body.classList.remove('open');
          chevron.classList.remove('open');
        } else {
          body.classList.add('open');
          chevron.classList.add('open');
        }
      }

      function syncPcCategoryNames() {
        var catDivs = document.querySelectorAll('#pcCategoriesContainer .pcm-cat');
        catDivs.forEach(function(catDiv) {
          var catIdx = parseInt(catDiv.getAttribute('data-cat-idx'), 10);
          var nameInput = catDiv.querySelector('.pcm-cat-name-input');
          if (pcSettingsData[catIdx] && nameInput) {
            pcSettingsData[catIdx].name = nameInput.value.trim();
          }
        });
      }

      function escHtml(str) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(str || ''));
        return d.innerHTML;
      }

      function escAttr(str) {
        return (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function addPcCategory() {
        syncPcCategoryNames();
        pcSettingsData.push({ name: '', violations: [] });
        renderPcCategories(pcSettingsData);
        // Focus the new category name input
        var cats = document.querySelectorAll('#pcCategoriesContainer .pcm-cat');
        if (cats.length > 0) {
          var lastCat = cats[cats.length - 1];
          var input = lastCat.querySelector('.pcm-cat-name-input');
          if (input) input.focus();
        }
      }

      function removePcCategory(catIdx) {
        syncPcCategoryNames();
        var catName = pcSettingsData[catIdx] ? pcSettingsData[catIdx].name : 'this category';
        showCustomConfirm(
          'Remove Category',
          'Delete "' + (catName || 'Unnamed') + '" and all its violations?',
          function() {
            pcSettingsData.splice(catIdx, 1);
            renderPcCategories(pcSettingsData);
          }
        );
      }

      // — Violation sub-modal —

      function addPcViolation(catIdx) {
        syncPcCategoryNames();
        var titleSpan = document.querySelector('#pcViolationModalTitle span');
        if (titleSpan) titleSpan.textContent = 'Add Violation';
        document.getElementById('pcViolationSubmitText').textContent = 'Add Violation';
        document.getElementById('pcVioName').value = '';
        document.getElementById('pcVioJailTime').value = '';
        document.getElementById('pcVioFine').value = '';
        document.getElementById('pcVioExplanation').value = '';
        document.getElementById('pcVioName').classList.remove('pcm-input-error');
        document.getElementById('pcVioJailTime').classList.remove('pcm-input-error');
        document.getElementById('pcViolationModal').style.display = 'flex';

        pcSettingsViolationCallback = function(data) {
          if (!pcSettingsData[catIdx].violations) pcSettingsData[catIdx].violations = [];
          pcSettingsData[catIdx].violations.push(data);
          renderPcCategories(pcSettingsData);
        };
      }

      function editPcViolation(catIdx, vIdx) {
        syncPcCategoryNames();
        var v = pcSettingsData[catIdx] && pcSettingsData[catIdx].violations && pcSettingsData[catIdx].violations[vIdx];
        if (!v) return;

        var titleSpan = document.querySelector('#pcViolationModalTitle span');
        if (titleSpan) titleSpan.textContent = 'Edit Violation';
        document.getElementById('pcViolationSubmitText').textContent = 'Update Violation';
        document.getElementById('pcVioName').value = v.name || '';
        document.getElementById('pcVioJailTime').value = v.jailTime || '';
        document.getElementById('pcVioFine').value = v.fine || '';
        document.getElementById('pcVioExplanation').value = v.explanation || '';
        document.getElementById('pcVioName').classList.remove('pcm-input-error');
        document.getElementById('pcVioJailTime').classList.remove('pcm-input-error');
        document.getElementById('pcViolationModal').style.display = 'flex';

        pcSettingsViolationCallback = function(data) {
          pcSettingsData[catIdx].violations[vIdx] = data;
          renderPcCategories(pcSettingsData);
        };
      }

      function removePcViolation(catIdx, vIdx) {
        var v = pcSettingsData[catIdx] && pcSettingsData[catIdx].violations && pcSettingsData[catIdx].violations[vIdx];
        var vName = v ? v.name : 'this violation';
        showCustomConfirm(
          'Remove Violation',
          'Delete "' + (vName || 'Unnamed') + '"?',
          function() {
            syncPcCategoryNames();
            pcSettingsData[catIdx].violations.splice(vIdx, 1);
            renderPcCategories(pcSettingsData);
          }
        );
      }

      function submitPcViolation() {
        var nameEl = document.getElementById('pcVioName');
        var jailEl = document.getElementById('pcVioJailTime');
        var name = nameEl.value.trim();
        var jailTime = jailEl.value.trim();
        var valid = true;

        nameEl.classList.remove('pcm-input-error');
        jailEl.classList.remove('pcm-input-error');
        if (!name) { nameEl.classList.add('pcm-input-error'); valid = false; }
        if (!jailTime) { jailEl.classList.add('pcm-input-error'); valid = false; }
        if (!valid) return;

        var data = {
          name: name,
          jailTime: jailTime,
          fine: parseInt(document.getElementById('pcVioFine').value, 10) || 0,
          explanation: document.getElementById('pcVioExplanation').value.trim()
        };

        if (pcSettingsViolationCallback) pcSettingsViolationCallback(data);
        closePcViolationModal();
      }

      function closePcViolationModal() {
        document.getElementById('pcViolationModal').style.display = 'none';
        pcSettingsViolationCallback = null;
      }

      // — Search —

      function searchPenalCodes(query) {
        var q = (query || '').toLowerCase().trim();
        if (!q) {
          renderPcCategories(pcSettingsData);
          return;
        }
        var filtered = pcSettingsData.map(function(cat) {
          var catMatch = (cat.name || '').toLowerCase().indexOf(q) !== -1;
          var matchedViolations = (cat.violations || []).filter(function(v) {
            return (v.name || '').toLowerCase().indexOf(q) !== -1 ||
                   (v.jailTime || '').toLowerCase().indexOf(q) !== -1 ||
                   (v.explanation || '').toLowerCase().indexOf(q) !== -1 ||
                   String(v.fine || '').indexOf(q) !== -1;
          });
          if (catMatch || matchedViolations.length > 0) {
            return {
              name: cat.name, subtitle: cat.subtitle, icon: cat.icon,
              color: cat.color, columns: cat.columns,
              violations: catMatch ? (cat.violations || []) : matchedViolations
            };
          }
          return null;
        }).filter(Boolean);
        renderPcCategories(filtered);
      }

      // — Save —

      function savePenalCodeSettings() {
        syncPcCategoryNames();

        var payload = {
          categories: pcSettingsData,
          currency: pcSettingsCurrency,
          currencies: pcSettingsCurrencies
        };

        var communityId = '<%= community._id %>';
        var apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

        fetch(apiUrl + '/api/v1/community/' + communityId + '/penal-codes', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          pcSettingsOriginal = JSON.stringify({ categories: pcSettingsData, currency: pcSettingsCurrency });
          showToast('Penal codes saved successfully!', 3000, 'success');
          closePenalCodesModal();
        })
        .catch(function(err) {
          showToast('Error saving penal codes: ' + err.message, 3000, 'error');
        });
      }

      // — Close with dirty check —

      function pcSettingsIsDirty() {
        syncPcCategoryNames();
        var current = JSON.stringify({ categories: pcSettingsData, currency: pcSettingsCurrency });
        return current !== pcSettingsOriginal;
      }

      function attemptClosePenalCodesModal() {
        if (pcSettingsIsDirty()) {
          showCustomConfirm(
            'Unsaved Changes',
            'You have unsaved changes. Discard them?',
            function() { closePenalCodesModal(); }
          );
        } else {
          closePenalCodesModal();
        }
      }

      function closePenalCodesModal() {
        document.getElementById('penalCodesModal').style.display = 'none';
        document.getElementById('pcSettingsSearch').value = '';
      }

      // ═══════════════════════════════════════
      //  PENAL CODES IMPORT / EXPORT
      // ═══════════════════════════════════════

      function showPcExportMenu() {
        showCustomConfirm(
          'Export Penal Codes',
          'Choose export format:',
          function() { exportPenalCodesJSON(); },
          function() { exportPenalCodesCSV(); },
          'JSON',
          'CSV'
        );
      }

      function resetToDefaultPenalCodes() {
        showCustomConfirm(
          'Reset to Default Penal Codes',
          'Are you sure you want to reset all penal codes to the default set? This will replace all current categories and violations.',
          function() {
            var communityId = '<%= community._id %>';
            var apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

            fetch(apiUrl + '/api/v1/community/' + communityId + '/penal-codes/reset', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            })
              .then(function(res) {
                if (!res.ok) throw new Error('Failed to reset penal codes');
                return res.json();
              })
              .then(function(data) {
                pcSettingsData = (data && data.categories) || [];
                pcSettingsCurrency = (data && data.currency) || 'USD';
                pcSettingsCurrencies = (data && data.currencies) || [];

                if (pcSettingsCurrencies.length > 0) {
                  pcSettingsCurrencies.forEach(function(c) {
                    pcCurrencySymbolMap[c.code] = c.symbol;
                  });
                }

                updatePcCurrencyDisplay();
                pcSettingsOriginal = JSON.stringify({ categories: pcSettingsData, currency: pcSettingsCurrency });
                renderPcCategories(pcSettingsData);
                showToast('Penal codes reset to defaults!', 3000, 'success');
              })
              .catch(function(err) {
                console.error('[PenalCodes] Reset error:', err);
                showToast('Error resetting penal codes: ' + err.message, 3000, 'error');
              });
          }
        );
      }

      function triggerDownload(content, filename, mimeType) {
        var blob = new Blob([content], { type: mimeType });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      function exportPenalCodesJSON() {
        syncPcCategoryNames();
        var payload = {
          categories: pcSettingsData,
          currency: pcSettingsCurrency,
          currencies: pcSettingsCurrencies
        };
        triggerDownload(JSON.stringify(payload, null, 2), 'penal-codes.json', 'application/json');
        showCustomToast('Penal codes exported as JSON', 'success');
      }

      function exportPenalCodesCSV() {
        syncPcCategoryNames();
        var rows = [['category_id', 'category_name', 'subtitle', 'icon', 'color', 'violation_name', 'jail_time', 'fine', 'explanation']];
        (pcSettingsData || []).forEach(function(cat) {
          (cat.violations || []).forEach(function(v) {
            rows.push([
              cat.id || '', cat.name || '', cat.subtitle || '', cat.icon || '', cat.color || '',
              v.name || '', v.jailTime || '', String(v.fine || 0), v.explanation || ''
            ]);
          });
        });
        var csv = rows.map(function(row) {
          return row.map(function(cell) {
            var s = String(cell).replace(/"/g, '""');
            return (s.indexOf(',') >= 0 || s.indexOf('"') >= 0 || s.indexOf('\n') >= 0) ? '"' + s + '"' : s;
          }).join(',');
        }).join('\n');
        triggerDownload(csv, 'penal-codes.csv', 'text/csv');
        showCustomToast('Penal codes exported as CSV', 'success');
      }

      function importPenalCodesFile(input) {
        var file = input.files[0];
        if (!file) return;
        input.value = ''; // Reset so same file can be picked again

        var reader = new FileReader();
        reader.onload = function(e) {
          var text = e.target.result;
          var isCSV = file.name.toLowerCase().endsWith('.csv');

          try {
            var parsed;
            if (isCSV) {
              parsed = parsePenalCodesCSV(text);
            } else {
              parsed = parsePenalCodesJSON(text);
            }

            showCustomConfirm(
              'Import Penal Codes',
              'This will replace all current penal codes with ' + countPcViolations(parsed.categories) + ' violations across ' + parsed.categories.length + ' categories. Continue?',
              function() {
                pcSettingsData = parsed.categories;
                if (parsed.currency) pcSettingsCurrency = parsed.currency;
                if (parsed.currencies && parsed.currencies.length > 0) pcSettingsCurrencies = parsed.currencies;
                updatePcCurrencyDisplay();
                renderPcCategories(pcSettingsData);
                showCustomToast('Penal codes imported. Click "Save Changes" to persist.', 'success');
              }
            );
          } catch (err) {
            showCustomToast('Import error: ' + err.message, 'error');
          }
        };
        reader.readAsText(file);
      }

      function countPcViolations(categories) {
        var count = 0;
        (categories || []).forEach(function(cat) { count += (cat.violations || []).length; });
        return count;
      }

      function parsePenalCodesJSON(text) {
        var data = JSON.parse(text);
        if (!data.categories || !Array.isArray(data.categories)) {
          throw new Error('JSON must contain a "categories" array');
        }
        data.categories.forEach(function(cat, i) {
          if (!cat.name) throw new Error('Category at index ' + i + ' is missing a name');
          if (!cat.id) cat.id = cat.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          if (!cat.violations) cat.violations = [];
          if (!cat.columns) cat.columns = ['name', 'jailTime', 'fine', 'explanation'];
        });
        return data;
      }

      function parsePenalCodesCSV(text) {
        var lines = parseCSVLines(text);
        if (lines.length < 2) throw new Error('CSV must have a header row and at least one data row');

        var header = lines[0].map(function(h) { return h.trim().toLowerCase(); });
        var catIdIdx = header.indexOf('category_id');
        var catNameIdx = header.indexOf('category_name');
        var subtitleIdx = header.indexOf('subtitle');
        var iconIdx = header.indexOf('icon');
        var colorIdx = header.indexOf('color');
        var violNameIdx = header.indexOf('violation_name');
        var jailIdx = header.indexOf('jail_time');
        var fineIdx = header.indexOf('fine');
        var explIdx = header.indexOf('explanation');

        if (violNameIdx < 0) throw new Error('CSV must have a "violation_name" column');

        var categoryMap = {};
        var categoryOrder = [];

        for (var i = 1; i < lines.length; i++) {
          var row = lines[i];
          if (row.length === 0 || (row.length === 1 && row[0].trim() === '')) continue;

          var catId = (catIdIdx >= 0 ? row[catIdIdx] : '').trim();
          var catName = (catNameIdx >= 0 ? row[catNameIdx] : '').trim();
          if (!catId && catName) catId = catName.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          if (!catId) catId = 'imported';
          if (!catName) catName = catId;

          if (!categoryMap[catId]) {
            categoryMap[catId] = {
              id: catId,
              name: catName,
              subtitle: subtitleIdx >= 0 ? (row[subtitleIdx] || '').trim() : '',
              icon: iconIdx >= 0 ? (row[iconIdx] || '').trim() : 'fa-gavel',
              color: colorIdx >= 0 ? (row[colorIdx] || '').trim() : '#8b5cf6',
              columns: ['name', 'jailTime', 'fine', 'explanation'],
              violations: []
            };
            categoryOrder.push(catId);
          }

          var vName = (violNameIdx >= 0 ? row[violNameIdx] : '').trim();
          if (!vName) continue;

          categoryMap[catId].violations.push({
            name: vName,
            jailTime: jailIdx >= 0 ? (row[jailIdx] || '').trim() : '',
            fine: fineIdx >= 0 ? parseInt(row[fineIdx], 10) || 0 : 0,
            explanation: explIdx >= 0 ? (row[explIdx] || '').trim() : ''
          });
        }

        var categories = categoryOrder.map(function(id) { return categoryMap[id]; });
        if (categories.length === 0) throw new Error('No valid data rows found in CSV');
        return { categories: categories, currency: pcSettingsCurrency, currencies: pcSettingsCurrencies };
      }

      // Robust CSV parser that handles quoted fields with commas and newlines
      function parseCSVLines(text) {
        var lines = [];
        var currentRow = [];
        var currentField = '';
        var inQuotes = false;
        var i = 0;

        while (i < text.length) {
          var ch = text[i];
          if (inQuotes) {
            if (ch === '"') {
              if (i + 1 < text.length && text[i + 1] === '"') {
                currentField += '"';
                i += 2;
              } else {
                inQuotes = false;
                i++;
              }
            } else {
              currentField += ch;
              i++;
            }
          } else {
            if (ch === '"') {
              inQuotes = true;
              i++;
            } else if (ch === ',') {
              currentRow.push(currentField);
              currentField = '';
              i++;
            } else if (ch === '\r' || ch === '\n') {
              currentRow.push(currentField);
              currentField = '';
              lines.push(currentRow);
              currentRow = [];
              if (ch === '\r' && i + 1 < text.length && text[i + 1] === '\n') i++;
              i++;
            } else {
              currentField += ch;
              i++;
            }
          }
        }
        // Last field/row
        if (currentField || currentRow.length > 0) {
          currentRow.push(currentField);
          lines.push(currentRow);
        }
        return lines;
      }

