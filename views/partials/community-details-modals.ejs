          <div class="member-item" style="background:#2d3748; border:1px solid #4a5568; border-radius:8px; padding:1rem; margin-bottom:0.75rem; cursor:pointer; transition:all 0.2s; hover:border-color:#3b82f6;" onclick="openMemberActions('${member._id}')">
