    document.getElementById('civDetailsImperialWeight').classList.add('active');
    document.getElementById('civDetailsImperialWeight').style.background = 'linear-gradient(135deg,#667eea 0%,#764ba2 100%)';
    document.getElementById('civDetailsImperialWeight').style.color = '#fff';
    document.getElementById('civDetailsMetricWeight').classList.remove('active');
    document.getElementById('civDetailsMetricWeight').style.background = 'transparent';
    document.getElementById('civDetailsMetricWeight').style.color = '#a0aec0';
