          <!-- Dynamically populated -->
        </div>

        <!-- Footer -->
        <div class="pcm-footer">
          <button class="pcm-btn-cancel" onclick="attemptClosePenalCodesModal()">Cancel</button>
          <button class="pcm-btn-save" onclick="savePenalCodeSettings()">
            <i class="fa fa-check"></i> Save Changes
          </button>
        </div>

        <!-- Loading overlay -->
