            <!-- User doesn't have permission to manage bans -->
            <div id="bansManagementCard" onclick="showNoBansPermissionModal()" style="background:#1a202c; border:1px solid #2d3748; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; opacity:0.6;">
              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-ban" style="font-size:2rem; color:#6b7280;"></i>
                </div>
                <h5 style="color:#6b7280; margin:0; font-size:1rem; font-weight:600;">Bans</h5>
                <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage banned users</p>
                <p style="color:#6b7280; margin:0.5rem 0 0 0; font-size:0.75rem; font-style:italic;">Permission Required</p>
              </div>
            </div>
          <% } %>

          <!-- 10-Codes Management -->
          <%
            // Permission logic for managing 10-codes (same as manage community settings)
            let canManageTenCodes = false;
            if (userId && community.community && Array.isArray(community.community.roles)) {
              community.community.roles.forEach(function(role) {
                if (Array.isArray(role.members) && role.members.includes(userId)) {
                  if (Array.isArray(role.permissions)) {
                    role.permissions.forEach(function(perm) {
                      if (
                        (perm.name === "administrator" && perm.enabled === true) ||
                        (perm.name === "manage community settings" && perm.enabled === true)
                      ) {
                        canManageTenCodes = true;
                      }
                    });
                  }
                }
              });
            }
            // Also allow community owner
            if (community.community.ownerID === userId) {
              canManageTenCodes = true;
            }
          %>
          
          <% if (canManageTenCodes) { %>
            <!-- User has permission to manage 10-codes -->
            <div id="tenCodesCard" onclick="openTenCodesModal()" style="background:#2d3748; border:1px solid #4a5568; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; hover:border-color:#f59e0b;">
              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-bullhorn" style="font-size:2rem; color:#f59e0b;"></i>
                </div>
                <h5 style="color:#fff; margin:0; font-size:1rem; font-weight:600;">10-Codes</h5>
                <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage community 10-codes</p>
              </div>
            </div>
          <% } else { %>
            <!-- User doesn't have permission to manage 10-codes -->
            <div id="tenCodesCard" onclick="showNoTenCodesPermissionModal()" style="background:#1a202c; border:1px solid #2d3748; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; opacity:0.6;">
              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-bullhorn" style="font-size:2rem; color:#6b7280;"></i>
                </div>
                <h5 style="color:#6b7280; margin:0; font-size:1rem; font-weight:600;">10-Codes</h5>
                <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage community 10-codes</p>
                <p style="color:#6b7280; margin:0.5rem 0 0 0; font-size:0.75rem; font-style:italic;">Permission Required</p>
              </div>
            </div>
          <% } %>

          <%
            // Permission logic for viewing audit logs
            let canViewAuditLogs = false;
            if (userId && community.community && Array.isArray(community.community.roles)) {
              community.community.roles.forEach(function(role) {
                if (Array.isArray(role.members) && role.members.includes(userId)) {
                  if (Array.isArray(role.permissions)) {
                    role.permissions.forEach(function(perm) {
                      if (
                        (perm.name === "administrator" && perm.enabled === true) ||
                        (perm.name === "view audit logs" && perm.enabled === true)
                      ) {
                        canViewAuditLogs = true;
                      }
                    });
                  }
                }
              });
            }
            // Also allow community owner
            if (community.community.ownerID === userId) {
              canViewAuditLogs = true;
            }
          %>

          <% if (canViewAuditLogs) { %>
            <div id="toneSettingsCard" onclick="openToneSettingsModal()" style="background:#2d3748; border:1px solid #4a5568; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; position:relative;">
              <% if (new Date() < new Date('2026-04-16')) { %>
                <span style="position:absolute; top:0.5rem; right:0.5rem; background:#7c3aed; color:#fff; font-size:0.65rem; font-weight:700; padding:0.15rem 0.5rem; border-radius:9999px; text-transform:uppercase; letter-spacing:0.05em;">Beta</span>
              <% } %>
              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-volume-high" style="font-size:2rem; color:#a855f7;"></i>
                </div>
                <h5 style="color:#fff; margin:0; font-size:1rem; font-weight:600;">Sound Settings</h5>
                <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage community alert sounds</p>
              </div>
            </div>
          <% } %>

          <% if (canViewAuditLogs) { %>
            <div id="auditLogsCard" onclick="openAuditLogsModal()" style="background:#2d3748; border:1px solid #4a5568; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; hover:border-color:#6366f1; position:relative;">
              <% if (new Date() < new Date('2026-03-20')) { %>
                <span style="position:absolute; top:0.5rem; right:0.5rem; background:#4f46e5; color:#fff; font-size:0.65rem; font-weight:700; padding:0.15rem 0.5rem; border-radius:9999px; text-transform:uppercase; letter-spacing:0.05em;">Beta</span>
              <% } %>
              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-clipboard-list" style="font-size:2rem; color:#6366f1;"></i>
                </div>
                <h5 style="color:#fff; margin:0; font-size:1rem; font-weight:600;">Audit Logs</h5>
                <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">View community activity log</p>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Action Buttons -->
        <div style="display:flex; gap:1rem; justify-content:center; padding-top:1rem; border-top:1px solid #35385a;">
          <% 
            let isOwner = false;
            if (user && user._doc && community.community && community.community.ownerID) {
              isOwner = String(community.community.ownerID) === String(user._doc._id);
            }
          %>
          <% if (!isOwner) { %>
          <button onclick="openLeaveCommunityModal()" 
                  style="background:#f59e0b; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1rem;">
            <i class="fa fa-sign-out-alt" style="margin-right:0.5rem;"></i>
            Leave Community
          </button>
          <% } else { %>
          <button onclick="openOwnerCannotLeaveModal()" 
                  style="background:#6b7280; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1rem; opacity:0.6;">
            <i class="fa fa-sign-out-alt" style="margin-right:0.5rem;"></i>
            Leave Community
          </button>
          <% } %>
          
          <% if (isOwner) { %>
          <button onclick="openDeleteCommunityModal()" 
                  style="background:#ef4444; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1rem;">
            <i class="fa fa-trash" style="margin-right:0.5rem;"></i>
            Delete Community
          </button>
          <% } %>
        </div>

        <!-- Error/Success Messages -->
        <div id="settingsError" style="display:none; background:#991b1b; color:#fecaca; padding:1rem; border-radius:8px; margin-top:1rem; text-align:center;"></div>
        <div id="settingsSuccess" style="display:none; background:#065f46; color:#d1fae5; padding:1rem; border-radius:8px; margin-top:1rem; text-align:center;"></div>
      </div>
    </div>

    <!-- Delete Community Modal -->
    <div id="deleteCommunityModal" class="heroui-modal" style="display:none; position:fixed; z-index:2000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
      <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:500px; width:90%; position:relative; border:1px solid #35385a;">
        <button onclick="closeDeleteCommunityModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
        
        <div style="text-align:center; margin-bottom:1.5rem;">
          <i class="fa fa-exclamation-triangle" style="font-size:3rem; color:#ef4444; margin-bottom:1rem;"></i>
          <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Delete Community</h3>
        </div>
        
        <div style="color:#a0aec0; text-align:center; padding:1rem; margin-bottom:1.5rem;">
          <p style="font-size:1.125rem; margin-bottom:1rem;"><strong style="color:#fff;"><%- community && community.community && community.community.name ? community.community.name.replace(/</g, '&lt;') : 'This community' %></strong> will be permanently deleted on <strong style="color:#fff;" id="deleteCommunityScheduledDate">in 30 days</strong>.</p>
          <p style="font-size:1rem; color:#fca5a5;">After that, all civilians, departments, calls, and settings are gone for good. Contact support before then if you change your mind.</p>
        </div>
        
        <div style="margin-top:2rem; display:flex; gap:1rem; justify-content:center;">
          <button onclick="closeDeleteCommunityModal()" type="button" style="background:#35385a; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1.125rem;">
            Cancel
          </button>
          <button onclick="confirmDeleteCommunity()" type="button" style="background:#ef4444; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1.125rem;">
            Delete Community
          </button>
        </div>
      </div>
    </div>

    <div id="inviteModal" class="heroui-modal" style="display:none; position:fixed; z-index:2000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
      <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:500px; width:90%; position:relative; border:1px solid #35385a;">
        <button id="inviteModalClose" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
        
        <div style="text-align:center; margin-bottom:1.5rem;">
          <i class="fa fa-user-plus" style="font-size:3rem; color:#10b981; margin-bottom:1rem;"></i>
          <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">Invite Members</h3>
        </div>
        
        <div style="color:#a0aec0; text-align:center; padding:1rem;">
          <p style="font-size:1.125rem;">Member invitation features coming soon...</p>
        </div>
        
        <div style="margin-top:2rem; text-align:center;">
          <button id="inviteModalCancel" type="button" style="background:#35385a; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1.125rem;">
            Close
          </button>
        </div>
      </div>
    </div>

    <!-- General Settings Modal -->
    <div id="generalSettingsModal" class="heroui-modal" style="display:none; position:fixed; z-index:2000; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.65); align-items:center; justify-content:center;">
      <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:600px; width:90%; position:relative; border:1px solid #35385a; max-height:90vh; overflow-y:auto;">
        <button onclick="closeGeneralSettingsModal()" aria-label="Close" style="position:absolute; top:1.2rem; right:1.2rem; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>
        
        <div style="text-align:center; margin-bottom:1.5rem;">
          <i class="fa fa-cogs" style="font-size:3rem; color:#3b82f6; margin-bottom:1rem;"></i>
          <h3 style="color:#fff; margin:0; font-size:1.5rem; font-weight:600;">General Settings</h3>
          <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:1rem;">Configure community options and preferences</p>
        </div>
        
        <!-- Civilian Creation Limits Section -->
        <div style="margin-bottom:2rem; padding:1.5rem; background:#2d3748; border-radius:12px; border:1px solid #4a5568;">
          <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem;">
            <i class="fa fa-users" style="font-size:1.5rem; color:#10b981;"></i>
            <h4 style="color:#fff; margin:0; font-size:1.125rem; font-weight:600;">Civilian Creation Limits</h4>
          </div>
          <p style="color:#a0aec0; margin-bottom:1rem; font-size:0.875rem;">Control how many civilians each user can create in this community</p>
          
          <div style="background:#1e3a8a; padding:1rem; border-radius:8px; margin:1rem 0; border-left:4px solid #3b82f6;">
            <p style="margin:0; color:#93c5fd; font-size:0.875rem;">
              <i class="fa fa-info-circle" style="color:#3b82f6; margin-right:0.5rem;"></i>
              <strong>Note:</strong> Community administrators can bypass these limits and create unlimited civilians.
            </p>
          </div>
          
          <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem;">
            <label style="display:flex; align-items:center; gap:0.5rem; color:#fff; font-weight:500; cursor:pointer;">
              <input type="checkbox" id="enableCivilianLimits" style="width:1.25rem; height:1.25rem; accent-color:#3b82f6;">
              Enable civilian creation limits
            </label>
          </div>
          
          <div id="civilianLimitsOptions" style="display:none; padding:1rem; background:#1a202c; border-radius:8px; border:1px solid #4a5568;">
            <label style="display:block; color:#fff; margin-bottom:0.5rem; font-weight:500; font-size:0.875rem;">
              Maximum civilians per user in this community:
            </label>
            <input type="number" id="maxCiviliansPerDept" min="1" max="100" value="5" 
                   style="width:100%; padding:0.75rem; background:#2d3748; border:1px solid #4a5568; border-radius:6px; color:#fff; font-size:1rem; transition: border-color 0.2s ease;"
                   oninput="validateMaxCiviliansInput(this)">
            <div id="maxCiviliansError" style="display:none; color:#ef4444; margin:0.5rem 0 0 0; font-size:0.75rem; font-weight:500;">
              <i class="fa fa-exclamation-circle" style="margin-right:0.25rem;"></i>
              <span id="maxCiviliansErrorText"></span>
            </div>
            <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.75rem;">Set to 1-100. Users will be limited to creating this many civilians in this community.</p>
          </div>
        </div>
        
        <!-- Vehicle Creation Limits Section -->
        <div style="margin-bottom:2rem; padding:1.5rem; background:#2d3748; border-radius:12px; border:1px solid #4a5568;">
          <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem;">
            <i class="fa fa-car" style="font-size:1.5rem; color:#3b82f6;"></i>
            <h4 style="color:#fff; margin:0; font-size:1.125rem; font-weight:600;">Vehicle Creation Limits</h4>
          </div>
          <p style="color:#a0aec0; margin-bottom:1rem; font-size:0.875rem;">Control how many vehicles each user can create in this community</p>
          
          <div style="background:#1e3a8a; padding:1rem; border-radius:8px; margin:1rem 0; border-left:4px solid #3b82f6;">
            <p style="margin:0; color:#93c5fd; font-size:0.875rem;">
              <i class="fa fa-info-circle" style="color:#3b82f6; margin-right:0.5rem;"></i>
              <strong>Note:</strong> Community administrators can bypass these limits and create unlimited vehicles.
            </p>
          </div>
          
          <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem;">
            <label style="display:flex; align-items:center; gap:0.5rem; color:#fff; font-weight:500; cursor:pointer;">
              <input type="checkbox" id="enableVehicleLimits" style="width:1.25rem; height:1.25rem; accent-color:#3b82f6;">
              Enable vehicle creation limits
            </label>
          </div>
          
          <div id="vehicleLimitsOptions" style="display:none; padding:1rem; background:#1a202c; border-radius:8px; border:1px solid #4a5568;">
            <label style="display:block; color:#fff; margin-bottom:0.5rem; font-weight:500; font-size:0.875rem;">
              Maximum vehicles per user in this community:
            </label>
            <input type="number" id="maxVehiclesPerDept" min="1" max="100" value="5" 
                   style="width:100%; padding:0.75rem; background:#2d3748; border:1px solid #4a5568; border-radius:6px; color:#fff; font-size:1rem; transition: border-color 0.2s ease;"
                   oninput="validateMaxVehiclesInput(this)">
            <div id="maxVehiclesError" style="display:none; color:#ef4444; margin:0.5rem 0 0 0; font-size:0.75rem; font-weight:500;">
              <i class="fa fa-exclamation-circle" style="margin-right:0.25rem;"></i>
              <span id="maxVehiclesErrorText"></span>
            </div>
            <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.75rem;">Set to 1-100. Users will be limited to creating this many vehicles in this community.</p>
          </div>
        </div>
        
        <!-- Firearm Creation Limits Section -->
        <div style="margin-bottom:2rem; padding:1.5rem; background:#2d3748; border-radius:12px; border:1px solid #4a5568;">
          <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem;">
            <i class="fa fa-crosshairs" style="font-size:1.5rem; color:#ef4444;"></i>
            <h4 style="color:#fff; margin:0; font-size:1.125rem; font-weight:600;">Firearm Creation Limits</h4>
          </div>
          <p style="color:#a0aec0; margin-bottom:1rem; font-size:0.875rem;">Control how many firearms each user can create in this community</p>
          
          <div style="background:#1e3a8a; padding:1rem; border-radius:8px; margin:1rem 0; border-left:4px solid #3b82f6;">
            <p style="margin:0; color:#93c5fd; font-size:0.875rem;">
              <i class="fa fa-info-circle" style="color:#3b82f6; margin-right:0.5rem;"></i>
              <strong>Note:</strong> Community administrators can bypass these limits and create unlimited firearms.
            </p>
          </div>
          
          <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem;">
            <label style="display:flex; align-items:center; gap:0.5rem; color:#fff; font-weight:500; cursor:pointer;">
              <input type="checkbox" id="enableFirearmLimits" style="width:1.25rem; height:1.25rem; accent-color:#3b82f6;">
              Enable firearm creation limits
            </label>
          </div>
          
          <div id="firearmLimitsOptions" style="display:none; padding:1rem; background:#1a202c; border-radius:8px; border:1px solid #4a5568;">
            <label style="display:block; color:#fff; margin-bottom:0.5rem; font-weight:500; font-size:0.875rem;">
              Maximum firearms per user in this community:
            </label>
            <input type="number" id="maxFirearmsPerDept" min="1" max="100" value="5" 
                   style="width:100%; padding:0.75rem; background:#2d3748; border:1px solid #4a5568; border-radius:6px; color:#fff; font-size:1rem; transition: border-color 0.2s ease;"
                   oninput="validateMaxFirearmsInput(this)">
            <div id="maxFirearmsError" style="display:none; color:#ef4444; margin:0.5rem 0 0 0; font-size:0.75rem; font-weight:500;">
              <i class="fa fa-exclamation-circle" style="margin-right:0.25rem;"></i>
              <span id="maxFirearmsErrorText"></span>
            </div>
            <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.75rem;">Set to 1-100. Users will be limited to creating this many firearms in this community.</p>
          </div>
        </div>
        
        <!-- Civilian Approval Section -->
        <div style="margin-bottom:2rem; padding:1.5rem; background:#2d3748; border-radius:12px; border:1px solid #4a5568;">
          <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem;">
            <i class="fa fa-check-circle" style="font-size:1.5rem; color:#f59e0b;"></i>
            <h4 style="color:#fff; margin:0; font-size:1.125rem; font-weight:600;">Civilian Approval System</h4>
          </div>
          <p style="color:#a0aec0; margin-bottom:1rem; font-size:0.875rem;">Require approval before civilians appear in the community</p>
          
          <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem;">
            <label style="display:flex; align-items:center; gap:0.5rem; color:#fff; font-weight:500; cursor:pointer;">
              <input type="checkbox" id="enableCivilianApproval" style="width:1.25rem; height:1.25rem; accent-color:#3b82f6;">
              Enable civilian approval system
            </label>
          </div>
          
          <div id="civilianApprovalInfo" style="display:none; background:#1e3a8a; padding:1rem; border-radius:8px; margin:1rem 0; border-left:4px solid #3b82f6;">
            <p style="margin:0; color:#93c5fd; font-size:0.875rem;">
              <i class="fa fa-info-circle" style="color:#3b82f6; margin-right:0.5rem;"></i>
              When enabled, newly created civilians will have "requested_review" status and require approval from community administrators before appearing in the community.
            </p>
          </div>
        </div>


        <!-- Warrant Approval Mode Section -->
        <div style="margin-bottom:2rem; padding:1.5rem; background:#2d3748; border-radius:12px; border:1px solid #4a5568;">
          <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem;">
            <i class="fa fa-gavel" style="font-size:1.5rem; color:#8b5cf6;"></i>
            <h4 style="color:#fff; margin:0; font-size:1.125rem; font-weight:600;">Warrant Approval Mode</h4>
          </div>
          <p style="color:#a0aec0; margin-bottom:1rem; font-size:0.875rem;">Configure how warrant requests are processed in this community</p>

          <div style="display:flex; flex-direction:column; gap:0.75rem;">
            <label style="display:flex; align-items:center; gap:0.5rem; color:#fff; font-weight:500; cursor:pointer;">
              <input type="radio" name="warrantApprovalMode" value="auto-approve" style="width:1.25rem; height:1.25rem; accent-color:#3b82f6;" onchange="toggleWarrantApprovalSlider()">
              Auto-Approve
            </label>
            <p style="color:#a0aec0; margin:0 0 0 1.75rem; font-size:0.8rem;">All warrant requests are automatically approved. Best for communities without a judicial department.</p>

            <label style="display:flex; align-items:center; gap:0.5rem; color:#fff; font-weight:500; cursor:pointer;">
              <input type="radio" name="warrantApprovalMode" value="random" style="width:1.25rem; height:1.25rem; accent-color:#3b82f6;" onchange="toggleWarrantApprovalSlider()">
              Random
            </label>
            <p style="color:#a0aec0; margin:0 0 0 1.75rem; font-size:0.8rem;">A random judge will approve or deny the warrant.</p>
            <div id="warrantApprovalSliderContainer" style="display:none; margin:0.5rem 0 0.75rem 1.75rem; padding:0.75rem 1rem; background:#1a1b2e; border-radius:8px; max-width:320px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.375rem;">
                <label style="color:#a0aec0; font-size:0.8rem; font-weight:500;">Approval Rate</label>
                <span id="warrantApprovalRateValue" style="color:#3b82f6; font-weight:700; font-size:0.9rem;">70%</span>
              </div>
              <input type="range" id="warrantRandomApprovalRate" min="0" max="100" value="70" step="5"
                style="width:100%; accent-color:#3b82f6; cursor:pointer;"
                oninput="document.getElementById('warrantApprovalRateValue').textContent = this.value + '%'">
              <div style="display:flex; justify-content:space-between; margin-top:0.25rem;">
                <span style="color:#6b7280; font-size:0.7rem;">0%</span>
                <span style="color:#6b7280; font-size:0.7rem;">50%</span>
                <span style="color:#6b7280; font-size:0.7rem;">100%</span>
              </div>
            </div>

            <label style="display:flex; align-items:center; gap:0.5rem; color:#fff; font-weight:500; cursor:pointer;">
              <input type="radio" name="warrantApprovalMode" value="require-judge" style="width:1.25rem; height:1.25rem; accent-color:#3b82f6;" onchange="toggleWarrantApprovalSlider()">
              Require Judge
            </label>
            <p style="color:#a0aec0; margin:0 0 0 1.75rem; font-size:0.8rem;">Warrants require manual approval from a judge in a Judicial department.</p>
          </div>
        </div>

        <div style="margin-top:2rem; display:flex; gap:1rem; justify-content:center;">
          <button onclick="closeGeneralSettingsModal()" type="button" style="background:#35385a; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1.125rem;">
            Cancel
          </button>
          <button onclick="saveGeneralSettings()" type="button" style="background:#3b82f6; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.5rem; font-weight:500; cursor:pointer; font-size:1.125rem;">
            Save Settings
          </button>
        </div>

        <!-- Loading Overlay -->
        <div id="generalSettingsLoading" style="display:none; position:absolute; top:0; left:0; right:0; bottom:0; background:rgba(30,32,44,0.9); border-radius:16px; display:flex; align-items:center; justify-content:center; z-index:20;">
          <div style="text-align:center;">
            <div class="loading-spinner" style="width:60px; height:60px; border:4px solid #4a5568; border-top:4px solid #3b82f6; border-radius:50%; animation:spin 1s linear infinite; margin:0 auto 1rem;"></div>
            <p style="color:#fff; margin:0; font-size:1rem;">Loading general settings...</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================= -->
    <!-- RP Server Promotion modal — owner/admin posts a structured     -->
    <!-- recruitment post to the shared LPC Discord rp-servers channel. -->
    <!-- ============================================================= -->
    <style>
      .promo-field { margin-bottom:1.1rem; }
      .promo-label { display:block; color:#fff; font-weight:600; font-size:0.85rem; margin-bottom:0.4rem; }
      .promo-hint { color:#8b93a7; font-size:0.72rem; margin-top:0.3rem; }
      .promo-input, .promo-textarea, .promo-select {
        width:100%; padding:0.6rem 0.7rem; background:#2d3748; border:1px solid #4a5568;
        border-radius:8px; color:#fff; font-size:0.9rem; box-sizing:border-box; transition:border-color 0.15s ease;
      }
      .promo-input:focus, .promo-textarea:focus, .promo-select:focus { outline:none; border-color:#5865f2; }
      .promo-textarea { resize:vertical; min-height:88px; }
      .promo-chk-row { display:flex; flex-wrap:wrap; gap:0.5rem; }
      .promo-chk {
        display:flex; align-items:center; gap:0.4rem; padding:0.5rem 0.8rem; background:#2d3748;
        border:1px solid #4a5568; border-radius:999px; color:#cbd5e1; font-size:0.8rem; cursor:pointer;
        transition:all 0.15s ease; min-height:38px;
      }
      .promo-chk:hover { border-color:#5865f2; }
      .promo-chk:has(input:checked) { background:#5865f233; border-color:#5865f2; color:#fff; }
      .promo-chk input { accent-color:#5865f2; }
      .promo-tag-row { display:flex; gap:0.4rem; }
      .promo-tags { display:flex; flex-wrap:wrap; gap:0.4rem; margin-top:0.5rem; }
      .promo-tag {
        display:inline-flex; align-items:center; gap:0.4rem; background:#3a3f56; color:#e2e8f0;
        border-radius:6px; padding:0.3rem 0.55rem; font-size:0.78rem;
      }
      .promo-tag button { background:none; border:none; color:#9aa3b8; cursor:pointer; padding:0 0 0 0.1rem; font-size:0.95rem; line-height:1; }
      .promo-tag button:hover { color:#ef4444; }
      .promo-add-btn {
        flex-shrink:0; background:#3a3f56; color:#fff; border:none; border-radius:8px;
        padding:0 0.95rem; cursor:pointer; font-size:0.9rem; min-height:38px; transition:background 0.15s ease;
      }
      .promo-add-btn:hover { background:#4b5168; }
      /* Discord-style live preview */
      .promo-embed {
        background:#2b2d31; border-radius:6px; border-left:4px solid #5865f2;
        padding:0.85rem 1rem; color:#dbdee1; font-size:0.85rem;
      }
      .promo-embed-title { color:#fff; font-weight:700; font-size:1rem; margin:0 0 0.35rem; word-break:break-word; }
      .promo-embed-title a { color:#00a8fc; text-decoration:none; }
      .promo-embed-desc { white-space:pre-wrap; word-break:break-word; margin:0 0 0.6rem; color:#dbdee1; }
      .promo-embed-field { margin:0.5rem 0; }
      .promo-embed-inline { display:flex; gap:1.6rem; flex-wrap:wrap; }
      .promo-embed-field.pf-inline { flex:1 1 40%; min-width:110px; }
      .promo-embed-field .pf-name { color:#fff; font-weight:600; font-size:0.78rem; margin-bottom:0.15rem; }
      .promo-embed-field .pf-val { color:#c9cdd4; font-size:0.82rem; white-space:pre-wrap; word-break:break-word; }
      .promo-embed-img { margin-top:0.6rem; border-radius:4px; max-width:100%; max-height:200px; object-fit:cover; }
      .promo-embed-footer { color:#949ba4; font-size:0.7rem; margin-top:0.6rem; }
      .promo-grid { display:grid; grid-template-columns:1fr; gap:1.5rem; }
      .promo-thumb { width:54px; height:54px; border-radius:6px; object-fit:cover; border:1px solid #4a5568; }
      @keyframes promoSpin { to { transform:rotate(360deg); } }
      .promo-mini-spin {
        width:13px; height:13px; border:2px solid #5b6172; border-top-color:#5865f2;
        border-radius:50%; display:inline-block; animation:promoSpin 0.7s linear infinite;
      }
      .promo-uploading { color:#cbd5e1; }
      /* Tabs */
      .promo-tabs {
        display:flex; gap:0.3rem; padding:0.3rem; background:#16171d; border:1px solid #2c2f3a;
        border-radius:12px; margin-bottom:1.4rem;
      }
      .promo-tab {
        flex:1; display:flex; align-items:center; justify-content:center; gap:0.45rem;
        padding:0.6rem 0.5rem; background:none; border:none; border-radius:9px; cursor:pointer;
        color:#8b93a7; font-size:0.86rem; font-weight:600; transition:all 0.15s ease; min-height:42px;
      }
      .promo-tab:hover { color:#cbd5e1; }
      .promo-tab.active { background:#5865f2; color:#fff; box-shadow:0 2px 10px rgba(88,101,242,0.35); }
      .promo-tab-count {
        font-size:0.7rem; font-weight:700; padding:0.05rem 0.4rem; border-radius:999px;
        background:rgba(255,255,255,0.16);
      }
      /* History */
      .promo-hist-card {
        border:1px solid #2c2f3a; border-left-width:4px; border-radius:10px; background:#23252f;
        margin-bottom:0.7rem; overflow:hidden; transition:border-color 0.15s ease;
        animation:promoFade 0.35s ease both;
      }
      .promo-hist-card:hover { border-color:#5865f2; }
      .promo-hist-head {
        display:flex; align-items:center; gap:0.8rem; padding:0.85rem 1rem; cursor:pointer;
      }
      .promo-hist-head .ph-name { color:#fff; font-weight:700; font-size:0.92rem; margin:0; word-break:break-word; }
      .promo-hist-head .ph-meta { color:#8b93a7; font-size:0.74rem; margin:0.15rem 0 0; }
      .promo-hist-body .ph-posted-by { color:#8b93a7; font-size:0.78rem; margin:0.7rem 0 0; }
      .promo-hist-body .ph-posted-by strong { color:#cbd5e1; font-weight:600; }
      .promo-hist-chevron { color:#8b93a7; transition:transform 0.2s ease; flex-shrink:0; }
      .promo-hist-card.open .promo-hist-chevron { transform:rotate(180deg); }
      .promo-tier-chip {
        flex-shrink:0; font-size:0.66rem; font-weight:700; padding:0.18rem 0.5rem; border-radius:999px;
        text-transform:uppercase; letter-spacing:0.03em;
      }
      .promo-hist-body { display:none; padding:0 1rem 1rem; }
      .promo-hist-card.open .promo-hist-body { display:block; }
      .promo-empty { text-align:center; padding:2.5rem 1rem; color:#8b93a7; }
      .promo-empty i { font-size:2.4rem; color:#3a3f56; margin-bottom:0.8rem; }
      @keyframes promoFade { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
      /* Desktop: two columns, preview sticks while the form scrolls */
      @media (min-width:860px) {
        .promo-grid { grid-template-columns:1.05fr 0.95fr; align-items:start; }
        .promo-preview-col { position:sticky; top:0; }
      }
      /* Mobile tightening */
      @media (max-width:560px) {
        .promo-modal-panel { padding:1.15rem !important; }
        .promo-footer-row { flex-direction:column-reverse; }
        .promo-footer-row > button { width:100%; }
      }
    </style>
    <div id="promoteModal" class="heroui-modal" style="display:none; position:fixed; z-index:2000; left:0; top:0; width:100vw; height:100vh; background:rgba(20,21,28,0.78); align-items:center; justify-content:center; overflow-y:auto; padding:1rem; box-sizing:border-box;">
      <div class="promo-modal-panel" style="background:#1e2028; border-radius:16px; padding:1.75rem; max-width:980px; width:96%; position:relative; border:1px solid #35385a; max-height:92vh; overflow-y:auto;">
        <button id="promoteModalClose" aria-label="Close" style="position:absolute; top:1.1rem; right:1.1rem; background:none; border:none; color:#fff; font-size:1.4rem; cursor:pointer; opacity:0.7;"><i class="fa fa-times"></i></button>

        <div style="text-align:center; margin-bottom:1.25rem;">
          <i class="fa-brands fa-discord" style="font-size:2.6rem; color:#5865f2;"></i>
          <h3 style="color:#fff; margin:0.4rem 0 0; font-size:1.4rem; font-weight:700;">Promote Your Community</h3>
          <p style="color:#a0aec0; margin:0.35rem 0 0; font-size:0.9rem;">Post a recruitment listing to the Lines Police CAD Discord. One post per community every <span id="promoCooldownLabel">24</span> hours.</p>
          <div id="promoTierBadge" style="margin-top:0.7rem;"></div>
        </div>

        <!-- Cooldown / status banner -->
        <div id="promoCooldownBanner" style="display:none; background:#3a2d12; border:1px solid #b45309; border-left:4px solid #f59e0b; border-radius:8px; padding:0.8rem 1rem; margin-bottom:1.25rem;">
          <p style="margin:0; color:#fcd34d; font-size:0.85rem;">
            <i class="fa fa-clock" style="margin-right:0.4rem;"></i>
            <span id="promoCooldownText">This community already promoted recently.</span>
            <a id="promoCooldownLink" target="_blank" rel="noopener" style="display:none; margin-left:0.5rem; color:#fcd34d; font-weight:700; text-decoration:underline; white-space:nowrap;"><i class="fa-brands fa-discord" style="margin-right:0.3rem;"></i>View the post</a>
          </p>
        </div>

        <!-- Not-configured banner -->
        <div id="promoUnconfiguredBanner" style="display:none; background:#3a1d1d; border:1px solid #b91c1c; border-left:4px solid #ef4444; border-radius:8px; padding:0.8rem 1rem; margin-bottom:1.25rem;">
          <p style="margin:0; color:#fca5a5; font-size:0.85rem;">
            <i class="fa fa-triangle-exclamation" style="margin-right:0.4rem;"></i>
            Discord promotion isn't available right now. Please try again later.
          </p>
        </div>

        <!-- Tab bar -->
        <div class="promo-tabs" role="tablist">
          <button type="button" id="promoTabBtnCreate" class="promo-tab active" role="tab" onclick="switchPromoTab('create')">
            <i class="fa fa-pen-nib"></i><span class="promo-tab-label">New post</span>
          </button>
          <button type="button" id="promoTabBtnHistory" class="promo-tab" role="tab" onclick="switchPromoTab('history')">
            <i class="fa fa-clock-rotate-left"></i><span class="promo-tab-label">History</span>
            <span id="promoHistoryCount" class="promo-tab-count" style="display:none;">0</span>
          </button>
        </div>

        <!-- ===== TAB: Create ===== -->
        <div id="promoTabCreate">
        <div class="promo-grid">
          <!-- ---- LEFT: structured form ---- -->
          <div>
            <div class="promo-field">
              <label class="promo-label" for="promoServerName">Server name</label>
              <input type="text" id="promoServerName" class="promo-input" maxlength="100" placeholder="e.g. Georgia State Roleplay Network" oninput="renderPromoPreview()">
            </div>

            <div class="promo-field">
              <label class="promo-label">Platforms</label>
              <div class="promo-chk-row" id="promoPlatforms">
                <% /* Mirror the community-settings platform tags (PlayStation / Xbox / PC) so autofill maps 1:1. */ %>
                <% var promoPlatformOpts = ['Xbox','PlayStation','PC']; %>
                <% promoPlatformOpts.forEach(function(p){ %>
                  <label class="promo-chk"><input type="checkbox" value="<%= p %>" onchange="renderPromoPreview()"> <%= p %></label>
                <% }); %>
              </div>
            </div>

            <div class="promo-field">
              <label class="promo-label" for="promoGame">Game</label>
              <select id="promoGame" class="promo-select" onchange="onPromoGameChange()">
