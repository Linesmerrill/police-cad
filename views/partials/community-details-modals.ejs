// Photo upload functionality
let currentPhotoUrl = '';

// Simple toast notification - uses the existing #toast element
function showToast(message, duration, type) {
  duration = duration || 4000;
  type = type || 'info';

  // Auto-extend duration for long messages
  var finalDuration = Math.min(Math.max(duration, message.length * 50), 8000);

  var toast = document.getElementById('toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'toast';
    document.body.appendChild(toast);
  }

  // Color schemes
  var colors = {
    success: { bg: 'rgba(16, 185, 129, 0.95)', border: '#10b981' },
    error: { bg: 'rgba(239, 68, 68, 0.95)', border: '#ef4444' },
    warning: { bg: 'rgba(245, 158, 11, 0.95)', border: '#f59e0b' },
    info: { bg: 'rgba(59, 130, 246, 0.95)', border: '#3b82f6' }
  };
  var color = colors[type] || colors.info;

  toast.style.cssText = 'position:fixed;bottom:32px;left:50%;transform:translateX(-50%);z-index:999999;background:' + color.bg + ';color:#fff;padding:14px 24px;border-radius:12px;font-weight:500;font-size:0.925rem;max-width:90vw;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.3);border:1px solid ' + color.border + ';backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);';
  toast.textContent = message;
  toast.style.display = 'block';

  setTimeout(function() {
    toast.style.display = 'none';
  }, finalDuration);
}

