<div id="deleteEventModal" class="heroui-modal" style="display:none; position:fixed; z-index:3500; left:0; top:0; width:100vw; height:100vh; background:rgba(30,32,44,0.75); align-items:center; justify-content:center;">
  <div style="background:#1e2028; border-radius:16px; padding:2rem; max-width:400px; width:90%; position:relative; border:1px solid #ef4444;">
    <div style="text-align:center; margin-bottom:1.5rem;">
      <div style="width:64px; height:64px; background:rgba(239, 68, 68, 0.1); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem;">
        <i class="fa fa-trash-alt" style="font-size:1.75rem; color:#ef4444;"></i>
      </div>
      <h3 style="color:#fff; margin:0; font-size:1.25rem; font-weight:600;">Delete Event</h3>
      <p style="color:#a0aec0; margin:0.75rem 0 0 0; font-size:0.9rem;">Are you sure you want to delete this event?</p>
      <p id="deleteEventTitle" style="color:#fff; margin:0.5rem 0 0 0; font-size:0.9rem; font-weight:500;"></p>
      <p style="color:#ef4444; margin:0.75rem 0 0 0; font-size:0.8rem;"><i class="fa fa-exclamation-triangle mr-1"></i>This action cannot be undone.</p>
    </div>
    <div id="deleteEventError" class="text-red-400 text-sm mb-3 text-center" style="display:none;"></div>
    <div class="flex justify-center gap-3">
      <button type="button" onclick="closeDeleteEventModal()" class="px-4 py-2 rounded font-semibold transition-colors" style="background:rgba(255,255,255,0.1); color:#fff; border:1px solid rgba(255,255,255,0.2);">
        Cancel
      </button>
      <button type="button" id="confirmDeleteEventBtn" onclick="confirmDeleteEvent()" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded font-semibold transition-colors">
        <i class="fa fa-trash-alt mr-1"></i>Delete
      </button>
    </div>
  </div>
</div>

<script>
let currentEditEvent = null;
let eventToDelete = null;

function openDeleteEventModal() {
  if (!currentEditEvent) return;
  eventToDelete = currentEditEvent;
  const allEvents = window.allEvents || [];
  const event = allEvents.find(e => {
    const eventId = e._id && typeof e._id === 'object' ? (e._id.$oid || e._id.toString()) : String(e._id);
    return eventId === String(eventToDelete);
  });
  const titleEl = document.getElementById('deleteEventTitle');
  if (event && titleEl) {
    titleEl.textContent = '"' + (event.title || 'Untitled Event') + '"';
  }
  document.getElementById('deleteEventError').style.display = 'none';
  document.getElementById('deleteEventModal').style.display = 'flex';
}

function closeDeleteEventModal() {
  document.getElementById('deleteEventModal').style.display = 'none';
  eventToDelete = null;
}

async function confirmDeleteEvent() {
  if (!eventToDelete) return;
  const deleteBtn = document.getElementById('confirmDeleteEventBtn');
  const originalContent = deleteBtn.innerHTML;
  deleteBtn.innerHTML = '<i class="fa fa-spinner fa-spin mr-1"></i>Deleting...';
  deleteBtn.disabled = true;

  const communityID = '<%= community._id %>';
  const eventIdToDelete = eventToDelete; // Store locally before async operation
  try {
    const res = await fetch(`${API_URL}/api/v1/community/${communityID}/events/${eventIdToDelete}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    });
    if (!res.ok) throw new Error('Failed to delete event');
    // Remove the event from the local array BEFORE closing modals
    if (window.allEvents) {
      window.allEvents = window.allEvents.filter(e => {
        const eventId = e._id && typeof e._id === 'object' ? (e._id.$oid || e._id.toString()) : String(e._id);
        return eventId !== String(eventIdToDelete);
      });
    }
    // Reset button state
    deleteBtn.innerHTML = originalContent;
    deleteBtn.disabled = false;
    // Close modals
    closeDeleteEventModal();
    closeEditEventModal();
    // Refresh UI (preserve current page)
    refreshEventsUI(true);
  } catch (err) {
    document.getElementById('deleteEventError').textContent = err.message || 'Failed to delete event.';
    document.getElementById('deleteEventError').style.display = 'block';
    deleteBtn.innerHTML = originalContent;
    deleteBtn.disabled = false;
  }
}

function openEditEventModal(eventId) {
  const allEvents = window.allEvents || [];
  // Helper to extract ID string from various formats
  function getEventIdString(id) {
    if (!id) return '';
    if (typeof id === 'object') return id.$oid || id.toString();
    return String(id);
  }
  const event = allEvents.find(e => getEventIdString(e._id) === String(eventId));
  if (!event) return;
  // Store the actual event ID (extract from object if needed)
  currentEditEvent = getEventIdString(event._id);
  document.getElementById('edit-event-title').value = event.title || '';
  document.getElementById('edit-event-date').value = event.scheduledDate ? new Date(event.scheduledDate).toISOString().slice(0,16) : '';
  document.getElementById('edit-event-location').value = event.location || '';
  document.getElementById('edit-event-description').value = event.description || '';
  document.getElementById('edit-event-required').checked = !!event.required;
  const preview = document.getElementById('edit-event-photo-preview');
  const removeBtn = document.getElementById('edit-event-remove-photo-btn');
  const cameraIcon = document.getElementById('edit-event-camera-icon');
  const uploadText = document.getElementById('edit-event-upload-text');
  if (event.image) {
    preview.src = event.image;
    preview.style.display = 'block';
    removeBtn.style.display = 'inline-block';
    if (cameraIcon) cameraIcon.style.display = 'none';
    if (uploadText) uploadText.style.display = 'none';
  } else {
    preview.src = '';
    preview.style.display = 'none';
    removeBtn.style.display = 'none';
    if (cameraIcon) cameraIcon.style.display = 'block';
    if (uploadText) uploadText.style.display = 'block';
  }
  // Reset file input
  document.getElementById('edit-event-photo').value = '';
  // Store whether we want to clear the image
  window.editEventClearImage = false;
  document.getElementById('editEventModal').style.display = 'flex';
}
function closeEditEventModal() {
  document.getElementById('editEventModal').style.display = 'none';
  currentEditEvent = null;
}
function handleEditEventPhotoChange(e) {
  const file = e.target.files[0];
  const preview = document.getElementById('edit-event-photo-preview');
  const removeBtn = document.getElementById('edit-event-remove-photo-btn');
  const cameraIcon = document.getElementById('edit-event-camera-icon');
  const uploadText = document.getElementById('edit-event-upload-text');
  if (file) {
    const reader = new FileReader();
    reader.onload = function(ev) {
      preview.src = ev.target.result;
      preview.style.display = 'block';
      removeBtn.style.display = 'inline-block';
      if (cameraIcon) cameraIcon.style.display = 'none';
      if (uploadText) uploadText.style.display = 'none';
      window.editEventClearImage = false;
    };
    reader.readAsDataURL(file);
  } else {
    preview.src = '';
    preview.style.display = 'none';
    removeBtn.style.display = 'none';
    if (cameraIcon) cameraIcon.style.display = 'block';
    if (uploadText) uploadText.style.display = 'block';
  }
}
function removeEditEventPhoto(e) {
  if (e) e.stopPropagation();
  const preview = document.getElementById('edit-event-photo-preview');
  const removeBtn = document.getElementById('edit-event-remove-photo-btn');
  const cameraIcon = document.getElementById('edit-event-camera-icon');
  const uploadText = document.getElementById('edit-event-upload-text');
  const photoInput = document.getElementById('edit-event-photo');

  preview.src = '';
  preview.style.display = 'none';
  removeBtn.style.display = 'none';
  if (cameraIcon) cameraIcon.style.display = 'block';
  if (uploadText) uploadText.style.display = 'block';
  if (photoInput) photoInput.value = '';
  // Mark that we want to clear the image
  window.editEventClearImage = true;
}
async function saveEditEvent() {
  if (!currentEditEvent) return;
  const title = document.getElementById('edit-event-title').value.trim();
  const scheduledDate = document.getElementById('edit-event-date').value;
  const location = document.getElementById('edit-event-location').value.trim();
  const description = document.getElementById('edit-event-description').value.trim();
  const required = document.getElementById('edit-event-required').checked;

  // Get the original event to preserve the original image if no new one is uploaded
  const originalEvent = (window.allEvents || []).find(e => {
    // Handle both string IDs and MongoDB ObjectId format
    const eventId = e._id && typeof e._id === 'object' ? (e._id.$oid || e._id.toString()) : String(e._id);
    return eventId === String(currentEditEvent);
  });

  let image = '';
  const photoInput = document.getElementById('edit-event-photo');

  if (!title || !scheduledDate || !location || !description) {
    document.getElementById('editEventError').textContent = 'All fields except image are required.';
    document.getElementById('editEventError').style.display = 'block';
    return;
  }
  document.getElementById('editEventError').style.display = 'none';

  // Upload new image if one was selected, check if cleared, otherwise preserve the original
  if (photoInput && photoInput.files && photoInput.files[0]) {
    try {
      const file = photoInput.files[0];
      image = await uploadToCloudinary(file, 'events', `event_${Date.now()}`);
    } catch (uploadErr) {
      console.error('Image upload failed:', uploadErr);
      document.getElementById('editEventError').textContent = 'Failed to upload image. Please try again.';
      document.getElementById('editEventError').style.display = 'block';
      return;
    }
  } else if (window.editEventClearImage) {
    // User explicitly removed the photo
    image = '';
  } else {
    // Preserve the original image URL from the event data
    image = originalEvent && originalEvent.image ? originalEvent.image : '';
  }

  const payload = {
    title,
    scheduledDate: new Date(scheduledDate).toISOString(),
    image,
    location,
    description,
    required
  };
  const communityID = '<%= community._id %>';

  // Check if this is a locally-created event with a temporary ID
  if (String(currentEditEvent).startsWith('temp_')) {
    document.getElementById('editEventError').textContent = 'This event was just created. Please refresh the page before editing.';
    document.getElementById('editEventError').style.display = 'block';
    return;
  }

  try {
    const res = await fetch(`${API_URL}/api/v1/community/${communityID}/events/${currentEditEvent}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (!res.ok) {
      const errorData = await res.json().catch(() => ({}));
      throw new Error(errorData.message || 'Failed to update event');
    }
    const data = await res.json();
    // Store the event ID before closing the modal (which sets currentEditEvent to null)
    const editedEventId = currentEditEvent;
    closeEditEventModal();
    // Update the event in the local array and refresh UI
    if (window.allEvents && editedEventId) {
      const idx = window.allEvents.findIndex(e => {
        const eventId = e._id && typeof e._id === 'object' ? (e._id.$oid || e._id.toString()) : String(e._id);
        return eventId === String(editedEventId);
      });
      if (idx !== -1) {
        // Use the event returned from the API if available, otherwise construct locally
        if (data.event) {
          window.allEvents[idx] = data.event;
        } else {
          // Fallback: update with local values
          window.allEvents[idx] = {
            ...window.allEvents[idx],
            title,
            scheduledDate: new Date(scheduledDate).toISOString(),
            image,
            location,
            description,
            required,
            updatedAt: new Date().toISOString()
          };
        }
      }
      // Refresh UI (preserve current page for edits)
      refreshEventsUI(true);
    }
  } catch (err) {
    document.getElementById('editEventError').textContent = err.message || 'Failed to update event.';
    document.getElementById('editEventError').style.display = 'block';
  }
}
</script>

