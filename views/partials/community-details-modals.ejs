      function triggerDownload(content, filename, mimeType) {
        var blob = new Blob([content], { type: mimeType });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      function exportPenalCodesJSON() {
        syncPcCategoryNames();
        var payload = {
          categories: pcSettingsData,
          currency: pcSettingsCurrency,
          currencies: pcSettingsCurrencies
        };
        triggerDownload(JSON.stringify(payload, null, 2), 'penal-codes.json', 'application/json');
        showCustomToast('Penal codes exported as JSON', 'success');
      }

      function exportPenalCodesCSV() {
        syncPcCategoryNames();
        var rows = [['category_id', 'category_name', 'subtitle', 'icon', 'color', 'violation_name', 'jail_time', 'fine', 'explanation']];
        (pcSettingsData || []).forEach(function(cat) {
          (cat.violations || []).forEach(function(v) {
            rows.push([
              cat.id || '', cat.name || '', cat.subtitle || '', cat.icon || '', cat.color || '',
              v.name || '', v.jailTime || '', String(v.fine || 0), v.explanation || ''
            ]);
          });
        });
        var csv = rows.map(function(row) {
          return row.map(function(cell) {
            var s = String(cell).replace(/"/g, '""');
            return (s.indexOf(',') >= 0 || s.indexOf('"') >= 0 || s.indexOf('\n') >= 0) ? '"' + s + '"' : s;
          }).join(',');
        }).join('\n');
        triggerDownload(csv, 'penal-codes.csv', 'text/csv');
        showCustomToast('Penal codes exported as CSV', 'success');
      }

      function importPenalCodesFile(input) {
        var file = input.files[0];
        if (!file) return;
        input.value = ''; // Reset so same file can be picked again

        var reader = new FileReader();
        reader.onload = function(e) {
          var text = e.target.result;
          var isCSV = file.name.toLowerCase().endsWith('.csv');

          try {
            var parsed;
            if (isCSV) {
              parsed = parsePenalCodesCSV(text);
            } else {
              parsed = parsePenalCodesJSON(text);
            }

            showCustomConfirm(
              'Import Penal Codes',
              'This will replace all current penal codes with ' + countPcViolations(parsed.categories) + ' violations across ' + parsed.categories.length + ' categories. Continue?',
              function() {
                pcSettingsData = parsed.categories;
                if (parsed.currency) pcSettingsCurrency = parsed.currency;
                if (parsed.currencies && parsed.currencies.length > 0) pcSettingsCurrencies = parsed.currencies;
                updatePcCurrencyDisplay();
                renderPcCategories(pcSettingsData);
                showCustomToast('Penal codes imported. Click "Save Changes" to persist.', 'success');
              }
            );
          } catch (err) {
            showCustomToast('Import error: ' + err.message, 'error');
          }
        };
        reader.readAsText(file);
      }

      function countPcViolations(categories) {
        var count = 0;
        (categories || []).forEach(function(cat) { count += (cat.violations || []).length; });
        return count;
      }

      function parsePenalCodesJSON(text) {
        var data = JSON.parse(text);
        if (!data.categories || !Array.isArray(data.categories)) {
          throw new Error('JSON must contain a "categories" array');
        }
        data.categories.forEach(function(cat, i) {
          if (!cat.name) throw new Error('Category at index ' + i + ' is missing a name');
          if (!cat.id) cat.id = cat.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          if (!cat.violations) cat.violations = [];
          if (!cat.columns) cat.columns = ['name', 'jailTime', 'fine', 'explanation'];
        });
        return data;
      }

      function parsePenalCodesCSV(text) {
        var lines = parseCSVLines(text);
        if (lines.length < 2) throw new Error('CSV must have a header row and at least one data row');

        var header = lines[0].map(function(h) { return h.trim().toLowerCase(); });
        var catIdIdx = header.indexOf('category_id');
        var catNameIdx = header.indexOf('category_name');
        var subtitleIdx = header.indexOf('subtitle');
        var iconIdx = header.indexOf('icon');
        var colorIdx = header.indexOf('color');
        var violNameIdx = header.indexOf('violation_name');
        var jailIdx = header.indexOf('jail_time');
        var fineIdx = header.indexOf('fine');
        var explIdx = header.indexOf('explanation');

        if (violNameIdx < 0) throw new Error('CSV must have a "violation_name" column');

        var categoryMap = {};
        var categoryOrder = [];

        for (var i = 1; i < lines.length; i++) {
          var row = lines[i];
          if (row.length === 0 || (row.length === 1 && row[0].trim() === '')) continue;

          var catId = (catIdIdx >= 0 ? row[catIdIdx] : '').trim();
          var catName = (catNameIdx >= 0 ? row[catNameIdx] : '').trim();
          if (!catId && catName) catId = catName.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          if (!catId) catId = 'imported';
          if (!catName) catName = catId;

          if (!categoryMap[catId]) {
            categoryMap[catId] = {
              id: catId,
              name: catName,
              subtitle: subtitleIdx >= 0 ? (row[subtitleIdx] || '').trim() : '',
              icon: iconIdx >= 0 ? (row[iconIdx] || '').trim() : 'fa-gavel',
              color: colorIdx >= 0 ? (row[colorIdx] || '').trim() : '#8b5cf6',
              columns: ['name', 'jailTime', 'fine', 'explanation'],
              violations: []
            };
            categoryOrder.push(catId);
          }

          var vName = (violNameIdx >= 0 ? row[violNameIdx] : '').trim();
          if (!vName) continue;

          categoryMap[catId].violations.push({
            name: vName,
            jailTime: jailIdx >= 0 ? (row[jailIdx] || '').trim() : '',
            fine: fineIdx >= 0 ? parseInt(row[fineIdx], 10) || 0 : 0,
            explanation: explIdx >= 0 ? (row[explIdx] || '').trim() : ''
          });
        }

        var categories = categoryOrder.map(function(id) { return categoryMap[id]; });
        if (categories.length === 0) throw new Error('No valid data rows found in CSV');
        return { categories: categories, currency: pcSettingsCurrency, currencies: pcSettingsCurrencies };
      }

      // Robust CSV parser that handles quoted fields with commas and newlines
      function parseCSVLines(text) {
        var lines = [];
        var currentRow = [];
        var currentField = '';
        var inQuotes = false;
        var i = 0;

        while (i < text.length) {
          var ch = text[i];
          if (inQuotes) {
            if (ch === '"') {
              if (i + 1 < text.length && text[i + 1] === '"') {
                currentField += '"';
                i += 2;
              } else {
                inQuotes = false;
                i++;
              }
            } else {
              currentField += ch;
              i++;
            }
          } else {
            if (ch === '"') {
              inQuotes = true;
              i++;
            } else if (ch === ',') {
              currentRow.push(currentField);
              currentField = '';
              i++;
            } else if (ch === '\r' || ch === '\n') {
              currentRow.push(currentField);
              currentField = '';
              lines.push(currentRow);
              currentRow = [];
              if (ch === '\r' && i + 1 < text.length && text[i + 1] === '\n') i++;
              i++;
            } else {
              currentField += ch;
              i++;
            }
          }
        }
        // Last field/row
        if (currentField || currentRow.length > 0) {
          currentRow.push(currentField);
          lines.push(currentRow);
        }
        return lines;
      }

