function openDeleteCommunityModal() {
  // Populate the explicit hard-delete date so the user sees "deleted on
  // Jun 17, 2026" instead of an abstract "in 30 days". Computed client-side;
  // the API confirms the same date in the response.
  try {
    var el = document.getElementById('deleteCommunityScheduledDate');
    if (el) {
      var d = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);
      el.textContent = d.toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' });
    }
