<script>
function openCreateEventModal() {
  document.getElementById('createEventModal').style.display = 'flex';
}
function closeCreateEventModal() {
  document.getElementById('createEventModal').style.display = 'none';
}
function handleEventPhotoChange(e) {
  const file = e.target.files[0];
  const preview = document.getElementById('event-photo-preview');
  if (file) {
    const reader = new FileReader();
    reader.onload = function(ev) {
      preview.src = ev.target.result;
      preview.style.display = 'block';
    };
    reader.readAsDataURL(file);
  } else {
    preview.src = '';
    preview.style.display = 'none';
  }
}
document.getElementById('createEventForm').onsubmit = async function(e) {
  e.preventDefault();
  const title = document.getElementById('event-title').value.trim();
  const scheduledDate = document.getElementById('event-date').value;
  const location = document.getElementById('event-location').value.trim();
  const description = document.getElementById('event-description').value.trim();
  const required = document.getElementById('event-required').checked;
  const communityID = '<%= community._id %>';
  const host = '<%= user && user._doc ? user._doc._id : "" %>';
  let image = '';
  const photoInput = document.getElementById('event-photo');
  if (photoInput && photoInput.files && photoInput.files[0]) {
    // TODO: Upload image to cloud and get URL, for now use a placeholder
    image = 'https://res.cloudinary.com/dqtwwvm7p/image/upload/v1747054441/upload_placeholder.jpg';
  }
  if (!title || !scheduledDate || !location || !description) {
    document.getElementById('createEventError').textContent = 'All fields except image are required.';
    document.getElementById('createEventError').style.display = 'block';
    return;
  }
  document.getElementById('createEventError').style.display = 'none';
  const payload = {
    communityID,
    title,
    scheduledDate: new Date(scheduledDate).toISOString(),
    image,
    location,
    description,
    host,
    coHosts: [],
    required
  };
  try {
    const res = await fetch(`${API_URL}/api/v1/community/${communityID}/events`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (!res.ok) throw new Error('Failed to create event');
    const data = await res.json();
    closeCreateEventModal();
    // Reset form
    document.getElementById('createEventForm').reset();
    document.getElementById('event-photo-preview').style.display = 'none';
    // Use the event returned from the API (includes real _id)
    const newEvent = data.event || {
      // Fallback if API doesn't return event (shouldn't happen)
      _id: 'temp_' + Date.now(),
      title,
      scheduledDate: new Date(scheduledDate).toISOString(),
      image,
      location,
      description,
      host,
      coHosts: [],
      required,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString()
    };
    window.allEvents = window.allEvents || [];
    window.allEvents.push(newEvent);
    // Go to last page to show the new event
    var newTotalPages = Math.max(1, Math.ceil(window.allEvents.length / eventPerPage));
    eventCurrentPage = newTotalPages;
    refreshEventsUI(true);
  } catch (err) {
    document.getElementById('createEventError').textContent = err.message || 'Failed to create event.';
    document.getElementById('createEventError').style.display = 'block';
  }
};
</script> 

