        const totalPages = Math.ceil(communityMembersTotal / communityMembersLimit);
        
        if (totalPages <= 1) {
          paginationDiv.style.display = 'none';
          return;
        }
        
        paginationDiv.style.display = 'flex';
        pageInfo.textContent = `Page ${communityMembersPage} of ${totalPages}`;
        
        prevBtn.disabled = communityMembersPage <= 1;
        prevBtn.style.opacity = communityMembersPage <= 1 ? '0.5' : '1';
        prevBtn.style.cursor = communityMembersPage <= 1 ? 'not-allowed' : 'pointer';
        
        nextBtn.disabled = communityMembersPage >= totalPages;
        nextBtn.style.opacity = communityMembersPage >= totalPages ? '0.5' : '1';
        nextBtn.style.cursor = communityMembersPage >= totalPages ? 'not-allowed' : 'pointer';
