async function deleteInviteCode() {
  if (!deleteInviteCodeId) return;

  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

    const response = await fetch(`${apiUrl}/api/v1/invite-code/${deleteInviteCodeId}`, {
      method: 'DELETE'
    });

    if (!response.ok) throw new Error('Failed to delete invite code');

    closeDeleteConfirmModal();
    loadInviteCodes();
    showToast('Invite code deleted', 2000, 'success');
  } catch (error) {
    console.error('Error deleting invite code:', error);
    showToast('Failed to delete invite code', 3000, 'error');
  }
}

</script> 

