<script>
// --- Refresh Departments Grid ---
async function refreshDepartmentsGrid() {
  // Use the pagination-aware fetchDepartmentsPage function from community-details.ejs
  // This preserves the current page and filter state
  if (typeof fetchDepartmentsPage === 'function' && typeof deptCurrentPage !== 'undefined') {
    // Clear the loaded pages cache for the current filter so it refetches
    var filterKey = (typeof deptCurrentFilter !== 'undefined' ? deptCurrentFilter : '') || '';
    if (typeof deptLoadedPages !== 'undefined') {
      deptLoadedPages[filterKey] = {};
    }
    // Fetch the current page (will clear and re-render)
    await fetchDepartmentsPage(deptCurrentPage, true);
    // Re-attach click handlers
    if (typeof initDeptCardClicks === 'function') {
      initDeptCardClicks();
    }
  } else {
    // Fallback: reload the page if pagination functions aren't available
    window.location.reload();
  }
}

// Initialize department card click handlers
function initDeptCardClicks() {
  document.querySelectorAll('.dept-card[data-dept-id]').forEach(card => {
    card.style.cursor = 'pointer';
    card.onclick = function(e) {
      if (e.target.closest('button')) return;
      const deptId = this.getAttribute('data-dept-id');
      const deptName = this.getAttribute('data-dept-name');
      const templateName = this.getAttribute('data-template-name');
      if (typeof handleDepartmentClick === 'function') {
        handleDepartmentClick(deptId, deptName, templateName);
      }
    };
  });
}

// --- Modal State ---
let createDeptData = {
  name: '',
  description: '',
  image: '',
  visibility: 'public',
  template: { name: '', components: [] },
  members: []
};
let createDeptTemplates = [
