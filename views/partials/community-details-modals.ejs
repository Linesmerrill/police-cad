          <button class="audit-filter-chip" data-category="settings" onclick="filterAuditLogs('settings')" style="padding:0.4rem 0.9rem; border-radius:9999px; border:1px solid #4a5568; background:#2d3748; color:#a0aec0; font-size:0.8rem; cursor:pointer;">Settings</button>
          <button class="audit-filter-chip" data-category="invite" onclick="filterAuditLogs('invite')" style="padding:0.4rem 0.9rem; border-radius:9999px; border:1px solid #4a5568; background:#2d3748; color:#a0aec0; font-size:0.8rem; cursor:pointer;">Invites</button>
          <button class="audit-filter-chip" data-category="penal_codes" onclick="filterAuditLogs('penal_codes')" style="padding:0.4rem 0.9rem; border-radius:9999px; border:1px solid #4a5568; background:#2d3748; color:#a0aec0; font-size:0.8rem; cursor:pointer;">Penal Codes</button>
          <button class="audit-filter-chip" data-category="fines" onclick="filterAuditLogs('fines')" style="padding:0.4rem 0.9rem; border-radius:9999px; border:1px solid #4a5568; background:#2d3748; color:#a0aec0; font-size:0.8rem; cursor:pointer;">Fines</button>
          <button class="audit-filter-chip" data-category="ten_codes" onclick="filterAuditLogs('ten_codes')" style="padding:0.4rem 0.9rem; border-radius:9999px; border:1px solid #4a5568; background:#2d3748; color:#a0aec0; font-size:0.8rem; cursor:pointer;">Ten Codes</button>
          <button class="audit-filter-chip" data-category="event" onclick="filterAuditLogs('event')" style="padding:0.4rem 0.9rem; border-radius:9999px; border:1px solid #4a5568; background:#2d3748; color:#a0aec0; font-size:0.8rem; cursor:pointer;">Events</button>
