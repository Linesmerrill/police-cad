                <option value="GTA RP">GTA RP</option>
                <option value="Roblox RP">Roblox RP</option>
                <option value="Red Dead RP">Red Dead RP</option>
                <option value="__other">Other…</option>
              </select>
              <input type="text" id="promoGameOther" class="promo-input" style="display:none; margin-top:0.5rem;" maxlength="60" placeholder="Game name" oninput="renderPromoPreview()">
            </div>

            <div class="promo-field">
              <label class="promo-label" for="promoDescription">Description</label>
              <textarea id="promoDescription" class="promo-textarea" placeholder="Describe your community, the vibe, what makes it worth joining…" oninput="renderPromoPreview()"></textarea>
              <div class="promo-hint"><span id="promoDescCount">0</span> / <span id="promoDescMax">600</span> characters</div>
