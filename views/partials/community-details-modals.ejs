// Fallback function using the existing working format
async function uploadImageWithExistingFormat(file, preset, folder, publicId) {
  // Validate file type
  const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
  if (!allowedTypes.includes(file.type)) {
    throw new Error('Please select a valid image file (JPEG, PNG, GIF, or WebP)');
  }

  // Validate file size (5MB limit)
  const maxSize = 5 * 1024 * 1024; // 5MB in bytes
  if (file.size > maxSize) {
    throw new Error('Image file size must be less than 5MB. Please choose a smaller image.');
  }

  // Create a canvas to resize the image
  const canvas = document.createElement('canvas');
  const ctx = canvas.getContext('2d');
  const imgElement = new Image();

  return new Promise((resolve, reject) => {
    imgElement.onload = function() {
      // Calculate new dimensions (max 800x800, maintain aspect ratio)
      const maxDimension = 800;
      let { width, height } = imgElement;
      
      if (width > height) {
        if (width > maxDimension) {
          height = (height * maxDimension) / width;
          width = maxDimension;
        }
      } else {
        if (height > maxDimension) {
          width = (width * maxDimension) / height;
          height = maxDimension;
        }
      }

      // Set canvas dimensions
      canvas.width = width;
      canvas.height = height;

      // Draw resized image
      ctx.drawImage(imgElement, 0, 0, width, height);

      // Convert to blob
      canvas.toBlob(function(blob) {
        // Create FormData for upload
        const formData = new FormData();
        formData.append('file', blob, 'image.jpg');
        formData.append('upload_preset', preset);
        formData.append('public_id', publicId);
        formData.append('folder', folder);
        
        // Upload to Cloudinary
        const cloudinaryUrl = 'https://api.cloudinary.com/v1_1/dqtwwvm7p/image/upload';
        
        fetch(cloudinaryUrl, {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(data => {
          if (data.error) {
            throw new Error(data.error.message || 'Upload failed');
          }
          resolve(data.secure_url);
        })
        .catch(error => {
          reject(error);
        });
      }, 'image/jpeg', 0.85);
    };

    imgElement.onerror = function() {
      reject(new Error('Failed to load image'));
    };

    imgElement.src = URL.createObjectURL(file);
  });
}

