        const totalPages = Math.ceil(communityMembersTotal / communityMembersLimit);
        
        if (newPage >= 1 && newPage <= totalPages) {
          // Show pagination loading state
          showPaginationLoading();
          
          // If we have a search term, use search pagination, otherwise use normal pagination
          if (communityCurrentSearchTerm && communityCurrentSearchTerm.trim()) {
            performMemberSearch(communityCurrentSearchTerm, newPage);
          } else {
            loadMembers(newPage);
          }
        }
      }

      // Debounce timer for search
      let searchDebounceTimer = null;
      
      async function searchMembers(searchTerm) {
        // Clear previous debounce timer
        if (searchDebounceTimer) {
          clearTimeout(searchDebounceTimer);
        }
        
        // Sanitize and trim the search term
        const sanitizedTerm = searchTerm ? searchTerm.trim() : '';
        communityCurrentSearchTerm = sanitizedTerm;
        
        // If search term is empty, load all members normally
        if (!sanitizedTerm) {
          loadMembers(1);
          return;
        }
        
        // Validate search term length (prevent extremely long searches)
        if (sanitizedTerm.length > 100) {
          console.warn('Search term too long, truncating');
          communityCurrentSearchTerm = sanitizedTerm.substring(0, 100);
        }
        
        // Debounce search to avoid excessive API calls
        searchDebounceTimer = setTimeout(async () => {
          await performMemberSearch(communityCurrentSearchTerm, 1);
        }, 300); // 300ms delay
      }
      
      async function performMemberSearch(searchTerm, page = 1) {
        const loadingDiv = document.getElementById('membersLoading');
        const listContainer = document.getElementById('membersListContainer');
        const paginationDiv = document.getElementById('membersPagination');
        
        if (!listContainer || !paginationDiv) {
          return;
        }
        
        try {
          // Show loading state
          if (loadingDiv) {
            loadingDiv.style.display = 'block';
          }
          listContainer.innerHTML = '';
          paginationDiv.style.display = 'none';
          
          const communityId = '<%= community._id %>';
          const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
          
          // Use the new search API endpoint
          const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/members/search?q=${encodeURIComponent(searchTerm)}&page=${page}&limit=${communityMembersLimit}`);
          
          if (!response.ok) {
            let errorMessage = 'Search failed';
            if (response.status === 400) {
              errorMessage = 'Invalid search request';
            } else if (response.status === 404) {
              errorMessage = 'Community not found';
            } else if (response.status >= 500) {
              errorMessage = 'Server error occurred';
            }
            throw new Error(`${errorMessage}: ${response.status}`);
          }
          
          let data;
          try {
            data = await response.json();
          } catch (jsonError) {
            throw new Error('Invalid response format from server');
          }
          
          // Validate response structure
          if (!data || typeof data !== 'object') {
            throw new Error('Invalid response data');
          }
          
          // Transform the simplified API response back to the original structure
          // The API returns simplified objects, but we need to maintain compatibility with existing code
          communityMembersData = (data.members || []).map(member => {
            // Validate member object structure
            if (!member || !member.id || !member.username) {
              console.warn('Invalid member object in search results:', member);
              return null;
            }
            
            return {
              _id: member.id,
              userId: member.id,
              user: {
                userId: member.id,
                username: member.username,
                profilePicture: member.profilePicture || '',
                callSign: member.callSign || '',
                isVerified: Boolean(member.isVerified),
                isOnline: false, // Default since this info isn't in the simplified response
                communities: [], // Empty array to prevent getMemberJoinDate errors
                createdAt: new Date().toISOString() // Default creation date
              }
            };
          }).filter(member => member !== null); // Remove any invalid members
          
          communityMembersTotal = data.pagination?.totalCount || 0;
          communityMembersPage = data.pagination?.currentPage || 1;
          
          // Hide loading state
          if (loadingDiv) {
            loadingDiv.style.display = 'none';
          }
          
          // Render the search results
          renderMembersList();
          
          // Update pagination for search results
          updatePagination();
          
        } catch (error) {
          console.error('Search error:', error);
          
          // Hide loading state
          if (loadingDiv) {
            loadingDiv.style.display = 'none';
          }
          
          // Show user-friendly error message
          let errorMessage = 'Failed to search members. Please try again.';
          if (error.message.includes('Invalid search request')) {
            errorMessage = 'Please check your search and try again.';
          } else if (error.message.includes('Community not found')) {
            errorMessage = 'Community not found. Please refresh the page.';
          } else if (error.message.includes('Server error')) {
            errorMessage = 'Server is temporarily unavailable. Please try again later.';
          }
          
          listContainer.innerHTML = `
            <div style="text-align:center; padding:2rem; color:#ef4444;">
              <i class="fa fa-exclamation-triangle" style="font-size:2rem; margin-bottom:1rem;"></i>
              <p style="margin:0;">${errorMessage}</p>
              <button onclick="searchMembers(document.getElementById('memberSearchInput').value)" 
                      style="margin-top:1rem; background:#3b82f6; color:#fff; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:pointer; font-size:0.875rem;">
                <i class="fa fa-refresh" style="margin-right:0.5rem;"></i>
                Try Again
              </button>
            </div>
          `;
        }
      }

