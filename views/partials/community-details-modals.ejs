async function loadRoleMembers() {
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    const response = await fetch(`${apiUrl}/api/v2/community/${communityId}/roles/${currentRole._id}/members?page=1&limit=100`);
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.Response?.Message || data.message || `Failed to fetch role members: ${response.status}`);
    }
    
    const data = await response.json();
    currentRole.membersData = data.members || [];
    currentRole.pagination = data.pagination || {};
    
    renderRoleMembersList();
    populateAddMemberSelect();
    
  } catch (error) {
    showToast(`Failed to load role members: ${error.message}`, 3000, 'error');
    // Fallback to showing just IDs if API fails
    renderRoleMembersList();
    populateAddMemberSelect();
  }
}

function renderRoleMembersList() {
  const membersList = document.getElementById('roleMembersList');
  

  
  // Use the new membersData if available, otherwise fallback to old members array
  const members = currentRole.membersData || currentRole.members || [];
  
  if (members.length === 0) {
    membersList.innerHTML = `
      <div style="text-align:center; padding:2rem; color:#a0aec0;">
        <i class="fa fa-users" style="font-size:2rem; margin-bottom:1rem; opacity:0.5;"></i>
        <p>No members in this role</p>
      </div>
    `;
    return;
  }
  
  membersList.innerHTML = members.map(member => {
    // Handle both new member objects and old member IDs
    const memberId = member.id || member;
    const username = member.username || memberId;
    const profilePicture = member.profilePicture;
    const callSign = member.callSign;
    const isVerified = member.isVerified;
    
    // Check if this is the Head Admin role (same logic as openRoleMembersModal)
    const isHeadAdminRole = (currentRole.permissions || []).some(p => 
      p.name === 'administrator' && p.description === 'Head Admin' && p.enabled
    );
    
    return `
      <div style="display:flex; justify-content:space-between; align-items:center; padding:1rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; margin-bottom:1rem;">
        <div style="display:flex; align-items:center; gap:1rem;">
          <div style="width:40px; height:40px; border-radius:50%; background:#4a5568; display:flex; align-items:center; justify-content:center; overflow:hidden;">
            ${profilePicture ? 
              `<img src="${profilePicture}" alt="${username}" style="width:100%; height:100%; object-fit:cover;">` : 
              `<i class="fa fa-user" style="color:#a0aec0;"></i>`
            }
          </div>
          <div>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span style="color:#fff; font-weight:500;">${username}</span>
              ${isVerified ? `<i class="fa fa-check-circle" style="color:#3b82f6; font-size:0.875rem;"></i>` : ''}
            </div>
            ${callSign ? `<div style="color:#a0aec0; font-size:0.875rem;">${callSign}</div>` : ''}
          </div>
        </div>
        ${isHeadAdminRole ? 
          `<button onclick="showHeadAdminInfoModal('Cannot Remove Head Admin', 'You cannot remove the Head Admin from this role. To change the Head Admin, you must transfer ownership of the community to another member.')" style="background:#6b7280; color:#a0aec0; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:not-allowed; opacity:0.7;">
            <i class="fa fa-times"></i>
          </button>` :
          `<button onclick="removeMemberFromRole('${memberId}')" style="background:#ef4444; color:#fff; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:pointer;">
            <i class="fa fa-times"></i>
          </button>`
        }
      </div>
    `;
  }).join('');
}

async function populateAddMemberSelect() {
  const select = document.getElementById('addMemberSelect');
  
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    // Fetch community members to populate the dropdown
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/members?page=1&limit=100`);
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to fetch community members: ${response.status}`);
    }
    
    const data = await response.json();
    const communityMembers = data.members || [];
    
    // Filter out members who are already in this role
    const currentMemberIds = (currentRole.membersData || currentRole.members || []).map(m => m.id || m);
    const availableMembers = communityMembers.filter(member => 
      !currentMemberIds.includes(member._id)
    );
    
    // Populate dropdown
    select.innerHTML = `
      <option value="">Select a member to add...</option>
      ${availableMembers.map(member => `
        <option value="${member._id}">${member.user?.username || member.user?.email || member._id}</option>
      `).join('')}
    `;
    
  } catch (error) {
    console.error('Failed to populate member select:', error);
    select.innerHTML = '<option value="">Failed to load members</option>';
  }
}

async function addMemberToRole() {
  const select = document.getElementById('addMemberSelect');
  const memberId = select.value;
  
  if (!memberId) {
    showToast('Please select a member to add', 3000, 'error');
    return;
  }
  
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    // Get current members and add the new one
    const currentMembers = (currentRole.membersData || currentRole.members || []).map(m => m.id || m);
    const updatedMembers = [...currentMembers, memberId];
    
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/roles/${currentRole._id}/members?userId=${window.dbUser?._id || ''}`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(updatedMembers), // Send array directly, not wrapped in object
    });
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to add member: ${response.status}`);
    }
    
    showToast('Member added to role successfully!', 3000, 'success');
    select.value = '';
    
    // Refresh the roles modal to update member counts
    refreshRolesModal();
    
    // Refresh the members list
    await loadRoleMembers();
    
  } catch (error) {
    showToast(`Failed to add member: ${error.message}`, 3000, 'error');
  }
}

function removeMemberFromRole(memberId) {
  showCustomConfirm(
    'Remove Member',
    `Are you sure you want to remove this member from the ${currentRole.name} role?`,
    () => performRemoveMemberFromRole(memberId)
  );
}

async function performRemoveMemberFromRole(memberId) {
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/roles/${currentRole._id}/members/${memberId}?userId=${window.dbUser?._id || ''}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      },
    });
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to remove member: ${response.status}`);
    }
    
    showToast('Member removed from role successfully!', 3000, 'success');
    
    // Refresh the roles modal to update member counts
    refreshRolesModal();
    
    // Refresh the members list and dropdown
    await loadRoleMembers();
    await populateAddMemberSelect();
    
  } catch (error) {
    showToast(`Failed to remove member: ${error.message}`, 3000, 'error');
  }
}

