      function attemptCloseFineSettingsModal() {
        // Check if there are unsaved changes
        if (hasUnsavedChanges()) {
          showCustomConfirm(
            'Unsaved Changes',
            'You have unsaved changes. Do you want to save before closing or discard your changes?',
            () => {
              // User chose to save - save and then close
              saveFineSettings();
            },
            () => {
              // User chose to discard - just close without saving
              document.getElementById('fineSettingsModal').style.display = 'none';
            }
          );
        } else {
          // No changes - close immediately
          document.getElementById('fineSettingsModal').style.display = 'none';
        }
      }

      function closeFineSettingsModal() {
        // Direct close without checking for changes (used internally)
        document.getElementById('fineSettingsModal').style.display = 'none';
      }

      function loadFineSettings() {
        // Get current fine settings from the page data
        const communityData = <%- JSON.stringify(community || {}) %>;
        const fines = communityData.community?.fines || { categories: [], currency: 'USD' };
        
        // Set currency
        const currency = fines.currency || 'USD';
        if (currency && !['USD', 'EUR', 'GBP', 'CAD', 'AUD', 'JPY', 'CHF', 'CNY', 'INR', 'BRL', 'MXN', 'KRW', 'RUB', 'ZAR', 'SEK', 'NOK', 'DKK', 'PLN', 'CZK', 'HUF'].includes(currency)) {
          // Custom currency
          document.getElementById('fineCurrency').value = 'custom';
          document.getElementById('customCurrency').value = currency;
          document.getElementById('customCurrency').style.display = 'block';
        } else {
          document.getElementById('fineCurrency').value = currency;
          document.getElementById('customCurrency').style.display = 'none';
        }
        
        // Store original data for search functionality
        window.originalFineCategories = fines.categories || [];
        window.originalCurrency = fines.currency || 'USD';
        
        // Load categories
        renderFineCategories(fines.categories || []);
        
        // Hide loading state
        document.getElementById('fineSettingsLoading').style.display = 'none';
      }

      function refreshFineSettings() {
        // Refresh community data from server and then load fine settings
        const communityId = '<%= community._id %>';
        const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
        
        fetch(`${apiUrl}/api/v1/community/${communityId}`)
          .then(res => res.json())
          .then(data => {
            if (data.community && data.community.fines) {
              // Update the page data with fresh information
              window.currentCommunityData = data.community;
              
              // Reload fine settings with fresh data
              const fines = data.community.fines;
              const currency = fines.currency || 'USD';
              if (currency && !['USD', 'EUR', 'GBP', 'CAD', 'AUD', 'JPY', 'CHF', 'CNY', 'INR', 'BRL', 'MXN', 'KRW', 'RUB', 'ZAR', 'SEK', 'NOK', 'DKK', 'PLN', 'CZK', 'HUF'].includes(currency)) {
                document.getElementById('fineCurrency').value = 'custom';
                document.getElementById('customCurrency').value = currency;
                document.getElementById('customCurrency').style.display = 'block';
              } else {
                document.getElementById('fineCurrency').value = currency;
                document.getElementById('customCurrency').style.display = 'none';
              }
              // Store original data for search functionality
              window.originalFineCategories = fines.categories || [];
              window.originalCurrency = fines.currency || 'USD';
              
              renderFineCategories(fines.categories || []);
            }
            
            // Hide loading state after data is loaded
            document.getElementById('fineSettingsLoading').style.display = 'none';
          })
          .catch(err => {
            // Fallback to current page data
            loadFineSettings();
            
            // Hide loading state even on error
            document.getElementById('fineSettingsLoading').style.display = 'none';
          });
      }

      // Handle currency selection change
      function handleCurrencyChange() {
        const currencySelect = document.getElementById('fineCurrency');
        const customCurrencyInput = document.getElementById('customCurrency');
        
        if (currencySelect.value === 'custom') {
          customCurrencyInput.style.display = 'block';
          customCurrencyInput.focus();
        } else {
          customCurrencyInput.style.display = 'none';
          customCurrencyInput.value = '';
        }
      }

      // Reset to default fines
      function resetToDefaultFines() {
        showCustomConfirm(
          'Reset to Default Fines',
          'Are you sure you want to reset all fines to default? This will replace all current categories and fines with the default set.',
          () => {
            const defaultFines = {
              currency: "USD",
              categories: [
                {
                  name: "Traffic Citations",
                  fines: [
                    { name: "Speeding", amount: 150 },
                    { name: "Parking Violation", amount: 50 },
                    { name: "Running a Stop Sign", amount: 100 },
                    { name: "Expired Registration", amount: 75 },
                  ],
                },
                {
                  name: "Misdemeanors",
                  fines: [
                    { name: "Public Intoxication", amount: 200 },
                    { name: "Disorderly Conduct", amount: 250 },
                    { name: "Petty Theft", amount: 300 },
                  ],
                },
                {
                  name: "Felonies",
                  fines: [
                    { name: "Assault", amount: 1000 },
                    { name: "Burglary", amount: 1500 },
                    { name: "Drug Possession", amount: 1200 },
                  ],
                },
                {
                  name: "Other",
