async function finishCreateRole() {
  if (newRoleData.members.length === 0) {
    showToast('Please select at least one member', 3000, 'error');
    return;
  }
  
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    // Add all selected members to the role
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/roles/${newRoleData._id}/members`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(newRoleData.members), // Send array directly, not wrapped in object
    });
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to add members: ${response.status}`);
    }
    
    showToast('Role created successfully with members!', 3000, 'success');
    closeCreateRoleModal();
    refreshRolesModal(); // Refresh the roles modal to show new role
    
  } catch (error) {
    showToast(`Failed to add members: ${error.message}`, 3000, 'error');
  }
}

