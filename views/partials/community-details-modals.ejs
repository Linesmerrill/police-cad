          <button class="tcm-toolbar-btn" onclick="document.getElementById('tcImportFileInput').click()" title="Import 10-codes" style="background:rgba(59,130,246,0.1); color:#3b82f6; border:1px solid rgba(59,130,246,0.2);">
            <i class="fa fa-upload"></i> Import
          </button>
          <input type="file" id="tcImportFileInput" accept=".json,.csv" style="display:none;" onchange="importTenCodesFile(this)">
          <button class="tcm-toolbar-btn" onclick="openAddTenCodeModal()" style="background:rgba(245,158,11,0.1); color:#f59e0b; border:1px solid rgba(245,158,11,0.2);">
