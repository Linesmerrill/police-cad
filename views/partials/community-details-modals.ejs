              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-user" style="font-size:2rem; color:#6b7280;"></i>
                </div>
                <h5 style="color:#6b7280; margin:0; font-size:1rem; font-weight:600;">Civilians</h5>
                <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage all civilians in community</p>
                <p style="color:#6b7280; margin:0.5rem 0 0 0; font-size:0.75rem; font-style:italic;">Permission Required</p>
              </div>
            </div>
          <% } %>

          <!-- Vehicles Management -->
          <% if (canManageCivilians) { %>
            <div id="vehiclesManagementCard" onclick="openVehiclesModal()" style="background:#2d3748; border:1px solid #4a5568; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; hover:border-color:#3b82f6;">
              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-car" style="font-size:2rem; color:#3b82f6;"></i>
                </div>
                <h5 style="color:#fff; margin:0; font-size:1rem; font-weight:600;">Vehicles</h5>
                <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage all vehicles in community</p>
              </div>
            </div>
          <% } else { %>
            <div id="vehiclesManagementCard" onclick="showNoCiviliansPermissionModal()" style="background:#1a202c; border:1px solid #2d3748; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; opacity:0.6;">
              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-car" style="font-size:2rem; color:#6b7280;"></i>
                </div>
