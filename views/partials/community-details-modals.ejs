  const civilian = civilianApprovalsData.find(civ => civ._id === civilianId);
  if (!civilian) {
    showToast('Civilian not found', 3000, 'error');
    return;
  }
  
  const civData = civilian.civilian || civilian;
  
  // Debug: Log the civilian data structure
  console.log('Civilian data structure:', civData);
  
  // Populate the form with civilian data
  document.getElementById('civDetailsName').value = civData.name || '';
  
  // Handle date of birth - convert from various possible formats
  let birthday = civData.birthday || '';
  if (birthday) {
    // If it's a date string, try to format it for the date input
    if (typeof birthday === 'string' && birthday.includes('/')) {
      // Convert MM/DD/YYYY to YYYY-MM-DD
      const parts = birthday.split('/');
