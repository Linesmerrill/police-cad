            }
          };
          
          // Reset cancel button to original
          const cancelBtn = document.getElementById('confirmCancelBtn');
          if (cancelBtn) {
            cancelBtn.textContent = cancelText || 'Cancel';
            cancelBtn.style.background = '#6b7280'; // Gray for cancel
            cancelBtn.onclick = () => {
              hideCustomConfirm();
            };
          }
