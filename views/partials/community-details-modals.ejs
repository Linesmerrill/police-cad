        const fines = communityData.community?.fines || { categories: [], currency: 'USD' };
        
        // Set currency
        const currency = fines.currency || 'USD';
        if (currency && !['USD', 'EUR', 'GBP', 'CAD', 'AUD', 'JPY', 'CHF', 'CNY', 'INR', 'BRL', 'MXN', 'KRW', 'RUB', 'ZAR', 'SEK', 'NOK', 'DKK', 'PLN', 'CZK', 'HUF'].includes(currency)) {
