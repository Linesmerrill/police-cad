<script>
function openNoEventPermissionModal() {
  document.getElementById('noEventPermissionModal').style.display = 'flex';
}

function openOwnerCannotLeaveModal() {
  document.getElementById('ownerCannotLeaveModal').style.display = 'flex';
}

function openLeaveCommunityModal() {
  document.getElementById('leaveCommunityModal').style.display = 'flex';
}

function openSettingsModal() {
  document.getElementById('settingsModal').style.display = 'flex';
  initPlatformButtons();
}

function openInviteCodesModal() {
  document.getElementById('inviteCodesModal').style.display = 'flex';
  loadInviteCodes();
  // Auto-populate a random code when modal opens
  generateInviteCode();
}

function closeInviteCodesModal() {
  document.getElementById('inviteCodesModal').style.display = 'none';
}

// Invite codes management functions
let inviteCodesData = [];
let inviteCodesPagination = { currentPage: 1, totalPages: 1, totalCount: 0, hasNextPage: false, hasPrevPage: false, limit: 10 };
let expiredCodesCount = 0;

async function loadInviteCodes(page = 1) {
  const listContainer = document.getElementById('inviteCodesList');
  const loadingDiv = document.getElementById('inviteCodesLoading');
  const emptyDiv = document.getElementById('inviteCodesEmpty');
  const expiredHelper = document.getElementById('expiredCodesHelper');
  const paginationDiv = document.getElementById('inviteCodesPagination');

  if (loadingDiv) loadingDiv.style.display = 'block';
  if (listContainer) listContainer.innerHTML = '';
  if (emptyDiv) emptyDiv.style.display = 'none';
  if (expiredHelper) expiredHelper.style.display = 'none';
  if (paginationDiv) paginationDiv.style.display = 'none';

  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

    const response = await fetch(`${apiUrl}/api/v2/community/${communityId}/invite-codes?page=${page}&limit=10`);
    if (!response.ok) throw new Error('Failed to load invite codes');

    const data = await response.json();
    inviteCodesData = data.inviteCodes || [];
    inviteCodesPagination = data.pagination || { currentPage: 1, totalPages: 1, totalCount: 0, hasNextPage: false, hasPrevPage: false, limit: 10 };

    // Get total expired codes count from API (across all pages)
    expiredCodesCount = data.expiredCount || 0;

    if (loadingDiv) loadingDiv.style.display = 'none';

    if (inviteCodesData.length === 0) {
      if (emptyDiv) emptyDiv.style.display = 'block';
      if (listContainer) listContainer.style.display = 'none';
      return;
    }

    // Show expired codes helper if there are expired codes
    if (expiredCodesCount > 0 && expiredHelper) {
      const countSpan = document.getElementById('expiredCodesCount');
      if (countSpan) countSpan.textContent = expiredCodesCount;
      expiredHelper.style.display = 'block';
    }

    renderInviteCodes();
    renderInviteCodesPagination();
  } catch (error) {
    console.error('Error loading invite codes:', error);
    if (loadingDiv) loadingDiv.style.display = 'none';
    if (listContainer) {
      listContainer.innerHTML = '<div style="text-align:center; padding:2rem; color:#ef4444;"><i class="fa fa-exclamation-triangle" style="font-size:2rem; margin-bottom:1rem;"></i><p>Failed to load invite codes</p></div>';
    }
  }
}

function renderInviteCodesPagination() {
  const paginationDiv = document.getElementById('inviteCodesPagination');
  if (!paginationDiv) return;

  if (inviteCodesPagination.totalPages <= 1) {
    paginationDiv.style.display = 'none';
    return;
  }

  paginationDiv.style.display = 'flex';
  paginationDiv.innerHTML = `
    <button onclick="loadInviteCodes(${inviteCodesPagination.currentPage - 1})"
            ${!inviteCodesPagination.hasPrevPage ? 'disabled' : ''}
            style="background:${inviteCodesPagination.hasPrevPage ? '#4a5568' : '#2d3748'}; color:${inviteCodesPagination.hasPrevPage ? '#fff' : '#6b7280'}; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:${inviteCodesPagination.hasPrevPage ? 'pointer' : 'not-allowed'}; font-size:0.875rem;">
      <i class="fa fa-chevron-left"></i> Prev
    </button>
    <span style="color:#a0aec0; font-size:0.875rem; display:flex; align-items:center;">
      Page ${inviteCodesPagination.currentPage} of ${inviteCodesPagination.totalPages}
    </span>
    <button onclick="loadInviteCodes(${inviteCodesPagination.currentPage + 1})"
            ${!inviteCodesPagination.hasNextPage ? 'disabled' : ''}
            style="background:${inviteCodesPagination.hasNextPage ? '#4a5568' : '#2d3748'}; color:${inviteCodesPagination.hasNextPage ? '#fff' : '#6b7280'}; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:${inviteCodesPagination.hasNextPage ? 'pointer' : 'not-allowed'}; font-size:0.875rem;">
      Next <i class="fa fa-chevron-right"></i>
    </button>
  `;
}

async function deleteExpiredInviteCodes() {
  const communityId = '<%= community._id %>';
  const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

  try {
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/invite-codes/expired`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    });

    if (!response.ok) throw new Error('Failed to delete expired codes');

    const data = await response.json();
    showToast(`Deleted ${data.deletedCount} expired invite code${data.deletedCount !== 1 ? 's' : ''}`, 3000, 'success');
    closeDeleteExpiredModal();
    loadInviteCodes(1); // Reload from page 1
  } catch (error) {
    console.error('Error deleting expired codes:', error);
    showToast('Failed to delete expired codes', 3000, 'error');
  }
}

function showDeleteExpiredModal() {
  const modal = document.getElementById('deleteExpiredModal');
  if (modal) modal.style.display = 'flex';
}

function closeDeleteExpiredModal() {
  const modal = document.getElementById('deleteExpiredModal');
  if (modal) modal.style.display = 'none';
}

function formatExpiryTime(expiresAt) {
  const expiry = new Date(expiresAt);
  const now = new Date();
  const diff = expiry - now;

  // Format the full date/time
  const dateStr = expiry.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  const timeStr = expiry.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });

  // Calculate relative time
  let relativeStr = '';
  if (diff > 0) {
    const minutes = Math.floor(diff / 60000);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);

    if (days > 0) {
      relativeStr = `${days} day${days > 1 ? 's' : ''}`;
    } else if (hours > 0) {
      relativeStr = `${hours} hour${hours > 1 ? 's' : ''}`;
    } else if (minutes > 0) {
      relativeStr = `${minutes} min${minutes > 1 ? 's' : ''}`;
    } else {
      relativeStr = 'less than a minute';
    }
  }

  return { dateStr, timeStr, relativeStr };
}

function renderInviteCodes() {
  const listContainer = document.getElementById('inviteCodesList');
  if (!listContainer) return;

  listContainer.innerHTML = '';
  listContainer.style.display = 'block';

  inviteCodesData.forEach(code => {
    const isExpired = code.expiresAt && new Date(code.expiresAt) < new Date();
    const usesCount = code.uses || 0;
    // Check if code has no remaining uses (maxUses > 0 means limited, remainingUses <= 0 means fully used)
    const isFullyUsed = code.maxUses > 0 && code.remainingUses <= 0;
    const isInvalid = isExpired || isFullyUsed;

    let expiryDisplay = '';
    if (code.expiresAt) {
      if (isExpired) {
        expiryDisplay = '<span style="color:#ef4444;"><i class="fa fa-clock" style="margin-right:0.25rem;"></i>Expired</span>';
      } else {
        const { dateStr, timeStr, relativeStr } = formatExpiryTime(code.expiresAt);
        expiryDisplay = `<span style="color:#fbbf24;"><i class="fa fa-clock" style="margin-right:0.25rem;"></i>Expires ${dateStr} at ${timeStr} (${relativeStr} left)</span>`;
      }
    } else {
      expiryDisplay = '<span style="color:#10b981;"><i class="fa fa-infinity" style="margin-right:0.25rem;"></i>Never expires</span>';
    }

    // Show uses display
    let usesDisplay = code.maxUses > 0 ? `${usesCount} of ${code.maxUses} uses` : `${usesCount} uses (unlimited)`;
    if (isFullyUsed) {
      usesDisplay = `<span style="color:#ef4444;">${usesCount} of ${code.maxUses} uses (limit reached)</span>`;
    }

    const codeEl = document.createElement('div');
    codeEl.style.cssText = 'display:flex; align-items:flex-start; justify-content:space-between; padding:1rem; border-bottom:1px solid #4a5568; gap:1rem; flex-wrap:wrap;';
    codeEl.innerHTML = `
      <div style="flex:1; min-width:150px;">
        <code style="background:#1e2028; color:${isInvalid ? '#ef4444' : '#68d391'}; padding:0.5rem 0.75rem; border-radius:6px; font-family:monospace; font-size:1rem; display:inline-block; word-break:break-all;">${code.code}</code>
        <div style="margin-top:0.5rem; font-size:0.75rem; color:#a0aec0;">
          ${usesDisplay}
        </div>
        <div style="margin-top:0.25rem; font-size:0.75rem;">
          ${expiryDisplay}
        </div>
      </div>
      <div style="display:flex; gap:0.5rem; flex-shrink:0;">
        <button id="copyCodeBtn-${code.code}" onclick="copyInviteCode('${code.code}', this)" title="Copy code" style="background:#4a5568; color:#fff; border:none; border-radius:6px; padding:0.5rem; cursor:pointer; font-size:0.875rem; transition:all 0.2s; width:36px; height:36px; display:flex; align-items:center; justify-content:center;">
          <i class="fa fa-copy"></i>
        </button>
        <button id="copyLinkBtn-${code.code}" onclick="copyInviteLink('${code.code}', this)" title="Copy join link" style="background:#3b82f6; color:#fff; border:none; border-radius:6px; padding:0.5rem; cursor:pointer; font-size:0.875rem; transition:all 0.2s; width:36px; height:36px; display:flex; align-items:center; justify-content:center;">
          <i class="fa fa-link"></i>
        </button>
        <button onclick="confirmDeleteInviteCode('${code._id || code.code}')" title="Delete" style="background:#ef4444; color:#fff; border:none; border-radius:6px; padding:0.5rem; cursor:pointer; font-size:0.875rem; width:36px; height:36px; display:flex; align-items:center; justify-content:center;">
          <i class="fa fa-trash"></i>
        </button>
      </div>
    `;
    listContainer.appendChild(codeEl);
  });
}

function generateInviteCode() {
  const input = document.getElementById('inviteCodeInput');
  if (input) {
    // Generate a random 8-character alphanumeric code
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    let code = '';
    for (let i = 0; i < 8; i++) {
      code += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    input.value = code;
    validateInviteCodeInput();
  }
}

function validateInviteCodeInput() {
  const input = document.getElementById('inviteCodeInput');
  const icon = document.getElementById('inviteCodeValidationIcon');
  if (!input || !icon) return;

  const value = input.value.trim().replace(/[^A-Za-z0-9]/g, '');
  const isValid = value.length >= 4 && value.length <= 16;

  if (isValid) {
    icon.style.color = '#10b981';
    icon.innerHTML = '<i class="fa fa-check"></i>';
  } else {
    icon.style.color = '#ef4444';
    icon.innerHTML = '<i class="fa fa-times"></i>';
  }
}

async function createInviteCode() {
  const codeInput = document.getElementById('inviteCodeInput');
  const expireSelect = document.getElementById('expireAfterSelect');
  const maxUsesSelect = document.getElementById('maxUsesSelect');

  let code = codeInput ? codeInput.value.trim().toUpperCase() : '';

  // Sanitize: only allow alphanumeric characters
  code = code.replace(/[^A-Z0-9]/g, '');

  // Auto-generate if empty
  if (!code) {
    generateInviteCode();
    code = codeInput.value;
  }

  // Validate length
  if (code.length < 4) {
    showToast('Invite code must be at least 4 characters', 3000, 'error');
    return;
  }
  if (code.length > 16) {
    showToast('Invite code must be 16 characters or less', 3000, 'error');
    return;
  }

  // Update input with sanitized value
  if (codeInput) codeInput.value = code;

  const expireAfter = expireSelect ? expireSelect.value : '7d';
  const maxUses = maxUsesSelect ? parseInt(maxUsesSelect.value, 10) : 0;

  // Calculate expiration date
  let expiresAt = null;
  if (expireAfter !== 'never') {
    const now = new Date();
    const match = expireAfter.match(/(\d+)([mhd])/);
    if (match) {
      const value = parseInt(match[1], 10);
      const unit = match[2];
      if (unit === 'm') now.setMinutes(now.getMinutes() + value);
      else if (unit === 'h') now.setHours(now.getHours() + value);
      else if (unit === 'd') now.setDate(now.getDate() + value);
      expiresAt = now.toISOString();
    }
  }

  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/add-invite-code?userId=${window.dbUser?._id || ''}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code, expiresAt, maxUses })
    });

    if (!response.ok) {
      const data = await response.json();
      // Handle duplicate invite code - auto-regenerate and notify user
      if (response.status === 409) {
        generateInviteCode();
        showToast('Code already exists. A new code has been generated.', 3000, 'error');
        return;
      }
      throw new Error(data.message || 'Failed to create invite code');
    }

    // Show success modal
    const successModal = document.getElementById('inviteCodeSuccessModal');
    const successCode = document.getElementById('successCode');
    const successLink = document.getElementById('successLink');

    if (successCode) successCode.textContent = code;
    if (successLink) successLink.textContent = `${window.location.origin}/join/${code}`;
    if (successModal) successModal.style.display = 'flex';

    // Clear input and reload list
    if (codeInput) codeInput.value = '';
    loadInviteCodes();

    showToast('Invite code created successfully!', 3000, 'success');
  } catch (error) {
    console.error('Error creating invite code:', error);
    showToast(error.message || 'Failed to create invite code', 3000, 'error');
  }
}

function copyInviteCode(code, btn) {
  navigator.clipboard.writeText(code).then(() => {
    // Show check icon on the button
    if (btn) {
      const icon = btn.querySelector('i');
      if (icon) {
        icon.className = 'fa fa-check';
        btn.style.background = '#10b981';
      }
      // Revert after 2 seconds
      setTimeout(() => {
        if (icon) icon.className = 'fa fa-copy';
        btn.style.background = '#4a5568';
      }, 2000);
    }
    showToast('Invite code copied!', 2000, 'success');
  }).catch(() => {
    showToast('Failed to copy code', 2000, 'error');
  });
}

function copyInviteLink(code, btn) {
  const link = `${window.location.origin}/join/${code}`;
  navigator.clipboard.writeText(link).then(() => {
    // Show check icon on the button
    if (btn) {
      const icon = btn.querySelector('i');
      if (icon) {
        icon.className = 'fa fa-check';
        btn.style.background = '#10b981';
      }
      // Revert after 2 seconds
      setTimeout(() => {
        if (icon) icon.className = 'fa fa-link';
        btn.style.background = '#3b82f6';
      }, 2000);
    }
    showToast('Join link copied!', 2000, 'success');
  }).catch(() => {
    showToast('Failed to copy link', 2000, 'error');
  });
}

function copySuccessCode() {
  const code = document.getElementById('successCode');
  const icon = document.getElementById('copyCodeIcon');
  const btn = document.getElementById('copyCodeBtn');
  if (code) {
    navigator.clipboard.writeText(code.textContent).then(() => {
      if (icon) {
        icon.className = 'fa fa-check';
        if (btn) btn.style.background = '#10b981';
      }
      showToast('Code copied!', 2000, 'success');
      setTimeout(() => {
        if (icon) icon.className = 'fa fa-copy';
        if (btn) btn.style.background = '#4a5568';
      }, 2000);
    });
  }
}

function copySuccessLink() {
  const link = document.getElementById('successLink');
  const icon = document.getElementById('copyLinkIcon');
  const btn = document.getElementById('copyLinkBtn');
  if (link) {
    navigator.clipboard.writeText(link.textContent).then(() => {
      if (icon) {
        icon.className = 'fa fa-check';
        if (btn) btn.style.background = '#10b981';
      }
      showToast('Link copied!', 2000, 'success');
      setTimeout(() => {
        if (icon) icon.className = 'fa fa-copy';
        if (btn) btn.style.background = '#4a5568';
      }, 2000);
    });
  }
}

function closeInviteCodeSuccessModal() {
  const modal = document.getElementById('inviteCodeSuccessModal');
  if (modal) modal.style.display = 'none';
}

function createAnotherCode() {
  closeInviteCodeSuccessModal();
  generateInviteCode();
}

let deleteInviteCodeId = null;

function confirmDeleteInviteCode(codeId) {
  deleteInviteCodeId = codeId;
  const modal = document.getElementById('deleteConfirmModal');
  const codeName = document.getElementById('deleteCodeName');

  // Find the code name
  const code = inviteCodesData.find(c => (c._id || c.code) === codeId);
  if (codeName && code) codeName.textContent = code.code;
  if (modal) modal.style.display = 'flex';
}

function closeDeleteConfirmModal() {
  const modal = document.getElementById('deleteConfirmModal');
  if (modal) modal.style.display = 'none';
  deleteInviteCodeId = null;
}

async function deleteInviteCode() {
  if (!deleteInviteCodeId) return;

  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

    const response = await fetch(`${apiUrl}/api/v1/invite-code/${deleteInviteCodeId}?userId=${window.dbUser?._id || ''}`, {
      method: 'DELETE'
    });

    if (!response.ok) throw new Error('Failed to delete invite code');

    closeDeleteConfirmModal();
    loadInviteCodes();
    showToast('Invite code deleted', 2000, 'success');
  } catch (error) {
    console.error('Error deleting invite code:', error);
    showToast('Failed to delete invite code', 3000, 'error');
  }
}

</script> 

