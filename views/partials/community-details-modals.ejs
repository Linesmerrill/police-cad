      async function loadMembers(page = 1) {
        const loadingDiv = document.getElementById('membersLoading');
        const listContainer = document.getElementById('membersListContainer');
        const paginationDiv = document.getElementById('membersPagination');
        
        // Safety check - ensure required elements exist (loadingDiv is optional)
        if (!listContainer || !paginationDiv) {
          return;
        }
        
        try {
          // Show loading if element exists
          if (loadingDiv) {
            loadingDiv.style.display = 'block';
          }
          listContainer.innerHTML = '';
          paginationDiv.style.display = 'none';
          
          const communityId = '<%= community._id %>';
          const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
          
          const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/members?limit=${communityMembersLimit}&page=${page}`);
          
          if (!response.ok) {
            throw new Error(`Failed to fetch members: ${response.status}`);
          }
          
          const data = await response.json();
          
          communityMembersData = data.members || [];
          communityMembersTotal = data.totalUsers || 0;
          communityMembersPage = page;
          
          // No need for client-side filtering anymore since we use API-based search
          
