  const addBtn = document.getElementById('addMemberBtn');
  if (isHeadAdmin) {
    addBtn.style.background = '#6b7280';
    addBtn.style.cursor = 'not-allowed';
    addBtn.onclick = () => showHeadAdminInfoModal('Cannot Add Members', 'There can only be a single Head Admin. If you want to add someone else, you need to transfer ownership of the community or create a new role with admin permissions.');
  } else {
    addBtn.style.background = '#10b981';
    addBtn.style.cursor = 'pointer';
    addBtn.onclick = () => addMemberToRole();
  }
  
  document.getElementById('roleMembersModal').style.display = 'flex';
