async function loadCivilianApprovals(page = 0) {
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    const response = await fetch(`${apiUrl}/api/v1/civilian/pending-approvals?communityId=${communityId}&page=${page}&limit=10`);
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to fetch pending approvals: ${response.status}`);
    }
    
    const data = await response.json();
    
    if (data.data && Array.isArray(data.data)) {
      civilianApprovalsData = data.data;
      filteredCivilianApprovals = [...civilianApprovalsData];
      
      // Update pagination info
      if (data.pagination) {
        approvalsPagination = data.pagination;
        currentApprovalsPage = data.pagination.currentPage;
      }
      
      // Update count with proper singular/plural
      const approvalsCount = document.getElementById('civilianApprovalsCount');
      const approvalsCountText = document.getElementById('civilianApprovalsCountText');
      const totalCount = approvalsPagination.totalCount || civilianApprovalsData.length;
      approvalsCount.textContent = totalCount;
      approvalsCountText.textContent = totalCount === 1 ? 'awaiting review' : 'awaiting review';
    } else {
      civilianApprovalsData = [];
      filteredCivilianApprovals = [];
      approvalsPagination = {
        currentPage: 0,
        limit: 10,
        totalCount: 0,
        totalPages: 0,
        hasNext: false,
        hasPrev: false
      };
      currentApprovalsPage = 0;
      
      const approvalsCount = document.getElementById('civilianApprovalsCount');
      const approvalsCountText = document.getElementById('civilianApprovalsCountText');
      approvalsCount.textContent = '0';
      approvalsCountText.textContent = 'awaiting review';
    }
    
    // Render approvals
    renderCivilianApprovalsList();
    
  } catch (error) {
    showToast(`Failed to load review requests: ${error.message}`, 3000, 'error');
  }
}

function renderCivilianApprovalsList() {
  const loadingDiv = document.getElementById('civilianApprovalsLoading');
  const listContainer = document.getElementById('civilianApprovalsListContainer');
  const emptyState = document.getElementById('civilianApprovalsEmptyState');
  const approvalsList = document.getElementById('civilianApprovalsList');
  const paginationDiv = document.getElementById('civilianApprovalsPagination');
  
  // Hide loading
  loadingDiv.style.display = 'none';
  
  if (filteredCivilianApprovals.length === 0) {
    emptyState.style.display = 'block';
    listContainer.style.display = 'none';
    paginationDiv.style.display = 'none';
    return;
  }
  
  emptyState.style.display = 'none';
  listContainer.style.display = 'block';
  
  // Show pagination if there are multiple pages
  if (approvalsPagination.totalPages > 1) {
    paginationDiv.style.display = 'block';
    
    // Update pagination info
    document.getElementById('civApprovalsCurrentPage').textContent = approvalsPagination.currentPage + 1;
    document.getElementById('civApprovalsTotalPages').textContent = approvalsPagination.totalPages;
    
    // Update button states
    document.getElementById('civApprovalsPrevBtn').disabled = !approvalsPagination.hasPrev;
    document.getElementById('civApprovalsNextBtn').disabled = !approvalsPagination.hasNext;
    
    // Update button styles based on disabled state
    const prevBtn = document.getElementById('civApprovalsPrevBtn');
    const nextBtn = document.getElementById('civApprovalsNextBtn');
    
    if (approvalsPagination.hasPrev) {
      prevBtn.style.background = '#4a5568';
      prevBtn.style.cursor = 'pointer';
    } else {
      prevBtn.style.background = '#2d3748';
      prevBtn.style.cursor = 'not-allowed';
      prevBtn.style.opacity = '0.6';
    }
    
    if (approvalsPagination.hasNext) {
      nextBtn.style.background = '#3b82f6';
      nextBtn.style.cursor = 'pointer';
    } else {
      nextBtn.style.background = '#2d3748';
      nextBtn.style.cursor = 'not-allowed';
      nextBtn.style.opacity = '0.6';
    }
  } else {
    paginationDiv.style.display = 'none';
  }
  
  approvalsList.innerHTML = filteredCivilianApprovals.map(civ => {
    const civData = civ.civilian ? civ.civilian : civ;
    const fullName = civData.name || 'Unnamed Civilian';
    const age = civData.birthday ? getAge(civData.birthday) : 'N/A';
    const gender = civData.gender || 'N/A';
    const address = civData.address || 'N/A';
    
    return `
      <div onclick="openCivilianDetailsModal('${civ._id}')" style="display:flex; justify-content:space-between; align-items:center; padding:1rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; margin-bottom:1rem; cursor:pointer; transition:all 0.2s;" onmouseover="this.style.background='#374151'" onmouseout="this.style.background='#2d3748'">
        <div style="display:flex; align-items:center; gap:1rem;">
          <div style="width:50px; height:50px; border-radius:50%; background:#3b82f6; display:flex; align-items:center; justify-content:center; overflow:hidden; position:relative;">
            ${civData.image ? 
              `<img src="${civData.image}" alt="${fullName}" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" />` : 
              `<i class="fa fa-user" style="color:#fff; font-size:1.5rem;"></i>`
            }
          </div>
          <div>
            <h4 style="color:#fff; margin:0; font-size:1.125rem; font-weight:600;">${fullName}</h4>
            <p style="color:#a0aec0; margin:0.25rem 0 0 0; font-size:0.875rem;">Age: ${age} | Gender: ${gender}</p>
            <p style="color:#a0aec0; margin:0.25rem 0 0 0; font-size:0.875rem;">Address: ${address}</p>
          </div>
        </div>
        <div style="display:flex; gap:0.5rem;" onclick="event.stopPropagation();">
          <button onclick="approveCivilian('${civ._id}')" style="background:#10b981; color:#fff; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:pointer; font-size:0.875rem;">
            <i class="fa fa-check"></i> Approve
          </button>
          <button onclick="denyCivilian('${civ._id}')" style="background:#ef4444; color:#fff; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:pointer; font-size:0.875rem;">
            <i class="fa fa-times"></i> Deny
          </button>
          <button onclick="requireEditsCivilian('${civ._id}')" style="background:#f59e0b; color:#fff; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:pointer; font-size:0.875rem;">
            <i class="fa fa-edit"></i> Edit
          </button>
        </div>
      </div>
    `;
  }).join('');
}

function searchCivilianApprovals(query) {
  const clearBtn = document.getElementById('civilianApprovalsSearchClear');
  
  if (!query.trim()) {
    filteredCivilianApprovals = [...civilianApprovalsData];
    clearBtn.style.display = 'none';
  } else {
    const lowerQuery = query.toLowerCase();
    filteredCivilianApprovals = civilianApprovalsData.filter(civ => {
      const civData = civ.civilian ? civ.civilian : civ;
      const name = civData.name || '';
      const address = civData.address || '';
      return name.toLowerCase().includes(lowerQuery) || address.toLowerCase().includes(lowerQuery);
    });
    clearBtn.style.display = 'block';
  }
  
  renderCivilianApprovalsList();
}

function clearCivilianApprovalsSearch() {
  const searchInput = document.getElementById('civilianApprovalsSearchInput');
  const clearBtn = document.getElementById('civilianApprovalsSearchClear');
  
  searchInput.value = '';
  clearBtn.style.display = 'none';
  
  filteredCivilianApprovals = [...civilianApprovalsData];
  renderCivilianApprovalsList();
}

function loadCivilianApprovalsPage(direction) {
  let newPage = currentApprovalsPage;
  
  if (direction === 'next' && approvalsPagination.hasNext) {
    newPage = currentApprovalsPage + 1;
  } else if (direction === 'prev' && approvalsPagination.hasPrev) {
    newPage = currentApprovalsPage - 1;
  }
  
  if (newPage !== currentApprovalsPage) {
    loadCivilianApprovals(newPage);
  }
}

