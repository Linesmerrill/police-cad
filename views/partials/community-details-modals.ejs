    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
      // Modal Event Listeners
      document.addEventListener('DOMContentLoaded', function() {
        // Account button click handler
        const accountBtn = document.getElementById('accountBtn');
        if (accountBtn) {
          accountBtn.addEventListener('click', function() {
            fillAccountDetails();
            document.getElementById('accountModal').style.display = 'flex';
          });
        }
        
        // Account modal close button
        const accountModalClose = document.getElementById('accountModalClose');
        if (accountModalClose) {
          accountModalClose.addEventListener('click', function() {
            document.getElementById('accountModal').style.display = 'none';
          });
        }
        
        // Notification button click handler
        const notificationBtn = document.getElementById('notificationBtn');
        if (notificationBtn) {
          notificationBtn.addEventListener('click', function() {
            document.getElementById('notificationModal').style.display = 'flex';
            fetchNotifications(0);
          });
        }
        
        // Notification modal close button
        const notificationModalClose = document.getElementById('notificationModalClose');
        if (notificationModalClose) {
          notificationModalClose.addEventListener('click', function() {
            document.getElementById('notificationModal').style.display = 'none';
          });
        }
        
        // Notification modal cancel button
        const notificationModalCancel = document.getElementById('notificationModalCancel');
        if (notificationModalCancel) {
          notificationModalCancel.addEventListener('click', function() {
            document.getElementById('notificationModal').style.display = 'none';
          });
        }
        
        // Close modals when clicking outside
        window.addEventListener('click', function(event) {
          const accountModal = document.getElementById('accountModal');
          const notificationModal = document.getElementById('notificationModal');
          const deactivateModal = document.getElementById('deactivateAccountModal');
          
          if (event.target === accountModal && (!deactivateModal || deactivateModal.style.display === 'none')) {
            accountModal.style.display = 'none';
          }
          if (event.target === notificationModal) {
            notificationModal.style.display = 'none';
          }
        });
        
        // Initialize notification count on page load
        if (dbUser && dbUser._id) {
          // Initialize notification count using the function from notifications.js
          fetchNotificationCount();
        }
      });
      
      // Fill account details function (same as community dashboard)
      function fillAccountDetails() {
        if (dbUser && dbUser.user) {
          const emailField = document.getElementById('accountEmail');
          const usernameField = document.getElementById('accountUsername');
          const callSignField = document.getElementById('accountCallSign');
          const profilePicture = document.getElementById('profilePicture');
          
          if (emailField) emailField.value = dbUser.user.email;
          if (usernameField) {
            usernameField.value = dbUser.user.username;
            usernameField.defaultValue = dbUser.user.username; // Set default for change detection
          }
          if (callSignField) {
            callSignField.value = dbUser.user.callSign;
            callSignField.defaultValue = dbUser.user.callSign; // Set default for change detection
          }
          if (profilePicture) {
            const profileImageUrl = dbUser.user.profilePicture || '/static/images/civ-unknown-user.png';
            profilePicture.style.backgroundImage = `url(${profileImageUrl})`;
          }
        }
      }
      
      // Modal open functions
      function openPromoteModal() {
        document.getElementById('promoteModal').style.display = 'flex';
      }


             
      
      function openInviteModal() {
        document.getElementById('inviteModal').style.display = 'flex';
      }
      
      function openRequestJoinModal() {
        document.getElementById('requestJoinModal').style.display = 'flex';
      }
      
      function closeRequestJoinModal() {
        document.getElementById('requestJoinModal').style.display = 'none';
      }
      

      
      // Modal close functions will be set up in DOMContentLoaded
      
      // Action functions
      async function submitJoinRequest() {
        const communityId = '<%= community._id %>';
        const userId = '<%= user && user._doc ? user._doc._id : "" %>';
        const user = <%- JSON.stringify(user && user._doc ? user._doc : {}) %>;
        
        // Get the API URL with fallback
        const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
        
        try {
          // Step 1: Send pending community request
          const response = await fetch(`${apiUrl}/api/v1/user/${userId}/pending-community-request`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              communityId: communityId
            })
          });

          if (!response.ok) {
            const data = await response.json();
            throw new Error(`Failed to send pending community request. Message: ${data.message}. Code: ${response.status}`);
          }

          const data = await response.json();
          
          if (data.status === 'joined') {
            showToast('Successfully joined community!', 2500, 'success');
            closeRequestJoinModal();
            setTimeout(() => {
              window.location.href = '/communities?success=true';
            }, 1000);
            return;
          }

          // Step 2: Send notifications to community administrators
          await sendJoinRequestNotification(communityId, user, apiUrl);
          
          showToast('Join request submitted successfully!', 2500, 'success');
          closeRequestJoinModal();
          setTimeout(() => {
            window.location.reload();
          }, 1000);
          
        } catch (error) {
          console.error('Error submitting join request:', error);
          showToast('Error submitting join request: ' + error.message, 3000, 'error');
        }
      }

      async function sendJoinRequestNotification(communityId, user, apiUrl) {
        try {
          // Fetch community details to get roles and permissions
          const communityResponse = await fetch(`${apiUrl}/api/v1/community/${communityId}`);
          if (!communityResponse.ok) {
            throw new Error('Failed to fetch community details');
          }
          const community = await communityResponse.json();
          
          // Get user IDs of roles with "manage members" or "administrator" permissions
          const userIds = community.community.roles
            .filter((role) =>
              role.permissions.some(
                (permission) =>
                  (permission.name === "manage members" ||
                    permission.name === "administrator") &&
                  permission.enabled
              )
            )
            .flatMap((role) => role.members);

          // Send notification to each user
          for (const recipientId of userIds) {
            await fetch(`${apiUrl}/api/v1/users/notifications`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                sentFromID: user._id,
                sentToID: recipientId,
                type: "join_request",
                data1: communityId,
                data2: community.community.name,
                message: `has requested to join`,
              }),
            });
          }
        } catch (error) {
          console.error("Error sending join request notification:", error);
          throw error;
        }
      }
      
      function submitLeaveCommunity() {
        const userId = '<%= user && user._doc ? user._doc._id : "" %>';
        const communityId = '<%= community._id %>';
        const errorDiv = document.getElementById('leaveCommunityError');
        errorDiv.style.display = 'none';
        errorDiv.textContent = '';

        // Show loading state (optional)
        const leaveBtn = document.getElementById('leaveCommunityModalConfirm');
        if (leaveBtn) {
          leaveBtn.disabled = true;
          leaveBtn.textContent = 'Leaving...';
        }

        fetch(`${API_URL}/api/v1/user/${userId}/remove-community`, {
          method: "DELETE",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ communityId }),
        })
          .then(async (response) => {
            if (!response.ok) {
              const data = await response.json();
              throw new Error(
                `Failed to remove user from community.\n\nMessage: ${data.message}.\nCode: ${response.status}`
              );
            }
            return response.json();
          })
          .then(() => {
            localStorage.setItem('leftCommunityToast', '1');
            window.location.href = "/communities";
          })
          .catch((error) => {
            errorDiv.style.display = 'block';
            errorDiv.textContent = error.message || "An error occurred.";
            if (leaveBtn) {
              leaveBtn.disabled = false;
              leaveBtn.textContent = 'Leave Community';
            }
          });
      }
    </script>
    <script>
    // Modal handlers for community actions
function openPromoteModal() {
  // TODO: Implement promote modal
  alert('Promote modal will be implemented next');
}

// Privacy and platform selection for community settings
window.selectedPrivacy = '<%= (community && community.community && community.community.visibility) || "public" %>';
window.selectedPlatforms = <%- JSON.stringify((community && community.community && community.community.tags) || []) %>;

function setPrivacy(privacy) {
  window.selectedPrivacy = privacy;

  const publicBtn = document.getElementById('privacyPublic');
  const privateBtn = document.getElementById('privacyPrivate');

  if (privacy === 'public') {
    publicBtn.style.background = '#3b82f6';
    privateBtn.style.background = 'transparent';
  } else {
    publicBtn.style.background = 'transparent';
    privateBtn.style.background = '#3b82f6';
  }
}

function togglePlatform(platform) {
  const platformLower = platform.toLowerCase();
  const index = window.selectedPlatforms.findIndex(p => p.toLowerCase() === platformLower);

  // Map to properly capitalized tag names (matching the app's standard)
  const capitalizedMap = {
    'xbox': 'Xbox',
    'playstation': 'PlayStation',
    'pc': 'PC'
  };

  if (index > -1) {
    window.selectedPlatforms.splice(index, 1);
  } else {
    // Store as properly capitalized (matching app standard: Xbox, PlayStation, PC)
    window.selectedPlatforms.push(capitalizedMap[platformLower] || platform);
  }

  // Update button styles - map to correct button IDs
  const platformIdMap = {
    'xbox': 'platformXbox',
    'playstation': 'platformPlayStation',
    'pc': 'platformPC'
  };
  const btnId = platformIdMap[platformLower];
  const btn = document.getElementById(btnId);
  if (btn) {
    const isSelected = window.selectedPlatforms.some(p => p.toLowerCase() === platformLower);
    btn.style.background = isSelected ? '#3b82f6' : 'transparent';
  }
}

// Format platform tag for display (handles any case -> nice display)
function formatPlatformTag(tag) {
  const displayMap = {
    'xbox': 'Xbox',
    'playstation': 'PlayStation',
    'pc': 'PC'
  };
  return displayMap[tag.toLowerCase()] || tag;
}

// Initialize platform buttons on modal open
function initPlatformButtons() {
  const platformIdMap = {
    'xbox': 'platformXbox',
    'playstation': 'platformPlayStation',
    'pc': 'platformPC'
  };

  Object.keys(platformIdMap).forEach(platform => {
    const btn = document.getElementById(platformIdMap[platform]);
    if (btn) {
      const isSelected = window.selectedPlatforms.some(p => p.toLowerCase() === platform);
      btn.style.background = isSelected ? '#3b82f6' : 'transparent';
    }
  });
}

// Settings search functionality
function filterSettings(searchTerm) {
  const cards = document.querySelectorAll('#settingsModal [id$="Card"]');
  const clearBtn = document.getElementById('settingsSearchClear');

  if (clearBtn) {
    clearBtn.style.display = searchTerm ? 'block' : 'none';
  }

  const term = searchTerm.toLowerCase().trim();

  cards.forEach(card => {
    if (!term) {
      card.style.display = '';
      return;
    }

    const text = card.textContent.toLowerCase();
    card.style.display = text.includes(term) ? '' : 'none';
  });
}

function clearSettingsSearch() {
  const input = document.getElementById('settingsSearchInput');
  if (input) {
    input.value = '';
    filterSettings('');
  }
}

function saveCommunityProfile() {
  const communityId = '<%= community._id %>';
  const name = document.getElementById('communityName').value;
  const description = document.getElementById('communityDescription').value;

  if (!name.trim()) {
    showToast('Community name is required.', 3000, 'error');
    return;
  }

  // Show loading state
  const saveBtn = document.querySelector('button[onclick="saveCommunityProfile()"]');
  const originalText = saveBtn.textContent;
  saveBtn.textContent = 'Saving...';
  saveBtn.disabled = true;

  // Get the API URL with fallback
  const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

  fetch(`${apiUrl}/api/v1/community/${communityId}`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      name: name.trim(),
      description: description.trim(),
      visibility: window.selectedPrivacy || '<%= (community && community.community && community.community.visibility) || "public" %>',
      tags: window.selectedPlatforms || []
    })
  })
  .then(res => {
    if (res.ok) {
      // Close the modal
      document.getElementById('settingsModal').style.display = 'none';

      // Show success toast
      showToast('Community profile updated successfully!', 3000, 'success');

      // Update the page title
      document.title = `${name.trim()} - Community Dashboard`;

      // Update the community name in the hero section
      const communityOverviewName = document.getElementById('community-overview-name');
      if (communityOverviewName) {
        communityOverviewName.textContent = name.trim();
      }

      // Update the community description in the hero section
      const communityOverviewDescription = document.getElementById('community-overview-description');
      if (communityOverviewDescription) {
        if (description.trim()) {
          communityOverviewDescription.textContent = description.trim();
          communityOverviewDescription.style.display = '';
        } else {
          communityOverviewDescription.style.display = 'none';
        }
      } else if (description.trim()) {
        // If description element doesn't exist but we have a description, create it
        const heroTextContainer = document.querySelector('#community-overview .flex-1');
        if (heroTextContainer) {
          const descEl = document.createElement('p');
          descEl.id = 'community-overview-description';
          descEl.className = 'text-slate-400 text-sm line-clamp-2';
          descEl.textContent = description.trim();
          heroTextContainer.appendChild(descEl);
        }
      }

      // Update any other elements with data-community-name attribute
      const allCommunityNameElements = document.querySelectorAll('[data-community-name], .community-name-display');
      allCommunityNameElements.forEach(element => {
        element.textContent = name.trim();
      });

      // Update platform tags in the hero section
      const tagsContainer = document.getElementById('community-overview-tags');
      if (tagsContainer) {
        if (window.selectedPlatforms && window.selectedPlatforms.length > 0) {
          tagsContainer.innerHTML = '';
          window.selectedPlatforms.forEach(tag => {
            const tagEl = document.createElement('span');
            tagEl.className = 'badge badge-tag';
            tagEl.textContent = formatPlatformTag(tag);
            tagsContainer.appendChild(tagEl);
          });
          tagsContainer.style.display = '';
        } else {
          tagsContainer.style.display = 'none';
        }
      } else if (window.selectedPlatforms && window.selectedPlatforms.length > 0) {
        // Create tags container if it doesn't exist
        const nameEl = document.getElementById('community-overview-name');
        if (nameEl && nameEl.parentElement) {
          const tagsDiv = document.createElement('div');
          tagsDiv.id = 'community-overview-tags';
          tagsDiv.className = 'flex flex-wrap justify-center sm:justify-start gap-2 mb-3';
          window.selectedPlatforms.forEach(tag => {
            const tagEl = document.createElement('span');
            tagEl.className = 'badge badge-tag';
            tagEl.textContent = formatPlatformTag(tag);
            tagsDiv.appendChild(tagEl);
          });
          nameEl.insertAdjacentElement('afterend', tagsDiv);
        }
      }

      // Update private indicator based on visibility
      const existingIndicator = document.querySelector('.private-indicator');
      const dashboardCard = document.querySelector('#community-overview .dashboard-card');

      if (window.selectedPrivacy === 'private') {
        // Add private indicator if it doesn't exist
        if (!existingIndicator && dashboardCard) {
          const indicator = document.createElement('div');
          indicator.className = 'private-indicator';
          indicator.title = 'This community is private and will not appear in searches across the CAD';
          indicator.style.cssText = 'position: absolute; top: 1rem; right: 1rem; display: flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.75rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 0.5rem; cursor: help; transition: all 0.2s ease;';
          indicator.innerHTML = '<i class="fa fa-lock text-sm" style="color: #ef4444;"></i><span class="text-xs font-medium hidden sm:inline" style="color: #fca5a5;">Private</span>';
          dashboardCard.insertBefore(indicator, dashboardCard.firstChild);
        }
      } else {
        // Remove private indicator if it exists
        if (existingIndicator) {
          existingIndicator.remove();
        }
      }
    } else {
      throw new Error('Failed to update community profile');
    }
  })
  .catch(error => {
    showToast('Failed to update community profile. Please try again.', 3000, 'error');
  })
  .finally(() => {
    // Reset button state
    saveBtn.textContent = originalText;
    saveBtn.disabled = false;
  });
}

// Handle community image upload with live preview
async function handleCommunityImageUpload(event) {
  const file = event.target.files[0];
  if (!file) return;

  // Validate file type
  if (!file.type.startsWith('image/')) {
    showToast('Please select an image file.', 3000, 'error');
    return;
  }

  // Validate file size (max 5MB)
  if (file.size > 5 * 1024 * 1024) {
    showToast('Image size must be less than 5MB.', 3000, 'error');
    return;
  }

  // Show loading state on the image in the modal
  const modalImage = document.getElementById('communityProfileImage');
  if (modalImage) {
    modalImage.style.opacity = '0.5';
  }

  try {
    // Upload to Cloudinary
    const formData = new FormData();
    formData.append('file', file);
    formData.append('upload_preset', window.CLOUDINARY_UPLOAD_PRESET);

    const cloudinaryUrl = `https://api.cloudinary.com/v1_1/${window.CLOUDINARY_CLOUD_NAME}/image/upload`;

    const uploadResponse = await fetch(cloudinaryUrl, {
      method: 'POST',
      body: formData
    });

    if (!uploadResponse.ok) {
      throw new Error('Failed to upload image');
    }

    const uploadData = await uploadResponse.json();
    const imageUrl = uploadData.secure_url;

    // Update community with new image
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

    const updateResponse = await fetch(`${apiUrl}/api/v1/community/${communityId}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        imageLink: imageUrl
      })
    });

    if (!updateResponse.ok) {
      throw new Error('Failed to update community image');
    }

    // Update the modal image
    if (modalImage) {
      modalImage.src = imageUrl;
      modalImage.style.opacity = '1';
    }

    // Update the hero section image
    const heroImage = document.getElementById('community-overview-image');
    if (heroImage) {
      heroImage.src = imageUrl;
    }

    showToast('Community image updated successfully!', 3000, 'success');
  } catch (error) {
    console.error('Error uploading image:', error);
    showToast('Failed to update image. Please try again.', 3000, 'error');

    // Reset modal image opacity
    if (modalImage) {
      modalImage.style.opacity = '1';
    }
  }

  // Clear the file input
  event.target.value = '';
}

