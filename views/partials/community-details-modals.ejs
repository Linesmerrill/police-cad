    const response = await fetch(`${apiUrl}/api/v2/community/${communityId}/transfer-ownership`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        currentUserId: currentUserId,
        newOwnerId: newOwnerId
      }),
    });
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to transfer ownership: ${response.status}`);
    }
    
    // Hide loading overlay
    hideTransferOwnershipLoading();
    
    showToast('Community ownership transferred successfully!', 3000, 'success');
    
    // Refresh the page to reflect the new ownership
