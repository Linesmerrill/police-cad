function validateMaxCiviliansInput(input) {
  const value = parseInt(input.value);
  const errorDiv = document.getElementById('maxCiviliansError');
  const errorText = document.getElementById('maxCiviliansErrorText');
  
  // Reset styling
  input.style.borderColor = '#4a5568';
  
  // Check if value is valid
  if (isNaN(value) || value < 1 || value > 100) {
    // Show error
    input.style.borderColor = '#ef4444';
    errorDiv.style.display = 'block';
    
    if (isNaN(value) || value === '') {
      errorText.textContent = 'Please enter a valid number';
    } else if (value < 1) {
      errorText.textContent = 'Value must be at least 1';
    } else if (value > 100) {
      errorText.textContent = 'Value cannot exceed 100';
    }
  } else {
    // Hide error
    errorDiv.style.display = 'none';
  }
}

