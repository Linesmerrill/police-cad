async function submitRequireEdits() {
  const approvalNotes = document.getElementById('approvalNotesInput').value.trim();
  
  if (!approvalNotes) {
    showToast('Please enter approval notes', 3000, 'error');
    document.getElementById('approvalNotesInput').focus();
    return;
  }
  
  if (!currentCivilianId) {
    showToast('No civilian selected', 3000, 'error');
    return;
  }
  
  const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
  
  try {
    const response = await fetch(`${apiUrl}/api/v1/civilian/admin-approval`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        civilianId: currentCivilianId,
        communityId: '<%= community._id %>',
        adminId: '<%= user && user._doc ? user._doc._id : "" %>',
        action: 'require_edits',
        notes: approvalNotes
      })
    });
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || 'Failed to submit require edits');
    }
    
    showToast('Edits required successfully', 3000, 'success');
    closeRequireEditsModal();
    closeCivilianDetailsModal();
    loadCivilianApprovals(); // Refresh the list
  } catch (error) {
    console.error('Error submitting require edits:', error);
    showToast('Error submitting require edits: ' + error.message, 3000, 'error');
  }
}

