async function saveCivilianDetails() {
  if (!currentCivilianId) {
    showToast('No civilian selected', 3000, 'error');
    return;
  }
  
  // Validate required fields
  const name = document.getElementById('civDetailsName').value.trim();
  const birthday = document.getElementById('civDetailsBirthday').value.trim();
  
  if (!name) {
    showToast('Name is required', 3000, 'error');
    document.getElementById('civDetailsName').focus();
    return;
  }
  
  if (!birthday) {
    showToast('Date of birth is required', 3000, 'error');
    document.getElementById('civDetailsBirthday').focus();
    return;
  }
  
  const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
  
  // Calculate height and weight based on selected units
  let height = '';
  let heightClassification = 'Imperial';
  let weight = '';
  let weightClassification = 'lbs';
  
  // Height calculation
  if (document.getElementById('civDetailsImperialHeight').classList.contains('active')) {
    const feet = parseInt(document.getElementById('civDetailsHeightFoot').value) || 0;
    const inches = parseInt(document.getElementById('civDetailsHeightInches').value) || 0;
    height = (feet * 12 + inches).toString();
    heightClassification = 'Imperial';
  } else {
    height = document.getElementById('civDetailsHeightCm').value;
    heightClassification = 'Metric';
  }
  
  // Weight calculation
  if (document.getElementById('civDetailsImperialWeight').classList.contains('active')) {
    weight = document.getElementById('civDetailsWeightLbs').value;
    weightClassification = 'lbs';
  } else {
    weight = document.getElementById('civDetailsWeightKg').value;
    weightClassification = 'kg';
  }
  
  const updatedData = {
    name: name,
    birthday: birthday,
    gender: document.getElementById('civDetailsGender').value,
    hairColor: document.getElementById('civDetailsHairColor').value,
    eyeColor: document.getElementById('civDetailsEyeColor').value,
    address: document.getElementById('civDetailsAddress').value,
    occupation: document.getElementById('civDetailsOccupation').value,
    height: height,
    heightClassification: heightClassification,
    weight: weight,
    weightClassification: weightClassification,
    organDonor: document.getElementById('civDetailsOrganDonor').checked,
    veteran: document.getElementById('civDetailsVeteran').checked,
    onProbation: document.getElementById('civDetailsOnProbation').checked,
    onParole: document.getElementById('civDetailsOnParole').checked,
    image: currentPhotoUrl || document.getElementById('civDetailsPhoto').src || ''
  };
  
  try {
    const response = await fetch(`${apiUrl}/api/v1/civilian/${currentCivilianId}`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(updatedData)
    });
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || 'Failed to update civilian');
    }
    
    showToast('Civilian details updated successfully!', 3000, 'success');
    closeCivilianDetailsModal();
    
    // Refresh the civilian approvals list
    loadCivilianApprovals(currentApprovalsPage);
    
  } catch (error) {
    console.error('Error updating civilian:', error);
    showToast('Error updating civilian: ' + error.message, 3000, 'error');
  }
}

