  currentRole = null;
}

function saveRoleName() {
  const newName = document.getElementById('editRoleName').value.trim();
  if (!newName || !currentRole) return;
  
  updateRoleName(currentRole._id, newName);
}

async function updateRoleName(roleId, newName) {
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/roles/${roleId}/name`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ name: newName }),
    });
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to update role name: ${response.status}`);
    }
    
    showToast('Role name updated successfully!', 3000, 'success');
    currentRole.name = newName;
    document.getElementById('roleDetailsTitle').textContent = newName;
    document.getElementById('saveRoleNameBtn').style.display = 'none';
    
    // Refresh the main roles list
    loadRoles();
    
  } catch (error) {
    showToast(`Failed to update role name: ${error.message}`, 3000, 'error');
  }
}

