// Helper function for proper singular/plural formatting
function formatCount(count, singular, plural) {
  return count === 1 ? `${count} ${singular}` : `${count} ${plural}`;
}

// Global variables for role creation flow
let newRoleData = {
  name: '',
  members: []
};
let createRoleMembersData = [];
let createRoleCurrentPage = 1;
let createRoleSearchQuery = '';
let selectedMembersData = new Map(); // Store member data by ID for better display

async function createRole() {
  const roleName = document.getElementById('newRoleName').value.trim();
  const errorDiv = document.getElementById('createRoleError');
  
  if (!roleName) {
    errorDiv.textContent = 'Role name is required';
    errorDiv.style.display = 'block';
    return;
  }
  
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/roles`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ name: roleName }),
    });
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to create role: ${response.status}`);
    }
    
    const data = await response.json();
    newRoleData.name = roleName;
    newRoleData._id = data._id || data.id;
    
    // Go to step 2
    goToStep2();
    
  } catch (error) {
    errorDiv.textContent = `Failed to create role: ${error.message}`;
    errorDiv.style.display = 'block';
  }
}

async function goToStep2() {
  const roleName = document.getElementById('newRoleName').value.trim();
  
  if (!roleName) {
    showToast('Please enter a role name', 3000, 'error');
    return;
  }
  
  try {
    // Show loading state
    const nextBtn = document.getElementById('createRoleBtn');
    if (!nextBtn) {
      throw new Error('Button not found');
    }
    const originalText = nextBtn.innerHTML;
    nextBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Creating Role...';
    nextBtn.disabled = true;
    
    // Create the role first
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/roles`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ name: roleName })
    });
    
    if (!response.ok) {
      const errorData = await response.json();
      throw new Error(errorData.message || 'Failed to create role');
    }
    
    const createdRole = await response.json();
    console.log('Role creation response:', createdRole); // Debug log
    
    // Store role data and proceed to step 2
    newRoleData = {
      _id: createdRole.role_id, // Store the actual role ID from response
      name: roleName,
      members: []
    };
    
    console.log('Stored role data:', newRoleData); // Debug log
    
    document.getElementById('createRoleStep1').style.display = 'none';
    document.getElementById('createRoleStep2').style.display = 'block';
    
    // Load community members for selection
    loadCreateRoleMembers();
    
  } catch (error) {
    console.error('Error creating role:', error);
    showToast(`Failed to create role: ${error.message}`, 3000, 'error');
    
    // Reset button state
    const nextBtn = document.getElementById('createRoleBtn');
    if (nextBtn) {
      nextBtn.innerHTML = originalText;
      nextBtn.disabled = false;
    }
  }
}

function goBackToStep1() {
  document.getElementById('createRoleStep2').style.display = 'none';
  document.getElementById('createRoleStep1').style.display = 'block';
  
  // Reset step 2 data
  newRoleData.members = [];
  createRoleMembersData = [];
  createRoleCurrentPage = 1;
  createRoleSearchQuery = '';
  selectedMembersData.clear(); // Clear stored member data
  updateSelectedMembersDisplay();
}

async function loadCreateRoleMembers() {
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/members?page=${createRoleCurrentPage}&limit=20`);
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to fetch members: ${response.status}`);
    }
    
    const data = await response.json();
    createRoleMembersData = data.members || [];
    
    renderCreateRoleMembersList();
    renderCreateRolePagination(data);
    
  } catch (error) {
    showToast(`Failed to load members: ${error.message}`, 3000, 'error');
  }
}

function renderCreateRoleMembersList() {
  const membersList = document.getElementById('createRoleMembersList');
  
  if (createRoleMembersData.length === 0) {
    membersList.innerHTML = `
      <div style="text-align:center; padding:2rem; color:#a0aec0;">
        <i class="fa fa-users" style="font-size:2rem; margin-bottom:1rem; opacity:0.5;"></i>
        <p>No members found</p>
      </div>
    `;
    return;
  }
  
  // Filter members based on search query
  const filteredMembers = createRoleSearchQuery ? 
    createRoleMembersData.filter(member => 
      (member.user?.username || '').toLowerCase().includes(createRoleSearchQuery.toLowerCase()) ||
      (member.user?.email || '').toLowerCase().includes(createRoleSearchQuery.toLowerCase())
    ) : createRoleMembersData;
  
  membersList.innerHTML = filteredMembers.map(member => {
    const memberId = member._id;
    const username = member.user?.username || member.user?.email || memberId;
    const profilePicture = member.user?.profilePicture;
    const isSelected = newRoleData.members.includes(memberId);
    
    return `
      <div style="display:flex; justify-content:space-between; align-items:center; padding:1rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; margin-bottom:1rem;">
        <div style="display:flex; align-items:center; gap:1rem;">
          <div style="width:40px; height:40px; border-radius:50%; background:#4a5568; display:flex; align-items:center; justify-content:center; overflow:hidden;">
            ${profilePicture ? 
              `<img src="${profilePicture}" alt="${username}" style="width:100%; height:100%; object-fit:cover;">` : 
              `<i class="fa fa-user" style="color:#a0aec0;"></i>`
            }
          </div>
          <span style="color:#fff; font-weight:500;">${username}</span>
        </div>
        <button onclick="toggleMemberSelection('${memberId}')" style="background:${isSelected ? '#10b981' : '#4a5568'}; color:#fff; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:pointer;">
          ${isSelected ? '<i class="fa fa-check"></i>' : '<i class="fa fa-plus"></i>'}
        </button>
      </div>
    `;
  }).join('');
}

function renderCreateRolePagination(data) {
  const paginationDiv = document.getElementById('createRolePagination');
  const totalPages = Math.ceil((data.totalUsers || 0) / 20);
  
  if (totalPages <= 1) {
    paginationDiv.style.display = 'none';
    return;
  }
  
  paginationDiv.style.display = 'block';
  paginationDiv.innerHTML = `
    <div style="display:flex; gap:0.5rem; justify-content:center; align-items:center;">
      <button onclick="changeCreateRolePage(${createRoleCurrentPage - 1})" ${createRoleCurrentPage <= 1 ? 'disabled' : ''} style="background:#4a5568; color:#fff; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:pointer; ${createRoleCurrentPage <= 1 ? 'opacity:0.5; cursor:not-allowed;' : ''}">
        <i class="fa fa-chevron-left"></i> Previous
      </button>
      <span style="color:#a0aec0; padding:0 1rem;">Page ${createRoleCurrentPage} of ${totalPages}</span>
      <button onclick="changeCreateRolePage(${createRoleCurrentPage + 1})" ${createRoleCurrentPage >= totalPages ? 'disabled' : ''} style="background:#4a5568; color:#fff; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:pointer; ${createRoleCurrentPage >= totalPages ? 'opacity:0.5; cursor:not-allowed;' : ''}">
        Next <i class="fa fa-chevron-right"></i>
      </button>
    </div>
  `;
}

function changeCreateRolePage(page) {
  if (page < 1) return;
  createRoleCurrentPage = page;
  loadCreateRoleMembers();
}

function toggleMemberSelection(memberId) {
  const index = newRoleData.members.indexOf(memberId);
  
  if (index > -1) {
    // Remove member
    newRoleData.members.splice(index, 1);
    selectedMembersData.delete(memberId); // Remove from stored data
  } else {
    // Add member (check limit)
    if (newRoleData.members.length >= 30) {
      showToast('You can only select up to 30 members at a time', 3000, 'error');
      return;
    }
    newRoleData.members.push(memberId);
    
    // Store member data for display
    const member = createRoleMembersData.find(m => m._id === memberId);
    if (member) {
      selectedMembersData.set(memberId, {
        username: member.user?.username || member.user?.email || 'Unknown User',
        email: member.user?.email || '',
        profilePicture: member.user?.profilePicture || ''
      });
    }
  }
  
  updateSelectedMembersDisplay();
  renderCreateRoleMembersList(); // Refresh the list to update button states
}

function getStoredMemberData(memberId) {
  return selectedMembersData.get(memberId);
}

function updateSelectedMembersDisplay() {
  const displayDiv = document.getElementById('selectedMembersDisplay');
  const countSpan = document.getElementById('selectedCount');
  const listDiv = document.getElementById('selectedMembersList');
  const finishBtn = document.getElementById('finishCreateRole');
  
  if (newRoleData.members.length === 0) {
    displayDiv.style.display = 'none';
    finishBtn.disabled = true;
    finishBtn.style.opacity = '0.5';
    return;
  }
  
  displayDiv.style.display = 'block';
  countSpan.textContent = newRoleData.members.length;
  
  // Render selected members list
  listDiv.innerHTML = newRoleData.members.map(memberId => {
    // Get stored member data (this should always have the username)
    const storedMember = getStoredMemberData(memberId);
    let username = 'Unknown User';
    
    if (storedMember) {
      username = storedMember.username;
    } else {
      // Fallback - try to get from current page data
      const member = createRoleMembersData.find(m => m._id === memberId);
      if (member) {
        username = member.user?.username || member.user?.email || 'Unknown User';
        // Store this data for future use
        selectedMembersData.set(memberId, {
          username: username,
          email: member.user?.email || '',
          profilePicture: member.user?.profilePicture || ''
        });
      } else {
        // Last resort - show truncated ID
        username = `User ${memberId.slice(-6)}`;
      }
    }
    
    return `
      <div style="display:flex; align-items:center; gap:0.5rem; background:#4a5568; padding:0.25rem 0.5rem; border-radius:6px; color:#fff; font-size:0.875rem;">
        <span>${username}</span>
        <button onclick="toggleMemberSelection('${memberId}')" style="background:none; border:none; color:#a0aec0; cursor:pointer; padding:0; font-size:0.75rem;">
          <i class="fa fa-times"></i>
        </button>
      </div>
    `;
  }).join('');
  
  // Enable finish button
  finishBtn.disabled = false;
  finishBtn.style.opacity = '1';
}

function skipAddMembers() {
  // Close modal and show success message
  showToast('Role created successfully!', 3000, 'success');
  closeCreateRoleModal();
  loadRoles(); // Refresh the roles list
}

async function finishCreateRole() {
  if (newRoleData.members.length === 0) {
    showToast('Please select at least one member', 3000, 'error');
    return;
  }
  
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    // Add all selected members to the role
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/roles/${newRoleData._id}/members`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(newRoleData.members), // Send array directly, not wrapped in object
    });
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to add members: ${response.status}`);
    }
    
    showToast('Role created successfully with members!', 3000, 'success');
    closeCreateRoleModal();
    refreshRolesModal(); // Refresh the roles modal to show new role
    
  } catch (error) {
    showToast(`Failed to add members: ${error.message}`, 3000, 'error');
  }
}

// Role Details Functions
