      function saveFineSettings() {
        let currency = document.getElementById('fineCurrency').value;
        
        // Handle custom currency
        if (currency === 'custom') {
          const customCurrency = document.getElementById('customCurrency').value.trim();
          if (!customCurrency) {
            showToast('Please enter a custom currency value', 3000, 'error');
            return;
          }
          currency = customCurrency;
        }
        
        const categories = [];
        
        // Collect all category data using class selectors
        const categoryDivs = document.querySelectorAll('#fineCategoriesContainer .fine-category');
        categoryDivs.forEach(categoryDiv => {
          const categoryNameInput = categoryDiv.querySelector('.category-name');
          if (categoryNameInput) {
            const categoryName = categoryNameInput.value.trim();
            if (categoryName) {
              const fines = [];
              const fineItems = categoryDiv.querySelectorAll('.fine-item');
              
              fineItems.forEach(fineItem => {
                const fineNameInput = fineItem.querySelector('.fine-name');
                const fineAmountInput = fineItem.querySelector('.fine-amount');
                
                if (fineNameInput && fineAmountInput) {
                  const fineName = fineNameInput.value.trim();
                  const fineAmount = parseFloat(fineAmountInput.value);
                  
                  if (fineName && !isNaN(fineAmount)) {
                    fines.push({
                      name: fineName,
                      amount: fineAmount
                    });
                  }
                }
              });
              
              categories.push({
                name: categoryName,
                fines: fines
              });
            }
          }
        });
        
        const fineSettings = {
          categories: categories,
          currency: currency
        };
        
        // Send to API
        const communityId = '<%= community._id %>';
        const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
        
        fetch(`${apiUrl}/api/v1/community/${communityId}/fines`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(fineSettings)
        })
        .then(res => res.json())
        .then(data => {
          if (data.success || (data.message && data.message.toLowerCase().includes('successfully'))) {
            showToast('Fine settings updated successfully!', 3000, 'success');
            
            // Update the original data to reflect the saved state
            window.originalFineCategories = getCurrentCategoriesFromDOM();
            window.originalCurrency = currency;
            
            // Close modal after successful save
            closeFineSettingsModal();
          } else {
            throw new Error(data.message || 'Failed to update fine settings');
          }
        })
        .catch(err => {
          showToast('Error updating fine settings: ' + err.message, 3000, 'error');
        });
      }

