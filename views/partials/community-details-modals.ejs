  if (permissionsSearchInput) {
    permissionsSearchInput.addEventListener('input', function(e) {
      const query = e.target.value;
      const clearBtn = document.getElementById('permissionsSearchClear');
      
      if (query.trim()) {
        clearBtn.style.display = 'block';
      } else {
        clearBtn.style.display = 'none';
      }
      
      // Re-render permissions with search filter
      if (currentRole) {
        renderPermissionsList();
      }
    });
  }
  
  // Member search input for role creation
  const memberSearchInput = document.getElementById('memberSearchInput');
  if (memberSearchInput) {
    memberSearchInput.addEventListener('input', function(e) {
      createRoleSearchQuery = e.target.value;
