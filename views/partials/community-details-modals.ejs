  const editRoleName = document.getElementById('editRoleName');
  if (editRoleName) {
    editRoleName.addEventListener('input', function() {
      const saveBtn = document.getElementById('saveRoleNameBtn');
      if (this.value.trim() !== currentRole?.name) {
        saveBtn.style.display = 'inline-block';
      } else {
        saveBtn.style.display = 'none';
      }
    });
