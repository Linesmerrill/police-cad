async function deleteRole(roleId) {
  // Check if this is a head admin role - prevent API call
  const isHeadAdmin = (currentRole.permissions || []).some(p => 
    p.name === 'administrator' && p.description === 'Head Admin' && p.enabled
  );
  
  if (isHeadAdmin) {
    showToast('Head Admin role cannot be deleted', 3000, 'error');
    return;
  }
  
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/roles/${roleId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      },
    });
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to delete role: ${response.status}`);
    }
    
    showToast('Role deleted successfully!', 3000, 'success');
    closeRoleDetailsModal();
    loadRoles(); // Refresh the list
    
  } catch (error) {
    showToast(`Failed to delete role: ${error.message}`, 3000, 'error');
  }
}

