      function refreshGeneralSettings() {
        // Refresh community data from server and then load general settings
        const communityId = '<%= community._id %>';
        const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
        
        fetch(`${apiUrl}/api/v1/community/${communityId}`)
          .then(res => res.json())
          .then(data => {
            if (data.community) {
              // Update the page data with fresh information
              window.currentCommunityData = data.community;
              
              // Reload general settings with fresh data
              loadGeneralSettingsFromData(data.community);
            } else {
              console.error('Failed to refresh community data');
              // Fallback to loading from page data
              loadGeneralSettings();
            }
          })
          .catch(error => {
            console.error('Error refreshing general settings:', error);
            // Fallback to loading from page data
            loadGeneralSettings();
          });
      }

