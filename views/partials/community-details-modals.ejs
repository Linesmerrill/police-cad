// Bans Management Functions
let bansData = [];
let filteredBans = [];

// Member Management Global Variables
let selectedMemberId = null;
let selectedMemberUsername = null;

function openBansModal() {
  document.getElementById('bansModal').style.display = 'flex';
  loadBans();
}

function closeBansModal() {
  document.getElementById('bansModal').style.display = 'none';
  bansData = [];
  filteredBans = [];
}

async function loadBans() {
  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    const response = await fetch(`${apiUrl}/api/v2/community/${communityId}/banned-users`);
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to fetch banned users: ${response.status}`);
    }
    
    const data = await response.json();
    
    // Handle new v2 API response structure
    if (data.bannedUsers && Array.isArray(data.bannedUsers)) {
      bansData = data.bannedUsers;
      filteredBans = [...bansData];
      
      // Update count with proper singular/plural
      const bansCount = document.getElementById('bansCount');
      const bansCountText = document.getElementById('bansCountText');
      const totalCount = data.pagination?.totalCount || bansData.length;
      bansCount.textContent = totalCount;
      bansCountText.textContent = totalCount === 1 ? 'banned user' : 'banned users';
    } else {
      bansData = [];
      filteredBans = [];
      
      const bansCount = document.getElementById('bansCount');
      const bansCountText = document.getElementById('bansCountText');
      bansCount.textContent = '0';
      bansCountText.textContent = 'banned users';
    }
    
    // Render bans
    renderBansList();
    
  } catch (error) {
    showToast(`Failed to load banned users: ${error.message}`, 3000, 'error');
  }
}

function renderBansList() {
  const loadingDiv = document.getElementById('bansLoading');
  const listContainer = document.getElementById('bansListContainer');
  const emptyState = document.getElementById('bansEmptyState');
  const bansList = document.getElementById('bansList');
  
  // Hide loading
  loadingDiv.style.display = 'none';
  
  if (filteredBans.length === 0) {
    emptyState.style.display = 'block';
    listContainer.style.display = 'none';
    return;
  }
  
  emptyState.style.display = 'none';
  listContainer.style.display = 'block';
  
  bansList.innerHTML = filteredBans.map(bannedUser => {
    const username = bannedUser.username || 'Unknown User';
    const callSign = bannedUser.callSign || '';
    const profilePicture = bannedUser.profilePicture;
    const isVerified = bannedUser.isVerified;
    
    return `
      <div style="display:flex; justify-content:space-between; align-items:center; padding:1rem; background:#2d3748; border:1px solid #4a5568; border-radius:8px; margin-bottom:1rem;">
        <div style="display:flex; align-items:center; gap:1rem;">
          <div style="width:50px; height:50px; border-radius:50%; background:#4a5568; display:flex; align-items:center; justify-content:center; overflow:hidden;">
            ${profilePicture ? 
              `<img src="${profilePicture}" alt="${username}" style="width:100%; height:100%; object-fit:cover;">` : 
              `<i class="fa fa-user" style="color:#a0aec0; font-size:1.5rem;"></i>`
            }
          </div>
          <div>
            <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
              <h4 style="color:#fff; margin:0; font-size:1.125rem; font-weight:600;">${username}</h4>
              ${isVerified ? `<i class="fa fa-check-circle" style="color:#3b82f6; font-size:1rem;"></i>` : ''}
            </div>
            ${callSign ? `<p style="color:#a0aec0; margin:0; font-size:0.875rem;">Call Sign: ${callSign}</p>` : ''}
          </div>
        </div>
        <button onclick="unbanUser('${bannedUser.id}')" style="background:#10b981; color:#fff; border:none; padding:0.5rem 1rem; border-radius:6px; font-weight:500; cursor:pointer; transition:all 0.2s; hover:background:#059669;">
          <i class="fa fa-user-check" style="margin-right:0.5rem;"></i>
          Unban
        </button>
      </div>
    `;
  }).join('');
}

function searchBans(query) {
  if (!query.trim()) {
    filteredBans = [...bansData];
  } else {
    const searchLower = query.toLowerCase();
    filteredBans = bansData.filter(bannedUser => 
      (bannedUser.username || '').toLowerCase().includes(searchLower) ||
      (bannedUser.callSign || '').toLowerCase().includes(searchLower)
    );
  }
  renderBansList();
}

function clearBansSearch() {
  const searchInput = document.getElementById('bansSearchInput');
  const clearBtn = document.getElementById('bansSearchClear');
  
  searchInput.value = '';
  clearBtn.style.display = 'none';
  searchBans('');
}

function unbanUser(userId) {
  // Find the user details for the confirmation message
  const bannedUser = bansData.find(user => user.id === userId);
  const username = bannedUser ? bannedUser.username : 'this user';
  
  // Show the custom unban confirmation modal
  showUnbanConfirmModal(username, userId);
}

