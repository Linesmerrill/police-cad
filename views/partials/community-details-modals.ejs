      // ═══════════════════════════════════════
      //  PENAL CODES SETTINGS MODAL
      // ═══════════════════════════════════════
      var pcSettingsData = [];       // categories array
      var pcSettingsCurrency = 'USD';
      var pcSettingsCurrencies = []; // currencies array for API
      var pcSettingsOriginal = '';   // JSON snapshot for dirty check
      var pcSettingsViolationCallback = null; // callback from sub-modal

      var pcCurrencySymbolMap = {
        'USD': '$', 'EUR': '€', 'GBP': '£', 'CAD': 'C$', 'AUD': 'A$'
      };

      var pcmAccents = [
        { accent: '#8b5cf6', bg: 'rgba(139,92,246,0.12)' },
        { accent: '#3b82f6', bg: 'rgba(59,130,246,0.12)' },
        { accent: '#fbbf24', bg: 'rgba(251,191,36,0.12)' },
        { accent: '#ef4444', bg: 'rgba(239,68,68,0.12)' },
        { accent: '#10b981', bg: 'rgba(16,185,129,0.12)' },
        { accent: '#ec4899', bg: 'rgba(236,72,153,0.12)' },
        { accent: '#f97316', bg: 'rgba(249,115,22,0.12)' },
        { accent: '#06b6d4', bg: 'rgba(6,182,212,0.12)' },
      ];
      var pcmCatIcons = ['fa-shield-halved','fa-car','fa-gun','fa-people-group','fa-cannabis','fa-gavel','fa-handcuffs','fa-building-columns'];

      function pcSettingsGetSymbol(code) {
        return pcCurrencySymbolMap[code] || code || '$';
      }

      function updatePcCurrencyDisplay() {
        var sym = pcSettingsGetSymbol(pcSettingsCurrency);
        document.getElementById('pcmCurrencySym').textContent = sym;
        document.getElementById('pcmCurrencyCode').textContent = pcSettingsCurrency;
      }

      function loadPenalCodeSettings() {
        var communityId = '<%= community._id %>';
        var apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

        fetch(apiUrl + '/api/v1/community/' + communityId + '/penal-codes')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            pcSettingsData = (data && data.categories) || [];
            pcSettingsCurrency = (data && data.currency) || 'USD';
            pcSettingsCurrencies = (data && data.currencies) || [];

            // Build symbol map from currencies array
            if (pcSettingsCurrencies.length > 0) {
              pcSettingsCurrencies.forEach(function(c) {
                pcCurrencySymbolMap[c.code] = c.symbol;
              });
            }

            updatePcCurrencyDisplay();
            pcSettingsOriginal = JSON.stringify({ categories: pcSettingsData, currency: pcSettingsCurrency });
            renderPcCategories(pcSettingsData);
            document.getElementById('pcSettingsLoading').style.display = 'none';
          })
          .catch(function(err) {
            console.error('[PenalCodesSettings] Load error:', err);
            document.getElementById('pcSettingsLoading').style.display = 'none';
            document.getElementById('pcCategoriesContainer').innerHTML =
              '<div class="pcm-empty-state"><i class="fa fa-exclamation-circle"></i><p>Failed to load penal codes.</p><p class="sub">Please try again.</p></div>';
          });
      }

      // ── Currency Picker ──

      function openPcCurrencyPicker() {
        var currencies = [
          { code: 'USD', sym: '$', label: 'US Dollar' },
          { code: 'EUR', sym: '€', label: 'Euro' },
          { code: 'GBP', sym: '£', label: 'British Pound' },
          { code: 'CAD', sym: 'C$', label: 'Canadian Dollar' },
          { code: 'AUD', sym: 'A$', label: 'Australian Dollar' },
        ];
        var html = '';
        currencies.forEach(function(c) {
          var active = c.code === pcSettingsCurrency ? ' active' : '';
          html += '<div class="pcm-cur-item' + active + '" onclick="selectPcCurrency(\'' + c.code + '\',\'' + escAttr(c.sym) + '\')">' +
            '<span class="sym">' + escHtml(c.sym) + '</span><span class="label">' + escHtml(c.label) + ' (' + c.code + ')</span></div>';
        });
        document.getElementById('pcCurrencyPickerList').innerHTML = html;
        document.getElementById('pcCurrencyCustomInput').value = '';
        document.getElementById('pcCurrencyPicker').style.display = 'flex';
      }

      function closePcCurrencyPicker() {
        document.getElementById('pcCurrencyPicker').style.display = 'none';
      }

      function selectPcCurrency(code, sym) {
        pcSettingsCurrency = code;
        pcCurrencySymbolMap[code] = sym;
        updatePcCurrencyDisplay();
        closePcCurrencyPicker();
        renderPcCategories(pcSettingsData);
      }

      function setPcCustomCurrency() {
        var val = document.getElementById('pcCurrencyCustomInput').value.trim().toUpperCase();
        if (!val) return;
        pcSettingsCurrency = val;
        updatePcCurrencyDisplay();
        closePcCurrencyPicker();
        renderPcCategories(pcSettingsData);
      }

      function renderPcCategories(categories) {
        var container = document.getElementById('pcCategoriesContainer');
        container.innerHTML = '';

        if (!categories || categories.length === 0) {
          container.innerHTML = '<div class="pcm-empty-state"><i class="fa fa-scale-balanced"></i><p>No penal code categories yet.</p><p class="sub">Click "+ Category" above to get started.</p></div>';
          return;
        }

        var sym = pcSettingsGetSymbol(pcSettingsCurrency);

        categories.forEach(function(cat, catIdx) {
          var violations = cat.violations || [];
          var accent = pcmAccents[catIdx % pcmAccents.length];
          var icon = cat.icon || pcmCatIcons[catIdx % pcmCatIcons.length];
          var vioCount = violations.length;
          var countLabel = vioCount === 1 ? '1 violation' : vioCount + ' violations';

          // When rendering filtered results, fall back to the original index recorded
          // on each filtered item so edit/delete handlers mutate the correct slot in pcSettingsData.
          var realCatIdx = (typeof cat.__origCatIdx === 'number') ? cat.__origCatIdx : catIdx;

          // Table body
          var tbody = '';
          if (violations.length === 0) {
            tbody = '<tr><td colspan="5" class="pcm-empty-cat">No violations — click "Add" to create one.</td></tr>';
          } else {
            violations.forEach(function(v, vIdx) {
              var realVioIdx = (typeof v.__origVioIdx === 'number') ? v.__origVioIdx : vIdx;
              var fineDisplay = v.fine ? escHtml(sym) + Number(v.fine).toLocaleString() : '—';
              tbody +=
                '<tr data-cat="' + realCatIdx + '" data-vio="' + realVioIdx + '">' +
                  '<td class="pcm-v-name">' + escHtml(v.name) + '</td>' +
                  '<td class="pcm-v-jail">' + escHtml(v.jailTime || '—') + '</td>' +
                  '<td class="pcm-v-fine">' + fineDisplay + '</td>' +
                  '<td class="pcm-v-expl">' + escHtml(v.explanation || '') + '</td>' +
                  '<td class="pcm-v-actions">' +
                    '<button class="pcm-icon-btn" onclick="editPcViolation(' + realCatIdx + ',' + realVioIdx + ')" title="Edit"><i class="fa fa-pen"></i></button>' +
                    '<button class="pcm-icon-btn danger" onclick="removePcViolation(' + realCatIdx + ',' + realVioIdx + ')" title="Delete"><i class="fa fa-trash"></i></button>' +
                  '</td>' +
                '</tr>';
            });
          }

          var catHtml =
            '<div class="pcm-cat" data-cat-idx="' + realCatIdx + '" style="--pcm-accent:' + accent.accent + ';--pcm-icon-bg:' + accent.bg + ';">' +
              '<div class="pcm-cat-header" onclick="togglePcCategory(this)">' +
                '<div class="pcm-cat-left">' +
                  '<i class="fa fa-chevron-down pcm-cat-chevron open"></i>' +
                  '<div class="pcm-cat-icon"><i class="fa ' + escAttr(icon) + '"></i></div>' +
                  '<input class="pcm-cat-name-input" value="' + escAttr(cat.name) + '" placeholder="Category Name" onclick="event.stopPropagation()" onkeydown="if(event.key===\'Enter\')this.blur()">' +
                  '<span class="pcm-cat-count">' + countLabel + '</span>' +
                '</div>' +
                '<div class="pcm-cat-actions" onclick="event.stopPropagation()">' +
                  '<button class="pcm-add-vio" onclick="addPcViolation(' + realCatIdx + ')"><i class="fa fa-plus"></i> Add</button>' +
                  '<button class="pcm-icon-btn danger" onclick="removePcCategory(' + realCatIdx + ')" title="Delete category"><i class="fa fa-trash"></i></button>' +
                '</div>' +
              '</div>' +
              '<div class="pcm-cat-body open">' +
                '<table class="pcm-table">' +
                  '<thead><tr>' +
                    '<th>Violation</th><th>Jail Time</th><th>Fine</th><th>Explanation</th><th></th>' +
                  '</tr></thead>' +
                  '<tbody>' + tbody + '</tbody>' +
                '</table>' +
              '</div>' +
            '</div>';

          container.insertAdjacentHTML('beforeend', catHtml);
        });
      }

      function togglePcCategory(headerEl) {
        var chevron = headerEl.querySelector('.pcm-cat-chevron');
        var body = headerEl.nextElementSibling;
        if (body.classList.contains('open')) {
          body.classList.remove('open');
          chevron.classList.remove('open');
        } else {
          body.classList.add('open');
          chevron.classList.add('open');
        }
      }

      function syncPcCategoryNames() {
        var catDivs = document.querySelectorAll('#pcCategoriesContainer .pcm-cat');
        catDivs.forEach(function(catDiv) {
          var catIdx = parseInt(catDiv.getAttribute('data-cat-idx'), 10);
          var nameInput = catDiv.querySelector('.pcm-cat-name-input');
          if (pcSettingsData[catIdx] && nameInput) {
            pcSettingsData[catIdx].name = nameInput.value.trim();
          }
        });
      }

      function escHtml(str) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(str || ''));
        return d.innerHTML;
      }

      function escAttr(str) {
        return (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function addPcCategory() {
        syncPcCategoryNames();
        pcSettingsData.push({ name: '', violations: [] });
        renderPcCategories(pcSettingsData);
        // Focus the new category name input
        var cats = document.querySelectorAll('#pcCategoriesContainer .pcm-cat');
        if (cats.length > 0) {
          var lastCat = cats[cats.length - 1];
          var input = lastCat.querySelector('.pcm-cat-name-input');
          if (input) input.focus();
        }
      }

      function removePcCategory(catIdx) {
        syncPcCategoryNames();
        var catName = pcSettingsData[catIdx] ? pcSettingsData[catIdx].name : 'this category';
        showCustomConfirm(
          'Remove Category',
          'Delete "' + (catName || 'Unnamed') + '" and all its violations?',
          function() {
            pcSettingsData.splice(catIdx, 1);
            renderPcCategories(pcSettingsData);
          }
        );
      }

      // — Violation sub-modal —

      function addPcViolation(catIdx) {
        syncPcCategoryNames();
        var titleSpan = document.querySelector('#pcViolationModalTitle span');
        if (titleSpan) titleSpan.textContent = 'Add Violation';
        document.getElementById('pcViolationSubmitText').textContent = 'Add Violation';
        document.getElementById('pcVioName').value = '';
        document.getElementById('pcVioJailTime').value = '';
        document.getElementById('pcVioFine').value = '';
        document.getElementById('pcVioExplanation').value = '';
        document.getElementById('pcVioName').classList.remove('pcm-input-error');
        document.getElementById('pcVioJailTime').classList.remove('pcm-input-error');
