// Invite codes management functions
let inviteCodesData = [];
let inviteCodesPagination = { currentPage: 1, totalPages: 1, totalCount: 0, hasNextPage: false, hasPrevPage: false, limit: 10 };
let expiredCodesCount = 0;

async function loadInviteCodes(page = 1) {
  const listContainer = document.getElementById('inviteCodesList');
  const loadingDiv = document.getElementById('inviteCodesLoading');
  const emptyDiv = document.getElementById('inviteCodesEmpty');
  const expiredHelper = document.getElementById('expiredCodesHelper');
  const paginationDiv = document.getElementById('inviteCodesPagination');

  if (loadingDiv) loadingDiv.style.display = 'block';
  if (listContainer) listContainer.innerHTML = '';
  if (emptyDiv) emptyDiv.style.display = 'none';
  if (expiredHelper) expiredHelper.style.display = 'none';
  if (paginationDiv) paginationDiv.style.display = 'none';

  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

    const response = await fetch(`${apiUrl}/api/v2/community/${communityId}/invite-codes?page=${page}&limit=10`);
    if (!response.ok) throw new Error('Failed to load invite codes');

    const data = await response.json();
    inviteCodesData = data.inviteCodes || [];
    inviteCodesPagination = data.pagination || { currentPage: 1, totalPages: 1, totalCount: 0, hasNextPage: false, hasPrevPage: false, limit: 10 };

    // Get total expired codes count from API (across all pages)
    expiredCodesCount = data.expiredCount || 0;

    if (loadingDiv) loadingDiv.style.display = 'none';

    if (inviteCodesData.length === 0) {
      if (emptyDiv) emptyDiv.style.display = 'block';
      if (listContainer) listContainer.style.display = 'none';
      return;
    }

    // Show expired codes helper if there are expired codes
    if (expiredCodesCount > 0 && expiredHelper) {
      const countSpan = document.getElementById('expiredCodesCount');
      if (countSpan) countSpan.textContent = expiredCodesCount;
      expiredHelper.style.display = 'block';
    }

    renderInviteCodes();
    renderInviteCodesPagination();
  } catch (error) {
    console.error('Error loading invite codes:', error);
    if (loadingDiv) loadingDiv.style.display = 'none';
    if (listContainer) {
      listContainer.innerHTML = '<div style="text-align:center; padding:2rem; color:#ef4444;"><i class="fa fa-exclamation-triangle" style="font-size:2rem; margin-bottom:1rem;"></i><p>Failed to load invite codes</p></div>';
    }
  }
}

function renderInviteCodesPagination() {
  const paginationDiv = document.getElementById('inviteCodesPagination');
  if (!paginationDiv) return;

  if (inviteCodesPagination.totalPages <= 1) {
    paginationDiv.style.display = 'none';
    return;
  }

  paginationDiv.style.display = 'flex';
  paginationDiv.innerHTML = `
    <button onclick="loadInviteCodes(${inviteCodesPagination.currentPage - 1})"
            ${!inviteCodesPagination.hasPrevPage ? 'disabled' : ''}
            style="background:${inviteCodesPagination.hasPrevPage ? '#4a5568' : '#2d3748'}; color:${inviteCodesPagination.hasPrevPage ? '#fff' : '#6b7280'}; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:${inviteCodesPagination.hasPrevPage ? 'pointer' : 'not-allowed'}; font-size:0.875rem;">
      <i class="fa fa-chevron-left"></i> Prev
    </button>
    <span style="color:#a0aec0; font-size:0.875rem; display:flex; align-items:center;">
      Page ${inviteCodesPagination.currentPage} of ${inviteCodesPagination.totalPages}
    </span>
    <button onclick="loadInviteCodes(${inviteCodesPagination.currentPage + 1})"
            ${!inviteCodesPagination.hasNextPage ? 'disabled' : ''}
            style="background:${inviteCodesPagination.hasNextPage ? '#4a5568' : '#2d3748'}; color:${inviteCodesPagination.hasNextPage ? '#fff' : '#6b7280'}; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:${inviteCodesPagination.hasNextPage ? 'pointer' : 'not-allowed'}; font-size:0.875rem;">
      Next <i class="fa fa-chevron-right"></i>
    </button>
  `;
}

