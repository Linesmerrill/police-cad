          <button class="audit-filter-chip" data-category="role" onclick="filterAuditLogs('role')" style="padding:0.4rem 0.9rem; border-radius:9999px; border:1px solid #4a5568; background:#2d3748; color:#a0aec0; font-size:0.8rem; cursor:pointer;">Roles</button>
          <button class="audit-filter-chip" data-category="department" onclick="filterAuditLogs('department')" style="padding:0.4rem 0.9rem; border-radius:9999px; border:1px solid #4a5568; background:#2d3748; color:#a0aec0; font-size:0.8rem; cursor:pointer;">Departments</button>
