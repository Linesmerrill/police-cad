          <div style="text-align:center;">
            <div class="pcm-spinner"></div>
            <p style="color:#64748b; font-family:'Outfit',sans-serif; font-size:0.75rem; margin:0.75rem 0 0;">Loading penal codes...</p>
          </div>
        </div>
      </div>
    </div>

