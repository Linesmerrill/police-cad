          document.getElementById('customCurrency').value = currency;
          document.getElementById('customCurrency').style.display = 'block';
        } else {
          document.getElementById('fineCurrency').value = currency;
          document.getElementById('customCurrency').style.display = 'none';
        }
        
        // Store original data for search functionality
        window.originalFineCategories = fines.categories || [];
        window.originalCurrency = fines.currency || 'USD';
        
        // Load categories
        renderFineCategories(fines.categories || []);
        
        // Hide loading state
        document.getElementById('fineSettingsLoading').style.display = 'none';
