// Component display metadata: maps component key -> { label, icon, color }
var editDeptComponentMeta = {
  createCivilians:      { label: 'Create Civilians',             icon: 'fa-id-card',              color: 'text-blue-400' },
  createVehicles:       { label: 'Create Vehicles',              icon: 'fa-car',                  color: 'text-green-400' },
  createFirearms:       { label: 'Create Firearms',              icon: 'fa-crosshairs',           color: 'text-red-400' },
  call911:              { label: 'Call 911',                      icon: 'fa-exclamation-triangle', color: 'text-yellow-400' },
  '10CodesInterface':   { label: '10-Codes Interface',           icon: 'fa-list-ol',              color: 'text-purple-400' },
  personSearch:         { label: 'Person Search & Actions',      icon: 'fa-search',               color: 'text-blue-400' },
  vehicleSearch:        { label: 'Vehicle Search & Actions',     icon: 'fa-car',                  color: 'text-green-400' },
  firearmSearch:        { label: 'Firearm Search & Actions',     icon: 'fa-crosshairs',           color: 'text-red-400' },
  createBolos:          { label: 'Create Bolos',                 icon: 'fa-bullhorn',             color: 'text-orange-400' },
  viewBolosAndWarrants: { label: 'View Calls, Bolos & Warrants', icon: 'fa-eye',                  color: 'text-cyan-400' },
  notepad:              { label: 'Notepad',                      icon: 'fa-sticky-note',          color: 'text-purple-400' },
  dispatchUnits:        { label: 'Dispatch Units',               icon: 'fa-headset',              color: 'text-blue-400' },
  createAndManageCalls: { label: 'Create & Manage Calls',        icon: 'fa-phone',                color: 'text-green-400' },
  manage911Calls:       { label: 'Manage 911 Calls',             icon: 'fa-ambulance',            color: 'text-red-400' },
  nameSearch:           { label: 'Name Search',                  icon: 'fa-search',               color: 'text-blue-400' },
  reviewWarrants:       { label: 'Review Warrants',              icon: 'fa-gavel',                color: 'text-purple-400' },
  allWarrants:          { label: 'All Warrants',                 icon: 'fa-folder-open',          color: 'text-blue-400' },
  penalCodes:           { label: 'Penal Codes',                  icon: 'fa-scale-balanced',       color: 'text-amber-400' },
  courtCases:           { label: 'Court Cases',                  icon: 'fa-briefcase',            color: 'text-purple-400' }
};

// Expected components per template type — used to add missing components to legacy departments
var expectedComponentsByTemplate = {
  'civilian': ['createCivilians', 'createVehicles', 'createFirearms', 'call911', 'notepad', 'courtCases'],
  'police':   ['10CodesInterface', 'personSearch', 'vehicleSearch', 'firearmSearch', 'createBolos', 'viewBolosAndWarrants', 'notepad', 'courtCases'],
  'dispatch': ['dispatchUnits', 'createAndManageCalls', 'createBolos', 'manage911Calls', 'nameSearch', 'vehicleSearch', 'firearmSearch', 'courtCases'],
  'fire':     ['10CodesInterface', 'personSearch', 'vehicleSearch', 'createBolos', 'viewBolosAndWarrants', 'notepad', 'courtCases'],
  'ems':      ['10CodesInterface', 'personSearch', 'vehicleSearch', 'createBolos', 'viewBolosAndWarrants', 'notepad', 'courtCases'],
  'judicial': ['courtCases', 'reviewWarrants', 'allWarrants', 'penalCodes', 'notepad']
};

// Merge missing expected components into a department's component list (defaults to enabled)
function mergeExpectedComponents(components, templateName) {
  if (!templateName) return components;
  var lowerName = templateName.toLowerCase();
  var expected = expectedComponentsByTemplate[lowerName];
  if (!expected) return components;

  var existingNames = {};
  components.forEach(function(c) { existingNames[c.name] = true; });

  // Build set of expected component names for quick lookup
  var expectedSet = {};
  expected.forEach(function(name) { expectedSet[name] = true; });

  // Keep only components that are in the expected list, preserving their enabled state
  var merged = components.filter(function(c) { return expectedSet[c.name]; });

  // Add any expected components that are missing (defaults to enabled)
  var mergedNames = {};
  merged.forEach(function(c) { mergedNames[c.name] = true; });
  expected.forEach(function(name) {
    if (!mergedNames[name]) {
      merged.push({ name: name, enabled: true });
    }
  });
  return merged;
}

function renderEditDeptComponents(components) {
  var container = document.getElementById('editDeptComponentsContainer');
  if (!components || components.length === 0) {
    container.innerHTML = '<div class="text-gray-500 text-sm">No components configured</div>';
    return;
  }
  container.innerHTML = components.map(function(comp) {
    var meta = editDeptComponentMeta[comp.name] || { label: comp.name, icon: 'fa-puzzle-piece', color: 'text-gray-400' };
    return '<div class="flex items-center justify-between">'
      + '<div class="flex items-center gap-2">'
      + '<i class="fa ' + meta.icon + ' ' + meta.color + ' text-sm"></i>'
      + '<span class="text-gray-300 text-sm">' + meta.label + '</span>'
      + '</div>'
      + '<label class="relative inline-flex items-center cursor-pointer">'
      + '<input type="checkbox" data-component-name="' + comp.name + '" class="sr-only peer edit-dept-component-toggle"' + (comp.enabled ? ' checked' : '') + '>'
      + '<div class="w-9 h-5 bg-gray-600 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-blue-500 rounded-full peer peer-checked:bg-blue-600 transition-all"></div>'
      + '<div class="absolute left-0.5 top-0.5 bg-white w-4 h-4 rounded-full shadow transition-all peer-checked:translate-x-4"></div>'
      + '</label>'
      + '</div>';
  }).join('');
}

function populateEditDeptModal(dept) {
  // Set basic department info
  document.getElementById('editDeptId').value = dept._id || '';
  document.getElementById('editDeptImageUrl').value = dept.image || '';
  document.getElementById('editDeptName').value = dept.name || '';
  document.getElementById('editDeptDescription').value = dept.description || '';
  document.getElementById('editDeptApprovalRequired').checked = !!dept.approvalRequired;

  // Update image preview
  var preview = document.getElementById('editDeptImagePreview');
  var placeholder = document.getElementById('editDeptImagePlaceholder');
  var deleteBtn = document.getElementById('editDeptImageDeleteBtn');
  if (dept.image) {
    preview.src = dept.image;
    preview.style.display = 'block';
    placeholder.style.display = 'none';
    if (deleteBtn) deleteBtn.style.display = 'flex';
  } else {
    preview.src = '';
    preview.style.display = 'none';
    placeholder.style.display = 'flex';
    if (deleteBtn) deleteBtn.style.display = 'none';
  }

  // Dynamically render components from template, merging in any missing expected components
  var templateName = (dept.template && dept.template.name) ? dept.template.name : '';
  var existingComponents = (dept.template && dept.template.components) ? dept.template.components : [];
  var mergedComponents = mergeExpectedComponents(existingComponents, templateName);
  renderEditDeptComponents(mergedComponents);

  updateEditDeptVisibilityLabel();
  document.getElementById('editDepartmentModal').style.display = 'flex';
}

function openEditDepartmentModal(departmentId) {
  currentEditDepartment = departmentId;
  const communityId = '<%= community._id %>';
  // Fetch latest department data from API
  fetch(`${API_URL}/api/v1/community/${communityId}/departments/${departmentId}`)
    .then(res => res.json())
    .then(data => {
      populateEditDeptModal(data.department || {});
    })
    .catch(() => {
      // fallback to local data if API fails
      const dept = (window.departmentsListData || []).find(d => d._id === departmentId) || {};
      populateEditDeptModal(dept);
    });
}
function closeEditDepartmentModal() {
  document.getElementById('editDepartmentModal').style.display = 'none';
}

// Handle department photo upload
async function handleEditDeptImageChange(event) {
  const file = event.target.files[0];
  if (!file) return;

  const preview = document.getElementById('editDeptImagePreview');
  const placeholder = document.getElementById('editDeptImagePlaceholder');
  const deleteBtn = document.getElementById('editDeptImageDeleteBtn');

  try {
    // Validate file type
    if (!file.type.startsWith('image/')) {
      showToast('Please select a valid image file', 3000, 'error');
      return;
    }

    // Validate file size (max 5MB)
    if (file.size > 5 * 1024 * 1024) {
      showToast('Image must be less than 5MB', 3000, 'error');
      return;
    }

    // Show preview immediately
    const reader = new FileReader();
    reader.onload = function(e) {
      preview.src = e.target.result;
      preview.style.display = 'block';
      placeholder.style.display = 'none';
      if (deleteBtn) deleteBtn.style.display = 'flex';
    };
    reader.readAsDataURL(file);

    // Show uploading status
    showToast('Uploading photo...', 3000, 'info');

    // Upload to Cloudinary
    const imageUrl = await uploadToCloudinary(file, 'departments', `dept_${Date.now()}`);

    // Store the URL
    document.getElementById('editDeptImageUrl').value = imageUrl;

    // Show success status
    showToast('Photo uploaded successfully!', 3000, 'success');

  } catch (error) {
    console.error('Photo upload error:', error);
    showToast('Upload failed: ' + error.message, 3000, 'error');

    // Reset preview on error
    preview.src = '';
    preview.style.display = 'none';
    placeholder.style.display = 'flex';
    if (deleteBtn) deleteBtn.style.display = 'none';
  }
}

// Delete department photo
function deleteEditDeptImage() {
  const preview = document.getElementById('editDeptImagePreview');
  const placeholder = document.getElementById('editDeptImagePlaceholder');
  const deleteBtn = document.getElementById('editDeptImageDeleteBtn');
  const imageUrlInput = document.getElementById('editDeptImageUrl');
  const fileInput = document.getElementById('editDeptImage');

  // Clear the image
  preview.src = '';
  preview.style.display = 'none';
  placeholder.style.display = 'flex';
  if (deleteBtn) deleteBtn.style.display = 'none';

  // Set special marker to indicate explicit deletion (not just empty)
  imageUrlInput.value = '__DELETE__';

  // Clear the file input
  if (fileInput) fileInput.value = '';

  showToast('Photo removed', 2000, 'info');
}
</script>

