function confirmDeleteCommunity() {
  const communityId = '<%= community._id %>';

  // Get the API URL with fallback
  const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

  // Close the confirm modal and show the ceremonial loading overlay so the
  // user sees something is happening during the API round-trip. We keep the
  // overlay visible on success straight through the navigation so the
  // animation actually plays — the API often responds in <300ms, which would
  // otherwise flash the overlay too briefly to register.
  closeDeleteCommunityModal();
  const overlayShownAt = Date.now();
  if (window.lpcShowDeleteCommunityLoading) window.lpcShowDeleteCommunityLoading();
  const MIN_OVERLAY_MS = 1500;

  // Mute the global 410 eviction modal for this community — we already
  // showed the owner a delete-confirm modal and a ceremonial loading
  // overlay, no need for a second "Community deleted" prompt before the
  // redirect lands.
  if (typeof window.suppressPendingDeletion === 'function') {
    window.suppressPendingDeletion(communityId);
  }

  fetch(`${apiUrl}/api/v1/community/${communityId}`, {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(res => res.json().catch(() => ({})).then(body => ({ ok: res.ok, body })))
  .then(({ ok }) => {
    if (!ok) throw new Error('Failed to delete community');
    const elapsed = Date.now() - overlayShownAt;
    const wait = Math.max(0, MIN_OVERLAY_MS - elapsed);
    // Leave the overlay up while we navigate — the redirect itself confirms
    // the action worked, and the communities list page can show the followup.
    setTimeout(() => { window.location.href = '/communities'; }, wait);
  })
  .catch(() => {
    if (window.lpcHideDeleteCommunityLoading) window.lpcHideDeleteCommunityLoading();
    showSettingsError('Failed to schedule deletion. Please try again.');
  });
}

