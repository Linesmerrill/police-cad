      // Members Modal Functions
      let communityMembersData = [];
      let communityMembersPage = 1;
      let communityMembersLimit = 20;
      let communityMembersTotal = 0;
      let communityFilteredMembers = [];
      let communityCurrentSearchTerm = '';

      function openMembersModal() {
        // Show loading state on the card
        showMembersCardLoading();
        
        // Ensure the modal exists (create if needed)
        const modal = ensureMembersModalExists();
        
