    <!-- Initialize civilian approvals badge on page load -->
    <script>
      // Update the badge count when the page loads
      document.addEventListener('DOMContentLoaded', function() {
        // Only update badge if civilian approval system is enabled
        if (document.getElementById('civApprovalsCard') && 
            document.getElementById('civApprovalsCard').style.display !== 'none') {
          updateCivilianApprovalsBadge();
        }
        
        // Civilian Details View Event Listeners
        const backToApprovalsBtn = document.getElementById('backToApprovalsBtn');
        const civilianDetailsSaveBtn = document.getElementById('civDetailsSaveBtn');
        const civilianDetailsApproveBtn = document.getElementById('civDetailsApproveBtn');
        const civilianDetailsDenyBtn = document.getElementById('civDetailsDenyBtn');
        const civilianDetailsRequireEditsBtn = document.getElementById('civDetailsRequireEditsBtn');
        
        if (backToApprovalsBtn) {
          backToApprovalsBtn.onclick = backToApprovalsList;
        }
        
        if (civilianDetailsSaveBtn) {
          civilianDetailsSaveBtn.onclick = saveCivilianDetails;
        }
        
        if (civilianDetailsApproveBtn) {
          civilianDetailsApproveBtn.onclick = () => {
            if (currentCivilianId) {
              approveCivilian(currentCivilianId);
              backToApprovalsList();
            }
          };
        }
        
        if (civilianDetailsDenyBtn) {
          civilianDetailsDenyBtn.onclick = () => {
            if (currentCivilianId) {
              denyCivilian(currentCivilianId);
              backToApprovalsList();
            }
          };
        }
        
        if (civilianDetailsRequireEditsBtn) {
          civilianDetailsRequireEditsBtn.onclick = () => {
            if (currentCivilianId) {
              openRequireEditsModal();
            }
          };
        }
        
        // Height/Weight toggle functionality
        const heightToggleButtons = document.querySelectorAll('.height-toggle-btn');
        heightToggleButtons.forEach(btn => {
          btn.onclick = function() {
            const value = this.dataset.value;
            const container = this.closest('div').parentElement;
            
            // Update button states
            container.querySelectorAll('.height-toggle-btn').forEach(b => {
              b.classList.remove('active');
              b.style.background = 'transparent';
              b.style.color = '#a0aec0';
            });
            this.classList.add('active');
            this.style.background = 'linear-gradient(135deg,#667eea 0%,#764ba2 100%)';
            this.style.color = '#fff';
            
            // Toggle input visibility
            if (value === 'imperial') {
              container.querySelector('.civ-height-imperial').style.display = 'flex';
              container.querySelector('.civ-height-metric').style.display = 'none';
            } else {
              container.querySelector('.civ-height-imperial').style.display = 'none';
              container.querySelector('.civ-height-metric').style.display = 'block';
            }
          };
        });
        
        const weightToggleButtons = document.querySelectorAll('.weight-toggle-btn');
        weightToggleButtons.forEach(btn => {
          btn.onclick = function() {
            const value = this.dataset.value;
            const container = this.closest('div').parentElement;
            
            // Update button states
            container.querySelectorAll('.weight-toggle-btn').forEach(b => {
              b.classList.remove('active');
              b.style.background = 'transparent';
              b.style.color = '#a0aec0';
            });
            this.classList.add('active');
            this.style.background = 'linear-gradient(135deg,#667eea 0%,#764ba2 100%)';
            this.style.color = '#fff';
            
            // Toggle input visibility
            if (value === 'imperial') {
              container.querySelector('.civ-weight-imperial').style.display = 'block';
              container.querySelector('.civ-weight-metric').style.display = 'none';
            } else {
              container.querySelector('.civ-weight-imperial').style.display = 'none';
              container.querySelector('.civ-weight-metric').style.display = 'block';
            }
          };
        });
      });
    </script>

