// Roles Management Functions
let rolesData = [];
let filteredRoles = [];
let currentRole = null;

function openRolesModal() {
  document.getElementById('rolesModal').style.display = 'flex';
  loadRoles();
}

function refreshRolesModal() {
  // Show loading state
  const rolesList = document.getElementById('rolesList');
  const originalContent = rolesList.innerHTML;
  rolesList.innerHTML = `
    <div style="text-align:center; padding:2rem; color:#a0aec0;">
      <i class="fa fa-spinner fa-spin" style="font-size:2rem; margin-bottom:1rem;"></i>
      <p>Refreshing roles...</p>
    </div>
  `;
  
  // Reload roles data
  loadRoles();
}

function closeRolesModal() {
  document.getElementById('rolesModal').style.display = 'none';
  // Reset data
  rolesData = [];
  filteredRoles = [];
  currentRole = null;
}

async function loadRoles() {
  const loadingDiv = document.getElementById('rolesLoading');
  const listContainer = document.getElementById('rolesListContainer');
  const emptyState = document.getElementById('rolesEmptyState');
  const rolesCount = document.getElementById('rolesCount');
  
  try {
    loadingDiv.style.display = 'block';
    listContainer.style.display = 'none';
    emptyState.style.display = 'none';
    
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
    
    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/roles`);
    
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || `Failed to fetch roles: ${response.status}`);
    }
    
    const data = await response.json();
    rolesData = Array.isArray(data) ? data : (data.roles || []);
    filteredRoles = [...rolesData];
    
    // Update count
    rolesCount.textContent = rolesData.length;
    document.getElementById('rolesCountText').textContent = rolesData.length === 1 ? 'role' : 'roles';
    
    // Render roles
    renderRolesList();
    
  } catch (error) {
    showToast(`Failed to load roles: ${error.message}`, 3000, 'error');
    emptyState.style.display = 'block';
  } finally {
    loadingDiv.style.display = 'none';
  }
}

var isRolesEditMode = false;
var originalRolesOrder = [];

function renderRolesList() {
  const listContainer = document.getElementById('rolesListContainer');
  const emptyState = document.getElementById('rolesEmptyState');
  const rolesList = document.getElementById('rolesList');

  if (filteredRoles.length === 0) {
    listContainer.style.display = 'none';
    emptyState.style.display = 'block';
    return;
  }

  listContainer.style.display = 'block';
  emptyState.style.display = 'none';

  rolesList.innerHTML = filteredRoles.map((role, index) => {
    const isHeadAdmin = (role.permissions || []).some(p =>
      p.name === 'administrator' && p.description === 'Head Admin' && p.enabled
    );
    const color = isHeadAdmin ? '#ef4444' : '#8b5cf6';
    const isLast = index === filteredRoles.length - 1;

    if (isRolesEditMode) {
      const upDisabled = index === 0 || isHeadAdmin;
      const downDisabled = isLast || isHeadAdmin;

      return `
        <div class="role-row" style="display:flex; align-items:center; gap:0.75rem; padding:0.75rem 1rem; border-bottom:${isLast ? 'none' : '1px solid rgba(255,255,255,0.06)'}; background:transparent;">
          <span style="background:rgba(56,189,248,0.12); color:#38bdf8; border:1px solid rgba(56,189,248,0.25); border-radius:9999px; width:1.6rem; height:1.6rem; display:flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:700; flex-shrink:0;">${index + 1}</span>
          <div style="background:${color}20; border-radius:9999px; padding:0.45rem; flex-shrink:0;">
            <i class="fa fa-shield-alt" style="color:${color}; font-size:0.8rem; width:14px; text-align:center;"></i>
          </div>
          <div style="flex:1; min-width:0;">
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <span style="color:#f1f5f9; font-size:0.9rem; font-weight:500;">${role.name}</span>
              ${isHeadAdmin ? '<i class="fa fa-lock" style="color:#64748b; font-size:0.65rem;"></i>' : ''}
            </div>
            <div style="color:#64748b; font-size:0.78rem; margin-top:0.15rem;">${formatCount(role.members ? role.members.length : 0, 'member', 'members')}</div>
          </div>
          <div style="display:flex; gap:0.35rem;">
            <button class="role-arrow-btn" onclick="moveRoleUp(${index})" ${upDisabled ? 'disabled' : ''} style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08); color:#f1f5f9; padding:0.3rem 0.5rem; border-radius:8px; cursor:${upDisabled ? 'not-allowed' : 'pointer'}; opacity:${upDisabled ? '0.3' : '1'}; font-size:0.75rem;">
              <i class="fa fa-arrow-up"></i>
            </button>
            <button class="role-arrow-btn" onclick="moveRoleDown(${index})" ${downDisabled ? 'disabled' : ''} style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08); color:#f1f5f9; padding:0.3rem 0.5rem; border-radius:8px; cursor:${downDisabled ? 'not-allowed' : 'pointer'}; opacity:${downDisabled ? '0.3' : '1'}; font-size:0.75rem;">
              <i class="fa fa-arrow-down"></i>
            </button>
          </div>
        </div>
      `;
    }

    return `
      <div class="role-row" style="display:flex; align-items:center; gap:0.75rem; padding:0.85rem 1rem; border-bottom:${isLast ? 'none' : '1px solid rgba(255,255,255,0.06)'}; cursor:pointer; background:transparent;" onclick="openRoleDetails('${role._id}')">
        <div style="background:${color}20; border-radius:9999px; padding:0.5rem; flex-shrink:0;">
          <i class="fa fa-shield-alt" style="color:${color}; font-size:0.85rem; width:16px; text-align:center;"></i>
        </div>
        <div style="flex:1; min-width:0;">
          <div style="display:flex; align-items:center; gap:0.4rem;">
            <span style="color:#f1f5f9; font-size:0.9rem; font-weight:500;">${role.name}</span>
            ${isHeadAdmin ? '<i class="fa fa-lock" style="color:#64748b; font-size:0.65rem;"></i>' : ''}
          </div>
          <div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.2rem;">
            <span style="color:#64748b; font-size:0.78rem;">${formatCount(role.members ? role.members.length : 0, 'member', 'members')}</span>
            ${isHeadAdmin ? `<span style="background:rgba(239,68,68,0.12); color:#ef4444; border:1px solid rgba(239,68,68,0.25); padding:0.1rem 0.5rem; border-radius:9999px; font-size:0.65rem; font-weight:500;">Head Admin</span>` : ''}
          </div>
        </div>
        <i class="fa fa-chevron-right" style="color:#64748b; font-size:0.7rem;"></i>
      </div>
    `;
  }).join('');
}

function toggleRolesEditMode() {
  isRolesEditMode = true;
  originalRolesOrder = [...filteredRoles];
  document.getElementById('rolesEditModeBanner').style.display = 'flex';
  document.getElementById('editRolesOrderBtn').style.display = 'none';
  document.getElementById('rolesSearchInput').disabled = true;
  renderRolesList();
}

function cancelRolesEditMode() {
  isRolesEditMode = false;
  filteredRoles = [...originalRolesOrder];
  rolesData = [...originalRolesOrder];
  document.getElementById('rolesEditModeBanner').style.display = 'none';
  document.getElementById('editRolesOrderBtn').style.display = 'inline-block';
  document.getElementById('rolesSearchInput').disabled = false;
  renderRolesList();
}

function moveRoleUp(index) {
  if (index <= 0) return;
  const targetRole = filteredRoles[index - 1];
  const isTargetHeadAdmin = (targetRole.permissions || []).some(p =>
    p.name === 'administrator' && p.description === 'Head Admin' && p.enabled
  );
  if (isTargetHeadAdmin) return;

  [filteredRoles[index], filteredRoles[index - 1]] = [filteredRoles[index - 1], filteredRoles[index]];
  rolesData = [...filteredRoles];
  renderRolesList();
}

function moveRoleDown(index) {
  if (index >= filteredRoles.length - 1) return;
  const currentRole = filteredRoles[index];
  const isCurrentHeadAdmin = (currentRole.permissions || []).some(p =>
    p.name === 'administrator' && p.description === 'Head Admin' && p.enabled
  );
  if (isCurrentHeadAdmin) return;

  [filteredRoles[index], filteredRoles[index + 1]] = [filteredRoles[index + 1], filteredRoles[index]];
  rolesData = [...filteredRoles];
  renderRolesList();
}

async function saveRolesOrder() {
  const saveBtn = document.getElementById('saveRolesOrderBtn');
  saveBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Saving...';
  saveBtn.disabled = true;

  try {
    const communityId = '<%= community._id %>';
    const apiUrl = window.API_URL || '<%= process.env.POLICE_CAD_API_URL || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';

    const roleIds = filteredRoles.map(r => r._id);

    const response = await fetch(`${apiUrl}/api/v1/community/${communityId}/roles/reorder?userId=${window.dbUser?._id || ''}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ roleIds })
    });

    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.message || 'Failed to reorder roles');
    }

    isRolesEditMode = false;
    document.getElementById('rolesEditModeBanner').style.display = 'none';
    document.getElementById('editRolesOrderBtn').style.display = 'inline-block';
    document.getElementById('rolesSearchInput').disabled = false;
    showToast('Roles reordered successfully!', 3000, 'success');
    renderRolesList();

  } catch (error) {
    showToast('Failed to reorder roles: ' + error.message, 3000, 'error');
    filteredRoles = [...originalRolesOrder];
    rolesData = [...originalRolesOrder];
    renderRolesList();
  } finally {
    saveBtn.innerHTML = '<i class="fa fa-check" style="margin-right:0.25rem;"></i>Save';
    saveBtn.disabled = false;
  }
}

function searchRoles(query) {
  if (!query.trim()) {
    filteredRoles = [...rolesData];
  } else {
    filteredRoles = rolesData.filter(role => 
      role.name.toLowerCase().includes(query.toLowerCase())
    );
  }
  renderRolesList();
}

function clearRolesSearch() {
  const searchInput = document.getElementById('rolesSearchInput');
  const clearBtn = document.getElementById('rolesSearchClear');
  
  searchInput.value = '';
  clearBtn.style.display = 'none';
  searchRoles('');
}

// Create Role Functions
function openCreateRoleModal() {
  document.getElementById('createRoleModal').style.display = 'flex';
  document.getElementById('newRoleName').value = '';
  document.getElementById('createRoleError').style.display = 'none';

  // Reset the create button in case it was left in loading state from a previous creation
  var createBtn = document.getElementById('createRoleBtn');
  if (createBtn) {
    createBtn.innerHTML = 'Create';
    createBtn.disabled = false;
  }
}

function closeCreateRoleModal() {
  document.getElementById('createRoleModal').style.display = 'none';
  
  // Reset modal state
  document.getElementById('createRoleStep1').style.display = 'block';
  document.getElementById('createRoleStep2').style.display = 'none';
  
  // Reset form and data
  document.getElementById('newRoleName').value = '';
  document.getElementById('createRoleError').style.display = 'none';
  
  // Reset role creation data
  newRoleData = { name: '', members: [] };
  createRoleMembersData = [];
  createRoleCurrentPage = 1;
  createRoleSearchQuery = '';
  selectedMembersData.clear(); // Clear stored member data
  
  // Clear selected members display
