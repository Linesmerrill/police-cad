                <input type="text" id="promoDeptInput" class="promo-input" maxlength="120" placeholder="e.g. State Patrol" onkeydown="if(event.key==='Enter'){event.preventDefault();addPromoTag('dept');}">
                <button type="button" class="promo-add-btn" onclick="addPromoTag('dept')">Add</button>
              </div>
              <div class="promo-tags" id="promoDeptList"></div>
            </div>

            <div class="promo-field">
              <label class="promo-label">Features <span style="color:#8b93a7; font-weight:400;">(optional)</span></label>
              <div class="promo-tag-row">
                <input type="text" id="promoFeatInput" class="promo-input" maxlength="120" placeholder="e.g. Custom CAD/MDT" onkeydown="if(event.key==='Enter'){event.preventDefault();addPromoTag('feat');}">
                <button type="button" class="promo-add-btn" onclick="addPromoTag('feat')">Add</button>
              </div>
              <div class="promo-tags" id="promoFeatList"></div>
              <div class="promo-hint" id="promoFeatHint">Up to 6 features. Boost your community to add more.</div>
