              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-crosshairs" style="font-size:2rem; color:#ef4444;"></i>
                </div>
                <h5 style="color:#fff; margin:0; font-size:1rem; font-weight:600;">Firearms</h5>
                <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage all firearms in community</p>
              </div>
            </div>
          <% } else { %>
            <div id="firearmsManagementCard" onclick="showNoCiviliansPermissionModal()" style="background:#1a202c; border:1px solid #2d3748; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; opacity:0.6;">
              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-crosshairs" style="font-size:2rem; color:#6b7280;"></i>
                </div>
                <h5 style="color:#6b7280; margin:0; font-size:1rem; font-weight:600;">Firearms</h5>
                <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage all firearms in community</p>
                <p style="color:#6b7280; margin:0.5rem 0 0 0; font-size:0.75rem; font-style:italic;">Permission Required</p>
              </div>
            </div>
          <% } %>

          <!-- Bans Management -->
          <%
            // Permission logic for managing bans
            let canManageBans = false;
            if (userId && community.community && Array.isArray(community.community.roles)) {
              community.community.roles.forEach(function(role) {
                if (Array.isArray(role.members) && role.members.includes(userId)) {
                  if (Array.isArray(role.permissions)) {
                    role.permissions.forEach(function(perm) {
                      if (
                        (perm.name === "administrator" && perm.enabled === true) ||
                        (perm.name === "manage bans" && perm.enabled === true)
                      ) {
                        canManageBans = true;
                      }
                    });
                  }
                }
              });
            }
          %>
          
          <% if (canManageBans) { %>
            <!-- User has permission to manage bans -->
            <div id="bansManagementCard" onclick="openBansModal()" style="background:#2d3748; border:1px solid #4a5568; border-radius:12px; padding:1.5rem; cursor:pointer; transition:all 0.2s; hover:border-color:#ef4444;">
              <div style="text-align:center;">
                <div style="margin-bottom:0.5rem;">
                  <i class="fa fa-ban" style="font-size:2rem; color:#ef4444;"></i>
                </div>
                <h5 style="color:#fff; margin:0; font-size:1rem; font-weight:600;">Bans</h5>
                <p style="color:#a0aec0; margin:0.5rem 0 0 0; font-size:0.875rem;">Manage banned users</p>
              </div>
            </div>
