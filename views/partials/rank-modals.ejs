      <!-- Promotion Celebration Modal -->
      <style>
        .promo-modal-overlay {
          display:none; position:fixed; inset:0; z-index:9999;
          background:rgba(4,4,10,0.88); backdrop-filter:blur(12px);
          align-items:center; justify-content:center; padding:1rem;
        }
        .promo-modal-overlay.is-open { display:flex; }

        .promo-modal {
          position:relative; width:100%; max-width:400px; text-align:center;
          padding:56px 40px 40px; border-radius:24px;
          background:
            radial-gradient(ellipse 70% 50% at 50% 0%, rgba(251,191,36,0.08) 0%, transparent 60%),
            linear-gradient(170deg, #161333 0%, #0e0f18 45%, #0c0d14 100%);
          border:1px solid rgba(251,191,36,0.12);
          box-shadow:
            0 48px 120px -24px rgba(0,0,0,0.8),
            0 0 0 1px rgba(251,191,36,0.06),
            inset 0 1px 0 rgba(255,255,255,0.04);
          opacity:0; transform:translateY(32px) scale(0.9);
          overflow:visible;
        }
        .promo-modal-overlay.is-open .promo-modal {
          animation:promoCardIn 0.6s cubic-bezier(0.16,1,0.3,1) forwards;
        }
        @keyframes promoCardIn {
          0% { opacity:0; transform:translateY(32px) scale(0.9); }
          100% { opacity:1; transform:translateY(0) scale(1); }
        }

        /* Radial light rays behind the shield */
        .promo-rays {
          position:absolute; top:-60px; left:50%; transform:translateX(-50%);
          width:280px; height:280px; pointer-events:none;
          background:
            conic-gradient(from 0deg, transparent 0deg, rgba(251,191,36,0.06) 8deg, transparent 16deg,
              transparent 30deg, rgba(251,191,36,0.05) 38deg, transparent 46deg,
              transparent 60deg, rgba(251,191,36,0.06) 68deg, transparent 76deg,
              transparent 90deg, rgba(251,191,36,0.05) 98deg, transparent 106deg,
              transparent 120deg, rgba(251,191,36,0.06) 128deg, transparent 136deg,
              transparent 150deg, rgba(251,191,36,0.05) 158deg, transparent 166deg,
              transparent 180deg, rgba(251,191,36,0.06) 188deg, transparent 196deg,
              transparent 210deg, rgba(251,191,36,0.05) 218deg, transparent 226deg,
              transparent 240deg, rgba(251,191,36,0.06) 248deg, transparent 256deg,
              transparent 270deg, rgba(251,191,36,0.05) 278deg, transparent 286deg,
              transparent 300deg, rgba(251,191,36,0.06) 308deg, transparent 316deg,
              transparent 330deg, rgba(251,191,36,0.05) 338deg, transparent 346deg,
              transparent 360deg);
          border-radius:50%;
          opacity:0;
        }
        .promo-modal-overlay.is-open .promo-rays {
          animation:promoRaysSpin 20s linear infinite, promoRaysFade 0.8s 0.3s ease-out forwards;
        }
        @keyframes promoRaysSpin { to { transform:translateX(-50%) rotate(360deg); } }
        @keyframes promoRaysFade { to { opacity:1; } }

        /* Shield icon — CSS-drawn */
        .promo-shield-wrap {
          position:relative; z-index:1; margin:-8px auto 18px;
          opacity:0; transform:scale(0.5);
        }
        .promo-modal-overlay.is-open .promo-shield-wrap {
