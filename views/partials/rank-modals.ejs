        .promo-modal-transition .promo-arrow-line span {
          display:block; width:32px; height:1px;
          background:linear-gradient(90deg, rgba(251,191,36,0.1), rgba(251,191,36,0.5));
        }
        .promo-modal-transition .promo-arrow-line i {
          color:#fbbf24; font-size:13px; margin-left:-1px;
        }
        .promo-modal-transition .promo-to {
          color:#fbbf24; font-size:15px; font-weight:700;
          padding-left:8px;
        }

        /* Dismiss button */
        .promo-modal-dismiss {
          position:relative; overflow:hidden;
          background:linear-gradient(135deg, rgba(251,191,36,0.14), rgba(251,191,36,0.06));
          border:1px solid rgba(251,191,36,0.22); border-radius:12px;
          color:#fbbf24; font-size:14px; font-weight:700; padding:12px 40px;
