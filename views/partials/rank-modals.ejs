          text-transform:uppercase;
          opacity:0; transform:translateY(6px);
        }
        .promo-modal-overlay.is-open .promo-modal-dismiss {
          animation:promoFadeUp 0.4s 0.6s ease-out forwards;
        }
        .promo-modal-dismiss:hover {
          background:linear-gradient(135deg, rgba(251,191,36,0.22), rgba(251,191,36,0.12));
          box-shadow:0 6px 24px rgba(251,191,36,0.18);
          transform:translateY(-1px);
        }
        .promo-modal-dismiss:active { transform:translateY(0); }
        /* Shimmer sweep across button */
        .promo-modal-dismiss::after {
          content:''; position:absolute; top:0; left:-100%; width:100%; height:100%;
          background:linear-gradient(90deg, transparent 0%, rgba(251,191,36,0.12) 50%, transparent 100%);
          animation:promoBtnShimmer 3s 1s ease-in-out infinite;
        }
        @keyframes promoBtnShimmer {
          0% { left:-100%; }
          40% { left:100%; }
          100% { left:100%; }
        }

        /* Shared fade-up keyframe */
        @keyframes promoFadeUp {
          0% { opacity:0; transform:translateY(8px); }
          100% { opacity:1; transform:translateY(0); }
        }

        .promo-modal canvas {
          position:absolute; inset:0; width:100%; height:100%; pointer-events:none;
          z-index:2; border-radius:24px;
        }

        /* Decorative corner accents */
        .promo-corner {
          position:absolute; width:20px; height:20px; opacity:0.2;
        }
