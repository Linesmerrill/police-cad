        .promo-shield svg { width:80px; height:90px; filter:drop-shadow(0 4px 24px rgba(251,191,36,0.3)); }
        .promo-shield-glow {
          position:absolute; inset:-16px; border-radius:50%;
          background:radial-gradient(circle, rgba(251,191,36,0.15) 0%, transparent 70%);
          animation:promoGlowPulse 2.5s ease-in-out infinite;
        }
        @keyframes promoGlowPulse {
          0%,100% { opacity:0.6; transform:scale(1); }
          50% { opacity:1; transform:scale(1.1); }
        }

        /* Title — "PROMOTED!" */
        .promo-modal-title {
          color:#fbbf24; font-size:11px; font-weight:800; text-transform:uppercase;
          letter-spacing:4px; margin-bottom:10px;
          opacity:0; transform:translateY(8px);
        }
        .promo-modal-overlay.is-open .promo-modal-title {
          animation:promoFadeUp 0.4s 0.35s ease-out forwards;
        }

        /* Rank name */
        .promo-modal-rank {
          color:#fff; font-size:36px; font-weight:800; letter-spacing:-0.8px;
