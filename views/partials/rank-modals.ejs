        .promo-corner--tr { top:16px; right:16px; border-top:2px solid #fbbf24; border-right:2px solid #fbbf24; }
        .promo-corner--bl { bottom:16px; left:16px; border-bottom:2px solid #fbbf24; border-left:2px solid #fbbf24; }
        .promo-corner--br { bottom:16px; right:16px; border-bottom:2px solid #fbbf24; border-right:2px solid #fbbf24; }
      </style>
