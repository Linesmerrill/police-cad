          letter-spacing:1.5px; text-transform:uppercase;
          border:1px solid rgba(251,191,36,0.15);
        }

        /* Transition: OldRank → NewRank */
        .promo-modal-transition {
          display:flex; align-items:center; justify-content:center; gap:0;
          margin:16px 0 28px;
          opacity:0; transform:translateY(6px);
        }
        .promo-modal-overlay.is-open .promo-modal-transition {
          animation:promoFadeUp 0.4s 0.52s ease-out forwards;
        }
        .promo-modal-transition .promo-from {
