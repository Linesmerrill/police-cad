<%#
  Report a community. The same two steps, reasons and copy as the mobile app
  (Select a reason -> Review Report -> Submit Report), so a player sees the same
  thing wherever they report from. Reasons come from app/community-report.js.

  Locals: reportReasons, reportLocations, reportDetailsMax, reportDetailsMin,
  offPlatformHelp, reportCommunityId.
%>
<style>
  .rcm-overlay { position:fixed; inset:0; z-index:2100; background:rgba(5,10,18,0.72); display:flex; align-items:center; justify-content:center; padding:16px; }
  .rcm-overlay[hidden] { display:none; }
  .rcm-dialog {
    width:100%; max-width:540px; max-height:min(86vh, 760px); display:flex; flex-direction:column;
    background:#101826; border:1px solid rgba(255,255,255,0.08); border-radius:16px; color:#e2e8f0;
    box-shadow:0 24px 64px rgba(0,0,0,0.5);
  }
  .rcm-head { display:grid; grid-template-columns:72px 1fr 72px; align-items:center; padding:16px 18px; border-bottom:1px solid rgba(255,255,255,0.06); }
  .rcm-head h3 { margin:0; text-align:center; font-size:1.05rem; font-weight:700; color:#fff; }
  .rcm-link { background:none; border:0; color:#94a3b8; font:inherit; font-size:0.9rem; cursor:pointer; padding:4px 0; }
  .rcm-link:hover { color:#e2e8f0; }
  .rcm-link.rcm-right { text-align:right; }
  .rcm-link[hidden] { visibility:hidden; display:block; }
  .rcm-body { overflow-y:auto; padding:16px 18px; flex:1; }
  .rcm-foot { padding:14px 18px 18px; border-top:1px solid rgba(255,255,255,0.06); }
  .rcm-option {
    width:100%; display:flex; align-items:flex-start; gap:12px; text-align:left; cursor:pointer;
    background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:12px;
    padding:14px; margin-bottom:10px; color:inherit; font:inherit;
  }
  .rcm-option:hover { background:rgba(255,255,255,0.05); }
  .rcm-option[aria-checked="true"] { border-color:rgba(56,189,248,0.6); background:rgba(56,189,248,0.08); }
  .rcm-option-title { font-weight:600; color:#fff; margin-bottom:4px; }
  .rcm-option[aria-checked="true"] .rcm-option-title { color:#38bdf8; }
  .rcm-option-sub { font-size:0.82rem; color:#94a3b8; line-height:1.45; }
  .rcm-check { margin-left:auto; flex:0 0 auto; color:#38bdf8; visibility:hidden; font-size:1.2rem; }
  .rcm-option[aria-checked="true"] .rcm-check { visibility:visible; }
  .rcm-label-row { display:flex; justify-content:space-between; align-items:baseline; margin:0 0 8px; }
  .rcm-label { font-size:0.72rem; letter-spacing:0.08em; font-weight:700; color:#94a3b8; }
  .rcm-hint { font-size:0.75rem; color:#64748b; }
  .rcm-selected { background:rgba(56,189,248,0.08); border:1px solid rgba(56,189,248,0.35); border-radius:12px; padding:14px; color:#fff; font-weight:600; margin-bottom:18px; }
  .rcm-textarea {
    width:100%; min-height:120px; resize:vertical; box-sizing:border-box; background:rgba(0,0,0,0.25); color:#e2e8f0;
    border:1px solid rgba(255,255,255,0.1); border-radius:12px; padding:12px 14px; font:inherit; font-size:0.92rem;
  }
  .rcm-textarea:focus { outline:none; border-color:rgba(56,189,248,0.6); }
  .rcm-lede { font-size:0.85rem; color:#94a3b8; line-height:1.5; margin:0 0 14px; }
  .rcm-input {
    width:100%; box-sizing:border-box; background:rgba(0,0,0,0.25); color:#e2e8f0;
    border:1px solid rgba(255,255,255,0.1); border-radius:12px; padding:12px 14px; font:inherit; font-size:0.92rem;
  }
  .rcm-input:focus { outline:none; border-color:rgba(56,189,248,0.6); }
  .rcm-off-links { display:flex; flex-direction:column; gap:10px; margin-top:4px; }
  .rcm-off-link {
    display:flex; align-items:center; justify-content:space-between; gap:12px; text-decoration:none;
    background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.1); border-radius:12px;
    padding:14px; color:#e2e8f0; font-weight:600;
  }
  .rcm-off-link:hover { background:rgba(255,255,255,0.06); }
  .rcm-off-link small { display:block; font-weight:400; color:#94a3b8; margin-top:3px; }
  .rcm-disclaimer { font-size:0.8rem; color:#94a3b8; line-height:1.5; margin:14px 0 0; }
  .rcm-disclaimer a { color:#38bdf8; }
  .rcm-primary {
    width:100%; border:0; border-radius:12px; padding:13px 16px; font:inherit; font-weight:700; cursor:pointer; color:#fff;
    background:linear-gradient(90deg, #0ea5e9, #38bdf8);
  }
  .rcm-primary:disabled { background:#475569; cursor:not-allowed; opacity:0.7; }
  .rcm-error { color:#f87171; font-size:0.85rem; margin:0 0 10px; text-align:center; }
  .rcm-error[hidden] { display:none; }
  .rcm-done { text-align:center; padding:28px 8px 8px; }
  .rcm-done i { font-size:2.4rem; color:#38bdf8; margin-bottom:12px; display:block; }
  .rcm-done h4 { margin:0 0 6px; color:#fff; font-size:1.15rem; }
  .rcm-done p { margin:0; color:#94a3b8; }
  .report-community-link {
    display:inline-flex; align-items:center; gap:6px; background:none; border:0; padding:4px 0; cursor:pointer;
    color:#64748b; font:inherit; font-size:0.8rem; text-decoration:none;
  }
  .report-community-link:hover { color:#f87171; }
  @media (max-width: 640px) {
    .rcm-overlay { padding:0; align-items:flex-end; }
    .rcm-dialog { max-width:none; max-height:92vh; border-radius:16px 16px 0 0; }
  }
</style>

<div id="reportCommunityModal" class="rcm-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="rcmTitle">
  <div class="rcm-dialog">
    <div class="rcm-head">
      <button type="button" class="rcm-link" id="rcmBack" hidden><i class="fa fa-chevron-left"></i> Back</button>
      <h3 id="rcmTitle">Select a reason</h3>
      <button type="button" class="rcm-link rcm-right" id="rcmCancel">Cancel</button>
    </div>

    <%# Step L: Where did this happen? Asked first, because a report about a
        Discord call is not something we can see, verify or act on, and the
        platform that could never hears about it. %>
    <div class="rcm-body" id="rcmStepLoc" hidden role="radiogroup" aria-labelledby="rcmTitle">
      <p class="rcm-lede">We can only look at things posted in Lines Police CAD. If it happened somewhere else, we will point you to who can help.</p>
      <% reportLocations.forEach(function (loc) { %>
        <button type="button" class="rcm-option" role="radio" aria-checked="false" data-location="<%= loc.id %>">
          <span>
            <div class="rcm-option-title"><%= loc.label %></div>
            <div class="rcm-option-sub"><%= loc.subtext %></div>
          </span>
          <i class="fa fa-circle-check rcm-check" aria-hidden="true"></i>
        </button>
      <% }); %>
    </div>

    <%# Step O: it did not happen here. No report is filed. %>
    <div class="rcm-body" id="rcmStepOff" hidden>
      <div class="rcm-done">
        <i class="fa fa-circle-info" aria-hidden="true"></i>
        <h4>We cannot act on this one</h4>
        <p id="rcmOffLede">This did not happen in Lines Police CAD, so we cannot see it or verify it.</p>
      </div>
      <div id="rcmOffLinks" class="rcm-off-links"></div>
      <p class="rcm-disclaimer">If someone is in immediate danger, call 911.</p>
    </div>

    <%# Step 1: Select a reason %>
    <div class="rcm-body" id="rcmStep1" role="radiogroup" aria-labelledby="rcmTitle">
      <% reportReasons.forEach(function (reason) { %>
        <button type="button" class="rcm-option" role="radio" aria-checked="false" data-reason="<%= reason.title %>">
          <span>
            <div class="rcm-option-title"><%= reason.title %></div>
            <div class="rcm-option-sub"><%= reason.subtext %></div>
          </span>
          <i class="fa fa-circle-check rcm-check" aria-hidden="true"></i>
        </button>
      <% }); %>
    </div>

    <%# Step 2: Review Report %>
    <div class="rcm-body" id="rcmStep2" hidden>
      <div class="rcm-label-row"><span class="rcm-label">REPORTED ISSUE</span></div>
      <div class="rcm-selected" id="rcmSelected"></div>

      <div class="rcm-label-row">
        <label class="rcm-label" for="rcmDetails">ADDITIONAL INFORMATION</label>
        <span class="rcm-hint" id="rcmCount">optional</span>
      </div>
      <textarea id="rcmDetails" class="rcm-textarea" maxlength="<%= reportDetailsMax %>" placeholder="Provide more details if needed..."></textarea>

      <div id="rcmImpersonationGroup" hidden>
        <div class="rcm-label-row">
          <label class="rcm-label" for="rcmImpersonated">WHO ARE THEY PRETENDING TO BE?</label>
        </div>
        <input type="text" id="rcmImpersonated" class="rcm-input" maxlength="<%= reportDetailsMax %>" placeholder="The real community or person's name" />
      </div>

      <p class="rcm-disclaimer">
        We take all reports seriously. By submitting this report, you agree that this content goes against our
        <a href="/terms-and-conditions" target="_blank" rel="noopener noreferrer">Terms of Service</a>.
      </p>
    </div>

    <%# Checking whether they already reported it %>
    <div class="rcm-body" id="rcmStep0" hidden>
      <div class="rcm-done"><i class="fa fa-spinner fa-spin" aria-hidden="true"></i><p>One moment…</p></div>
    </div>

    <%# Already reported: one open report per person per community %>
    <div class="rcm-body" id="rcmStep4" hidden>
      <div class="rcm-done">
        <i class="fa fa-flag" aria-hidden="true"></i>
        <h4>Already reported</h4>
        <p>You've already reported this community. Our team will review it, and you can report it again once they have.</p>
      </div>
    </div>

    <%# Done %>
    <div class="rcm-body" id="rcmStep3" hidden>
      <div class="rcm-done">
        <i class="fa fa-circle-check" aria-hidden="true"></i>
        <h4>Report Submitted</h4>
        <p>Thank you for helping keep our community safe.</p>
      </div>
    </div>

    <div class="rcm-foot">
      <p class="rcm-error" id="rcmError" hidden role="alert"></p>
      <button type="button" class="rcm-primary" id="rcmPrimary" disabled>Next</button>
    </div>
  </div>
</div>

<script>
  (function () {
    var COMMUNITY_ID = <%- JSON.stringify(String(reportCommunityId || '')) %>;
    var MAX = <%- JSON.stringify(Number(reportDetailsMax) || 2000) %>;
    var MIN = <%- JSON.stringify(Number(reportDetailsMin) || 20) %>;
    var OFF_HELP = <%- JSON.stringify(offPlatformHelp || {}) %>;
    var CHILD_SAFETY = 'Child Safety';
    var IMPERSONATION = 'Impersonation';

    var modal = document.getElementById('reportCommunityModal');
    if (!modal) return;
    var title = document.getElementById('rcmTitle');
    var back = document.getElementById('rcmBack');
    var cancel = document.getElementById('rcmCancel');
    // 0 checking, 1 reason, 2 review, 3 submitted, 4 already reported
    // 5 where did this happen, 6 it did not happen here
    var steps = [document.getElementById('rcmStep0'), document.getElementById('rcmStep1'), document.getElementById('rcmStep2'),
                 document.getElementById('rcmStep3'), document.getElementById('rcmStep4'),
                 document.getElementById('rcmStepLoc'), document.getElementById('rcmStepOff')];
    var STEP_LOCATION = 5, STEP_OFF = 6;
    // The end screens carry their own heading, so the header does not repeat it.
    var TITLES = ['Report community', 'Select a reason', 'Review Report', 'Report community', 'Report community',
                  'Where did this happen?', 'Report community'];
    var primary = document.getElementById('rcmPrimary');
    var errorEl = document.getElementById('rcmError');
    var details = document.getElementById('rcmDetails');
    var count = document.getElementById('rcmCount');
    var selectedEl = document.getElementById('rcmSelected');
    // Reason buttons only: the location step uses the same class.
    var options = Array.prototype.slice.call(document.querySelectorAll('#rcmStep1 .rcm-option'));
    var locationOptions = Array.prototype.slice.call(document.querySelectorAll('#rcmStepLoc [data-location]'));
    var impersonated = document.getElementById('rcmImpersonated');
    var impersonationGroup = document.getElementById('rcmImpersonationGroup');

    var state = { step: 1, reason: '', location: '', submitting: false, lastFocus: null, checkSeq: 0 };

    function showStep(n) {
      state.step = n;
      for (var i = 0; i < steps.length; i++) steps[i].hidden = i !== n;
      title.textContent = TITLES[n];
      back.hidden = !(n === 1 || n === 2);
      cancel.textContent = (n === 3 || n === 4 || n === STEP_OFF) ? 'Close' : 'Cancel';
      errorEl.hidden = true;
      if (n === 0) { primary.textContent = 'Next'; primary.disabled = true; }
      if (n === STEP_LOCATION) { primary.textContent = 'Next'; primary.disabled = !state.location; }
      if (n === 1) { primary.textContent = 'Next'; primary.disabled = !state.reason; }
      if (n === 2) {
        primary.textContent = 'Submit Report';
        primary.disabled = false;
        selectedEl.textContent = state.reason;
        // Without a name, an impersonation claim cannot be checked at all.
        impersonationGroup.hidden = state.reason !== IMPERSONATION;
        if (impersonationGroup.hidden) impersonated.value = '';
      }
      if (n === 3 || n === 4 || n === STEP_OFF) { primary.textContent = 'Done'; primary.disabled = false; }
    }

    function escapeText(v) {
      return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // Where to send someone whose report is not about this product. Child
    // safety goes to NCMEC wherever it happened: they take reports from anyone,
    // about any platform.
    function showOffPlatform() {
      var help = OFF_HELP[state.location];
      document.getElementById('rcmOffLede').textContent =
        'This did not happen in Lines Police CAD, so we cannot see it or verify it. '
        + (help ? 'Report it to ' + help.name + ', who can.' : 'Report it to whoever runs the app or site it happened on.');

      var html = '';
      if (help) {
        html += '<a class="rcm-off-link" href="' + escapeText(help.url) + '" target="_blank" rel="noopener noreferrer">'
          + '<span>Report to ' + escapeText(help.name) + '<small>' + escapeText(help.url) + '</small></span>'
          + '<i class="fa fa-arrow-up-right-from-square" aria-hidden="true"></i></a>';
      }
      if (state.reason === CHILD_SAFETY || !state.reason) {
        html += '<a class="rcm-off-link" href="https://report.cybertip.org" target="_blank" rel="noopener noreferrer">'
          + '<span>Child safety, anywhere: NCMEC CyberTipline<small>report.cybertip.org</small></span>'
          + '<i class="fa fa-arrow-up-right-from-square" aria-hidden="true"></i></a>';
      }
      document.getElementById('rcmOffLinks').innerHTML = html;
      showStep(STEP_OFF);
    }

    // Ask before showing the form. A failed check falls through to the form:
    // the API still discards a duplicate on submit, and says so.
    function checkAlreadyReported() {
      var seq = ++state.checkSeq;
      return fetch('/community/' + encodeURIComponent(COMMUNITY_ID) + '/report/status', { credentials: 'same-origin' })
        .then(function (res) { return res.ok ? res.json() : { open: false }; })
        .catch(function () { return { open: false }; })
        .then(function (body) {
          if (seq !== state.checkSeq || modal.hidden) return;
          showStep(body && body.open ? 4 : STEP_LOCATION);
          if (!(body && body.open)) (locationOptions[0] || cancel).focus();
        });
    }

    function open() {
      state.reason = '';
      state.location = '';
      state.submitting = false;
      details.value = '';
      impersonated.value = '';
      locationOptions.forEach(function (o) { o.setAttribute('aria-checked', 'false'); });
      updateCount();
      options.forEach(function (o) { o.setAttribute('aria-checked', 'false'); });
      state.lastFocus = document.activeElement;
      showStep(0);
      modal.hidden = false;
      // Lock the page behind the modal, so scrolling the list does not scroll it.
      document.body.classList.add('modal-open');
      document.body.style.overflow = 'hidden';
      steps[1].scrollTop = 0;
      cancel.focus();
      checkAlreadyReported();
    }

    function close() {
      modal.hidden = true;
      document.body.classList.remove('modal-open');
      document.body.style.overflow = '';
      if (state.lastFocus && state.lastFocus.focus) state.lastFocus.focus();
    }

    function updateCount() {
      var n = details.value.length;
      count.textContent = n > 0 ? n + '/' + MAX : 'optional';
    }

    options.forEach(function (o) {
      o.addEventListener('click', function () {
        state.reason = o.getAttribute('data-reason');
        options.forEach(function (x) { x.setAttribute('aria-checked', x === o ? 'true' : 'false'); });
        primary.disabled = false;
      });
    });

    locationOptions.forEach(function (o) {
      o.addEventListener('click', function () {
        state.location = o.getAttribute('data-location');
        locationOptions.forEach(function (x) { x.setAttribute('aria-checked', x === o ? 'true' : 'false'); });
        primary.disabled = false;
      });
    });

    details.addEventListener('input', updateCount);
    back.addEventListener('click', function () { showStep(state.step === 1 ? STEP_LOCATION : 1); });
    cancel.addEventListener('click', close);
    modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
    document.addEventListener('keydown', function (e) { if (!modal.hidden && e.key === 'Escape') close(); });

    primary.addEventListener('click', function () {
      if (state.step === STEP_LOCATION) {
        if (!state.location) return;
        // Nothing is filed for another platform. We point them at it instead.
        if (state.location !== 'in_app') { showOffPlatform(); return; }
        showStep(1);
        return;
      }
      if (state.step === 1) {
        if (state.reason) showStep(2);
        return;
      }
      if (state.step === 3 || state.step === 4 || state.step === STEP_OFF) { close(); return; }
      if (state.step === 0) return;
      if (state.submitting) return;

      // Flag the field rather than only toasting.
      if (details.value.trim().length < MIN) {
        details.style.borderColor = '#f87171';
        errorEl.textContent = 'Please describe what you saw, in at least ' + MIN + ' characters.';
        errorEl.hidden = false;
        details.focus();
        return;
      }
      details.style.borderColor = '';
      if (state.reason === IMPERSONATION && !impersonated.value.trim()) {
        impersonated.style.borderColor = '#f87171';
        errorEl.textContent = 'Tell us who this community is pretending to be.';
        errorEl.hidden = false;
        impersonated.focus();
        return;
      }
      impersonated.style.borderColor = '';

      state.submitting = true;
      primary.disabled = true;
      primary.textContent = 'Submitting…';
      errorEl.hidden = true;

      fetch('/community/' + encodeURIComponent(COMMUNITY_ID) + '/report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          reason: state.reason,
          details: details.value,
          location: state.location,
          impersonatedName: impersonated.value
        })
      })
        .then(function (res) {
          return res.json().catch(function () { return {}; }).then(function (body) {
            if (!res.ok) throw new Error((body && body.message) || 'Failed to submit report. Please try again.');
            return body;
          });
        })
        // A duplicate is not stored, so it must not be announced as a new
        // report: say it was already reported, same as when the form opens.
        .then(function (body) { showStep(body && body.duplicate ? 4 : 3); })
        .catch(function (err) {
          errorEl.textContent = err.message || 'Failed to submit report. Please try again.';
          errorEl.hidden = false;
          primary.disabled = false;
          primary.textContent = 'Submit Report';
        })
        .then(function () { state.submitting = false; });
    });

    window.openReportCommunityModal = open;
  })();
</script>
