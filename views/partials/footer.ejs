<!-- Shared Footer for Internal Pages -->
<footer style="background: #0a0a0f; border-top: 1px solid rgba(59, 130, 246, 0.2); margin-top: 2rem;">
  <div style="padding: 2rem 1rem;">
    <!-- Logo -->
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 0.5rem;">
        <img src="/static/images/lines-police-cad-discord-logo-2024-github-profile.png" alt="Lines Police CAD" style="height: 36px; width: auto;" />
      </div>
      <p style="color: #64748b; font-size: 14px; margin: 0;">World's Leading Free-to-use Role-play Facilitator</p>
    </div>

    <!-- Social Links -->
    <div style="display: flex; justify-content: center; gap: 1rem; margin-bottom: 1.5rem;">
      <a href="https://discord.gg/fVFAA6UcUQ" target="_blank" class="lpc-footer-social" style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #94a3b8; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(59, 130, 246, 0.2); text-decoration: none;">
        <i class="fab fa-discord"></i>
      </a>
      <a href="https://x.com/LinesPoliceCAD" target="_blank" class="lpc-footer-social" style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #94a3b8; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(59, 130, 246, 0.2); text-decoration: none;">
        <i class="fa-brands fa-x-twitter"></i>
      </a>
      <a href="https://www.facebook.com/linespoliceserver/" target="_blank" class="lpc-footer-social" style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #94a3b8; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(59, 130, 246, 0.2); text-decoration: none;">
        <i class="fab fa-facebook"></i>
      </a>
      <a href="https://github.com/linesmerrill/police-cad" target="_blank" class="lpc-footer-social" style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #94a3b8; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(59, 130, 246, 0.2); text-decoration: none;">
        <i class="fab fa-github"></i>
      </a>
    </div>

    <!-- Links -->
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.5rem; margin-bottom: 1.5rem;">
      <a href="/faq" class="lpc-footer-link" style="color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; font-size: 12px; text-decoration: none;">FAQ</a>
      <a href="/contact-us" class="lpc-footer-link" style="color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; font-size: 12px; text-decoration: none;">Contact</a>
      <a href="https://status.linespolice-cad.com" target="_blank" rel="noopener noreferrer" class="lpc-footer-link" style="color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; font-size: 12px; text-decoration: none;">Status</a>
      <a href="/terms-and-conditions" class="lpc-footer-link" style="color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; font-size: 12px; text-decoration: none;">Terms</a>
      <a href="/privacy-policy" class="lpc-footer-link" style="color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; font-size: 12px; text-decoration: none;">Privacy</a>
      <a href="/about-us" class="lpc-footer-link" style="color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; font-size: 12px; text-decoration: none;">About</a>
    </div>

    <!-- Copyright -->
    <div style="text-align: center; color: #475569; font-size: 12px;">
      &copy; 2020-<%= new Date().getFullYear() %> Lines Police CAD. All rights reserved.
    </div>

    <!-- Build Version -->
    <div style="text-align: center; color: #334155; font-size: 12px; margin-top: 0.5rem;">
      <span
        id="footer-build-version"
        style="cursor: pointer;"
        title="Click to copy build version"
        data-version="<%= typeof buildVersion !== 'undefined' ? buildVersion : 'unknown' %>"
      >Build: <%= typeof buildVersion !== 'undefined' ? buildVersion : 'unknown' %></span>
    </div>
  </div>
</footer>
<style>
  .lpc-footer-social:hover { color: #fff !important; }
  .lpc-footer-link:hover { color: #fff !important; }
  #footer-build-version:hover { color: #64748b !important; }
</style>
<script>
(function() {
  try {
    var p = window.location.pathname;
    if (/^\/(civ|department|police|ems|dispatch|command|judicial|fire|community)-dashboard\/?$/.test(p)) {
      // Preserve search + hash so /department-dashboard?departmentId=X returns
      // to the same department (not a generic landing).
      var full = p.replace(/\/$/, '') + (window.location.search || '') + (window.location.hash || '');
      localStorage.setItem('lpc.lastDashboard', full);
    }
  } catch (e) {}
})();
(function() {
  var el = document.getElementById('footer-build-version');
  if (el) {
    el.addEventListener('click', function() {
      var version = el.getAttribute('data-version');
      navigator.clipboard.writeText('Build: ' + version).then(function() {
        el.textContent = 'Copied!';
        setTimeout(function() {
          el.textContent = 'Build: ' + version;
        }, 1500);
      });
    });
  }
})();
</script>

<%- include('partials/whats-new') %>
