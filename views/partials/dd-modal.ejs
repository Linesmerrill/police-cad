<%
  /*
   * Shared confirmation/alert modal for standalone pages that don't get
   * the dept- or command-dashboard's modal (e.g. /wallet, /inbox,
   * /economy-settings).
   *
   * Exposes window.ddModal({type, icon, title, message, detail, buttons,
   * confirmText, confirmIcon, cancelText, onConfirm, onCancel}) and
   * window.ddCloseModal() — same API as the jQuery version in
   * department-dashboard.ejs so callers don't change between surfaces.
   *
   * Vanilla JS (no jQuery dependency) so it can drop into any page.
   * Idempotent on re-include: guards against double-injecting the HTML
   * and only assigns window.ddModal once.
   */
%>
<style>
  /* Mirror of the dept-dashboard modal styles. Standalone pages don't
     have the --dd-* token palette set up, so we substitute literals that
     match the dark-glass aesthetic used by /wallet & /inbox. */
  .ddm-overlay {
    position: fixed; inset: 0; z-index: 10001;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ddm-overlay.visible { opacity: 1; pointer-events: auto; }
  .ddm-modal {
    background: rgba(16, 17, 24, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    width: 90%; max-width: 420px;
    overflow: hidden;
    transform: scale(0.92) translateY(12px);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5), 0 0 1px rgba(255, 255, 255, 0.05) inset;
    position: relative;
    font-family: 'Outfit', system-ui, sans-serif;
  }
  .ddm-overlay.visible .ddm-modal { transform: scale(1) translateY(0); }
  .ddm-modal::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: var(--ddm-accent, #8b5cf6); opacity: 0.85;
  }
  .ddm-header {
    padding: 1.1rem 1.25rem 0;
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
  }
  .ddm-header h3 {
    font-size: 0.95rem; font-weight: 600; color: #e2e8f0; margin: 0;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .ddm-close {
    width: 28px; height: 28px; border-radius: 6px;
    background: transparent; border: none; color: #94a3b8;
    font-size: 0.875rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s, color 0.15s;
  }
  .ddm-close:hover { color: #fff; background: rgba(255,255,255,0.06); }
  .ddm-body { padding: 1.25rem 1.25rem 1.1rem; text-align: center; }
  .ddm-icon {
    width: 52px; height: 52px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.25rem; margin: 0 auto 0.85rem; position: relative;
  }
  .ddm-icon::after {
    content: ''; position: absolute; inset: -4px; border-radius: 50%;
    background: inherit; opacity: 0.3; filter: blur(8px); z-index: -1;
  }
  .ddm-msg { font-size: 0.85rem; line-height: 1.5; color: #e2e8f0; margin: 0 0 0.35rem; }
  .ddm-detail { color: #94a3b8; font-size: 0.75rem; line-height: 1.45; margin: 0; }
  .ddm-footer { padding: 0 1.25rem 1.2rem; display: flex; gap: 0.5rem; }
  .ddm-btn {
    flex: 1; padding: 0.55rem 1rem; border-radius: 8px;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.825rem; font-weight: 600; cursor: pointer; border: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    text-decoration: none; text-align: center;
    display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;
  }
  .ddm-btn-secondary { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.10); color: #cbd5e1; }
  .ddm-btn-secondary:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .ddm-btn-primary { background: rgba(139, 92, 246, 0.20); border: 1px solid rgba(139, 92, 246, 0.32); color: #c4b5fd; }
  .ddm-btn-primary:hover { background: rgba(139, 92, 246, 0.30); border-color: rgba(139,92,246,0.5); color: #fff; }
  .ddm-btn-danger { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.28); color: #fca5a5; }
  .ddm-btn-danger:hover { background: rgba(239,68,68,0.25); border-color: rgba(239,68,68,0.42); color: #fff; }
  .ddm-btn-warning { background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.28); color: #fcd34d; }
  .ddm-btn-warning:hover { background: rgba(245,158,11,0.25); border-color: rgba(245,158,11,0.42); color: #fff; }
  /* Map dd-modal-btn-* class names (used by callers like the dept dashboard
     and the wallet's clock-in modals) to the ddm-btn-* styles so the same
     buttons[] options work on both surfaces. */
  .dd-modal-btn { all: unset; }
  .ddm-footer .dd-modal-btn { /* fall through to .ddm-btn styling below */ }
</style>

<div class="ddm-overlay" id="ddm-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="ddm-title">
  <div class="ddm-modal" role="document">
    <div class="ddm-header">
      <h3 id="ddm-title"></h3>
      <button type="button" class="ddm-close" id="ddm-close" aria-label="Close">
        <i class="fa fa-times"></i>
      </button>
    </div>
    <div class="ddm-body">
      <div class="ddm-icon" id="ddm-icon"></div>
      <p class="ddm-msg" id="ddm-msg"></p>
      <p class="ddm-detail" id="ddm-detail"></p>
    </div>
    <div class="ddm-footer" id="ddm-footer"></div>
  </div>
</div>

<script>
  (function() {
    if (window.ddModal) return; // already installed (e.g. by dept-dashboard)

    var TYPES = {
      danger:  { accent: '#ef4444', iconBg: 'rgba(239,68,68,0.12)',  iconColor: '#fca5a5', btnClass: 'ddm-btn-danger' },
      warning: { accent: '#f59e0b', iconBg: 'rgba(245,158,11,0.12)', iconColor: '#fcd34d', btnClass: 'ddm-btn-warning' },
      info:    { accent: '#3b82f6', iconBg: 'rgba(59,130,246,0.12)', iconColor: '#93c5fd', btnClass: 'ddm-btn-primary' },
      confirm: { accent: '#8b5cf6', iconBg: 'rgba(139,92,246,0.12)', iconColor: '#c4b5fd', btnClass: 'ddm-btn-primary' },
    };

    var overlay = document.getElementById('ddm-overlay');
    var titleEl = document.getElementById('ddm-title');
    var iconEl = document.getElementById('ddm-icon');
    var msgEl = document.getElementById('ddm-msg');
    var detailEl = document.getElementById('ddm-detail');
    var footerEl = document.getElementById('ddm-footer');
    var closeBtn = document.getElementById('ddm-close');
    var modalEl = overlay.querySelector('.ddm-modal');
    var currentOnCancel = null;

    function closeModal() {
      overlay.classList.remove('visible');
      overlay.setAttribute('aria-hidden', 'true');
      currentOnCancel = null;
    }

    // Map the dept-dashboard's dd-modal-btn-* class names to our ddm-btn-*
    // equivalents so callers that pass `{class: 'dd-modal-btn-primary'}` keep
    // working without modification.
    function mapBtnClass(cls) {
      if (!cls) return 'ddm-btn-secondary';
      return cls
        .replace('dd-modal-btn-secondary', 'ddm-btn-secondary')
        .replace('dd-modal-btn-primary',   'ddm-btn-primary')
        .replace('dd-modal-btn-danger',    'ddm-btn-danger')
        .replace('dd-modal-btn-warning',   'ddm-btn-warning');
    }

    function setIcon(name, type) {
      iconEl.style.background = type.iconBg;
      iconEl.innerHTML = '<i class="fa ' + (name || 'fa-info-circle') + '" style="color:' + type.iconColor + ';font-size:1.375rem;"></i>';
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
        return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
      });
    }

    function buildBtn(opts, fallbackType) {
      var cls = 'ddm-btn ' + mapBtnClass(opts.class || fallbackType.btnClass);
      var node;
      if (opts.href) {
        node = document.createElement('a');
        node.className = cls;
        node.setAttribute('href', opts.href);
      } else {
        node = document.createElement('button');
        node.type = 'button';
        node.className = cls;
      }
      var inner = '';
      if (opts.icon) inner += '<i class="fa ' + opts.icon + '"></i> ';
      inner += escapeHtml(opts.label || 'OK');
      node.innerHTML = inner;
      if (!opts.href) {
        node.addEventListener('click', function() {
          closeModal();
          if (opts.onClick) opts.onClick();
        });
      }
      return node;
    }

    window.ddModal = function(opts) {
      opts = opts || {};
      var type = TYPES[opts.type] || TYPES.confirm;
      modalEl.style.setProperty('--ddm-accent', type.accent);
      titleEl.innerHTML = '<i class="fa ' + (opts.icon || 'fa-info-circle') + '" style="color:' + type.iconColor + ';"></i> ' + escapeHtml(opts.title || 'Confirm');
      setIcon(opts.icon, type);
      msgEl.innerHTML = opts.message || '';
      if (opts.detail) { detailEl.innerHTML = opts.detail; detailEl.style.display = ''; }
      else { detailEl.innerHTML = ''; detailEl.style.display = 'none'; }

      footerEl.innerHTML = '';
      if (Array.isArray(opts.buttons) && opts.buttons.length) {
        opts.buttons.forEach(function(b) { footerEl.appendChild(buildBtn(b, type)); });
      } else {
        // Cancel + Confirm default. Mirrors the dept-dashboard's jQuery
        // implementation so callers that omit `buttons` get the same shape.
        var cancel = buildBtn({
          label: opts.cancelText || 'Cancel',
          class: 'ddm-btn-secondary',
          onClick: function() { if (opts.onCancel) opts.onCancel(); },
        }, type);
        var confirm = buildBtn({
          label: opts.confirmText || 'Confirm',
          icon: opts.confirmIcon,
          class: type.btnClass,
          onClick: function() { if (opts.onConfirm) opts.onConfirm(); },
        }, type);
        footerEl.appendChild(cancel);
        footerEl.appendChild(confirm);
      }

      currentOnCancel = opts.onCancel || null;
      overlay.classList.add('visible');
      overlay.setAttribute('aria-hidden', 'false');
    };

    window.ddCloseModal = closeModal;

    closeBtn.addEventListener('click', function() {
      var cb = currentOnCancel;
      closeModal();
      if (cb) cb();
    });
    overlay.addEventListener('click', function(e) {
      // Backdrop click cancels (matches the dashboard helpers' behavior).
      if (e.target === overlay) {
        var cb = currentOnCancel;
        closeModal();
        if (cb) cb();
      }
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.classList.contains('visible')) {
        var cb = currentOnCancel;
        closeModal();
        if (cb) cb();
      }
    });
  })();
</script>
