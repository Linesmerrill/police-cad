<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | Lines Police CAD</title>

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="shortcut icon" type="image/ico" href="/static/images/favicon.ico">

  <%- include('ad-header') %>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
      color: #f0f0f5;
      background: #0a0a0f;
    }

    /* ── Background layers ── */
    .bg-image {
      position: fixed;
      inset: 0;
      background-image: url('/static/static/images/landing-bg.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 0;
    }

    .bg-overlay {
      position: fixed;
      inset: 0;
      background: linear-gradient(180deg, rgba(10,10,15,0.88) 0%, rgba(26,26,46,0.82) 50%, rgba(10,10,15,0.92) 100%);
      z-index: 1;
    }

    .bg-radials {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse at 25% 0%, rgba(59,130,246,0.12) 0%, transparent 55%),
        radial-gradient(ellipse at 75% 100%, rgba(139,92,246,0.10) 0%, transparent 55%),
        radial-gradient(ellipse at 50% 50%, rgba(251,191,36,0.04) 0%, transparent 60%);
      z-index: 2;
    }

    .bg-grid {
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(59,130,246,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59,130,246,0.03) 1px, transparent 1px);
      background-size: 50px 50px;
      opacity: 0.5;
      z-index: 2;
    }

    .noise {
      position: fixed;
      inset: 0;
      opacity: 0.03;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      z-index: 2;
    }

    /* ── Navbar ── */
    .navbar {
      position: relative;
      z-index: 10;
      background: rgba(15,15,20,0.9);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .navbar-inner {
      max-width: 80rem;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      height: 64px;
    }

    .navbar-logo {
      text-decoration: none;
      display: flex;
      align-items: center;
    }

    .navbar-logo img {
      height: 2.25rem;
      width: auto;
      display: block;
    }

    .navbar-links {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .navbar-links a {
      font-size: 0.85rem;
      font-weight: 600;
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: color 0.2s;
    }

    .navbar-links a:hover { color: #fff; }

    .navbar-cta {
      font-size: 0.85rem;
      font-weight: 700;
      color: #fff;
      text-decoration: none;
      padding: 0.6rem 1.25rem;
      border-radius: 6px;
      background: rgba(251,191,36,0.15);
      border: 1px solid rgba(251,191,36,0.35);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.25s;
    }

    .navbar-cta:hover {
      background: rgba(251,191,36,0.25);
      border-color: rgba(251,191,36,0.5);
      transform: translateY(-1px);
    }

    /* ── Page Content ── */
    .page {
      position: relative;
      z-index: 5;
      min-height: calc(100vh - 64px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem 1.5rem;
    }

    /* ── 404 Number ── */
    .error-number {
      font-size: clamp(6rem, 18vw, 12rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.04em;
      margin-bottom: 1rem;
      position: relative;
      display: inline-block;
      animation: fadeDown 0.6s ease-out, float 4s ease-in-out 0.6s infinite;
    }

    .error-number-glow {
      position: absolute;
      inset: 0;
      color: #3b82f6;
      text-shadow: 0 0 40px rgba(59,130,246,0.5), 0 0 80px rgba(59,130,246,0.25);
      filter: blur(3px);
      z-index: 0;
    }

    .error-number-text {
      position: relative;
      z-index: 1;
      background: linear-gradient(135deg, #ffffff 0%, rgba(255,255,255,0.6) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ── Card ── */
    .card {
      background: rgba(15,15,25,0.65);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 1.5rem;
      padding: 2.5rem 2.5rem 3rem;
      max-width: 540px;
      width: 100%;
      text-align: center;
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.03),
        0 24px 48px rgba(0,0,0,0.4),
        0 0 80px rgba(59,130,246,0.04);
      animation: slideUp 0.7s ease-out;
    }

    .card h1 {
      font-size: 1.65rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, #ffffff 0%, rgba(255,255,255,0.7) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .card .subtitle {
      font-size: 1rem;
      line-height: 1.7;
      color: rgba(255,255,255,0.50);
      margin-bottom: 2.25rem;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }

    /* ── Buttons ── */
    .actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      align-items: center;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.85rem 1.75rem;
      border-radius: 0.75rem;
      font-weight: 600;
      font-size: 0.9rem;
      font-family: inherit;
      text-decoration: none;
      transition: all 0.25s ease;
      cursor: pointer;
      border: none;
      width: 100%;
      max-width: 280px;
    }

    .btn-primary {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      color: #0a0a0f;
      box-shadow: 0 4px 20px rgba(251,191,36,0.25);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(251,191,36,0.35);
    }

    .btn-secondary {
      background: linear-gradient(135deg, rgba(59,130,246,0.12) 0%, rgba(99,102,241,0.12) 100%);
      color: #93a8f4;
      border: 1px solid rgba(59,130,246,0.25);
    }

    .btn-secondary:hover {
      background: linear-gradient(135deg, rgba(59,130,246,0.2) 0%, rgba(99,102,241,0.2) 100%);
      border-color: rgba(59,130,246,0.4);
      transform: translateY(-1px);
    }

    .btn-ghost {
      background: rgba(255,255,255,0.04);
      color: rgba(255,255,255,0.5);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .btn-ghost:hover {
      background: rgba(255,255,255,0.08);
      color: rgba(255,255,255,0.7);
      transform: translateY(-1px);
    }

    .divider {
      width: 40px;
      height: 1px;
      background: rgba(255,255,255,0.08);
      margin: 0.25rem auto;
    }

    /* ── Footer ── */
    .footer {
      position: relative;
      z-index: 10;
      background: rgba(10,10,15,0.95);
      border-top: 1px solid rgba(59,130,246,0.15);
      padding: 2.5rem 1.5rem 1.5rem;
      text-align: center;
    }

    .footer-logo {
      margin-bottom: 1rem;
    }

    .footer-logo img {
      height: 32px;
      width: auto;
    }

    .footer-tagline {
      color: rgba(255,255,255,0.35);
      font-size: 0.8rem;
      margin-bottom: 1.5rem;
    }

    .footer-social {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .footer-social a {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(255,255,255,0.4);
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(59,130,246,0.15);
      text-decoration: none;
      font-size: 0.85rem;
      transition: all 0.25s;
    }

    .footer-social a:hover {
      color: #fff;
      background: rgba(59,130,246,0.15);
      border-color: rgba(59,130,246,0.35);
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .footer-links a {
      color: rgba(255,255,255,0.4);
      text-decoration: none;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: color 0.2s;
    }

    .footer-links a:hover { color: #fff; }

    .footer-copy {
      color: rgba(255,255,255,0.2);
      font-size: 0.7rem;
    }

    .footer-build {
      color: rgba(255,255,255,0.15);
      font-size: 0.7rem;
      margin-top: 0.5rem;
      cursor: pointer;
      transition: color 0.2s;
    }

    .footer-build:hover { color: rgba(255,255,255,0.35); }

    /* ── Animations ── */
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeDown {
      from { opacity: 0; transform: translateY(-16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(-8px); }
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .navbar-links { display: none; }
      .navbar-cta   { display: none; }

      .card {
        padding: 2rem 1.25rem 2.5rem;
        border-radius: 1.25rem;
      }

      .card h1 { font-size: 1.35rem; }
      .card .subtitle { font-size: 0.9rem; }
    }

    @media (max-width: 480px) {
      .error-number { font-size: 5rem; }
    }
  </style>
</head>
<body>
  <!-- Background layers -->
  <div class="bg-image"></div>
  <div class="bg-overlay"></div>
  <div class="bg-radials"></div>
  <div class="bg-grid"></div>
  <div class="noise"></div>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/" class="navbar-logo">
        <img src="/static/images/lines-police-cad-discord-logo-2024-github-profile.png" alt="Lines Police CAD">
      </a>
      <div class="navbar-links">
        <a href="/">Home</a>
        <a href="/pricing">Pricing</a>
        <a href="/about-us">About</a>
        <a href="/faq">FAQ</a>
        <a href="/contact-us">Contact Us</a>
        <a href="/discord-bot">Discord Bot</a>
      </div>
      <a href="/signup-civ" class="navbar-cta">Get Started</a>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="page">
    <div class="error-number">
      <span class="error-number-glow" aria-hidden="true">404</span>
      <span class="error-number-text">404</span>
    </div>

    <div class="card">
      <h1>Page Not Found</h1>
      <p class="subtitle">
        The page you're looking for doesn't exist or has been moved. Let's get you back on track.
      </p>

      <div class="actions">
        <a href="/" class="btn btn-primary">
          <i class="fas fa-home"></i>
          Return Home
        </a>

        <div class="divider"></div>

        <a href="https://status.linespolice-cad.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <i class="fas fa-signal"></i>
          Check Service Status
        </a>

        <a href="/contact-us" class="btn btn-ghost">
          <i class="fas fa-envelope"></i>
          Contact Support
        </a>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-logo">
      <img src="/static/images/lines-police-cad-discord-logo-2024-github-profile.png" alt="Lines Police CAD">
    </div>
    <p class="footer-tagline">World's Leading Free-to-use Role-play Facilitator</p>

    <div class="footer-social">
      <a href="https://discord.gg/fVFAA6UcUQ" target="_blank" rel="noopener noreferrer" title="Discord"><i class="fab fa-discord"></i></a>
      <a href="https://x.com/LinesPoliceCAD" target="_blank" rel="noopener noreferrer" title="X / Twitter"><i class="fa-brands fa-x-twitter"></i></a>
      <a href="https://www.facebook.com/linespoliceserver/" target="_blank" rel="noopener noreferrer" title="Facebook"><i class="fab fa-facebook"></i></a>
      <a href="https://github.com/linesmerrill/police-cad" target="_blank" rel="noopener noreferrer" title="GitHub"><i class="fab fa-github"></i></a>
    </div>

    <div class="footer-links">
      <a href="/faq">FAQ</a>
      <a href="/contact-us">Contact</a>
      <a href="https://status.linespolice-cad.com" target="_blank" rel="noopener noreferrer">Status</a>
      <a href="/terms-and-conditions">Terms</a>
      <a href="/privacy-policy">Privacy</a>
      <a href="/about-us">About</a>
    </div>

    <div class="footer-copy">&copy; 2020-2026 Lines Police CAD. All rights reserved.</div>
    <% if (typeof buildVersion !== 'undefined') { %>
    <div class="footer-build" id="footer-build-version"
         title="Click to copy build version"
         data-version="<%= buildVersion %>">Build: <%= buildVersion %></div>
    <% } %>
  </footer>

  <script>
  (function() {
    var el = document.getElementById('footer-build-version');
    if (el) {
      el.addEventListener('click', function() {
        var version = el.getAttribute('data-version');
        navigator.clipboard.writeText('Build: ' + version).then(function() {
          el.textContent = 'Copied!';
          setTimeout(function() {
            el.textContent = 'Build: ' + version;
          }, 1500);
        });
      });
    }
  })();
  </script>
</body>
</html>
