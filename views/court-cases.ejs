                (cNum ? '<span class="cc-case-number-pill" style="margin-right:0.4rem;">' + esc(cNum) + '</span>' : '') +
                '<i class="fa fa-user"></i><span class="cc-docket-civ-text">' + esc(civName) + '</span>' +
              '</div>' +
