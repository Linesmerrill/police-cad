        '</div>' +
        '<div class="cc-session-meta">' +
          '<span><i class="fa fa-file-lines"></i> ' + docketCount + ' case' + (docketCount !== 1 ? 's' : '') + '</span>' +
          (startedAt ? '<span><i class="fa fa-play"></i> ' + startedAt + '</span>' : '') +
          (endedAt ? '<span><i class="fa fa-stop"></i> ' + endedAt + '</span>' : '') +
