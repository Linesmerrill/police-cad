  // --- History expand/collapse ---

  window.toggleHistorySession = function(sessionId) {
    var $card = $('.cc-session-card[data-session-id="' + sessionId + '"]');
    var isExpanding = !$card.hasClass('expanded');

    // Accordion: collapse all others
    $('.cc-session-card.expanded').not($card).removeClass('expanded');
    $card.toggleClass('expanded');

    if (!isExpanding) return;

    // Fetch case details for each docket entry (if not cached)
    var $entries = $card.find('.cc-docket-entry');
    $entries.each(function() {
      var $entry = $(this);
      var caseId = $entry.data('case-id');
      if (!caseId) return;

      var $resArea = $entry.find('.cc-docket-resolutions');

      if (historyCaseCache[caseId]) {
        renderDocketResolutions($resArea, historyCaseCache[caseId]);
        return;
      }

      $resArea.html('<span style="font-size:0.78rem;color:var(--cc-text-dim);"><i class="fa fa-spinner fa-spin"></i> Loading...</span>');

      $.ajax({
        url: API_URL + '/api/v2/court-cases/' + caseId,
        method: 'GET',
        success: function(c) {
          var cd = c.courtCase || c.details || c;
          historyCaseCache[caseId] = cd;
          renderDocketResolutions($resArea, cd);
          // Backfill case number pill for legacy docket rows
          var $civWrap = $entry.find('.cc-docket-civ-name');
          if ($civWrap.length && cd.caseNumber && !$civWrap.find('.cc-case-number-pill').length) {
            $civWrap.prepend('<span class="cc-case-number-pill" style="margin-right:0.4rem;">' + esc(cd.caseNumber) + '</span>');
          }
          // Backfill civilian name if showing "Unknown"
          var $nameEl = $entry.find('.cc-docket-civ-text');
          if ($nameEl.length && (!$nameEl.text().trim() || $nameEl.text() === 'Unknown')) {
            var name = (cd.civilianName || '').trim();
            if (name) {
              $nameEl.text(name);
            } else if (cd.civilianID) {
              $.ajax({
                url: API_URL + '/api/v1/civilian/' + cd.civilianID,
                method: 'GET',
                success: function(civ) {
                  var civD = civ.civilian || civ;
                  var fullName = (civD.name || '').trim() || ((civD.firstName || '') + ' ' + (civD.lastName || '')).trim();
                  if (fullName) $nameEl.text(fullName);
                }
              });
            }
          }
        },
        error: function() {
          $resArea.html('<span style="font-size:0.78rem;color:#f87171;">Failed to load case details</span>');
        }
      });
    });
  };

  // Renders an indented list of per-charge rulings when the judge ruled
  // per-fine. Labels come from the comma-split item summary (best-effort,
  // falls back to "Charge N"). Returns empty string when no per-charge
  // rulings exist so the caller can unconditionally inline the result.
  function renderChargeRulings(item, res) {
    if (!res || !Array.isArray(res.chargeResolutions) || res.chargeResolutions.length === 0) return '';
    var labels = ((item && item.summary) || '').split(',').map(function(s) { return s.trim(); });
    var rows = res.chargeResolutions.map(function(cr) {
      var disp = cr.disposition || cr.verdict || 'upheld';
      var label = cr.name || labels[cr.fineIndex] || ('Charge ' + ((cr.fineIndex || 0) + 1));
      var rowCls = disp === 'dismissed' ? 'dismissed' : 'upheld';
      var icon = disp === 'dismissed' ? 'fa-ban' : 'fa-gavel';
      var detail = '';
      if (disp === 'reduced' || disp === 'amended') {
        detail = ' <span class="cc-charge-final">($' + Number(cr.finalAmount || 0).toLocaleString() +
          (cr.finalJailTime ? ' &middot; ' + esc(cr.finalJailTime) : '') + ')</span>';
      }
      return '<div class="cc-charge-row ' + rowCls + '">' +
               '<i class="fa ' + icon + '"></i>' +
               '<span class="cc-charge-label">' + esc(label) + '</span>' +
               '<span class="cc-charge-verdict">' + esc(disp) + detail + '</span>' +
             '</div>';
    }).join('');
    return '<div class="cc-charges">' + rows + '</div>';
  }

  function renderDocketResolutions($container, caseData) {
    var resolutions = caseData.resolutions || [];
    var contestedItems = caseData.contestedItems || [];

    if (resolutions.length === 0 && contestedItems.length === 0) {
      $container.html('<span style="font-size:0.78rem;color:var(--cc-text-dim);">No contested items</span>');
      return;
    }

    var resMap = {};
    for (var i = 0; i < resolutions.length; i++) {
      resMap[resolutions[i].itemID] = resolutions[i];
    }

    var html = contestedItems.map(function(item) {
      var res = resMap[item.itemID];
      // Reflect adjustments (reduced/amended) instead of collapsing to "upheld".
      var badge = res && res.verdict;
      if (res && Array.isArray(res.chargeResolutions) && res.chargeResolutions.length > 0) {
        var dsp = res.chargeResolutions.map(function(cr){ return cr.disposition || cr.verdict || 'upheld'; });
        var anyDismissed = dsp.indexOf('dismissed') !== -1;
        var anyReduced = dsp.indexOf('reduced') !== -1;
        var anyAmended = dsp.indexOf('amended') !== -1;
        if (dsp.every(function(d){ return d === 'dismissed'; })) badge = 'dismissed';
        else if (anyDismissed) badge = 'partial';
        else if (anyReduced && !anyAmended) badge = 'reduced';
        else if (anyAmended && !anyReduced) badge = 'amended';
        else if (anyReduced || anyAmended) badge = 'adjusted';
        else badge = 'upheld';
      }
      var badgeClass = (badge === 'reduced' || badge === 'amended' || badge === 'adjusted') ? 'adjusted' : (badge || '');
      var verdictHtml = res
        ? '<span class="cc-verdict ' + badgeClass + '">' + esc(badge || '') + '</span>'
        : '<span style="font-size:0.72rem;color:var(--cc-text-dim);">pending</span>';
      var typeClass = (item.itemType || '').toLowerCase();

      return '<div class="cc-resolution-row">' +
        '<span class="cc-resolution-type ' + typeClass + '">' + esc(item.itemType || '') + '</span>' +
        '<span class="cc-resolution-summary">' + esc(item.summary || 'No description') + '</span>' +
        verdictHtml +
      '</div>' +
      renderChargeRulings(item, res);
    }).join('');

    var notesHtml = '';
    for (var j = 0; j < resolutions.length; j++) {
      if (resolutions[j].judgeNotes) {
        notesHtml += '<div style="font-size:0.75rem;color:var(--cc-text-muted);margin-top:0.35rem;font-style:italic;">' +
          '<i class="fa fa-quote-left" style="font-size:0.6rem;margin-right:0.3rem;color:var(--cc-text-dim);"></i>' +
          esc(resolutions[j].judgeNotes) +
        '</div>';
      }
    }

    var totalsHtml = '';
    if (caseData.totalFine > 0 || (caseData.totalJailTimeLabel && caseData.totalJailTimeLabel !== 'None')) {
      totalsHtml = '<div class="cc-final-judgment">' +
        '<span class="cc-fj-title"><i class="fa fa-scale-balanced"></i> Final Judgment</span>' +
        '<span class="cc-fj-vals">$' + Number(caseData.totalFine || 0).toLocaleString() +
        ((caseData.totalJailTimeLabel && caseData.totalJailTimeLabel !== 'None') ? '  &middot;  ' + esc(caseData.totalJailTimeLabel) : '') +
        '</span></div>';
    }

    $container.html(totalsHtml + html + notesHtml);
  }

  // --- View Case Detail ---

  window.viewCase = function(caseId) {
    $('#caseDetailBody').html('<div class="cc-spinner"></div>');
    $('#caseDetailFoot').hide().empty();
    $('#caseDetailModal').addClass('open');

    $.ajax({
      url: API_URL + '/api/v2/court-cases/' + caseId,
      method: 'GET',
      success: function(c) {
        var d = c.courtCase || c.details || c;
        var statusClass = 'cc-badge-' + (d.status || 'submitted');
        var statusLabel = (d.status || 'submitted').replace('_', ' ');

        var itemsHtml = '<div id="cc-contested-items-area">' +
          (d.contestedItems || []).map(function(item) {
            var typeClass = item.itemType === 'arrest' ? 'cc-badge-in_progress' : item.itemType === 'citation' ? 'cc-badge-in_review' : 'cc-badge-submitted';
            return '<div class="cc-contested-item" data-item-id="' + esc(item.itemID) + '" data-item-type="' + esc(item.itemType) + '" style="background:var(--cc-surface);border:1px solid var(--cc-glass-border);border-radius:var(--cc-radius-sm);padding:0.65rem 0.75rem;margin-bottom:0.4rem;">' +
              '<div style="display:flex;align-items:center;gap:0.6rem;">' +
                '<span class="cc-badge ' + typeClass + '">' + esc(item.itemType) + '</span>' +
                '<span style="font-size:0.85rem;color:var(--cc-text);">' + esc(item.summary || 'No description') + '</span>' +
              '</div>' +
              '<div class="cc-item-details" style="margin-top:0.4rem;display:none;"></div>' +
            '</div>';
          }).join('') +
        '</div>';

        var historyHtml = (d.history || []).map(function(h) {
          var judgeActions = ['assigned', 'scheduled', 'started', 'completed'];
          var displayName = h.userName || '';
          if (displayName && judgeActions.indexOf(h.action) !== -1) {
            displayName = 'Judge ' + displayName;
          }
          return '<div style="display:flex;align-items:center;gap:0.75rem;padding:0.4rem 0;border-bottom:1px solid var(--cc-glass-border);">' +
            '<span style="font-size:0.72rem;color:var(--cc-text-dim);min-width:110px;">' + (h.timestamp ? new Date(h.timestamp).toLocaleString() : '') + '</span>' +
            '<span class="cc-badge cc-badge-' + h.action + '" style="font-size:0.65rem;">' + (h.action || '').replace('_', ' ') + '</span>' +
            '<span style="font-size:0.78rem;color:var(--cc-text-muted);">' + esc(displayName) + (h.notes ? ' — ' + esc(h.notes) : '') + '</span>' +
          '</div>';
        }).join('');

        var resolutionsHtml = '';
        if (d.resolutions && d.resolutions.length > 0) {
          // Map contested items by id so per-charge labels can pull from the
          // original summary string.
          var itemByID = {};
          (d.contestedItems || []).forEach(function(it) { itemByID[it.itemID] = it; });
          resolutionsHtml = '<div style="margin-top:1rem;"><div class="cc-form-label">Resolutions</div>' +
            d.resolutions.map(function(r) {
              var verdictColor = r.verdict === 'dismissed' ? 'color:#6ee7b7;'
                                : r.verdict === 'partial'   ? 'color:#c4b5fd;'
                                : 'color:#fca5a5;';
              return '<div style="background:var(--cc-surface);border:1px solid var(--cc-glass-border);border-radius:var(--cc-radius-sm);padding:0.5rem 0.75rem;margin-bottom:0.4rem;">' +
                '<div style="display:flex;justify-content:space-between;align-items:center;">' +
                  '<span style="font-size:0.85rem;color:var(--cc-text);">' + esc(r.itemType) + '</span>' +
                  '<span style="font-size:0.78rem;font-weight:600;' + verdictColor + 'text-transform:uppercase;">' + esc(r.verdict) + '</span>' +
                '</div>' +
                renderChargeRulings(itemByID[r.itemID], r) +
              '</div>';
            }).join('') +
          '</div>';
        }

        var detailHtml = '' +
          '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem;">' +
            '<div>' +
              (d.caseNumber ? '<div style="margin-bottom:0.4rem;"><span class="cc-case-number-pill">' + esc(d.caseNumber) + '</span></div>' : '') +
              '<div style="font-weight:700;font-size:1.05rem;color:#fff;">' + esc(d.civilianName || 'Unknown') + '</div>' +
              '<div style="font-size:0.8rem;color:var(--cc-text-muted);margin-top:0.15rem;">Submitted ' + (d.createdAt ? new Date(d.createdAt).toLocaleDateString() : '') + '</div>' +
            '</div>' +
            '<span class="cc-badge ' + statusClass + '">' + statusLabel + '</span>' +
          '</div>' +
          (d.statement ? '<div style="margin-bottom:1rem;"><div class="cc-form-label">Civilian Statement</div><div style="background:var(--cc-surface);border:1px solid var(--cc-glass-border);border-radius:var(--cc-radius-sm);padding:0.75rem;font-size:0.85rem;color:var(--cc-text);font-style:italic;">' + esc(d.statement) + '</div></div>' : '') +
          '<div style="margin-bottom:1rem;"><div class="cc-form-label">Contested Items (' + (d.contestedItems || []).length + ')</div>' + itemsHtml + '</div>' +
          (d.judgeName ? '<div style="margin-bottom:1rem;font-size:0.82rem;color:var(--cc-text-muted);"><i class="fa fa-gavel" style="color:var(--cc-accent);margin-right:0.3rem;"></i> Assigned to <strong style="color:#fff;">Judge ' + esc(d.judgeName) + '</strong></div>' : '') +
          (isValidDate(d.scheduledDate) ? '<div style="margin-bottom:1rem;font-size:0.82rem;color:var(--cc-text-muted);"><i class="fa fa-calendar" style="color:#4ade80;margin-right:0.3rem;"></i> Scheduled for <strong style="color:#fff;">' + new Date(d.scheduledDate).toLocaleString() + '</strong></div>' : '<div style="margin-bottom:1rem;font-size:0.82rem;color:var(--cc-text-dim);"><i class="fa fa-calendar" style="margin-right:0.3rem;"></i> Not yet scheduled</div>') +
          resolutionsHtml +
          (historyHtml ? '<div style="margin-top:1rem;"><div class="cc-form-label">History</div>' + historyHtml + '</div>' : '');

        $('#caseDetailBody').html(detailHtml);

        // Show delete button for case owner
        var $foot = $('#caseDetailFoot');
        if (currentUserId && d.userID && d.userID === currentUserId) {
          $foot.html('<button class="cc-btn" style="background:rgba(239,68,68,0.15);color:#f87171;border:1px solid rgba(239,68,68,0.3);" onclick="deleteCivilianCase(\'' + caseId + '\')"><i class="fa fa-trash"></i> Delete Case</button>').css('display', 'flex');
        } else {
          $foot.hide().empty();
        }

        // Enrich contested items with actual record details
        enrichContestedItems(d.civilianID, d.contestedItems || []);
      },
      error: function() {
        $('#caseDetailBody').html('<div class="cc-empty"><i class="fa fa-exclamation-triangle"></i>Failed to load case details.</div>');
        $('#caseDetailFoot').hide().empty();
      }
    });
  };

  window.deleteCivilianCase = function(caseId) {
    if (!confirm('Delete this court case? If it is not completed, contested charges will be reverted. This cannot be undone.')) return;
    $.ajax({
      url: API_URL + '/api/v2/court-cases/' + caseId + '?userId=' + encodeURIComponent(currentUserId || ''),
      method: 'DELETE',
      success: function() {
        $('#caseDetailModal').removeClass('open');
        loadQueue();
        loadScheduled();
      },
      error: function(xhr) {
        alert((xhr.responseJSON && xhr.responseJSON.message) || 'Failed to delete court case.');
      }
    });
  };

  function enrichContestedItems(civilianId, contestedItems) {
    if (!civilianId || !contestedItems.length) return;

    $.ajax({
      url: API_URL + '/api/v1/civilian/' + civilianId,
      method: 'GET',
      success: function(civ) {
        var civData = civ.civilian || civ;
        var crimHistory = civData.criminalHistory || [];

        var historyMap = {};
        for (var i = 0; i < crimHistory.length; i++) {
          historyMap[crimHistory[i]._id] = crimHistory[i];
        }

        contestedItems.forEach(function(item) {
          var $el = $('.cc-contested-item[data-item-id="' + item.itemID + '"]');
          var $details = $el.find('.cc-item-details');

          if (item.itemType === 'citation' || item.itemType === 'warning') {
            var entry = historyMap[item.itemID];
            if (entry) {
              var fines = entry.fines || [];
              var detailHtml = '';
              if (fines.length > 0) {
                detailHtml += fines.map(function(f) {
                  return '<div style="display:flex;justify-content:space-between;align-items:center;padding:0.25rem 0;font-size:0.8rem;">' +
                    '<span style="color:var(--cc-text);">' + esc(f.fineType || '') + ' <span style="color:var(--cc-text-dim);">(' + esc(f.category || '') + ')</span></span>' +
                    '<span style="color:var(--cc-amber);font-weight:600;">$' + esc(String(f.fineAmount || 0)) + '</span>' +
                  '</div>';
                }).join('');
              }
              if (entry.notes) {
                detailHtml += '<div style="font-size:0.78rem;color:var(--cc-text-muted);margin-top:0.3rem;font-style:italic;">' +
                  '<i class="fa fa-quote-left" style="font-size:0.6rem;margin-right:0.25rem;color:var(--cc-text-dim);"></i>' +
                  esc(entry.notes) + '</div>';
              }
              // Ticket-format details (optional) — surface the extra fields so a
              // judge has the full context on a contested ticket.
              var ticketRows = [];
              var addRow = function(label, value) {
                if (value) ticketRows.push(
                  '<div style="display:flex;justify-content:space-between;gap:0.5rem;font-size:0.75rem;padding:0.1rem 0;">' +
                    '<span style="color:var(--cc-text-dim);">' + label + '</span>' +
                    '<span style="color:var(--cc-text);text-align:right;">' + esc(value) + '</span></div>');
              };
              addRow('Location', entry.stopLocation);
              addRow('Time', entry.incidentTime);
              addRow('Phone', entry.phone);
              addRow('Officer', entry.officerBadge);
              if (entry.vehicle) {
                var v = entry.vehicle;
                var vparts = [v.color, v.make, v.model].filter(Boolean).join(' ');
                var vlabel = (vparts + (v.plate ? ' (' + v.plate + ')' : '')).trim();
                addRow('Vehicle', vlabel);
              }
              if (ticketRows.length) {
                detailHtml += '<div style="margin-top:0.4rem;padding-top:0.4rem;border-top:1px solid var(--cc-border,rgba(148,163,184,0.15));">' +
                  ticketRows.join('') + '</div>';
              }
              if (detailHtml) {
                $details.html(detailHtml).show();
              }
            }
          } else if (item.itemType === 'arrest') {
            $.ajax({
              url: API_URL + '/api/v1/arrest-report/' + item.itemID,
              method: 'GET',
              success: function(ar) {
                var report = ar.arrestReport || ar;
                var detailHtml = '';
                if (report.charges) {
                  detailHtml += '<div style="font-size:0.8rem;padding:0.25rem 0;">' +
                    '<span style="color:var(--cc-text-dim);">Charges:</span> ' +
                    '<span style="color:var(--cc-text);">' + esc(report.charges) + '</span></div>';
                }
                if (report.arrestLocation) {
                  detailHtml += '<div style="font-size:0.8rem;padding:0.25rem 0;">' +
                    '<span style="color:var(--cc-text-dim);">Location:</span> ' +
                    '<span style="color:var(--cc-text);">' + esc(report.arrestLocation) + '</span></div>';
                }
                if (report.narrative) {
                  detailHtml += '<div style="font-size:0.78rem;color:var(--cc-text-muted);margin-top:0.3rem;font-style:italic;">' +
                    '<i class="fa fa-quote-left" style="font-size:0.6rem;margin-right:0.25rem;color:var(--cc-text-dim);"></i>' +
                    esc(report.narrative) + '</div>';
                }
                if (detailHtml) {
                  $details.html(detailHtml).show();
                }
              }
            });
          }
        });
      }
    });
  }

})();
</script>
<%- include('partials/pending-deletion-gate') %>

</body>
</html>
