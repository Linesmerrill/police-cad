<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Court Cases - Lines Police CAD</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="shortcut icon" type="image/ico" href="static/images/favicon.ico">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cc-bg: #08090c;
      --cc-surface: rgba(255,255,255,0.03);
      --cc-glass: rgba(255,255,255,0.04);
      --cc-glass-border: rgba(255,255,255,0.06);
      --cc-glass-hover: rgba(255,255,255,0.07);
      --cc-text: #e2e8f0;
      --cc-text-muted: #64748b;
      --cc-text-dim: #475569;
      --cc-accent: #8b5cf6;
      --cc-accent-glow: rgba(139,92,246,0.15);
      --cc-green: #22c55e;
      --cc-red: #ef4444;
      --cc-amber: #f59e0b;
      --cc-blue: #3b82f6;
      --cc-radius: 12px;
      --cc-radius-sm: 8px;
    }

    html { font-size: 16px; }
    body {
      background: var(--cc-bg);
      color: var(--cc-text);
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding-top: 36px; /* clears the fixed standalone-utility strip */
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 700px 500px at 10% 15%, rgba(139,92,246,0.07) 0%, transparent 70%),
        radial-gradient(ellipse 500px 400px at 90% 85%, rgba(245,158,11,0.04) 0%, transparent 70%);
    }

    .cc-shell {
      position: relative;
      z-index: 1;
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }

    /* Header */
    .cc-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--cc-glass-border);
    }
    .cc-header-left { display: flex; align-items: center; gap: 1rem; }
    .cc-header-icon {
      width: 44px; height: 44px;
      background: var(--cc-accent-glow);
      border: 1px solid rgba(139,92,246,0.2);
      border-radius: var(--cc-radius-sm);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem; color: var(--cc-accent);
    }
    .cc-title { font-weight: 700; font-size: 1.5rem; color: #fff; }
    .cc-subtitle { font-size: 0.85rem; color: var(--cc-text-muted); margin-top: 0.1rem; }
    .cc-back-btn {
      display: inline-flex; align-items: center; gap: 0.35rem;
      color: var(--cc-text-muted); font-size: 0.85rem; text-decoration: none;
      padding: 0.4rem 0.75rem; border-radius: var(--cc-radius-sm);
      transition: all 0.2s ease;
      border: 1px solid transparent;
    }
    .cc-back-btn:hover { color: #fff; background: var(--cc-surface); border-color: var(--cc-glass-border); }
    .cc-refresh-btn {
      display: inline-flex; align-items: center; justify-content: center;
      width: 34px; height: 34px; border-radius: var(--cc-radius-sm);
      background: transparent; border: 1px solid var(--cc-glass-border);
      color: var(--cc-text-muted); font-size: 0.85rem; cursor: pointer;
      transition: all 0.2s ease;
    }
    .cc-refresh-btn:hover { color: #fff; background: var(--cc-surface); border-color: var(--cc-accent); }
    .cc-refresh-btn.spinning i { animation: cc-spin 0.8s linear infinite; }
    @keyframes cc-spin { to { transform: rotate(360deg); } }

    /* Buttons */
    .cc-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.4rem 0.75rem; border-radius: var(--cc-radius-sm);
      font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 0.8rem;
      border: none; cursor: pointer; transition: all 0.2s ease;
      text-decoration: none; white-space: nowrap;
    }
    .cc-btn-primary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; }
    .cc-btn-primary:hover { box-shadow: 0 4px 12px rgba(102,126,234,0.3); transform: translateY(-1px); }
    .cc-btn-outline { background: transparent; color: var(--cc-text-muted); border: 1px solid var(--cc-glass-border); }
    .cc-btn-outline:hover { background: var(--cc-surface); color: #fff; }

    /* Metrics */
    .cc-metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .cc-metric {
      background: var(--cc-surface);
      border: 1px solid var(--cc-glass-border);
      border-radius: var(--cc-radius-sm);
      padding: 1rem 0.75rem;
      text-align: center;
      transition: all 0.2s ease;
    }
    .cc-metric:hover { border-color: rgba(255,255,255,0.1); }
    .cc-metric-value {
      font-weight: 700;
      font-size: 1.8rem;
      line-height: 1;
      margin-bottom: 0.25rem;
    }
    .cc-metric-value.gold { color: #d4af37; }
    .cc-metric-value.blue { color: var(--cc-blue); }
    .cc-metric-value.red { color: var(--cc-red); }
    .cc-metric-value.green { color: var(--cc-green); }
    .cc-metric-label { font-size: 0.78rem; color: var(--cc-text-muted); font-weight: 500; }

    /* Tabs */
    .cc-tabs {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--cc-glass-border);
      margin-bottom: 1.5rem;
      overflow-x: auto;
    }
    .cc-tab {
      padding: 0.65rem 1.1rem;
      font-weight: 600; font-size: 0.85rem;
      color: var(--cc-text-dim);
      cursor: pointer; border: none; background: none;
      border-bottom: 2px solid transparent;
      transition: all 0.2s ease;
      white-space: nowrap;
      font-family: 'Outfit', sans-serif;
      display: flex; align-items: center; gap: 0.4rem;
    }
    .cc-tab:hover { color: var(--cc-text-muted); }
    .cc-tab.active { color: var(--cc-accent); border-bottom-color: var(--cc-accent); }
    .cc-tab-count {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 18px; height: 18px; padding: 0 5px;
      border-radius: 9px; font-size: 0.68rem; font-weight: 700;
      background: var(--cc-glass); color: var(--cc-text-muted);
    }
    .cc-tab.active .cc-tab-count { background: var(--cc-accent-glow); color: var(--cc-accent); }

    .cc-tab-content { display: none; }
    .cc-tab-content.active { display: block; }

    /* Search bar (Case Search tab) */
    .cc-search-bar {
      position: relative;
      margin-bottom: 0.875rem;
    }
    .cc-search-icon {
      position: absolute;
      left: 0.85rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--cc-text-dim);
      font-size: 0.85rem;
      pointer-events: none;
    }
    .cc-search-input {
      width: 100%;
      background: var(--cc-glass);
      border: 1px solid var(--cc-glass-border);
      border-radius: var(--cc-radius-sm);
      color: #fff;
      font-family: 'Outfit', sans-serif;
      font-size: 0.9rem;
      padding: 0.7rem 0.9rem 0.7rem 2.4rem;
      outline: none;
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    .cc-search-input::placeholder { color: var(--cc-text-dim); }
    .cc-search-input:focus {
      border-color: var(--cc-accent);
      background: var(--cc-glass-hover, var(--cc-glass));
    }
    .cc-case-number-pill {
      display: inline-flex; align-items: center;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.72rem; font-weight: 600;
      color: var(--cc-accent);
      background: var(--cc-accent-glow);
      border: 1px solid rgba(56,189,248,0.18);
      padding: 0.1rem 0.4rem; border-radius: 4px;
    }

    /* Case cards */
    .cc-case-list { display: flex; flex-direction: column; gap: 0.6rem; }
    .cc-case-card {
      background: var(--cc-surface);
      border: 1px solid var(--cc-glass-border);
      border-radius: var(--cc-radius-sm);
      padding: 0.875rem 1rem;
      display: flex; align-items: center; gap: 0.875rem;
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .cc-case-card:hover { border-color: rgba(255,255,255,0.12); background: var(--cc-glass-hover); }
    .cc-avatar {
      width: 38px; height: 38px;
      border-radius: var(--cc-radius-sm);
      background: var(--cc-accent-glow);
      display: flex; align-items: center; justify-content: center;
      color: var(--cc-accent); font-weight: 700; font-size: 0.85rem;
      flex-shrink: 0;
      border: 1px solid rgba(139,92,246,0.15);
    }
    .cc-case-info { flex: 1; min-width: 0; }
    .cc-case-name { font-weight: 600; font-size: 0.875rem; color: #fff; }
    .cc-case-meta {
      font-size: 0.78rem; color: var(--cc-text-muted); margin-top: 0.15rem;
      display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
    }
    .cc-case-meta-item { display: flex; align-items: center; gap: 0.25rem; }
    .cc-case-actions { display: flex; gap: 0.4rem; flex-shrink: 0; }

    /* Badges */
    .cc-badge {
      display: inline-flex; align-items: center; gap: 0.25rem;
      font-size: 0.68rem; font-weight: 600; text-transform: uppercase;
      letter-spacing: 0.03em; padding: 0.15rem 0.45rem; border-radius: 5px;
    }
    .cc-badge-submitted { background: rgba(234,179,8,0.15); color: #eab308; border: 1px solid rgba(234,179,8,0.25); }
    .cc-badge-in_review { background: rgba(96,165,250,0.15); color: #60a5fa; border: 1px solid rgba(96,165,250,0.25); }
    .cc-badge-scheduled { background: rgba(34,197,94,0.15); color: #4ade80; border: 1px solid rgba(34,197,94,0.25); }
    .cc-badge-in_progress { background: rgba(248,113,113,0.15); color: #f87171; border: 1px solid rgba(248,113,113,0.25); }
    .cc-badge-completed { background: rgba(148,163,184,0.15); color: #94a3b8; border: 1px solid rgba(148,163,184,0.25); }
    .cc-badge-unresolved { background: rgba(245,158,158,0.15); color: #f59e9e; border: 1px solid rgba(245,158,158,0.25); }
    .cc-badge-cancelled { background: rgba(251,191,36,0.15); color: #fbbf24; border: 1px solid rgba(251,191,36,0.25); }

    /* Session cards */
    .cc-session-card {
      background: var(--cc-surface);
      border: 1px solid var(--cc-glass-border);
      border-radius: var(--cc-radius-sm);
      padding: 1rem;
      transition: all 0.2s ease;
      margin-bottom: 0.6rem;
    }
    .cc-session-card:hover { border-color: rgba(255,255,255,0.1); }
    .cc-session-card.live {
      border-color: rgba(239,68,68,0.3);
      box-shadow: 0 0 16px rgba(239,68,68,0.06);
    }
    .cc-session-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem; }
    .cc-session-title { font-weight: 600; font-size: 0.9rem; color: #fff; }
    .cc-session-subtitle { font-size: 0.78rem; color: var(--cc-text-muted); margin-top: 0.2rem; }
    .cc-live-dot {
      display: inline-block; width: 7px; height: 7px;
      border-radius: 50%; background: #ef4444; margin-right: 0.35rem;
      animation: cc-pulse 1.5s ease-in-out infinite;
    }
    @keyframes cc-pulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(239,68,68,0.4); }
      50% { opacity: 0.7; box-shadow: 0 0 0 5px rgba(239,68,68,0); }
    }
    .cc-session-meta {
      display: flex; gap: 1.25rem; margin-top: 0.5rem;
      font-size: 0.78rem; color: var(--cc-text-muted);
    }
    .cc-session-meta i { color: var(--cc-text-dim); margin-right: 0.25rem; }

    /* History session expand/collapse */
    .cc-session-card.expandable { cursor: pointer; }
    .cc-session-card.expandable:hover { border-color: rgba(139,92,246,0.25); }
    .cc-session-card.expanded {
      border-color: rgba(139,92,246,0.3);
      box-shadow: 0 4px 24px rgba(139,92,246,0.08);
    }
    .cc-session-expand-icon {
      color: var(--cc-text-dim);
      font-size: 0.75rem;
      transition: transform 0.25s ease;
      flex-shrink: 0;
      margin-left: 0.5rem;
    }
    .cc-session-card.expanded .cc-session-expand-icon { transform: rotate(180deg); }
    .cc-session-detail {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .cc-session-card.expanded .cc-session-detail { max-height: 1200px; }
    .cc-session-detail-inner {
      padding-top: 0.875rem;
      margin-top: 0.75rem;
      border-top: 1px solid var(--cc-glass-border);
    }
    .cc-detail-label {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--cc-text-dim);
      margin-bottom: 0.5rem;
    }
    .cc-docket-entry {
      background: rgba(255,255,255,0.02);
      border: 1px solid var(--cc-glass-border);
      border-radius: var(--cc-radius-sm);
      padding: 0.65rem 0.75rem;
      margin-bottom: 0.4rem;
    }
    .cc-docket-civ-name {
      font-weight: 600;
      font-size: 0.85rem;
      color: #fff;
      margin-bottom: 0.35rem;
    }
    .cc-docket-civ-name i { color: var(--cc-accent); margin-right: 0.35rem; font-size: 0.75rem; }
    .cc-resolution-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.3rem 0;
      font-size: 0.8rem;
    }
    .cc-resolution-row + .cc-resolution-row { border-top: 1px solid rgba(255,255,255,0.04); }
    .cc-resolution-summary { color: var(--cc-text-muted); flex: 1; }
    .cc-resolution-type {
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      padding: 0.15rem 0.4rem;
      border-radius: 3px;
      margin-right: 0.6rem;
      flex-shrink: 0;
    }
    .cc-resolution-type.citation { background: rgba(59,130,246,0.15); color: #93c5fd; }
    .cc-resolution-type.warning { background: rgba(234,179,8,0.15); color: #fde047; }
    .cc-resolution-type.arrest { background: rgba(239,68,68,0.15); color: #fca5a5; }
    .cc-verdict {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      flex-shrink: 0;
    }
    .cc-verdict.dismissed { color: #6ee7b7; }
    .cc-verdict.upheld { color: #fca5a5; }
    .cc-verdict.partial { color: #c4b5fd; }
    .cc-verdict.adjusted { color: #fbbf24; }
    .cc-charge-final { color: var(--cc-text-muted); font-weight: 500; }
    .cc-final-judgment {
      display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
      margin-bottom: 0.6rem; padding: 0.5rem 0.7rem;
      background: rgba(251,191,36,0.08); border: 1px solid rgba(251,191,36,0.22); border-radius: 7px;
    }
    .cc-fj-title { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #fbbf24; }
    .cc-fj-vals { font-size: 0.9rem; font-weight: 700; color: #fbbf24; }

    /* Per-charge breakdown — indented list under a docket / resolution row */
    .cc-charges {
      display: flex; flex-direction: column; gap: 0.18rem;
      margin: 0.35rem 0 0.1rem 1.5rem;
      padding-left: 0.6rem;
      border-left: 2px solid var(--cc-glass-border);
    }
    .cc-charge-row {
      display: flex; align-items: center; gap: 0.45rem;
      font-size: 0.74rem;
    }
    .cc-charge-row i { font-size: 0.6rem; flex-shrink: 0; }
    .cc-charge-label { flex: 1; }
    .cc-charge-verdict {
      font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.05em;
      font-weight: 700;
      padding: 0.08rem 0.4rem; border-radius: 3px;
    }
    .cc-charge-row.dismissed { color: #6ee7b7; }
    .cc-charge-row.dismissed .cc-charge-label { text-decoration: line-through; color: var(--cc-text-dim); }
    .cc-charge-row.dismissed .cc-charge-verdict { background: rgba(110,231,183,0.15); color: #6ee7b7; }
    .cc-charge-row.upheld { color: #fca5a5; }
    .cc-charge-row.upheld .cc-charge-verdict { background: rgba(252,165,165,0.14); color: #fca5a5; }
    .cc-participant-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.3rem;
    }
    .cc-participant-chip {
      font-size: 0.72rem;
      padding: 0.25rem 0.55rem;
      border-radius: 999px;
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--cc-glass-border);
      color: var(--cc-text-muted);
    }
    .cc-participant-chip .chip-role {
      color: var(--cc-text-dim);
      font-size: 0.65rem;
      margin-left: 0.25rem;
    }
    .cc-participant-chip.role-judge { border-color: rgba(139,92,246,0.3); color: #c4b5fd; }
    .cc-participant-chip.role-defendant { border-color: rgba(234,179,8,0.3); color: #fde68a; }

    /* Empty & loading */
    .cc-empty {
      text-align: center; padding: 2.5rem 1rem;
      color: var(--cc-text-dim); font-size: 0.88rem;
    }
    .cc-empty i { font-size: 1.75rem; margin-bottom: 0.5rem; display: block; opacity: 0.4; }
    .cc-spinner {
      display: block; width: 24px; height: 24px;
      border: 2px solid var(--cc-glass-border);
      border-top-color: var(--cc-accent);
      border-radius: 50%;
      animation: cc-spin 0.7s linear infinite;
      margin: 2rem auto;
    }
    @keyframes cc-spin { to { transform: rotate(360deg); } }

    /* Modal */
    .cc-modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);
      z-index: 10000;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden;
      /* visibility flips after the opacity fade-out finishes (closing);
         see .open below for the open-state override that flips it instantly */
      transition: opacity 0.25s, visibility 0s 0.25s;
    }
    .cc-modal-overlay.open {
      opacity: 1; visibility: visible;
      /* When opening, drop the visibility delay so the input inside the
         modal is focusable immediately — otherwise a programmatic focus
         call during the 250ms fade is silently ignored. */
      transition: opacity 0.25s, visibility 0s 0s;
    }
    .cc-modal {
      background: #0f1019;
      border: 1px solid var(--cc-glass-border);
      border-radius: var(--cc-radius);
      width: 92%; max-width: 620px;
      max-height: 85vh; overflow-y: auto;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
      transform: translateY(12px) scale(0.97);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .cc-modal-overlay.open .cc-modal { transform: translateY(0) scale(1); }
    .cc-modal-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.1rem 1.25rem;
      border-bottom: 1px solid var(--cc-glass-border);
    }
    .cc-modal-title { font-weight: 700; font-size: 1rem; color: #fff; }
    .cc-modal-close {
      background: none; border: none; color: var(--cc-text-dim);
      font-size: 1.3rem; cursor: pointer; padding: 0.25rem;
      transition: all 0.2s ease;
    }
    .cc-modal-close:hover { color: #fff; }
    .cc-modal-body { padding: 1.25rem; }
    .cc-form-label {
      display: block; font-size: 0.75rem; font-weight: 600;
      color: var(--cc-text-muted); margin-bottom: 0.35rem;
      text-transform: uppercase; letter-spacing: 0.04em;
    }

    /* === LIVE SESSION BANNER === */
    .cc-live-banner {
      display: none;
      margin-bottom: 1rem;
      border: 1px solid rgba(239,68,68,0.25);
      border-radius: var(--cc-radius);
      background: linear-gradient(135deg, rgba(239,68,68,0.06) 0%, rgba(239,68,68,0.02) 100%);
      overflow: hidden;
      position: relative;
    }
    .cc-live-banner.visible { display: block; }

    .cc-live-banner::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--cc-red), transparent);
      animation: cc-banner-sweep 3s ease-in-out infinite;
    }
    @keyframes cc-banner-sweep {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 1; }
    }

    .cc-live-banner-header {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.65rem 1rem 0.35rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--cc-red);
    }
    .cc-live-banner-header .cc-live-dot {
      width: 7px; height: 7px;
      background: var(--cc-red);
      border-radius: 50%;
      box-shadow: 0 0 6px var(--cc-red);
      animation: cc-pulse-dot 1.5s ease-in-out infinite;
    }
    @keyframes cc-pulse-dot {
      0%, 100% { opacity: 1; box-shadow: 0 0 4px var(--cc-red); }
      50% { opacity: 0.5; box-shadow: 0 0 10px var(--cc-red), 0 0 20px rgba(239,68,68,0.3); }
    }

    .cc-live-session-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.55rem 1rem;
      transition: background 0.15s ease;
    }
    .cc-live-session-row:hover {
      background: rgba(239,68,68,0.04);
    }
    .cc-live-session-row + .cc-live-session-row {
      border-top: 1px solid rgba(255,255,255,0.04);
    }

    .cc-live-session-info { flex: 1; min-width: 0; }
    .cc-live-session-title {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--cc-text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .cc-live-session-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.75rem;
      color: var(--cc-text-muted);
      margin-top: 0.1rem;
    }
    .cc-live-session-meta i { margin-right: 0.25rem; font-size: 0.65rem; }

    .cc-live-join-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.9rem;
      font-size: 0.78rem;
      font-weight: 600;
      font-family: inherit;
      color: #fff;
      background: var(--cc-red);
      border: none;
      border-radius: 6px;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.15s ease;
      box-shadow: 0 0 12px rgba(239,68,68,0.2);
    }
    .cc-live-join-btn:hover {
      background: #dc2626;
      box-shadow: 0 0 20px rgba(239,68,68,0.35);
      transform: translateY(-1px);
    }

    @media (max-width: 768px) {
      .cc-metrics { grid-template-columns: repeat(2, 1fr); }
      .cc-header { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
      .cc-case-card { flex-wrap: wrap; }
      .cc-case-actions { width: 100%; justify-content: flex-end; }
      .cc-live-session-row { flex-wrap: wrap; gap: 0.5rem; }
      .cc-live-join-btn { width: 100%; justify-content: center; }
    }
    /* Case filter pills */
    .cc-case-filter {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
    }
    .cc-filter-pill {
      padding: 0.35rem 0.85rem;
      border-radius: var(--cc-radius-sm);
      font-family: 'Outfit', sans-serif;
      font-weight: 600;
      font-size: 0.8rem;
      border: 1px solid var(--cc-glass-border);
      background: var(--cc-glass);
      color: var(--cc-text-dim);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .cc-filter-pill:hover { color: var(--cc-text-muted); border-color: rgba(255,255,255,0.1); }
    .cc-filter-pill.active {
      background: var(--cc-accent-glow);
      border-color: rgba(139,92,246,0.4);
      color: var(--cc-accent);
    }

    @media (max-width: 480px) {
      .cc-shell { padding: 1rem; }
      .cc-metrics { grid-template-columns: 1fr 1fr; gap: 0.4rem; }
      .cc-tab { padding: 0.5rem 0.65rem; font-size: 0.78rem; }
    }
  </style>
</head>
<body>

<%- include('partials/standalone-utility', {
  user: user,
  communityName: communityName,
  pageLabel: 'Court Cases',
  backHref: '/communities',
  backLabel: 'Back to dashboard'
}) %>

<div class="cc-shell">
  <!-- Header -->
  <div class="cc-header">
    <div class="cc-header-left">
      <div class="cc-header-icon"><i class="fa fa-gavel"></i></div>
      <div>
        <div class="cc-title">Court Cases</div>
        <div class="cc-subtitle"><%= communityName || 'Community' %> court case queue & sessions</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <button class="cc-refresh-btn" id="ccCaseSearchBtn" onclick="ccOpenCaseSearch()" title="Case Search"><i class="fa fa-magnifying-glass"></i></button>
      <a href="/help#court-cases" class="cc-refresh-btn" title="Help & Tutorials"><i class="fa fa-circle-question"></i></a>
      <button class="cc-refresh-btn" id="ccRefreshBtn" onclick="ccRefreshAll()" title="Refresh"><i class="fa fa-arrows-rotate"></i></button>
    </div>
  </div>

  <!-- Live Session Banner -->
  <div class="cc-live-banner" id="liveSessionsBanner"></div>

  <!-- Metrics -->
  <div class="cc-metrics">
    <div class="cc-metric">
      <div class="cc-metric-value gold" id="metricPending">-</div>
      <div class="cc-metric-label">Pending Cases</div>
    </div>
    <div class="cc-metric">
      <div class="cc-metric-value blue" id="metricScheduled">-</div>
      <div class="cc-metric-label">Scheduled</div>
    </div>
    <div class="cc-metric">
      <div class="cc-metric-value red" id="metricActive">-</div>
      <div class="cc-metric-label">Active Sessions</div>
    </div>
    <div class="cc-metric">
      <div class="cc-metric-value green" id="metricCompleted">-</div>
      <div class="cc-metric-label">Completed</div>
    </div>
  </div>

  <!-- Case Filter -->
  <div class="cc-case-filter">
    <button class="cc-filter-pill active" data-filter="yours">Your Cases</button>
    <button class="cc-filter-pill" data-filter="all">All Cases</button>
  </div>

  <!-- Tabs -->
  <div class="cc-tabs">
    <button class="cc-tab active" data-tab="queue">
      <i class="fa fa-inbox"></i> Case Queue <span class="cc-tab-count" id="countQueue">0</span>
    </button>
    <button class="cc-tab" data-tab="scheduled">
      <i class="fa fa-calendar-check"></i> Scheduled <span class="cc-tab-count" id="countScheduled">0</span>
    </button>
    <button class="cc-tab" data-tab="active">
      <i class="fa fa-circle-play"></i> Sessions <span class="cc-tab-count" id="countActive">0</span>
    </button>
    <button class="cc-tab" data-tab="history">
      <i class="fa fa-clock-rotate-left"></i> History
    </button>
  </div>

  <!-- Tab Content -->
  <div class="cc-tab-content active" id="tab-queue">
    <div class="cc-spinner"></div>
    <div class="cc-case-list" id="queueList" style="display:none;"></div>
  </div>
  <div class="cc-tab-content" id="tab-scheduled">
    <div class="cc-spinner"></div>
    <div class="cc-case-list" id="scheduledList" style="display:none;"></div>
  </div>
  <div class="cc-tab-content" id="tab-active">
    <div class="cc-spinner"></div>
    <div class="cc-case-list" id="activeList" style="display:none;"></div>
  </div>
  <div class="cc-tab-content" id="tab-history">
    <div class="cc-spinner"></div>
    <div class="cc-case-list" id="historyList" style="display:none;"></div>
  </div>
</div>

<!-- Case Search Modal -->
<div class="cc-modal-overlay" id="caseSearchModal">
  <div class="cc-modal" style="max-width:640px;width:100%;">
    <div class="cc-modal-head">
      <div class="cc-modal-title"><i class="fa fa-magnifying-glass" style="color:var(--cc-accent);margin-right:0.4rem;"></i> Case Search</div>
      <button class="cc-modal-close" onclick="$('#caseSearchModal').removeClass('open')">&times;</button>
    </div>
    <div class="cc-modal-body" style="padding:1rem 1.25rem;">
      <div class="cc-search-bar">
        <i class="fa fa-magnifying-glass cc-search-icon"></i>
        <input type="text" id="caseSearchInput" class="cc-search-input"
               placeholder="Search by case number (CC-YYYY-NNNNNN) or civilian name…" autocomplete="off">
      </div>
      <div class="cc-case-list" id="searchList" style="max-height:55vh;overflow-y:auto;"></div>
    </div>
  </div>
</div>

<!-- Case Detail Modal -->
<div class="cc-modal-overlay" id="caseDetailModal">
  <div class="cc-modal">
    <div class="cc-modal-head">
      <div class="cc-modal-title"><i class="fa fa-file-lines" style="color:var(--cc-accent);margin-right:0.4rem;"></i> Case Details</div>
      <button class="cc-modal-close" onclick="$('#caseDetailModal').removeClass('open')">&times;</button>
    </div>
    <div class="cc-modal-body" id="caseDetailBody">
      <div class="cc-spinner"></div>
    </div>
    <div id="caseDetailFoot" style="display:none;padding:0.75rem 1.25rem;border-top:1px solid var(--cc-glass-border);justify-content:flex-end;"></div>
  </div>
</div>

<script type="text/javascript">
  var API_URL = '<%= apiUrl || "https://police-cad-app-api-bc6d659b60b3.herokuapp.com" %>';
  var communityId = '<%= communityId %>';
  var currentUserId = '<%= user && user._doc ? user._doc._id : "" %>';
</script>
<script src="/static/js/jquery.min.js"></script>
<script>
(function() {
  'use strict';

  var cachedQueue = [];
  var cachedScheduled = [];
  var cachedActive = [];
  var cachedHistory = [];
  var historyCaseCache = {}; // caseId -> fetched court case data
  var expandedHistoryId = null;
  var caseFilter = 'yours'; // 'yours' | 'all'

  function esc(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str || ''));
    return div.innerHTML;
  }

  function isValidDate(d) {
    if (!d) return false;
    var dt = new Date(d);
    return !isNaN(dt.getTime()) && dt.getFullYear() > 2000;
  }

  function getInitials(name) {
    var parts = (name || '').split(' ').filter(Boolean);
    if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    if (parts.length === 1) return parts[0][0].toUpperCase();
    return '?';
  }

  function showEmpty($list, msg) {
    $list.closest('.cc-tab-content').find('.cc-spinner').hide();
    $list.show().html('<div class="cc-empty"><i class="fa fa-inbox"></i>' + esc(msg) + '</div>');
  }

  // --- Back navigation ---
  // Smart back attached to the standalone-utility strip's back link.
  // Capture the referrer on first arrival into sessionStorage so the
  // back button returns to the page the user actually came from, even
  // after refreshes or sibling-page navigation. Same pattern as
  // /reports, /most-wanted, /community/:hash/map, /court-session.
  (function () {
    var RETURN_KEY = 'courtCases.returnUrl';
    (function captureReturnUrl() {
      var ref = document.referrer || '';
      if (!ref) return;
      if (ref.indexOf(window.location.origin) !== 0) return;
      var path = ref.slice(window.location.origin.length).split('?')[0].split('#')[0];
      // Don't overwrite when bouncing between sibling court pages or
      // arriving from /help — we want the original entry point.
      if (path.indexOf('/court-cases') === 0) return;
      if (path.indexOf('/court-session') === 0) return;
      if (path.indexOf('/help') === 0) return;
      try { sessionStorage.setItem(RETURN_KEY, ref); } catch (e) { /* private mode */ }
    })();
    Array.from(document.querySelectorAll('.lpc-utility-back')).forEach(function (a) {
      a.addEventListener('click', function (e) {
        var stored = '';
        try { stored = sessionStorage.getItem(RETURN_KEY) || ''; } catch (e2) {}
        if (stored) { e.preventDefault(); window.location.href = stored; }
      });
    });
  })();

  // --- Init ---
  $(document).ready(function() {
    bindTabs();
    window.ccRefreshAll = function() {
      var $btn = $('#ccRefreshBtn');
      $btn.addClass('spinning');
      loadQueue();
      loadScheduled();
      loadActiveSessions();
      loadHistory();
      setTimeout(function() { $btn.removeClass('spinning'); }, 800);
    };

    loadQueue();
    loadScheduled();
    loadActiveSessions();
    loadHistory();

    // Deep-link: ?caseId=<id> opens that case's detail modal on load.
    var deepCaseId = (function() {
      var m = window.location.search.match(/[?&]caseId=([^&]+)/);
      return m ? decodeURIComponent(m[1]) : null;
    })();
    if (deepCaseId && typeof viewCase === 'function') {
      setTimeout(function() { viewCase(deepCaseId); }, 200);
    }

    function ccRefreshIfIdle() {
      if (!communityId) return;
      var hasExpanded = $('.cc-session-card.expanded').length > 0;
      loadQueue();
      loadScheduled();
      loadActiveSessions();
      if (!hasExpanded) loadHistory();
    }

    // Refresh data when user returns to this tab/page
    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) ccRefreshIfIdle();
    });

    // Refresh when navigating back (bfcache restore)
    window.addEventListener('pageshow', function(e) {
      if (e.persisted) ccRefreshIfIdle();
    });

    // Catch returns that bypass bfcache (e.g. active timers prevent caching)
    var lastFocusRefresh = 0;
    window.addEventListener('focus', function() {
      // Debounce: skip if refreshed within last 3 seconds
      var now = Date.now();
      if (now - lastFocusRefresh < 3000) return;
      lastFocusRefresh = now;
      ccRefreshIfIdle();
    });
  });

  function bindTabs() {
    $(document).on('click', '.cc-tab', function() {
      var tab = $(this).data('tab');
      $('.cc-tab').removeClass('active');
      $(this).addClass('active');
      $('.cc-tab-content').removeClass('active');
      $('#tab-' + tab).addClass('active');
    });

    var searchTimer = null;
    $(document).on('input', '#caseSearchInput', function() {
      var q = $(this).val();
      clearTimeout(searchTimer);
      searchTimer = setTimeout(function() { runCaseSearch(q); }, 250);
    });

    // Case Search modal: backdrop + ESC close
    $('#caseSearchModal').on('click', function(e) {
      if (e.target === this) $(this).removeClass('open');
    });
    $(document).on('keydown', function(e) {
      if (e.key === 'Escape' && $('#caseSearchModal').hasClass('open')) {
        $('#caseSearchModal').removeClass('open');
      }
    });

    // Case filter pills
    $(document).on('click', '.cc-filter-pill', function() {
      $('.cc-filter-pill').removeClass('active');
      $(this).addClass('active');
      caseFilter = $(this).data('filter');
      reRenderAll();
    });

    // Close case-detail modal on backdrop
    $('#caseDetailModal').on('click', function(e) {
      if (e.target === this) $(this).removeClass('open');
    });
  }

  window.ccOpenCaseSearch = function() {
    $('#caseSearchModal').addClass('open');
    // Use native .focus() — jQuery's .trigger('focus') only fires the event
    // and doesn't reliably move the actual focus across browsers, which made
    // the case-search e2e test flake on a freshly-opened modal.
    requestAnimationFrame(function() {
      var input = document.getElementById('caseSearchInput');
      if (input) {
        input.focus();
        input.select();
      }
      if (!$('#caseSearchInput').val()) runCaseSearch('');
    });
  };

  function isMyCase(c) {
    var d = c.courtCase || c.details || c;
    return d.userID === currentUserId;
  }

  function isMySession(s) {
    var d = s.courtSession || s.details || s;
    var parts = d.participants || [];
    for (var i = 0; i < parts.length; i++) {
      if (parts[i].userID === currentUserId) return true;
    }
    var docket = d.docket || [];
    for (var j = 0; j < docket.length; j++) {
      if (docket[j].userID === currentUserId) return true;
    }
    return false;
  }

  function getFilteredQueue() {
    return caseFilter === 'all' ? cachedQueue : cachedQueue.filter(isMyCase);
  }
  function getFilteredScheduled() {
    return caseFilter === 'all' ? cachedScheduled : cachedScheduled.filter(isMyCase);
  }
  function getFilteredActive() {
    return caseFilter === 'all' ? cachedActive : cachedActive.filter(isMySession);
  }
  function getFilteredHistory() {
    return caseFilter === 'all' ? cachedHistory : cachedHistory.filter(isMySession);
  }

  function reRenderAll() {
    renderQueue();
    renderScheduled();
    renderActive();
    renderHistory();
    updateMetrics();
  }

  function updateMetrics() {
    var fq = getFilteredQueue();
    var fs = getFilteredScheduled();
    var fa = getFilteredActive();
    var fh = getFilteredHistory();
    $('#metricPending').text(fq.length);
    $('#countQueue').text(fq.length);
    $('#metricScheduled').text(fs.length);
    $('#countScheduled').text(fs.length);
    var activeCount = fa.filter(function(s) { return (s.courtSession || s.details || s).status === 'in_progress'; }).length;
    $('#metricActive').text(activeCount);
    $('#countActive').text(fa.length);
    $('#metricCompleted').text(fh.length);
  }

  // --- Case Search ---

  function runCaseSearch(rawQuery) {
    var query = (rawQuery || '').trim();
    var $list = $('#searchList');
    if (!query) {
      $list.html('<div class="cc-empty"><i class="fa fa-magnifying-glass"></i>Enter a case number or civilian name to search.</div>');
      return;
    }
    if (!communityId) {
      $list.html('<div class="cc-empty"><i class="fa fa-triangle-exclamation"></i>No community selected.</div>');
      return;
    }
    if (!currentUserId) {
      $list.html('<div class="cc-empty"><i class="fa fa-triangle-exclamation"></i>Sign in required.</div>');
      return;
    }

    $list.html('<div class="cc-spinner"></div>');
    $.ajax({
      url: API_URL + '/api/v2/court-cases/search',
      method: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({
        query: query,
        communityId: communityId,
        userId: currentUserId,
        page: 0,
        limit: 25
      }),
      success: function(resp) { renderSearchResults(resp.data || []); },
      error: function(xhr) {
        if (xhr.status === 403) {
          $list.html('<div class="cc-empty"><i class="fa fa-ban"></i>You don\'t have access to search cases in this community.</div>');
        } else {
          $list.html('<div class="cc-empty"><i class="fa fa-triangle-exclamation"></i>Search failed.</div>');
        }
      }
    });
  }

  function renderSearchResults(results) {
    var $list = $('#searchList');
    if (!results.length) {
      $list.html('<div class="cc-empty"><i class="fa fa-magnifying-glass"></i>No cases match.</div>');
      return;
    }
    var html = results.map(function(c) {
      var d = c.courtCase || c.details || c;
      var initials = getInitials(d.civilianName || 'Unknown');
      var itemCount = (d.contestedItems || []).length;
      var dateStr = d.createdAt ? new Date(d.createdAt).toLocaleDateString() : '';
      var statusClass = 'cc-badge-' + (d.status || 'submitted');
      var statusLabel = (d.status || 'submitted').replace('_', ' ');
      var caseId = c._id || '';
      var caseNumber = d.caseNumber || '';

      return '<div class="cc-case-card" onclick="viewCase(\'' + caseId + '\')">' +
        '<div class="cc-avatar">' + initials + '</div>' +
        '<div class="cc-case-info">' +
          '<div class="cc-case-name">' +
            (caseNumber ? '<span class="cc-case-number-pill">' + esc(caseNumber) + '</span> ' : '') +
            esc(d.civilianName || 'Unknown Civilian') +
          '</div>' +
          '<div class="cc-case-meta">' +
            '<span class="cc-badge ' + statusClass + '">' + statusLabel + '</span>' +
            '<span class="cc-case-meta-item"><i class="fa fa-file-lines"></i> ' + itemCount + ' item' + (itemCount !== 1 ? 's' : '') + '</span>' +
            '<span class="cc-case-meta-item"><i class="fa fa-clock"></i> ' + dateStr + '</span>' +
          '</div>' +
        '</div>' +
        '<div class="cc-case-actions">' +
          '<button class="cc-btn cc-btn-outline" onclick="event.stopPropagation();viewCase(\'' + caseId + '\')"><i class="fa fa-eye"></i> View</button>' +
        '</div>' +
      '</div>';
    }).join('');
    $list.html(html);
  }

  // --- Data Loading ---

  function loadQueue() {
    if (!communityId) return showEmpty($('#queueList'), 'No community selected.');
    $.ajax({
      url: API_URL + '/api/v2/court-cases/community/' + communityId + '?status=submitted&limit=50',
      method: 'GET',
      success: function(resp) {
        var submitted = resp.data || [];
        $.ajax({
          url: API_URL + '/api/v2/court-cases/community/' + communityId + '?status=in_review&limit=50',
          method: 'GET',
          success: function(resp2) {
            cachedQueue = submitted.concat(resp2.data || []);
            renderQueue();
            updateMetrics();
          },
          error: function() {
            cachedQueue = submitted;
            renderQueue();
            updateMetrics();
          }
        });
      },
      error: function() { showEmpty($('#queueList'), 'Failed to load cases.'); }
    });
  }

  function loadScheduled() {
    if (!communityId) return;
    $.ajax({
      url: API_URL + '/api/v2/court-cases/community/' + communityId + '?status=scheduled&limit=50',
      method: 'GET',
      success: function(resp) {
        cachedScheduled = resp.data || [];
        renderScheduled();
        updateMetrics();
      },
      error: function() { showEmpty($('#scheduledList'), 'Failed to load scheduled cases.'); }
    });
  }

  function loadActiveSessions() {
    if (!communityId) return;
    // Fetch both in_progress and scheduled sessions
    $.ajax({
      url: API_URL + '/api/v2/court-sessions/community/' + communityId + '?status=in_progress&limit=50',
      method: 'GET',
      success: function(respActive) {
        var activeSessions = respActive.data || [];
        renderLiveBanner(activeSessions);
        $.ajax({
          url: API_URL + '/api/v2/court-sessions/community/' + communityId + '?status=scheduled&limit=50',
          method: 'GET',
          success: function(respSched) {
            var scheduledSessions = respSched.data || [];
            cachedActive = activeSessions.concat(scheduledSessions);
            renderActive();
            updateMetrics();
          },
          error: function() {
            cachedActive = activeSessions;
            renderActive();
            updateMetrics();
          }
        });
      },
      error: function() { showEmpty($('#activeList'), 'Failed to load sessions.'); }
    });
  }

  function loadHistory() {
    if (!communityId) return;
    $.ajax({
      url: API_URL + '/api/v2/court-sessions/community/' + communityId + '?status=completed,cancelled&limit=50',
      method: 'GET',
      success: function(resp) {
        cachedHistory = resp.data || [];
        renderHistory();
        updateMetrics();
      },
      error: function() { showEmpty($('#historyList'), 'Failed to load history.'); }
    });
  }

  // --- Rendering ---

  function renderQueue() {
    var $list = $('#queueList');
    $list.closest('.cc-tab-content').find('.cc-spinner').hide();
    $list.show();

    var filtered = getFilteredQueue();
    if (filtered.length === 0) {
      var msg = caseFilter === 'yours' ? 'You have no pending cases.' : 'No pending cases in the queue.';
      $list.html('<div class="cc-empty"><i class="fa fa-inbox"></i>' + esc(msg) + '</div>');
      return;
    }

    var html = filtered.map(function(c) {
      var d = c.courtCase || c.details || c;
      var initials = getInitials(d.civilianName || 'Unknown');
      var itemCount = (d.contestedItems || []).length;
      var dateStr = d.createdAt ? new Date(d.createdAt).toLocaleDateString() : '';
      var statusClass = 'cc-badge-' + (d.status || 'submitted');
      var statusLabel = (d.status || 'submitted').replace('_', ' ');
      var caseId = c._id || '';
      var caseNumber = d.caseNumber || '';

      return '<div class="cc-case-card" onclick="viewCase(\'' + caseId + '\')">' +
        '<div class="cc-avatar">' + initials + '</div>' +
        '<div class="cc-case-info">' +
          '<div class="cc-case-name">' +
            (caseNumber ? '<span class="cc-case-number-pill">' + esc(caseNumber) + '</span> ' : '') +
            esc(d.civilianName || 'Unknown Civilian') +
          '</div>' +
          '<div class="cc-case-meta">' +
            '<span class="cc-badge ' + statusClass + '">' + statusLabel + '</span>' +
            '<span class="cc-case-meta-item"><i class="fa fa-file-lines"></i> ' + itemCount + ' item' + (itemCount !== 1 ? 's' : '') + '</span>' +
