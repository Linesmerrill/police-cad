      <!-- ║           RANK SYSTEM SECTION              ║ -->
      <!-- ╚═══════════════════════════════════════════╝ -->
      <section id="rank-system" class="ht-section">
        <div class="ht-section-header">
          <div class="ht-section-icon"><i class="fa fa-ranking-star"></i></div>
          <div>
            <div class="ht-section-title">Rank System</div>
            <div class="ht-section-subtitle">Create department rank hierarchies with promotions, permissions, and activity tracking</div>
          </div>
        </div>

        <!-- Overview -->
        <div class="ht-subsection" id="ranks-overview">
          <h3 class="ht-subsection-title">Overview</h3>
          <p class="ht-text">
            Every department type &mdash; Police, EMS, Fire, Dispatch, and Judicial &mdash; can have its own rank hierarchy.
            Ranks can have requirements based on member activity, and the available metrics automatically adjust based on the
            department type. When a member meets all the requirements for a rank, they can be promoted automatically or reviewed by an admin first.
          </p>
          <p class="ht-text">
            Key features of the rank system:
          </p>
          <ul class="ht-text" style="margin: 0.5rem 0 1rem 1.5rem; color: #cbd5e1; line-height: 1.8;">
            <li><strong style="color:#fff;">Works Across All Departments</strong> &mdash; Configure ranks for Police, EMS, Fire, Dispatch, and Judicial departments</li>
            <li><strong style="color:#fff;">Smart Metrics</strong> &mdash; The metric dropdown automatically shows only metrics relevant to the department type (e.g., EMS sees "Medical Reports Created" but not "Citations Issued")</li>
            <li><strong style="color:#fff;">Default Rank</strong> &mdash; Automatically assigned to new or unranked department members</li>
            <li><strong style="color:#fff;">Auto Promote</strong> &mdash; Members advance automatically when they meet all requirements</li>
            <li><strong style="color:#fff;">Pending Promotions</strong> &mdash; Review and approve promotions for ranks without auto-promote</li>
            <li><strong style="color:#fff;">Activity Stats</strong> &mdash; Members can view their stats and rank progress on their dashboard and mobile app</li>
            <li><strong style="color:#fff;">Rank Prefix</strong> &mdash; A short label (e.g., "SGT") displayed before the member's name</li>
          </ul>
          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              Ranks are department-specific &mdash; a member can have different ranks in different departments.
            </div>
          </div>
        </div>

        <!-- Setting Up Ranks -->
        <div class="ht-subsection" id="ranks-setup">
          <h3 class="ht-subsection-title">Setting Up Ranks</h3>
          <p class="ht-text">To create and organize ranks for a department:</p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Go to Community Details page</div>
                <div class="ht-step-desc">Navigate to the <strong>Community Details</strong> page from the sidebar.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Click the edit icon on a department</div>
                <div class="ht-step-desc">Find the department you want to configure and click the <strong>pencil icon</strong> to open the Edit Department modal.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Click "Manage Ranks"</div>
                <div class="ht-step-desc">At the bottom of the Edit Department modal, click the <strong>Manage Ranks</strong> button.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">4</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Click "+ Add Rank" to create a new rank</div>
                <div class="ht-step-desc">Click <strong>+ Add Rank</strong> to add a new rank to the hierarchy.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">5</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Enter rank name and optional prefix</div>
                <div class="ht-step-desc">Give the rank a name (e.g., "Sergeant") and an optional prefix (e.g., "SGT") that will appear before the member's name.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">6</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Configure rank options</div>
                <div class="ht-step-desc">
                  <strong>Default Rank</strong> &mdash; Check this to auto-assign this rank to new or unranked members in the department.<br>
                  <strong>Auto Promote</strong> &mdash; Check this to automatically promote members when they meet all requirements (see below). Leave unchecked to review and approve promotions manually.
                </div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">7</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Reorder ranks with the up/down arrows</div>
                <div class="ht-step-desc">Use the <strong>up/down arrows</strong> to reorder ranks. A lower number means a higher rank in the hierarchy.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">8</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Edit or delete ranks</div>
                <div class="ht-step-desc">Click the <strong>pencil icon</strong> to edit an existing rank or the <strong>trash icon</strong> to delete it. Deleting a rank will set its members to unranked.</div>
              </div>
            </div>
          </div>
          <div class="ht-tip">
            <i class="fa fa-lightbulb ht-tip-icon"></i>
            <div class="ht-tip-text">
              You need the <strong>"manage departments"</strong> or <strong>"administrator"</strong> permission to manage ranks.
            </div>
          </div>
        </div>

        <!-- Requirements & Auto-Promote -->
        <div class="ht-subsection" id="ranks-requirements">
          <h3 class="ht-subsection-title">Requirements &amp; Auto-Promote</h3>
          <p class="ht-text">
            Each rank can have metric requirements &mdash; thresholds that members must meet to qualify for promotion.
            The metric dropdown automatically shows only metrics relevant to the department type:
          </p>
          <div style="margin: 0.75rem 0 1.25rem 0; display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div style="background:rgba(30,32,40,0.6); border:1px solid rgba(53,56,90,0.4); border-radius:10px; padding:14px 16px;">
              <div style="color:#a78bfa; font-size:11px; text-transform:uppercase; letter-spacing:1px; font-weight:600; margin-bottom:8px;">Police</div>
              <div style="color:#cbd5e1; font-size:13px; line-height:1.7;">Citations Issued, Warnings Issued, Arrests Made, Calls Created, Calls Responded To, Calls Cleared, BOLOs Created, Warrants Requested, Warrants Executed</div>
            </div>
            <div style="background:rgba(30,32,40,0.6); border:1px solid rgba(53,56,90,0.4); border-radius:10px; padding:14px 16px;">
              <div style="color:#34d399; font-size:11px; text-transform:uppercase; letter-spacing:1px; font-weight:600; margin-bottom:8px;">EMS / Fire</div>
              <div style="color:#cbd5e1; font-size:13px; line-height:1.7;">Calls Responded To, Calls Cleared, BOLOs Created, Medical Reports Created</div>
            </div>
            <div style="background:rgba(30,32,40,0.6); border:1px solid rgba(53,56,90,0.4); border-radius:10px; padding:14px 16px;">
              <div style="color:#60a5fa; font-size:11px; text-transform:uppercase; letter-spacing:1px; font-weight:600; margin-bottom:8px;">Dispatch</div>
              <div style="color:#cbd5e1; font-size:13px; line-height:1.7;">Calls Created, BOLOs Created, Calls Dispatched</div>
            </div>
            <div style="background:rgba(30,32,40,0.6); border:1px solid rgba(53,56,90,0.4); border-radius:10px; padding:14px 16px;">
              <div style="color:#fbbf24; font-size:11px; text-transform:uppercase; letter-spacing:1px; font-weight:600; margin-bottom:8px;">Judicial</div>
              <div style="color:#cbd5e1; font-size:13px; line-height:1.7;">Warrants Reviewed, Court Cases Completed</div>
            </div>
          </div>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Edit a rank and click "+ Add"</div>
                <div class="ht-step-desc">Open a rank for editing and click <strong>+ Add</strong> in the <strong>Requirements</strong> section.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Select a metric type</div>
                <div class="ht-step-desc">Choose a metric from the dropdown. The options shown depend on the department type (e.g., Police sees "Arrests Made" while EMS sees "Medical Reports Created").</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Enter the threshold value</div>
                <div class="ht-step-desc">Set the number the member must reach (e.g., 50 arrests for Police, 20 medical reports for EMS).</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">4</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Check "Auto Promote"</div>
                <div class="ht-step-desc">Enable <strong>Auto Promote</strong> so members are automatically promoted when they meet all requirements for this rank.</div>
              </div>
            </div>
          </div>
          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              Auto-promote only promotes upward &mdash; members are never auto-demoted. A member who meets the
              requirements for a rank two levels above will skip the intermediate rank.
            </div>
          </div>
          <div class="ht-tip" style="margin-top: 0.75rem;">
            <i class="fa fa-lightbulb ht-tip-icon"></i>
            <div class="ht-tip-text">
              If <strong>Auto Promote</strong> is off for a rank, members who qualify will appear in the
              <strong>Pending Promotions</strong> panel for an admin to review and approve.
            </div>
          </div>
        </div>

        <!-- Pending Promotions -->
        <div class="ht-subsection" id="ranks-pending-promotions">
          <h3 class="ht-subsection-title">Pending Promotions</h3>
          <p class="ht-text">
            When a rank has requirements but <strong>Auto Promote</strong> is turned off, members who meet all the
            requirements will appear in the <strong>Pending Promotions</strong> panel for admin review.
          </p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Look for the promotions banner</div>
                <div class="ht-step-desc">When members are eligible for promotion, a banner appears at the top of the <strong>Manage Ranks</strong> modal showing the number of pending promotions.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Open the Pending Promotions panel</div>
                <div class="ht-step-desc">Click the banner to open the panel. Each entry shows the member's name, their current rank, the rank they qualify for, and progress bars for each requirement.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Promote an officer</div>
                <div class="ht-step-desc">Click <strong>Promote</strong> next to a member to advance them to the next rank. The promotion takes effect immediately.</div>
              </div>
            </div>
          </div>
          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              Pending promotions only appear for ranks where <strong>Auto Promote</strong> is off. If Auto Promote is on, members are promoted automatically without admin review.
            </div>
          </div>
        </div>

        <!-- Assigning Ranks -->
        <div class="ht-subsection" id="ranks-assigning">
          <h3 class="ht-subsection-title">Assigning Ranks</h3>
          <p class="ht-text">
            Admins can manually assign ranks to members from the Manage Ranks modal.
          </p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Open the Manage Ranks modal</div>
                <div class="ht-step-desc">Open the <strong>Manage Ranks</strong> modal for the department you want to configure.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Scroll to "Members &amp; Ranks"</div>
                <div class="ht-step-desc">Scroll down to the <strong>Members &amp; Ranks</strong> section at the bottom of the modal.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Assign a rank from the dropdown</div>
                <div class="ht-step-desc">Use the dropdown next to each member to assign them a rank.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">4</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Remove a rank</div>
                <div class="ht-step-desc">Select <strong>"Unranked"</strong> from the dropdown to remove a rank assignment.</div>
              </div>
            </div>
          </div>
          <div class="ht-tip">
            <i class="fa fa-lightbulb ht-tip-icon"></i>
            <div class="ht-tip-text">
              Manual assignments override auto-promotions. The assignment type is tracked (manual vs. auto).
            </div>
          </div>
        </div>

        <!-- Member View -->
        <div class="ht-subsection" id="ranks-member-view">
          <h3 class="ht-subsection-title">Member View</h3>
          <p class="ht-text">
            Members can see their rank and progress on their <strong>department dashboard</strong> (Police, EMS, Dispatch, etc.)
            and in the <strong>mobile app</strong>. The rank card shows:
          </p>
          <ul class="ht-text" style="margin: 0.5rem 0 1rem 1.5rem; color: #cbd5e1; line-height: 1.8;">
            <li>Current rank name and prefix</li>
            <li>Next rank in the hierarchy</li>
            <li>Progress bars toward each requirement for the next rank</li>
            <li>Collapsible activity stats grid showing metrics relevant to the department</li>
          </ul>
          <p class="ht-text">
            When a member is promoted, they see a celebration animation with their new rank.
            If a member is demoted, they see a notification with their updated rank.
          </p>
          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              All members can view their own activity stats and rank progress on their dashboard and mobile app.
              Stats are tracked automatically from CAD activity relevant to the department type.
            </div>
          </div>
        </div>
      </section>

      <!-- ╔═══════════════════════════════════════════╗ -->
      <!-- ║          TONE BOARD SECTION                ║ -->
      <!-- ╚═══════════════════════════════════════════╝ -->
      <section id="tone-board" class="ht-section">
        <div class="ht-section-header">
          <div class="ht-section-icon"><i class="fa fa-broadcast-tower"></i></div>
          <div>
            <div class="ht-section-title">Tone Board</div>
            <div class="ht-section-subtitle">Set up and use dispatch alert tones for your community</div>
          </div>
        </div>

        <!-- Overview -->
        <div class="ht-subsection" id="tones-overview">
          <h3 class="ht-subsection-title">Overview</h3>
          <p class="ht-text">
            The Tone Board is a dispatch tool that simulates real-world station alerting tones.
            When a dispatcher presses a tone button, every on-duty member in the targeted department(s) receives
            an audible alert tone and a visual banner on their dashboard &mdash; just like a real fire station
            or police precinct alerting system.
          </p>
          <p class="ht-text">
            After the tone plays, the dispatcher switches to their voice channel (e.g. Discord) to deliver
            the dispatch message with the incident details.
          </p>
          <div class="ht-flow">
            <span class="ht-flow-item">Dispatcher presses tone</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Alert plays on targeted dashboards</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Voice dispatch over comms</span>
          </div>
          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              The Tone Board is available on the <strong>Dispatch Dashboard</strong>. Only users with dispatch access can trigger tones.
              All department dashboard users (Police, Fire, EMS) will receive alerts if their department is targeted.
            </div>
          </div>
        </div>

        <!-- Admin Setup -->
        <div class="ht-subsection" id="tones-admin-setup">
          <h3 class="ht-subsection-title">Admin Setup</h3>
          <p class="ht-text">Administrators set up tone groups and configure which departments receive alerts. Here's how:</p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Open Community Settings</div>
                <div class="ht-step-desc">Navigate to your <strong>Community Settings</strong> page and find the <strong>Tone Board</strong> card.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Create Tone Groups</div>
                <div class="ht-step-desc">
                  Tone groups organize which departments get toned together. For example, you might create a group called
                  <strong>"Structure Fire &mdash; North"</strong> that includes Engine 1, Ladder 5, and Rescue 12.
                  Each group becomes a button on the dispatch Tone Board.
                </div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Assign Departments to Groups</div>
                <div class="ht-step-desc">
                  Each tone group targets one or more departments. When the tone is activated, <strong>only dashboards belonging
                  to those departments</strong> will receive the alert. Departments are automatically categorized as
                  Police (blue), Fire (orange), or EMS (green) based on their template.
                </div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">4</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Configure Alert Sounds (Optional)</div>
                <div class="ht-step-desc">
                  Each department template has a default alert tone (Police, Fire, EMS). You can customize which tone sound plays
                  for a specific department by editing the department and changing the <strong>Dispatch Tone</strong> dropdown.
                </div>
              </div>
            </div>
          </div>
          <div class="ht-tip">
            <i class="fa fa-lightbulb ht-tip-icon"></i>
            <div class="ht-tip-text">
              Members control their own alert volume through <strong>Sound Settings</strong> (the speaker icon on their dashboard).
              Make sure your members have sounds enabled and the volume set to their preference.
            </div>
          </div>
        </div>

        <!-- Dispatching Tones -->
        <div class="ht-subsection" id="tones-dispatching">
          <h3 class="ht-subsection-title">Dispatching Tones</h3>
          <p class="ht-text">To send a tone from the Dispatch Dashboard:</p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Find the department or tone group</div>
                <div class="ht-step-desc">
                  Use the <strong>filter chips</strong> (All / Police / Fire / EMS) to narrow by department type,
                  or use the <strong>search bar</strong> to find a specific department by name.
                </div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Press the tone button</div>
                <div class="ht-step-desc">
                  Click the department button to trigger the tone. The button will show a <strong>"Sending..."</strong>
                  state followed by a brief cooldown (3 seconds) to prevent accidental double-triggers.
                </div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Deliver the dispatch over voice</div>
                <div class="ht-step-desc">
                  After the tone plays on all targeted dashboards, switch to your voice channel (e.g. Discord)
                  and deliver the dispatch message with the incident details. See the roleplay examples below.
                </div>
              </div>
            </div>
          </div>
          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              The <strong>Recent Activity</strong> log at the bottom of the Tone Board shows who triggered what and when,
              giving you a history of all dispatched tones.
            </div>
          </div>
        </div>

        <!-- Roleplay Examples -->
        <div class="ht-subsection" id="tones-rp-examples">
          <h3 class="ht-subsection-title">Roleplay Examples</h3>
          <p class="ht-text">
            These examples show how real-world dispatchers communicate after sending a tone.
            Use these as a guide for your roleplay dispatch calls.
          </p>

          <!-- Fire Example -->
          <div class="ht-sample-box" style="border-left: 3px solid #ea580c;">
            <div class="ht-sample-label"><i class="fa fa-fire-flame-curved" style="color:#ea580c;"></i> Fire Dispatch</div>
            <div class="ht-sample-content">
              <div class="ht-steps" style="margin-bottom: 0.5rem;">
                <div class="ht-step">
                  <div class="ht-step-number" style="background:rgba(234,88,12,0.15); border-color:rgba(234,88,12,0.25); color:#ea580c;">1</div>
                  <div class="ht-step-body">
                    <div class="ht-step-title">Press the tone button for the target fire department(s)</div>
                  </div>
                </div>
                <div class="ht-step">
                  <div class="ht-step-number" style="background:rgba(234,88,12,0.15); border-color:rgba(234,88,12,0.25); color:#ea580c;">2</div>
                  <div class="ht-step-body">
                    <div class="ht-step-title">Wait for the tone to finish playing (~3 seconds)</div>
                  </div>
                </div>
                <div class="ht-step">
                  <div class="ht-step-number" style="background:rgba(234,88,12,0.15); border-color:rgba(234,88,12,0.25); color:#ea580c;">3</div>
                  <div class="ht-step-body">
                    <div class="ht-step-title">Key up on your voice channel and dispatch:</div>
                  </div>
                </div>
              </div>
              <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(234,88,12,0.12); border-radius:var(--ht-radius-sm); padding:1rem 1.25rem; margin-top:0.5rem;">
                <i class="fa fa-quote-left" style="color:#475569; font-size:0.75rem; display:block; margin-bottom:0.4rem;"></i>
                <p style="color:#cbd5e1; font-style:italic; line-height:1.65; margin:0; font-size:0.92rem;">
                  "Station 5, Ladder 11 &mdash; structure fire reported at 742 Evergreen Terrace.
                  Two-story residential, possible entrapment. Engine 3 and Rescue 7 also responding. Time out: 14:32."
                </p>
              </div>
            </div>
          </div>

          <!-- EMS Example -->
          <div class="ht-sample-box" style="border-left: 3px solid #16a34a;">
            <div class="ht-sample-label"><i class="fa fa-kit-medical" style="color:#16a34a;"></i> EMS Dispatch</div>
            <div class="ht-sample-content">
              <div class="ht-steps" style="margin-bottom: 0.5rem;">
                <div class="ht-step">
                  <div class="ht-step-number" style="background:rgba(22,163,74,0.15); border-color:rgba(22,163,74,0.25); color:#16a34a;">1</div>
                  <div class="ht-step-body">
                    <div class="ht-step-title">Press the tone button for the target EMS unit(s)</div>
                  </div>
                </div>
                <div class="ht-step">
                  <div class="ht-step-number" style="background:rgba(22,163,74,0.15); border-color:rgba(22,163,74,0.25); color:#16a34a;">2</div>
                  <div class="ht-step-body">
                    <div class="ht-step-title">Wait for the tone, then key up:</div>
                  </div>
                </div>
              </div>
              <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(22,163,74,0.12); border-radius:var(--ht-radius-sm); padding:1rem 1.25rem; margin-top:0.5rem;">
                <i class="fa fa-quote-left" style="color:#475569; font-size:0.75rem; display:block; margin-bottom:0.4rem;"></i>
                <p style="color:#cbd5e1; font-style:italic; line-height:1.65; margin:0; font-size:0.92rem;">
                  "Medic 4, respond to 1600 Pennsylvania Avenue for a medical emergency &mdash; 45-year-old male,
                  chest pains, conscious and breathing. ALS response requested. Time out: 09:17."
                </p>
              </div>
            </div>
          </div>

          <!-- Police Example -->
          <div class="ht-sample-box" style="border-left: 3px solid #3b82f6;">
            <div class="ht-sample-label"><i class="fa fa-shield-halved" style="color:#3b82f6;"></i> Police Dispatch</div>
            <div class="ht-sample-content">
              <div class="ht-steps" style="margin-bottom: 0.5rem;">
                <div class="ht-step">
                  <div class="ht-step-number" style="background:rgba(59,130,246,0.15); border-color:rgba(59,130,246,0.25); color:#3b82f6;">1</div>
                  <div class="ht-step-body">
                    <div class="ht-step-title">Press the tone button for the target police unit(s)</div>
                  </div>
                </div>
                <div class="ht-step">
                  <div class="ht-step-number" style="background:rgba(59,130,246,0.15); border-color:rgba(59,130,246,0.25); color:#3b82f6;">2</div>
                  <div class="ht-step-body">
                    <div class="ht-step-title">Wait for the tone, then key up:</div>
                  </div>
                </div>
              </div>
              <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(59,130,246,0.12); border-radius:var(--ht-radius-sm); padding:1rem 1.25rem; margin-top:0.5rem;">
                <i class="fa fa-quote-left" style="color:#475569; font-size:0.75rem; display:block; margin-bottom:0.4rem;"></i>
                <p style="color:#cbd5e1; font-style:italic; line-height:1.65; margin:0; font-size:0.92rem;">
                  "All units, priority traffic &mdash; armed robbery in progress at First National Bank, 400 Main Street.
                  Suspect described as male, black hoodie, armed with a handgun. Units 12 and 15 respond code 3. Time out: 22:45."
                </p>
              </div>
            </div>
          </div>

          <div class="ht-tip">
            <i class="fa fa-lightbulb ht-tip-icon"></i>
            <div class="ht-tip-text">
              Always include key details: <strong>unit assignment</strong>, <strong>incident type</strong>,
              <strong>location</strong>, <strong>relevant details</strong> (suspect description, patient condition, etc.),
              and <strong>time out</strong>. This mirrors real-world dispatch protocol.
            </div>
          </div>
        </div>

        <!-- Tips -->
        <div class="ht-subsection" id="tones-tips">
          <h3 class="ht-subsection-title">Tips</h3>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number" style="background:rgba(34,197,94,0.15); border-color:rgba(34,197,94,0.25); color:#22c55e;"><i class="fa fa-check" style="font-size:0.7rem;"></i></div>
              <div class="ht-step-body">
                <div class="ht-step-title">Use Filter Chips</div>
                <div class="ht-step-desc">Use the <strong>Police / Fire / EMS</strong> filter chips to narrow the tone board when you have many departments.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number" style="background:rgba(34,197,94,0.15); border-color:rgba(34,197,94,0.25); color:#22c55e;"><i class="fa fa-check" style="font-size:0.7rem;"></i></div>
              <div class="ht-step-body">
                <div class="ht-step-title">Search for Departments</div>
                <div class="ht-step-desc">Use the <strong>search bar</strong> to quickly find a specific department by name &mdash; especially useful with 20+ departments.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number" style="background:rgba(34,197,94,0.15); border-color:rgba(34,197,94,0.25); color:#22c55e;"><i class="fa fa-check" style="font-size:0.7rem;"></i></div>
              <div class="ht-step-body">
                <div class="ht-step-title">Cooldown Prevention</div>
                <div class="ht-step-desc">There's a <strong>3-second cooldown</strong> after pressing a tone button to prevent accidental double-triggers.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number" style="background:rgba(34,197,94,0.15); border-color:rgba(34,197,94,0.25); color:#22c55e;"><i class="fa fa-check" style="font-size:0.7rem;"></i></div>
              <div class="ht-step-body">
                <div class="ht-step-title">Activity Log</div>
                <div class="ht-step-desc">Check the <strong>Recent Activity</strong> log to see who triggered what tone and when.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number" style="background:rgba(34,197,94,0.15); border-color:rgba(34,197,94,0.25); color:#22c55e;"><i class="fa fa-check" style="font-size:0.7rem;"></i></div>
              <div class="ht-step-body">
                <div class="ht-step-title">Sound Settings</div>
                <div class="ht-step-desc">Members can adjust their alert volume via the <strong>speaker icon</strong> on their dashboard. Remind members to check their settings so they don't miss a tone.</div>
              </div>
            </div>
          </div>
        </div>
      </section>

    </div><!-- /.ht-content -->
  </div><!-- /.ht-layout -->


</div><!-- /.ht-shell -->

<% include partials/footer %>

<script>
(function() {
  'use strict';

  var navLinks = document.querySelectorAll('.ht-nav-link');
  var subsections = document.querySelectorAll('.ht-subsection[id]');

  // Smooth scroll on nav click
  navLinks.forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      var target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, null, this.getAttribute('href'));
        // Close mobile nav after clicking a link
        var sidebar = document.querySelector('.ht-sidebar');
        var toggle = document.querySelector('.ht-nav-toggle');
        if (sidebar) sidebar.classList.remove('open');
        if (toggle) toggle.classList.remove('active');
      }
    });
  });

  // Scrollspy: highlight active nav link
  function updateActiveLink() {
    var atBottom = (window.innerHeight + window.scrollY) >= (document.body.scrollHeight - 30);

    if (atBottom && subsections.length) {
      // At the bottom of the page — activate the last subsection
      var lastId = subsections[subsections.length - 1].id;
      navLinks.forEach(function(link) {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + lastId) {
          link.classList.add('active');
        }
      });
      return;
    }

    var scrollY = window.scrollY + 120;
    var current = '';
    subsections.forEach(function(section) {
      if (section.offsetTop <= scrollY) {
        current = section.id;
      }
    });
    navLinks.forEach(function(link) {
      link.classList.remove('active');
      if (link.getAttribute('href') === '#' + current) {
        link.classList.add('active');
      }
    });
  }

  window.addEventListener('scroll', updateActiveLink);
  updateActiveLink();

  // Handle hash on page load (deep linking)
  if (window.location.hash) {
    var hashTarget = document.querySelector(window.location.hash);
    if (!hashTarget) {
      // Try matching section id (e.g., #court-cases -> scroll to #court-overview)
      var sectionMap = {
        '#warrants': '#warrants-overview',
        '#penal-codes': '#penal-overview',
        '#court-cases': '#court-overview',
        '#community-settings': '#settings-overview',
        '#rank-system': '#ranks-overview',
        '#tone-board': '#tones-overview'
      };
      var mapped = sectionMap[window.location.hash];
      if (mapped) hashTarget = document.querySelector(mapped);
    }
    if (hashTarget) {
      setTimeout(function() {
        hashTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 150);
    }
  }
})();

// Sidebar search filter
function filterHelpNav(query) {
  var q = query.toLowerCase().trim();
  var sidebar = document.querySelector('.ht-sidebar');
  var groups = sidebar.querySelectorAll('.ht-nav-group-title');
  var links = sidebar.querySelectorAll('.ht-nav-link');

  if (!q) {
    // Show everything
    groups.forEach(function(g) { g.style.display = ''; });
    links.forEach(function(l) { l.style.display = ''; });
    return;
  }

  // First pass: check which links match
  var visibleGroups = new Set();
  links.forEach(function(link) {
    var text = link.textContent.toLowerCase();
    // Also check the group title above this link
    var prev = link.previousElementSibling;
    while (prev && !prev.classList.contains('ht-nav-group-title')) {
      prev = prev.previousElementSibling;
    }
    var groupText = prev ? prev.textContent.toLowerCase() : '';

    if (text.indexOf(q) !== -1 || groupText.indexOf(q) !== -1) {
      link.style.display = '';
      if (prev) visibleGroups.add(prev);
    } else {
      link.style.display = 'none';
    }
  });

  // Show/hide group titles
  groups.forEach(function(g) {
    g.style.display = visibleGroups.has(g) ? '' : 'none';
  });
}
</script>

</body>
</html>
