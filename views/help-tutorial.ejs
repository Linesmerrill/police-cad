      <!-- ╔═══════════════════════════════════════════╗ -->
      <!-- ║           WARRANTS SECTION                 ║ -->
      <!-- ╚═══════════════════════════════════════════╝ -->
      <section id="warrants" class="ht-section">
        <div class="ht-section-header">
          <div class="ht-section-icon"><i class="fa fa-gavel"></i></div>
          <div>
            <div class="ht-section-title">Warrants</div>
            <div class="ht-section-subtitle">Request, review, and manage warrants</div>
          </div>
        </div>

        <!-- Overview -->
        <div class="ht-subsection" id="warrants-overview">
          <h3 class="ht-subsection-title">Overview</h3>
          <p class="ht-text">
            Warrants are official court-authorized documents that allow law enforcement to take specific actions
            against a civilian. There are three types of warrants available in the system:
          </p>
          <p class="ht-text">
            <strong style="color:#fff;">Arrest Warrant</strong> &mdash; Authorizes the arrest of a specific individual suspected of a crime.<br>
            <strong style="color:#fff;">Search Warrant</strong> &mdash; Authorizes a search of a specific location for evidence related to a crime.<br>
            <strong style="color:#fff;">Bench Warrant</strong> &mdash; Issued by a judge, typically when a person fails to appear in court.
          </p>
          <p class="ht-text">Every warrant goes through a lifecycle:</p>
          <div class="ht-flow">
            <span class="ht-flow-item">Pending</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Approved / Denied</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Active</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Executed / Withdrawn</span>
          </div>
          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              Only users with the appropriate permissions (e.g., officers, judges) can create, review, or manage warrants. Your role determines which actions are available to you.
            </div>
          </div>
        </div>

        <!-- Creating a Warrant -->
        <div class="ht-subsection" id="warrants-creating">
          <h3 class="ht-subsection-title">Creating a Warrant</h3>
          <p class="ht-text">Officers can request a warrant by following these steps:</p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Search for the civilian</div>
                <div class="ht-step-desc">Use the <strong>Name Database</strong> in the sidebar to look up the person you want to file a warrant for.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Click "Request Warrant"</div>
                <div class="ht-step-desc">Once you've found the civilian, click the <strong>Request Warrant</strong> button to open the warrant form.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Fill out the warrant form</div>
                <div class="ht-step-desc">Select the warrant type, add the charges, and provide probable cause. For search warrants, also specify the location to be searched.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">4</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Submit for review</div>
                <div class="ht-step-desc">Click <strong>Submit</strong> to send the warrant request to a judge for approval. You'll be notified once it's been reviewed.</div>
              </div>
            </div>
          </div>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Warrant Request Form</div>
            <div class="ht-sample-content">
              <div class="ht-form-group">
                <label class="ht-form-label">Warrant Type</label>
                <select class="ht-form-select">
                  <option>Arrest Warrant</option>
                </select>
              </div>
              <div class="ht-form-row">
                <div class="ht-form-group">
                  <label class="ht-form-label">First Name</label>
                  <input class="ht-form-input" type="text" value="John">
                </div>
                <div class="ht-form-group">
                  <label class="ht-form-label">Last Name</label>
                  <input class="ht-form-input" type="text" value="Doe">
                </div>
              </div>
              <div class="ht-form-group">
                <label class="ht-form-label">Charges</label>
                <input class="ht-form-input" type="text" value="Reckless Driving, Evading Police">
              </div>
              <div class="ht-form-group">
                <label class="ht-form-label">Probable Cause</label>
                <textarea class="ht-form-textarea">Suspect was observed driving recklessly through a school zone and fled when officers attempted a traffic stop.</textarea>
              </div>
              <div class="ht-btn-group">
                <button class="ht-btn ht-btn-accent"><i class="fa fa-paper-plane"></i> Submit Warrant</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Reviewing Warrants -->
        <div class="ht-subsection" id="warrants-reviewing">
          <h3 class="ht-subsection-title">Reviewing Warrants</h3>
          <p class="ht-text">
            Judges and authorized administrators can review pending warrant requests. Pending warrants appear in the
            <strong>Review Warrants</strong> section in the sidebar.
          </p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Open Review Warrants</div>
                <div class="ht-step-desc">Click <strong>Review Warrants</strong> in the sidebar. A badge shows how many warrants are pending review.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Read the warrant details</div>
                <div class="ht-step-desc">Review the warrant type, accused person, charges, probable cause, and the requesting officer's information.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Add judge notes (optional)</div>
                <div class="ht-step-desc">You can add notes explaining your decision. These notes will be visible to the requesting officer.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">4</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Approve or Deny</div>
                <div class="ht-step-desc">Click <strong>Approve</strong> to authorize the warrant, or <strong>Deny</strong> to reject it.</div>
              </div>
            </div>
          </div>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Warrant Review Panel</div>
            <div class="ht-sample-content">
              <div class="ht-form-row">
                <div class="ht-form-group">
                  <label class="ht-form-label">Warrant Type</label>
                  <input class="ht-form-input" type="text" value="Arrest Warrant" readonly>
                </div>
                <div class="ht-form-group">
                  <label class="ht-form-label">Status</label>
                  <input class="ht-form-input" type="text" value="Pending Review" readonly>
                </div>
              </div>
              <div class="ht-form-row">
                <div class="ht-form-group">
                  <label class="ht-form-label">Accused</label>
                  <input class="ht-form-input" type="text" value="John Doe" readonly>
                </div>
                <div class="ht-form-group">
                  <label class="ht-form-label">Requesting Officer</label>
                  <input class="ht-form-input" type="text" value="Ofc. Smith" readonly>
                </div>
              </div>
              <div class="ht-form-group">
                <label class="ht-form-label">Charges</label>
                <input class="ht-form-input" type="text" value="Reckless Driving, Evading Police" readonly>
              </div>
              <div class="ht-form-group">
                <label class="ht-form-label">Probable Cause</label>
                <textarea class="ht-form-textarea" readonly>Suspect was observed driving recklessly through a school zone and fled when officers attempted a traffic stop.</textarea>
              </div>
              <div class="ht-form-group">
                <label class="ht-form-label">Judge Notes</label>
                <textarea class="ht-form-textarea" placeholder="Enter any notes about your decision..."></textarea>
              </div>
              <div class="ht-btn-group">
                <button class="ht-btn ht-btn-green"><i class="fa fa-check"></i> Approve Warrant</button>
                <button class="ht-btn ht-btn-red"><i class="fa fa-times"></i> Deny Warrant</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Managing Warrants -->
        <div class="ht-subsection" id="warrants-managing">
          <h3 class="ht-subsection-title">Managing Warrants</h3>
          <p class="ht-text">
            Once a warrant has been approved, it becomes active. Officers can view all active warrants under the
            <strong>All Warrants</strong> section in the sidebar.
          </p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">View warrant details</div>
                <div class="ht-step-desc">Click on any warrant to view its full details including type, status, charges, probable cause, and judge notes.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Execute the warrant</div>
                <div class="ht-step-desc">When you're ready to act on the warrant, click <strong>Execute Warrant</strong>. This marks the warrant as executed in the system.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Withdraw (if needed)</div>
                <div class="ht-step-desc">If a warrant is no longer needed, click <strong>Withdraw</strong> to recall it. This cannot be undone.</div>
              </div>
            </div>
          </div>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Warrant Detail View</div>
            <div class="ht-sample-content">
              <div class="ht-form-row">
                <div class="ht-form-group">
                  <label class="ht-form-label">Warrant Type</label>
                  <input class="ht-form-input" type="text" value="Arrest Warrant" readonly>
                </div>
                <div class="ht-form-group">
                  <label class="ht-form-label">Status</label>
                  <div style="margin-top:0.3rem;"><span class="ht-badge ht-badge-approved">Approved</span></div>
                </div>
              </div>
              <div class="ht-form-row">
                <div class="ht-form-group">
                  <label class="ht-form-label">Accused</label>
                  <input class="ht-form-input" type="text" value="John Doe" readonly>
                </div>
                <div class="ht-form-group">
                  <label class="ht-form-label">Date Filed</label>
                  <input class="ht-form-input" type="text" value="2/20/2026, 3:15 PM" readonly>
                </div>
              </div>
              <div class="ht-form-group">
                <label class="ht-form-label">Charges</label>
                <input class="ht-form-input" type="text" value="Reckless Driving, Evading Police" readonly>
              </div>
              <div class="ht-form-group">
                <label class="ht-form-label">Judge Notes</label>
                <textarea class="ht-form-textarea" readonly>Sufficient probable cause. Warrant approved.</textarea>
              </div>
              <div class="ht-btn-group">
                <button class="ht-btn ht-btn-accent"><i class="fa fa-bolt"></i> Execute Warrant</button>
                <button class="ht-btn ht-btn-outline"><i class="fa fa-rotate-left"></i> Withdraw</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ╔═══════════════════════════════════════════╗ -->
      <!-- ║         PENAL CODES SECTION                ║ -->
      <!-- ╚═══════════════════════════════════════════╝ -->
      <section id="penal-codes" class="ht-section">
        <div class="ht-section-header">
          <div class="ht-section-icon"><i class="fa fa-scale-balanced"></i></div>
          <div>
            <div class="ht-section-title">Penal Codes</div>
            <div class="ht-section-subtitle">Browse and understand the legal code reference</div>
          </div>
        </div>

        <!-- Overview -->
        <div class="ht-subsection" id="penal-overview">
          <h3 class="ht-subsection-title">Overview</h3>
          <p class="ht-text">
            Penal Codes are a reference document listing all violations recognized by your community. Each violation includes the offense name,
            the associated jail time, fine amount, and an explanation of the offense. Penal codes are used throughout the system
            when filing citations, arrest reports, and warrant charges.
          </p>
          <p class="ht-text">Violations are organized into five categories, from least to most severe:</p>
          <div class="ht-flow">
            <span class="ht-flow-item">Traffic Violations</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Petty Misdemeanors</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Misdemeanors</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Felonies</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Other</span>
          </div>
        </div>

        <!-- Navigating -->
        <div class="ht-subsection" id="penal-navigating">
          <h3 class="ht-subsection-title">Navigating Penal Codes</h3>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Open Penal Codes</div>
                <div class="ht-step-desc">Click <strong>Penal Codes</strong> in the sidebar to open the reference page.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Use the category navigation</div>
                <div class="ht-step-desc">The left sidebar on the Penal Codes page lists all categories. Click a category name to jump directly to that section.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Search for a violation</div>
                <div class="ht-step-desc">Each category table has a search box at the top. Type a keyword to instantly filter results within that category.</div>
              </div>
            </div>
          </div>
          <div class="ht-tip">
            <i class="fa fa-lightbulb ht-tip-icon"></i>
            <div class="ht-tip-text">
              The <strong>"Other"</strong> category includes special violations like cop/civ baiting and metagaming. Check this section if the violation you're looking for doesn't fit into the standard categories.
            </div>
          </div>
        </div>

        <!-- Understanding the Table -->
        <div class="ht-subsection" id="penal-table">
          <h3 class="ht-subsection-title">Understanding the Table</h3>
          <p class="ht-text">Each penal code table has four columns:</p>
          <p class="ht-text">
            <strong style="color:#fff;">Violation</strong> &mdash; The name of the offense.<br>
            <strong style="color:#fff;">Jail Time</strong> &mdash; How long the offender may be jailed (in seconds, for roleplay purposes).<br>
            <strong style="color:#fff;">Fine</strong> &mdash; The monetary fine associated with the offense.<br>
            <strong style="color:#fff;">Explanation</strong> &mdash; A brief description of what constitutes this offense.
          </p>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Penal Code Table</div>
            <div class="ht-sample-content">
              <table class="ht-sample-table">
                <thead>
                  <tr>
                    <th>Violation</th>
                    <th>Jail Time</th>
                    <th>Fine</th>
                    <th>Explanation</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Reckless Driving</td>
                    <td>30 seconds</td>
                    <td>$1,000</td>
                    <td>Careless and unlawful operation of a vehicle.</td>
                  </tr>
                  <tr>
                    <td>Speeding (10-19 over)</td>
                    <td>N/A</td>
                    <td>$150</td>
                    <td>Failing to obey posted speed limit signs.</td>
                  </tr>
                  <tr>
                    <td>Assault</td>
                    <td>45 seconds</td>
                    <td>$1,500</td>
                    <td>Intentional use of physical force against another person.</td>
                  </tr>
                  <tr>
                    <td>Grand Theft Auto</td>
                    <td>60 seconds</td>
                    <td>$2,500</td>
                    <td>Unlawful taking of a motor vehicle belonging to another.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Using in Other Features -->
        <div class="ht-subsection" id="penal-usage">
          <h3 class="ht-subsection-title">Using Penal Codes in Other Features</h3>
          <p class="ht-text">
            Penal codes aren't just a reference &mdash; they're integrated throughout the system. When you file a citation,
            create an arrest report, or request a warrant, the <strong>Charges</strong> field pulls from the penal code list.
            This ensures consistency across all reports and documents.
          </p>
          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              If your community has custom penal codes, those will appear in the charges dropdowns as well. Community owners can manage penal codes through the community settings.
            </div>
          </div>
        </div>
      </section>

      <!-- ╔═══════════════════════════════════════════╗ -->
      <!-- ║         COURT CASES SECTION                ║ -->
      <!-- ╚═══════════════════════════════════════════╝ -->
      <section id="court-cases" class="ht-section">
        <div class="ht-section-header">
          <div class="ht-section-icon"><i class="fa fa-briefcase"></i></div>
          <div>
            <div class="ht-section-title">Court Cases</div>
            <div class="ht-section-subtitle">File, track, and manage court proceedings</div>
          </div>
        </div>

        <!-- Overview -->
        <div class="ht-subsection" id="court-overview">
          <h3 class="ht-subsection-title">Overview</h3>
          <p class="ht-text">
            The Court Cases system allows civilians to contest actions taken against them (arrests, citations, warnings)
            and have their cases heard by a judge. Cases are organized into sessions where a judge reviews one or more cases at a time.
          </p>
          <p class="ht-text">Every court case follows a lifecycle:</p>
          <div class="ht-flow">
            <span class="ht-flow-item">Submitted</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">In Review</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Scheduled</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">In Progress</span>
            <i class="fa fa-arrow-right ht-flow-arrow"></i>
            <span class="ht-flow-item">Completed</span>
          </div>
          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              Civilians submit cases to contest actions, while judges manage the review and scheduling process.
              <strong>Judges</strong> see the full dashboard with all tabs and action buttons.
              <strong>Civilians</strong> see a filtered view showing only their own cases.
            </div>
          </div>
        </div>

        <!-- Accessing Court Cases -->
        <div class="ht-subsection" id="court-accessing">
          <h3 class="ht-subsection-title">Accessing Court Cases</h3>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Open Court Cases from the sidebar</div>
                <div class="ht-step-desc">From your <strong>Judicial Department</strong> dashboard, click <strong>Court Cases</strong> in the left sidebar navigation. This opens the court case management page for your community.</div>
              </div>
            </div>
          </div>

          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              The <strong>Court Cases</strong> link appears in the sidebar of every department, but only the <strong>Judicial Department</strong> sidebar gives you the full judge controls &mdash; assigning cases, scheduling court dates, creating sessions, and resolving verdicts. From other departments, you can view cases but won't have these additional actions.
            </div>
          </div>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Sidebar Navigation</div>
            <div class="ht-sample-content">
              <div class="ht-sidebar-sample">
                <div class="ht-sidebar-item"><i class="fa fa-phone"></i> Calls</div>
                <div class="ht-sidebar-item"><i class="fa fa-map"></i> Map</div>
                <div class="ht-sidebar-item highlighted"><i class="fa fa-briefcase"></i> Court Cases</div>
                <div class="ht-sidebar-item"><i class="fa fa-circle-question"></i> Help</div>
              </div>
            </div>
          </div>

          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Check the metrics bar</div>
                <div class="ht-step-desc">At the top of the page, four metric cards give you a quick summary of <strong>Pending</strong> cases, <strong>Scheduled</strong> cases, <strong>Active Sessions</strong>, and <strong>Completed</strong> sessions.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Navigate using tabs</div>
                <div class="ht-step-desc">Below the metrics, four tabs organize all court activity: <strong>Case Queue</strong>, <strong>Scheduled</strong>, <strong>Sessions</strong>, and <strong>History</strong>. Each tab is explained in detail below.</div>
              </div>
            </div>
          </div>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Court Cases Dashboard</div>
            <div class="ht-sample-content">
              <div class="ht-metrics">
                <div class="ht-metric">
                  <div class="ht-metric-value gold">3</div>
                  <div class="ht-metric-label">Pending</div>
                </div>
                <div class="ht-metric">
                  <div class="ht-metric-value blue">1</div>
                  <div class="ht-metric-label">Scheduled</div>
                </div>
                <div class="ht-metric">
                  <div class="ht-metric-value red">1</div>
                  <div class="ht-metric-label">Active</div>
                </div>
                <div class="ht-metric">
                  <div class="ht-metric-value green">12</div>
                  <div class="ht-metric-label">Completed</div>
                </div>
              </div>
              <div class="ht-tabs">
                <button class="ht-tab active"><i class="fa fa-inbox"></i> Case Queue <span class="ht-tab-count">3</span></button>
                <button class="ht-tab"><i class="fa fa-calendar-check"></i> Scheduled <span class="ht-tab-count">1</span></button>
                <button class="ht-tab"><i class="fa fa-circle-play"></i> Sessions <span class="ht-tab-count">1</span></button>
                <button class="ht-tab"><i class="fa fa-clock-rotate-left"></i> History</button>
              </div>
            </div>
          </div>

          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              You can filter between <strong>Your Cases</strong> (only cases you submitted or are assigned to) and <strong>All Cases</strong> using the filter pills above the tabs.
            </div>
          </div>
        </div>

        <!-- Case Queue -->
        <div class="ht-subsection" id="court-queue">
          <h3 class="ht-subsection-title">Case Queue</h3>
          <p class="ht-text">
            The <strong>Case Queue</strong> tab is where all newly submitted court cases appear. When a civilian contests an arrest, citation, or warning, their case lands here with a <strong>Submitted</strong> status. This is the starting point for all judicial work.
          </p>

          <p class="ht-text">
            Each case card shows the civilian's name, the number of items they're contesting, and when they submitted their case.
          </p>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Submitted Case in Queue</div>
            <div class="ht-sample-content">
              <div class="ht-case-card">
                <div class="ht-avatar">JD</div>
                <div class="ht-case-info">
                  <div class="ht-case-name">John Doe</div>
                  <div class="ht-case-meta">
                    <span class="ht-badge ht-badge-submitted">Submitted</span>
                    <span><i class="fa fa-file-lines"></i> 2 items</span>
                    <span><i class="fa fa-clock"></i> 2/20/2026</span>
                  </div>
                </div>
                <button class="ht-btn ht-btn-outline"><i class="fa fa-eye"></i> View</button>
              </div>
            </div>
          </div>

          <h3 class="ht-subsection-title" style="margin-top:1.5rem;">Assigning a Case</h3>
          <p class="ht-text">
            As a judge, you can click the <strong>Assign</strong> button on any submitted case to let other judges in your community know that you would like to take on that case. Assigning moves the case from <strong>Submitted</strong> to <strong>In Review</strong> status and records your name as the assigned judge.
          </p>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Case Card with Assign Button</div>
            <div class="ht-sample-content">
              <div class="ht-case-card">
                <div class="ht-avatar">AS</div>
                <div class="ht-case-info">
                  <div class="ht-case-name">Alice Smith</div>
                  <div class="ht-case-meta">
                    <span class="ht-badge ht-badge-submitted">Submitted</span>
                    <span><i class="fa fa-file-lines"></i> 1 item</span>
                    <span><i class="fa fa-clock"></i> 2/18/2026</span>
                  </div>
                </div>
                <button class="ht-btn ht-btn-indigo"><i class="fa fa-user-check"></i> Assign</button>
              </div>
            </div>
          </div>

          <p class="ht-text">
            After assigning, the case stays in the Queue tab but now shows an <strong>In Review</strong> badge with your name as the judge. The case is now ready for you to review and schedule.
          </p>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Case After Assignment</div>
            <div class="ht-sample-content">
              <div class="ht-case-card">
                <div class="ht-avatar">AS</div>
                <div class="ht-case-info">
                  <div class="ht-case-name">Alice Smith</div>
                  <div class="ht-case-meta">
                    <span class="ht-badge ht-badge-in-review">In Review</span>
                    <span><i class="fa fa-file-lines"></i> 1 item</span>
                    <span><i class="fa fa-user"></i> Judge Williams</span>
                  </div>
                </div>
                <button class="ht-btn ht-btn-outline"><i class="fa fa-eye"></i> View</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Reviewing & Scheduling -->
        <div class="ht-subsection" id="court-reviewing">
          <h3 class="ht-subsection-title">Reviewing & Scheduling</h3>
          <p class="ht-text">
            Once you've assigned a case to yourself, click on the case card to open its details. Here you can see the civilian's full statement, all the contested items they're disputing, and take action.
          </p>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Case Detail View (In Review)</div>
            <div class="ht-sample-content">
              <div class="ht-case-detail">
                <div class="ht-case-detail-header">
                  <div class="ht-avatar" style="width:32px;height:32px;font-size:0.7rem;">AS</div>
                  <div>
                    <div class="ht-case-detail-title">Alice Smith</div>
                    <span class="ht-badge ht-badge-in-review" style="margin-top:0.15rem;">In Review</span>
                  </div>
                </div>

                <div class="ht-detail-row">
                  <span class="ht-detail-label">Judge</span>
                  <span class="ht-detail-value">Judge Williams</span>
                </div>
                <div class="ht-detail-row">
                  <span class="ht-detail-label">Submitted</span>
                  <span class="ht-detail-value">Feb 18, 2026</span>
                </div>

                <div style="margin-top:0.75rem;margin-bottom:0.35rem;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:var(--ht-text-dim);">Contested Items</div>
                <div class="ht-contested-item">
                  <div><span class="ht-contested-type citation">Citation</span> Speeding &mdash; 85 in a 65 zone</div>
                </div>

                <div style="margin-top:0.75rem;margin-bottom:0.35rem;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:var(--ht-text-dim);">Civilian Statement</div>
                <p style="font-size:0.8rem;color:var(--ht-text-muted);line-height:1.5;margin-bottom:0.75rem;font-style:italic;">"I believe the radar reading was inaccurate. I was driving at the speed limit."</p>

                <div class="ht-action-row">
                  <button class="ht-btn ht-btn-accent"><i class="fa fa-calendar"></i> Schedule Court Date</button>
                  <button class="ht-btn ht-btn-red"><i class="fa fa-trash"></i> Delete Case</button>
                </div>
              </div>
            </div>
          </div>

          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Schedule Court Date</div>
                <div class="ht-step-desc">Click <strong>Schedule Court Date</strong> to pick a date and time. This notifies the civilian when their case will be taken up in court and moves the case to the <strong>Scheduled</strong> tab.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Delete Case (optional)</div>
                <div class="ht-step-desc">If the case is invalid or submitted in error, you can permanently remove it by clicking <strong>Delete Case</strong>. If the case hasn't been completed, any contested charges will be reverted to their original state.</div>
              </div>
            </div>
          </div>

          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              After scheduling, the case automatically moves from the <strong>Case Queue</strong> tab to the <strong>Scheduled</strong> tab. The civilian will be able to see the scheduled date on their end.
            </div>
          </div>
        </div>

        <!-- Scheduled Cases -->
        <div class="ht-subsection" id="court-scheduled">
          <h3 class="ht-subsection-title">Scheduled Cases</h3>
          <p class="ht-text">
            The <strong>Scheduled</strong> tab shows all cases that have a court date set. Each card displays the civilian's name, the scheduled date, and two action buttons for the judge.
          </p>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Scheduled Case with Actions</div>
            <div class="ht-sample-content">
              <div class="ht-case-card" style="flex-wrap:wrap;">
                <div class="ht-avatar">AS</div>
                <div class="ht-case-info">
                  <div class="ht-case-name">Alice Smith</div>
                  <div class="ht-case-meta">
                    <span class="ht-badge ht-badge-scheduled">Scheduled</span>
                    <span><i class="fa fa-calendar"></i> Mar 15, 2026 at 2:00 PM</span>
                    <span><i class="fa fa-file-lines"></i> 1 item</span>
                  </div>
                </div>
                <div style="display:flex;gap:0.4rem;width:100%;margin-top:0.5rem;padding-left:calc(38px + 0.875rem);">
                  <button class="ht-btn ht-btn-muted" style="flex:1;justify-content:center;"><i class="fa fa-rotate-left"></i> Unschedule</button>
                  <button class="ht-btn ht-btn-amber" style="flex:1;justify-content:center;"><i class="fa fa-calendar-days"></i> Reschedule</button>
                </div>
              </div>
            </div>
          </div>

          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number"><i class="fa fa-rotate-left" style="font-size:0.6rem;"></i></div>
              <div class="ht-step-body">
                <div class="ht-step-title">Unschedule</div>
                <div class="ht-step-desc">Moves the case back to the <strong>Case Queue</strong> in <strong>In Review</strong> status. Use this if the court date needs to be cancelled entirely. The judge remains assigned.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number"><i class="fa fa-calendar-days" style="font-size:0.6rem;"></i></div>
              <div class="ht-step-body">
                <div class="ht-step-title">Reschedule</div>
                <div class="ht-step-desc">Opens a date picker to select a new court date. The case stays in the <strong>Scheduled</strong> tab with the updated date.</div>
              </div>
            </div>
          </div>

          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              Cases that have already been added to a court session cannot be unscheduled. You'll need to remove them from the session first.
            </div>
          </div>
        </div>

        <!-- Court Sessions -->
        <div class="ht-subsection" id="court-sessions">
          <h3 class="ht-subsection-title">Court Sessions</h3>
          <p class="ht-text">
            Court sessions are live proceedings where a judge reviews one or more scheduled cases. Sessions bundle multiple cases together into a single docket that the judge works through in order.
          </p>

          <p class="ht-text">
            When a session is actively running, a red banner appears at the top of the Court Cases page so everyone in your community can see that court is in session.
          </p>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Live Session Banner</div>
            <div class="ht-sample-content">
              <div class="ht-live-banner">
                <div class="ht-live-dot"></div>
                <span><strong style="color:#fff;">Court Session Active</strong> &mdash; Judge Williams is presiding &middot; 2 cases on docket</span>
                <button class="ht-btn ht-btn-outline" style="margin-left:auto;font-size:0.75rem;padding:0.35rem 0.75rem;"><i class="fa fa-right-to-bracket"></i> Join</button>
              </div>
            </div>
          </div>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Session Card (Sessions Tab)</div>
            <div class="ht-sample-content">
              <div class="ht-session-card" style="margin-bottom:0.6rem;">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
                  <span class="ht-badge ht-badge-scheduled">Scheduled</span>
                </div>
                <div class="ht-session-title">Morning Docket &mdash; Mar 22</div>
                <div class="ht-session-meta">Judge Williams</div>
                <div class="ht-session-stats">
                  <span><i class="fa fa-scale-balanced"></i> 3 cases</span>
                  <span><i class="fa fa-users"></i> 0</span>
                  <span><i class="fa fa-calendar"></i> Mar 22, 2026</span>
                </div>
              </div>
              <div class="ht-session-card live">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
                  <div style="width:8px;height:8px;border-radius:50%;background:var(--ht-red);"></div>
                  <span class="ht-badge ht-badge-active">In Session</span>
                </div>
                <div class="ht-session-title">Afternoon Docket &mdash; Mar 20</div>
                <div class="ht-session-meta">Judge Martinez</div>
                <div class="ht-session-stats">
                  <span><i class="fa fa-scale-balanced"></i> 2 cases</span>
                  <span><i class="fa fa-users"></i> 4</span>
                  <span>Started 2:15 PM</span>
                </div>
                <div style="position:absolute;right:1rem;top:50%;transform:translateY(-50%);">
                  <button class="ht-btn ht-btn-red" style="font-size:0.72rem;padding:0.35rem 0.75rem;">Join</button>
                </div>
              </div>
            </div>
          </div>

          <h3 class="ht-subsection-title" style="margin-top:1.5rem;">Running a Court Session</h3>

          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Create a session</div>
                <div class="ht-step-desc">Click <strong>+ Create Session</strong> on the Sessions tab. Enter a session title (e.g., "Morning Docket &mdash; Mar 22"), choose start and end times, and select which <strong>scheduled cases</strong> to include in the docket. Only cases not already assigned to another session will appear as options.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Start the session</div>
                <div class="ht-step-desc">Once created, open the session and click <strong>Start Session</strong> to begin proceedings. A live banner will appear for all users on the Court Cases page, and participants can join.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Activate cases from the docket</div>
                <div class="ht-step-desc">The judge activates each case in order from the docket. When a case is activated, its details appear in the main panel with all contested items. You can skip a case if it's not ready.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">4</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Review and resolve contested items</div>
                <div class="ht-step-desc">For each contested item, the judge marks it as <strong>Dismissed</strong> (charge is dropped) or <strong>Upheld</strong> (charge stands). Add optional judge notes, then click <strong>Submit Resolution</strong>.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">5</div>
              <div class="ht-step-body">
                <div class="ht-step-title">End the session</div>
                <div class="ht-step-desc">Once all cases on the docket have been resolved, click <strong>End Session</strong>. All completed cases and their verdicts move to the <strong>History</strong> tab. Any unresolved cases return to <strong>Scheduled</strong> status.</div>
              </div>
            </div>
          </div>

          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              Court sessions include a <strong>real-time chat</strong> feature. Participants (judge, defendants, spectators) can communicate during the session. Use the chat to ask questions or provide additional context.
            </div>
          </div>
        </div>

        <!-- History -->
        <div class="ht-subsection" id="court-history">
          <h3 class="ht-subsection-title">History</h3>
          <p class="ht-text">
            The <strong>History</strong> tab shows all completed and cancelled court sessions. Click on any session card to expand it and view the full docket with verdicts for each contested item.
          </p>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Completed Session with Verdicts</div>
            <div class="ht-sample-content">
              <div class="ht-session-card">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
                  <span class="ht-badge ht-badge-completed">Completed</span>
                </div>
                <div class="ht-session-title">Morning Docket &mdash; Mar 15</div>
                <div class="ht-session-meta">Judge Williams &middot; 2 cases</div>

                <div style="margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid var(--ht-glass-border);">
                  <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--ht-text-dim);margin-bottom:0.5rem;">Docket</div>
                  <div class="ht-docket-entry">
                    <div class="ht-docket-name"><i class="fa fa-user"></i> Alice Smith</div>
                    <div class="ht-resolution-row">
                      <div><span class="ht-contested-type citation">Citation</span> <span style="color:var(--ht-text-muted);">Speeding &mdash; 85 in a 65 zone</span></div>
                      <span class="ht-badge ht-badge-dismissed" style="font-size:0.62rem;">Dismissed</span>
                    </div>
                  </div>
                  <div class="ht-docket-entry">
                    <div class="ht-docket-name"><i class="fa fa-user"></i> John Doe</div>
                    <div class="ht-resolution-row">
                      <div><span class="ht-contested-type arrest">Arrest</span> <span style="color:var(--ht-text-muted);">Reckless Driving</span></div>
                      <span class="ht-badge ht-badge-upheld" style="font-size:0.62rem;">Upheld</span>
                    </div>
                    <div class="ht-resolution-row">
                      <div><span class="ht-contested-type citation">Citation</span> <span style="color:var(--ht-text-muted);">Failure to Signal</span></div>
                      <span class="ht-badge ht-badge-dismissed" style="font-size:0.62rem;">Dismissed</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <p class="ht-text">
            Verdicts are permanent once the session ends. <strong>Dismissed</strong> items have their original charges dropped, while <strong>Upheld</strong> items keep the original charges in place.
          </p>
        </div>
      </section>

      <!-- ╔═══════════════════════════════════════════╗ -->
      <!-- ║      COMMUNITY SETTINGS SECTION            ║ -->
      <!-- ╚═══════════════════════════════════════════╝ -->
      <section id="community-settings" class="ht-section">
        <div class="ht-section-header">
          <div class="ht-section-icon"><i class="fa fa-gear"></i></div>
          <div>
            <div class="ht-section-title">Community Settings</div>
            <div class="ht-section-subtitle">Manage penal codes, ten codes, and community configuration</div>
          </div>
        </div>

        <!-- Overview -->
        <div class="ht-subsection" id="settings-overview">
          <h3 class="ht-subsection-title">Overview</h3>
          <p class="ht-text">
            Community owners and admins can customize penal codes, ten codes, and fine settings through the
            <strong style="color:#fff;">Community Details</strong> page. These settings control what violations, codes,
            and fines are available across your entire community &mdash; including citations, arrest reports, and warrants.
          </p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Open Community Details</div>
                <div class="ht-step-desc">Click your community name in the sidebar, then select <strong>Community Details</strong>.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Navigate to the settings tab</div>
                <div class="ht-step-desc">Choose the relevant tab: <strong>Penal Codes</strong>, <strong>10-Codes</strong>, or <strong>Fine Settings</strong>.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Make your changes</div>
                <div class="ht-step-desc">Add, edit, remove, import, or export entries. Click <strong>Save Changes</strong> when finished.</div>
              </div>
            </div>
          </div>
          <div class="ht-tip">
            <i class="fa fa-lock ht-tip-icon"></i>
            <div class="ht-tip-text">
              Only users with the <strong>"Manage Community Settings"</strong> permission can access these features. Community owners have this permission by default.
            </div>
          </div>
        </div>

        <!-- Penal Code Import/Export -->
        <div class="ht-subsection" id="settings-penal-import">
          <h3 class="ht-subsection-title">Penal Code Import &amp; Export</h3>
          <p class="ht-text">
            Quickly transfer your penal code configuration between communities. Export your current setup as a file,
            then import it elsewhere &mdash; no need to manually re-enter dozens of violations.
          </p>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Penal Codes Toolbar</div>
            <div class="ht-sample-content" style="display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
              <span class="ht-btn" style="background:rgba(16,185,129,0.15); color:#22c55e; font-size:0.75rem;"><i class="fa fa-download"></i> Export</span>
              <span class="ht-btn" style="background:rgba(59,130,246,0.15); color:#3b82f6; font-size:0.75rem;"><i class="fa fa-upload"></i> Import</span>
              <span class="ht-btn" style="background:rgba(245,158,11,0.15); color:#f59e0b; font-size:0.75rem;"><i class="fa fa-undo"></i> Reset</span>
            </div>
          </div>

          <p class="ht-text" style="font-weight:600; color:#fff; margin-top:1.25rem;">Exporting Penal Codes</p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Click "Export"</div>
                <div class="ht-step-desc">In the Penal Codes settings, click the green <strong>Export</strong> button in the toolbar.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Choose a format</div>
                <div class="ht-step-desc">Select <strong>JSON</strong> or <strong>CSV</strong>. The file will download automatically.</div>
              </div>
            </div>
          </div>

          <p class="ht-text" style="font-weight:600; color:#fff; margin-top:1.25rem;">Importing Penal Codes</p>
          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Click "Import"</div>
                <div class="ht-step-desc">Click the blue <strong>Import</strong> button and select a <code>.json</code> or <code>.csv</code> file from your computer.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Review the imported data</div>
                <div class="ht-step-desc">The imported penal codes will load into the editor. Review the categories and violations to make sure everything looks correct.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">3</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Save Changes</div>
                <div class="ht-step-desc">Click <strong>Save Changes</strong> to apply the imported penal codes. Until you save, nothing is changed on the server.</div>
              </div>
            </div>
          </div>

          <p class="ht-text" style="font-weight:600; color:#fff; margin-top:1.25rem;">Resetting to Defaults</p>
          <p class="ht-text">
            Click the amber <strong>Reset</strong> button to restore the built-in default penal codes. This replaces all current categories and violations
            with the original set that comes with every new community. You'll be asked to confirm before the reset takes effect.
          </p>

          <div class="ht-tip">
            <i class="fa fa-circle-info ht-tip-icon"></i>
            <div class="ht-tip-text">
              <strong>Always export first!</strong> Importing replaces all existing penal codes. Export your current codes as a backup before importing a new set.
            </div>
          </div>
          <div class="ht-tip">
            <i class="fa fa-lightbulb ht-tip-icon"></i>
            <div class="ht-tip-text">
              <strong>JSON vs CSV:</strong> JSON preserves the full data structure including currency settings and is the recommended format for transferring between communities.
              CSV is useful if you want to edit violations in a spreadsheet app like Excel or Google Sheets.
            </div>
          </div>
        </div>

        <!-- Ten Code Import/Export -->
        <div class="ht-subsection" id="settings-ten-import">
          <h3 class="ht-subsection-title">Ten Code Import &amp; Export</h3>
          <p class="ht-text">
            Ten codes (radio codes like 10-4, 10-7, Signal 100) can also be exported and imported. Each ten code is a simple
            pair: a <strong style="color:#fff;">code</strong> and a <strong style="color:#fff;">description</strong>.
          </p>

          <div class="ht-sample-box">
            <div class="ht-sample-label"><i class="fa fa-eye"></i> Sample: Ten Codes Table</div>
            <div class="ht-sample-content">
              <table class="ht-sample-table">
                <thead>
                  <tr>
                    <th>Code</th>
                    <th>Description</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Signal 100</td>
                    <td>HOLD ALL BUT EMERGENCY</td>
                  </tr>
                  <tr>
                    <td>10-4</td>
                    <td>Acknowledgement / OK</td>
                  </tr>
                  <tr>
                    <td>10-7</td>
                    <td>Out of Service</td>
                  </tr>
                  <tr>
                    <td>10-8</td>
                    <td>In Service</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="ht-steps">
            <div class="ht-step">
              <div class="ht-step-number">1</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Open the 10-Codes tab</div>
                <div class="ht-step-desc">In Community Details, switch to the <strong>10-Codes</strong> tab and click the edit button to enter edit mode.</div>
              </div>
            </div>
            <div class="ht-step">
              <div class="ht-step-number">2</div>
              <div class="ht-step-body">
                <div class="ht-step-title">Export or Import</div>
                <div class="ht-step-desc">Click <strong>Export</strong> to download your codes as JSON or CSV. Click <strong>Import</strong> to upload a file and replace all current ten codes.</div>
              </div>
            </div>
          </div>

          <div class="ht-tip">
            <i class="fa fa-triangle-exclamation ht-tip-icon" style="color:var(--ht-amber);"></i>
            <div class="ht-tip-text">
              <strong>Ten code imports take effect immediately</strong> after confirmation &mdash; there is no separate "Save Changes" step.
              Export your current codes first as a backup.
            </div>
          </div>
        </div>

        <!-- Category Icons -->
        <div class="ht-subsection" id="settings-icons">
          <h3 class="ht-subsection-title">Category Icons</h3>
          <p class="ht-text">
            When editing penal code categories, you can assign a <strong style="color:#fff;">Font Awesome</strong> icon to each category.
            Icons appear next to the category name throughout the system, making it easy to identify categories at a glance.
