<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Help & Tutorials - Lines Police CAD</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="shortcut icon" type="image/ico" href="static/images/favicon.ico">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ht-bg: #08090c;
      --ht-surface: rgba(255,255,255,0.03);
      --ht-glass: rgba(255,255,255,0.04);
      --ht-glass-border: rgba(255,255,255,0.06);
      --ht-glass-hover: rgba(255,255,255,0.07);
      --ht-text: #e2e8f0;
      --ht-text-muted: #64748b;
      --ht-text-dim: #475569;
      --ht-accent: #8b5cf6;
      --ht-accent-glow: rgba(139,92,246,0.15);
      --ht-green: #22c55e;
      --ht-red: #ef4444;
      --ht-amber: #f59e0b;
      --ht-blue: #3b82f6;
      --ht-radius: 12px;
      --ht-radius-sm: 8px;
    }

    html { font-size: 16px; }
    body {
      background: var(--ht-bg);
      color: var(--ht-text);
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 700px 500px at 10% 15%, rgba(139,92,246,0.07) 0%, transparent 70%),
        radial-gradient(ellipse 500px 400px at 90% 85%, rgba(59,130,246,0.04) 0%, transparent 70%);
    }

    .ht-shell {
      position: relative;
      z-index: 1;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 2rem 4rem;
    }

    /* ── Header ── */
    .ht-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--ht-glass-border);
    }
    .ht-header-left {
      display: flex;
      align-items: center;
      gap: 0.875rem;
    }
    .ht-header-icon {
      width: 42px; height: 42px;
      border-radius: 10px;
      background: var(--ht-accent-glow);
      border: 1px solid rgba(139,92,246,0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ht-accent);
      font-size: 1.1rem;
    }
    .ht-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: #fff;
    }
    .ht-subtitle {
      font-size: 0.78rem;
      color: var(--ht-text-muted);
      margin-top: 0.1rem;
    }
    .ht-back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 1rem;
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--ht-text);
      background: var(--ht-glass);
      border: 1px solid var(--ht-glass-border);
      border-radius: var(--ht-radius-sm);
      text-decoration: none;
      transition: all 0.2s ease;
      font-family: inherit;
    }
    .ht-back-btn:hover {
      background: var(--ht-glass-hover);
      color: #fff;
    }

    /* ── Layout ── */
    .ht-layout {
      display: flex;
      gap: 2.5rem;
      align-items: flex-start;
    }

    /* ── Sidebar ── */
    .ht-sidebar {
      position: sticky;
      top: 2rem;
      width: 210px;
      flex-shrink: 0;
      align-self: flex-start;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      padding-right: 0.35rem;
    }
    .ht-sidebar::-webkit-scrollbar { width: 3px; }
    .ht-sidebar::-webkit-scrollbar-track { background: transparent; }
    .ht-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 3px; }
    .ht-sidebar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.15); }
    /* Search */
    .ht-nav-search {
      position: relative;
      margin-bottom: 0.75rem;
    }
    .ht-nav-search input {
      width: 100%;
      padding: 0.45rem 0.65rem 0.45rem 2rem;
      background: var(--ht-glass);
      border: 1px solid var(--ht-glass-border);
      border-radius: var(--ht-radius-sm);
      color: var(--ht-text);
      font-size: 0.78rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s, background 0.2s;
    }
    .ht-nav-search input::placeholder { color: var(--ht-text-dim); }
    .ht-nav-search input:focus {
      border-color: rgba(139,92,246,0.35);
      background: var(--ht-glass-hover);
    }
    .ht-nav-search i {
      position: absolute;
      left: 0.65rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.7rem;
      color: var(--ht-text-dim);
      pointer-events: none;
    }
    .ht-nav-group-title {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ht-text-dim);
      padding: 0.5rem 0.75rem;
      margin-top: 1rem;
    }
    .ht-nav-group-title:first-child { margin-top: 0; }
    .ht-nav-link {
      display: block;
      padding: 0.4rem 0.75rem 0.4rem 1.5rem;
      font-size: 0.8rem;
      color: var(--ht-text-muted);
      text-decoration: none;
      border-radius: var(--ht-radius-sm);
      border-left: 2px solid transparent;
      transition: all 0.2s ease;
    }
    .ht-nav-link:hover {
      color: #fff;
      background: var(--ht-surface);
    }
    .ht-nav-link.active {
      color: var(--ht-accent);
      border-left-color: var(--ht-accent);
      background: var(--ht-accent-glow);
    }

    /* ── Content ── */
    .ht-content {
      flex: 1;
      min-width: 0;
    }

    /* ── Section ── */
    .ht-section {
      margin-bottom: 3rem;
    }
    .ht-section-header {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--ht-glass-border);
    }
    .ht-section-icon {
      width: 38px; height: 38px;
      border-radius: 10px;
      background: var(--ht-glass);
      border: 1px solid var(--ht-glass-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ht-accent);
      font-size: 0.95rem;
    }
    .ht-section-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
    }
    .ht-section-subtitle {
      font-size: 0.76rem;
      color: var(--ht-text-muted);
      margin-top: 0.1rem;
    }

    /* ── Subsection ── */
    .ht-subsection {
      margin-bottom: 2rem;
      scroll-margin-top: 2rem;
    }
    .ht-subsection-title {
      font-size: 0.95rem;
      font-weight: 600;
      color: #fff;
      margin-bottom: 0.6rem;
    }
    .ht-text {
      font-size: 0.84rem;
      color: var(--ht-text-muted);
      line-height: 1.65;
      margin-bottom: 0.75rem;
    }

    /* ── Steps ── */
    .ht-steps {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin: 0.75rem 0 1rem;
    }
    .ht-step {
      display: flex;
      gap: 0.875rem;
      padding: 0.75rem 1rem;
      background: var(--ht-surface);
      border: 1px solid var(--ht-glass-border);
      border-radius: var(--ht-radius-sm);
    }
    .ht-step-number {
      width: 26px; height: 26px;
      border-radius: 50%;
      background: var(--ht-accent-glow);
      border: 1px solid rgba(139,92,246,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ht-accent);
      font-weight: 700;
      font-size: 0.75rem;
      flex-shrink: 0;
    }
    .ht-step-body { flex: 1; min-width: 0; }
    .ht-step-title {
      font-weight: 600;
      font-size: 0.85rem;
      color: #fff;
      margin-bottom: 0.15rem;
    }
    .ht-step-desc {
      font-size: 0.8rem;
      color: var(--ht-text-muted);
      line-height: 1.5;
    }

    /* ── Tip Box ── */
    .ht-tip {
      display: flex;
      gap: 0.75rem;
      padding: 0.875rem 1rem;
      background: rgba(59,130,246,0.06);
      border: 1px solid rgba(59,130,246,0.15);
      border-left: 3px solid var(--ht-blue);
      border-radius: var(--ht-radius-sm);
      margin: 0.75rem 0 1rem;
    }
    .ht-tip-icon {
      color: var(--ht-blue);
      font-size: 0.85rem;
      flex-shrink: 0;
      margin-top: 0.1rem;
    }
    .ht-tip-text {
      font-size: 0.8rem;
      color: var(--ht-text);
      line-height: 1.55;
    }

    /* ── Sample Component Box ── */
    .ht-sample-box {
      background: var(--ht-surface);
      border: 1px solid var(--ht-glass-border);
      border-radius: var(--ht-radius);
      margin: 1rem 0 1.5rem;
      overflow: hidden;
    }
    .ht-sample-label {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.55rem 1rem;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ht-text-dim);
      background: rgba(255,255,255,0.02);
      border-bottom: 1px solid var(--ht-glass-border);
    }
    .ht-sample-content {
      padding: 1.25rem;
      pointer-events: none;
      opacity: 0.85;
      user-select: none;
    }

    /* ── Sample Form Elements ── */
    .ht-form-group {
      margin-bottom: 0.875rem;
    }
    .ht-form-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--ht-text-muted);
      margin-bottom: 0.3rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .ht-form-input,
    .ht-form-select,
    .ht-form-textarea {
      width: 100%;
      padding: 0.5rem 0.75rem;
      font-size: 0.82rem;
      font-family: inherit;
      color: var(--ht-text);
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 6px;
      outline: none;
    }
    .ht-form-textarea { resize: none; min-height: 60px; }
    .ht-form-select { appearance: none; }
    .ht-form-row {
      display: flex;
      gap: 0.75rem;
    }
    .ht-form-row > * { flex: 1; }

    /* ── Sample Buttons ── */
    .ht-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
      font-weight: 600;
      font-family: inherit;
      border: none;
      border-radius: 6px;
      cursor: default;
    }
    .ht-btn-accent { background: var(--ht-accent); color: #fff; }
    .ht-btn-green { background: var(--ht-green); color: #fff; }
    .ht-btn-red { background: var(--ht-red); color: #fff; }
    .ht-btn-outline {
      background: transparent;
      border: 1px solid var(--ht-glass-border);
      color: var(--ht-text);
    }
    .ht-btn-group {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    /* ── Sample Table ── */
    .ht-sample-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }
    .ht-sample-table th {
      text-align: left;
      padding: 0.55rem 0.75rem;
      background: rgba(255,255,255,0.04);
      color: var(--ht-text-muted);
      font-weight: 600;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--ht-glass-border);
    }
    .ht-sample-table td {
      padding: 0.55rem 0.75rem;
      color: var(--ht-text);
      border-bottom: 1px solid rgba(255,255,255,0.03);
    }

    /* ── Sample Metrics ── */
    .ht-metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
    }
    .ht-metric {
      text-align: center;
      padding: 1rem 0.5rem;
      background: var(--ht-glass);
      border: 1px solid var(--ht-glass-border);
      border-radius: var(--ht-radius);
    }
    .ht-metric-value {
      font-size: 1.5rem;
      font-weight: 700;
    }
    .ht-metric-value.gold { color: var(--ht-amber); }
    .ht-metric-value.blue { color: var(--ht-blue); }
    .ht-metric-value.red { color: var(--ht-red); }
    .ht-metric-value.green { color: var(--ht-green); }
    .ht-metric-label {
      font-size: 0.72rem;
      color: var(--ht-text-muted);
      margin-top: 0.15rem;
    }

    /* ── Sample Tabs ── */
    .ht-tabs {
      display: flex;
      gap: 0.25rem;
      border-bottom: 1px solid var(--ht-glass-border);
      margin-top: 0.75rem;
    }
    .ht-tab {
      padding: 0.65rem 1rem;
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--ht-text-muted);
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      font-family: inherit;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .ht-tab.active {
      color: var(--ht-accent);
      border-bottom-color: var(--ht-accent);
    }
    .ht-tab-count {
      font-size: 0.68rem;
      font-weight: 700;
      background: var(--ht-glass);
      border: 1px solid var(--ht-glass-border);
      padding: 0.1rem 0.4rem;
      border-radius: 10px;
    }

    /* ── Sample Case Card ── */
    .ht-case-card {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      padding: 0.875rem 1rem;
      background: var(--ht-glass);
      border: 1px solid var(--ht-glass-border);
      border-radius: var(--ht-radius);
    }
    .ht-avatar {
      width: 38px; height: 38px;
      border-radius: 50%;
      background: var(--ht-accent-glow);
      border: 1px solid rgba(139,92,246,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ht-accent);
      font-weight: 700;
      font-size: 0.75rem;
      flex-shrink: 0;
    }
    .ht-case-info { flex: 1; min-width: 0; }
    .ht-case-name {
      font-weight: 600;
      font-size: 0.85rem;
      color: #fff;
    }
    .ht-case-meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: 0.2rem;
      font-size: 0.72rem;
      color: var(--ht-text-muted);
    }

    /* ── Badges ── */
    .ht-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.15rem 0.5rem;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-radius: 4px;
    }
    .ht-badge-submitted { background: rgba(245,158,11,0.15); color: var(--ht-amber); }
    .ht-badge-scheduled { background: rgba(34,197,94,0.15); color: var(--ht-green); }
    .ht-badge-active { background: rgba(239,68,68,0.15); color: var(--ht-red); }
    .ht-badge-pending { background: rgba(139,92,246,0.15); color: var(--ht-accent); }
    .ht-badge-approved { background: rgba(34,197,94,0.15); color: var(--ht-green); }
    .ht-badge-in-review { background: rgba(96,165,250,0.15); color: #60a5fa; }
    .ht-badge-completed { background: rgba(148,163,184,0.15); color: #94a3b8; }
    .ht-badge-dismissed { background: rgba(110,231,183,0.15); color: #6ee7b7; }
    .ht-badge-upheld { background: rgba(252,165,165,0.15); color: #fca5a5; }

    /* ── Extra Button Variants ── */
    .ht-btn-amber { background: rgba(234,179,8,0.15); border: 1px solid rgba(234,179,8,0.3); color: #eab308; }
    .ht-btn-indigo { background: rgba(99,102,241,0.2); border: 1px solid rgba(99,102,241,0.4); color: #818cf8; }
    .ht-btn-muted { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #94a3b8; }

    /* ── Sample Sidebar ── */
    .ht-sidebar-sample {
      background: var(--ht-glass);
      border: 1px solid var(--ht-glass-border);
      border-radius: var(--ht-radius-sm);
      padding: 0.5rem 0;
      width: 200px;
    }
    .ht-sidebar-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 1rem;
      font-size: 0.8rem;
      color: var(--ht-text-muted);
      transition: all 0.15s ease;
    }
    .ht-sidebar-item i { width: 16px; text-align: center; font-size: 0.78rem; }
    .ht-sidebar-item.highlighted {
      background: var(--ht-accent-glow);
      color: var(--ht-accent);
      border-left: 3px solid var(--ht-accent);
      font-weight: 600;
    }

    /* ── Case Detail Sample ── */
    .ht-case-detail {
      background: var(--ht-glass);
      border: 1px solid var(--ht-glass-border);
      border-radius: var(--ht-radius);
      padding: 1.25rem;
    }
    .ht-case-detail-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--ht-glass-border);
    }
    .ht-case-detail-title { font-weight: 700; font-size: 0.95rem; color: #fff; }
    .ht-detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.45rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      font-size: 0.8rem;
    }
    .ht-detail-label { color: var(--ht-text-muted); }
    .ht-detail-value { color: var(--ht-text); font-weight: 600; }
    .ht-action-row {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
    }
    .ht-action-row .ht-btn { flex: 1; justify-content: center; }

    /* ── Contested Item Sample ── */
    .ht-contested-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 0.75rem;
      background: rgba(255,255,255,0.02);
      border: 1px solid var(--ht-glass-border);
      border-radius: 6px;
      margin-bottom: 0.35rem;
      font-size: 0.8rem;
    }
    .ht-contested-type {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      margin-right: 0.5rem;
    }
    .ht-contested-type.citation { background: rgba(59,130,246,0.15); color: #93c5fd; }
    .ht-contested-type.warning { background: rgba(234,179,8,0.15); color: #fde047; }
    .ht-contested-type.arrest { background: rgba(239,68,68,0.15); color: #fca5a5; }

    /* ── Session Card Sample ── */
    .ht-session-card {
      background: var(--ht-glass);
      border: 1px solid var(--ht-glass-border);
      border-radius: var(--ht-radius);
      padding: 1rem;
      position: relative;
    }
    .ht-session-card.live { border-color: rgba(239,68,68,0.25); }
    .ht-session-title { font-weight: 700; font-size: 0.9rem; color: #fff; margin-bottom: 0.2rem; }
    .ht-session-meta { font-size: 0.78rem; color: var(--ht-text-muted); margin-bottom: 0.5rem; }
    .ht-session-stats {
      display: flex;
      gap: 1rem;
      font-size: 0.75rem;
      color: var(--ht-text-dim);
    }

    /* ── Docket Entry Sample ── */
    .ht-docket-entry {
      background: rgba(255,255,255,0.02);
      border: 1px solid var(--ht-glass-border);
      border-radius: 6px;
      padding: 0.65rem 0.75rem;
      margin-bottom: 0.4rem;
    }
    .ht-docket-name {
      font-weight: 600;
      font-size: 0.82rem;
      color: #fff;
      margin-bottom: 0.35rem;
    }
    .ht-docket-name i { color: var(--ht-accent); margin-right: 0.3rem; font-size: 0.72rem; }
    .ht-resolution-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.25rem 0;
      font-size: 0.78rem;
    }
    .ht-resolution-row + .ht-resolution-row { border-top: 1px solid rgba(255,255,255,0.04); }

    /* ── Sample Live Banner ── */
    .ht-live-banner {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.65rem 1rem;
      background: rgba(239,68,68,0.06);
      border: 1px solid rgba(239,68,68,0.15);
      border-radius: var(--ht-radius-sm);
      font-size: 0.8rem;
      color: var(--ht-text);
    }
    .ht-live-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--ht-red);
      flex-shrink: 0;
      animation: ht-pulse 2s ease-in-out infinite;
    }
    @keyframes ht-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* ── Warrant Status Flow ── */
    .ht-flow {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: wrap;
      margin: 0.5rem 0 0.75rem;
    }
    .ht-flow-item {
      padding: 0.3rem 0.65rem;
      font-size: 0.72rem;
      font-weight: 600;
      border-radius: 4px;
      background: var(--ht-glass);
      border: 1px solid var(--ht-glass-border);
      color: var(--ht-text-muted);
    }
    .ht-flow-arrow {
      color: var(--ht-text-dim);
      font-size: 0.7rem;
    }

    /* ── Nav Toggle (hidden on desktop) ── */
    .ht-nav-toggle {
      display: none;
    }

    /* ── Mobile ── */
    @media (max-width: 768px) {
      .ht-shell { padding: 1.25rem 1rem 3rem; }
      .ht-layout { flex-direction: column; gap: 0; }
      .ht-nav-toggle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.7rem 1rem;
        font-size: 0.82rem;
        font-weight: 600;
        font-family: inherit;
        color: var(--ht-text);
        background: var(--ht-glass);
        border: 1px solid var(--ht-glass-border);
        border-radius: var(--ht-radius-sm);
        cursor: pointer;
        margin-bottom: 0.75rem;
        transition: all 0.2s ease;
      }
      .ht-nav-toggle:hover,
      .ht-nav-toggle.active {
        background: var(--ht-glass-hover);
        border-color: rgba(139,92,246,0.25);
        color: #fff;
      }
      .ht-nav-toggle .ht-toggle-arrow {
        margin-left: auto;
        transition: transform 0.3s ease;
        font-size: 0.7rem;
      }
      .ht-nav-toggle.active .ht-toggle-arrow {
        transform: rotate(180deg);
      }
      .ht-sidebar {
        position: static;
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--ht-glass-border);
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease, padding 0.3s ease, margin 0.3s ease;
        padding-top: 0;
        padding-bottom: 0;
        margin-bottom: 0;
      }
      .ht-sidebar.open {
        max-height: 2000px;
        padding-bottom: 1rem;
        margin-bottom: 0.75rem;
      }
      .ht-nav-search { width: 100%; margin-bottom: 0.5rem; margin-top: 0.5rem; }
      .ht-nav-group-title { margin-top: 0.5rem; width: 100%; }
      .ht-nav-link { padding: 0.35rem 0.65rem; border-left: none; }
      .ht-metrics { grid-template-columns: repeat(2, 1fr); }
      .ht-form-row { flex-direction: column; }
      .ht-header { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    }
  </style>
</head>
