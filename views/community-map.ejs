<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Community Map - <%= community.community.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      /* cm- variables aligned to the shared rp- token system
         (see memory/project_website_theme_rp.md) */
      --cm-bg: #08090c;
      --cm-surface: rgba(255, 255, 255, 0.03);
      --cm-glass: rgba(255, 255, 255, 0.04);
      --cm-glass-border: rgba(255, 255, 255, 0.06);
      --cm-glass-hover: rgba(255, 255, 255, 0.07);
      --cm-text: #e2e8f0;
      --cm-text-muted: #64748b;
      --cm-text-dim: #475569;
      --cm-accent: #38bdf8;
      --cm-accent-glow: rgba(56, 189, 248, 0.15);
      --cm-green: #22c55e;
      --cm-red: #ef4444;
      --cm-radius: 12px;
      --cm-radius-sm: 8px;
    }

    html { font-size: 16px; }

    body {
      background: var(--cm-bg);
      color: var(--cm-text);
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      overflow-x: hidden;
      padding-top: 36px; /* clears the fixed standalone-utility strip */
    }

    /* Background effects — match the cyan/amber rp- backdrop */
    .cm-bg-mesh {
      position: fixed; inset: 0; z-index: 0;
      background:
        radial-gradient(ellipse 700px 500px at 10% 15%, rgba(56, 189, 248, 0.06) 0%, transparent 70%),
        radial-gradient(ellipse 500px 400px at 90% 85%, rgba(245, 158, 11, 0.04) 0%, transparent 70%);
      animation: cm-mesh-drift 20s ease-in-out infinite alternate;
    }
    @keyframes cm-mesh-drift { 0% { opacity: 1; } 100% { opacity: 0.6; } }

    .cm-grain {
      position: fixed; inset: 0; z-index: 1;
      opacity: 0.035; pointer-events: none;
    }

    /* Layout */
    .cm-wrapper { position: relative; z-index: 2; min-height: 100vh; }

    .cm-content { padding: 1.5rem 2rem; max-width: 1400px; margin: 0 auto; }

    /* Card */
    .cm-card {
      background: var(--cm-glass);
      border: 1px solid var(--cm-glass-border);
      border-radius: var(--cm-radius);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      overflow: hidden;
      transition: border-color 0.2s, box-shadow 0.2s;
      position: relative;
    }
    .cm-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0;
      height: 2px; background: var(--cm-accent); opacity: 0.7;
      z-index: 1;
    }
    .cm-card:hover {
      border-color: rgba(255, 255, 255, 0.1);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .cm-card-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--cm-glass-border);
    }

    .cm-card-title {
      display: flex; align-items: center; gap: 0.625rem;
      font-size: 0.875rem; font-weight: 600; color: var(--cm-text);
    }

    .cm-card-actions { display: flex; gap: 0.5rem; }

    /* Buttons */
    .cm-btn {
      padding: 0.5rem 1rem; border-radius: var(--cm-radius-sm);
      font-family: 'Outfit', sans-serif; font-size: 0.75rem; font-weight: 600;
      border: none; cursor: pointer; transition: all 0.15s ease;
      display: inline-flex; align-items: center; gap: 0.375rem;
    }
    .cm-btn-accent {
      background: var(--cm-accent-glow); color: var(--cm-accent);
      border: 1px solid rgba(56, 189, 248, 0.2);
    }
    .cm-btn-accent:hover {
      background: rgba(56, 189, 248, 0.25);
      box-shadow: 0 0 20px rgba(56, 189, 248, 0.15);
    }
    .cm-btn-danger {
      background: rgba(239, 68, 68, 0.15); color: var(--cm-red);
      border: 1px solid rgba(239, 68, 68, 0.2);
    }
    .cm-btn-danger:hover { background: rgba(239, 68, 68, 0.25); }
    .cm-btn-glass {
      background: var(--cm-glass); color: var(--cm-text-muted);
      border: 1px solid var(--cm-glass-border);
    }
    .cm-btn-glass:hover { background: var(--cm-glass-hover); color: var(--cm-text); }

    /* Beta badge */
    .cm-beta-badge {
      padding: 0.125rem 0.5rem;
      border-radius: 99px;
      font-size: 0.625rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: rgba(245, 158, 11, 0.12);
      color: #f59e0b;
      border: 1px solid rgba(245, 158, 11, 0.3);
    }

    /* Default label */
    .cm-default-label {
      padding: 0.5rem 1.25rem;
      color: var(--cm-text-dim); font-size: 0.75rem;
      display: flex; align-items: center; gap: 0.5rem;
      background: rgba(56, 189, 248, 0.05);
      border-bottom: 1px solid var(--cm-glass-border);
    }

    /* Map container */
    .cm-map-container {
      position: relative; overflow: hidden;
      max-height: calc(100vh - 240px); min-height: 400px;
      cursor: grab; background: rgba(0, 0, 0, 0.3);
    }
    .cm-map-container:active { cursor: grabbing; }
    .cm-map-container img {
      display: block; width: 100%;
      transform-origin: 0 0; transition: none;
      user-select: none; -webkit-user-drag: none;
    }

    /* Loading overlay */
    .cm-loading-overlay {
      position: absolute; inset: 0; z-index: 10;
      background: rgba(8, 9, 12, 0.8);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 0.75rem;
      color: var(--cm-text-muted); font-size: 0.8125rem;
    }
    .cm-spinner {
      width: 32px; height: 32px;
      border: 2px solid var(--cm-glass-border);
      border-top-color: var(--cm-accent);
      border-radius: 50%;
      animation: cm-spin 0.8s linear infinite;
    }
    @keyframes cm-spin { to { transform: rotate(360deg); } }

    /* Zoom controls */
    .cm-zoom-controls {
      display: flex; gap: 0.375rem;
      padding: 0.75rem 1.25rem;
      border-top: 1px solid var(--cm-glass-border);
      justify-content: center;
    }

    /* Error banner */
    .cm-error-banner {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.2);
      border-radius: var(--cm-radius-sm);
      color: var(--cm-red); padding: 0.625rem 1rem;
      font-size: 0.8125rem; margin-bottom: 1rem;
    }

    /* Modal */
    .cm-modal-overlay {
      position: fixed; inset: 0; z-index: 10001;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      opacity: 0; pointer-events: none;
      transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .cm-modal-overlay.active { opacity: 1; pointer-events: auto; }
    .cm-modal {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%) scale(0.92);
      background: rgba(16, 17, 24, 0.97);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--cm-radius);
      width: 90%; max-width: 400px;
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5), 0 0 1px rgba(255, 255, 255, 0.05) inset;
      padding: 1.5rem; overflow: hidden;
    }
    .cm-modal-overlay.active .cm-modal { transform: translate(-50%, -50%) scale(1); }
    .cm-modal-accent {
      position: absolute; top: 0; left: 0; right: 0;
      height: 2px; background: var(--cm-red); opacity: 0.8;
    }

    /* Upload preview modal — wider variant of cm-modal for image preview */
    .cm-preview-modal {
      width: 95%;
      max-width: 720px;
      padding: 0;
      max-height: 90vh;
      display: flex; flex-direction: column;
    }
    .cm-preview-modal .cm-modal-accent { background: var(--cm-accent); }
    .cm-preview-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--cm-glass-border);
    }
    .cm-preview-title {
      font-size: 0.875rem; font-weight: 600; color: var(--cm-text);
      display: flex; align-items: center; gap: 0.5rem;
    }
    .cm-preview-body { padding: 1rem 1.25rem; overflow-y: auto; }
    .cm-preview-stage {
      position: relative;
      width: 100%; aspect-ratio: 16 / 9;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid var(--cm-glass-border);
      border-radius: var(--cm-radius-sm);
      overflow: hidden; cursor: grab;
      touch-action: none;
    }
    .cm-preview-stage:active { cursor: grabbing; }
    .cm-preview-stage img {
      width: 100%; height: 100%; object-fit: contain;
      transform-origin: 0 0;
      user-select: none; -webkit-user-drag: none;
      display: block;
    }
    .cm-preview-zoom-controls {
      position: absolute; right: 8px; bottom: 8px;
      display: flex; gap: 4px; z-index: 2;
    }
    .cm-preview-zoom-controls .cm-btn {
      padding: 0.375rem 0.5rem; font-size: 0.75rem;
      background: rgba(8, 9, 12, 0.7);
      backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
    }
    .cm-preview-zoom-readout {
      position: absolute; left: 8px; bottom: 8px;
      padding: 0.25rem 0.5rem;
      background: rgba(8, 9, 12, 0.7);
      backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
      border-radius: 6px;
      color: var(--cm-text-muted);
      font-size: 0.6875rem;
      font-variant-numeric: tabular-nums;
      pointer-events: none;
      z-index: 2;
    }
    .cm-preview-stage-busy {
      position: absolute; inset: 0;
      background: rgba(8, 9, 12, 0.7);
      display: none; align-items: center; justify-content: center; gap: 0.5rem;
      color: var(--cm-text-muted); font-size: 0.75rem;
    }
    .cm-preview-stage-busy.active { display: flex; }
    .cm-preset-row {
      display: flex; gap: 0.5rem; margin-top: 1rem;
    }
    .cm-preset-btn {
      flex: 1;
      padding: 0.625rem 0.75rem;
      border-radius: var(--cm-radius-sm);
      background: var(--cm-glass);
      border: 1px solid var(--cm-glass-border);
      color: var(--cm-text-muted);
      font-family: 'Outfit', sans-serif; font-size: 0.75rem; font-weight: 600;
      cursor: pointer; transition: all 0.15s ease;
      display: flex; flex-direction: column; align-items: center; gap: 0.125rem;
    }
    .cm-preset-btn:hover { background: var(--cm-glass-hover); color: var(--cm-text); }
    .cm-preset-btn.active {
      background: var(--cm-accent-glow);
      color: var(--cm-accent);
      border-color: rgba(56, 189, 248, 0.35);
    }
    .cm-preset-btn small {
      font-size: 0.625rem; opacity: 0.7; font-weight: 500;
    }
    .cm-preview-stats {
      margin-top: 1rem;
      padding: 0.625rem 0.75rem;
      background: var(--cm-glass);
      border: 1px solid var(--cm-glass-border);
      border-radius: var(--cm-radius-sm);
      font-size: 0.75rem; color: var(--cm-text-muted);
      display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem 1rem;
    }
    .cm-preview-stats strong { color: var(--cm-text); font-weight: 600; }
    .cm-preview-footer {
      display: flex; gap: 0.5rem; justify-content: flex-end;
      padding: 0.875rem 1.25rem;
      border-top: 1px solid var(--cm-glass-border);
      background: rgba(0, 0, 0, 0.2);
    }
    .cm-preview-error {
      margin-top: 0.75rem;
      padding: 0.5rem 0.75rem;
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.25);
      border-radius: var(--cm-radius-sm);
      color: var(--cm-red); font-size: 0.75rem;
      display: none;
    }
    .cm-preview-error.active { display: block; }

    /* Responsive */
    @media (max-width: 768px) {
      .cm-content { padding: 1rem; }
      .cm-card-header { flex-direction: column; gap: 0.75rem; align-items: flex-start; }
      .cm-map-container { min-height: 300px; max-height: calc(100vh - 280px); }
      .cm-btn .cm-btn-label { display: none; }
      .cm-preview-stats { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .cm-bg-mesh { animation: none; }
    }
    @media (min-width: 769px) {
      .cm-btn .cm-btn-label { display: inline; }
    }
  </style>
</head>
<body>
  <%- include('partials/standalone-utility', {
    user: user,
    communityName: (community && community.community && community.community.name) || null,
    pageLabel: 'Map',
    backHref: '/community/' + encodedCommunityId,
    backLabel: 'Back to dashboard'
  }) %>

  <!-- Background effects -->
  <div class="cm-bg-mesh"></div>
  <div class="cm-grain">
    <svg width="100%" height="100%"><filter id="cmNoise"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(#cmNoise)"/></svg>
  </div>

  <!-- Main content -->
  <div class="cm-wrapper">
    <!-- Content -->
    <div class="cm-content">
      <!-- Error banner -->
      <div id="errorBanner" class="cm-error-banner" style="display: none;"></div>

      <!-- Map card -->
      <div class="cm-card">
        <!-- Card header with title and admin buttons -->
        <div class="cm-card-header">
          <div class="cm-card-title">
            <i class="fa fa-map" style="color: var(--cm-accent); opacity: 0.7;"></i>
            <span>Community Map</span>
            <% if (new Date() < new Date('2026-04-06T00:00:00Z')) { %>
              <span class="cm-beta-badge">BETA</span>
            <% } %>
          </div>
          <div class="cm-card-actions">
            <%
              // Permission check — same pattern as community-details.ejs
              const userId = user && user._doc ? user._doc._id : (user && user._id ? user._id : null);
              let canManageSettings = false;
              if (userId && community.community && Array.isArray(community.community.roles)) {
                community.community.roles.forEach(function(role) {
                  if (Array.isArray(role.members) && role.members.includes(userId)) {
                    if (Array.isArray(role.permissions)) {
                      role.permissions.forEach(function(perm) {
                        if ((perm.name === "administrator" && perm.enabled === true) || (perm.name === "manage community settings" && perm.enabled === true)) {
                          canManageSettings = true;
                        }
                      });
                    }
                  }
                });
              }
              // Also check if user is the community owner
              if (userId && community.community && String(community.community.ownerID) === String(userId)) {
                canManageSettings = true;
              }
            %>
            <% if (canManageSettings) { %>
              <button class="cm-btn cm-btn-accent" onclick="triggerUpload()">
                <i class="fa fa-upload"></i>
                <span class="cm-btn-label">Upload Map</span>
              </button>
              <button id="removeBtn" class="cm-btn cm-btn-danger" onclick="confirmRemoveMap()" style="display: <%= community.community.mapLink ? 'inline-flex' : 'none' %>;">
                <i class="fa fa-trash"></i>
                <span class="cm-btn-label">Remove</span>
              </button>
            <% } %>
          </div>
        </div>

        <!-- Default map label -->
        <div id="defaultLabel" class="cm-default-label" style="display: <%= community.community.mapLink ? 'none' : 'flex' %>;">
          <i class="fa fa-info-circle"></i>
          Default Map — Upload a custom map for your community
        </div>

        <!-- Map viewer -->
        <div id="mapContainer" class="cm-map-container">
          <!-- Loading overlay -->
          <div id="loadingOverlay" class="cm-loading-overlay" style="display: none;">
            <div class="cm-spinner"></div>
            <span>Loading...</span>
          </div>
          <img
            id="mapImage"
            src="<%= community.community.mapLink || '/static/images/GTA-V-Custom-Postal-Code-Map.jpg' %>"
            alt="Community Map"
            draggable="false"
          />
        </div>

        <!-- Zoom controls -->
        <div class="cm-zoom-controls">
          <button class="cm-btn cm-btn-glass" onclick="zoomOut()" title="Zoom Out">
            <i class="fa fa-minus"></i>
          </button>
          <button class="cm-btn cm-btn-glass" onclick="resetView()" title="Reset View">
            <i class="fa fa-expand"></i>
          </button>
          <button class="cm-btn cm-btn-glass" onclick="zoomIn()" title="Zoom In">
            <i class="fa fa-plus"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Remove confirmation modal -->
  <div id="removeModal" class="cm-modal-overlay">
    <div class="cm-modal">
      <div class="cm-modal-accent"></div>
      <h3 style="color: var(--cm-text); font-family: 'Outfit'; font-size: 1rem; font-weight: 600; margin: 0 0 0.75rem 0;">Remove Custom Map?</h3>
      <p style="color: var(--cm-text-muted); font-size: 0.8125rem; margin: 0 0 1.25rem 0;">This will revert to the default GTA-V map. You can upload a new map at any time.</p>
      <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
        <button class="cm-btn cm-btn-glass" onclick="closeRemoveModal()">Cancel</button>
        <button class="cm-btn cm-btn-danger" onclick="removeMap()">Remove</button>
      </div>
    </div>
  </div>

  <!-- Hidden file input -->
  <input type="file" id="mapFileInput" accept=".jpg,.jpeg,.png,.webp" style="display: none;" />

  <!-- Upload preview / optimize modal -->
  <div id="uploadPreviewModal" class="cm-modal-overlay">
    <div class="cm-modal cm-preview-modal" role="dialog" aria-labelledby="cm-preview-title">
      <div class="cm-modal-accent"></div>
      <div class="cm-preview-header">
        <div id="cm-preview-title" class="cm-preview-title">
          <i class="fa fa-image" style="color: var(--cm-accent);"></i>
          Optimize Map
        </div>
        <button class="cm-btn cm-btn-glass" id="previewCancelXBtn" aria-label="Close" type="button" style="padding: 0.375rem 0.625rem;">
          <i class="fa fa-times"></i>
        </button>
      </div>
      <div class="cm-preview-body">
        <div id="previewStage" class="cm-preview-stage" role="img" aria-label="Optimized map preview — scroll to zoom, drag to pan">
          <img id="previewImage" alt="" />
          <div id="previewBusy" class="cm-preview-stage-busy">
            <div class="cm-spinner" style="width: 20px; height: 20px;"></div>
            <span>Compressing…</span>
          </div>
          <div class="cm-preview-zoom-readout"><span id="previewZoomReadout">100%</span></div>
          <div class="cm-preview-zoom-controls">
            <button type="button" class="cm-btn cm-btn-glass" id="previewZoomOutBtn" title="Zoom out" aria-label="Zoom out"><i class="fa fa-minus"></i></button>
            <button type="button" class="cm-btn cm-btn-glass" id="previewZoomResetBtn" title="Fit to view" aria-label="Fit to view"><i class="fa fa-expand"></i></button>
            <button type="button" class="cm-btn cm-btn-glass" id="previewZoomInBtn" title="Zoom in" aria-label="Zoom in"><i class="fa fa-plus"></i></button>
          </div>
        </div>
        <div class="cm-preset-row" role="radiogroup" aria-label="Image quality preset">
          <button type="button" class="cm-preset-btn" data-preset="low" role="radio" aria-checked="false">
            Low <small>~65% · 3072px · ≤5MB</small>
          </button>
          <button type="button" class="cm-preset-btn active" data-preset="medium" role="radio" aria-checked="true">
            Medium <small>~82% · 4096px · ≤5MB</small>
          </button>
          <button type="button" class="cm-preset-btn" data-preset="high" role="radio" aria-checked="false">
            High <small>~96% · 8192px · ≤10MB</small>
          </button>
        </div>
        <div class="cm-preview-stats">
          <div>Original: <strong id="statOriginal">—</strong></div>
          <div>Optimized: <strong id="statOptimized">—</strong></div>
          <div>Dimensions: <strong id="statDims">—</strong></div>
          <div>Format: <strong>JPEG</strong></div>
        </div>
        <div id="previewError" class="cm-preview-error" role="alert"></div>
      </div>
      <div class="cm-preview-footer">
        <button class="cm-btn cm-btn-glass" id="previewCancelBtn" type="button">Cancel</button>
        <button class="cm-btn cm-btn-accent" id="previewSaveBtn" type="button">
          <i class="fa fa-cloud-upload-alt"></i>
          <span class="cm-btn-label">Save Map</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Cloudinary config and upload utility -->
  <script>
    window.API_URL = '<%= process.env.POLICE_CAD_API_URL || "" %>';
    window.CLOUDINARY_CLOUD_NAME = '<%= process.env.CLOUDINARY_CLOUD_NAME || "" %>';
    window.CLOUDINARY_API_KEY = '<%= process.env.CLOUDINARY_API_KEY || "" %>';
    window.CLOUDINARY_UPLOAD_PRESET = '<%= process.env.CLOUDINARY_UPLOAD_PRESET || "" %>';
  </script>
  <script src="/static/js/image-compress.js"></script>
  <script src="/static/js/cloudinary-upload.js"></script>

  <script>
    // ===== Map Pan/Zoom =====
    var scale = 1;
    var translateX = 0;
    var translateY = 0;
    var isDragging = false;
    var startX, startY;
    var MIN_SCALE = 0.5;
    var MAX_SCALE = 10;

    var mapImg = document.getElementById('mapImage');
    var mapContainer = document.getElementById('mapContainer');

    // Rewrite the initial map URL through Cloudinary's f_auto,q_auto so
    // browsers receive AVIF/WebP/JPEG variants per their capability. No-op
    // for the default static map (non-Cloudinary).
    (function applyDeliveryTransform() {
      if (!window.ImageCompress) return;
      var current = mapImg.getAttribute('src') || '';
      var rewritten = window.ImageCompress.withCloudinaryDelivery(current);
      if (rewritten !== current) mapImg.setAttribute('src', rewritten);
    })();

    function updateTransform() {
      mapImg.style.transform = 'translate(' + translateX + 'px, ' + translateY + 'px) scale(' + scale + ')';
    }

    // Mouse drag
    mapContainer.addEventListener('mousedown', function(e) {
      isDragging = true;
      startX = e.clientX - translateX;
      startY = e.clientY - translateY;
      e.preventDefault();
    });
    document.addEventListener('mousemove', function(e) {
      if (!isDragging) return;
      translateX = e.clientX - startX;
      translateY = e.clientY - startY;
      updateTransform();
    });
    document.addEventListener('mouseup', function() { isDragging = false; });

    // Touch drag
    mapContainer.addEventListener('touchstart', function(e) {
      if (e.touches.length === 1) {
        isDragging = true;
        startX = e.touches[0].clientX - translateX;
        startY = e.touches[0].clientY - translateY;
      }
    }, { passive: true });
    mapContainer.addEventListener('touchmove', function(e) {
      if (!isDragging || e.touches.length !== 1) return;
      e.preventDefault();
      translateX = e.touches[0].clientX - startX;
      translateY = e.touches[0].clientY - startY;
      updateTransform();
    }, { passive: false });
    mapContainer.addEventListener('touchend', function() { isDragging = false; });

    // Scroll wheel zoom (zooms toward cursor)
    mapContainer.addEventListener('wheel', function(e) {
      e.preventDefault();
      var delta = e.deltaY > 0 ? 0.9 : 1.1;
      var newScale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, scale * delta));
      var rect = mapContainer.getBoundingClientRect();
      var mouseX = e.clientX - rect.left;
      var mouseY = e.clientY - rect.top;
      var ratio = newScale / scale;
      translateX = mouseX - ratio * (mouseX - translateX);
      translateY = mouseY - ratio * (mouseY - translateY);
      scale = newScale;
      updateTransform();
    }, { passive: false });

    // Double-click reset
    mapContainer.addEventListener('dblclick', resetView);

    function resetView() {
      scale = 1; translateX = 0; translateY = 0;
      updateTransform();
    }
    function zoomIn() {
      scale = Math.min(MAX_SCALE, scale * 1.3);
      updateTransform();
    }
    function zoomOut() {
      scale = Math.max(MIN_SCALE, scale / 1.3);
      updateTransform();
    }

    // ===== Upload & Remove =====
    var communityId = '<%= communityId %>';
    var fileInput = document.getElementById('mapFileInput');

    function triggerUpload() {
      fileInput.click();
    }

    // ===== Upload Preview Modal =====
    var INPUT_MAX_BYTES = 50 * 1024 * 1024;   // 50MB raw input cap.
    // Final compressed cap is taken from the active preset (see QUALITY_PRESETS).
    var pendingFile = null;
    var pendingBlob = null;
    var currentPreset = 'medium';
    var compressToken = 0;

    var previewModal      = document.getElementById('uploadPreviewModal');
    var previewImage      = document.getElementById('previewImage');
    var previewStage      = document.getElementById('previewStage');
    var previewBusy       = document.getElementById('previewBusy');
    var previewSaveBtn    = document.getElementById('previewSaveBtn');
    var previewCancelBtn  = document.getElementById('previewCancelBtn');
    var previewCancelXBtn = document.getElementById('previewCancelXBtn');
    var previewError      = document.getElementById('previewError');
    var statOriginal      = document.getElementById('statOriginal');
    var statOptimized     = document.getElementById('statOptimized');
    var statDims          = document.getElementById('statDims');
    var presetButtons     = document.querySelectorAll('.cm-preset-btn');

    function setPreviewError(msg) {
      if (msg) {
        previewError.textContent = msg;
        previewError.classList.add('active');
      } else {
        previewError.textContent = '';
        previewError.classList.remove('active');
      }
    }

    function setBusy(busy) {
      previewBusy.classList.toggle('active', !!busy);
      previewSaveBtn.disabled = !!busy;
      previewSaveBtn.style.opacity = busy ? 0.5 : 1;
      previewSaveBtn.style.cursor = busy ? 'wait' : 'pointer';
    }

    // ===== Preview pan/zoom (matches the main map viewer) =====
    var PV_MIN_SCALE = 1;
    var PV_MAX_SCALE = 40;
    var pvScale = 1;
    var pvTx = 0;
    var pvTy = 0;
    var pvDragging = false;
    var pvDragStartX = 0;
    var pvDragStartY = 0;
    var previewZoomReadout = document.getElementById('previewZoomReadout');
    var previewZoomInBtn   = document.getElementById('previewZoomInBtn');
    var previewZoomOutBtn  = document.getElementById('previewZoomOutBtn');
    var previewZoomResetBtn = document.getElementById('previewZoomResetBtn');

    function pvApply() {
      previewImage.style.transform = 'translate(' + pvTx + 'px, ' + pvTy + 'px) scale(' + pvScale + ')';
      // Past 4x, switch to nearest-neighbor so the user sees the actual
      // saved pixels rather than browser-interpolated smoothing — that's
      // the honest "is this quality good enough?" view.
      previewImage.style.imageRendering = pvScale > 4 ? 'pixelated' : 'auto';
      if (previewZoomReadout) previewZoomReadout.textContent = Math.round(pvScale * 100) + '%';
    }
    function pvReset() {
      pvScale = 1; pvTx = 0; pvTy = 0;
      pvApply();
    }
    function pvZoomTo(newScale, originX, originY) {
      newScale = Math.min(PV_MAX_SCALE, Math.max(PV_MIN_SCALE, newScale));
      if (newScale === pvScale) return;
      // Zoom toward the given stage-relative origin (defaults to center).
      var rect = previewStage.getBoundingClientRect();
      var cx = (originX == null) ? rect.width / 2 : originX;
      var cy = (originY == null) ? rect.height / 2 : originY;
      var ratio = newScale / pvScale;
      pvTx = cx - ratio * (cx - pvTx);
      pvTy = cy - ratio * (cy - pvTy);
      pvScale = newScale;
      pvApply();
    }

    function openPreviewModal() {
      previewModal.classList.add('active');
      pvReset();
    }
    function closePreviewModal() {
      previewModal.classList.remove('active');
      if (previewImage.src) URL.revokeObjectURL(previewImage.src);
      previewImage.removeAttribute('src');
      pendingFile = null;
      pendingBlob = null;
      setPreviewError('');
      setBusy(false);
      pvReset();
    }

    async function recompress() {
      if (!pendingFile) return;
      var token = ++compressToken;
      setBusy(true);
      setPreviewError('');
      try {
        var preset = window.ImageCompress.QUALITY_PRESETS[currentPreset];
        var result = await window.ImageCompress.compressImage(pendingFile, {
          quality: preset.quality,
          maxDimension: preset.maxDimension,
          maxBytes: preset.maxBytes,
        });
        if (token !== compressToken) return; // a newer pass started
        pendingBlob = result.blob;
        if (previewImage.src) URL.revokeObjectURL(previewImage.src);
        previewImage.src = URL.createObjectURL(result.blob);
        statOriginal.textContent = window.ImageCompress.formatBytes(result.originalBytes);
        statOptimized.textContent = window.ImageCompress.formatBytes(result.bytes);
        statDims.textContent = result.width + ' × ' + result.height;
        if (result.bytes > preset.maxBytes) {
          var capLabel = window.ImageCompress.formatBytes(preset.maxBytes);
          setPreviewError('Could not shrink under ' + capLabel + ' even at lowest quality. Try a smaller source image.');
          previewSaveBtn.disabled = true;
          previewSaveBtn.style.opacity = 0.5;
        }
      } catch (err) {
        console.error('Compression error:', err);
        if (token === compressToken) setPreviewError('Could not process this image. Try a different file.');
      } finally {
        if (token === compressToken) setBusy(false);
      }
    }

    fileInput.addEventListener('change', async function(e) {
      var file = e.target.files[0];
      fileInput.value = '';
      if (!file) return;

      var validTypes = ['image/jpeg', 'image/png', 'image/webp'];
      if (validTypes.indexOf(file.type) === -1) {
        showError('Please select a JPG, PNG, or WebP image.');
        return;
      }
      if (file.size > INPUT_MAX_BYTES) {
        showError('Image must be under 50MB.');
        return;
      }

      pendingFile = file;
      // Reset preset to medium each open.
      currentPreset = 'medium';
      presetButtons.forEach(function(b) {
        var active = b.dataset.preset === currentPreset;
        b.classList.toggle('active', active);
        b.setAttribute('aria-checked', active ? 'true' : 'false');
      });
      openPreviewModal();
      recompress();
    });

    presetButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (btn.classList.contains('active')) return;
        currentPreset = btn.dataset.preset;
        presetButtons.forEach(function(b) {
          var active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-checked', active ? 'true' : 'false');
        });
        recompress();
      });
    });

    // Reset pan/zoom whenever a new compressed image is loaded.
    previewImage.addEventListener('load', pvReset);

    // Wheel zoom — centered on cursor, like the main map viewer.
    previewStage.addEventListener('wheel', function(e) {
      if (!previewImage.src) return;
      e.preventDefault();
      var rect = previewStage.getBoundingClientRect();
      var mx = e.clientX - rect.left;
      var my = e.clientY - rect.top;
      // Tame the zoom step on touchpads which emit large deltaY values.
      var step = Math.min(0.25, Math.abs(e.deltaY) / 500);
      var factor = e.deltaY > 0 ? (1 - step) : (1 + step);
      pvZoomTo(pvScale * factor, mx, my);
    }, { passive: false });

    // Mouse drag to pan.
    previewStage.addEventListener('mousedown', function(e) {
      if (!previewImage.src) return;
      pvDragging = true;
      pvDragStartX = e.clientX - pvTx;
      pvDragStartY = e.clientY - pvTy;
      e.preventDefault();
    });
    document.addEventListener('mousemove', function(e) {
      if (!pvDragging) return;
      pvTx = e.clientX - pvDragStartX;
      pvTy = e.clientY - pvDragStartY;
      pvApply();
    });
    document.addEventListener('mouseup', function() { pvDragging = false; });

    // Single-finger touch drag to pan.
    previewStage.addEventListener('touchstart', function(e) {
      if (!previewImage.src || e.touches.length !== 1) return;
      pvDragging = true;
      pvDragStartX = e.touches[0].clientX - pvTx;
      pvDragStartY = e.touches[0].clientY - pvTy;
    }, { passive: true });
    previewStage.addEventListener('touchmove', function(e) {
      if (!pvDragging || e.touches.length !== 1) return;
      e.preventDefault();
      pvTx = e.touches[0].clientX - pvDragStartX;
      pvTy = e.touches[0].clientY - pvDragStartY;
      pvApply();
    }, { passive: false });
    previewStage.addEventListener('touchend', function() { pvDragging = false; });

    // Double-click resets the view (also matches main map viewer).
    previewStage.addEventListener('dblclick', pvReset);

    previewZoomInBtn.addEventListener('click', function() { pvZoomTo(pvScale * 1.6); });
    previewZoomOutBtn.addEventListener('click', function() { pvZoomTo(pvScale / 1.6); });
    previewZoomResetBtn.addEventListener('click', pvReset);

    previewCancelBtn.addEventListener('click', closePreviewModal);
    previewCancelXBtn.addEventListener('click', closePreviewModal);
    previewModal.addEventListener('click', function(e) {
      if (e.target === previewModal) closePreviewModal();
    });

    previewSaveBtn.addEventListener('click', async function() {
      if (!pendingBlob) return;
      setBusy(true);
      setPreviewError('');
      try {
        // Wrap blob as a File so Cloudinary picks up a sensible filename.
        var fileToUpload = new File([pendingBlob], 'community-map.jpg', { type: 'image/jpeg' });
        var url = await uploadToCloudinary(fileToUpload, 'community-maps', communityId);
        var response = await fetch('/api/v1/community/' + communityId + '/map', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mapLink: url }),
        });
        if (!response.ok) throw new Error('Failed to save map');

        var deliveryUrl = window.ImageCompress.withCloudinaryDelivery(url);
        closePreviewModal();
        showLoading(true);
        mapImg.onload = null;
        mapImg.onerror = null;
        mapImg.src = deliveryUrl;
        mapImg.onload = function() {
          mapImg.onload = null;
          resetView();
          showLoading(false);
          updateDefaultLabel(false);
        };
        mapImg.onerror = function() {
          mapImg.onerror = null;
          showLoading(false);
          showError('Map uploaded but failed to display. Refresh the page.');
        };
      } catch (err) {
        console.error('Upload error:', err);
        setPreviewError('Failed to upload map. Please try again.');
        setBusy(false);
      }
    });

    // Remove map
    function confirmRemoveMap() {
      document.getElementById('removeModal').classList.add('active');
    }
    function closeRemoveModal() {
      document.getElementById('removeModal').classList.remove('active');
    }
    async function removeMap() {
      closeRemoveModal();
      showLoading(true);
      try {
        var response = await fetch('/api/v1/community/' + communityId + '/map', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mapLink: null }),
        });
        if (!response.ok) throw new Error('Failed to remove map');
        mapImg.onload = null;
        mapImg.onerror = null;
        mapImg.src = '/static/images/GTA-V-Custom-Postal-Code-Map.jpg';
        resetView();
        showLoading(false);
        updateDefaultLabel(true);
      } catch (err) {
        console.error('Remove error:', err);
        showLoading(false);
        showError('Failed to remove map. Please try again.');
      }
    }

    // ===== Helpers =====
    function showError(msg) {
      var banner = document.getElementById('errorBanner');
      banner.textContent = msg;
      banner.style.display = 'block';
      setTimeout(function() { banner.style.display = 'none'; }, 5000);
    }
    function showLoading(show) {
      document.getElementById('loadingOverlay').style.display = show ? 'flex' : 'none';
    }
    function updateDefaultLabel(isDefault) {
      var label = document.getElementById('defaultLabel');
      if (label) label.style.display = isDefault ? 'flex' : 'none';
      var removeBtn = document.getElementById('removeBtn');
      if (removeBtn) removeBtn.style.display = isDefault ? 'none' : 'inline-flex';
    }

    // ===== Image Load Timeout (5s) =====
    var loadTimeout = setTimeout(function() {
      if (!mapImg.complete) {
        mapImg.src = '/static/images/GTA-V-Custom-Postal-Code-Map.jpg';
        updateDefaultLabel(true);
      }
    }, 5000);
    mapImg.addEventListener('load', function() { clearTimeout(loadTimeout); });
    mapImg.addEventListener('error', function() {
      clearTimeout(loadTimeout);
      mapImg.src = '/static/images/GTA-V-Custom-Postal-Code-Map.jpg';
      updateDefaultLabel(true);
    });

    // Smart back: store the page the user arrived from so the strip's
    // back link returns there instead of the static dashboard default.
    // Same pattern as /reports and /most-wanted.
    (function () {
      var RETURN_KEY = 'communityMap.returnUrl';
      (function captureReturnUrl() {
        var ref = document.referrer || '';
        if (!ref) return;
        if (ref.indexOf(window.location.origin) !== 0) return;
        var path = ref.slice(window.location.origin.length).split('?')[0].split('#')[0];
        if (/\/community\/[^/]+\/map\/?$/.test(path)) return;
        try { sessionStorage.setItem(RETURN_KEY, ref); } catch (e) { /* private mode */ }
      })();
      Array.from(document.querySelectorAll('.lpc-utility-back')).forEach(function (a) {
        a.addEventListener('click', function (e) {
          var stored = '';
          try { stored = sessionStorage.getItem(RETURN_KEY) || ''; } catch (e2) {}
          if (stored) { e.preventDefault(); window.location.href = stored; }
        });
      });
    })();
  </script>
</body>
</html>
